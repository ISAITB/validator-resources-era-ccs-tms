@prefix era: <http://data.europa.eu/949/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== Balise Group Shape =====
era:BaliseGroupShape a sh:NodeShape ;
    sh:targetClass era:BaliseGroup ;
    
    # Q_UPDOWN (required, boolean - uplink/downlink capability)
    sh:property [ 
        sh:path era:q_updown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each BaliseGroup must have exactly one q_updown value (boolean indicating uplink/downlink capability)."@en ;
        sh:message "Jede BaliseGroup muss genau einen q_updown-Wert haben (boolescher Wert, der die Uplink-/Downlink-Fähigkeit angibt)."@de ;
        sh:message "Chaque BaliseGroup doit avoir exactement une valeur q_updown (booléen indiquant la capacité de liaison montante/descendante)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_LINK (required, boolean - linking information)
    sh:property [ 
        sh:path era:q_link ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each BaliseGroup must have exactly one q_link value (boolean indicating linking information)."@en ;
        sh:message "Jede BaliseGroup muss genau einen q_link-Wert haben (boolescher Wert, der Verknüpfungsinformationen angibt)."@de ;
        sh:message "Chaque BaliseGroup doit avoir exactement une valeur q_link (booléen indiquant les informations de liaison)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # ETCS M_VERSION (required, controlled vocabulary - ETCS message version)
    sh:property [ 
        sh:path era:etcsMVersion ;
        sh:in (
            <http://data.europa.eu/949/concepts/etcs-m-versions/v1_0>
            <http://data.europa.eu/949/concepts/etcs-m-versions/v1_1>
            <http://data.europa.eu/949/concepts/etcs-m-versions/v2_0>
            <http://data.europa.eu/949/concepts/etcs-m-versions/v2_1>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property etcsMVersion must have a value from the defined SKOS concept scheme (v1.0, v1.1, v2.0, or v2.1)."@en ;
        sh:message "Die Eigenschaft etcsMVersion muss einen Wert aus dem definierten SKOS-Konzeptschema (v1.0, v1.1, v2.0 oder v2.1) haben."@de ;
        sh:message "La propriété etcsMVersion doit avoir une valeur du schéma de concept SKOS défini (v1.0, v1.1, v2.0 ou v2.1)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Balise Shape =====
era:BaliseShape a sh:NodeShape ;
    sh:targetClass era:Balise ;
    
    # Design Type (required, string - manufacturer/model identifier)
    sh:property [ 
        sh:path era:designType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one designType (string identifying manufacturer/model)."@en ;
        sh:message "Jede Balise muss genau eine designType (Zeichenfolge zur Identifizierung des Herstellers/Modells) haben."@de ;
        sh:message "Chaque Balise doit avoir exactement un designType (chaîne identifiant le fabricant/modèle)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Balise Mounting System (required, string)
    sh:property [ 
        sh:path era:baliseMountingSystem ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one baliseMountingSystem (string describing mounting method)."@en ;
        sh:message "Jede Balise muss genau eine baliseMountingSystem (Zeichenfolge, die die Montagemethode beschreibt) haben."@de ;
        sh:message "Chaque Balise doit avoir exactement un baliseMountingSystem (chaîne décrivant la méthode de montage)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Sleeper Fastening (required, string - attachment method to sleeper)
    sh:property [ 
        sh:path era:sleeperFastening ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one sleeperFastening (string describing attachment method)."@en ;
        sh:message "Jede Balise muss genau eine sleeperFastening (Zeichenfolge, die die Befestigungsmethode beschreibt) haben."@de ;
        sh:message "Chaque Balise doit avoir exactement un sleeperFastening (chaîne décrivant la méthode de pièce jointe)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Fixed (required, boolean - fixed vs switchable balise)
    sh:property [ 
        sh:path era:fixed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one fixed value (boolean: true for fixed, false for switchable)."@en ;
        sh:message "Jede Balise muss genau einen festen Wert haben (boolean: true für fest, false für umschaltbar)."@de ;
        sh:message "Chaque Balise doit avoir exactement une valeur fixe (booléenne : true pour fixe, false pour commutable)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Standard Size (required, boolean)
    sh:property [ 
        sh:path era:standardSize ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one standardSize value (boolean indicating standard dimensions)."@en ;
        sh:message "Jede Balise muss genau einen standardSize-Wert haben (boolescher Wert, der Standardabmessungen angibt)."@de ;
        sh:message "Chaque Balise doit avoir exactement une valeur standardSize (booléenne indiquant les dimensions standards)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Vertically Oriented (required, boolean)
    sh:property [ 
        sh:path era:verticallyOriented ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one verticallyOriented value (boolean indicating mounting orientation)."@en ;
        sh:message "Jede Balise muss genau einen verticallyOriented-Wert haben (boolescher Wert, der die Montageausrichtung angibt)."@de ;
        sh:message "Chaque Balise doit avoir exactement une valeur verticallyOriented (booléen indiquant l'orientation de montage)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # N_PIG (required, unsigned integer 0-7 - position in group)
    sh:property [ 
        sh:path era:n_pig ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 7 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one n_pig value (unsigned integer 0-7, position in balise group)."@en ;
        sh:message "Jede Balise muss genau einen n_pig-Wert haben (vorzeichenlose Ganzzahl 0-7, Position in der Balise-Gruppe)."@de ;
        sh:message "Chaque Balise doit avoir exactement une valeur n_pig (entier non signé 0-7, position dans le groupe balise)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_MCOUNT (required, unsigned integer 0-255 - message count)
    sh:property [ 
        sh:path era:m_mcount ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one m_mcount value (unsigned integer 0-255, message counter)."@en ;
        sh:message "Jede Balise muss genau einen m_mcount-Wert (vorzeichenlose Ganzzahl 0-255, Nachrichtenzähler) haben."@de ;
        sh:message "Chaque Balise doit avoir exactement une valeur m_mcount (entier non signé 0-255, compteur de messages)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_DUP (required, controlled vocabulary - duplication indicator)
    sh:property [ 
        sh:path era:m_dup ;
        sh:in (
            <http://data.europa.eu/949/concepts/duplication-type/noDuplicates>
            <http://data.europa.eu/949/concepts/duplication-type/duplicateNextBalise>
            <http://data.europa.eu/949/concepts/duplication-type/duplicatePreviousBalise>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_dup must have a value from the defined SKOS concept scheme (noDuplicates, duplicateNextBalise, or duplicatePreviousBalise)."@en ;
        sh:message "Die Eigenschaft m_dup muss einen Wert aus dem definierten SKOS-Konzeptschema (noDuplicates, duplicateNextBalise oder duplicatePreviousBalise) haben."@de ;
        sh:message "La propriété m_dup doit avoir une valeur du schéma de concept SKOS défini (noDuplicates, duplicateNextBalise ou duplicatePreviousBalise)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Telegram (required, base64Binary - encoded balise telegram data)
    sh:property [ 
        sh:path era:telegram ;
        sh:datatype xsd:base64Binary ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one telegram (base64Binary encoded ETCS data)."@en ;
        sh:message "Jede Balise muss genau ein Telegramm (base64Binär kodierte ETCS-Daten) haben."@de ;
        sh:message "Chaque Balise doit avoir exactement un télégramme (données ETCS codées en base64Binary)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Telegram Checksum (required, string - verification checksum)
    sh:property [ 
        sh:path era:telegramChecksum ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one telegramChecksum (string for data verification)."@en ;
        sh:message "Jede Balise muss genau eine telegramChecksum (Zeichenfolge zur Datenüberprüfung) haben."@de ;
        sh:message "Chaque Balise doit avoir exactement un telegramChecksum (chaîne pour la vérification des données)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # ETCS Packets (optional, multiple allowed)
    sh:property [ 
        sh:path era:etcsPackets ;
        sh:node era:BalisePacketShape ;
        sh:message "Balise etcsPackets must reference valid BalisePacket."@en ;
        sh:message "Balise etcsPackets muss auf ein gültiges BalisePacket verweisen."@de ;
        sh:message "Balise etcsPackets doit faire référence à BalisePacket valide."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Buffer Stop Shape =====
era:BufferStopShape a sh:NodeShape ;
    sh:targetClass era:BufferStop ;
    
    # Buffer Stop Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:bsType ;
        sh:in (
            <http://data.europa.eu/949/concepts/buffer-stop-type/friction>
            <http://data.europa.eu/949/concepts/buffer-stop-type/hydraulic>
            <http://data.europa.eu/949/concepts/buffer-stop-type/fixated>
            <http://data.europa.eu/949/concepts/buffer-stop-type/other>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property bsType must have a value from the defined SKOS concept scheme (friction, hydraulic, fixated, or other)."@en ;
        sh:message "Die Eigenschaft bsType muss einen Wert aus dem definierten SKOS-Konzeptschema haben (Reibung, hydraulisch, feststehend oder andere)."@de ;
        sh:message "La propriété bsType doit avoir une valeur issue du schéma conceptuel SKOS défini (friction, hydraulique, fixe ou autre)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Danger Points (optional, multiple allowed)
    sh:property [ 
        sh:path era:dangerPoints ;
        sh:class era:DangerPoint ;
		sh:nodeKind sh:IRI ;
        sh:message "BufferStop dangerPoints must conform to a valid DangerPoint object"@en ;
        sh:message "BufferStop dangerPoints muss einem gültigen DangerPoint-Objekt entsprechen"@de ;
        sh:message "BufferStop dangerPoints doit être conforme à un objet DangerPoint valide"@fr ;
        sh:severity sh:Violation ;
    ] ;
	
    sh:property [ 
        sh:path era:linearElementSections ;
        sh:node era:LinearElementSectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
		sh:minCount 1 ;
        sh:message "BufferStop dangerPoints must conform to valid DangerPoint object."@en ;
        sh:message "BufferStop dangerPoints muss einem gültigen DangerPoint-Objekt entsprechen."@de ;
        sh:message "BufferStop dangerPoints doit être conforme à un objet DangerPoint valide."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Crossing Shape =====
era:CrossingShape a sh:NodeShape ;
    sh:targetClass era:Crossing ;
    
    # Fouling Points (required, one or more)
    sh:property [ 
        sh:path era:foulingPoints ;
        sh:class era:FoulingPoint ;
		sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Each Crossing must have at least one foulingPoint that conform to a valid FoulingPoint object."@en ;
        sh:message "Jede Kreuzung muss mindestens ein foulingPoint haben, das einem gültigen FoulingPoint-Objekt entspricht."@de ;
        sh:message "Chaque croisement doit avoir au moins un foulingPoint conforme à un objet FoulingPoint valide."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Danger Point Shape =====
era:DangerPointShape a sh:NodeShape ;
    sh:targetClass era:DangerPoint ;
    
    # Name (required, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DangerPoint must have exactly one name (string)."@en ;
        sh:message "Jeder DangerPoint muss genau einen Namen (String) haben."@de ;
        sh:message "Chaque DangerPoint doit avoir exactement un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Topological Coordinate (required, can be inline or referenced)
    sh:property [ 
        sh:path era:topologicalCoordinate ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DangerPoint must have exactly one topologicalCoordinate that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jeder DangerPoint muss genau ein topologicalCoordinate haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque DangerPoint doit avoir exactement un topologicalCoordinate conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Engineering Shape =====
era:ETCSEngineeringShape a sh:NodeShape ;
    sh:targetClass era:ETCSEngineering ;
    
    # Engineering Areas (optional, multiple allowed)
    sh:property [ 
        sh:path era:engAreas ;
        sh:node era:EngAreaShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "ETCSEngineering engAreas must conform to a valid EngArea"@en ;
        sh:message "ETCSEngineering engAreas muss einer gültigen EngArea entsprechen"@de ;
        sh:message "ETCSEngineering engAreas doit être conforme à une EngArea valide"@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Location Accuracy Areas (optional, multiple allowed)
    sh:property [ 
        sh:path era:locationAccuracyAreas ;
        sh:node era:LocationAccuracyAreaShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "ETCSEngineering locationAccuracyAreas must conform to valid LocationAccuracyArea object."@en ;
        sh:message "ETCSEngineering locationAccuracyAreas muss einem gültigen LocationAccuracyArea-Objekt entsprechen."@de ;
        sh:message "ETCSEngineering locationAccuracyAreas doit être conforme à un objet LocationAccuracyArea valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Kilometer Areas (optional, multiple allowed)
    sh:property [ 
        sh:path era:kmAreas ;
        sh:node era:KmAreaShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "ETCSEngineering kmAreas must conform to valid KmArea object."@en ;
        sh:message "ETCSEngineering kmAreas muss einem gültigen KmArea-Objekt entsprechen."@de ;
        sh:message "ETCSEngineering kmAreas doit être conforme à un objet KmArea valide."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Engineering Area Shape =====
era:EngAreaShape a sh:NodeShape ;
    sh:targetClass era:EngArea ;
    
    # Default Sleepers Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:defaultSleepersType ;
        sh:in (
            <http://data.europa.eu/949/concepts/sleepers-type/unknownSleepersType>
            <http://data.europa.eu/949/concepts/sleepers-type/composite>
            <http://data.europa.eu/949/concepts/sleepers-type/concrete>
            <http://data.europa.eu/949/concepts/sleepers-type/steel>
            <http://data.europa.eu/949/concepts/sleepers-type/wood>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property defaultSleepersType must have a value from the defined SKOS concept scheme (composite, concrete, steel, wood, or unknown)."@en ;
        sh:message "Die Eigenschaft defaultSleepersType muss einen Wert aus dem definierten SKOS-Konzeptschema haben (Verbundwerkstoff, Beton, Stahl, Holz oder unbekannt)."@de ;
        sh:message "La propriété defaultSleepersType doit avoir une valeur issue du schéma conceptuel SKOS défini (composite, béton, acier, bois ou inconnu)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Balises (optional)
    sh:property [ 
        sh:path era:balises ;
        sh:nodeKind sh:BlankNodeOrIRI ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "An EngArea may have at most one balises property pointing to an RDF list."@en ;
        sh:message "Eine EngArea darf höchstens eine balises-Eigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Une EngArea peut avoir au plus une propriété balises pointant vers une liste RDF."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Balise Groups (optional, multiple allowed)
    sh:property [ 
        sh:path era:baliseGroups ;
        sh:node era:BaliseGroupShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "EngArea baliseGroups must conform to valid BaliseGroup object."@en ;
        sh:message "EngArea baliseGroups muss einem gültigen BaliseGroup-Objekt entsprechen."@de ;
        sh:message "EngArea baliseGroups doit être conforme à un objet BaliseGroup valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Buffer Stops (optional, multiple allowed)
    sh:property [ 
        sh:path era:bufferStops ;
        sh:node era:BufferStopShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "EngArea bufferStops must conform to a valid BufferStop object."@en ;
        sh:message "EngArea bufferStops muss einem gültigen BufferStop-Objekt entsprechen."@de ;
        sh:message "EngArea bufferStops doit être conforme à un objet BufferStop valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Switches (optional, multiple allowed)
    sh:property [ 
        sh:path era:switches ;
        sh:node era:SwitchShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "EngArea switches must conform to valid Switch object."@en ;
        sh:message "EngArea-Schalter müssen einem gültigen Schalterobjekt entsprechen."@de ;
        sh:message "Les commutateurs EngArea doivent être conformes à un objet Switch valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Crossings (optional, multiple allowed)
    sh:property [ 
        sh:path era:crossings ;
        sh:node era:CrossingShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "EngArea crossings must conform to valid Crossing object."@en ;
        sh:message "EngArea-Kreuzungen müssen einem gültigen Kreuzungsobjekt entsprechen."@de ;
        sh:message "Les croisements EngArea doivent être conformes à un objet Crossing valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Level Crossings (optional, multiple allowed)
    sh:property [ 
        sh:path era:levelCrossings ;
        sh:node era:LevelCrossingShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "EngArea levelCrossings must conform to valid LevelCrossing object."@en ;
        sh:message "EngArea levelCrossings muss einem gültigen LevelCrossing-Objekt entsprechen."@de ;
        sh:message "EngArea levelCrossings doit être conforme à un objet LevelCrossing valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Danger Points (optional, multiple allowed)
    sh:property [ 
        sh:path era:dangerPoints ;
        sh:node era:DangerPointShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "EngArea dangerPoints must conform to valid DangerPoint object."@en ;
        sh:message "EngArea dangerPoints muss einem gültigen DangerPoint-Objekt entsprechen."@de ;
        sh:message "EngArea dangerPoints doit être conforme à un objet DangerPoint valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Fouling Points (optional, multiple allowed)
    sh:property [ 
        sh:path era:foulingPoints ;
        sh:node era:FoulingPointShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "EngArea foulingPoints must conform to valid FoulingPoint object."@en ;
        sh:message "EngArea foulingPoints muss einem gültigen FoulingPoint-Objekt entsprechen."@de ;
        sh:message "EngArea foulingPoints doit être conforme à un objet FoulingPoint valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Sleepers (optional, multiple allowed)
    sh:property [ 
        sh:path era:sleepers ;
        sh:node era:SleepersShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "EngArea sleepers must conform to valid Sleepers object."@en ;
        sh:message "EngArea-Schwellen müssen einem gültigen Schwellenobjekt entsprechen."@de ;
        sh:message "Les dormeurs EngArea doivent être conformes à l'objet Sleepers valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Track Usage Paths (optional, multiple allowed)
    sh:property [ 
        sh:path era:trackUsagePaths ;
        sh:node era:TrackUsagePathShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "EngArea trackUsagePaths must conform to valid TrackUsagePath object."@en ;
        sh:message "EngArea trackUsagePaths muss einem gültigen TrackUsagePath-Objekt entsprechen."@de ;
        sh:message "EngArea trackUsagePaths doit être conforme à un objet TrackUsagePath valide."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Fouling Point Shape =====
era:FoulingPointShape a sh:NodeShape ;
    sh:targetClass era:FoulingPoint ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A FoulingPoint may have at most one name (string)."@en ;
        sh:message "Ein FoulingPoint darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un FoulingPoint peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Topological Coordinate (required, can be inline or referenced)
    sh:property [ 
        sh:path era:topologicalCoordinate ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each FoulingPoint must have exactly one topologicalCoordinate that conforms to valid TopologicalCoordinate object."@en ;
        sh:message "Jeder FoulingPoint muss genau ein topologicalCoordinate haben, das einem gültigen TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque FoulingPoint doit avoir exactement un topologicalCoordinate conforme à un objet TopologicalCoordonnée valide."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Kilometric Post Shape =====
era:KilometricPostShape a sh:NodeShape ;
    sh:targetClass era:KilometricPost ;
    
    # Position (required, unsigned integer)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each KilometricPost must have exactly one pos (position as unsigned integer)."@en ;
        sh:message "Jeder KilometricPost muss genau eine Position (Position als vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque KilometricPost doit avoir exactement une pos (position sous forme d'entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Kilometer (required, double - kilometer value)
    sh:property [ 
        sh:path era:kilometer ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each KilometricPost must have exactly one kilometer value (double)."@en ;
        sh:message "Jeder KilometricPost muss genau einen Kilometerwert (double) haben."@de ;
        sh:message "Chaque KilometricPost doit avoir exactement une valeur kilométrique (double)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Kilometer Post Name (optional, string)
    sh:property [ 
        sh:path era:kmPostName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A KilometricPost may have at most one kmPostName (string)."@en ;
        sh:message "Ein KilometricPost darf höchstens einen kmPostName (String) haben."@de ;
        sh:message "Un KilometricPost peut avoir au plus un kmPostName (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Kilometer Area Shape =====
era:KmAreaShape a sh:NodeShape ;
    sh:targetClass era:KmArea ;
    
    # Linear Element Kilometer (optional, multiple allowed)
    sh:property [ 
        sh:path era:linearElementKm ;
        sh:node era:LinearElementKmShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "KmArea linearElementKm must conform to valid LinearElementKm object."@en ;
        sh:message "KmArea linearElementKm muss einem gültigen LinearElementKm-Objekt entsprechen."@de ;
        sh:message "KmArea linearElementKm doit être conforme à un objet LinearElementKm valide."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Level Crossing Shape =====
era:LevelCrossingShape a sh:NodeShape ;
    sh:targetClass era:LevelCrossing ;
    
    # Danger Points (required, one or more)
    sh:property [ 
        sh:path era:dangerPoints ;
        sh:class era:DangerPoint ;
		sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Each LevelCrossing must have at least one dangerPoints that conform to DangerPoint object."@en ;
        sh:message "Jedes LevelCrossing muss mindestens ein dangerPoints haben, das dem DangerPoint-Objekt entspricht."@de ;
        sh:message "Chaque LevelCrossing doit avoir au moins un dangerPoints conforme à l'objet DangerPoint."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Linear Element Accuracy Profile Shape =====
era:LinearElementAccuracyProfileShape a sh:NodeShape ;
    sh:targetClass era:LinearElementAccuracyProfile ;
    
    # Offset Accuracies (optional, RDF list)
    sh:property [ 
        sh:path era:offsetAccuracies ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A LinearElementAccuracyProfile may have at most one offsetAccuracies property pointing to an RDF list."@en ;
        sh:message "Ein LinearElementAccuracyProfile darf höchstens eine offsetAccuracies-Eigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Un LinearElementAccuracyProfile peut avoir au plus une propriété offsetAccuracies pointant vers une liste RDF."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all offsetAccuracies list items are OffsetAccuracy instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the offsetAccuracies list must be instances of era:OffsetAccuracy that conform to OffsetAccuracyShape."@en ;
        sh:message "Alle Elemente in der Liste offsetAccuracies müssen Instanzen von era:OffsetAccuracy sein, die OffsetAccuracyShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste offsetAccuracies doivent être des instances de era:OffsetAccuracy conformes à OffsetAccuracyShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:offsetAccuracies ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                FILTER NOT EXISTS { ?item a era:OffsetAccuracy }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .

# ===== Linear Element Kilometer Shape =====
era:LinearElementKmShape a sh:NodeShape ;
    sh:targetClass era:LinearElementKm ;
    
    # Linear Element (required, can be inline or referenced)
    sh:property [ 
        sh:path era:linearElement ;
        sh:class era:LinearElement ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementKm must have exactly one linearElement that conforms to LinearElementShape."@en ;
        sh:message "Jedes LinearElementKm muss genau ein linearElement haben, das LinearElementShape entspricht."@de ;
        sh:message "Chaque LinearElementKm doit avoir exactement un linearElement conforme à LinearElementShape."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Kilometric Posts (optional, RDF list)
    sh:property [ 
        sh:path era:kilometricPosts ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A LinearElementKm may have at most one kilometricPosts property pointing to an RDF list."@en ;
        sh:message "Ein LinearElementKm darf höchstens eine kilometricPosts-Eigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Un LinearElementKm peut avoir au plus une propriété kilometricPosts pointant vers une liste RDF."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all kilometricPosts list items are KilometricPost instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the kilometricPosts list must be instances of era:KilometricPost that conform to KilometricPostShape."@en ;
        sh:message "Alle Elemente in der Liste kilometricPosts müssen Instanzen von era:KilometricPost sein, die KilometricPostShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste kilometricPosts doivent être des instances de era:KilometricPost conformes à KilometricPostShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:kilometricPosts ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                FILTER NOT EXISTS { ?item a era:KilometricPost }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .

# ===== Location Accuracy Area Shape =====
era:LocationAccuracyAreaShape a sh:NodeShape ;
    sh:targetClass era:LocationAccuracyArea ;
    
    # Accuracy Profiles (optional, multiple allowed)
    sh:property [ 
        sh:path era:accuracyProfiles ;
        sh:node era:LinearElementAccuracyProfileShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "LocationAccuracyArea accuracyProfiles must conform to valid LinearElementAccuracyProfile object."@en ;
        sh:message "LocationAccuracyArea accuracyProfiles muss einem gültigen LinearElementAccuracyProfile-Objekt entsprechen."@de ;
        sh:message "LocationAccuracyArea accuracyProfiles doit être conforme à un objet LinearElementAccuracyProfile valide."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Offset Accuracy Shape =====
era:OffsetAccuracyShape a sh:NodeShape ;
    sh:targetClass era:OffsetAccuracy ;
    
    # Offset (required, unsigned integer - position in meters)
    sh:property [ 
        sh:path era:offset ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OffsetAccuracy must have exactly one offset (unsigned integer, in meters)."@en ;
        sh:message "Jede OffsetAccuracy muss genau einen Offset (vorzeichenlose Ganzzahl in Metern) haben."@de ;
        sh:message "Chaque OffsetAccuracy doit avoir exactement un décalage (entier non signé, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Accuracy (required, unsigned integer - accuracy value in meters)
    sh:property [ 
        sh:path era:accuracy ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OffsetAccuracy must have exactly one accuracy value (unsigned integer, in meters)."@en ;
        sh:message "Jede OffsetAccuracy muss genau einen Genauigkeitswert haben (vorzeichenlose Ganzzahl in Metern)."@de ;
        sh:message "Chaque OffsetAccuracy doit avoir exactement une valeur de précision (entier non signé, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Sleepers Shape =====
era:SleepersShape a sh:NodeShape ;
    sh:targetClass era:Sleepers ;
    
    # Sleepers Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:sleepersType ;
        sh:in (
            <http://data.europa.eu/949/concepts/sleepers-type/unknownSleepersType>
            <http://data.europa.eu/949/concepts/sleepers-type/composite>
            <http://data.europa.eu/949/concepts/sleepers-type/concrete>
            <http://data.europa.eu/949/concepts/sleepers-type/steel>
            <http://data.europa.eu/949/concepts/sleepers-type/wood>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property sleepersType must have a value from the defined SKOS concept scheme (composite, concrete, steel, wood, or unknown)."@en ;
        sh:message "Die Eigenschaft sleepersType muss einen Wert aus dem definierten SKOS-Konzeptschema haben (Verbundwerkstoff, Beton, Stahl, Holz oder unbekannt)."@de ;
        sh:message "La propriété sleepersType doit avoir une valeur issue du schéma conceptuel SKOS défini (composite, béton, acier, bois ou inconnu)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Linear Element Section (required, one or more)
    sh:property [ 
        sh:path era:linearElementSection ;
        sh:node era:LinearElementSectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each Sleepers must have at least one linearElementSection that conform to valid LinearElementSection object."@en ;
        sh:message "Jeder Schwellenwert muss mindestens ein linearElementSection haben, das einem gültigen LinearElementSection-Objekt entspricht."@de ;
        sh:message "Chaque Sleeper doit avoir au moins un linearElementSection conforme à un objet LinearElementSection valide."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Switch Shape =====
era:SwitchShape a sh:NodeShape ;
    sh:targetClass era:Switch ;
    
    # Blade Length (required, double - length in meters)
    sh:property [ 
        sh:path era:bladeLength ;
        sh:datatype xsd:double ;
        sh:minExclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Switch must have exactly one bladeLength (double > 0, in meters)."@en ;
        sh:message "Jeder Switch muss genau einen bladeLength haben (double > 0, in Metern)."@de ;
        sh:message "Chaque Switch doit avoir exactement un bladeLength (double > 0, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Tip Shift (required, double - lateral displacement in meters)
    sh:property [ 
        sh:path era:tipShift ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Switch must have exactly one tipShift value (double, in meters)."@en ;
        sh:message "Jeder Switch muss genau einen tipShift-Wert haben (doppelt, in Metern)."@de ;
        sh:message "Chaque commutateur doit avoir exactement une valeur tipShift (double, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Fouling Points (required, one or more)
    sh:property [ 
        sh:path era:foulingPoints ;
        sh:class era:FoulingPoint ;
		sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Each Switch must have at least one foulingPoints that conform to valid FoulingPoint object."@en ;
        sh:message "Jeder Switch muss mindestens ein foulingPoints haben, das einem gültigen FoulingPoint-Objekt entspricht."@de ;
        sh:message "Chaque commutateur doit avoir au moins un foulingPoints conforme à un objet FoulingPoint valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Route Requires Point Left (optional, multiple allowed)
    sh:property [ 
        sh:path era:routeRequiresPointLeft ;
        sh:class era:TrackUsagePath ;
		sh:nodeKind sh:IRI ;
        sh:message "Switch routeRequiresPointLeft must conform to TrackUsagePath object."@en ;
        sh:message "Schalter routeRequiresPointLeft muss dem TrackUsagePath-Objekt entsprechen."@de ;
        sh:message "Le commutateur routeRequiresPointLeft doit être conforme à l'objet TrackUsagePath."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Route Requires Point Right (optional, multiple allowed)
    sh:property [ 
        sh:path era:routeRequiresPointRight ;
        sh:class era:TrackUsagePath ;
		sh:nodeKind sh:IRI ;
        sh:message "Switch routeRequiresPointRight must conform to valid TrackUsagePath object."@en ;
        sh:message "Schalter routeRequiresPointRight muss einem gültigen TrackUsagePath-Objekt entsprechen."@de ;
        sh:message "Le commutateur routeRequiresPointRight doit être conforme à un objet TrackUsagePath valide."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Track Usage Path Shape =====
era:TrackUsagePathShape a sh:NodeShape ;
    sh:targetClass era:TrackUsagePath ;
    
    # Path Body (required, can be inline or referenced)
    sh:property [ 
        sh:path era:pathBody ;
        sh:node era:NetLinearReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrackUsagePath must have exactly one pathBody that conforms to valid NetLinearReference object."@en ;
        sh:message "Jeder TrackUsagePath muss genau ein pathBody haben, das einem gültigen NetLinearReference-Objekt entspricht."@de ;
        sh:message "Chaque TrackUsagePath doit avoir exactement un pathBody conforme à un objet NetLinearReference valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Has Preceded Track Usage Path (optional, single)
    sh:property [ 
        sh:path era:hasPreceededTrackUsagePath ;
        sh:class era:TrackUsagePath ;
		sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "A TrackUsagePath may have at most one hasPreceededTrackUsagePath that conforms to valid TrackUsagePath object."@en ;
        sh:message "Ein TrackUsagePath kann höchstens ein hasPreceededTrackUsagePath haben, das einem gültigen TrackUsagePath-Objekt entspricht."@de ;
        sh:message "Un TrackUsagePath peut avoir au plus un hasPreceededTrackUsagePath conforme à un objet TrackUsagePath valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Switches (optional, multiple allowed)
    sh:property [ 
        sh:path era:switches ;
        sh:class era:Switch ;
		sh:nodeKind sh:IRI ;
        sh:message "TrackUsagePath switches must conform to SwitchShape."@en ;
        sh:message "TrackUsagePath-Schalter müssen SwitchShape entsprechen."@de ;
        sh:message "Les commutateurs TrackUsagePath doivent être conformes à SwitchShape."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Derailers (optional, multiple allowed)
    sh:property [ 
        sh:path era:derailers ;
        sh:class era:Derailer ;
		sh:nodeKind sh:IRI ;
        sh:message "TrackUsagePath derailers must conform to DerailerShape."@en ;
        sh:message "TrackUsagePath-Entgleiser müssen DerailerShape entsprechen."@de ;
        sh:message "Les dérailleurs TrackUsagePath doivent être conformes à DerailerShape."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Level Crossings (optional, multiple allowed)
    sh:property [ 
        sh:path era:levelCrossings ;
        sh:class era:LevelCrossing ;
		sh:nodeKind sh:IRI ;
        sh:message "TrackUsagePath levelCrossings must conform to LevelCrossingShape."@en ;
        sh:message "TrackUsagePath levelCrossings muss LevelCrossingShape entsprechen."@de ;
        sh:message "TrackUsagePath levelCrossings doit être conforme à LevelCrossingShape."@fr ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Linear Element Section Shape =====
era:LinearElementSectionShape a sh:NodeShape ;
    sh:targetClass era:LinearElementSection ;
    
    # On Element (required, reference to the linear element - can be inline or referenced)
    sh:property [ 
        sh:path era:onElement ;
        sh:class era:LinearElement ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one onElement that conforms to a valid LinearElement."@en ;
        sh:message "Jeder LinearElementSection muss genau ein onElement haben, das einem gültigen LinearElement entspricht."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement un onElement conforme à un LinearElement valide."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Start Offset From Origin (required, double >= 0 - distance in meters from element origin)
    sh:property [ 
        sh:path era:startOffsetFromOrigin ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one startOffsetFromOrigin (non-negative double, in meters)."@en ;
        sh:message "Jeder LinearElementSection muss genau ein startOffsetFromOrigin (nicht negatives Double, in Metern) haben."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement un startOffsetFromOrigin (double non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # End Offset From Origin (required, double >= 0 - distance in meters from element origin)
    sh:property [ 
        sh:path era:endOffsetFromOrigin ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one endOffsetFromOrigin (non-negative double, in meters)."@en ;
        sh:message "Jeder LinearElementSection muss genau ein endOffsetFromOrigin (nicht negatives Double, in Metern) haben."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement un endOffsetFromOrigin (double non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Applies In Both Directions (required, boolean)
    sh:property [ 
        sh:path era:appliesInBothDirections ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one appliesInBothDirections value (boolean)."@en ;
        sh:message "Jeder LinearElementSection muss genau einen appliesInBothDirections-Wert (boolean) haben."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement une valeur appliesInBothDirections (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint: startOffsetFromOrigin must be less than endOffsetFromOrigin
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The startOffsetFromOrigin must be less than endOffsetFromOrigin."@en ;
        sh:message "Der startOffsetFromOrigin muss kleiner als endOffsetFromOrigin sein."@de ;
        sh:message "Le startOffsetFromOrigin doit être inférieur à endOffsetFromOrigin."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            
            SELECT $this
            WHERE {
                $this era:startOffsetFromOrigin ?start ;
                      era:endOffsetFromOrigin ?end .
                FILTER (?start >= ?end)
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
	
	
	
# Shape to check that at least one ETCS Engineering class exists
era:AtLeastOneETCSEngineeringClassShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            SELECT ?this
            WHERE {
                BIND (era:ValidationRoot as ?this)
            }
        """ ;
    ] ;
    
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The data must contain at least one instance of the required ETCS Engineering classes (e.g., BufferStop, Switch, BaliseGroup, TrackUsagePath, etc.). This error may indicate that the provided data significantly deviates from the expected ETCS Engineering model as defined in the extended ERA ontology."@en ;
        sh:message "Die Daten müssen mindestens eine Instanz der erforderlichen ETCS Engineering-Klassen enthalten (z. B. BufferStop, Switch, BaliseGroup, TrackUsagePath usw.). Dieser Fehler kann darauf hinweisen, dass die bereitgestellten Daten erheblich vom erwarteten ETCS-Engineering-Modell abweichen, wie es in der erweiterten ERA-Ontologie definiert ist."@de ;
        sh:message "Les données doivent contenir au moins une instance des classes d'ingénierie ETCS requises (par exemple, BufferStop, Switch, BaliseGroup, TrackUsagePath, etc.). Cette erreur peut indiquer que les données fournies s'écartent considérablement du modèle d'ingénierie ETCS attendu tel que défini dans l'ontologie ERA étendue."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    # Core Track Assets
                    { ?instance rdf:type era:BufferStop . }
                    UNION { ?instance rdf:type era:Switch . }
                    UNION { ?instance rdf:type era:Crossing . }
                    UNION { ?instance rdf:type era:LevelCrossing . }
                    
                    # ETCS Signaling Components
                    UNION { ?instance rdf:type era:BaliseGroup . }
                    UNION { ?instance rdf:type era:Balise . }
                    
                    # Track Components
                    UNION { ?instance rdf:type era:Sleepers . }
                    
                    # Safety Points
                    UNION { ?instance rdf:type era:DangerPoint . }
                    UNION { ?instance rdf:type era:FoulingPoint . }
                    
                    # Operational Path
                    UNION { ?instance rdf:type era:TrackUsagePath . }
                    
                    # Container Areas
                    UNION { ?instance rdf:type era:EngArea . }
                    UNION { ?instance rdf:type era:LocationAccuracyArea . }
                    UNION { ?instance rdf:type era:KmArea . }
                    
                    # Accuracy and Location
                    UNION { ?instance rdf:type era:LinearElementAccuracyProfile . }
                    UNION { ?instance rdf:type era:OffsetAccuracy . }
                    UNION { ?instance rdf:type era:LinearElementKm . }
                    UNION { ?instance rdf:type era:KilometricPost . }
                    
                    # Top-Level Container
                    UNION { ?instance rdf:type era:ETCSEngineering . }
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .