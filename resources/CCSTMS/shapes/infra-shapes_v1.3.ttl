@prefix era: <http://data.europa.eu/949/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

era:AxleLoadSpeedProfileShape a sh:NodeShape ;
    sh:targetClass era:AxleLoadSpeedProfile ;
    sh:message "Validates the structure and constraints of an AxleLoadSpeedProfile instance according to the ERA ontology."@en ;
    sh:message "Validiert die Struktur und Einschränkungen einer AxleLoadSpeedProfile-Instanz gemäß der ERA-Ontologie."@de ;
    sh:message "Valide la structure et les contraintes d'une instance AxleLoadSpeedProfile selon l'ontologie ERA."@fr ;
    
    # Start Position (required, unsigned integer)
    sh:property [ 
        sh:path era:startPos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AxleLoadSpeedProfile must have exactly one startPos (unsigned integer)."@en ;
        sh:message "Jedes AxleLoadSpeedProfile muss genau eine startPos (vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque AxleLoadSpeedProfile doit avoir exactement un startPos (entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # End Position (required, unsigned integer)
    sh:property [ 
        sh:path era:endPos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AxleLoadSpeedProfile must have exactly one endPos (unsigned integer)."@en ;
        sh:message "Jedes AxleLoadSpeedProfile muss genau eine endPos (vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque AxleLoadSpeedProfile doit avoir exactement un endPos (entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Speed (required, unsigned integer)
    sh:property [ 
        sh:path era:speed ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AxleLoadSpeedProfile must have exactly one speed (unsigned integer)."@en ;
        sh:message "Jedes AxleLoadSpeedProfile muss genau eine Geschwindigkeit (vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque AxleLoadSpeedProfile doit avoir exactement une vitesse (entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Axle Load Category (required, controlled vocabulary)
    sh:property [ 
        sh:path era:axleLoadCategory ;
        sh:in (
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_A>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_HS17>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B1>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4XL>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E5>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property axleLoadCategory must have a value from the defined SKOS concept scheme."@en ;
        sh:message "Die Eigenschaft axleLoadCategory muss einen Wert aus dem definierten SKOS-Konzeptschema haben."@de ;
        sh:message "La propriété axleLoadCategory doit avoir une valeur issue du schéma conceptuel SKOS défini."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint: startPos must be less than endPos
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The startPos must be less than endPos."@en ;
        sh:message "Der startPos muss kleiner als endPos sein."@de ;
        sh:message "Le startPos doit être inférieur à endPos."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            
            SELECT $this
            WHERE {
                $this era:startPos ?start ;
                      era:endPos ?end .
                FILTER (?start >= ?end)
            }
        """ ;
        sh:severity sh:Violation ;
    ] .


era:BaliseGroupShape a sh:NodeShape ;
    sh:targetClass era:BaliseGroup ;
    era:additionalInfo "This finding relates to the BaliseGroup structural constraints. Possible causes: (1) era:nid_bg is missing or outside the range 0-16383. (2) era:nid_c is missing or outside the range 0-1023. (3) era:etcsMarker references an invalid ETCSMarker instance. (4) era:linkOrientationDirection has a value not from the defined concept scheme (both, same, or opposite). (5) era:bgFunction has a value not from the defined concept scheme. (6) era:balises is missing, appears more than once, or does not point to an RDF list." ;
    
    # NID_BG: Balise Group Identity Number (0-16383)
    sh:property [ 
        sh:path era:nid_bg ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "nid_bg must be an unsigned integer between 0 and 16383."@en ;
        sh:message "nid_bg muss eine vorzeichenlose Ganzzahl zwischen 0 und 16383 sein."@de ;
        sh:message "nid_bg doit être un entier non signé compris entre 0 et 16383."@fr ;
    ] ;
    
    # NID_C: Country/Region Identity Number (0-1023)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "nid_c must be an unsigned integer between 0 and 1023."@en ;
        sh:message "nid_c muss eine vorzeichenlose Ganzzahl zwischen 0 und 1023 sein."@de ;
        sh:message "nid_c doit être un entier non signé compris entre 0 et 1023."@fr ;
    ] ;
    
    # ETCS Marker reference
    sh:property [ 
        sh:path era:etcsMarker ;
        sh:class era:ETCSMarker ;
		sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "etcsMarker must reference an instance of a proper era:ETCSMarker."@en ;
        sh:message "etcsMarker muss auf eine Instanz eines richtigen era:ETCSMarker verweisen."@de ;
        sh:message "etcsMarker doit faire référence à une instance d'un era:ETCSMarker approprié."@fr ;
    ] ;
    
    # Link Orientation Direction (required, controlled vocabulary)
    sh:property [ 
        sh:path era:linkOrientationDirection ;
        sh:in (
            <http://data.europa.eu/949/concepts/orientations/both>
            <http://data.europa.eu/949/concepts/orientations/same>
            <http://data.europa.eu/949/concepts/orientations/opposite>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "linkOrientationDirection must have a value from the defined SKOS concept scheme (both, same, or opposite)."@en ;
        sh:message "linkOrientationDirection muss einen Wert aus dem definierten SKOS-Konzeptschema haben (beide, gleich oder entgegengesetzt)."@de ;
        sh:message "linkOrientationDirection doit avoir une valeur du schéma conceptuel SKOS défini (les deux, identique ou opposé)."@fr ;
    ] ;
    
    # Balise Group Function (required, controlled vocabulary)
    sh:property [ 
        sh:path era:bgFunction ;
        sh:in (
            <http://data.europa.eu/949/concepts/balise-group-function/location>
            <http://data.europa.eu/949/concepts/balise-group-function/sessionManagement>
            <http://data.europa.eu/949/concepts/balise-group-function/networkRegistration>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "bgFunction must have a value from the defined SKOS concept scheme."@en ;
        sh:message "bgFunction muss einen Wert aus dem definierten SKOS-Konzeptschema haben."@de ;
        sh:message "bgFunction doit avoir une valeur du schéma conceptuel SKOS défini."@fr ;
    ] ;
    
    # Balises list (RDF list containing 1-8 Balise instances)
    sh:property [
        sh:path era:balises ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A BaliseGroup must have exactly one era:balises property pointing to an RDF list."@en ;
        sh:message "Eine BaliseGroup muss genau eine era:balises-Eigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Un BaliseGroup doit avoir exactement une propriété era:balises pointant vers une liste RDF."@fr ;
    ] ;   
    
    # SPARQL constraint to validate list length (1-8 items)
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "The era:balises list must contain between 1 and 8 items."@en ;
        sh:message "Die Liste era:balises muss zwischen 1 und 8 Elemente enthalten."@de ;
        sh:message "La liste era:balises doit contenir entre 1 et 8 éléments."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:balises ?list .
                {
                    SELECT $this (COUNT(?item) AS ?count)
                    WHERE {
                        $this era:balises ?list .
                        ?list rdf:rest*/rdf:first ?item .
                    }
                    GROUP BY $this
                }
                
                # Violation if count is outside valid range
                FILTER (?count < 1 || ?count > 8)
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate each list item is a Balise
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the era:balises list must be instances of era:Balise."@en ;
        sh:message "Alle Elemente in der Liste era:balises müssen Instanzen von era:Balise sein."@de ;
        sh:message "Tous les éléments de la liste era:balises doivent être des instances de era:Balise."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:balises ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                # Violation if item is not a Balise
                FILTER NOT EXISTS { ?item a era:Balise }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .

# ===== Balise Shape =====
era:BaliseShape a sh:NodeShape ;
    sh:targetClass era:Balise ;
    
    # Topological Coordinate (required, can be inline or referenced)
    sh:property [ 
        sh:path era:topologicalCoordinate ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one topologicalCoordinate that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jede Balise muss genau ein topologicalCoordinate haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque Balise doit avoir exactement un topologicalCoordinate conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Bridge Shape =====
era:BridgeShape a sh:NodeShape ;
    sh:targetClass era:Bridge ;
    
    # Area Reference (required, can be inline or referenced)
    sh:property [ 
        sh:path era:areaReference ;
        sh:node era:NetAreaReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Bridge must have exactly one areaReference that conforms to NetAreaReference object."@en ;
        sh:message "Jede Bridge muss genau ein areaReference haben, das dem NetAreaReference-Objekt entspricht."@de ;
        sh:message "Chaque pont doit avoir exactement un areaReference conforme à l'objet NetAreaReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Bridge may have at most one name (string)."@en ;
        sh:message "Eine Bridge darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un Bridge peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Buffer Stop Shape =====
era:BufferStopShape a sh:NodeShape ;
    sh:targetClass era:BufferStop ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A BufferStop may have at most one name (string)."@en ;
        sh:message "Ein BufferStop darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un BufferStop peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Net Point Reference (required, can be inline or referenced)
    sh:property [ 
        sh:path era:netPointReference ;
        sh:node era:NetPointReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each BufferStop must have exactly one netPointReference that conforms to NetPointReference object."@en ;
        sh:message "Jeder BufferStop muss genau ein netPointReference haben, das dem NetPointReference-Objekt entspricht."@de ;
        sh:message "Chaque BufferStop doit avoir exactement un netPointReference conforme à l'objet NetPointReference."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Cant Point Shape =====
era:CantPointShape a sh:NodeShape ;
    sh:targetClass era:CantPoint ;
    
    # Element Geometry Position (required, double)
    sh:property [ 
        sh:path era:elementGeometryPos ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CantPoint must have exactly one elementGeometryPos (double)."@en ;
        sh:message "Jeder CantPoint muss genau ein elementGeometryPos (double) haben."@de ;
        sh:message "Chaque CantPoint doit avoir exactement un elementGeometryPos (double)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Applied Cant (required, double - typically in millimeters)
    sh:property [ 
        sh:path era:appliedCant ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CantPoint must have exactly one appliedCant value (double)."@en ;
        sh:message "Jeder CantPoint muss genau einen appliedCant-Wert (double) haben."@de ;
        sh:message "Chaque CantPoint doit avoir exactement une valeur appliedCant (double)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Cant Sample Point Shape =====
era:CantSamplePointShape a sh:NodeShape ;
    sh:targetClass era:CantSamplePoint ;
    
    # Position (required, unsigned integer)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CantSamplePoint must have exactly one pos (position as unsigned integer)."@en ;
        sh:message "Jeder CantSamplePoint muss genau eine Position (Position als vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque CantSamplePoint doit avoir exactement une position (position sous forme d'entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Sample Point Cant (required, signed integer - can be negative)
    sh:property [ 
        sh:path era:samplePointCant ;
        sh:datatype xsd:int ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CantSamplePoint must have exactly one samplePointCant value (signed integer)."@en ;
        sh:message "Jeder CantSamplePoint muss genau einen samplePointCant-Wert (vorzeichenbehaftete Ganzzahl) haben."@de ;
        sh:message "Chaque CantSamplePoint doit avoir exactement une valeur samplePointCant (entier signé)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Crossing Shape =====
era:CrossingShape a sh:NodeShape ;
    sh:targetClass era:Crossing ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Crossing may have at most one name (string)."@en ;
        sh:message "Eine Kreuzung darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un croisement peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Is Switchable (required, boolean)
    sh:property [ 
        sh:path era:isSwitchable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Crossing must have exactly one isSwitchable value (boolean)."@en ;
        sh:message "Jede Kreuzung muss genau einen isSwitchable-Wert (boolean) haben."@de ;
        sh:message "Chaque croisement doit avoir exactement une valeur isSwitchable (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Topological Coordinates (required, exactly 2)
    sh:property [ 
        sh:path era:topologicalCoordinates ;
        sh:node era:TopologicalCoordinateShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:message "Each Crossing must have exactly 2 topologicalCoordinates that conform to TopologicalCoordinate object."@en ;
        sh:message "Jede Kreuzung muss genau 2 topologicalCoordinates haben, die dem TopologicalCoordinate-Objekt entsprechen."@de ;
        sh:message "Chaque croisement doit avoir exactement 2 topologicalCoordinates conformes à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Current Limitation Shape =====
era:CurrentLimitationShape a sh:NodeShape ;
    sh:targetClass era:CurrentLimitation ;
    
    # Maximum Current (required, unsigned integer - typically in Amperes)
    sh:property [ 
        sh:path era:maxCurrent ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CurrentLimitation must have exactly one maxCurrent value (unsigned integer)."@en ;
        sh:message "Jede CurrentLimitation muss genau einen maxCurrent-Wert (vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque CurrentLimitation doit avoir exactement une valeur maxCurrent (entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Linear Element Sections (required, one or more)
    sh:property [ 
        sh:path era:linearElementSections ;
        sh:node era:LinearElementSectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each CurrentLimitation must have at least one linearElementSections that conform to LinearElementSection object."@en ;
        sh:message "Jede CurrentLimitation muss mindestens ein linearElementSections haben, das dem LinearElementSection-Objekt entspricht."@de ;
        sh:message "Chaque CurrentLimitation doit avoir au moins un linearElementSections conforme à l'objet LinearElementSection."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Curve Sample Point Shape =====
era:CurveSamplePointShape a sh:NodeShape ;
    sh:targetClass era:CurveSamplePoint ;
    
    # Position (required, unsigned integer)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CurveSamplePoint must have exactly one pos (position as unsigned integer)."@en ;
        sh:message "Jeder CurveSamplePoint muss genau eine Position (Position als vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque CurveSamplePoint doit avoir exactement une position (position sous forme d'entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Sample Curve Radius (required, signed integer - can be negative for direction)
    sh:property [ 
        sh:path era:sampleCurveRadius ;
        sh:datatype xsd:int ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CurveSamplePoint must have exactly one sampleCurveRadius value (signed integer)."@en ;
        sh:message "Jeder CurveSamplePoint muss genau einen sampleCurveRadius-Wert (vorzeichenbehaftete Ganzzahl) haben."@de ;
        sh:message "Chaque CurveSamplePoint doit avoir exactement une valeur sampleCurveRadius (entier signé)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Derailer Shape =====
era:DerailerShape a sh:NodeShape ;
    sh:targetClass era:Derailer ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Derailer may have at most one name (string)."@en ;
        sh:message "Ein Derailer darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un dérailleur peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Net Point Reference (required, can be inline or referenced)
    sh:property [ 
        sh:path era:netPointReference ;
        sh:node era:NetPointReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Derailer must have exactly one netPointReference that conforms to NetPointReference object."@en ;
        sh:message "Jeder Derailer muss genau ein netPointReference haben, das dem NetPointReference-Objekt entspricht."@de ;
        sh:message "Chaque dérailleur doit avoir exactement un netPointReference conforme à l'objet NetPointReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Derail to Right (required, boolean - direction of derailment)
    sh:property [ 
        sh:path era:derailToRight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Derailer must have exactly one derailToRight value (boolean)."@en ;
        sh:message "Jeder Derailer muss genau einen derailToRight-Wert (boolean) haben."@de ;
        sh:message "Chaque dérailleur doit avoir exactement une valeur derailToRight (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Reversal Time (required, unsigned integer - typically in seconds)
    sh:property [ 
        sh:path era:reversalTime ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Derailer must have exactly one reversalTime value (unsigned integer)."@en ;
        sh:message "Jeder Derailer muss genau einen reversalTime-Wert (vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque dérailleur doit avoir exactement une valeur reversalTime (entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Marker Shape =====
era:ETCSMarkerShape a sh:NodeShape ;
    sh:targetClass era:ETCSMarker ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "An ETCSMarker may have at most one name (string)."@en ;
        sh:message "Ein ETCSMarker darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un ETCSMarker peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Net Point Reference (required, can be inline or referenced)
    sh:property [ 
        sh:path era:netPointReference ;
        sh:node era:NetPointReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSMarker must have exactly one netPointReference that conforms to NetPointReference object."@en ;
        sh:message "Jeder ETCSMarker muss genau ein netPointReference haben, das dem NetPointReference-Objekt entspricht."@de ;
        sh:message "Chaque ETCSMarker doit avoir exactement un netPointReference conforme à l'objet NetPointReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Marker Function Stop (required, boolean - indicates if marker is a stop marker)
    sh:property [ 
        sh:path era:markerFunctionStop ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSMarker must have exactly one markerFunctionStop value (boolean)."@en ;
        sh:message "Jeder ETCSMarker muss genau einen markerFunctionStop-Wert (boolean) haben."@de ;
        sh:message "Chaque ETCSMarker doit avoir exactement une valeur markerFunctionStop (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Functional Area Shape =====
