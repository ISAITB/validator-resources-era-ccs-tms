        sh:message "Jede FunctionalArea muss genau ein versionTimestamp (dateTime) haben."@de ;
        sh:message "Chaque FunctionalArea doit avoir exactement un versionTimestamp (dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Points (optional, multiple allowed)
