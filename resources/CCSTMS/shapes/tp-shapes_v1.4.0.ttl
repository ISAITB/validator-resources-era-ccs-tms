    sh:description "defines EULYNX RaSTA identifier for the field object controller" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:Controller-portNumber
    a sh:PropertyShape ;
    sh:path era:portNumber ;
    sh:name "Port Number" ;
    sh:description "defines the port number for communication purposes" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:Controller-eulynxBaseline
    a sh:PropertyShape ;
    sh:path era:eulynxBaseline ;
    sh:name "EULYNX Baseline" ;
    sh:description "defines EULYNX baseline for the filed object controller" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:Controller-ocVersion
    a sh:PropertyShape ;
    sh:path era:ocVersion ;
    sh:name "Object-Controller Version" ;
    sh:description "defines the EULYNX field object controller version" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSMarker ########################################################
tp-sh:ETCSMarkerShape
    a sh:NodeShape ;
    sh:targetClass era:ETCSMarker ;
    sh:name "ETCSMarker" ;
    sh:description "Defines the ETCS Marker Boards" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property tp-sh:ETCSMarker-markerType ;
    sh:property tp-sh:ETCSMarker-acknowledgementDistance ;
    sh:property tp-sh:ETCSMarker-maxTransitionSpeed ;
    sh:property tp-sh:ETCSMarker-offsetTransitionUnreachable ;
    sh:severity sh:Violation ;
    .

tp-sh:ETCSMarker-markerType
    a sh:PropertyShape ;
    sh:path era:markerType ;
    sh:name "markerType" ;
    sh:description "Defines the type of marker board associated" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/marker-function/exit> <http://data.europa.eu/949/concepts/marker-function/entry> <http://data.europa.eu/949/concepts/marker-function/intermediate> ) ;
    sh:message "Value must be one of the CCSTMS-scoped MarkerFunction concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:ETCSMarker-acknowledgementDistance
    a sh:PropertyShape ;
    sh:path era:acknowledgementDistance ;
    sh:name "acknowledgementDistance" ;
    sh:description "Defines the distance at which the driver should acknowledge a visual/audio indication on the DMI" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:severity sh:Violation ;
    .

tp-sh:ETCSMarker-maxTransitionSpeed
    a sh:PropertyShape ;
    sh:path era:maxTransitionSpeed ;
    sh:name "Maximum Transition Speed" ;
    sh:description "Defines the maximum allowed speed during transition" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:severity sh:Violation ;
    .

tp-sh:ETCSMarker-offsetTransitionUnreachable
    a sh:PropertyShape ;
    sh:path era:offsetTransitionUnreachable ;
    sh:name "offsetTransitionUnreachable" ;
    sh:description "Definesa distance from LRBG that indicates the point beyond which a transition becomes unreachable." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:severity sh:Violation ;
    .

