### SwitchableTracksideAsset ##########################################
tp-sh:SwitchableTracksideAssetShape
    a sh:NodeShape ;
    sh:targetClass era:SwitchableTracksideAsset ;
    sh:name "SwitchableTracksideAsset" ;
    sh:description "Defines Switchable Trackside Asset" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property tp-sh:SwitchableTracksideAsset-name ;
    sh:property tp-sh:SwitchableTracksideAsset-switchableTracksideAssetSections ;
    sh:property tp-sh:SwitchableTracksideAsset-protectedInfraElements ;
    sh:property tp-sh:SwitchableTracksideAsset-dependenciesType ;
    sh:property tp-sh:SwitchableTracksideAsset-switchableTracksideAssetsDependencies ;
    sh:property tp-sh:SwitchableTracksideAsset-runTime ;
    sh:severity sh:Violation ;
    .

tp-sh:SwitchableTracksideAsset-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this asset, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für dieses Asset, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cet actif, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

tp-sh:SwitchableTracksideAsset-switchableTracksideAssetSections
    a sh:PropertyShape ;
    sh:path era:switchableTracksideAssetSections ;
    sh:name "Switchable Trackside Asset Section" ;
    sh:description "Composes of Switchable Trackside Asset Sections" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:SwitchableTracksideAssetSectionShape ;
    sh:message "switchableTracksideAssetSections must be a well-formed SwitchableTracksideAssetSection (blank node or IRI)."@en ;
    sh:message "switchableTracksideAssetSections muss ein wohlgeformtes SwitchableTracksideAssetSection sein (Blank Node oder IRI)."@de ;
    sh:message "switchableTracksideAssetSections doit être un SwitchableTracksideAssetSection bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:SwitchableTracksideAsset-protectedInfraElements
    a sh:PropertyShape ;
    sh:path era:protectedInfraElements ;
    sh:name "Protected Infrastructure Elements" ;
    sh:description "Composes of Protected Infra Element" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:ProtectedInfraElementShape ;
    sh:message "protectedInfraElements must be a well-formed ProtectedInfraElement (blank node or IRI)."@en ;
    sh:message "protectedInfraElements muss ein wohlgeformtes ProtectedInfraElement sein (Blank Node oder IRI)."@de ;
    sh:message "protectedInfraElements doit être un ProtectedInfraElement bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:SwitchableTracksideAsset-dependenciesType
    a sh:PropertyShape ;
    sh:path era:dependenciesType ;
    sh:name "dependenciesType" ;
    sh:description "defines dependencies between n Switchable Trackside Asset Sections" ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/dependency-type/exclusive> <http://data.europa.eu/949/concepts/dependency-type/equivalent> <http://data.europa.eu/949/concepts/dependency-type/specific> ) ;
    sh:message "Value must be one of the CCSTMS-scoped DependencyType concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von DependencyType entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de DependencyType."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:SwitchableTracksideAsset-switchableTracksideAssetsDependencies
    a sh:PropertyShape ;
    sh:path era:switchableTracksideAssetsDependencies ;
    sh:name "Switchable Trackside Assets Dependencies" ;
    sh:description "contains row-wise bit matrix with column = index of the element in DriveProtectionSectionGroup. 0 means not allowed to use ; 1 means allowed to use for rail traffic. Each line in the matrix contains a valid state of the DriveProtectionSectionGroup ; Use only if DPSDependencyType == Specific" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:severity sh:Violation ;
    era:additionalInfo "This property's own description states it is only meant to be used when dependenciesType on this same object is specific - it encodes a row-wise bit matrix, where each column corresponds to the index of an element in the DriveProtectionSectionGroup, 0 means that element may not be used and 1 means it may, and each row of the matrix describes one valid overall state of the group. This property has neither minCount nor maxCount, so its own absence is not itself a problem, and it may carry several values (rows). There is no custom message defined for this specific check, so the validation engine's own generic text is shown if a value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung dieser Eigenschaft besagt, dass sie nur verwendet werden soll, wenn dependenciesType an demselben Objekt specific ist - sie kodiert eine zeilenweise Bit-Matrix, bei der jede Spalte dem Index eines Elements in der DriveProtectionSectionGroup entspricht, 0 bedeutet, dass dieses Element nicht verwendet werden darf, und 1, dass es verwendet werden darf, und jede Zeile der Matrix beschreibt einen gültigen Gesamtzustand der Gruppe. Diese Eigenschaft hat weder minCount noch maxCount, ihr eigenes Fehlen ist also kein Problem für sich, und sie kann mehrere Werte (Zeilen) tragen. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine angezeigt, wenn ein vorhandener Wert keine gültige vorzeichenlose Ganzzahl ist."@de ;
    era:additionalInfo "La propre description de cette propriété indique qu'elle n'est censée être utilisée que lorsque dependenciesType sur ce même objet est specific - elle code une matrice de bits ligne par ligne, où chaque colonne correspond à l'index d'un élément dans le DriveProtectionSectionGroup, 0 signifiant que cet élément ne peut pas être utilisé et 1 qu'il le peut, et chaque ligne de la matrice décrit un état global valide du groupe. Cette propriété n'a ni minCount ni maxCount, son absence n'est donc pas un problème en soi, et elle peut porter plusieurs valeurs (lignes). Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché si une valeur présente n'est pas un entier non signé valide."@fr ;
    .

tp-sh:SwitchableTracksideAsset-runTime
    a sh:PropertyShape ;
    sh:path era:runTime ;
    sh:name "runTime" ;
    sh:description "Defines the total time required for the DPS(s) in a DPS Group to switch from one position to the other" ;
    sh:order 7 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "runTime is stored with a scaling exponent of -1: the raw stored integer must be multiplied by 0.1 to get the actual physical value in seconds - a stored value of 50 means an actual run time of 5.0 seconds, not 50. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "runTime wird mit einem Skalierungsexponenten von -1 gespeichert: der roh gespeicherte Ganzzahlwert muss mit 0,1 multipliziert werden, um den tatsächlichen physikalischen Wert in Sekunden zu erhalten - ein gespeicherter Wert von 50 bedeutet eine tatsächliche Laufzeit von 5,0 Sekunden, nicht 50. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "runTime est stocké avec un exposant d'échelle de -1 : l'entier brut stocké doit être multiplié par 0,1 pour obtenir la valeur physique réelle en secondes - une valeur stockée de 50 signifie un temps de fonctionnement réel de 5,0 secondes, non 50. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

### SwitchableTracksideAssetSection ###################################
tp-sh:SwitchableTracksideAssetSectionShape
    a sh:NodeShape ;
    sh:targetClass era:SwitchableTracksideAssetSection ;
    sh:name "SwitchableTracksideAssetSection" ;
    sh:description "Defines Switchable Trackside Asset Section" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property tp-sh:SwitchableTracksideAssetSection-name ;
    sh:property tp-sh:SwitchableTracksideAssetSection-linearElementSection ;
    sh:property tp-sh:SwitchableTracksideAssetSection-maxFlankProtectionSpeed ;
    sh:severity sh:Violation ;
    .

tp-sh:SwitchableTracksideAssetSection-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this section, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diesen Abschnitt, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cette section, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

tp-sh:SwitchableTracksideAssetSection-linearElementSection
    a sh:PropertyShape ;
    sh:path era:linearElementSection ;
    sh:name "linearElementSection" ;
    sh:description "Composes of the Linear Element Section" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:infra-LinearElementSectionShape ;
    sh:message "linearElementSection must be a well-formed LinearElementSection (blank node or IRI)."@en ;
    sh:message "linearElementSection muss ein wohlgeformtes LinearElementSection sein (Blank Node oder IRI)."@de ;
    sh:message "linearElementSection doit être un LinearElementSection bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:SwitchableTracksideAssetSection-maxFlankProtectionSpeed
    a sh:PropertyShape ;
    sh:path era:maxFlankProtectionSpeed ;
    sh:name "Maximum Flank Protection Speed" ;
    sh:description "Defines the Maximum Speed Allowed on the Switchable Trackside Asset when it is set for Flank Protection" ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "maxFlankProtectionSpeed's own description ties this specifically to the case where the asset is set to provide flank protection - guarding against a train straying into an adjacent, potentially conflicting route - rather than to its normal running speed. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von maxFlankProtectionSpeed verknüpft dies speziell mit dem Fall, dass das Asset zum Flankenschutz eingestellt ist - dem Schutz davor, dass ein Zug in eine benachbarte, möglicherweise konfliktäre Fahrstraße gerät -, nicht mit seiner normalen Fahrgeschwindigkeit. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "La propre description de maxFlankProtectionSpeed relie ceci spécifiquement au cas où l'actif est configuré pour assurer une protection de flanc - protéger contre le fait qu'un train dévie vers un itinéraire adjacent potentiellement conflictuel - plutôt qu'à sa vitesse de marche normale. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

### FoulingSection ####################################################
tp-sh:FoulingSectionShape
    a sh:NodeShape ;
    sh:targetClass era:FoulingSection ;
    sh:name "FoulingSection" ;
    sh:description "Defines an fouling section for a section of track" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:sparql tp-sh:FoulingSection-dependencies-irreflexive ;
    sh:property tp-sh:FoulingSection-name ;
    sh:property tp-sh:FoulingSection-linearReferences ;
    sh:property tp-sh:FoulingSection-dependencies ;
    sh:severity sh:Violation ;
    .

tp-sh:FoulingSection-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this fouling section, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diesen Grenzbereich, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cette section d'encombrement, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

tp-sh:FoulingSection-linearReferences
    a sh:PropertyShape ;
    sh:path era:linearReferences ;
    sh:name "linearReferences" ;
    sh:description "References Linear Element Sections" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:infra-LinearElementSectionShape ;
    sh:message "linearReferences must be a well-formed LinearElementSection (blank node or IRI)."@en ;
    sh:message "linearReferences muss ein wohlgeformtes LinearElementSection sein (Blank Node oder IRI)."@de ;
    sh:message "linearReferences doit être un LinearElementSection bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:FoulingSection-dependencies
    a sh:PropertyShape ;
    sh:path era:dependencies ;
    sh:name "dependencies" ;
    sh:description "is dependent on the fouling sections" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:class era:FoulingSection ;
    sh:message "dependencies must reference an existing era:FoulingSection by IRI."@en ;
    sh:message "dependencies muss über eine IRI auf ein bestehendes era:FoulingSection verweisen."@de ;
    sh:message "dependencies doit référencer un era:FoulingSection existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:FoulingSection-dependencies-irreflexive
    a sh:SPARQLConstraint ;
    sh:prefixes tp-sh:PrefixDeclarations ;
    sh:message "era:dependencies is an owl:IrreflexiveProperty: a FoulingSection must not point at itself."@en ;
    sh:message "era:dependencies ist eine owl:IrreflexiveProperty: ein FoulingSection darf nicht auf sich selbst verweisen."@de ;
    sh:message "era:dependencies est une owl:IrreflexiveProperty : un FoulingSection ne doit pas pointer vers lui-même."@fr ;
    sh:select """
            SELECT $this
            WHERE { $this era:dependencies $this }
        """ ;
    .

### ControlledInfraElement ############################################
tp-sh:ControlledInfraElementShape
    a sh:NodeShape ;
    sh:targetClass era:ControlledInfraElement ;
    sh:name "ControlledInfraElement" ;
    sh:description "Defines Controlled Infra Element" ;
    sh:xone (
        tp-sh:ControlledInfraElement-switchConfigurationData-present
        tp-sh:ControlledInfraElement-tvpSection-present
        tp-sh:ControlledInfraElement-trainDetector-present
        tp-sh:ControlledInfraElement-levelCrossing-present
    ) ;
    sh:message "ControlledInfraElement is a union: exactly one of (switchConfigurationData, tvpSection, trainDetector, levelCrossing) must be present."@en ;
    sh:message "ControlledInfraElement ist eine Union: genau eines von (switchConfigurationData, tvpSection, trainDetector, levelCrossing) muss vorhanden sein."@de ;
    sh:message "ControlledInfraElement est une union : exactement l'un de (switchConfigurationData, tvpSection, trainDetector, levelCrossing) doit être présent."@fr ;
    sh:property tp-sh:ControlledInfraElement-switchConfigurationData ;
    sh:property tp-sh:ControlledInfraElement-tvpSection ;
    sh:property tp-sh:ControlledInfraElement-trainDetector ;
    sh:property tp-sh:ControlledInfraElement-levelCrossing ;
    sh:severity sh:Violation ;
    .

tp-sh:ControlledInfraElement-switchConfigurationData
    a sh:PropertyShape ;
    sh:path era:switchConfigurationData ;
    sh:name "switchConfigurationData" ;
    sh:description "Reference to the Configuration for the Switch" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:SwitchConfigurationData ;
    sh:message "switchConfigurationData must reference an existing era:SwitchConfigurationData by IRI."@en ;
    sh:message "switchConfigurationData muss über eine IRI auf ein bestehendes era:SwitchConfigurationData verweisen."@de ;
    sh:message "switchConfigurationData doit référencer un era:SwitchConfigurationData existant par IRI."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:ControlledInfraElement-tvpSection
    a sh:PropertyShape ;
    sh:path era:tvpSection ;
    sh:name "tvpSection" ;
    sh:description "Reference to the Configuration for the Tvp Section" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TvpSectionConfigurationData ;
    sh:message "tvpSection must reference an existing era:TvpSectionConfigurationData by IRI."@en ;
    sh:message "tvpSection muss über eine IRI auf ein bestehendes era:TvpSectionConfigurationData verweisen."@de ;
    sh:message "tvpSection doit référencer un era:TvpSectionConfigurationData existant par IRI."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:ControlledInfraElement-trainDetector
    a sh:PropertyShape ;
    sh:path era:trainDetector ;
    sh:name "trainDetector" ;
    sh:description "Reference to the Configuration for the Train Detection System" ;
    sh:order 3 ;
