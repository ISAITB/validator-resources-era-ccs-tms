    sh:description "Defines the container for all Train Protection Areas within a railway infrastructure system." ;
    sh:property tp-sh:TrainProtection-tpArea ;
    sh:severity sh:Violation ;
    .

tp-sh:TrainProtection-tpArea
    a sh:PropertyShape ;
    sh:path era:tpArea ;
    sh:name "tpArea" ;
    sh:description "Defines the collection of Train Protection Areas belonging to the railway infrastructure system." ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:TrainProtectionAreaShape ;
    sh:message "tpArea must be a well-formed TrainProtectionArea (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
