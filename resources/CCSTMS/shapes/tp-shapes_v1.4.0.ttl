### TrainDetectionSystemConfigurationData #############################
tp-sh:TrainDetectionSystemConfigurationDataShape
    a sh:NodeShape ;
    sh:targetClass era:TrainDetectionSystemConfigurationData ;
    sh:name "TrainDetectionSystemConfigurationData" ;
    sh:description "Defines Configuration Data for Train Detection System" ;
    sh:property tp-sh:TrainDetectionSystemConfigurationData-abilityToForceTvpsClear ;
    sh:property tp-sh:TrainDetectionSystemConfigurationData-tvpSectionConfigurationData ;
    sh:property tp-sh:TrainDetectionSystemConfigurationData-trainDetectorConfigurationData ;
    sh:severity sh:Violation ;
    .

tp-sh:TrainDetectionSystemConfigurationData-abilityToForceTvpsClear
    a sh:PropertyShape ;
    sh:path era:abilityToForceTvpsClear ;
    sh:name "abilityToForceTvpsClear" ;
    sh:description "The handling of the ability to force a TVPS to clear in the state disturbed, reason operational according to Variant A and B.Note: The functional differences between these variants is explained in section Eu.TDS.6525" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "abilityToForceTvpsClear's own description states this covers forcing a TVPS to clear while it is in the disturbed state for operational reasons, according to Variant A or B - the actual functional difference between those two variants is explained separately, in section Eu.TDS.6525, not here. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean."@en ;
    era:additionalInfo "Die eigene Beschreibung von abilityToForceTvpsClear besagt, dass dies das Freischalten einer TVPS im gestörten Zustand aus betrieblichen Gründen betrifft, gemäß Variante A oder B - der tatsächliche funktionale Unterschied zwischen diesen beiden Varianten wird separat in Abschnitt Eu.TDS.6525 erklärt, nicht hier. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert."@de ;
    era:additionalInfo "La propre description de abilityToForceTvpsClear indique que ceci couvre le forçage d'une TVPS à l'état libre alors qu'elle est perturbée, pour des raisons opérationnelles, selon la variante A ou B - la différence fonctionnelle réelle entre ces deux variantes est expliquée séparément, dans la section Eu.TDS.6525, non ici. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique."@fr ;
    .

tp-sh:TrainDetectionSystemConfigurationData-tvpSectionConfigurationData
    a sh:PropertyShape ;
    sh:path era:tvpSectionConfigurationData ;
    sh:name "tvpSectionConfigurationData" ;
    sh:description "Composes Tvp Section Configuration Data" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:TvpSectionConfigurationDataShape ;
    sh:message "tvpSectionConfigurationData must be a well-formed TvpSectionConfigurationData (blank node or IRI)."@en ;
    sh:message "tvpSectionConfigurationData muss ein wohlgeformtes TvpSectionConfigurationData sein (Blank Node oder IRI)."@de ;
    sh:message "tvpSectionConfigurationData doit être un TvpSectionConfigurationData bien formé (nœud vide ou IRI)."@fr ;
    sh:severity sh:Violation ;
    .

