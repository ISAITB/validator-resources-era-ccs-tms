    sh:description "Composes output channel configuration data" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:OutputChannelConfigurationDataShape ;
    sh:message "outputChannelConfigurationData must be a well-formed OutputChannelConfigurationData (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

tp-sh:GenericIOConfigurationData-inputChannelConfigurationData
    a sh:PropertyShape ;
    sh:path era:inputChannelConfigurationData ;
    sh:name "inputChannelConfigurationData" ;
