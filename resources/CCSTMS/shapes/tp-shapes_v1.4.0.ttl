### NetAreaReference ##################################################
tp-sh:infra-NetAreaReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetAreaReference ;
    sh:name "NetAreaReference" ;
    sh:description "Represents an area reference in the network." ;
    sh:property tp-sh:infra-NetAreaReference-includes ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-NetAreaReference-includes
    a sh:PropertyShape ;
    sh:path era:includes ;
    sh:name "includes" ;
