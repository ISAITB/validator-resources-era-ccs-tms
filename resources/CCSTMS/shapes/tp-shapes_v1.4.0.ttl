tp-sh:OutputChannelConfigurationData-physicalOutputMonitored
    a sh:PropertyShape ;
    sh:path era:physicalOutputMonitored ;
    sh:name "physicalOutputMonitored" ;
    sh:description "Defines weather physical output is monitored" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
