@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix era:     <http://data.europa.eu/949/> .

@prefix tp-sh: <http://data.europa.eu/949/shapes/tp#> .


########################################################################
#  SPARQL prefix declarations
#
#  SHACL 5.3: the Turtle @prefix declarations above do NOT apply inside
#  sh:select - only sh:prefixes does. Without this, a query writing era:...
#  fails with "Unknown namespace prefix : era" on any data graph that does
#  not itself bind the same prefix (e.g. data written with full IRIs).
########################################################################

tp-sh:PrefixDeclarations
    a owl:Ontology ;
    rdfs:label "Prefixes available to every sh:select in this file"@en ;
    sh:declare
        [ sh:prefix "era"  ; sh:namespace "http://data.europa.eu/949/"^^xsd:anyURI ] ,
        [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd"  ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ;
    .

########################################################################
#  Imported shapes
#
#  tp references or composes these structs from other
#  modules, so their shapes are inlined here for completeness (rule 17).
#  They are minted in this module's namespace, prefixed with the source
#  module, so this file never collides with the owning module's own
#  shapes file. Loading both simply reports shared classes twice.
########################################################################

### Switch ############################################################
tp-sh:infra-SwitchShape
    a sh:NodeShape ;
    sh:targetClass era:Switch ;
    sh:name "Switch" ;
    sh:description "A unit of track comprising two fixed rails (stock rails) and two movable rails (switch rails) used to direct vehicles from one track to another track." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property tp-sh:infra-Switch-reversalTime ;
    sh:property tp-sh:infra-Switch-leftBranch ;
    sh:property tp-sh:infra-Switch-rightBranch ;
    sh:property tp-sh:infra-Switch-name ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-Switch-reversalTime
    a sh:PropertyShape ;
    sh:path era:reversalTime ;
    sh:name "reversalTime" ;
    sh:description "Defines the time in seconds to switch from one position to the other" ;
    sh:order 2 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "reversalTime is stored with a scaling exponent of -1: the raw stored integer must be multiplied by 0.1 to get the actual physical value in seconds - a stored value of 50 means an actual reversal time of 5.0 seconds, not 50. This property is optional; its absence is not a violation. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "reversalTime wird mit einem Skalierungsexponenten von -1 gespeichert: der roh gespeicherte Ganzzahlwert muss mit 0,1 multipliziert werden, um den tatsächlichen physikalischen Wert in Sekunden zu erhalten - ein gespeicherter Wert von 50 bedeutet eine tatsächliche Umstellzeit von 5,0 Sekunden, nicht 50. Diese Eigenschaft ist optional; ihr Fehlen ist kein Verstoß. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "reversalTime est stocké avec un exposant d'échelle de -1 : l'entier brut stocké doit être multiplié par 0,1 pour obtenir la valeur physique réelle en secondes - une valeur stockée de 50 signifie un temps de retournement réel de 5,0 secondes, non 50. Cette propriété est optionnelle ; son absence n'est pas une violation. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

tp-sh:infra-Switch-leftBranch
    a sh:PropertyShape ;
    sh:path era:leftBranch ;
    sh:name "leftBranch" ;
    sh:description "NetRelation referencing the left side of the switch in the facing direction of the switch" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:NetRelation ;
    sh:message "leftBranch must reference an existing era:NetRelation by IRI."@en ;
    sh:message "leftBranch muss über eine IRI auf ein bestehendes era:NetRelation verweisen."@de ;
    sh:message "leftBranch doit référencer un era:NetRelation existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-Switch-rightBranch
    a sh:PropertyShape ;
    sh:path era:rightBranch ;
    sh:name "rightBranch" ;
    sh:description "NetRelation referencing the right side of the switch in the facing direction of the switch" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:class era:NetRelation ;
    sh:message "rightBranch must reference an existing era:NetRelation by IRI."@en ;
    sh:message "rightBranch muss über eine IRI auf ein bestehendes era:NetRelation verweisen."@de ;
    sh:message "rightBranch doit référencer un era:NetRelation existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-Switch-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this switch, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diese Weiche, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cet aiguillage, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### SlipCrossing ######################################################
tp-sh:infra-SlipCrossingShape
    a sh:NodeShape ;
    sh:targetClass era:SlipCrossing ;
    sh:name "SlipCrossing" ;
    sh:description "Defines the physical track asset Slip Crossing ; 2 instances switch point define a single slip crossing and 4 instances of switch point defined a double slip crossing ; Reversal time is the maximum of known reversal times of switches. If the reversal time of at least one switch in the slip point is unknown, the reversal time of the slip point is unknown as well." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:or (
        [ sh:property [ sh:path era:switches ; sh:minCount 2 ; sh:maxCount 2 ] ]
        [ sh:property [ sh:path era:switches ; sh:minCount 4 ; sh:maxCount 4 ] ]
    ) ;
    sh:message "A SlipCrossing must reference exactly two switches (single slip crossing) or exactly four switches (double slip crossing) - never three (see formatNote on SlipCrossing.switches)."@en ;
    sh:message "Ein SlipCrossing muss entweder genau zwei switches referenzieren (einfache Kreuzungsweiche) oder genau vier switches (doppelte Kreuzungsweiche) - niemals drei (siehe formatNote zu SlipCrossing.switches)."@de ;
    sh:message "Un SlipCrossing doit référencer soit exactement deux switches (traversée-jonction simple), soit exactement quatre switches (traversée-jonction double) - jamais trois (voir formatNote sur SlipCrossing.switches)."@fr ;
    sh:property tp-sh:infra-SlipCrossing-switches ;
    sh:property tp-sh:infra-SlipCrossing-crossing ;
    sh:property tp-sh:infra-SlipCrossing-name ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-SlipCrossing-switches
    a sh:PropertyShape ;
    sh:path era:switches ;
    sh:name "switches" ;
    sh:description "Consists of simple points" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Switch ;
    sh:message "switches must reference an existing era:Switch by IRI."@en ;
    sh:message "switches muss über eine IRI auf ein bestehendes era:Switch verweisen."@de ;
    sh:message "switches doit référencer un era:Switch existant par IRI."@fr ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-SlipCrossing-crossing
    a sh:PropertyShape ;
    sh:path era:crossing ;
    sh:name "crossing" ;
    sh:description "Consists of crossing" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Crossing ;
    sh:message "crossing must reference an existing era:Crossing by IRI."@en ;
    sh:message "crossing muss über eine IRI auf ein bestehendes era:Crossing verweisen."@de ;
    sh:message "crossing doit référencer un era:Crossing existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-SlipCrossing-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this slip crossing, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diese Kreuzungsweiche, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cette traversée-jonction, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### Crossing ##########################################################
tp-sh:infra-CrossingShape
    a sh:NodeShape ;
    sh:targetClass era:Crossing ;
    sh:name "Crossing" ;
    sh:description "Defines the physical track asset Crossing without possibility to switch between two linear elements" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property tp-sh:infra-Crossing-topologicalCoordinates ;
    sh:property tp-sh:infra-Crossing-isSwitchable ;
    sh:property tp-sh:infra-Crossing-name ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-Crossing-topologicalCoordinates
    a sh:PropertyShape ;
    sh:path era:topologicalCoordinates ;
    sh:name "topologicalCoordinates" ;
    sh:description "composes of topological coordinates" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:infra-TopologicalCoordinateShape ;
    sh:message "topologicalCoordinates must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:message "topologicalCoordinates muss ein wohlgeformtes TopologicalCoordinate sein (Blank Node oder IRI)."@de ;
    sh:message "topologicalCoordinates doit être un TopologicalCoordinate bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 2 ;
    sh:maxCount 2 ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-Crossing-isSwitchable
    a sh:PropertyShape ;
    sh:path era:isSwitchable ;
    sh:name "isSwitchable" ;
    sh:description "True: If the crossing is switchable ; False: If the crossing is not switchable ; https://commons.wikimedia.org/wiki/Category:Switched_diamond_crossings" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "isSwitchable's own description states that true means this crossing is switchable, and false means it is not - referring to what is sometimes called a switched diamond crossing, as opposed to a fixed one. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean."@en ;
    era:additionalInfo "Die eigene Beschreibung von isSwitchable besagt, dass true bedeutet, dass diese Kreuzung schaltbar ist, und false, dass sie es nicht ist - bezogen auf das, was manchmal als bewegliche Doppelkreuzung bezeichnet wird, im Gegensatz zu einer starren. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert."@de ;
    era:additionalInfo "La propre description de isSwitchable indique que true signifie que ce croisement est mobile, et false qu'il ne l'est pas - faisant référence à ce que l'on appelle parfois une traversée oblique mobile, par opposition à une fixe. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique."@fr ;
    .

tp-sh:infra-Crossing-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this crossing, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diese Kreuzung, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour ce croisement, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### Derailer ##########################################################
tp-sh:infra-DerailerShape
    a sh:NodeShape ;
    sh:targetClass era:Derailer ;
    sh:name "Derailer" ;
    sh:description "Defines the physical track asset Derailer" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property tp-sh:infra-Derailer-netPointReference ;
    sh:property tp-sh:infra-Derailer-reversalTime ;
    sh:property tp-sh:infra-Derailer-derailToRight ;
    sh:property tp-sh:infra-Derailer-name ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-Derailer-netPointReference
    a sh:PropertyShape ;
    sh:path era:netPointReference ;
    sh:name "netPointReference" ;
    sh:description "Defines position on LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:infra-NetPointReferenceShape ;
    sh:message "netPointReference must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:message "netPointReference muss ein wohlgeformtes NetPointReference sein (Blank Node oder IRI)."@de ;
    sh:message "netPointReference doit être un NetPointReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-Derailer-reversalTime
    a sh:PropertyShape ;
    sh:path era:reversalTime ;
    sh:name "reversalTime" ;
    sh:description "Defines the time in seconds to switch from one position to the other" ;
    sh:order 3 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "reversalTime is stored with a scaling exponent of -1: the raw stored integer must be multiplied by 0.1 to get the actual physical value in seconds - a stored value of 50 means an actual reversal time of 5.0 seconds, not 50. This property is optional; its absence is not a violation. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "reversalTime wird mit einem Skalierungsexponenten von -1 gespeichert: der roh gespeicherte Ganzzahlwert muss mit 0,1 multipliziert werden, um den tatsächlichen physikalischen Wert in Sekunden zu erhalten - ein gespeicherter Wert von 50 bedeutet eine tatsächliche Umstellzeit von 5,0 Sekunden, nicht 50. Diese Eigenschaft ist optional; ihr Fehlen ist kein Verstoß. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "reversalTime est stocké avec un exposant d'échelle de -1 : l'entier brut stocké doit être multiplié par 0,1 pour obtenir la valeur physique réelle en secondes - une valeur stockée de 50 signifie un temps de retournement réel de 5,0 secondes, non 50. Cette propriété est optionnelle ; son absence n'est pas une violation. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

tp-sh:infra-Derailer-derailToRight
    a sh:PropertyShape ;
    sh:path era:derailToRight ;
    sh:name "derailToRight" ;
    sh:description "Defines the side on which the derailer derails. If false = derailToLeft" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique."@fr ;
    .

tp-sh:infra-Derailer-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label, only meant to be populated when a more human-readable name is wanted in addition to the derailer's own id - most derailers are not expected to need one. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id der Gleissperre ein besser lesbarer Name gewünscht wird - die meisten Gleissperren benötigen voraussichtlich keinen. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de l'id propre du dispositif de déraillement - la plupart des dispositifs de déraillement ne devraient pas en avoir besoin. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### LevelCrossing #####################################################
tp-sh:infra-LevelCrossingShape
    a sh:NodeShape ;
    sh:targetClass era:LevelCrossing ;
    sh:name "LevelCrossing" ;
    sh:description "A level crossing is an intersection where a railway line crosses a road or a path at the same level. It can be used for the implementation of the ETCS trackside or to identify potential collision scenarios" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property tp-sh:infra-LevelCrossing-areaReference ;
    sh:property tp-sh:infra-LevelCrossing-name ;
    sh:property tp-sh:infra-LevelCrossing-isProtected ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-LevelCrossing-areaReference
    a sh:PropertyShape ;
    sh:path era:areaReference ;
    sh:name "areaReference" ;
    sh:description "composes of track area" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:infra-NetAreaReferenceShape ;
    sh:message "areaReference must be a well-formed NetAreaReference (blank node or IRI)."@en ;
    sh:message "areaReference muss ein wohlgeformtes NetAreaReference sein (Blank Node oder IRI)."@de ;
    sh:message "areaReference doit être un NetAreaReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-LevelCrossing-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this level crossing, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diesen Bahnübergang, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour ce passage à niveau, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

tp-sh:infra-LevelCrossing-isProtected
    a sh:PropertyShape ;
    sh:path era:isProtected ;
    sh:name "isProtected" ;
    sh:description "True if the level crossing is protected, False - if the level crossing is unprotected" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "isProtected's own description states that true means the level crossing is protected, and false means it is unprotected. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean."@en ;
    era:additionalInfo "Die eigene Beschreibung von isProtected besagt, dass true bedeutet, dass der Bahnübergang gesichert ist, und false, dass er ungesichert ist. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert."@de ;
    era:additionalInfo "La propre description de isProtected indique que true signifie que le passage à niveau est protégé, et false qu'il ne l'est pas. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique."@fr ;
    .

### LinearElementSection ##############################################
tp-sh:infra-LinearElementSectionShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElementSection ;
    sh:name "LinearElementSection" ;
    sh:description "Defines adirected linear object (with a linear extension) located on a LinearElement" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property tp-sh:infra-LinearElementSection-onElement ;
    sh:property tp-sh:infra-LinearElementSection-startOffsetFromOrigin ;
    sh:property tp-sh:infra-LinearElementSection-endOffsetFromOrigin ;
    sh:property tp-sh:infra-LinearElementSection-appliesInBothDirections ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-LinearElementSection-onElement
    a sh:PropertyShape ;
    sh:path era:onElement ;
    sh:name "onElement" ;
    sh:description "Specifies the linear element a section belongs to." ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "onElement must reference an existing era:LinearElement by IRI."@en ;
    sh:message "onElement muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
    sh:message "onElement doit référencer un era:LinearElement existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-LinearElementSection-startOffsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:startOffsetFromOrigin ;
    sh:name "startOffsetFromOrigin" ;
    sh:description "Defines the start offset from the origin" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "startOffsetFromOrigin is a distance skip, in metres, measured forward from the origin (start) of the LinearElement named in onElement, marking where this section begins. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number. This check does not compare it against endOffsetFromOrigin, nor does it require it to be non-negative."@en ;
    era:additionalInfo "startOffsetFromOrigin ist ein Distanzversatz in Metern, gemessen vorwärts vom Ursprung (Anfang) des in onElement genannten LinearElement, der markiert, wo dieser Abschnitt beginnt. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der Wert ist vorhanden, aber keine gültige Zahl. Diese Prüfung vergleicht ihn nicht mit endOffsetFromOrigin, noch verlangt sie, dass er nicht negativ ist."@de ;
    era:additionalInfo "startOffsetFromOrigin est un décalage de distance, en mètres, mesuré vers l'avant depuis l'origine (le début) du LinearElement nommé dans onElement, marquant où cette section commence. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur est présente mais n'est pas un nombre valide. Cette vérification ne la compare pas à endOffsetFromOrigin, et n'exige pas non plus qu'elle soit non négative."@fr ;
    .

tp-sh:infra-LinearElementSection-endOffsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:endOffsetFromOrigin ;
    sh:name "endOffsetFromOrigin" ;
    sh:description "Defines the end offset from the origin" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "endOffsetFromOrigin is a distance skip, in metres, measured forward from the origin (start) of the LinearElement named in onElement, marking where this section ends. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number. This check does not compare it against startOffsetFromOrigin, nor does it require it to stay within the element's own length."@en ;
    era:additionalInfo "endOffsetFromOrigin ist ein Distanzversatz in Metern, gemessen vorwärts vom Ursprung (Anfang) des in onElement genannten LinearElement, der markiert, wo dieser Abschnitt endet. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der Wert ist vorhanden, aber keine gültige Zahl. Diese Prüfung vergleicht ihn nicht mit startOffsetFromOrigin, noch verlangt sie, dass er innerhalb der eigenen Länge des Elements bleibt."@de ;
    era:additionalInfo "endOffsetFromOrigin est un décalage de distance, en mètres, mesuré vers l'avant depuis l'origine (le début) du LinearElement nommé dans onElement, marquant où cette section se termine. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur est présente mais n'est pas un nombre valide. Cette vérification ne la compare pas à startOffsetFromOrigin, et n'exige pas non plus qu'elle reste dans la longueur propre de l'élément."@fr ;
    .

tp-sh:infra-LinearElementSection-appliesInBothDirections
    a sh:PropertyShape ;
    sh:path era:appliesInBothDirections ;
    sh:name "appliesInBothDirections" ;
    sh:description "Defines if the section applies in both directions" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "appliesInBothDirections indicates whether this section's content is valid only when traversing its LinearElement in the element's own defined direction, or valid regardless of the direction of travel across it - consistent with how 'direction' is used elsewhere in this data model, relative to the element's own orientation rather than any absolute or geographic sense. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean (true/false)."@en ;
    era:additionalInfo "appliesInBothDirections gibt an, ob der Inhalt dieses Abschnitts nur gilt, wenn sein LinearElement in der eigenen definierten Richtung des Elements durchfahren wird, oder unabhängig von der Fahrtrichtung über es hinweg gilt - konsistent damit, wie 'Richtung' an anderer Stelle in diesem Datenmodell verwendet wird, bezogen auf die eigene Ausrichtung des Elements und nicht in einem absoluten oder geografischen Sinn. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert (true/false)."@de ;
    era:additionalInfo "appliesInBothDirections indique si le contenu de cette section n'est valide que lorsque son LinearElement est parcouru dans la direction propre définie de l'élément, ou valide quel que soit le sens de circulation le long de celui-ci - cohérent avec la façon dont « direction » est utilisée ailleurs dans ce modèle de données, par rapport à l'orientation propre de l'élément plutôt que dans un sens absolu ou géographique. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur est présente mais n'est pas un booléen authentique (true/false)."@fr ;
    .

### TrainDetectionSystem ##############################################
tp-sh:infra-TrainDetectionSystemShape
    a sh:NodeShape ;
    sh:targetClass era:TrainDetectionSystem ;
    sh:name "TrainDetectionSystem" ;
    sh:description "Safety system used to detect the presence of vehicles on the railway track." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property tp-sh:infra-TrainDetectionSystem-topologicalCoordinate ;
    sh:property tp-sh:infra-TrainDetectionSystem-trainDetectionSystemType ;
    sh:property tp-sh:infra-TrainDetectionSystem-referenceDir ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-TrainDetectionSystem-topologicalCoordinate
    a sh:PropertyShape ;
    sh:path era:topologicalCoordinate ;
    sh:name "topologicalCoordinate" ;
    sh:description "defines the location on linear element" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:infra-TopologicalCoordinateShape ;
    sh:message "topologicalCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:message "topologicalCoordinate muss ein wohlgeformtes TopologicalCoordinate sein (Blank Node oder IRI)."@de ;
    sh:message "topologicalCoordinate doit être un TopologicalCoordinate bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-TrainDetectionSystem-trainDetectionSystemType
    a sh:PropertyShape ;
    sh:path era:trainDetectionSystemType ;
    sh:name "trainDetectionSystemType" ;
    sh:description "Defines the train detection system applicable for the TVPS" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-detection/20> <http://data.europa.eu/949/concepts/train-detection/10> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TrainDetectionSystems concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von TrainDetectionSystems entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de TrainDetectionSystems."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:infra-TrainDetectionSystem-referenceDir
    a sh:PropertyShape ;
    sh:path era:referenceDir ;
    sh:name "referenceDir" ;
    sh:description "Reference direction corresponding to linear element in which the train detector detects trains: same/opposite for axleCounter, both for trackCircuit" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/orientations/02> <http://data.europa.eu/949/concepts/orientations/00> <http://data.europa.eu/949/concepts/orientations/01> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OrientationDirections concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von OrientationDirections entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de OrientationDirections."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

