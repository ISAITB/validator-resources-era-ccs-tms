    sh:property tp-sh:Controller-portNumber ;
    sh:property tp-sh:Controller-eulynxBaseline ;
    sh:property tp-sh:Controller-ocVersion ;
    sh:severity sh:Violation ;
    .

tp-sh:Controller-iPAddress
    a sh:PropertyShape ;
    sh:path era:iPAddress ;
    sh:name "IP Address" ;
    sh:description "defines the ip address for communication purposes" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:Controller-rastaId
    a sh:PropertyShape ;
    sh:path era:rastaId ;
