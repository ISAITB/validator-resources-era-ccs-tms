    sh:path era:conTFlashPeriod ;
    sh:name "Flash Period Time" ;
    sh:description "Defines the Configurable time for flash period" ;
    sh:order 1 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
