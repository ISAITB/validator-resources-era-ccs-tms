    sh:description "Usage of the UFL-command per each TVPS." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:TvpSectionConfigurationData-permissibleFcModes
    a sh:PropertyShape ;
    sh:path era:permissibleFcModes ;
    sh:name "Permissible Force Section modes" ;
    sh:description "Permissible FC-modes per each TVPS and per source of the command (Electronic Interlocking, Maintainer or from internal)." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:TvpSectionConfigurationData-conTInhibitionTimer
    a sh:PropertyShape ;
    sh:path era:conTInhibitionTimer ;
    sh:name "Inhibition Timer" ;
    sh:description "Configurable delay, defining the duration between the detection of a passing for a TVPS (incoming wheel, outgoing wheel or undefined pattern) and the moment that the state of a TVPS is considered stable. Cd_Cancel is not rejected during inhibition time. Until expiration of this delay, all FC, DRFC and UFL commands to the TVPS are rejected." ;
    sh:order 5 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:TvpSectionConfigurationData-conTDealyOfNotificationOfAvailability
    a sh:PropertyShape ;
    sh:path era:conTDealyOfNotificationOfAvailability ;
    sh:name "Delay of Availability Notification" ;
    sh:description "Defines a configurable delay of reporting vacant from the Train Detection System to the interlocking, following the state change of a TVPS from occupied to vacant" ;
    sh:order 6 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:TvpSectionConfigurationData-conTMaxfcPOrFcPA
    a sh:PropertyShape ;
    sh:path era:conTMaxfcPOrFcPA ;
    sh:name "Max Configurable time" ;
    sh:description "Configurable time, defining the maximum time between detecting a sweeping train and confirmation of a succesful sweeping." ;
    sh:order 7 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:TvpSectionConfigurationData-conTMinfcPOrFcPA
    a sh:PropertyShape ;
    sh:path era:conTMinfcPOrFcPA ;
    sh:name "Min Configurable Time" ;
    sh:description "a configurable time, which starts with the first detected incomming Wheel." ;
    sh:order 8 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:TvpSectionConfigurationData-conTTdpDelay
    a sh:PropertyShape ;
    sh:path era:conTTdpDelay ;
    sh:name "Passed TDP Indication Delay" ;
    sh:description "configurable delay, defining the duration of a passed TDP and the message, that the TDP is in state TDP not passed." ;
    sh:order 9 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:TvpSectionConfigurationData-conTTdpUnidentifiedPatternDelay
    a sh:PropertyShape ;
    sh:path era:conTTdpUnidentifiedPatternDelay ;
    sh:name "Undefined Pattern Delay" ;
    sh:description "Configurable delay, defining the duration after an undefined pattern was detected till the TDP is reported as Disturbed." ;
    sh:order 10 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### GenericIOConfigurationData ########################################
tp-sh:GenericIOConfigurationDataShape
    a sh:NodeShape ;
    sh:targetClass era:GenericIOConfigurationData ;
    sh:name "GenericIOConfigurationData" ;
