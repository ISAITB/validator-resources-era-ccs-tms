    .

tp-sh:OutputChannelConfigurationData-conTActivationDelayOff
    a sh:PropertyShape ;
    sh:path era:conTActivationDelayOff ;
    sh:name "Activation Delay Off Time" ;
    sh:description "represents the time value for conTActivationDelay. This is the delay for switching-off the Output Channel." ;
    sh:order 6 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

tp-sh:OutputChannelConfigurationData-conTFlashDutyCycle
    a sh:PropertyShape ;
    sh:path era:conTFlashDutyCycle ;
    sh:name "Flash Duty Cycle Time" ;
    sh:description "Defines the Configurable flash duty cycle period" ;
    sh:order 7 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

