    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node tp-sh:infra-NetLinearReferenceShape ;
    sh:message "includes must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:message "includes muss ein wohlgeformtes NetLinearReference sein (Blank Node oder IRI)."@de ;
    sh:message "includes doit être un NetLinearReference bien formé (nœud vide ou IRI)."@fr ;
