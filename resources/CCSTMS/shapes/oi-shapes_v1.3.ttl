        sh:message "Ein OI kann mehrere validierte digitalRegisterHandshakeRequests enthalten."@de ;
        sh:message "Un OI peut contenir plusieurs digitalRegisterHandshakeRequests validés."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Digital Register Handshake Acknowledgements (optional)
    sh:property [ 
        sh:path era:digitalRegisterHandshakeAcknowledgements ;
        sh:node era:DigitalRegisterHandshakeAcknowledgementShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "An OI may contain multiple validated digitalRegisterHandshakeAcknowledgements."@en ;
        sh:message "Ein OI kann mehrere validierte digitalRegisterHandshakeAcknowledgements enthalten."@de ;
        sh:message "Un OI peut contenir plusieurs digitalRegisterHandshakeAcknowledgements validés."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Digital Register Handshake Rejections (optional)
    sh:property [ 
        sh:path era:digitalRegisterHandshakeRejections ;
        sh:node era:DigitalRegisterHandshakeRejectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "An OI may contain multiple validated digitalRegisterHandshakeRejections."@en ;
        sh:message "Ein OI kann mehrere validierte digitalRegisterHandshakeRejections enthalten."@de ;
        sh:message "Un OI peut contenir plusieurs digitalRegisterHandshakeRejections validés."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Digital Register Session Termination Requests (optional)
    sh:property [ 
        sh:path era:digitalRegisterSessionTerminationRequests ;
        sh:node era:DigitalRegisterSessionTerminationRequestShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "An OI may contain multiple validated digitalRegisterSessionTerminationRequests."@en ;
        sh:message "Ein OI kann mehrere validierte digitalRegisterSessionTerminationRequests enthalten."@de ;
        sh:message "Un OI peut contenir plusieurs digitalRegisterSessionTerminationRequests validés."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Digital Register Session Terminations (optional)
    sh:property [ 
        sh:path era:digitalRegisterSessionTerminations ;
        sh:node era:DigitalRegisterSessionTerminationShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "An OI may contain multiple validated digitalRegisterSessionTerminations."@en ;
        sh:message "Ein OI kann mehrere validierte digitalRegisterSessionTerminations enthalten."@de ;
        sh:message "Un OI peut contenir plusieurs digitalRegisterSessionTerminations validés."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Segment Profile Requests (optional)
    sh:property [ 
        sh:path era:segmentProfileRequests ;
        sh:node era:SegmentProfileRequestShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "An OI may contain multiple validated segmentProfileRequests."@en ;
        sh:message "Ein OI kann mehrere validierte segmentProfileRequests enthalten."@de ;
        sh:message "Un OI peut contenir plusieurs segmentProfileRequests validés."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Segment Profile Packets (optional)
    sh:property [ 
        sh:path era:segmentProfilePackets ;
        sh:node era:SegmentProfilePacketShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
