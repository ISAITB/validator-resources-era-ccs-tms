        sh:maxCount 1 ;
        sh:message "Each SegmentProfilePacket must have exactly one trackTrainHeader that conforms to TrackTrainHeader object."@en ;
        sh:message "Jedes SegmentProfilePacket muss genau ein trackTrainHeader haben, das dem TrackTrainHeader-Objekt entspricht."@de ;
        sh:message "Chaque SegmentProfilePacket doit avoir exactement un trackTrainHeader conforme à l'objet TrackTrainHeader."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Segment Profiles (required, at least one profile)
