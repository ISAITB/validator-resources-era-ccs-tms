@prefix era: <http://data.europa.eu/949/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# ===== Absolute Position Shape =====
era:AbsolutePositionShape a sh:NodeShape ;
    sh:targetClass era:AbsolutePosition ;
    sh:message "3D coordinates defining absolute position in a geographic coordinate system."@en ;
    sh:message "3D-Koordinaten, die die absolute Position in einem geografischen Koordinatensystem definieren."@de ;
    sh:message "Coordonnées 3D définissant la position absolue dans un système de coordonnées géographiques."@fr ;
    
    # X Coordinate (optional, double - easting/longitude)
    sh:property [ 
        sh:path era:x ;
        sh:datatype xsd:double ;
        sh:maxCount 1 ;
        sh:message "An AbsolutePosition may have at most one x coordinate (double, easting or longitude value)."@en ;
        sh:message "Eine AbsolutePosition darf höchstens eine x-Koordinate haben (Doppel-, Rechts- oder Längengradwert)."@de ;
        sh:message "Une AbsolutePosition peut avoir au plus une coordonnée x (valeur double, est ou longitude)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Y Coordinate (optional, double - northing/latitude)
    sh:property [ 
        sh:path era:y ;
        sh:datatype xsd:double ;
        sh:maxCount 1 ;
        sh:message "An AbsolutePosition may have at most one y coordinate (double, northing or latitude value)."@en ;
        sh:message "Eine AbsolutePosition darf höchstens eine Y-Koordinate (Doppel-, Nord- oder Breitengradwert) haben."@de ;
        sh:message "Une AbsolutePosition peut avoir au plus une coordonnée y (valeur double, nord ou latitude)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Z Coordinate (optional, double - elevation/altitude)
    sh:property [ 
        sh:path era:z ;
        sh:datatype xsd:double ;
        sh:maxCount 1 ;
        sh:message "An AbsolutePosition may have at most one z coordinate (double, elevation or altitude in meters)."@en ;
        sh:message "Eine AbsolutePosition darf höchstens eine Z-Koordinate haben (doppelt, Höhe oder Höhe in Metern)."@de ;
        sh:message "Une AbsolutePosition peut avoir au plus une coordonnée z (double, élévation ou altitude en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Adjacent Segment Profile Shape =====
era:AdjacentSegmentProfileShape a sh:NodeShape ;
    sh:targetClass era:AdjacentSegmentProfile ;
    sh:message "Reference to an adjacent track segment profile, describing topology connections."@en ;
    sh:message "Verweis auf ein benachbartes Gleissegmentprofil, das Topologieverbindungen beschreibt."@de ;
    sh:message "Référence à un profil de segment de piste adjacent, décrivant les connexions topologiques."@fr ;
    
    # NID SP (required, unsigned integer - segment profile identifier)
    sh:property [ 
        sh:path era:nidSP ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AdjacentSegmentProfile must have exactly one nidSP (unsigned integer, segment profile ID)."@en ;
        sh:message "Jedes AdjacentSegmentProfile muss genau eine nidSP (vorzeichenlose Ganzzahl, Segmentprofil-ID) haben."@de ;
        sh:message "Chaque AdjacentSegmentProfile doit avoir exactement un nidSP (entier non signé, ID de profil de segment)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Version (required, unsigned integer - data version)
    sh:property [ 
        sh:path era:version ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AdjacentSegmentProfile must have exactly one version (unsigned integer, segment profile data version)."@en ;
        sh:message "Jedes AdjacentSegmentProfile muss genau eine Version haben (vorzeichenlose Ganzzahl, Segmentprofildatenversion)."@de ;
        sh:message "Chaque AdjacentSegmentProfile doit avoir exactement une version (entier non signé, version des données du profil de segment)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID C (required, unsigned integer 0-1023 - country identifier)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AdjacentSegmentProfile must have exactly one nid_c (unsigned integer 0-1023, ETCS country identifier)."@en ;
        sh:message "Jedes AdjacentSegmentProfile muss genau ein nid_c (vorzeichenlose Ganzzahl 0-1023, ETCS-Länderkennung) haben."@de ;
        sh:message "Chaque AdjacentSegmentProfile doit avoir exactement un nid_c (entier non signé 0-1023, identifiant de pays ETCS)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Link Type (required, controlled vocabulary - connection type)
    sh:property [ 
        sh:path era:linkType ;
        sh:in (
            <http://data.europa.eu/949/concepts/link-type/pointLeft>
            <http://data.europa.eu/949/concepts/link-type/pointRight>
            <http://data.europa.eu/949/concepts/link-type/pointTip>
            <http://data.europa.eu/949/concepts/link-type/simpleConnector>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property linkType must have a value from the defined SKOS concept scheme (pointLeft, pointRight, pointTip, or simpleConnector)."@en ;
        sh:message "Die Eigenschaft linkType muss einen Wert aus dem definierten SKOS-Konzeptschema (pointLeft, pointRight, pointTip oder simpleConnector) haben."@de ;
        sh:message "La propriété linkType doit avoir une valeur du schéma de concept SKOS défini (pointLeft, pointRight, pointTip ou simpleConnector)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ATO-TS Contact Info Shape =====
era:AtoTSContactInfoShape a sh:NodeShape ;
    sh:targetClass era:AtoTSContactInfo ;
    sh:message "Contact information for ATO Trackside (ATO-TS) system communication."@en ;
    sh:message "Kontaktinformationen für die Systemkommunikation von ATO Trackside (ATO-TS)."@de ;
    sh:message "Coordonnées pour la communication du système ATO Trackside (ATO-TS)."@fr ;
    
    # NID ATOTS (required, unsigned integer - ATO trackside identifier)
    sh:property [ 
        sh:path era:nidATOTS ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AtoTSContactInfo must have exactly one nidATOTS (unsigned integer, ATO trackside system identifier)."@en ;
        sh:message "Jede AtoTSContactInfo muss genau eine nidATOTS (vorzeichenlose Ganzzahl, streckenseitige ATO-Systemkennung) haben."@de ;
        sh:message "Chaque AtoTSContactInfo doit avoir exactement un nidATOTS (entier non signé, identifiant du système au sol ATO)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SP NID C (required, unsigned integer - segment profile country ID)
    sh:property [ 
        sh:path era:spNidC ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AtoTSContactInfo must have exactly one spNidC (unsigned integer, segment profile country identifier)."@en ;
        sh:message "Jede AtoTSContactInfo muss genau eine spNidC (vorzeichenlose Ganzzahl, Länderkennung des Segmentprofils) haben."@de ;
        sh:message "Chaque AtoTSContactInfo doit avoir exactement un spNidC (entier non signé, identifiant de pays du profil de segment)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID SP (required, unsigned integer - segment profile identifier)
    sh:property [ 
        sh:path era:nidSP ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AtoTSContactInfo must have exactly one nidSP (unsigned integer, segment profile identifier)."@en ;
        sh:message "Jede AtoTSContactInfo muss genau eine nidSP (vorzeichenlose Ganzzahl, Segmentprofil-ID) haben."@de ;
        sh:message "Chaque AtoTSContactInfo doit avoir exactement un nidSP (entier non signé, identifiant de profil de segment)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # ATOTS NID C (required, unsigned integer - ATO-TS country identifier)
    sh:property [ 
        sh:path era:atotsNidC ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AtoTSContactInfo must have exactly one atotsNidC (unsigned integer, ATO trackside country identifier)."@en ;
        sh:message "Jede AtoTSContactInfo muss genau eine atotsNidC (vorzeichenlose Ganzzahl, streckenseitige ATO-Länderkennung) haben."@de ;
        sh:message "Chaque AtoTSContactInfo doit avoir exactement un atotsNidC (entier non signé, identifiant de pays au bord de la piste ATO)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Attitude Shape =====
era:AttitudeShape a sh:NodeShape ;
    sh:targetClass era:Attitude ;
    sh:message "Spatial orientation of track segment including angles and curvature."@en ;
    sh:message "Räumliche Ausrichtung des Gleissegments einschließlich Winkel und Krümmung."@de ;
    sh:message "Orientation spatiale du segment de voie, y compris les angles et la courbure."@fr ;
    
    # Azimuth (required, double 0-360 - compass bearing in degrees)
    sh:property [ 
        sh:path era:azimuth ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 360.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Attitude must have exactly one azimuth (double 0-360, compass bearing in degrees)."@en ;
        sh:message "Jede Fluglage muss genau einen Azimut haben (doppelt 0-360, Kompasspeilung in Grad)."@de ;
        sh:message "Chaque attitude doit avoir exactement un azimut (double 0-360, relèvement compas en degrés)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Pitch (required, integer 0-360 - vertical angle in degrees)
    sh:property [ 
        sh:path era:pitch ;
        sh:datatype xsd:int ;
        sh:minInclusive 0 ;
        sh:maxInclusive 360 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Attitude must have exactly one pitch (integer 0-360, vertical inclination angle in degrees)."@en ;
        sh:message "Jede Attitude muss genau eine Tonhöhe haben (Ganzzahl 0-360, vertikaler Neigungswinkel in Grad)."@de ;
        sh:message "Chaque attitude doit avoir exactement un pas (entier 0-360, angle d'inclinaison verticale en degrés)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Roll Angle (required, integer 0-360 - banking angle in degrees)
    sh:property [ 
        sh:path era:rollAngle ;
        sh:datatype xsd:int ;
        sh:minInclusive 0 ;
        sh:maxInclusive 360 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Attitude must have exactly one rollAngle (integer 0-360, banking/cant angle in degrees)."@en ;
        sh:message "Jede Haltung muss genau eine rollAngle haben (Ganzzahl 0-360, Neigungs-/Neigungswinkel in Grad)."@de ;
        sh:message "Chaque attitude doit avoir exactement un rollAngle (entier 0-360, angle d'inclinaison/inclinaison en degrés)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Curvature (required, integer - radius in meters, negative=left, positive=right)
    sh:property [ 
        sh:path era:curvature ;
        sh:datatype xsd:int ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Attitude must have exactly one curvature (integer, curve radius in meters; negative=left curve, positive=right curve, 0=straight)."@en ;
        sh:message "Jede Attitude muss genau eine Krümmung haben (Ganzzahl, Kurvenradius in Metern; negativ=linke Kurve, positiv=rechte Kurve, 0=gerade)."@de ;
        sh:message "Chaque Attitude doit avoir exactement une courbure (entier, rayon de courbe en mètres ; négatif=courbe gauche, positif=courbe droite, 0=droite)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Axle Load Speed Profile Shape =====
era:AxleLoadSpeedProfileShape a sh:NodeShape ;
    sh:targetClass era:AxleLoadSpeedProfile ;
    sh:message "Speed restriction profile based on axle load for a track segment."@en ;
    sh:message "Geschwindigkeitsbeschränkungsprofil basierend auf der Achslast für ein Gleissegment."@de ;
    sh:message "Profil de limitation de vitesse basé sur la charge par essieu pour un segment de voie."@fr ;
    
    # Segment Section (required, track section reference)
    sh:property [ 
        sh:path era:segmentSection ;
        sh:node era:SegmentSectionShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AxleLoadSpeedProfile must reference exactly one segmentSection that conforms to SegmentSection object."@en ;
        sh:message "Jedes AxleLoadSpeedProfile muss genau auf ein segmentSection verweisen, das dem SegmentSection-Objekt entspricht."@de ;
        sh:message "Chaque AxleLoadSpeedProfile doit faire référence à exactement un segmentSection conforme à l'objet SegmentSection."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train End Applicability (required, controlled vocabulary)
    sh:property [ 
        sh:path era:trainEndApplicability ;
        sh:in (
            <http://data.europa.eu/949/concepts/train-end-applicability/lengthDelay>
            <http://data.europa.eu/949/concepts/train-end-applicability/noLengthDelay>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property trainEndApplicability must have a value from the defined SKOS concept scheme (lengthDelay or noLengthDelay)."@en ;
        sh:message "Die Eigenschaft trainEndApplicability muss einen Wert aus dem definierten SKOS-Konzeptschema (lengthDelay oder noLengthDelay) haben."@de ;
        sh:message "La propriété trainEndApplicability doit avoir une valeur du schéma de concept SKOS défini (lengthDelay ou noLengthDelay)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Balise Group Shape =====
era:BaliseGroupShape a sh:NodeShape ;
    sh:targetClass era:BaliseGroup ;
    sh:message "Group of ETCS balises functioning as a logical unit for train detection and positioning."@en ;
    sh:message "Gruppe von ETCS-Balisen, die als logische Einheit zur Zugerkennung und -positionierung fungieren."@de ;
    sh:message "Groupe de balises ETCS fonctionnant comme une unité logique pour la détection et le positionnement des trains."@fr ;
    
    # NID C Qualifier (required, boolean - country ID qualifier flag)
    sh:property [ 
        sh:path era:nidCQualifier ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each BaliseGroup must have exactly one nidCQualifier (boolean, true if country ID is qualified/linked to previous balise group)."@en ;
        sh:message "Jede BaliseGroup muss genau eine nidCQualifier haben (boolean, true, wenn die Länder-ID qualifiziert/mit der vorherigen Balise-Gruppe verknüpft ist)."@de ;
        sh:message "Chaque BaliseGroup doit avoir exactement un nidCQualifier (booléen, vrai si l'ID du pays est qualifié/lié au groupe balise précédent)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Balise Shape =====
era:BaliseShape a sh:NodeShape ;
    sh:targetClass era:Balise ;
    sh:message "Individual ETCS balise transponder providing position and data to passing trains."@en ;
    sh:message "Individueller ETCS-Balisentransponder, der vorbeifahrenden Zügen Position und Daten liefert."@de ;
    sh:message "Transpondeur balise ETCS individuel fournissant la position et les données aux trains qui passent."@fr ;
    
    # N PIG (required, unsigned integer 0-7 - position in balise group)
    sh:property [ 
        sh:path era:n_pig ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 7 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one n_pig (unsigned integer 0-7, position in group; 0=not in group, 1-8=position within group)."@en ;
        sh:message "Jede Balise muss genau ein n_pig haben (vorzeichenlose Ganzzahl 0-7, Position in der Gruppe; 0=nicht in der Gruppe, 1-8=Position innerhalb der Gruppe)."@de ;
        sh:message "Chaque Balise doit avoir exactement un n_pig (entier non signé 0-7, position dans le groupe ; 0=pas dans le groupe, 1-8=position dans le groupe)."@fr ;
        sh:severity sh:Violation ;
    ] ;
	
	# Position (required, unsigned integer)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one pos (position as unsigned integer). The error might be because the position of the Balise on the corresponding Segment Profile is undefined"@en ;
        sh:message "Jede Balise muss genau eine Position (Position als vorzeichenlose Ganzzahl) haben. Der Fehler könnte darauf zurückzuführen sein, dass die Position der Balise auf dem entsprechenden Segmentprofil nicht definiert ist"@de ;
        sh:message "Chaque Balise doit avoir exactement une pos (position sous forme d'entier non signé). L'erreur peut être due au fait que la position de la balise sur le profil de segment correspondant n'est pas définie."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Contact Information Shape =====
era:ContactInformationShape a sh:NodeShape ;
    sh:targetClass era:ContactInformation ;
    sh:message "Contact information for Digital Railway Traffic Authority (DRTA) system."@en ;
    sh:message "Kontaktinformationen für das System der Digital Railway Traffic Authority (DRTA)."@de ;
    sh:message "Coordonnées du système Digital Railway Traffic Authority (DRTA)."@fr ;
    
    # NID C (required, unsigned integer 0-1023 - country identifier)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ContactInformation must have exactly one nid_c (unsigned integer 0-1023, ETCS country identifier)."@en ;
        sh:message "Jede ContactInformation muss genau ein nid_c (vorzeichenlose Ganzzahl 0-1023, ETCS-Länderkennung) haben."@de ;
        sh:message "Chaque ContactInformation doit avoir exactement un nid_c (entier non signé 0-1023, identifiant de pays ETCS)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID DRTA (required, unsigned integer - digital RTA identifier)
    sh:property [ 
        sh:path era:nidDRTA ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ContactInformation must have exactly one nidDRTA (unsigned integer, Digital Railway Traffic Authority identifier)."@en ;
        sh:message "Jede ContactInformation muss genau eine nidDRTA (ganzzahlige Zahl ohne Vorzeichen, Kennung der Digital Railway Traffic Authority) haben."@de ;
        sh:message "Chaque ContactInformation doit avoir exactement un nidDRTA (entier non signé, identifiant Digital Railway Traffic Authority)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Current Change Shape =====
era:CurrentChangeShape a sh:NodeShape ;
    sh:targetClass era:CurrentChange ;
    sh:message "Defines a change in electrical current limit at a specific position along the track."@en ;
    sh:message "Definiert eine Änderung der elektrischen Stromgrenze an einer bestimmten Position entlang der Strecke."@de ;
    sh:message "Définit un changement dans la limite de courant électrique à une position spécifique le long de la piste."@fr ;
    
    # Position (required, unsigned integer - position in meters)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CurrentChange must have exactly one pos (unsigned integer, position along track in meters)."@en ;
        sh:message "Jeder CurrentChange muss genau eine Position (vorzeichenlose Ganzzahl, Position entlang der Spur in Metern) haben."@de ;
        sh:message "Chaque CurrentChange doit avoir exactement une pos (entier non signé, position le long de la piste en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Current Value (required, unsigned integer - maximum current in amperes)
    sh:property [ 
        sh:path era:currentValue ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CurrentChange must have exactly one currentValue (unsigned integer, maximum permitted current in amperes)."@en ;
        sh:message "Jeder CurrentChange muss genau eine currentValue (vorzeichenlose Ganzzahl, maximal zulässiger Strom in Ampere) haben."@de ;
        sh:message "Chaque CurrentChange doit avoir exactement un currentValue (entier non signé, courant maximum autorisé en ampères)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Curve Change Shape =====
era:CurveChangeShape a sh:NodeShape ;
    sh:targetClass era:CurveChange ;
    sh:message "Defines a change in track curvature at a specific position."@en ;
    sh:message "Definiert eine Änderung der Gleiskrümmung an einer bestimmten Position."@de ;
    sh:message "Définit un changement dans la courbure de la piste à une position spécifique."@fr ;
    
    # Position (required, unsigned integer - position in meters)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CurveChange must have exactly one pos (unsigned integer, position along track in meters)."@en ;
        sh:message "Jeder CurveChange muss genau eine Position (vorzeichenlose Ganzzahl, Position entlang der Strecke in Metern) haben."@de ;
        sh:message "Chaque CurveChange doit avoir exactement une pos (entier non signé, position le long de la piste en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Curve (required, controlled vocabulary - curve radius category)
    sh:property [ 
        sh:path era:curve ;
        sh:in (
            <http://data.europa.eu/949/concepts/curve-radius/cr_R_7000>
            <http://data.europa.eu/949/concepts/curve-radius/cr_7000_4500>
            <http://data.europa.eu/949/concepts/curve-radius/cr_4500_2800>
            <http://data.europa.eu/949/concepts/curve-radius/cr_2800_2000>
            <http://data.europa.eu/949/concepts/curve-radius/cr_2000_1500>
            <http://data.europa.eu/949/concepts/curve-radius/cr_1500_1250>
            <http://data.europa.eu/949/concepts/curve-radius/cr_1250_1075>
            <http://data.europa.eu/949/concepts/curve-radius/cr_1075_925>
            <http://data.europa.eu/949/concepts/curve-radius/cr_925_825>
            <http://data.europa.eu/949/concepts/curve-radius/cr_825_725>
            <http://data.europa.eu/949/concepts/curve-radius/cr_725_625>
            <http://data.europa.eu/949/concepts/curve-radius/cr_625_525>
            <http://data.europa.eu/949/concepts/curve-radius/cr_525_475>
            <http://data.europa.eu/949/concepts/curve-radius/cr_475_425>
            <http://data.europa.eu/949/concepts/curve-radius/cr_425_375>
            <http://data.europa.eu/949/concepts/curve-radius/cr_375_325>
            <http://data.europa.eu/949/concepts/curve-radius/cr_325_300>
            <http://data.europa.eu/949/concepts/curve-radius/cr_300_275>
            <http://data.europa.eu/949/concepts/curve-radius/cr_275_250>
            <http://data.europa.eu/949/concepts/curve-radius/cr_250_225>
            <http://data.europa.eu/949/concepts/curve-radius/cr_225_200>
            <http://data.europa.eu/949/concepts/curve-radius/cr_200_175>
            <http://data.europa.eu/949/concepts/curve-radius/cr_175_150>
            <http://data.europa.eu/949/concepts/curve-radius/cr_R_150>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property curve must have a value from the defined SKOS concept scheme (curve radius categories from >7000m down to <150m)."@en ;
        sh:message "Die Eigenschaftskurve muss einen Wert aus dem definierten SKOS-Konzeptschema haben (Kurvenradiuskategorien von >7000 m bis <150 m)."@de ;
        sh:message "La courbe de propriété doit avoir une valeur issue du schéma conceptuel SKOS défini (catégories de rayon de courbe de >7 000 m à <150 m)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Digital Register Handshake Acknowledgement Shape =====
era:DigitalRegisterHandshakeAcknowledgementShape a sh:NodeShape ;
    sh:targetClass era:DigitalRegisterHandshakeAcknowledgement ;
    sh:message "Acknowledgement message for successful digital register handshake between train and trackside."@en ;
    sh:message "Bestätigungsnachricht für den erfolgreichen digitalen Register-Handshake zwischen Zug und Gleis."@de ;
    sh:message "Message d'accusé de réception pour une prise de contact réussie du registre numérique entre le train et le bord de la voie."@fr ;
    
    # Track Train Header (required, message header)
    sh:property [ 
        sh:path era:trackTrainHeader ;
        sh:node era:TrackTrainHeaderShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterHandshakeAcknowledgement must have exactly one trackTrainHeader that conforms to TrackTrainHeader object."@en ;
        sh:message "Jedes DigitalRegisterHandshakeAcknowledgement muss genau ein trackTrainHeader haben, das dem TrackTrainHeader-Objekt entspricht."@de ;
        sh:message "Chaque DigitalRegisterHandshakeAcknowledgement doit avoir exactement un trackTrainHeader conforme à l'objet TrackTrainHeader."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID C (required, unsigned integer 0-1023 - country identifier)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterHandshakeAcknowledgement must have exactly one nid_c (unsigned integer 0-1023, ETCS country identifier)."@en ;
        sh:message "Jedes DigitalRegisterHandshakeAcknowledgement muss genau ein nid_c (vorzeichenlose Ganzzahl 0-1023, ETCS-Länderkennung) haben."@de ;
        sh:message "Chaque DigitalRegisterHandshakeAcknowledgement doit avoir exactement un nid_c (entier non signé 0-1023, identifiant de pays ETCS)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID DRTA (required, unsigned integer - DRTA identifier)
    sh:property [ 
        sh:path era:nidDRTA ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterHandshakeAcknowledgement must have exactly one nidDRTA (unsigned integer, Digital RTA identifier)."@en ;
        sh:message "Jedes DigitalRegisterHandshakeAcknowledgement muss genau eine nidDRTA (vorzeichenlose Ganzzahl, digitale RTA-Kennung) haben."@de ;
        sh:message "Chaque DigitalRegisterHandshakeAcknowledgement doit avoir exactement un nidDRTA (entier non signé, identifiant Digital RTA)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # System Version (required, unsigned integer - protocol version)
    sh:property [ 
        sh:path era:systemVersion ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterHandshakeAcknowledgement must have exactly one systemVersion (unsigned integer, digital register protocol version)."@en ;
        sh:message "Jedes DigitalRegisterHandshakeAcknowledgement muss genau eine systemVersion (vorzeichenlose Ganzzahl, digitale Registerprotokollversion) haben."@de ;
        sh:message "Chaque DigitalRegisterHandshakeAcknowledgement doit avoir exactement un systemVersion (entier non signé, version du protocole de registre numérique)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Time Out Response (required, unsigned integer - timeout in seconds)
    sh:property [ 
        sh:path era:timeOutResponse ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterHandshakeAcknowledgement must have exactly one timeOutResponse (unsigned integer, response timeout in seconds)."@en ;
        sh:message "Jedes DigitalRegisterHandshakeAcknowledgement muss genau eine timeOutResponse haben (Ganzzahl ohne Vorzeichen, Antwortzeitüberschreitung in Sekunden)."@de ;
        sh:message "Chaque DigitalRegisterHandshakeAcknowledgement doit avoir exactement un timeOutResponse (entier non signé, délai d'attente de réponse en secondes)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Digital Register Handshake Rejection Shape =====
era:DigitalRegisterHandshakeRejectionShape a sh:NodeShape ;
    sh:targetClass era:DigitalRegisterHandshakeRejection ;
    sh:message "Rejection message for digital register handshake with reason for failure."@en ;
    sh:message "Ablehnungsmeldung für Digitalregister-Handshake mit Fehlergrund."@de ;
    sh:message "Message de rejet pour la prise de contact du registre numérique avec raison de l'échec."@fr ;
    
    # Track Train Header (required, message header)
    sh:property [ 
        sh:path era:trackTrainHeader ;
        sh:node era:TrackTrainHeaderShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterHandshakeRejection must have exactly one trackTrainHeader that conforms to TrackTrainHeader object."@en ;
        sh:message "Jede DigitalRegisterHandshakeRejection muss genau ein trackTrainHeader haben, das dem TrackTrainHeader-Objekt entspricht."@de ;
        sh:message "Chaque DigitalRegisterHandshakeRejection doit avoir exactement un trackTrainHeader conforme à l'objet TrackTrainHeader."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Rejection Reason (required, controlled vocabulary)
    sh:property [ 
        sh:path era:rejectionReason ;
        sh:in (
            <http://data.europa.eu/949/concepts/reject-reason/incompatibleSystemVersion>
            <http://data.europa.eu/949/concepts/reject-reason/anotherDRTAInCharge>
            <http://data.europa.eu/949/concepts/reject-reason/DRTAInChargeUnknown>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property rejectionReason must have a value from the defined SKOS concept scheme (incompatibleSystemVersion, anotherDRTAInCharge, or DRTAInChargeUnknown)."@en ;
        sh:message "Die Eigenschaft rejectionReason muss einen Wert aus dem definierten SKOS-Konzeptschema (incompatibleSystemVersion, anotherDRTAInCharge oder DRTAInChargeUnknown) haben."@de ;
        sh:message "La propriété rejectionReason doit avoir une valeur du schéma de concept SKOS défini (incompatibleSystemVersion, anotherDRTAInCharge ou DRTAInChargeUnknown)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Contact Information (optional, alternative DRTA contact)
    sh:property [ 
        sh:path era:contactInformation ;
        sh:node era:ContactInformationShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A DigitalRegisterHandshakeRejection may have at most one contactInformation that conforms to ContactInformation object."@en ;
        sh:message "Eine DigitalRegisterHandshakeRejection kann höchstens ein contactInformation haben, das dem ContactInformation-Objekt entspricht."@de ;
        sh:message "Un DigitalRegisterHandshakeRejection peut avoir au plus un contactInformation conforme à l'objet ContactInformation."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Digital Register Handshake Request Shape =====
era:DigitalRegisterHandshakeRequestShape a sh:NodeShape ;
    sh:targetClass era:DigitalRegisterHandshakeRequest ;
    sh:message "Request message to initiate digital register communication session between train and trackside."@en ;
    sh:message "Anforderungsnachricht zum Initiieren einer digitalen Registerkommunikationssitzung zwischen Zug und Gleis."@de ;
    sh:message "Demander un message pour lancer une session de communication du registre numérique entre le train et le bord de la voie."@fr ;
    
    # Track Train Header (required, message header)
    sh:property [ 
        sh:path era:trackTrainHeader ;
        sh:node era:TrackTrainHeaderShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterHandshakeRequest must have exactly one trackTrainHeader that conforms to TrackTrainHeader object."@en ;
        sh:message "Jede DigitalRegisterHandshakeRequest muss genau ein trackTrainHeader haben, das dem TrackTrainHeader-Objekt entspricht."@de ;
        sh:message "Chaque DigitalRegisterHandshakeRequest doit avoir exactement un trackTrainHeader conforme à l'objet TrackTrainHeader."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Absolute Position (required, geographic coordinates)
    sh:property [ 
        sh:path era:absolutePosition ;
        sh:node era:AbsolutePositionShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterHandshakeRequest must have exactly one absolutePosition that conforms to AbsolutePosition object."@en ;
        sh:message "Jede DigitalRegisterHandshakeRequest muss genau ein absolutePosition haben, das dem AbsolutePosition-Objekt entspricht."@de ;
        sh:message "Chaque DigitalRegisterHandshakeRequest doit avoir exactement un absolutePosition conforme à l'objet AbsolutePosition."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Relative Position (required, position on track)
    sh:property [ 
        sh:path era:relativePos ;
        sh:node era:RelativePositionShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterHandshakeRequest must have exactly one relativePos that conforms to RelativePosition object."@en ;
        sh:message "Jede DigitalRegisterHandshakeRequest muss genau ein relativePos haben, das dem RelativePosition-Objekt entspricht."@de ;
        sh:message "Chaque DigitalRegisterHandshakeRequest doit avoir exactement un relativePos conforme à l'objet RelativePosition."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Handing Over (required, boolean - handover flag)
    sh:property [ 
        sh:path era:handingOver ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterHandshakeRequest must have exactly one handingOver (boolean, true if handing over from another DRTA)."@en ;
        sh:message "Jede DigitalRegisterHandshakeRequest muss genau eine handingOver haben (boolean, true bei Übergabe von einem anderen DRTA)."@de ;
        sh:message "Chaque DigitalRegisterHandshakeRequest doit avoir exactement un handingOver (booléen, vrai en cas de transfert depuis un autre DRTA)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Digital Register Session Termination Request Shape =====
era:DigitalRegisterSessionTerminationRequestShape a sh:NodeShape ;
    sh:targetClass era:DigitalRegisterSessionTerminationRequest ;
    sh:message "Request message to terminate digital register communication session."@en ;
    sh:message "Anforderungsnachricht zum Beenden der Kommunikationssitzung mit dem digitalen Register."@de ;
    sh:message "Message de demande pour mettre fin à la session de communication du registre numérique."@fr ;
    
    # Track Train Header (required, message header)
    sh:property [ 
        sh:path era:trackTrainHeader ;
        sh:node era:TrackTrainHeaderShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterSessionTerminationRequest must have exactly one trackTrainHeader that conforms to TrackTrainHeader object."@en ;
        sh:message "Jede DigitalRegisterSessionTerminationRequest muss genau ein trackTrainHeader haben, das dem TrackTrainHeader-Objekt entspricht."@de ;
        sh:message "Chaque DigitalRegisterSessionTerminationRequest doit avoir exactement un trackTrainHeader conforme à l'objet TrackTrainHeader."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== Digital Register Session Termination Shape =====
era:DigitalRegisterSessionTerminationShape a sh:NodeShape ;
    sh:targetClass era:DigitalRegisterSessionTermination ;
    sh:message "Termination confirmation message for digital register communication session with reason."@en ;
    sh:message "Bestätigungsnachricht zur Beendigung der digitalen Registerkommunikationssitzung mit Begründung."@de ;
    sh:message "Message de confirmation de fin de session de communication avec registre numérique avec motif."@fr ;
    
    # Track Train Header (required, message header)
    sh:property [ 
        sh:path era:trackTrainHeader ;
        sh:node era:TrackTrainHeaderShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DigitalRegisterSessionTermination must have exactly one trackTrainHeader that conforms to TrackTrainHeader object."@en ;
        sh:message "Jede DigitalRegisterSessionTermination muss genau ein trackTrainHeader haben, das dem TrackTrainHeader-Objekt entspricht."@de ;
        sh:message "Chaque DigitalRegisterSessionTermination doit avoir exactement un trackTrainHeader conforme à l'objet TrackTrainHeader."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Termination Reason (required, controlled vocabulary)
    sh:property [ 
        sh:path era:terminationReason ;
        sh:in (
            <http://data.europa.eu/949/concepts/termination-reason/DRTATerminationRequest>
            <http://data.europa.eu/949/concepts/termination-reason/lastSPLeft>
            <http://data.europa.eu/949/concepts/termination-reason/DRTAHandoverCancelled>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property terminationReason must have a value from the defined SKOS concept scheme (DRTATerminationRequest, lastSPLeft, or DRTAHandoverCancelled)."@en ;
        sh:message "Die Eigenschaft terminationReason muss einen Wert aus dem definierten SKOS-Konzeptschema (DRTATerminationRequest, lastSPLeft oder DRTAHandoverCancelled) haben."@de ;
        sh:message "La propriété terminationReason doit avoir une valeur du schéma de concept SKOS défini (DRTATerminationRequest, lastSPLeft ou DRTAHandoverCancelled)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Driving Profile Shape =====
era:DrivingProfileShape a sh:NodeShape ;
    sh:targetClass era:DrivingProfile ;
    sh:message "Comprehensive track profile for ATO driving including gradients, curves, speeds, voltages, and infrastructure elements."@en ;
    sh:message "Umfassendes Streckenprofil für ATO-Fahrten, einschließlich Steigungen, Kurven, Geschwindigkeiten, Spannungen und Infrastrukturelementen."@de ;
    sh:message "Profil de piste complet pour la conduite ATO, comprenant les pentes, les courbes, les vitesses, les tensions et les éléments d'infrastructure."@fr ;
    
    # Static Speed Profile Start (required, initial speed)
    sh:property [ 
        sh:path era:staticSpeedProfileStart ;
        sh:node era:StaticSpeedProfileStartShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DrivingProfile must have exactly one staticSpeedProfileStart that conforms to StaticSpeedProfileStart object."@en ;
        sh:message "Jedes DrivingProfile muss genau ein staticSpeedProfileStart haben, das dem StaticSpeedProfileStart-Objekt entspricht."@de ;
        sh:message "Chaque DrivingProfile doit avoir exactement un staticSpeedProfileStart conforme à l'objet StaticSpeedProfileStart."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Voltage Start (required, initial voltage system)
    sh:property [ 
        sh:path era:voltageStart ;
        sh:node era:VoltageStartShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DrivingProfile must have exactly one voltageStart that conforms to VoltageStart object."@en ;
        sh:message "Jedes DrivingProfile muss genau ein voltageStart haben, das dem VoltageStart-Objekt entspricht."@de ;
        sh:message "Chaque DrivingProfile doit avoir exactement un voltageStart conforme à l'objet VoltageStart."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Gradient Start (required, integer - initial gradient in per mille)
    sh:property [ 
        sh:path era:gradientStart ;
        sh:datatype xsd:int ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DrivingProfile must have exactly one gradientStart (integer, initial track gradient in per mille)."@en ;
        sh:message "Jedes DrivingProfile muss genau eine gradientStart (Ganzzahl, anfänglicher Streckengradient in Promille) haben."@de ;
        sh:message "Chaque DrivingProfile doit avoir exactement un gradientStart (entier, pente initiale de la piste en pour mille)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Start Altitude (required, integer - elevation in meters)
    sh:property [ 
        sh:path era:startAltitude ;
        sh:datatype xsd:int ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DrivingProfile must have exactly one startAltitude (integer, initial elevation in meters above sea level)."@en ;
        sh:message "Jedes DrivingProfile muss genau eine startAltitude (Ganzzahl, anfängliche Höhe in Metern über dem Meeresspiegel) haben."@de ;
        sh:message "Chaque DrivingProfile doit avoir exactement un startAltitude (entier, altitude initiale en mètres au-dessus du niveau de la mer)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Curve Start (required, controlled vocabulary - initial curve radius)
    sh:property [ 
        sh:path era:curveStart ;
        sh:in (
            <http://data.europa.eu/949/concepts/curve-radius/cr_R_7000>
            <http://data.europa.eu/949/concepts/curve-radius/cr_7000_4500>
            <http://data.europa.eu/949/concepts/curve-radius/cr_4500_2800>
            <http://data.europa.eu/949/concepts/curve-radius/cr_2800_2000>
            <http://data.europa.eu/949/concepts/curve-radius/cr_2000_1500>
            <http://data.europa.eu/949/concepts/curve-radius/cr_1500_1250>
            <http://data.europa.eu/949/concepts/curve-radius/cr_1250_1075>
            <http://data.europa.eu/949/concepts/curve-radius/cr_1075_925>
            <http://data.europa.eu/949/concepts/curve-radius/cr_925_825>
            <http://data.europa.eu/949/concepts/curve-radius/cr_825_725>
            <http://data.europa.eu/949/concepts/curve-radius/cr_725_625>
            <http://data.europa.eu/949/concepts/curve-radius/cr_625_525>
            <http://data.europa.eu/949/concepts/curve-radius/cr_525_475>
            <http://data.europa.eu/949/concepts/curve-radius/cr_475_425>
            <http://data.europa.eu/949/concepts/curve-radius/cr_425_375>
            <http://data.europa.eu/949/concepts/curve-radius/cr_375_325>
            <http://data.europa.eu/949/concepts/curve-radius/cr_325_300>
            <http://data.europa.eu/949/concepts/curve-radius/cr_300_275>
            <http://data.europa.eu/949/concepts/curve-radius/cr_275_250>
            <http://data.europa.eu/949/concepts/curve-radius/cr_250_225>
            <http://data.europa.eu/949/concepts/curve-radius/cr_225_200>
            <http://data.europa.eu/949/concepts/curve-radius/cr_200_175>
            <http://data.europa.eu/949/concepts/curve-radius/cr_175_150>
            <http://data.europa.eu/949/concepts/curve-radius/cr_R_150>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property curveStart must have a value from the defined SKOS concept scheme (curve radius categories)."@en ;
        sh:message "Die Eigenschaft curveStart muss einen Wert aus dem definierten SKOS-Konzeptschema (Kurvenradiuskategorien) haben."@de ;
        sh:message "La propriété curveStart doit avoir une valeur issue du schéma conceptuel SKOS défini (catégories de rayon de courbe)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Current Start (required, unsigned integer - initial current in amperes)
    sh:property [ 
        sh:path era:currentStart ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DrivingProfile must have exactly one currentStart (unsigned integer, initial maximum current in amperes)."@en ;
        sh:message "Jedes DrivingProfile muss genau eine currentStart (vorzeichenlose Ganzzahl, anfänglicher Maximalstrom in Ampere) haben."@de ;
        sh:message "Chaque DrivingProfile doit avoir exactement un currentStart (entier non signé, courant maximum initial en ampères)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # EOA Offset (required, unsigned integer - end of authority offset in meters)
    sh:property [ 
        sh:path era:eoaOffset ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DrivingProfile must have exactly one eoaOffset (unsigned integer, end of authority offset in meters)."@en ;
        sh:message "Jedes DrivingProfile muss genau eine eoaOffset haben (Ganzzahl ohne Vorzeichen, Offset des Autoritätsendes in Metern)."@de ;
        sh:message "Chaque DrivingProfile doit avoir exactement un eoaOffset (entier non signé, décalage de fin d'autorité en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # UTC Offset (required, controlled vocabulary - timezone offset)
    sh:property [ 
        sh:path era:utcOffset ;
        sh:in (
            # Negative offsets (UTC-14:00 to UTC-00:15)
            <http://data.europa.eu/949/concepts/utc-offset/utc_Neg_1400>
            <http://data.europa.eu/949/concepts/utc-offset/utc_Neg_1345>
            <http://data.europa.eu/949/concepts/utc-offset/utc_Neg_1330>
