        sh:maxCount 1 ;
        sh:message "Each SegmentProfileRequest must have exactly one nidSP (unsigned integer, requested segment profile identifier)."@en ;
        sh:message "Jede SegmentProfileRequest muss genau eine nidSP (vorzeichenlose Ganzzahl, angeforderte Segmentprofil-ID) haben."@de ;
        sh:message "Chaque SegmentProfileRequest doit avoir exactement un nidSP (entier non signé, identifiant de profil de segment demandé)."@fr ;
