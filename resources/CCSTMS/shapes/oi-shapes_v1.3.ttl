        sh:message "Ein OI kann mehrere validierte segmentProfilePackets enthalten."@de ;
        sh:message "Un OI peut contenir plusieurs segmentProfilePackets validés."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Permitted Braking Distance Shape =====
era:PermittedBrakingDistanceShape a sh:NodeShape ;
    sh:targetClass era:PermittedBrakingDistance ;
    sh:message "Defines permitted braking distance for a track section."@en ;
    sh:message "Definiert den zulässigen Bremsweg für einen Streckenabschnitt."@de ;
    sh:message "Définit la distance de freinage autorisée pour un tronçon de voie."@fr ;
    
    # Segment Section (required, where distance applies)
    sh:property [ 
        sh:path era:segmentSection ;
        sh:node era:SegmentSectionShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PermittedBrakingDistance must reference exactly one segmentSection that conforms to SegmentSection object."@en ;
        sh:message "Jeder PermittedBrakingDistance muss auf genau einen segmentSection verweisen, der dem SegmentSection-Objekt entspricht."@de ;
        sh:message "Chaque PermitteBrakingDistance doit faire référence à exactement un segmentSection conforme à l'objet SegmentSection."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # By Emergency Brake (required, boolean - emergency or service brake)
    sh:property [ 
        sh:path era:byEmergencyBrake ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PermittedBrakingDistance must have exactly one byEmergencyBrake (boolean, true=emergency brake distance, false=service brake distance)."@en ;
        sh:message "Jede PermittedBrakingDistance muss genau eine byEmergencyBrake haben (boolean, true=Notbremsdistanz, false=Betriebsbremsdistanz)."@de ;
        sh:message "Chaque PermitteBrakingDistance doit avoir exactement un byEmergencyBrake (booléen, true = distance de freinage d'urgence, false = distance de freinage de service)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Relative Position Shape =====
era:RelativePositionShape a sh:NodeShape ;
    sh:targetClass era:RelativePosition ;
    sh:message "Position on track relative to segment profile reference system."@en ;
    sh:message "Position auf der Strecke relativ zum Segmentprofil-Referenzsystem."@de ;
    sh:message "Position sur la bonne voie par rapport au système de référence du profil de segment."@fr ;
    
    # NID SP (required, unsigned integer - segment profile identifier)
    sh:property [ 
        sh:path era:nidSP ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RelativePosition must have exactly one nidSP (unsigned integer, segment profile identifier)."@en ;
        sh:message "Jede RelativePosition muss genau eine nidSP (vorzeichenlose Ganzzahl, Segmentprofil-ID) haben."@de ;
        sh:message "Chaque RelativePosition doit avoir exactement un nidSP (entier non signé, identifiant de profil de segment)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Version (required, unsigned integer - segment profile version)
    sh:property [ 
        sh:path era:version ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RelativePosition must have exactly one version (unsigned integer, segment profile data version)."@en ;
        sh:message "Jede RelativePosition muss genau eine Version haben (vorzeichenlose Ganzzahl, Segmentprofildatenversion)."@de ;
        sh:message "Chaque RelativePosition doit avoir exactement une version (entier non signé, version des données de profil de segment)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID C (required, unsigned integer 0-1023 - country identifier)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RelativePosition must have exactly one nid_c (unsigned integer 0-1023, ETCS country identifier)."@en ;
        sh:message "Jede RelativePosition muss genau ein nid_c (vorzeichenlose Ganzzahl 0-1023, ETCS-Länderkennung) haben."@de ;
        sh:message "Chaque RelativePosition doit avoir exactement un nid_c (entier non signé 0-1023, identifiant de pays ETCS)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Position (required, unsigned integer - offset in meters)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RelativePosition must have exactly one pos (unsigned integer, position offset within segment in meters)."@en ;
        sh:message "Jede RelativePosition muss genau eine Pos (vorzeichenlose Ganzzahl, Positionsoffset innerhalb des Segments in Metern) haben."@de ;
        sh:message "Chaque RelativePosition doit avoir exactement une pos (entier non signé, décalage de position dans le segment en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Segment Description Shape =====
era:SegmentDescriptionShape a sh:NodeShape ;
    sh:targetClass era:SegmentDescription ;
    sh:message "Complete description of track segment including geometry and driving characteristics."@en ;
    sh:message "Vollständige Beschreibung des Streckenabschnitts einschließlich Geometrie und Fahreigenschaften."@de ;
    sh:message "Description complète du segment de piste, y compris la géométrie et les caractéristiques de conduite."@fr ;
    
    # Geometry Profile (optional, spatial geometry)
    sh:property [ 
        sh:path era:geometryProfile ;
        sh:node era:GeometryProfileShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A SegmentDescription may have at most one geometryProfile that conforms to GeometryProfile object."@en ;
        sh:message "Eine SegmentDescription darf höchstens eine geometryProfile haben, die dem GeometryProfile-Objekt entspricht."@de ;
        sh:message "Une SegmentDescription peut avoir au plus un geometryProfile conforme à l'objet GeometryProfile."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Driving Profile (optional, operational characteristics)
    sh:property [ 
        sh:path era:drivingProfile ;
        sh:node era:DrivingProfileShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A SegmentDescription may have at most one drivingProfile that conforms to DrivingProfile object."@en ;
        sh:message "Eine SegmentDescription kann höchstens eine drivingProfile haben, die dem DrivingProfile-Objekt entspricht."@de ;
        sh:message "Une SegmentDescription peut avoir au plus un drivingProfile conforme à l'objet DrivingProfile."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Segment Profile List Shape =====
era:SegmentProfileListShape a sh:NodeShape ;
    sh:targetClass era:SegmentProfileList ;
    sh:message "List header identifying segment profile with country, ID, and version."@en ;
    sh:message "Listenkopf, der das Segmentprofil mit Land, ID und Version identifiziert."@de ;
    sh:message "En-tête de liste identifiant le profil de segment avec le pays, l'ID et la version."@fr ;
    
    # NID SP (required, unsigned integer - segment profile identifier)
    sh:property [ 
        sh:path era:nidSP ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SegmentProfileList must have exactly one nidSP (unsigned integer, segment profile identifier)."@en ;
        sh:message "Jede SegmentProfileList muss genau eine nidSP (vorzeichenlose Ganzzahl, Segmentprofil-ID) haben."@de ;
        sh:message "Chaque SegmentProfileList doit avoir exactement un nidSP (entier non signé, identifiant de profil de segment)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID C (required, unsigned integer 0-1023 - country identifier)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SegmentProfileList must have exactly one nid_c (unsigned integer 0-1023, ETCS country identifier)."@en ;
        sh:message "Jede SegmentProfileList muss genau ein nid_c (vorzeichenlose Ganzzahl 0-1023, ETCS-Länderkennung) haben."@de ;
        sh:message "Chaque SegmentProfileList doit avoir exactement un nid_c (entier non signé 0-1023, identifiant de pays ETCS)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Version (required, unsigned integer - data version)
    sh:property [ 
        sh:path era:version ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SegmentProfileList must have exactly one version (unsigned integer, segment profile data version)."@en ;
        sh:message "Jede SegmentProfileList muss genau eine Version haben (vorzeichenlose Ganzzahl, Segmentprofildatenversion)."@de ;
        sh:message "Chaque SegmentProfileList doit avoir exactement une version (entier non signé, version des données de profil de segment)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== Segment Profile Packet Shape =====
era:SegmentProfilePacketShape a sh:NodeShape ;
    sh:targetClass era:SegmentProfilePacket ;
    sh:message "Packet containing one or more segment profiles for digital register transmission."@en ;
    sh:message "Paket, das ein oder mehrere Segmentprofile für die digitale Registerübertragung enthält."@de ;
    sh:message "Paquet contenant un ou plusieurs profils de segments pour la transmission de registres numériques."@fr ;
    
    # Track Train Header (required, message header)
    sh:property [ 
        sh:path era:trackTrainHeader ;
