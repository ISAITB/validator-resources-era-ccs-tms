# ===== Segment Profile Shape =====
era:SegmentProfileShape a sh:NodeShape ;
    sh:targetClass era:SegmentProfile ;
    sh:message "Complete profile for track segment including topology connections and segment description."@en ;
    sh:message "Komplettes Profil für Gleissegment inklusive Topologieverbindungen und Segmentbeschreibung."@de ;
    sh:message "Profil complet pour le segment de voie, y compris les connexions topologiques et la description du segment."@fr ;
    
    # NID SP (required, unsigned integer - segment profile identifier)
    sh:property [ 
        sh:path era:nidSP ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SegmentProfile must have exactly one nidSP (unsigned integer, segment profile identifier)."@en ;
        sh:message "Jedes SegmentProfile muss genau eine nidSP (vorzeichenlose Ganzzahl, Segmentprofil-ID) haben."@de ;
        sh:message "Chaque SegmentProfile doit avoir exactement un nidSP (entier non signé, identifiant de profil de segment)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID C (required, unsigned integer 0-1023 - country identifier)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SegmentProfile must have exactly one nid_c (unsigned integer 0-1023, ETCS country identifier)."@en ;
        sh:message "Jedes SegmentProfile muss genau ein nid_c (vorzeichenlose Ganzzahl 0-1023, ETCS-Länderkennung) haben."@de ;
        sh:message "Chaque SegmentProfile doit avoir exactement un nid_c (entier non signé 0-1023, identifiant de pays ETCS)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Version (required, unsigned integer - data version)
    sh:property [ 
        sh:path era:version ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SegmentProfile must have exactly one version (unsigned integer, segment profile data version)."@en ;
        sh:message "Jedes SegmentProfile muss genau eine Version haben (vorzeichenlose Ganzzahl, Segmentprofildatenversion)."@de ;
        sh:message "Chaque SegmentProfile doit avoir exactement une version (entier non signé, version des données du profil de segment)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Segment Profile Length (required, unsigned integer - length in meters)
    sh:property [ 
        sh:path era:segmentProfileLength ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SegmentProfile must have exactly one segmentProfileLength (unsigned integer, total segment length in meters)."@en ;
        sh:message "Jedes SegmentProfile muss genau eine segmentProfileLength (vorzeichenlose Ganzzahl, Gesamtsegmentlänge in Metern) haben."@de ;
        sh:message "Chaque SegmentProfile doit avoir exactement un segmentProfileLength (entier non signé, longueur totale du segment en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Segment Description (required, profile content)
    sh:property [ 
        sh:path era:segmentDescription ;
        sh:node era:SegmentDescriptionShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SegmentProfile must have exactly one segmentDescription that conforms to SegmentDescription object."@en ;
        sh:message "Jedes SegmentProfile muss genau ein segmentDescription haben, das dem SegmentDescription-Objekt entspricht."@de ;
        sh:message "Chaque SegmentProfile doit avoir exactement un segmentDescription conforme à l'objet SegmentDescription."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Adjacent Segment Profiles (required, 1-4 connections)
    sh:property [ 
        sh:path era:adjacentSegmentProfiles ;
        sh:node era:AdjacentSegmentProfileShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 4 ;
        sh:message "Each SegmentProfile must have 1-4 adjacentSegmentProfiles that conform to AdjacentSegmentProfile object."@en ;
        sh:message "Jedes SegmentProfile muss 1–4 adjacentSegmentProfiles haben, die dem AdjacentSegmentProfile-Objekt entsprechen."@de ;
        sh:message "Chaque SegmentProfile doit avoir 1 à 4 adjacentSegmentProfiles conformes à l'objet AdjacentSegmentProfile."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Segment Section Shape =====
era:SegmentSectionShape a sh:NodeShape ;
    sh:targetClass era:SegmentSection ;
    sh:message "Defines a section within a segment profile using start and end positions."@en ;
    sh:message "Definiert einen Abschnitt innerhalb eines Segmentprofils mithilfe von Start- und Endpositionen."@de ;
    sh:message "Définit une section dans un profil de segment à l'aide des positions de début et de fin."@fr ;
    
    # Range (required, controlled vocabulary - range type)
    sh:property [ 
        sh:path era:range ;
        sh:in (
            <http://data.europa.eu/949/concepts/range-type/rtStart>
            <http://data.europa.eu/949/concepts/range-type/rtEnd>
            <http://data.europa.eu/949/concepts/range-type/rtStartEnd>
            <http://data.europa.eu/949/concepts/range-type/rtWholeSP>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property range must have a value from the defined SKOS concept scheme (rtStart, rtEnd, rtStartEnd, or rtWholeSP)."@en ;
        sh:message "Der Eigenschaftsbereich muss einen Wert aus dem definierten SKOS-Konzeptschema (rtStart, rtEnd, rtStartEnd oder rtWholeSP) haben."@de ;
        sh:message "La plage de propriétés doit avoir une valeur du schéma de concept SKOS défini (rtStart, rtEnd, rtStartEnd ou rtWholeSP)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # P Start (required, unsigned integer - start position in meters)
    sh:property [ 
        sh:path era:pStart ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SegmentSection must have exactly one pStart (unsigned integer, section start position in meters from segment beginning)."@en ;
        sh:message "Jeder Segmentabschnitt muss genau eine pStart haben (vorzeichenlose Ganzzahl, Abschnittsstartposition in Metern vom Segmentanfang)."@de ;
        sh:message "Chaque SegmentSection doit avoir exactement un pStart (entier non signé, position de début de section en mètres à partir du début du segment)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # P End (required, unsigned integer - end position in meters)
    sh:property [ 
        sh:path era:pEnd ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SegmentSection must have exactly one pEnd (unsigned integer, section end position in meters from segment beginning)."@en ;
        sh:message "Jeder Segmentabschnitt muss genau eine pEnd haben (vorzeichenlose Ganzzahl, Abschnittsendposition in Metern vom Segmentanfang)."@de ;
        sh:message "Chaque SegmentSection doit avoir exactement un pEnd (entier non signé, position de fin de section en mètres à partir du début du segment)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Static Speed Profile Change Shape =====
era:StaticSpeedProfileChangeShape a sh:NodeShape ;
    sh:targetClass era:StaticSpeedProfileChange ;
    sh:message "Defines a change in static speed limit at a specific position."@en ;
    sh:message "Definiert eine Änderung der statischen Geschwindigkeitsbegrenzung an einer bestimmten Position."@de ;
    sh:message "Définit un changement de limite de vitesse statique à une position spécifique."@fr ;
    
    # Position (required, unsigned integer - position in meters)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StaticSpeedProfileChange must have exactly one pos (unsigned integer, position along track in meters)."@en ;
        sh:message "Jeder StaticSpeedProfileChange muss genau eine Position (vorzeichenlose Ganzzahl, Position entlang der Strecke in Metern) haben."@de ;
        sh:message "Chaque StaticSpeedProfileChange doit avoir exactement une position (entier non signé, position le long de la piste en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Speed (required, unsigned integer - speed limit in km/h)
    sh:property [ 
        sh:path era:speed ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StaticSpeedProfileChange must have exactly one speed (unsigned integer, new speed limit in km/h)."@en ;
        sh:message "Jeder StaticSpeedProfileChange muss genau eine Geschwindigkeit haben (vorzeichenlose Ganzzahl, neue Geschwindigkeitsbegrenzung in km/h)."@de ;
        sh:message "Chaque StaticSpeedProfileChange doit avoir exactement une vitesse (entier non signé, nouvelle limite de vitesse en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train End Applicability (required, controlled vocabulary)
    sh:property [ 
        sh:path era:trainEndApplicability ;
        sh:in (
            <http://data.europa.eu/949/concepts/train-end-applicability/lengthDelay>
            <http://data.europa.eu/949/concepts/train-end-applicability/noLengthDelay>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property trainEndApplicability must have a value from the defined SKOS concept scheme (lengthDelay or noLengthDelay)."@en ;
        sh:message "Die Eigenschaft trainEndApplicability muss einen Wert aus dem definierten SKOS-Konzeptschema (lengthDelay oder noLengthDelay) haben."@de ;
        sh:message "La propriété trainEndApplicability doit avoir une valeur du schéma de concept SKOS défini (lengthDelay ou noLengthDelay)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Specific Static Speed Profile (optional, train-type-specific limits)
    sh:property [ 
        sh:path era:specificStaticSpeedProfile ;
        sh:node era:SpecificStaticSpeedLimitShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A StaticSpeedProfileChange may have multiple validated specificStaticSpeedProfile entries for different train types."@en ;
        sh:message "Ein StaticSpeedProfileChange kann mehrere validierte specificStaticSpeedProfile-Einträge für verschiedene Zugtypen haben."@de ;
        sh:message "Un StaticSpeedProfileChange peut avoir plusieurs entrées specificStaticSpeedProfile validées pour différents types de train."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Static Speed Profile Start Shape =====
era:StaticSpeedProfileStartShape a sh:NodeShape ;
    sh:targetClass era:StaticSpeedProfileStart ;
    sh:message "Defines the initial static speed limit at the start of a segment profile."@en ;
    sh:message "Definiert die anfängliche statische Geschwindigkeitsbegrenzung am Anfang eines Segmentprofils."@de ;
    sh:message "Définit la limite de vitesse statique initiale au début d'un profil de segment."@fr ;
    
    # Speed (required, unsigned integer - initial speed in km/h)
    sh:property [ 
        sh:path era:speed ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StaticSpeedProfileStart must have exactly one speed (unsigned integer, initial speed limit in km/h)."@en ;
        sh:message "Jeder StaticSpeedProfileStart muss genau eine Geschwindigkeit haben (vorzeichenlose Ganzzahl, anfängliche Geschwindigkeitsbegrenzung in km/h)."@de ;
        sh:message "Chaque StaticSpeedProfileStart doit avoir exactement une vitesse (entier non signé, limite de vitesse initiale en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train End Applicability (required, controlled vocabulary)
    sh:property [ 
        sh:path era:trainEndApplicability ;
        sh:in (
            <http://data.europa.eu/949/concepts/train-end-applicability/lengthDelay>
            <http://data.europa.eu/949/concepts/train-end-applicability/noLengthDelay>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property trainEndApplicability must have a value from the defined SKOS concept scheme (lengthDelay or noLengthDelay)."@en ;
        sh:message "Die Eigenschaft trainEndApplicability muss einen Wert aus dem definierten SKOS-Konzeptschema (lengthDelay oder noLengthDelay) haben."@de ;
        sh:message "La propriété trainEndApplicability doit avoir une valeur du schéma de concept SKOS défini (lengthDelay ou noLengthDelay)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Specific Static Speed Profile (optional, train-type-specific limits)
    sh:property [ 
        sh:path era:specificStaticSpeedProfile ;
        sh:node era:SpecificStaticSpeedLimitShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A StaticSpeedProfileStart may have multiple validated specificStaticSpeedProfile entries for different train types."@en ;
        sh:message "Ein StaticSpeedProfileStart kann mehrere validierte specificStaticSpeedProfile-Einträge für verschiedene Zugtypen haben."@de ;
        sh:message "Un StaticSpeedProfileStart peut avoir plusieurs entrées specificStaticSpeedProfile validées pour différents types de train."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Timing Point Mapping Shape =====
era:TimingPointMappingShape a sh:NodeShape ;
    sh:targetClass era:TimingPointMapping ;
    sh:message "Maps infrastructure timing points to ATO timing points for schedule coordination."@en ;
    sh:message "Ordnet Infrastruktur-Timing-Punkte den ATO-Timing-Punkten zur Zeitplankoordinierung zu."@de ;
    sh:message "Mappe les points de synchronisation de l’infrastructure aux points de synchronisation ATO pour la coordination du calendrier."@fr ;
    
    # Infrastructure Timing Point (required, reference to infrastructure timing point)
    sh:property [ 
        sh:path era:infraTimingPoint ;
        sh:class era:TimingPoint ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TimingPointMapping must reference exactly one infraTimingPoint that conforms to TimingPoint object."@en ;
        sh:message "Jedes TimingPointMapping muss genau ein infraTimingPoint referenzieren, das dem TimingPoint-Objekt entspricht."@de ;
        sh:message "Chaque TimingPointMapping doit référencer exactement un infraTimingPoint conforme à l'objet TimingPoint."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # ATO Timing Point (required, reference to ATO timing point)
    sh:property [ 
        sh:path era:atoTimingPoint ;
        sh:class era:TimingPoint ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TimingPointMapping must reference exactly one atoTimingPoint that conforms to TimingPoint object."@en ;
        sh:message "Jedes TimingPointMapping muss genau ein atoTimingPoint referenzieren, das dem TimingPoint-Objekt entspricht."@de ;
        sh:message "Chaque TimingPointMapping doit référencer exactement un atoTimingPoint conforme à l'objet TimingPoint."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== Timing Point Shape =====
era:TimingPointShape a sh:NodeShape ;
    sh:targetClass era:TimingPoint ;
    sh:message "Operational timing point for schedule monitoring and ATO stopping precision."@en ;
    sh:message "Betriebszeitpunkt für die Zeitplanüberwachung und ATO-Stopppräzision."@de ;
    sh:message "Point de timing opérationnel pour la surveillance du calendrier et la précision d’arrêt de l’ATO."@fr ;
    
    # NID TP (required, unsigned integer - timing point identifier)
    sh:property [ 
        sh:path era:nidTP ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TimingPoint must have exactly one nidTP (unsigned integer, timing point identifier)."@en ;
        sh:message "Jeder TimingPoint muss genau eine nidTP (vorzeichenlose Ganzzahl, Timing-Point-ID) haben."@de ;
        sh:message "Chaque TimingPoint doit avoir exactement un nidTP (entier non signé, identifiant de point de timing)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Stop Location Tolerance (required, controlled vocabulary - stopping accuracy)
    sh:property [ 
        sh:path era:stopLocationTolerance ;
        sh:in (
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_Undefined>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_10cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_20cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_30cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_40cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_50cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_1m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_150cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_2m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_250cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_3m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_5m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_750cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_10m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_15m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_20m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_25m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_30m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_50m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_75m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_100m>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property stopLocationTolerance must have a value from the defined SKOS concept scheme (10cm to 100m tolerance levels)."@en ;
        sh:message "Die Eigenschaft stopLocationTolerance muss einen Wert aus dem definierten SKOS-Konzeptschema haben (Toleranzstufen 10 cm bis 100 m)."@de ;
        sh:message "La propriété stopLocationTolerance doit avoir une valeur issue du schéma conceptuel SKOS défini (niveaux de tolérance de 10 cm à 100 m)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Stopping Point Reach Distance (required, controlled vocabulary - approach distance)
    sh:property [ 
        sh:path era:stoppingPointReachDistance ;
        sh:in (
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_Undefined>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_10cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_20cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_30cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_40cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_50cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_1m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_150cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_2m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_250cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_3m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_5m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_750cm>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_10m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_15m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_20m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_25m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_30m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_50m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_75m>
            <http://data.europa.eu/949/concepts/stop-location-tolerance/T_100m>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property stoppingPointReachDistance must have a value from the defined SKOS concept scheme (distance before timing point to initiate stopping sequence)."@en ;
        sh:message "Die Eigenschaft stoppingPointReachDistance muss einen Wert aus dem definierten SKOS-Konzeptschema haben (Abstand vor dem Zeitpunkt zum Einleiten der Stoppsequenz)."@de ;
        sh:message "La propriété stoppingPointReachDistance doit avoir une valeur issue du schéma conceptuel SKOS défini (distance avant le point de timing pour lancer la séquence d'arrêt)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Track Train Header Shape =====
era:TrackTrainHeaderShape a sh:NodeShape ;
    sh:targetClass era:TrackTrainHeader ;
    sh:message "Message header for track-to-train and train-to-track digital register communications."@en ;
    sh:message "Nachrichtenkopf für die digitale Registerkommunikation Gleis-zu-Zug und Zug-zu-Gleis."@de ;
    sh:message "En-tête de message pour les communications de registre numérique voie-à-train et train-à-voie."@fr ;
    
    # Issued At (required, dateTime - message timestamp)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrackTrainHeader must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder TrackTrainHeader muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque TrackTrainHeader doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Packet ID (required, unsigned integer 0-255 - message sequence number)
    sh:property [ 
        sh:path era:packetId ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrackTrainHeader must have exactly one packetId (unsigned integer 0-255, message sequence identifier)."@en ;
        sh:message "Jeder TrackTrainHeader muss genau eine packetId (vorzeichenlose Ganzzahl 0-255, Nachrichtensequenz-ID) haben."@de ;
        sh:message "Chaque TrackTrainHeader doit avoir exactement un packetId (entier non signé 0-255, identifiant de séquence de message)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Leading OnBoard Unit ID (optional, string - onboard unit identifier)
    sh:property [ 
        sh:path era:leadingOnBoardUnitId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A TrackTrainHeader may have at most one leadingOnBoardUnitId (string, identifier of leading onboard unit)."@en ;
        sh:message "Ein TrackTrainHeader darf höchstens einen leadingOnBoardUnitId (String, Kennung der führenden Onboard-Einheit) haben."@de ;
        sh:message "Un TrackTrainHeader peut avoir au plus un leadingOnBoardUnitId (chaîne, identifiant de l'unité embarquée principale)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Tunnel Shape =====
era:TunnelShape a sh:NodeShape ;
    sh:targetClass era:Tunnel ;
    sh:message "Tunnel section with type classification for ATO operational considerations."@en ;
    sh:message "Tunnelabschnitt mit Typklassifizierung für ATO-Betriebserwägungen."@de ;
    sh:message "Section de tunnel avec classification de type pour les considérations opérationnelles ATO."@fr ;
    
    # Segment Section (required, tunnel location)
    sh:property [ 
        sh:path era:segmentSection ;
        sh:node era:SegmentSectionShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Tunnel must reference exactly one segmentSection that conforms to SegmentSection object."@en ;
        sh:message "Jeder Tunnel muss genau einen segmentSection referenzieren, der dem SegmentSection-Objekt entspricht."@de ;
        sh:message "Chaque tunnel doit référencer exactement un segmentSection conforme à l'objet SegmentSection."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Tunnel Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:tunnelType ;
        sh:in (
            <http://data.europa.eu/949/concepts/tunnel-type/singleTrackTunnel>
            <http://data.europa.eu/949/concepts/tunnel-type/doubleTrackTunnel>
            <http://data.europa.eu/949/concepts/tunnel-type/wideCrossSectionTunnel>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property tunnelType must have a value from the defined SKOS concept scheme (singleTrackTunnel, doubleTrackTunnel, or wideCrossSectionTunnel)."@en ;
        sh:message "Die Eigenschaft tunnelType muss einen Wert aus dem definierten SKOS-Konzeptschema (singleTrackTunnel, doubleTrackTunnel oder wideCrossSectionTunnel) haben."@de ;
        sh:message "La propriété tunnelType doit avoir une valeur du schéma de concept SKOS défini (singleTrackTunnel, doubleTrackTunnel ou wideCrossSectionTunnel)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Unprotected Level Crossing Shape =====
era:UnprotectedLXShape a sh:NodeShape ;
    sh:targetClass era:UnprotectedLX ;
    sh:message "Unprotected level crossing location requiring horn/whistle warning."@en ;
    sh:message "Ungeschützter Bahnübergang, der eine Hupen-/Pfeifwarnung erfordert."@de ;
    sh:message "Emplacement de passage à niveau non protégé nécessitant un avertissement sonore/sifflet."@fr ;
    
    # P Nominal (required, unsigned integer - nominal position in meters)
    sh:property [ 
        sh:path era:pNominal ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each UnprotectedLX must have exactly one pNominal (unsigned integer, nominal crossing position in meters for nominal direction)."@en ;
        sh:message "Jeder UnprotectedLX muss genau eine pNominal haben (vorzeichenlose Ganzzahl, nominelle Kreuzungsposition in Metern für nominelle Richtung)."@de ;
        sh:message "Chaque UnprotectedLX doit avoir exactement un pNominal (entier non signé, position de croisement nominale en mètres pour la direction nominale)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # P Reverse (required, unsigned integer - reverse position in meters)
    sh:property [ 
        sh:path era:pReverse ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each UnprotectedLX must have exactly one pReverse (unsigned integer, crossing position in meters for reverse direction)."@en ;
        sh:message "Jeder UnprotectedLX muss genau eine pReverse haben (Ganzzahl ohne Vorzeichen, Kreuzungsposition in Metern für umgekehrte Richtung)."@de ;
        sh:message "Chaque UnprotectedLX doit avoir exactement un pReverse (entier non signé, position de croisement en mètres pour le sens inverse)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Voltage Change Shape =====
era:VoltageChangeShape a sh:NodeShape ;
    sh:targetClass era:VoltageChange ;
    sh:message "Defines a change in electrical power supply system at a specific position."@en ;
    sh:message "Definiert eine Änderung des Stromversorgungssystems an einer bestimmten Position."@de ;
    sh:message "Définit un changement dans le système d'alimentation électrique à un endroit spécifique."@fr ;
    
    # Position (required, unsigned integer - position in meters)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each VoltageChange must have exactly one pos (unsigned integer, position along track in meters)."@en ;
        sh:message "Jede Spannungsänderung muss genau eine Position (vorzeichenlose Ganzzahl, Position entlang der Strecke in Metern) haben."@de ;
        sh:message "Chaque changement de tension doit avoir exactement une pos (entier non signé, position le long de la voie en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Voltage Type (required, controlled vocabulary - power system)
    sh:property [ 
        sh:path era:voltageType ;
        sh:in (
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtNotFitted>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtAC25kv50Hz>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtAC15kv16_7Hz>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC3kv>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC1_5kv>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC600v>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC650v>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC750v>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC850v>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property voltageType must have a value from the defined SKOS concept scheme (AC 25kV 50Hz, AC 15kV 16.7Hz, DC 3kV, DC 1.5kV, DC 750V, etc.)."@en ;
        sh:message "Die Eigenschaft voltageType muss einen Wert aus dem definierten SKOS-Konzeptschema haben (AC 25 kV 50 Hz, AC 15 kV 16,7 Hz, DC 3 kV, DC 1,5 kV, DC 750 V usw.)."@de ;
        sh:message "La propriété voltageType doit avoir une valeur issue du schéma conceptuel SKOS défini (AC 25kV 50Hz, AC 15kV 16,7Hz, DC 3kV, DC 1,5kV, DC 750V, etc.)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID C (required, unsigned integer 0-1023 - country identifier)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each VoltageChange must have exactly one nid_c (unsigned integer 0-1023, ETCS country identifier for traction system)."@en ;
        sh:message "Jeder Spannungswechsel muss genau einen nid_c (vorzeichenlose Ganzzahl 0-1023, ETCS-Länderkennung für Traktionssystem) haben."@de ;
        sh:message "Chaque changement de tension doit avoir exactement un nid_c (entier non signé 0-1023, identifiant de pays ETCS pour le système de traction)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Voltage Start Shape =====
era:VoltageStartShape a sh:NodeShape ;
    sh:targetClass era:VoltageStart ;
    sh:message "Defines the initial electrical power supply system at the start of a segment profile."@en ;
    sh:message "Definiert das anfängliche Stromversorgungssystem am Anfang eines Segmentprofils."@de ;
    sh:message "Définit le système d'alimentation électrique initial au début d'un profil de segment."@fr ;
    
    # Voltage Type (required, controlled vocabulary - power system)
    sh:property [ 
        sh:path era:voltageType ;
        sh:in (
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtNotFitted>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtAC25kv50Hz>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtAC15kv16_7Hz>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC3kv>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC1_5kv>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC600v>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC650v>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC750v>
            <http://data.europa.eu/949/concepts/energy-supply-systems/vtDC850v>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property voltageType must have a value from the defined SKOS concept scheme (AC 25kV 50Hz, AC 15kV 16.7Hz, DC 3kV, DC 1.5kV, DC 750V, etc.)."@en ;
        sh:message "Die Eigenschaft voltageType muss einen Wert aus dem definierten SKOS-Konzeptschema haben (AC 25 kV 50 Hz, AC 15 kV 16,7 Hz, DC 3 kV, DC 1,5 kV, DC 750 V usw.)."@de ;
        sh:message "La propriété voltageType doit avoir une valeur issue du schéma conceptuel SKOS défini (AC 25kV 50Hz, AC 15kV 16,7Hz, DC 3kV, DC 1,5kV, DC 750V, etc.)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID C (required, unsigned integer 0-1023 - country identifier)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each VoltageStart must have exactly one nid_c (unsigned integer 0-1023, ETCS country identifier for traction system)."@en ;
        sh:message "Jeder VoltageStart muss genau ein nid_c (vorzeichenlose Ganzzahl 0-1023, ETCS-Länderkennung für Traktionssystem) haben."@de ;
        sh:message "Chaque VoltageStart doit avoir exactement un nid_c (entier non signé 0-1023, identifiant de pays ETCS pour le système de traction)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	

# Shape to check that at least one On-Board Infrastructure class exists
era:AtLeastOneOnBoardInfrastructureClassShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            SELECT ?this
            WHERE {
                BIND (era:ValidationRoot as ?this)
            }
        """ ;
    ] ;
    
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The data must contain at least one instance of the required On-Board Infrastructure classes (e.g., OIArea, SegmentProfile, BaliseGroup, TimingPoint, etc.). This error may indicate that the provided data significantly deviates from the expected ATO On-Board Infrastructure model as defined in the extended ERA ontology."@en ;
        sh:message "Die Daten müssen mindestens eine Instanz der erforderlichen On-Board-Infrastrukturklassen enthalten (z. B. OIArea, SegmentProfile, BaliseGroup, TimingPoint usw.). Dieser Fehler kann darauf hinweisen, dass die bereitgestellten Daten erheblich vom erwarteten ATO-On-Board-Infrastrukturmodell gemäß der Definition in der erweiterten ERA-Ontologie abweichen."@de ;
        sh:message "Les données doivent contenir au moins une instance des classes d'infrastructure embarquées requises (par exemple, OIArea, SegmentProfile, BaliseGroup, TimingPoint, etc.). Cette erreur peut indiquer que les données fournies s'écartent considérablement du modèle d'infrastructure embarquée ATO attendu tel que défini dans l'ontologie ERA étendue."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    # Top-Level Container
                    { ?instance rdf:type era:OI . }
                    
                    # Area and Segment Classes
                    UNION { ?instance rdf:type era:OIArea . }
                    UNION { ?instance rdf:type era:TimingPointMapping . }
                    UNION { ?instance rdf:type era:OISegment . }
                    
                    # Segment Profile Classes
                    UNION { ?instance rdf:type era:SegmentProfile . }
                    UNION { ?instance rdf:type era:AdjacentSegmentProfile . }
                    UNION { ?instance rdf:type era:SegmentDescription . }
                    UNION { ?instance rdf:type era:SegmentSection . }
                    
                    # Profile Layer Classes
                    UNION { ?instance rdf:type era:DrivingProfile . }
                    UNION { ?instance rdf:type era:GeometryProfile . }
                    UNION { ?instance rdf:type era:Attitude . }
                    
                    # Speed Profile Classes
                    UNION { ?instance rdf:type era:StaticSpeedProfileStart . }
                    UNION { ?instance rdf:type era:StaticSpeedProfileChange . }
                    UNION { ?instance rdf:type era:AxleLoadSpeedProfile . }
                    
                    # Track Geometry Classes
                    UNION { ?instance rdf:type era:GradientChange . }
                    UNION { ?instance rdf:type era:CurveChange . }
                    
                    # Signaling and Location Classes
                    UNION { ?instance rdf:type era:TimingPoint . }
                    UNION { ?instance rdf:type era:BaliseGroup . }
                    UNION { ?instance rdf:type era:Balise . }
                    
                    # Braking Classes
                    UNION { ?instance rdf:type era:PermittedBrakingDistance . }
                    UNION { ?instance rdf:type era:LimitedDynamicBrakeForce . }
                    
                    # Power Supply Classes
                    UNION { ?instance rdf:type era:VoltageStart . }
                    UNION { ?instance rdf:type era:VoltageChange . }
                    UNION { ?instance rdf:type era:CurrentChange . }
                    
                    # Infrastructure Elements
                    UNION { ?instance rdf:type era:Tunnel . }
                    UNION { ?instance rdf:type era:UnprotectedLX . }
                    UNION { ?instance rdf:type era:AtoTSContactInfo . }
                    
                    # Position Classes
                    UNION { ?instance rdf:type era:RelativePosition . }
                    UNION { ?instance rdf:type era:AbsolutePosition . }
                    
                    # Map Area Classes
                    UNION { ?instance rdf:type era:MapAreaRequest . }
                    UNION { ?instance rdf:type era:MapArea . }
                    UNION { ?instance rdf:type era:SegmentProfileList . }
                    
                    # Segment Profile Communication Classes
                    UNION { ?instance rdf:type era:SegmentProfileRequest . }
                    UNION { ?instance rdf:type era:SegmentProfilePacket . }
                    
                    # Digital Register Handshake Classes
                    UNION { ?instance rdf:type era:DigitalRegisterHandshakeRequest . }
                    UNION { ?instance rdf:type era:DigitalRegisterHandshakeAcknowledgement . }
                    UNION { ?instance rdf:type era:DigitalRegisterHandshakeRejection . }
                    UNION { ?instance rdf:type era:ContactInformation . }
                    
                    # Session Termination Classes
                    UNION { ?instance rdf:type era:DigitalRegisterSessionTerminationRequest . }
                    UNION { ?instance rdf:type era:DigitalRegisterSessionTermination . }
                    
                    # Communication Header
                    UNION { ?instance rdf:type era:TrackTrainHeader . }
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .