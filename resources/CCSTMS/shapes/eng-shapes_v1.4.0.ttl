    sh:message "pbdSelection must be a well-formed PBDSelection (blank node or IRI)."@en ;
    sh:maxCount 32 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_57 #########################################
eng-sh:ss026-ETCSTrackToTrainPacket_57Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_57 ;
    sh:name "ETCSTrackToTrainPacket_57" ;
    sh:description "Movement Authority Request Parameters. This packet is intended to give parameters telling when and how often the train has to ask for a movement authority." ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_57-t_mar ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_57-t_timeoutrqst ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_57-t_cycrqst ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_57-t_mar
    a sh:PropertyShape ;
    sh:path era:t_mar ;
    sh:name "t_mar" ;
    sh:description "Time before reaching the perturbation location. A value of 255 seconds means that no MA request triggering with regards to this function" ;
    sh:order 1 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_57-t_timeoutrqst
    a sh:PropertyShape ;
    sh:path era:t_timeoutrqst ;
    sh:name "t_timeoutrqst" ;
    sh:description "Time before any section timer expires or the LOA speed timer expires" ;
    sh:order 2 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_57-t_cycrqst
    a sh:PropertyShape ;
    sh:path era:t_cycrqst ;
    sh:name "t_cycrqst" ;
    sh:description "Time between two cyclic requests for a movement authority. As long as at least one reason for sending MA requests is applicable, the on-board will repeat its request every T_CYCRQST seconds" ;
    sh:order 3 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_58 #########################################
eng-sh:ss026-ETCSTrackToTrainPacket_58Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_58 ;
    sh:name "ETCSTrackToTrainPacket_58" ;
    sh:description "Position Report Parameters. This packet is intended to give parameters telling when and how often the position has to be reported." ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_58-t_cycloc ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_58-d_cycloc ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_58-m_loc ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_58-hasPositionReportLocation ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_58-t_cycloc
    a sh:PropertyShape ;
    sh:path era:t_cycloc ;
    sh:name "t_cycloc" ;
    sh:description "Time Interval between two position reports sent by the train" ;
    sh:order 1 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_58-d_cycloc
    a sh:PropertyShape ;
    sh:path era:d_cycloc ;
    sh:name "d_cycloc" ;
    sh:description "Distance between two position reports from the train. The train has to report its position every D_CYCLOC meters." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_58-m_loc
    a sh:PropertyShape ;
    sh:path era:m_loc ;
    sh:name "m_loc" ;
    sh:description "Time between two cyclic requests for a movement authority. As long as at least one reason for sending MA requests is applicable, the on-board will repeat its request every T_CYCRQST seconds" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/prlt/now> <http://data.europa.eu/949/concepts/prlt/everyLRBG> <http://data.europa.eu/949/concepts/prlt/noReportOnLRBG> ) ;
    sh:message "Value must be one of the CCSTMS-scoped PositionReportLocationType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_58-hasPositionReportLocation
    a sh:PropertyShape ;
