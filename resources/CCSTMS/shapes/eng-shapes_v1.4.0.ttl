    .

eng-sh:ss026-ETCSTrackToTrainPacket_52-pbdSelection
    a sh:PropertyShape ;
    sh:path era:pbdSelection ;
    sh:name "pbdSelection" ;
    sh:description "List of permitted braking distance constraints" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
