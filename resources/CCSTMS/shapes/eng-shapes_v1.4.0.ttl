eng-sh:DangerPoint-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:DangerPoint-topologicalCoordinate
    a sh:PropertyShape ;
    sh:path era:topologicalCoordinate ;
    sh:name "topologicalCoordinate" ;
    sh:description "Defines the point location on the linear element" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:infra-TopologicalCoordinateShape ;
    sh:message "topologicalCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### FoulingPoint ######################################################
eng-sh:FoulingPointShape
    a sh:NodeShape ;
    sh:targetClass era:FoulingPoint ;
    sh:name "FoulingPoint" ;
