    .

### ETCSTrackToTrainPacket_51 #########################################
eng-sh:ss026-ETCSTrackToTrainPacket_51Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_51 ;
    sh:name "ETCSTrackToTrainPacket_51" ;
    sh:description "Axle Load Speed Profile (This packet gives the speed restrictions for trains with axle load category higher than or equal to the specified value for the speed restriction)" ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_51-q_trackinit ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_51-d_trackinit ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_51-d_axleload ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_51-l_axleload ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_51-q_front ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_51-axleLoadRestrictions ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_51-axleLoadSelections ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_51-q_trackinit
    a sh:PropertyShape ;
    sh:path era:q_trackinit ;
    sh:name "q_trackinit" ;
    sh:description "Qualifier for resuming the initial states of the related track description of the packet" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_51-d_trackinit
    a sh:PropertyShape ;
    sh:path era:d_trackinit ;
    sh:name "d_trackinit" ;
    sh:description "Distance to start of empty profile. Distance to where initial states of the related track description in the packet shall be resumed." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_51-d_axleload
    a sh:PropertyShape ;
    sh:path era:d_axleload ;
    sh:name "d_axleload" ;
    sh:description "Incremental distance to the start of the next Axle load speed profile. Note that Only if Q_TRACKINIT = 0, D_AXLELOAD and the following variables follow" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_51-l_axleload
    a sh:PropertyShape ;
    sh:path era:l_axleload ;
    sh:name "l_axleload" ;
    sh:description "Length of speed restriction due to Axle load." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_51-q_front
    a sh:PropertyShape ;
    sh:path era:q_front ;
    sh:name "q_front" ;
    sh:description "Qualifier for validity end point of profile element. Qualifier to indicate if a speed limit given for a profile element is to be applied until the front of the train (no train length delay) or the end of the train (train length delay) has left the element." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_51-axleLoadRestrictions
    a sh:PropertyShape ;
    sh:path era:axleLoadRestrictions ;
    sh:name "axleLoadRestrictions" ;
    sh:description "List of axle load restrictions for the selection" ;
    sh:order 6 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:ss026-AxleLoadRestrictionShape ;
    sh:message "axleLoadRestrictions must be a well-formed AxleLoadRestriction (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_51-axleLoadSelections
    a sh:PropertyShape ;
    sh:path era:axleLoadSelections ;
    sh:name "axleLoadSelections" ;
    sh:description "List of the selection criteria for axle load-based restrictions" ;
    sh:order 7 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:ss026-AxleLoadSelectionShape ;
    sh:message "axleLoadSelections must be a well-formed AxleLoadSelection (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_52 #########################################
eng-sh:ss026-ETCSTrackToTrainPacket_52Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_52 ;
    sh:name "ETCSTrackToTrainPacket_52" ;
