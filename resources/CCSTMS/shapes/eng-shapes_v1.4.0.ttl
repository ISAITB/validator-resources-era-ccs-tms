### LevelCrossing #####################################################
eng-sh:LevelCrossingShape
    a sh:NodeShape ;
    sh:targetClass era:LevelCrossing ;
    sh:name "LevelCrossing" ;
    sh:description "A level crossing is an intersection where a railway line crosses a road or a path at the same level. It can be used for the implementation of the ETCS trackside or to identify potential collision scenarios" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:LevelCrossing-dangerPoints ;
    sh:severity sh:Violation ;
    .

eng-sh:LevelCrossing-dangerPoints
    a sh:PropertyShape ;
    sh:path era:dangerPoints ;
    sh:name "dangerPoints" ;
    sh:description "refers to danger points" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:DangerPoint ;
    sh:message "dangerPoints must reference an existing era:DangerPoint by IRI."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

### BaliseGroup #######################################################
eng-sh:BaliseGroupShape
    a sh:NodeShape ;
    sh:targetClass era:BaliseGroup ;
    sh:name "BaliseGroup" ;
    sh:description "Defines a group of balises on the railway trackbed." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:BaliseGroup-etcsMVersion ;
    sh:property eng-sh:BaliseGroup-q_link ;
    sh:severity sh:Violation ;
    .

eng-sh:BaliseGroup-etcsMVersion
    a sh:PropertyShape ;
    sh:path era:etcsMVersion ;
    sh:name "etcsMVersion" ;
    sh:description "This gives the version of the ETCS system. Each part indicates the first and second number of the version respectively: The first number distinguishes not compatible versions (The three MSBs)_ The second number indicates compatibility within a version X. (The four LSBs)" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-m-versions/10> <http://data.europa.eu/949/concepts/etcs-m-versions/11> <http://data.europa.eu/949/concepts/etcs-m-versions/20> <http://data.europa.eu/949/concepts/etcs-m-versions/21> <http://data.europa.eu/949/concepts/etcs-m-versions/22> <http://data.europa.eu/949/concepts/etcs-m-versions/23> <http://data.europa.eu/949/concepts/etcs-m-versions/30> <http://data.europa.eu/949/concepts/etcs-m-versions/00> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSMVersions concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:BaliseGroup-q_link
    a sh:PropertyShape ;
    sh:path era:q_link ;
    sh:name "q_link" ;
    sh:description "true when the balise group is linked, otherwise, false (unlinked)" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### Balise ############################################################
eng-sh:BaliseShape
    a sh:NodeShape ;
    sh:targetClass era:Balise ;
    sh:name "Balise" ;
    sh:description "Defines a technical device on the railway trackbed." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:Balise-fixed ;
    sh:property eng-sh:Balise-m_dup ;
    sh:property eng-sh:Balise-m_mcount ;
    sh:property eng-sh:Balise-n_pig ;
    sh:property eng-sh:Balise-q_updown ;
    sh:property eng-sh:Balise-verticallyOriented ;
    sh:property eng-sh:Balise-standardSize ;
    sh:property eng-sh:Balise-etcsPackets ;
    sh:property eng-sh:Balise-telegram ;
    sh:property eng-sh:Balise-telegramChecksum ;
    sh:property eng-sh:Balise-sleeperFastening ;
    sh:property eng-sh:Balise-baliseMountingSystem ;
    sh:property eng-sh:Balise-designType ;
    sh:property eng-sh:Balise-sleepersType ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-fixed
    a sh:PropertyShape ;
    sh:path era:fixed ;
    sh:name "fixed" ;
    sh:description "Defines if the balise is fixed or virtual" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-m_dup
    a sh:PropertyShape ;
    sh:path era:m_dup ;
    sh:name "m_dup" ;
    sh:description "Defines whether the information of the balise is a duplicate of the balise before or after" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/duplication-type/noDuplicates> <http://data.europa.eu/949/concepts/duplication-type/duplicateNextBalise> <http://data.europa.eu/949/concepts/duplication-type/duplicatePreviousBalise> ) ;
    sh:message "Value must be one of the CCSTMS-scoped DuplicationType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-m_mcount
    a sh:PropertyShape ;
    sh:path era:m_mcount ;
    sh:name "m_mcount" ;
    sh:description "the purpose of message counter is to make it possible for the ERTMS/ETCS on-board to detect which balise group message the telegram belongs to." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-n_pig
    a sh:PropertyShape ;
    sh:path era:n_pig ;
    sh:name "n_pig" ;
    sh:description "position in the group. Defines the position of the balise in the balise group." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 7 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-q_updown
    a sh:PropertyShape ;
    sh:path era:q_updown ;
    sh:name "q_updown" ;
    sh:description "Balise telegram transmission direction. This defines the direction of the information in the balise telegram. True when it is Up-link (Track-to-Train) and false when it is Down-link (Train-to-Track)" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-verticallyOriented
    a sh:PropertyShape ;
    sh:path era:verticallyOriented ;
    sh:name "verticallyOriented" ;
    sh:description "Defines the orientation of the balise. false when oriented parallel to the sleepers" ;
    sh:order 7 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-standardSize
    a sh:PropertyShape ;
    sh:path era:standardSize ;
    sh:name "standardSize" ;
    sh:description "Defines if the balise is of standard size. false when balise is of reduced size" ;
    sh:order 8 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-etcsPackets
    a sh:PropertyShape ;
    sh:path era:etcsPackets ;
    sh:name "etcsPackets" ;
    sh:description "Defines the ETCS packets associates to the Balise Group." ;
    sh:order 9 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:ss026-ETCSTrackToTrainPacketShape ;
    sh:message "etcsPackets must be a well-formed ETCSTrackToTrainPacket (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-telegram
    a sh:PropertyShape ;
    sh:path era:telegram ;
    sh:name "telegram" ;
    sh:description "Defines the encoded ETCS telegram content of the balise" ;
    sh:order 10 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:or (
            [ sh:pattern "^[01]{341}$" ]
            [ sh:pattern "^[01]{1023}$" ]
        ) ;
        sh:message "An ETCS balise telegram must be a binary bit string of either exactly 341 bits (short telegram) or exactly 1023 bits (long telegram); see formatNote on Balise.telegram."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-telegramChecksum
    a sh:PropertyShape ;
    sh:path era:telegramChecksum ;
    sh:name "telegramChecksum" ;
    sh:description "Defines the checksum to verify the integrity of the stored telegram" ;
    sh:order 11 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-sleeperFastening
    a sh:PropertyShape ;
    sh:path era:sleeperFastening ;
    sh:name "sleeperFastening" ;
    sh:description "Defines the fastening system used for the balise on the sleeper" ;
    sh:order 12 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-baliseMountingSystem
    a sh:PropertyShape ;
    sh:path era:baliseMountingSystem ;
    sh:name "baliseMountingSystem" ;
    sh:description "Defines the mounting system used for the balise" ;
    sh:order 13 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-designType
    a sh:PropertyShape ;
    sh:path era:designType ;
    sh:name "designType" ;
    sh:description "Defines the manufacturer type for the balise" ;
    sh:order 14 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Balise-sleepersType
    a sh:PropertyShape ;
    sh:path era:sleepersType ;
    sh:name "sleepersType" ;
    sh:description "Defines the sleepersType on which the Balise was mounted" ;
    sh:order 15 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/sleepers-type/unknownSleepersType> <http://data.europa.eu/949/concepts/sleepers-type/composite> <http://data.europa.eu/949/concepts/sleepers-type/concrete> <http://data.europa.eu/949/concepts/sleepers-type/steel> <http://data.europa.eu/949/concepts/sleepers-type/wood> ) ;
    sh:message "Value must be one of the CCSTMS-scoped SleepersType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### Sleepers ##########################################################
eng-sh:SleepersShape
    a sh:NodeShape ;
    sh:targetClass era:Sleepers ;
    sh:name "Sleepers" ;
    sh:description "Sleepers are components on which the rails arranged with corresponding gauge." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
