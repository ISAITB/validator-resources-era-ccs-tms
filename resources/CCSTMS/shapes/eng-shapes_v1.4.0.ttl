    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_0-nid_vbcmk
    a sh:PropertyShape ;
    sh:path era:nid_vbcmk ;
    sh:name "nid_vbcmk" ;
    sh:description "Marker for Virtual Balise Cover." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 63 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
