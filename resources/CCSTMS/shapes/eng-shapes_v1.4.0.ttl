    .

### ETCSTrackToTrainPacket_254 ########################################
eng-sh:ss026-ETCSTrackToTrainPacket_254Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_254 ;
    sh:name "ETCSTrackToTrainPacket_254" ;
    sh:description "Default balise, loop or RIU information (Indication to on-board that balise telegram, loop message or RIU information contains default information due to a fault of the trackside equipment.)" ;
