    sh:property eng-sh:ss026-NVKSubItem-m_nvkvint ;
    sh:property eng-sh:ss026-NVKSubItem-m_nvkvint_2 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVKSubItem-v_nvkvint
