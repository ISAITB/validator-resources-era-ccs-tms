### NetPointReference #################################################
eng-sh:infra-NetPointReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetPointReference ;
    sh:name "NetPointReference" ;
    sh:description "Represents a point reference in the network." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property eng-sh:infra-NetPointReference-hasTopoCoordinate ;
    sh:property eng-sh:infra-NetPointReference-appliesToDirection ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-NetPointReference-hasTopoCoordinate
    a sh:PropertyShape ;
    sh:path era:hasTopoCoordinate ;
    sh:name "hasTopoCoordinate" ;
    sh:description "Defines the topological coordinate of a network point reference" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:infra-TopologicalCoordinateShape ;
    sh:message "hasTopoCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-NetPointReference-appliesToDirection
    a sh:PropertyShape ;
    sh:path era:appliesToDirection ;
    sh:name "appliesToDirection" ;
    sh:description "The direction relative to the origin of the linear element towards the point reference applies" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/orientations/02> <http://data.europa.eu/949/concepts/orientations/00> <http://data.europa.eu/949/concepts/orientations/01> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OrientationDirections concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### NetRelation #######################################################
eng-sh:infra-NetRelationShape
    a sh:NodeShape ;
    sh:targetClass era:NetRelation ;
    sh:name "NetRelation" ;
    sh:description "Defines a relation between two elements." ;
    rdfs:comment "sub-package: topology" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:infra-NetRelation-elementA ;
    sh:property eng-sh:infra-NetRelation-elementB ;
    sh:property eng-sh:infra-NetRelation-isOnOriginOfElementA ;
    sh:property eng-sh:infra-NetRelation-isOnOriginOfElementB ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-NetRelation-elementA
    a sh:PropertyShape ;
    sh:path era:elementA ;
    sh:name "elementA" ;
    sh:description "References the first linear element in an oriented relation." ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "elementA must reference an existing era:LinearElement by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-NetRelation-elementB
    a sh:PropertyShape ;
    sh:path era:elementB ;
    sh:name "elementB" ;
    sh:description "References the second linear element in an oriented relation." ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "elementB must reference an existing era:LinearElement by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-NetRelation-isOnOriginOfElementA
    a sh:PropertyShape ;
    sh:path era:isOnOriginOfElementA ;
    sh:name "isOnOriginOfElementA" ;
    sh:description "Determines if the position of the topological element A in a relation is the origin of element A." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-NetRelation-isOnOriginOfElementB
    a sh:PropertyShape ;
    sh:path era:isOnOriginOfElementB ;
    sh:name "isOnOriginOfElementB" ;
    sh:description "Determines if the position of the topological element B in a relation is the origin of element B." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_0 ##########################################
eng-sh:ss026-ETCSTrackToTrainPacket_0Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_0 ;
    sh:name "ETCSTrackToTrainPacket_0" ;
    sh:description "Virtual Balise Cover marker (Indication to on-board that the telegram can be ignored according to a VBC)" ;
