    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_3-v_nvshunt-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "v_nvshunt must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_nvshunt ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_3-v_nvstff-multipleOf
