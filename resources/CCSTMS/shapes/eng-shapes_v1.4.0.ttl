    sh:name "sleepers" ;
    sh:description "Defines the list of sleepers" ;
    sh:order 8 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:SleepersShape ;
    sh:message "sleepers must be a well-formed Sleepers (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:EngArea-trackUsagePaths
    a sh:PropertyShape ;
    sh:path era:trackUsagePaths ;
    sh:name "trackUsagePaths" ;
    sh:description "Defines the list of track usage paths" ;
    sh:order 9 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:TrackUsagePathShape ;
    sh:message "trackUsagePaths must be a well-formed TrackUsagePath (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:EngArea-dangerPoints
    a sh:PropertyShape ;
