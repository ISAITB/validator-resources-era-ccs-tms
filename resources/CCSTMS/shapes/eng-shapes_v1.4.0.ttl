########################################################################
#  eng node shapes
########################################################################
### BufferStop ########################################################
eng-sh:BufferStopShape
    a sh:NodeShape ;
    sh:targetClass era:BufferStop ;
    sh:name "BufferStop" ;
    sh:description "An infrastructure element installed at the end of a track to prevent rolling stock from moving beyond the track termination. It serves as the physical end point of the track and may provide energy absorption in the event of a train overrun." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:BufferStop-dangerPoint ;
    sh:property eng-sh:BufferStop-lengthOfBufferStop ;
    sh:property eng-sh:BufferStop-bsType ;
    sh:severity sh:Violation ;
    .

eng-sh:BufferStop-dangerPoint
    a sh:PropertyShape ;
    sh:path era:dangerPoint ;
    sh:name "dangerPoint" ;
    sh:description "refers to the associated danger point" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:DangerPoint ;
    sh:message "dangerPoint must reference an existing era:DangerPoint by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:BufferStop-lengthOfBufferStop
    a sh:PropertyShape ;
    sh:path era:lengthOfBufferStop ;
    sh:name "lengthOfBufferStop" ;
    sh:description "Defines the length of the buffer stop from the buffer along the LinearElement." ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:BufferStop-bsType
    a sh:PropertyShape ;
    sh:path era:bsType ;
    sh:name "bsType" ;
    sh:description "Defines buffer stop type" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/buffer-stop-type/friction> <http://data.europa.eu/949/concepts/buffer-stop-type/hydraulic> <http://data.europa.eu/949/concepts/buffer-stop-type/fixated> <http://data.europa.eu/949/concepts/buffer-stop-type/other> ) ;
    sh:message "Value must be one of the CCSTMS-scoped BufferStopType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### Switch ############################################################
eng-sh:SwitchShape
    a sh:NodeShape ;
    sh:targetClass era:Switch ;
    sh:name "Switch" ;
    sh:description "A unit of track comprising two fixed rails (stock rails) and two movable rails (switch rails) used to direct vehicles from one track to another track." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:Switch-foulingPoints ;
    sh:property eng-sh:Switch-tipShift ;
    sh:property eng-sh:Switch-bladeLength ;
    sh:property eng-sh:Switch-routeRequiresPointRight ;
    sh:property eng-sh:Switch-routeRequiresPointLeft ;
    sh:severity sh:Violation ;
    .

eng-sh:Switch-foulingPoints
    a sh:PropertyShape ;
    sh:path era:foulingPoints ;
    sh:name "foulingPoints" ;
    sh:description "refers to fouling points" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:FoulingPoint ;
    sh:message "foulingPoints must reference an existing era:FoulingPoint by IRI."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Switch-tipShift
    a sh:PropertyShape ;
    sh:path era:tipShift ;
    sh:name "tipShift" ;
    sh:description "Defines the tip distance from the start of the switch on main and branching tracks" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Switch-bladeLength
    a sh:PropertyShape ;
    sh:path era:bladeLength ;
    sh:name "bladeLength" ;
    sh:description "Defines the length of the blade of switch along main and branching tracks" ;
    sh:order 4 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:Switch-routeRequiresPointRight
    a sh:PropertyShape ;
    sh:path era:routeRequiresPointRight ;
    sh:name "routeRequiresPointRight" ;
    sh:description "list of trackUsagePaths that require this Switch to allow travelling through pointRight." ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TrackUsagePath ;
    sh:message "routeRequiresPointRight must reference an existing era:TrackUsagePath by IRI."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:Switch-routeRequiresPointLeft
    a sh:PropertyShape ;
    sh:path era:routeRequiresPointLeft ;
    sh:name "routeRequiresPointLeft" ;
    sh:description "list of trackUsagePaths that require this Switch to allow travelling through pointLeft." ;
    sh:order 6 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TrackUsagePath ;
    sh:message "routeRequiresPointLeft must reference an existing era:TrackUsagePath by IRI."@en ;
    sh:severity sh:Violation ;
    .

### Crossing ##########################################################
eng-sh:CrossingShape
    a sh:NodeShape ;
    sh:targetClass era:Crossing ;
    sh:name "Crossing" ;
    sh:description "Defines the physical track asset Crossing without possibility to switch between two linear elements" ;
