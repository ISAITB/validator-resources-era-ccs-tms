    sh:severity sh:Violation ;
    .

eng-sh:Sleepers-sleepersType
    a sh:PropertyShape ;
    sh:path era:sleepersType ;
    sh:name "sleepersType" ;
    sh:description "defines sleepers type" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/sleepers-type/unknownSleepersType> <http://data.europa.eu/949/concepts/sleepers-type/composite> <http://data.europa.eu/949/concepts/sleepers-type/concrete> <http://data.europa.eu/949/concepts/sleepers-type/steel> <http://data.europa.eu/949/concepts/sleepers-type/wood> ) ;
    sh:message "Value must be one of the CCSTMS-scoped SleepersType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### DangerPoint #######################################################
eng-sh:DangerPointShape
    a sh:NodeShape ;
    sh:targetClass era:DangerPoint ;
    sh:name "DangerPoint" ;
    sh:description "a specific location on the railway where a potential conflict or danger may arise between trains or between trains and other object" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:DangerPoint-name ;
    sh:property eng-sh:DangerPoint-topologicalCoordinate ;
    sh:severity sh:Violation ;
