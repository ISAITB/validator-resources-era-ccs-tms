@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix era:     <http://data.europa.eu/949/> .

@prefix eng-sh: <http://data.europa.eu/949/shapes/eng#> .


########################################################################
#  SPARQL prefix declarations
#
#  SHACL 5.3: the Turtle @prefix declarations above do NOT apply inside
#  sh:select - only sh:prefixes does. Without this, a query writing era:...
#  fails with "Unknown namespace prefix : era" on any data graph that does
#  not itself bind the same prefix (e.g. data written with full IRIs).
########################################################################

eng-sh:PrefixDeclarations
    a owl:Ontology ;
    rdfs:label "Prefixes available to every sh:select in this file"@en ;
    sh:declare
        [ sh:prefix "era"  ; sh:namespace "http://data.europa.eu/949/"^^xsd:anyURI ] ,
        [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd"  ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ;
    .

########################################################################
#  Imported shapes
#
#  eng references or composes these structs from other
#  modules, so their shapes are inlined here for completeness (rule 17).
#  They are minted in this module's namespace, prefixed with the source
#  module, so this file never collides with the owning module's own
#  shapes file. Loading both simply reports shared classes twice.
########################################################################

### ETCSTrackToTrainPacket ############################################
eng-sh:ss026-ETCSTrackToTrainPacketShape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket ;
    sh:name "ETCSTrackToTrainPacket" ;
    sh:description "a unique packet number, the length of the packet in bits, the orientation information, optionally the scale for distance/length information and an information section containing a defined set of variables" ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket-packetId ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket-q_dir ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket-q_scale ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket-trackToTrainPacket ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket-packetId
    a sh:PropertyShape ;
    sh:path era:packetId ;
    sh:name "packetId" ;
    sh:description "defines the packet identifier" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket-q_dir
    a sh:PropertyShape ;
    sh:path era:q_dir ;
    sh:name "q_dir" ;
    sh:description "specifies the validity direction of transmitted data" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/q-dir/reverse> <http://data.europa.eu/949/concepts/q-dir/nominal> <http://data.europa.eu/949/concepts/q-dir/both> ) ;
    sh:message "Value must be one of the CCSTMS-scoped QDir concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket-q_scale
    a sh:PropertyShape ;
    sh:path era:q_scale ;
    sh:name "q_scale" ;
    sh:description "An indicator specifying the uniform scale applied to describe distances within the packet containing Q_SCALE" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 2 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket-trackToTrainPacket
    a sh:PropertyShape ;
    sh:path era:trackToTrainPacket ;
    sh:name "trackToTrainPacket" ;
    sh:description "consists of variable group of the track-to-train ETCS-Packet" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:ss026-TrackToTrainPacketShape ;
    sh:message "trackToTrainPacket must be a well-formed TrackToTrainPacket (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### LinearElementSection ##############################################
eng-sh:infra-LinearElementSectionShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElementSection ;
    sh:name "LinearElementSection" ;
    sh:description "Defines adirected linear object (with a linear extension) located on a LinearElement" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property eng-sh:infra-LinearElementSection-onElement ;
    sh:property eng-sh:infra-LinearElementSection-startOffsetFromOrigin ;
    sh:property eng-sh:infra-LinearElementSection-endOffsetFromOrigin ;
    sh:property eng-sh:infra-LinearElementSection-appliesInBothDirections ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-LinearElementSection-onElement
    a sh:PropertyShape ;
    sh:path era:onElement ;
    sh:name "onElement" ;
    sh:description "Specifies the linear element a section belongs to." ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "onElement must reference an existing era:LinearElement by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-LinearElementSection-startOffsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:startOffsetFromOrigin ;
    sh:name "startOffsetFromOrigin" ;
    sh:description "Defines the start offset from the origin" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-LinearElementSection-endOffsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:endOffsetFromOrigin ;
    sh:name "endOffsetFromOrigin" ;
    sh:description "Defines the end offset from the origin" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-LinearElementSection-appliesInBothDirections
    a sh:PropertyShape ;
    sh:path era:appliesInBothDirections ;
    sh:name "appliesInBothDirections" ;
    sh:description "Defines if the section applies in both directions" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### TopologicalCoordinate #############################################
eng-sh:infra-TopologicalCoordinateShape
    a sh:NodeShape ;
    sh:targetClass era:TopologicalCoordinate ;
    sh:name "TopologicalCoordinate" ;
    sh:description "Defines a topological coordinate on the track" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property eng-sh:infra-TopologicalCoordinate-onLinearElement ;
    sh:property eng-sh:infra-TopologicalCoordinate-offsetFromOrigin ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-TopologicalCoordinate-onLinearElement
    a sh:PropertyShape ;
    sh:path era:onLinearElement ;
    sh:name "onLinearElement" ;
    sh:description "is positioned on linear element" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "onLinearElement must reference an existing era:LinearElement by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-TopologicalCoordinate-offsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:offsetFromOrigin ;
    sh:name "offsetFromOrigin" ;
    sh:description "position on the associated NetElement" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### Derailer ##########################################################
eng-sh:infra-DerailerShape
    a sh:NodeShape ;
    sh:targetClass era:Derailer ;
    sh:name "Derailer" ;
    sh:description "Defines the physical track asset Derailer" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:infra-Derailer-netPointReference ;
    sh:property eng-sh:infra-Derailer-reversalTime ;
    sh:property eng-sh:infra-Derailer-derailToRight ;
    sh:property eng-sh:infra-Derailer-name ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-Derailer-netPointReference
    a sh:PropertyShape ;
    sh:path era:netPointReference ;
    sh:name "netPointReference" ;
    sh:description "Defines position on LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:infra-NetPointReferenceShape ;
    sh:message "netPointReference must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-Derailer-reversalTime
    a sh:PropertyShape ;
    sh:path era:reversalTime ;
    sh:name "reversalTime" ;
    sh:description "Defines the time in seconds to switch from one position to the other" ;
    sh:order 3 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-Derailer-derailToRight
    a sh:PropertyShape ;
    sh:path era:derailToRight ;
    sh:name "derailToRight" ;
    sh:description "Defines the side on which the derailer derails. If false = derailToLeft" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-Derailer-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### NetLinearReference ################################################
eng-sh:infra-NetLinearReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetLinearReference ;
    sh:name "NetLinearReference" ;
    sh:description "Defines a linked path on the topology" ;
    sh:sparql eng-sh:infra-NetLinearReference-hasSequence-listWellFormed ;
    sh:property eng-sh:infra-NetLinearReference-startsAt ;
    sh:property eng-sh:infra-NetLinearReference-endsAt ;
    sh:property eng-sh:infra-NetLinearReference-hasSequence ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-NetLinearReference-startsAt
    a sh:PropertyShape ;
    sh:path era:startsAt ;
    sh:name "startsAt" ;
    sh:description "Definesthe starting point of a linear reference" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:infra-NetPointReferenceShape ;
    sh:message "startsAt must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-NetLinearReference-endsAt
    a sh:PropertyShape ;
    sh:path era:endsAt ;
    sh:name "endsAt" ;
    sh:description "Specifies the ending point of a linear reference" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:infra-NetPointReferenceShape ;
    sh:message "endsAt must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-NetLinearReference-hasSequence
    a sh:PropertyShape ;
    sh:path era:hasSequence ;
    sh:name "hasSequence" ;
    sh:description "The ordered sequence of topological linear elements which create a linear net reference." ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "hasSequence is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node eng-sh:infra-NetLinearReference-hasSequence-items ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-NetLinearReference-hasSequence-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "era:hasSequence is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:hasSequence ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

eng-sh:infra-NetLinearReference-hasSequence-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:hasSequence"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:IRI ;
        sh:class era:LinearElement ;
        sh:message "hasSequence must reference an existing era:LinearElement by IRI."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

### TopoArea ##########################################################
eng-sh:infra-TopoAreaShape
    a sh:NodeShape ;
    sh:targetClass era:TopoArea ;
    sh:name "TopoArea" ;
    sh:description "Defines a container for rail network topology" ;
    rdfs:comment "sub-package: topology" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:infra-TopoArea-taVersionTimestamp ;
    sh:property eng-sh:infra-TopoArea-linearElements ;
    sh:property eng-sh:infra-TopoArea-netRelations ;
    sh:property eng-sh:infra-TopoArea-name ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-TopoArea-taVersionTimestamp
    a sh:PropertyShape ;
    sh:path era:taVersionTimestamp ;
    sh:name "taVersionTimestamp" ;
    sh:description "version information of the topo-area which is valid since timestamp" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-TopoArea-linearElements
    a sh:PropertyShape ;
    sh:path era:linearElements ;
    sh:name "linearElements" ;
    sh:description "composes of linear elements = Edges in the graph" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:infra-LinearElementShape ;
    sh:message "linearElements must be a well-formed LinearElement (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-TopoArea-netRelations
    a sh:PropertyShape ;
    sh:path era:netRelations ;
    sh:name "netRelations" ;
    sh:description "composes of net relations = links between edges in the graph" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:infra-NetRelationShape ;
    sh:message "netRelations must be a well-formed NetRelation (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-TopoArea-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### LinearElement #####################################################
eng-sh:infra-LinearElementShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElement ;
    sh:name "LinearElement" ;
    sh:description "A linear element is an uninterrupted stretch of railway track, without divergence or convergence." ;
    rdfs:comment "sub-package: topology" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:infra-LinearElement-lengthOfNetLinearElement ;
    sh:property eng-sh:infra-LinearElement-name ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-LinearElement-lengthOfNetLinearElement
    a sh:PropertyShape ;
    sh:path era:lengthOfNetLinearElement ;
    sh:name "lengthOfNetLinearElement" ;
    sh:description "Defines the distance along the LinearElement's track centre line." ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:infra-LinearElement-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### TrackToTrainPacket ################################################
eng-sh:ss026-TrackToTrainPacketShape
    a sh:NodeShape ;
    sh:targetClass era:TrackToTrainPacket ;
    sh:name "TrackToTrainPacket" ;
    sh:description "multiple variables of track-to-train packets grouped into a single unit, with a defined internal structure" ;
    sh:xone (
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_0-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_2-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_3-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_5-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_6-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_15-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_16-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_21-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_27-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_31-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_32-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_39-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_40-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_41-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_42-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_44-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_45-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_46-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_49-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_51-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_52-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_57-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_58-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_63-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_64-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_65-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_66-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_67-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_68-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_69-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_70-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_71-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_73-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_74-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_79-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_80-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_88-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_90-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_131-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_132-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_133-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_134-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_135-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_136-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_137-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_138-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_139-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_140-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_141-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_145-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_180-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_181-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_254-present
        eng-sh:ss026-TrackToTrainPacket-trackToTrainPacket_255-present
    ) ;
