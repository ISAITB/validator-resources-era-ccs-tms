    .

eng-sh:ss026-ETCSTrackToTrainPacket_52-q_trackinit
    a sh:PropertyShape ;
    sh:path era:q_trackinit ;
    sh:name "q_trackinit" ;
    sh:description "Qualifier for resuming the initial states of the related track description of the packet." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_52-d_trackinit
    a sh:PropertyShape ;
    sh:path era:d_trackinit ;
    sh:name "d_trackinit" ;
    sh:description "Distance to start of empty profile (Distance to where initial states of the related track description in the packet shall be resumed.)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
