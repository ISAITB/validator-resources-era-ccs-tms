### LocationAccuracyArea ##############################################
eng-sh:LocationAccuracyAreaShape
    a sh:NodeShape ;
    sh:targetClass era:LocationAccuracyArea ;
    sh:name "LocationAccuracyArea" ;
    sh:description "Represents an area containing positional accuracy definitions for one or more LinearElements. The accuracy information is provided through LinearElementAccuracyProfiles, which specify the expected positional deviation of the LinearElement geometry at defined offsets along its length." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:LocationAccuracyArea-topoArea ;
    sh:property eng-sh:LocationAccuracyArea-accuracyProfiles ;
    sh:severity sh:Violation ;
    .

eng-sh:LocationAccuracyArea-topoArea
    a sh:PropertyShape ;
    sh:path era:topoArea ;
    sh:name "topoArea" ;
    sh:description "reference to the corresponding TopoArea" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TopoArea ;
    sh:message "topoArea must reference an existing era:TopoArea by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:LocationAccuracyArea-accuracyProfiles
    a sh:PropertyShape ;
    sh:path era:accuracyProfiles ;
    sh:name "accuracyProfiles" ;
    sh:description "Defines the accuracies for defined linear elements" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:LinearElementAccuracyProfileShape ;
    sh:message "accuracyProfiles must be a well-formed LinearElementAccuracyProfile (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

### LinearElementAccuracyProfile ######################################
eng-sh:LinearElementAccuracyProfileShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElementAccuracyProfile ;
    sh:name "LinearElementAccuracyProfile" ;
    sh:description "Defines the positional accuracy of a LinearElement along its length, indicating how precisely its geometry is known or measured." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:sparql eng-sh:LinearElementAccuracyProfile-offsetAccuracies-listWellFormed ;
    sh:property eng-sh:LinearElementAccuracyProfile-linearElement ;
    sh:property eng-sh:LinearElementAccuracyProfile-offsetAccuracies ;
    sh:severity sh:Violation ;
    .

eng-sh:LinearElementAccuracyProfile-linearElement
    a sh:PropertyShape ;
    sh:path era:linearElement ;
    sh:name "linearElement" ;
    sh:description "reference to the corresponding LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "linearElement must reference an existing era:LinearElement by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:LinearElementAccuracyProfile-offsetAccuracies
    a sh:PropertyShape ;
    sh:path era:offsetAccuracies ;
    sh:name "offsetAccuracies" ;
    sh:description "must be sorted in accending order according to offset from 0 to LinearElement.length" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "offsetAccuracies is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node eng-sh:LinearElementAccuracyProfile-offsetAccuracies-items ;
    sh:severity sh:Violation ;
    .

eng-sh:LinearElementAccuracyProfile-offsetAccuracies-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "era:offsetAccuracies is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:offsetAccuracies ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

eng-sh:LinearElementAccuracyProfile-offsetAccuracies-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:offsetAccuracies"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node eng-sh:OffsetAccuracyShape ;
        sh:message "offsetAccuracies must be a well-formed OffsetAccuracy (blank node or IRI)."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

### OffsetAccuracy ####################################################
eng-sh:OffsetAccuracyShape
    a sh:NodeShape ;
    sh:targetClass era:OffsetAccuracy ;
    sh:name "OffsetAccuracy" ;
    sh:description "Positional accuracy specified at a defined offset along a LinearElement." ;
    sh:property eng-sh:OffsetAccuracy-offset ;
    sh:property eng-sh:OffsetAccuracy-accuracy ;
    sh:severity sh:Violation ;
    .

eng-sh:OffsetAccuracy-offset
    a sh:PropertyShape ;
    sh:path era:offset ;
    sh:name "offset" ;
    sh:description "offset on the LinearElement with defined accuracy." ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:OffsetAccuracy-accuracy
    a sh:PropertyShape ;
    sh:path era:accuracy ;
    sh:name "accuracy" ;
    sh:description "defines absolute deviation of the offset as 1sigma" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### LinearElementKm ###################################################
eng-sh:LinearElementKmShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElementKm ;
    sh:name "LinearElementKm" ;
    sh:description "Defines the kilometre referencing information for a LinearElement. It contains an ordered set of KilometricPosts that associate positions along the LinearElement with corresponding railway kilometre values." ;
    sh:sparql eng-sh:LinearElementKm-kilometricPosts-listWellFormed ;
    sh:property eng-sh:LinearElementKm-linearElement ;
    sh:property eng-sh:LinearElementKm-kilometricPosts ;
    sh:severity sh:Violation ;
    .

eng-sh:LinearElementKm-linearElement
    a sh:PropertyShape ;
    sh:path era:linearElement ;
    sh:name "linearElement" ;
    sh:description "reference to the corresponding linear element" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "linearElement must reference an existing era:LinearElement by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:LinearElementKm-kilometricPosts
    a sh:PropertyShape ;
    sh:path era:kilometricPosts ;
    sh:name "kilometricPosts" ;
    sh:description "Defines the kilometre points on the track. These are sorted by pos from 0 to length" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "kilometricPosts is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node eng-sh:LinearElementKm-kilometricPosts-items ;
    sh:severity sh:Violation ;
    .

eng-sh:LinearElementKm-kilometricPosts-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "era:kilometricPosts is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:kilometricPosts ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

eng-sh:LinearElementKm-kilometricPosts-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:kilometricPosts"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node eng-sh:KilometricPostShape ;
        sh:message "kilometricPosts must be a well-formed KilometricPost (blank node or IRI)."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

### KilometricPost ####################################################
eng-sh:KilometricPostShape
    a sh:NodeShape ;
    sh:targetClass era:KilometricPost ;
    sh:name "KilometricPost" ;
    sh:description "An object that represents Kilometer information at specific location on a LinearElement" ;
    sh:property eng-sh:KilometricPost-pos ;
    sh:property eng-sh:KilometricPost-kilometer ;
    sh:property eng-sh:KilometricPost-kmPostName ;
    sh:severity sh:Violation ;
    .

eng-sh:KilometricPost-pos
    a sh:PropertyShape ;
    sh:path era:pos ;
    sh:name "pos" ;
    sh:description "position on the associated LinearElement" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:KilometricPost-kilometer
    a sh:PropertyShape ;
    sh:path era:kilometer ;
    sh:name "kilometer" ;
    sh:description "Defines exact kilometer value" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:KilometricPost-kmPostName
    a sh:PropertyShape ;
    sh:path era:kmPostName ;
    sh:name "kmPostName" ;
    sh:description "Name of the Kilometric Post." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### KmArea ############################################################
eng-sh:KmAreaShape
    a sh:NodeShape ;
    sh:targetClass era:KmArea ;
    sh:name "KmArea" ;
    sh:description "Represents an area containing kilometre referencing information for one or more LinearElements. The kilometre values are defined through associated LinearElementKm profiles and their KilometricPosts." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:KmArea-topoArea ;
    sh:property eng-sh:KmArea-linearElementKm ;
    sh:severity sh:Violation ;
    .

eng-sh:KmArea-topoArea
    a sh:PropertyShape ;
    sh:path era:topoArea ;
    sh:name "topoArea" ;
    sh:description "reference to the corresponding TopoArea" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TopoArea ;
    sh:message "topoArea must reference an existing era:TopoArea by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:KmArea-linearElementKm
    a sh:PropertyShape ;
    sh:path era:linearElementKm ;
    sh:name "linearElementKm" ;
    sh:description "Contains the kilometre referencing definitions for the LinearElements belonging to the area." ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:LinearElementKmShape ;
    sh:message "linearElementKm must be a well-formed LinearElementKm (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

