    sh:name "dangerPoints" ;
    sh:description "Defines the list of danger points" ;
    sh:order 10 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:DangerPointShape ;
    sh:message "dangerPoints must be a well-formed DangerPoint (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:EngArea-foulingPoints
    a sh:PropertyShape ;
    sh:path era:foulingPoints ;
    sh:name "foulingPoints" ;
    sh:description "Defines the list of fouling points" ;
    sh:order 11 ;
