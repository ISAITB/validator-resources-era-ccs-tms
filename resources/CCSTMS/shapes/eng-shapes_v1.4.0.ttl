eng-sh:ss026-ETCSTrackToTrainPacket_3-m_nvavadh-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "m_nvavadh must be a multiple of 0.05."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvavadh ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

