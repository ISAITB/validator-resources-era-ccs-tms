### LevelTransitionWithAck ############################################
eng-sh:ss026-LevelTransitionWithAckShape
    a sh:NodeShape ;
    sh:targetClass era:LevelTransitionWithAck ;
    sh:name "LevelTransitionWithAck" ;
    sh:description "Defines the parameters for level transitions requiring acknowledgment in ETCS operations. This includes the target ETCS level, the associated national system identity, and the length of the acknowledgment area required for a safe transition." ;
    sh:property eng-sh:ss026-LevelTransitionWithAck-m_leveltr ;
    sh:property eng-sh:ss026-LevelTransitionWithAck-nid_ntc ;
    sh:property eng-sh:ss026-LevelTransitionWithAck-l_ackleveltr ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LevelTransitionWithAck-m_leveltr
    a sh:PropertyShape ;
    sh:path era:m_leveltr ;
    sh:name "m_leveltr" ;
    sh:description "Required level" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-levels/50> <http://data.europa.eu/949/concepts/etcs-levels/60> <http://data.europa.eu/949/concepts/etcs-levels/20> <http://data.europa.eu/949/concepts/etcs-levels/30> <http://data.europa.eu/949/concepts/etcs-levels/80> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSLevels concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LevelTransitionWithAck-nid_ntc
    a sh:PropertyShape ;
    sh:path era:nid_ntc ;
    sh:name "nid_ntc" ;
    sh:description "National System identity (Each value of this variable represents the identity of a National System)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LevelTransitionWithAck-l_ackleveltr
    a sh:PropertyShape ;
    sh:path era:l_ackleveltr ;
    sh:name "l_ackleveltr" ;
    sh:description "Length of the acknowledgement area in rear of the required level." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### LevelTransition ###################################################
eng-sh:ss026-LevelTransitionShape
    a sh:NodeShape ;
    sh:targetClass era:LevelTransition ;
    sh:name "LevelTransition" ;
    sh:description "Defines the parameters for level transitions in ETCS operations, specifying the required ETCS level and the associated national system identity to ensure seamless interoperability between signaling systems." ;
    sh:property eng-sh:ss026-LevelTransition-m_leveltr ;
    sh:property eng-sh:ss026-LevelTransition-nid_ntc ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LevelTransition-m_leveltr
    a sh:PropertyShape ;
    sh:path era:m_leveltr ;
    sh:name "m_leveltr" ;
    sh:description "Required level" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-levels/50> <http://data.europa.eu/949/concepts/etcs-levels/60> <http://data.europa.eu/949/concepts/etcs-levels/20> <http://data.europa.eu/949/concepts/etcs-levels/30> <http://data.europa.eu/949/concepts/etcs-levels/80> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSLevels concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LevelTransition-nid_ntc
    a sh:PropertyShape ;
    sh:path era:nid_ntc ;
    sh:name "nid_ntc" ;
    sh:description "National System identity (Each value of this variable represents the identity of a National System.)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### CountryBalise #####################################################
eng-sh:ss026-CountryBaliseShape
    a sh:NodeShape ;
    sh:targetClass era:CountryBalise ;
    sh:name "CountryBalise" ;
    sh:description "The new country's and balise group's identification number" ;
    sh:property eng-sh:ss026-CountryBalise-nid_c ;
    sh:property eng-sh:ss026-CountryBalise-nid_bg ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-CountryBalise-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "Identity number of the country or region (Code used to identify the country or region in which the balise group, the RBC or the RIU is situated. These need not necessarily follow administrative or political boundaries )" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-CountryBalise-nid_bg
    a sh:PropertyShape ;
    sh:path era:nid_bg ;
    sh:name "nid_bg" ;
    sh:description "Identity number of the balise group (Identity number of a balise group or loop within the country or region defined by NID_C)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### AxleLoadRestriction ###############################################
eng-sh:ss026-AxleLoadRestrictionShape
    a sh:NodeShape ;
    sh:targetClass era:AxleLoadRestriction ;
    sh:name "AxleLoadRestriction" ;
    sh:description "Defines the restriction with respect to the axle load" ;
    sh:sparql eng-sh:ss026-AxleLoadRestriction-v_axleLoad-multipleOf ;
    sh:property eng-sh:ss026-AxleLoadRestriction-axleLoadCategory ;
    sh:property eng-sh:ss026-AxleLoadRestriction-v_axleLoad ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-AxleLoadRestriction-axleLoadCategory
    a sh:PropertyShape ;
    sh:path era:axleLoadCategory ;
    sh:name "axleLoadCategory" ;
    sh:description "Axle load category (The values allocated below correspond to a list of increasing axle load categories (i.e. B1 > HS17, B2 > B1, D2 > C4, ….etc) and it is used by the on-board equipment to compare its axle load category with the axle load category sent by trackside.For the underlying meaning of the axle load categories listed (with the exception of HS17) refer to CR INF TSI.The category HS17 (axle load <= 17t) corresponds to a static load per axle only, as specified in HS RST TSI clause 4.2.3.2. The introduction of this artefact is necessary to ensure backward compatibility, without any negative performance impact, in case ASPs are used on lines operated with system version X = 1).see ss026, 7.5.1.62 M_AXLELOADCAT" ;
    sh:order 1 ;
    rdfs:comment "ERTMS subset variable: M_AXLELOADCAT"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/load-capability-line-categories/10> <http://data.europa.eu/949/concepts/load-capability-line-categories/230> <http://data.europa.eu/949/concepts/load-capability-line-categories/20> <http://data.europa.eu/949/concepts/load-capability-line-categories/30> <http://data.europa.eu/949/concepts/load-capability-line-categories/40> <http://data.europa.eu/949/concepts/load-capability-line-categories/50> <http://data.europa.eu/949/concepts/load-capability-line-categories/60> <http://data.europa.eu/949/concepts/load-capability-line-categories/70> <http://data.europa.eu/949/concepts/load-capability-line-categories/80> <http://data.europa.eu/949/concepts/load-capability-line-categories/90> <http://data.europa.eu/949/concepts/load-capability-line-categories/100> <http://data.europa.eu/949/concepts/load-capability-line-categories/110> <http://data.europa.eu/949/concepts/load-capability-line-categories/120> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LoadCapabilityLineCategories concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-AxleLoadRestriction-v_axleLoad
    a sh:PropertyShape ;
    sh:path era:v_axleLoad ;
    sh:name "v_axleLoad" ;
    sh:description "Speed restriction related to axleload. Speed restriction to be applied if the axle load category of the train M_AXLELOADCAT(n)" ;
    sh:order 2 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-AxleLoadRestriction-v_axleLoad-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "v_axleLoad must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_axleLoad ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

### AxleLoadSelection #################################################
eng-sh:ss026-AxleLoadSelectionShape
    a sh:NodeShape ;
    sh:targetClass era:AxleLoadSelection ;
    sh:name "AxleLoadSelection" ;
    sh:description "Defines the selection criteria for axle load-based speed restrictions in a railway network. It represents a structured profile containing axle load constraints, distances, and validity conditions necessary for safe train operations." ;
    sh:property eng-sh:ss026-AxleLoadSelection-d_axleload ;
    sh:property eng-sh:ss026-AxleLoadSelection-l_axleload ;
    sh:property eng-sh:ss026-AxleLoadSelection-q_front ;
    sh:property eng-sh:ss026-AxleLoadSelection-axleLoadRestrictions ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-AxleLoadSelection-d_axleload
    a sh:PropertyShape ;
    sh:path era:d_axleload ;
    sh:name "d_axleload" ;
    sh:description "Incremental distance to the start of the next Axle load speed profile. Note that Only if Q_TRACKINIT = 0, D_AXLELOAD and the following variables follow" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-AxleLoadSelection-l_axleload
    a sh:PropertyShape ;
    sh:path era:l_axleload ;
    sh:name "l_axleload" ;
    sh:description "Length of speed restriction due to Axle load." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-AxleLoadSelection-q_front
    a sh:PropertyShape ;
    sh:path era:q_front ;
    sh:name "q_front" ;
    sh:description "Qualifier for validity end point of profile element. Qualifier to indicate if a speed limit given for a profile element is to be applied until the front of the train (no train length delay) or the end of the train (train length delay) has left the element." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-AxleLoadSelection-axleLoadRestrictions
    a sh:PropertyShape ;
    sh:path era:axleLoadRestrictions ;
    sh:name "axleLoadRestrictions" ;
    sh:description "List of axle load restrictions for the selection" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:ss026-AxleLoadRestrictionShape ;
    sh:message "axleLoadRestrictions must be a well-formed AxleLoadRestriction (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

### PBDSelection ######################################################
eng-sh:ss026-PBDSelectionShape
    a sh:NodeShape ;
    sh:targetClass era:PBDSelection ;
    sh:name "PBDSelection" ;
    sh:description "Defines the selection criteria for Permitted Braking Distance (PBD) constraints, ensuring safe braking within defined limits. This includes parameters such as braking distance, gradient slope, speed restrictions, and braking mode qualifiers, which influence braking performance calculations." ;
    sh:property eng-sh:ss026-PBDSelection-d_pbd ;
    sh:property eng-sh:ss026-PBDSelection-q_gdir ;
    sh:property eng-sh:ss026-PBDSelection-g_pbdsr ;
    sh:property eng-sh:ss026-PBDSelection-q_pbdsr ;
    sh:property eng-sh:ss026-PBDSelection-d_pbdsr ;
    sh:property eng-sh:ss026-PBDSelection-l_pbdsr ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-PBDSelection-d_pbd
    a sh:PropertyShape ;
    sh:path era:d_pbd ;
    sh:name "d_pbd" ;
    sh:description "Permitted Braking Distance. Only if Q_TRACKINIT = 0, D_PBDand the following variables follow" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-PBDSelection-q_gdir
    a sh:PropertyShape ;
    sh:path era:q_gdir ;
    sh:name "q_gdir" ;
    sh:description "Qualifier for gradient slope. Note: 0 = downhill, 1 = uphill" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-PBDSelection-g_pbdsr
    a sh:PropertyShape ;
    sh:path era:g_pbdsr ;
    sh:name "g_pbdsr" ;
    sh:description "Default gradient for PBD Speed restriction (Defines a default gradient to be used for calculation of speed restriction to ensure permitted braking distance.)" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-PBDSelection-q_pbdsr
    a sh:PropertyShape ;
    sh:path era:q_pbdsr ;
    sh:name "q_pbdsr" ;
    sh:description "Qualifier for Permitted Braking Distance (Qualifier defining whether the permitted braking distance is to be achieved with the Service Brake or Emergency Brake)" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-PBDSelection-d_pbdsr
    a sh:PropertyShape ;
    sh:path era:d_pbdsr ;
    sh:name "d_pbdsr" ;
    sh:description "Incremental distance to the start of the next speed restriction to ensure permitted braking distance." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-PBDSelection-l_pbdsr
    a sh:PropertyShape ;
    sh:path era:l_pbdsr ;
    sh:name "l_pbdsr" ;
    sh:description "Length of speed restriction to ensure permitted braking distance." ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### PositionReportLocation ############################################
eng-sh:ss026-PositionReportLocationShape
    a sh:NodeShape ;
    sh:targetClass era:PositionReportLocation ;
    sh:name "PositionReportLocation" ;
    sh:description "Defines a specific location or distance reference at which the train must send a position report. Includes the distance increment to the reporting location and a qualifier indicating whether reporting is triggered by the front or rear of the train passing the location." ;
    sh:property eng-sh:ss026-PositionReportLocation-d_loc ;
    sh:property eng-sh:ss026-PositionReportLocation-q_lgtloc ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-PositionReportLocation-d_loc
    a sh:PropertyShape ;
    sh:path era:d_loc ;
    sh:name "d_loc" ;
    sh:description "Incremental distance between locations where the train has to report its position." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-PositionReportLocation-q_lgtloc
    a sh:PropertyShape ;
    sh:path era:q_lgtloc ;
    sh:name "q_lgtloc" ;
    sh:description "Qualifier for the specified report location. This qualifier tells whether the train has to report its position when the max safe front end or when the min safe rear end has over passed the location defined by D_LOC. False - Min safe rear end; True - Max safe front end" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### DLTrackCond #######################################################
eng-sh:ss026-DLTrackCondShape
    a sh:NodeShape ;
    sh:targetClass era:DLTrackCond ;
    sh:name "DLTrackCond" ;
    sh:description "Defines the parameters for dynamic line track conditions, specifying the distance to track condition changes and the validity length of the condition. These parameters are used to manage integrity check alarms of balise transmission within the defined section." ;
    sh:property eng-sh:ss026-DLTrackCond-d_trackcond ;
    sh:property eng-sh:ss026-DLTrackCond-l_trackcond ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-DLTrackCond-d_trackcond
    a sh:PropertyShape ;
    sh:path era:d_trackcond ;
    sh:name "d_trackcond" ;
    sh:description "Track condition distance (The incremental distance to where the track conditions change)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-DLTrackCond-l_trackcond
    a sh:PropertyShape ;
    sh:path era:l_trackcond ;
    sh:name "l_trackcond" ;
    sh:description "Length for which the defined track condition is valid. (The distance for which integrity check alarms of balise transmission shall be ignored)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### DLMCondition ######################################################
eng-sh:ss026-DLMConditionShape
    a sh:NodeShape ;
    sh:targetClass era:DLMCondition ;
    sh:name "DLMCondition" ;
    sh:description "Defines the track conditions, specifying the distance to track condition changes, the validity length of the condition, and the type of track condition to ensure safe and efficient train movement." ;
    sh:property eng-sh:ss026-DLMCondition-d_trackcond ;
    sh:property eng-sh:ss026-DLMCondition-l_trackcond ;
    sh:property eng-sh:ss026-DLMCondition-m_trackcond ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-DLMCondition-d_trackcond
    a sh:PropertyShape ;
    sh:path era:d_trackcond ;
    sh:name "d_trackcond" ;
    sh:description "Track condition distance (The incremental distance to where the track conditions change. Comment : Only if Q_TRACKINIT = 0, D_TRACKCOND and the following variables follow)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-DLMCondition-l_trackcond
    a sh:PropertyShape ;
    sh:path era:l_trackcond ;
    sh:name "l_trackcond" ;
    sh:description "Length for which the defined track condition is valid." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-DLMCondition-m_trackcond
    a sh:PropertyShape ;
    sh:path era:m_trackcond ;
    sh:name "m_trackcond" ;
    sh:description "Type of track condition" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-a> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-b> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-e> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-h> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-c> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-g> <http://data.europa.eu/949/concepts/transmitted-tcs/bigMetalMasses> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-d> <http://data.europa.eu/949/concepts/transmitted-tcs/switchOffRegenerativeBrake> <http://data.europa.eu/949/concepts/transmitted-tcs/switchOffEddyCurrentBrakeForServiceBrake> <http://data.europa.eu/949/concepts/transmitted-tcs/switchOffEddyCurrentBrakeForEmergencyBrake> <http://data.europa.eu/949/concepts/transmitted-tcs/switchOffMagneticShoeBrake> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TransmittedTrackConditions concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### TCSPCondition #####################################################
eng-sh:ss026-TCSPConditionShape
    a sh:NodeShape ;
    sh:targetClass era:TCSPCondition ;
    sh:name "TCSPCondition" ;
    sh:description "Defines the conditions related to track characteristics and platform parameters, ensuring accurate assessment of track suitability. This includes track condition change distances, validity lengths, platform height specifications, and platform positioning, as referenced in TSI infrastructure standards." ;
    sh:property eng-sh:ss026-TCSPCondition-d_trackcond ;
    sh:property eng-sh:ss026-TCSPCondition-l_trackcond ;
    sh:property eng-sh:ss026-TCSPCondition-m_platform ;
    sh:property eng-sh:ss026-TCSPCondition-q_platform ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TCSPCondition-d_trackcond
    a sh:PropertyShape ;
    sh:path era:d_trackcond ;
    sh:name "d_trackcond" ;
    sh:description "Track condition distance (The incremental distance to where the track conditions change.)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TCSPCondition-l_trackcond
    a sh:PropertyShape ;
    sh:path era:l_trackcond ;
    sh:name "l_trackcond" ;
    sh:description "Length for which the defined track condition is valid" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TCSPCondition-m_platform
    a sh:PropertyShape ;
    sh:path era:m_platform ;
    sh:name "m_platform" ;
    sh:description "Special/Reserved values for the Nominal height of platform above rail level (refer to TSI infrastructure)" ;
    sh:order 3 ;
    qudt:hasUnit unit:MilliM ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 200 ;
    sh:maxInclusive 1100 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TCSPCondition-q_platform
    a sh:PropertyShape ;
    sh:path era:q_platform ;
    sh:name "q_platform" ;
    sh:description "defines the platform position with respect to the direction of authorized movement" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/platform-position/ppLeft> <http://data.europa.eu/949/concepts/platform-position/ppRight> <http://data.europa.eu/949/concepts/platform-position/ppBoth> ) ;
    sh:message "Value must be one of the CCSTMS-scoped PlatformPosition concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### RouteSuitability ##################################################
eng-sh:ss026-RouteSuitabilityShape
    a sh:NodeShape ;
    sh:targetClass era:RouteSuitability ;
    sh:name "RouteSuitability" ;
    sh:description "Defines the parameters for route suitability assessment, ensuring compatibility between railway infrastructure and rolling stock. This includes route suitability changes, loading gauge constraints, axle load categories, traction system voltage, and country-specific traction system identifiers, allowing on-board systems to validate operational feasibility." ;
    sh:property eng-sh:ss026-RouteSuitability-d_suitability ;
    sh:property eng-sh:ss026-RouteSuitability-q_suitability ;
    sh:property eng-sh:ss026-RouteSuitability-m_lineGauge ;
    sh:property eng-sh:ss026-RouteSuitability-axleLoadCategory ;
    sh:property eng-sh:ss026-RouteSuitability-m_voltage ;
    sh:property eng-sh:ss026-RouteSuitability-nid_ctraction ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-RouteSuitability-d_suitability
    a sh:PropertyShape ;
    sh:path era:d_suitability ;
    sh:name "d_suitability" ;
    sh:description "Distance to change in route suitability (The incremental distance to where the route suitability data changes.)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-RouteSuitability-q_suitability
    a sh:PropertyShape ;
    sh:path era:q_suitability ;
    sh:name "q_suitability" ;
    sh:description "Type of route suitability data" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/q-suitability/loadingGuage> <http://data.europa.eu/949/concepts/q-suitability/maxAxleLoad> <http://data.europa.eu/949/concepts/q-suitability/tractionSystem> ) ;
    sh:message "Value must be one of the CCSTMS-scoped Q_Suitability concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-RouteSuitability-m_lineGauge
    a sh:PropertyShape ;
    sh:path era:m_lineGauge ;
    sh:name "m_lineGauge" ;
    sh:description "defining which loading gauge(s) are permitted on a line (refer to TSI INF)" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/line-guage/g1> <http://data.europa.eu/949/concepts/line-guage/gA> <http://data.europa.eu/949/concepts/line-guage/gB> <http://data.europa.eu/949/concepts/line-guage/gC> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LineGauge concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-RouteSuitability-axleLoadCategory
    a sh:PropertyShape ;
    sh:path era:axleLoadCategory ;
    sh:name "axleLoadCategory" ;
    sh:description "Axle load category (The values allocated below correspond to a list of increasing axle load categories (i.e. B1 > HS17, B2 > B1, D2 > C4, ….etc) and it is used by the on-board equipment to compare its axle load category with the axle load category sent by trackside.For the underlying meaning of the axle load categories listed (with the exception of HS17) refer to CR INF TSI.The category HS17 (axle load <= 17t) corresponds to a static load per axle only, as specified in HS RST TSI clause 4.2.3.2. The introduction of this artefact is necessary to ensure backward compatibility, without any negative performance impact, in case ASPs are used on lines operated with system version X = 1).see ss026, 7.5.1.62 M_AXLELOADCAT" ;
    sh:order 4 ;
    rdfs:comment "ERTMS subset variable: M_AXLELOADCAT"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/load-capability-line-categories/10> <http://data.europa.eu/949/concepts/load-capability-line-categories/230> <http://data.europa.eu/949/concepts/load-capability-line-categories/20> <http://data.europa.eu/949/concepts/load-capability-line-categories/30> <http://data.europa.eu/949/concepts/load-capability-line-categories/40> <http://data.europa.eu/949/concepts/load-capability-line-categories/50> <http://data.europa.eu/949/concepts/load-capability-line-categories/60> <http://data.europa.eu/949/concepts/load-capability-line-categories/70> <http://data.europa.eu/949/concepts/load-capability-line-categories/80> <http://data.europa.eu/949/concepts/load-capability-line-categories/90> <http://data.europa.eu/949/concepts/load-capability-line-categories/100> <http://data.europa.eu/949/concepts/load-capability-line-categories/110> <http://data.europa.eu/949/concepts/load-capability-line-categories/120> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LoadCapabilityLineCategories concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-RouteSuitability-m_voltage
    a sh:PropertyShape ;
    sh:path era:m_voltage ;
    sh:name "m_voltage" ;
    sh:description "Special/Reserved values for Traction System voltage. It indicates the voltage of the traction system installed on a specific line or respectively that can be used by an engine. The identity of the traction system is given by M_VOLTAGE and, if M_VOLTAGE ≠ 0, by the country identifier of the traction system (NID_CTRACTION). Note that values from 6 to 15 are currently unassigned" ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/energy-supply-systems/notFitted> <http://data.europa.eu/949/concepts/energy-supply-systems/AC10> <http://data.europa.eu/949/concepts/energy-supply-systems/AC20> <http://data.europa.eu/949/concepts/energy-supply-systems/DC30> <http://data.europa.eu/949/concepts/energy-supply-systems/DC40> <http://data.europa.eu/949/concepts/energy-supply-systems/DC80> <http://data.europa.eu/949/concepts/energy-supply-systems/DC70> <http://data.europa.eu/949/concepts/energy-supply-systems/DC60> <http://data.europa.eu/949/concepts/energy-supply-systems/DC90> ) ;
    sh:message "Value must be one of the CCSTMS-scoped EnergySupplySystems concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-RouteSuitability-nid_ctraction
    a sh:PropertyShape ;
    sh:path era:nid_ctraction ;
    sh:name "nid_ctraction" ;
    sh:description "Country identifier of the traction system. It identifies the information, additional to M_VOLTAGE, required to fully define the traction system." ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### TextMessageConfig #################################################
eng-sh:ss026-TextMessageConfigShape
    a sh:NodeShape ;
    sh:targetClass era:TextMessageConfig ;
    sh:name "TextMessageConfig" ;
    sh:description "Defines the configuration parameters for text message display and acknowledgment in railway operations. This includes message classification, display conditions based on distance, mode, and level, as well as qualifiers for text confirmation, reporting, and national system identity. These parameters ensure proper handling of onboard text messages and their interaction with trackside signaling and RBC communication." ;
    sh:property eng-sh:ss026-TextMessageConfig-q_textclass ;
    sh:property eng-sh:ss026-TextMessageConfig-q_textdisplay ;
    sh:property eng-sh:ss026-TextMessageConfig-d_textdisplay ;
    sh:property eng-sh:ss026-TextMessageConfig-m_modetextdisplay ;
    sh:property eng-sh:ss026-TextMessageConfig-m_leveltextdisplay ;
    sh:property eng-sh:ss026-TextMessageConfig-nid_ntc ;
    sh:property eng-sh:ss026-TextMessageConfig-l_textdisplay ;
    sh:property eng-sh:ss026-TextMessageConfig-t_textdisplay ;
    sh:property eng-sh:ss026-TextMessageConfig-m_modetextdisplay_e ;
    sh:property eng-sh:ss026-TextMessageConfig-m_leveltextdisplay_e ;
    sh:property eng-sh:ss026-TextMessageConfig-nid_ntc_e ;
    sh:property eng-sh:ss026-TextMessageConfig-q_textconfirm ;
    sh:property eng-sh:ss026-TextMessageConfig-q_conftextdisplay ;
    sh:property eng-sh:ss026-TextMessageConfig-q_textreport ;
    sh:property eng-sh:ss026-TextMessageConfig-nid_textmessage ;
    sh:property eng-sh:ss026-TextMessageConfig-nid_c ;
    sh:property eng-sh:ss026-TextMessageConfig-nid_rbc ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-q_textclass
    a sh:PropertyShape ;
    sh:path era:q_textclass ;
    sh:name "q_textclass" ;
    sh:description "Class of message to be displayed (Q_TEXTCLASS specifies the class of the text message included in the same packet (either plain or fixed message))" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/text-class/auxiliary> <http://data.europa.eu/949/concepts/text-class/important> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TextClass concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-q_textdisplay
    a sh:PropertyShape ;
    sh:path era:q_textdisplay ;
    sh:name "q_textdisplay" ;
    sh:description "Qualifier for the combination of text message events (Q_TEXTDISPLAY defines whether the start/end events for text message are to be combined or not.)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-d_textdisplay
    a sh:PropertyShape ;
    sh:path era:d_textdisplay ;
    sh:name "d_textdisplay" ;
    sh:description "Distance from where on a text shall be displayed." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-m_modetextdisplay
    a sh:PropertyShape ;
    sh:path era:m_modetextdisplay ;
    sh:name "m_modetextdisplay" ;
    sh:description "Onboard operating mode for text display (The text is displayed when entering / as long as in the defined mode)" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/display-operating-mode/fullSupervision> <http://data.europa.eu/949/concepts/display-operating-mode/onSight> <http://data.europa.eu/949/concepts/display-operating-mode/staffResponsible> <http://data.europa.eu/949/concepts/display-operating-mode/automaticDriving> <http://data.europa.eu/949/concepts/display-operating-mode/unfitted> <http://data.europa.eu/949/concepts/display-operating-mode/supervisedManoeuvre> <http://data.europa.eu/949/concepts/display-operating-mode/standBy> <http://data.europa.eu/949/concepts/display-operating-mode/trip> <http://data.europa.eu/949/concepts/display-operating-mode/postTrip> <http://data.europa.eu/949/concepts/display-operating-mode/limitedSupervision> <http://data.europa.eu/949/concepts/display-operating-mode/reversing> <http://data.europa.eu/949/concepts/display-operating-mode/notLimitedByMode> ) ;
    sh:message "Value must be one of the CCSTMS-scoped DisplayOperatingMode concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-m_leveltextdisplay
    a sh:PropertyShape ;
    sh:path era:m_leveltextdisplay ;
    sh:name "m_leveltextdisplay" ;
    sh:description "Onboard operating level for text display (The text is displayed when entering / as long as in the defined level)" ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/display-operating-level/level0> <http://data.europa.eu/949/concepts/display-operating-level/levelNTC> <http://data.europa.eu/949/concepts/display-operating-level/level1> <http://data.europa.eu/949/concepts/display-operating-level/level2> <http://data.europa.eu/949/concepts/display-operating-level/level3> <http://data.europa.eu/949/concepts/display-operating-level/notLimited> ) ;
    sh:message "Value must be one of the CCSTMS-scoped DisplayOperatingLevel concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-nid_ntc
    a sh:PropertyShape ;
    sh:path era:nid_ntc ;
    sh:name "nid_ntc" ;
    sh:description "National System identity. Each value of this variable represents the identity of a National System." ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-l_textdisplay
    a sh:PropertyShape ;
    sh:path era:l_textdisplay ;
    sh:name "l_textdisplay" ;
    sh:description "Length on which a text shall be displayed." ;
    sh:order 7 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-t_textdisplay
    a sh:PropertyShape ;
    sh:path era:t_textdisplay ;
    sh:name "t_textdisplay" ;
    sh:description "Duration for which a text shall be displayed." ;
    sh:order 8 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-m_modetextdisplay_e
    a sh:PropertyShape ;
    sh:path era:m_modetextdisplay_e ;
    sh:name "m_modetextdisplay_e" ;
    sh:description "Onboard operating mode for text display. The text is displayed when entering / as long as in the defined mode. Comment : End event" ;
    sh:order 9 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/display-operating-mode/fullSupervision> <http://data.europa.eu/949/concepts/display-operating-mode/onSight> <http://data.europa.eu/949/concepts/display-operating-mode/staffResponsible> <http://data.europa.eu/949/concepts/display-operating-mode/automaticDriving> <http://data.europa.eu/949/concepts/display-operating-mode/unfitted> <http://data.europa.eu/949/concepts/display-operating-mode/supervisedManoeuvre> <http://data.europa.eu/949/concepts/display-operating-mode/standBy> <http://data.europa.eu/949/concepts/display-operating-mode/trip> <http://data.europa.eu/949/concepts/display-operating-mode/postTrip> <http://data.europa.eu/949/concepts/display-operating-mode/limitedSupervision> <http://data.europa.eu/949/concepts/display-operating-mode/reversing> <http://data.europa.eu/949/concepts/display-operating-mode/notLimitedByMode> ) ;
    sh:message "Value must be one of the CCSTMS-scoped DisplayOperatingMode concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-m_leveltextdisplay_e
    a sh:PropertyShape ;
    sh:path era:m_leveltextdisplay_e ;
    sh:name "m_leveltextdisplay_e" ;
    sh:description "Onboard operating level for text display.The text is displayed when entering / as long as in the defined level." ;
    sh:order 10 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/display-operating-level/level0> <http://data.europa.eu/949/concepts/display-operating-level/levelNTC> <http://data.europa.eu/949/concepts/display-operating-level/level1> <http://data.europa.eu/949/concepts/display-operating-level/level2> <http://data.europa.eu/949/concepts/display-operating-level/level3> <http://data.europa.eu/949/concepts/display-operating-level/notLimited> ) ;
    sh:message "Value must be one of the CCSTMS-scoped DisplayOperatingLevel concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-nid_ntc_e
    a sh:PropertyShape ;
    sh:path era:nid_ntc_e ;
    sh:name "nid_ntc_e" ;
    sh:description "National System identity. Each value of this variable represents the identity of a National System." ;
    sh:order 11 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-q_textconfirm
    a sh:PropertyShape ;
    sh:path era:q_textconfirm ;
    sh:name "q_textconfirm" ;
    sh:description "Qualifier for text confirmation." ;
    sh:order 12 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 3 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-q_conftextdisplay
    a sh:PropertyShape ;
    sh:path era:q_conftextdisplay ;
    sh:name "q_conftextdisplay" ;
    sh:description "Qualifier for text confirmation versus end of text display. (Gives the relationship between the event (driver acknowledgement) and the list of events (location), (time), (mode), (level) defining the end condition for text display.)" ;
    sh:order 13 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-q_textreport
    a sh:PropertyShape ;
    sh:path era:q_textreport ;
    sh:name "q_textreport" ;
    sh:description "Qualifier for reporting acknowledgement of text by driver." ;
    sh:order 14 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-nid_textmessage
    a sh:PropertyShape ;
    sh:path era:nid_textmessage ;
    sh:name "nid_textmessage" ;
    sh:description "Text message identifier (Identity of a text message from trackside to be used in a report of driver acknowledgement to the RBC.)" ;
    sh:order 15 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "Identity number of the country or region (Code used to identify the country or region in which the balise group, the RBC or the RIU is situated. These need not necessarily follow administrative or political boundaries )" ;
    sh:order 16 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TextMessageConfig-nid_rbc
    a sh:PropertyShape ;
    sh:path era:nid_rbc ;
    sh:name "nid_rbc" ;
    sh:description "RBC ETCS identity number (This variable provides the identity of the RBC belonging to NID_C. The RBC ETCS identity is given by NID_C + NID_RBC.)" ;
    sh:order 17 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### GeoPosItem ########################################################
eng-sh:ss026-GeoPosItemShape
    a sh:NodeShape ;
    sh:targetClass era:GeoPosItem ;
    sh:name "GeoPosItem" ;
    sh:description "Defines the parameters for geographical position referencing in railway operations. This includes balise group identity, position offsets, track kilometre references, and direction qualifiers to support accurate location tracking and reporting along the railway network." ;
    sh:property eng-sh:ss026-GeoPosItem-nid_c ;
    sh:property eng-sh:ss026-GeoPosItem-nid_bg ;
    sh:property eng-sh:ss026-GeoPosItem-d_posoff ;
    sh:property eng-sh:ss026-GeoPosItem-q_mposition ;
    sh:property eng-sh:ss026-GeoPosItem-m_position ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-GeoPosItem-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "Identity number of the country or region (Code used to identify the country or region in which the balise group, the RBC or the RIU is situated. These need not necessarily follow administrative or political boundaries )" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-GeoPosItem-nid_bg
    a sh:PropertyShape ;
    sh:path era:nid_bg ;
    sh:name "nid_bg" ;
    sh:description "Identity number of the balise group. Identity number of a balise group or loop within the country or region defined by NID_C." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-GeoPosItem-d_posoff
    a sh:PropertyShape ;
    sh:path era:d_posoff ;
    sh:name "d_posoff" ;
    sh:description "Offset from the location reference of the geographical position reference balise group to the related track kilometre reference..The geographical position reporting function uses this variables content as an offset from the location reference of the geographical position reference balise group to the related track kilometre reference." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-GeoPosItem-q_mposition
    a sh:PropertyShape ;
    sh:path era:q_mposition ;
    sh:name "q_mposition" ;
    sh:description "Qualifier for track kilometre direction. Qualifier to indicate the direction of counting of the geographical position track kilometre in relation to the geographical position reference balise group directionality." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-GeoPosItem-m_position
    a sh:PropertyShape ;
    sh:path era:m_position ;
    sh:name "m_position" ;
    sh:description "Track kilometre reference value. The geographical position reporting function uses this variables content as a reference value." ;
    sh:order 5 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16777215 ;
    sh:not [ sh:minInclusive 10000000 ; sh:maxInclusive 16777214 ] ;
    sh:message "Values 10000000 to 16777214 are spare/invalid for m_position and must not be used."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ModeProfileItem ###################################################
eng-sh:ss026-ModeProfileItemShape
    a sh:NodeShape ;
    sh:targetClass era:ModeProfileItem ;
    sh:name "ModeProfileItem" ;
    sh:description "Defines the parameters for mode profile transitions in railway operations, specifying the required mode, associated speed limits, and spatial constraints. This includes incremental distances, supervision qualifiers, and acknowledgment areas to ensure proper mode application within the movement authority framework." ;
    sh:property eng-sh:ss026-ModeProfileItem-d_mamode ;
    sh:property eng-sh:ss026-ModeProfileItem-m_mamode ;
    sh:property eng-sh:ss026-ModeProfileItem-v_mamode ;
    sh:property eng-sh:ss026-ModeProfileItem-l_mamode ;
    sh:property eng-sh:ss026-ModeProfileItem-l_ackmamode ;
    sh:property eng-sh:ss026-ModeProfileItem-q_mamode ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ModeProfileItem-d_mamode
    a sh:PropertyShape ;
    sh:path era:d_mamode ;
    sh:name "d_mamode" ;
    sh:description "Incremental distance to the start of the next Mode Profile" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ModeProfileItem-m_mamode
    a sh:PropertyShape ;
    sh:path era:m_mamode ;
    sh:name "m_mamode" ;
    sh:description "Required mode for a part of the MA. None. Comment : OS, LS, SH" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/ma-mode/onSight> <http://data.europa.eu/949/concepts/ma-mode/shunting> <http://data.europa.eu/949/concepts/ma-mode/limitedSupervision> ) ;
    sh:message "Value must be one of the CCSTMS-scoped MAMode concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ModeProfileItem-v_mamode
    a sh:PropertyShape ;
    sh:path era:v_mamode ;
    sh:name "v_mamode" ;
    sh:description "Required mode related speed." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 127 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ModeProfileItem-l_mamode
    a sh:PropertyShape ;
    sh:path era:l_mamode ;
    sh:name "l_mamode" ;
    sh:description "Length of the area of the required mode." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ModeProfileItem-l_ackmamode
    a sh:PropertyShape ;
    sh:path era:l_ackmamode ;
    sh:name "l_ackmamode" ;
    sh:description "Length of the acknowledgement area in rear of the start of the required mode." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ModeProfileItem-q_mamode
    a sh:PropertyShape ;
    sh:path era:q_mamode ;
    sh:name "q_mamode" ;
    sh:description "Qualifier to indicate the supervision of the beginning of the mode profile. This qualifier defines whether the beginning of the mode profile shall be considered as the SvL, or if the SvL shall be derived from the movement authority." ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### LXStatus ##########################################################
eng-sh:ss026-LXStatusShape
    a sh:NodeShape ;
    sh:targetClass era:LXStatus ;
    sh:name "LXStatus" ;
    sh:description "Defines the status parameters for a Level Crossing (LX) in railway operations, including the permitted speed when the crossing is not protected, the requirement for stopping before the crossing, and the designated stopping area length to ensure safe passage." ;
    sh:sparql eng-sh:ss026-LXStatus-v_lx-multipleOf ;
    sh:property eng-sh:ss026-LXStatus-v_lx ;
    sh:property eng-sh:ss026-LXStatus-q_stoplx ;
    sh:property eng-sh:ss026-LXStatus-l_stoplx ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LXStatus-v_lx
    a sh:PropertyShape ;
    sh:path era:v_lx ;
    sh:name "v_lx" ;
    sh:description "Permitted speed for the LX speed restriction. Speed at which the LX can be passed when it is not protected." ;
    sh:order 1 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LXStatus-q_stoplx
    a sh:PropertyShape ;
    sh:path era:q_stoplx ;
    sh:name "q_stoplx" ;
    sh:description "Qualifier for stopping in rear of the LX. Indicates whether stopping the train in rear of a non protected LX is required." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LXStatus-l_stoplx
    a sh:PropertyShape ;
    sh:path era:l_stoplx ;
    sh:name "l_stoplx" ;
    sh:description "Length of the stopping area in rear of the start location of the LX area." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LXStatus-v_lx-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "v_lx must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_lx ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

### NVKItem ###########################################################
eng-sh:ss026-NVKItemShape
    a sh:NodeShape ;
    sh:targetClass era:NVKItem ;
    sh:name "NVKItem" ;
    sh:description "Defines the correction factor set Kv used for braking calculations based on speed and deceleration limits. This includes thresholds for selecting the appropriate Kv set, speed-dependent correction factors, and associated sub-items. These values are part of the National Values and are used to refine braking performance for Conventional Passenger trains." ;
    sh:sparql eng-sh:ss026-NVKItem-a_nvp12-multipleOf ;
    sh:sparql eng-sh:ss026-NVKItem-a_nvp23-multipleOf ;
    sh:sparql eng-sh:ss026-NVKItem-v_nvkvint-multipleOf ;
    sh:sparql eng-sh:ss026-NVKItem-m_nvkvint-multipleOf ;
    sh:sparql eng-sh:ss026-NVKItem-m_nvkvint_2-multipleOf ;
    sh:property eng-sh:ss026-NVKItem-q_nvkvintset ;
    sh:property eng-sh:ss026-NVKItem-a_nvp12 ;
    sh:property eng-sh:ss026-NVKItem-a_nvp23 ;
    sh:property eng-sh:ss026-NVKItem-v_nvkvint ;
    sh:property eng-sh:ss026-NVKItem-m_nvkvint ;
    sh:property eng-sh:ss026-NVKItem-m_nvkvint_2 ;
    sh:property eng-sh:ss026-NVKItem-nvkSubItems ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVKItem-q_nvkvintset
    a sh:PropertyShape ;
    sh:path era:q_nvkvintset ;
    sh:name "q_nvkvintset" ;
    sh:description "Type of kv_int set. True, if it is Conventional passenger trains; False, if its Freight Trains." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVKItem-a_nvp12
    a sh:PropertyShape ;
    sh:path era:a_nvp12 ;
    sh:name "a_nvp12" ;
    sh:description "Lower deceleration limit to determine the set of Kv to be used. Lower deceleration limit to determine the set of correction factor Kv to be used for Conventional Passenger trains. This variable is part of the National Values." ;
    sh:order 2 ;
    qudt:hasUnit unit:M-PER-SEC2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 3.15 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVKItem-a_nvp23
    a sh:PropertyShape ;
    sh:path era:a_nvp23 ;
    sh:name "a_nvp23" ;
    sh:description "Upper deceleration limit to determine the set of Kv to be used. Upper deceleration limit to determine the set of correction factor Kv to be used for Conventional Passenger trains. This variable is part of the National Values." ;
    sh:order 3 ;
    qudt:hasUnit unit:M-PER-SEC2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 3.15 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVKItem-v_nvkvint
    a sh:PropertyShape ;
    sh:path era:v_nvkvint ;
    sh:name "v_nvkvint" ;
    sh:description "Speed step used to define the integrated correction factor Kv. This variable is part of the National Values." ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVKItem-m_nvkvint
    a sh:PropertyShape ;
    sh:path era:m_nvkvint ;
    sh:name "m_nvkvint" ;
    sh:description "Integrated correction factor Kv. This is the speed dependent integrated correction factor. M_NVKVINT(n) is valid for an estimated speed between V_NVKVINT(n) and V_NVKVINT(n+1). M_NVKVINT is valid between 0 km/h and V_NVKVINT(1)This variable is part of the National Values. Comment : Valid between V_NVKVINT and V_NVKVINT(1) If Q_NVKVINTSET = 1, gives the correction factor if maximum emergency brake deceleration is lower than A_NVP12" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 2.54 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVKItem-m_nvkvint_2
    a sh:PropertyShape ;
    sh:path era:m_nvkvint_2 ;
    sh:name "m_nvkvint_2" ;
    sh:description "Only if q_nvkvintset = 1; valid between v_nvkvint and v_nvkvint(1). Gives the correction factor if maximum emergency brake deceleration is higher than a_nvp23" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 2.54 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVKItem-nvkSubItems
    a sh:PropertyShape ;
    sh:path era:nvkSubItems ;
    sh:name "nvkSubItems" ;
    sh:description "List of NVKSubItem" ;
    sh:order 7 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:ss026-NVKSubItemShape ;
    sh:message "nvkSubItems must be a well-formed NVKSubItem (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVKItem-a_nvp12-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "a_nvp12 must be a multiple of 0.05 m/s2."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:a_nvp12 ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

eng-sh:ss026-NVKItem-a_nvp23-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "a_nvp23 must be a multiple of 0.05 m/s2."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:a_nvp23 ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

eng-sh:ss026-NVKItem-v_nvkvint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "v_nvkvint must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_nvkvint ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

eng-sh:ss026-NVKItem-m_nvkvint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "m_nvkvint must be a multiple of 0.02."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvkvint ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.02) * 0.02)) > 0.000000001 )
            }
        """ ;
    .

eng-sh:ss026-NVKItem-m_nvkvint_2-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "m_nvkvint_2 must be a multiple of 0.02."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvkvint_2 ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.02) * 0.02)) > 0.000000001 )
            }
        """ ;
    .

### CorrectionFactor ##################################################
eng-sh:ss026-CorrectionFactorShape
    a sh:NodeShape ;
    sh:targetClass era:CorrectionFactor ;
    sh:name "CorrectionFactor" ;
    sh:description "Defines the correction factors used to adjust train operation parameters based on train length. These factors are part of the National Values and are used to determine the integrated correction factor Kr for specific train length intervals." ;
    sh:sparql eng-sh:ss026-CorrectionFactor-m_nvkrint-multipleOf ;
    sh:property eng-sh:ss026-CorrectionFactor-l_nvkrint ;
    sh:property eng-sh:ss026-CorrectionFactor-m_nvkrint ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-CorrectionFactor-l_nvkrint
    a sh:PropertyShape ;
    sh:path era:l_nvkrint ;
    sh:name "l_nvkrint" ;
    sh:description "Train length step used to define the integrated correction factor Kr. This variable is part of the National Values." ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 2700 ;
    sh:in ( "0"^^xsd:unsignedInt "25"^^xsd:unsignedInt "50"^^xsd:unsignedInt "75"^^xsd:unsignedInt "100"^^xsd:unsignedInt "150"^^xsd:unsignedInt "200"^^xsd:unsignedInt "300"^^xsd:unsignedInt "400"^^xsd:unsignedInt "500"^^xsd:unsignedInt "600"^^xsd:unsignedInt "700"^^xsd:unsignedInt "800"^^xsd:unsignedInt "900"^^xsd:unsignedInt "1000"^^xsd:unsignedInt "1100"^^xsd:unsignedInt "1200"^^xsd:unsignedInt "1300"^^xsd:unsignedInt "1400"^^xsd:unsignedInt "1500"^^xsd:unsignedInt "1600"^^xsd:unsignedInt "1700"^^xsd:unsignedInt "1800"^^xsd:unsignedInt "1900"^^xsd:unsignedInt "2000"^^xsd:unsignedInt "2100"^^xsd:unsignedInt "2200"^^xsd:unsignedInt "2300"^^xsd:unsignedInt "2400"^^xsd:unsignedInt "2500"^^xsd:unsignedInt "2600"^^xsd:unsignedInt "2700"^^xsd:unsignedInt ) ;
    sh:message "l_nvkrint must be one of 0, 25, 50, 75, 100, 150, 200, 300, then 400 to 2700 in steps of 100 m."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-CorrectionFactor-m_nvkrint
    a sh:PropertyShape ;
    sh:path era:m_nvkrint ;
    sh:name "m_nvkrint" ;
    sh:description "Integrated correction factor Kr. This is the train length dependent integrated correction factor. M_NVKRINT(l) is valid for a train length between L_NVKRINT(l) and L_NVKRINT(l+1). M_NVKRINT is valid between 0m and L_NVKRINT(1)Th variable is part of the National Values." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 1.55 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-CorrectionFactor-m_nvkrint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "m_nvkrint must be a multiple of 0.05."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvkrint ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

### TransmittedSpecificStaticSpeed ####################################
eng-sh:ss026-TransmittedSpecificStaticSpeedShape
    a sh:NodeShape ;
    sh:targetClass era:TransmittedSpecificStaticSpeed ;
    sh:name "TransmittedSpecificStaticSpeed" ;
    sh:description "Defines a single specific static speed restriction transmitted as part of the Static Speed Profile (SSP). It specifies conditions under which a different static line speed applies to certain train categories or cant deficiency classes." ;
    sh:sparql eng-sh:ss026-TransmittedSpecificStaticSpeed-v_diff-multipleOf ;
    sh:property eng-sh:ss026-TransmittedSpecificStaticSpeed-q_diff ;
    sh:property eng-sh:ss026-TransmittedSpecificStaticSpeed-nc_cddiff ;
    sh:property eng-sh:ss026-TransmittedSpecificStaticSpeed-nc_diff ;
    sh:property eng-sh:ss026-TransmittedSpecificStaticSpeed-v_diff ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TransmittedSpecificStaticSpeed-q_diff
    a sh:PropertyShape ;
    sh:path era:q_diff ;
    sh:name "q_diff" ;
    sh:description "Qualifier for specific SSP categories. In case of 'other specific' SSP, it tells ERTMS/ETCS on-board equipment whether it replaces or not the Cant Deficiency SSP as selected by on-board (ref. 3.11.3.2.3), when the train belongs to an 'other international' train category to which the 'other specific' SSP applies" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 2 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TransmittedSpecificStaticSpeed-nc_cddiff
    a sh:PropertyShape ;
    sh:path era:nc_cddiff ;
    sh:name "nc_cddiff" ;
    sh:description "It is the 'Cant Deficiency' SSP category for which a different value for the static line speed exists. Used together with V_DIFF to permit certain trains to go faster or lower than the 'international basic static speed' given by V_STATIC. Note: nc_cddiff only needed If Q_DIFF(n) = 0" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/cant-deficiencies/80> <http://data.europa.eu/949/concepts/cant-deficiencies/100> <http://data.europa.eu/949/concepts/cant-deficiencies/130> <http://data.europa.eu/949/concepts/cant-deficiencies/150> <http://data.europa.eu/949/concepts/cant-deficiencies/165> <http://data.europa.eu/949/concepts/cant-deficiencies/180> <http://data.europa.eu/949/concepts/cant-deficiencies/210> <http://data.europa.eu/949/concepts/cant-deficiencies/225> <http://data.europa.eu/949/concepts/cant-deficiencies/245> <http://data.europa.eu/949/concepts/cant-deficiencies/275> <http://data.europa.eu/949/concepts/cant-deficiencies/300> ) ;
    sh:message "Value must be one of the CCSTMS-scoped CantDeficiencies concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TransmittedSpecificStaticSpeed-nc_diff
    a sh:PropertyShape ;
    sh:path era:nc_diff ;
    sh:name "nc_diff" ;
    sh:description "It is the 'other specific' SSP category for which a different value for the static line speed exists. Used together with V_DIFF to permit trains belonging to the corresponding 'other international' train category to go faster or lower than the 'international basic static speed' given by V_STATIC. Value 0 of NC_DIFF corresponds to the LSB of NC_TRAIN, value 14 of NC_DIFF to MSB (15-bit variable) of NC_TRAIN." ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_freightTrainP> <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_freightTrainG> <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_passengerTrain> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OtherSpecificStaticSpeedProfileCategory concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TransmittedSpecificStaticSpeed-v_diff
    a sh:PropertyShape ;
    sh:path era:v_diff ;
    sh:name "v_diff" ;
    sh:description "Absolute Positive Speed associated to a train category. Resolution is 5 km/h" ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-TransmittedSpecificStaticSpeed-v_diff-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "v_diff must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_diff ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

