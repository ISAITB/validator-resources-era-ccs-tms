### TrackUsagePath ####################################################
eng-sh:TrackUsagePathShape
    a sh:NodeShape ;
    sh:targetClass era:TrackUsagePath ;
    sh:name "TrackUsagePath" ;
    sh:description "A defined sequence of track elements and associated infrastructure forming a continuous operational path." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:sparql eng-sh:TrackUsagePath-precedingTrackUsagePath-irreflexive ;
    sh:sparql eng-sh:TrackUsagePath-precedingTrackUsagePath-asymmetric ;
    sh:property eng-sh:TrackUsagePath-switches ;
    sh:property eng-sh:TrackUsagePath-derailers ;
    sh:property eng-sh:TrackUsagePath-levelCrossings ;
    sh:property eng-sh:TrackUsagePath-pathBody ;
    sh:property eng-sh:TrackUsagePath-precedingTrackUsagePath ;
    sh:severity sh:Violation ;
    .

eng-sh:TrackUsagePath-switches
    a sh:PropertyShape ;
    sh:path era:switches ;
    sh:name "switches" ;
    sh:description "Defines the list of switch(es)" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Switch ;
    sh:message "switches must reference an existing era:Switch by IRI."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:TrackUsagePath-derailers
    a sh:PropertyShape ;
    sh:path era:derailers ;
    sh:name "derailers" ;
    sh:description "Defines the list of derailer(s)" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Derailer ;
    sh:message "derailers must reference an existing era:Derailer by IRI."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:TrackUsagePath-levelCrossings
    a sh:PropertyShape ;
    sh:path era:levelCrossings ;
    sh:name "levelCrossings" ;
    sh:description "Defines the list of level crossings" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LevelCrossing ;
    sh:message "levelCrossings must reference an existing era:LevelCrossing by IRI."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:TrackUsagePath-pathBody
    a sh:PropertyShape ;
    sh:path era:pathBody ;
    sh:name "pathBody" ;
    sh:description "List of linear references included in the track usage path." ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:infra-NetLinearReferenceShape ;
    sh:message "pathBody must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:TrackUsagePath-precedingTrackUsagePath
    a sh:PropertyShape ;
    sh:path era:precedingTrackUsagePath ;
    sh:name "precedingTrackUsagePath" ;
    sh:description "Defines the immediately preceding TrackUsagePath in the operational sequence." ;
    sh:order 6 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TrackUsagePath ;
    sh:message "precedingTrackUsagePath must reference an existing era:TrackUsagePath by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:TrackUsagePath-precedingTrackUsagePath-irreflexive
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "era:precedingTrackUsagePath is an owl:IrreflexiveProperty: a TrackUsagePath must not point at itself."@en ;
    sh:select """
            SELECT $this
            WHERE { $this era:precedingTrackUsagePath $this }
        """ ;
    .

eng-sh:TrackUsagePath-precedingTrackUsagePath-asymmetric
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "era:precedingTrackUsagePath is an owl:AsymmetricProperty: if A era:precedingTrackUsagePath B then B era:precedingTrackUsagePath A must not hold."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:precedingTrackUsagePath ?other .
                ?other era:precedingTrackUsagePath $this .
            }
        """ ;
    .

### EngArea ###########################################################
eng-sh:EngAreaShape
    a sh:NodeShape ;
    sh:targetClass era:EngArea ;
    sh:name "EngArea" ;
    sh:description "Defines the container for the Engineering area" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property eng-sh:EngArea-topoArea ;
    sh:property eng-sh:EngArea-defaultSleepersType ;
    sh:property eng-sh:EngArea-switches ;
    sh:property eng-sh:EngArea-crossings ;
    sh:property eng-sh:EngArea-levelCrossings ;
    sh:property eng-sh:EngArea-baliseGroups ;
    sh:property eng-sh:EngArea-sleepers ;
    sh:property eng-sh:EngArea-trackUsagePaths ;
    sh:property eng-sh:EngArea-dangerPoints ;
    sh:property eng-sh:EngArea-foulingPoints ;
    sh:property eng-sh:EngArea-bufferStops ;
    sh:severity sh:Violation ;
    .

eng-sh:EngArea-topoArea
    a sh:PropertyShape ;
    sh:path era:topoArea ;
    sh:name "topoArea" ;
    sh:description "reference to the corresponding TopoArea" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TopoArea ;
    sh:message "topoArea must reference an existing era:TopoArea by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:EngArea-defaultSleepersType
    a sh:PropertyShape ;
    sh:path era:defaultSleepersType ;
    sh:name "defaultSleepersType" ;
    sh:description "Defines the default sleeper type" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/sleepers-type/unknownSleepersType> <http://data.europa.eu/949/concepts/sleepers-type/composite> <http://data.europa.eu/949/concepts/sleepers-type/concrete> <http://data.europa.eu/949/concepts/sleepers-type/steel> <http://data.europa.eu/949/concepts/sleepers-type/wood> ) ;
    sh:message "Value must be one of the CCSTMS-scoped SleepersType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:EngArea-switches
    a sh:PropertyShape ;
    sh:path era:switches ;
    sh:name "switches" ;
    sh:description "Defines the list of switches" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:SwitchShape ;
    sh:message "switches must be a well-formed Switch (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:EngArea-crossings
    a sh:PropertyShape ;
    sh:path era:crossings ;
    sh:name "crossings" ;
    sh:description "Defines the list of crossings" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:CrossingShape ;
    sh:message "crossings must be a well-formed Crossing (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:EngArea-levelCrossings
    a sh:PropertyShape ;
    sh:path era:levelCrossings ;
    sh:name "levelCrossings" ;
    sh:description "Defines the list of level crossings" ;
    sh:order 6 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:LevelCrossingShape ;
    sh:message "levelCrossings must be a well-formed LevelCrossing (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:EngArea-baliseGroups
    a sh:PropertyShape ;
    sh:path era:baliseGroups ;
    sh:name "baliseGroups" ;
    sh:description "Defines the balise groups" ;
    sh:order 7 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:BaliseGroupShape ;
    sh:message "baliseGroups must be a well-formed BaliseGroup (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

eng-sh:EngArea-sleepers
    a sh:PropertyShape ;
