### ETCSTrackToTrainPacket_139 ########################################
eng-sh:ss026-ETCSTrackToTrainPacket_139Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_139 ;
    sh:name "ETCSTrackToTrainPacket_139" ;
    sh:description "Reversing supervision information (Used to send supervision parameters (distance to run, speed) of reversing area to the on-board)" ;
    sh:sparql eng-sh:ss026-ETCSTrackToTrainPacket_139-v_reverse-multipleOf ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_139-d_reverse ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_139-v_reverse ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_139-d_reverse
    a sh:PropertyShape ;
    sh:path era:d_reverse ;
    sh:name "d_reverse" ;
    sh:description "Maximum distance to run in RV mode (Distance from reference location to end location of the distance to run in RV mode.)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_139-v_reverse
    a sh:PropertyShape ;
    sh:path era:v_reverse ;
    sh:name "v_reverse" ;
    sh:description "Reversing mode speed limit." ;
    sh:order 2 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_139-v_reverse-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "v_reverse must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_reverse ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

### ETCSTrackToTrainPacket_140 ########################################
eng-sh:ss026-ETCSTrackToTrainPacket_140Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_140 ;
    sh:name "ETCSTrackToTrainPacket_140" ;
    sh:description "Train running number from RBC" ;
    sh:property eng-sh:ss026-ETCSTrackToTrainPacket_140-nid_operational ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_140-nid_operational
    a sh:PropertyShape ;
    sh:path era:nid_operational ;
    sh:name "nid_operational" ;
    sh:description "This is the operational train running number. The NID_OPERATIONAL consists of up to 8 digits which are entered left adjusted into the data field, the leftmost digit is the digit to be entered first. In case the NID_OPERATIONAL is shorter than 8 digits, the remaining space is to be filled with special character 'F' in the binary representation as uint32." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]{8}$" ;
    sh:message "nid_operational is Binary Coded Decimal: exactly 8 decimal digits (0-9), no other characters."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

