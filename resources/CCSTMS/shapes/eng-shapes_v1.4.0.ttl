    .

eng-sh:ss026-ETCSTrackToTrainPacket_180-q_lssma
    a sh:PropertyShape ;
    sh:path era:q_lssma ;
    sh:name "q_lssma" ;
    sh:description "Qualifier for the LSSMA display (This qualifier tells whether the on-board has to toggle on/off the display of the lowest supervised speed within the MA.)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_180-t_lssma
    a sh:PropertyShape ;
    sh:path era:t_lssma ;
    sh:name "t_lssma" ;
    sh:description "Delay to toggle on the LSSMA display." ;
    sh:order 2 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_181 ########################################
eng-sh:ss026-ETCSTrackToTrainPacket_181Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_181 ;
    sh:name "ETCSTrackToTrainPacket_181" ;
    sh:description "Generic LS function marker (Used to enable the generic toggling on/off of the display of the Lowest Supervised Speed within the MA.)" ;
