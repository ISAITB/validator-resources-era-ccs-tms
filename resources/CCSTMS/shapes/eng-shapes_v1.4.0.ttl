eng-sh:ss026-ETCSTrackToTrainPacket_15-v_ema-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "v_ema must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_ema ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

eng-sh:ss026-ETCSTrackToTrainPacket_15-v_releaseDP-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "v_releaseDP must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_releaseDP ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

