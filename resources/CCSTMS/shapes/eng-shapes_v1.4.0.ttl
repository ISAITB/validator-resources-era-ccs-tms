### NVK ###############################################################
eng-sh:ss026-NVKShape
    a sh:NodeShape ;
    sh:targetClass era:NVK ;
    sh:name "NVK" ;
    sh:description "Defines the integrated correction factors Kv, Kr, and Kt used for speed- and train length-dependent braking performance adjustments. It aggregates multiple correction factor sets, including train length steps, speed-dependent correction factors, and their associated validation parameters, as part of the National Values." ;
    sh:sparql eng-sh:ss026-NVK-m_nvkrint-multipleOf ;
    sh:sparql eng-sh:ss026-NVK-m_nvktint-multipleOf ;
    sh:property eng-sh:ss026-NVK-nvkItems ;
    sh:property eng-sh:ss026-NVK-l_nvkrint ;
    sh:property eng-sh:ss026-NVK-m_nvkrint ;
    sh:property eng-sh:ss026-NVK-correctionFactors ;
    sh:property eng-sh:ss026-NVK-m_nvktint ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVK-nvkItems
    a sh:PropertyShape ;
    sh:path era:nvkItems ;
    sh:name "nvkItems" ;
    sh:description "q_nvkvintset and other variables follows" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:ss026-NVKItemShape ;
    sh:message "nvkItems must be a well-formed NVKItem (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 32 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVK-l_nvkrint
    a sh:PropertyShape ;
    sh:path era:l_nvkrint ;
    sh:name "l_nvkrint" ;
    sh:description "Train length step used to define the integrated correction factor Kr. This variable is part of the National Values." ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 2700 ;
    sh:in ( "0"^^xsd:unsignedInt "25"^^xsd:unsignedInt "50"^^xsd:unsignedInt "75"^^xsd:unsignedInt "100"^^xsd:unsignedInt "150"^^xsd:unsignedInt "200"^^xsd:unsignedInt "300"^^xsd:unsignedInt "400"^^xsd:unsignedInt "500"^^xsd:unsignedInt "600"^^xsd:unsignedInt "700"^^xsd:unsignedInt "800"^^xsd:unsignedInt "900"^^xsd:unsignedInt "1000"^^xsd:unsignedInt "1100"^^xsd:unsignedInt "1200"^^xsd:unsignedInt "1300"^^xsd:unsignedInt "1400"^^xsd:unsignedInt "1500"^^xsd:unsignedInt "1600"^^xsd:unsignedInt "1700"^^xsd:unsignedInt "1800"^^xsd:unsignedInt "1900"^^xsd:unsignedInt "2000"^^xsd:unsignedInt "2100"^^xsd:unsignedInt "2200"^^xsd:unsignedInt "2300"^^xsd:unsignedInt "2400"^^xsd:unsignedInt "2500"^^xsd:unsignedInt "2600"^^xsd:unsignedInt "2700"^^xsd:unsignedInt ) ;
    sh:message "l_nvkrint must be one of 0, 25, 50, 75, 100, 150, 200, 300, then 400 to 2700 in steps of 100 m."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVK-m_nvkrint
    a sh:PropertyShape ;
    sh:path era:m_nvkrint ;
    sh:name "m_nvkrint" ;
    sh:description "Integrated correction factor Kr. This is the train length dependent integrated correction factor. M_NVKRINT(l) is valid for a train length between L_NVKRINT(l) and L_NVKRINT(l+1). M_NVKRINT is valid between 0m and L_NVKRINT(1)This variable is part of the National Values." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 1.55 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVK-correctionFactors
    a sh:PropertyShape ;
    sh:path era:correctionFactors ;
    sh:name "correctionFactors" ;
    sh:description "integration correction factors" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node eng-sh:ss026-CorrectionFactorShape ;
    sh:message "correctionFactors must be a well-formed CorrectionFactor (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVK-m_nvktint
    a sh:PropertyShape ;
    sh:path era:m_nvktint ;
    sh:name "m_nvktint" ;
    sh:description "Integrated correction factor Kt." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 1.55 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-NVK-m_nvkrint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "m_nvkrint must be a multiple of 0.05."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvkrint ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

eng-sh:ss026-NVK-m_nvktint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes eng-sh:PrefixDeclarations ;
    sh:message "m_nvktint must be a multiple of 0.05."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvktint ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

### LinkItem ##########################################################
eng-sh:ss026-LinkItemShape
    a sh:NodeShape ;
    sh:targetClass era:LinkItem ;
    sh:name "LinkItem" ;
    sh:description "Defines the attributes for linking balise groups in railway signaling, ensuring proper navigation and train positioning. This includes linking distances, country and region qualifiers, balise group identity, link orientation, reaction to inconsistencies, and location accuracy to maintain safe and reliable operations." ;
    sh:property eng-sh:ss026-LinkItem-d_link ;
    sh:property eng-sh:ss026-LinkItem-nid_c ;
    sh:property eng-sh:ss026-LinkItem-nid_bg ;
    sh:property eng-sh:ss026-LinkItem-q_linkorientation ;
    sh:property eng-sh:ss026-LinkItem-q_linkreaction ;
    sh:property eng-sh:ss026-LinkItem-q_locacc ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LinkItem-d_link
    a sh:PropertyShape ;
    sh:path era:d_link ;
    sh:name "d_link" ;
    sh:description "Incremental linking distance to next linked balise group" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LinkItem-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "New Country Qualifier (Qualifier to indicate whether the next balise group is in the same country / railway administration as the one before inside the packet or not.For the first balise group in the packet, if not provided, it is the same country / railway administration as the one of the LRBG within the radio message, the one of balise group within the balise telegram giving the packet, or the one of the loop within the loop message giving the packet)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LinkItem-nid_bg
    a sh:PropertyShape ;
    sh:path era:nid_bg ;
    sh:name "nid_bg" ;
    sh:description "Identity number of the balise group. Identity number of a balise group or loop within the country or region defined by NID_C." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LinkItem-q_linkorientation
    a sh:PropertyShape ;
    sh:path era:q_linkorientation ;
    sh:name "q_linkorientation" ;
    sh:description "Qualifier for the direction of the linked balise group. Indicates whether the linked balise group will be overpassed by the train in nominal or reverse directio" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LinkItem-q_linkreaction
    a sh:PropertyShape ;
    sh:path era:q_linkreaction ;
    sh:name "q_linkreaction" ;
    sh:description "linking reaction. Qualifier for the reaction to be performed if a linking or a balise group message consistency problem occurs with the balise group linked to." ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-reactions-contact/00> <http://data.europa.eu/949/concepts/etcs-reactions-contact/01> <http://data.europa.eu/949/concepts/etcs-reactions-contact/10> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSReactionsNVContact concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

eng-sh:ss026-LinkItem-q_locacc
    a sh:PropertyShape ;
    sh:path era:q_locacc ;
    sh:name "q_locacc" ;
    sh:description "Accuracy of the balise location. This Qualifier defines the absolute value of the accuracy of the Balise location" ;
    sh:order 6 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 63 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

