### ETCSTrackToTrainPacket_255 ########################################
eng-sh:ss026-ETCSTrackToTrainPacket_255Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_255 ;
    sh:name "ETCSTrackToTrainPacket_255" ;
