### DLTrackCond #######################################################
ss026-sh:DLTrackCondShape
    a sh:NodeShape ;
    sh:targetClass era:DLTrackCond ;
    sh:name "DLTrackCond" ;
    sh:description "Defines the parameters for dynamic line track conditions, specifying the distance to track condition changes and the validity length of the condition. These parameters are used to manage integrity check alarms of balise transmission within the defined section." ;
    sh:property ss026-sh:DLTrackCond-d_trackcond ;
    sh:property ss026-sh:DLTrackCond-l_trackcond ;
    sh:severity sh:Violation ;
    .

ss026-sh:DLTrackCond-d_trackcond
    a sh:PropertyShape ;
    sh:path era:d_trackcond ;
    sh:name "d_trackcond" ;
    sh:description "Track condition distance (The incremental distance to where the track conditions change)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:DLTrackCond-l_trackcond
    a sh:PropertyShape ;
    sh:path era:l_trackcond ;
    sh:name "l_trackcond" ;
    sh:description "Length for which the defined track condition is valid. (The distance for which integrity check alarms of balise transmission shall be ignored)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_67 #########################################
ss026-sh:ETCSTrackToTrainPacket_67Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_67 ;
    sh:name "ETCSTrackToTrainPacket_67" ;
    sh:description "Track Condition Big Metal Masses.This packet gives details concerning where to ignore integrity check alarms of balise transmission due to big metal masses trackside" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_67-dlTrackConditions ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_67-dlTrackConditions
    a sh:PropertyShape ;
    sh:path era:dlTrackConditions ;
    sh:name "dlTrackConditions" ;
    sh:description "List of track condition (distance-length)" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:DLTrackCondShape ;
    sh:message "dlTrackConditions must be a well-formed DLTrackCond (blank node or IRI)."@en ;
