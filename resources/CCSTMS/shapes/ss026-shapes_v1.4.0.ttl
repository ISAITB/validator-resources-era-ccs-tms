### ETCSTrainToTrackRM_157 ############################################
ss026-sh:ETCSTrainToTrackRM_157Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackRM_157 ;
    sh:name "ETCSTrainToTrackRM_157" ;
    sh:description "SoM Position Report" ;
    sh:property ss026-sh:ETCSTrainToTrackRM_157-q_statusLRBG ;
    sh:property ss026-sh:ETCSTrainToTrackRM_157-trainToTrackPacket_0 ;
    sh:property ss026-sh:ETCSTrainToTrackRM_157-trainToTrackPacket_1 ;
    sh:property ss026-sh:ETCSTrainToTrackRM_157-hasOptionalTrainToTrackPackets ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackRM_157-q_statusLRBG
    a sh:PropertyShape ;
    sh:path era:q_statusLRBG ;
    sh:name "q_statusLRBG" ;
    sh:description "Status of SoM position report in relation to the LRBG" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/lrbg-position-status/invalidPosition> <http://data.europa.eu/949/concepts/lrbg-position-status/validPosition> <http://data.europa.eu/949/concepts/lrbg-position-status/noPosition> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LRBGPositionStatus concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackRM_157-trainToTrackPacket_0
    a sh:PropertyShape ;
    sh:path era:trainToTrackPacket_0 ;
    sh:name "trainToTrackPacket_0" ;
    sh:description "refers to position report" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:ETCSTrainToTrackPacket_0Shape ;
    sh:message "trainToTrackPacket_0 must be a well-formed ETCSTrainToTrackPacket_0 (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackRM_157-trainToTrackPacket_1
    a sh:PropertyShape ;
    sh:path era:trainToTrackPacket_1 ;
    sh:name "trainToTrackPacket_1" ;
    sh:description "refers to position report based on two balise groups" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:ETCSTrainToTrackPacket_1Shape ;
    sh:message "trainToTrackPacket_1 must be a well-formed ETCSTrainToTrackPacket_1 (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackRM_157-hasOptionalTrainToTrackPackets
    a sh:PropertyShape ;
    sh:path era:hasOptionalTrainToTrackPackets ;
    sh:name "hasOptionalTrainToTrackPackets" ;
    sh:description "refers to the optional train-to-track packets. See Subset026-8, 8.4.4" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:ETCSTrainToTrackPacketShape ;
    sh:message "hasOptionalTrainToTrackPackets must be a well-formed ETCSTrainToTrackPacket (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

