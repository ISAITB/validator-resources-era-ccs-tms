    sh:property ss026-sh:ETCSTrackToTrainPacket_141-q_gdir ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_141-g_tsr ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_141-q_gdir
    a sh:PropertyShape ;
