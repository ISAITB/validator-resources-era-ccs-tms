### ETCSTrackToTrainPacket_57 #########################################
ss026-sh:ETCSTrackToTrainPacket_57Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_57 ;
    sh:name "ETCSTrackToTrainPacket_57" ;
    sh:description "Movement Authority Request Parameters. This packet is intended to give parameters telling when and how often the train has to ask for a movement authority." ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_57-t_mar ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_57-t_timeoutrqst ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_57-t_cycrqst ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_57-t_mar
    a sh:PropertyShape ;
    sh:path era:t_mar ;
    sh:name "t_mar" ;
    sh:description "Time before reaching the perturbation location. A value of 255 seconds means that no MA request triggering with regards to this function" ;
    sh:order 1 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_57-t_timeoutrqst
    a sh:PropertyShape ;
    sh:path era:t_timeoutrqst ;
    sh:name "t_timeoutrqst" ;
    sh:description "Time before any section timer expires or the LOA speed timer expires" ;
    sh:order 2 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_57-t_cycrqst
    a sh:PropertyShape ;
    sh:path era:t_cycrqst ;
    sh:name "t_cycrqst" ;
    sh:description "Time between two cyclic requests for a movement authority. As long as at least one reason for sending MA requests is applicable, the on-board will repeat its request every T_CYCRQST seconds" ;
    sh:order 3 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### PositionReportLocation ############################################
ss026-sh:PositionReportLocationShape
    a sh:NodeShape ;
    sh:targetClass era:PositionReportLocation ;
    sh:name "PositionReportLocation" ;
    sh:description "Defines a specific location or distance reference at which the train must send a position report. Includes the distance increment to the reporting location and a qualifier indicating whether reporting is triggered by the front or rear of the train passing the location." ;
    sh:property ss026-sh:PositionReportLocation-d_loc ;
    sh:property ss026-sh:PositionReportLocation-q_lgtloc ;
    sh:severity sh:Violation ;
    .

ss026-sh:PositionReportLocation-d_loc
    a sh:PropertyShape ;
    sh:path era:d_loc ;
    sh:name "d_loc" ;
    sh:description "Incremental distance between locations where the train has to report its position." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:PositionReportLocation-q_lgtloc
    a sh:PropertyShape ;
    sh:path era:q_lgtloc ;
    sh:name "q_lgtloc" ;
    sh:description "Qualifier for the specified report location. This qualifier tells whether the train has to report its position when the max safe front end or when the min safe rear end has over passed the location defined by D_LOC. False - Min safe rear end; True - Max safe front end" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_58 #########################################
ss026-sh:ETCSTrackToTrainPacket_58Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_58 ;
    sh:name "ETCSTrackToTrainPacket_58" ;
    sh:description "Position Report Parameters. This packet is intended to give parameters telling when and how often the position has to be reported." ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_58-t_cycloc ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_58-d_cycloc ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_58-m_loc ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_58-hasPositionReportLocation ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_58-t_cycloc
    a sh:PropertyShape ;
    sh:path era:t_cycloc ;
    sh:name "t_cycloc" ;
    sh:description "Time Interval between two position reports sent by the train" ;
    sh:order 1 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_58-d_cycloc
    a sh:PropertyShape ;
    sh:path era:d_cycloc ;
    sh:name "d_cycloc" ;
    sh:description "Distance between two position reports from the train. The train has to report its position every D_CYCLOC meters." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_58-m_loc
    a sh:PropertyShape ;
    sh:path era:m_loc ;
    sh:name "m_loc" ;
    sh:description "Time between two cyclic requests for a movement authority. As long as at least one reason for sending MA requests is applicable, the on-board will repeat its request every T_CYCRQST seconds" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/prlt/now> <http://data.europa.eu/949/concepts/prlt/everyLRBG> <http://data.europa.eu/949/concepts/prlt/noReportOnLRBG> ) ;
    sh:message "Value must be one of the CCSTMS-scoped PositionReportLocationType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_58-hasPositionReportLocation
    a sh:PropertyShape ;
    sh:path era:hasPositionReportLocation ;
    sh:name "hasPositionReportLocation" ;
    sh:description "refers to the position report locations" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:PositionReportLocationShape ;
    sh:message "hasPositionReportLocation must be a well-formed PositionReportLocation (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

