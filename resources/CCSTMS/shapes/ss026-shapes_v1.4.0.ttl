ss026-sh:SectionTimer-t_sectionTimer
    a sh:PropertyShape ;
    sh:path era:t_sectionTimer ;
    sh:name "t_sectionTimer" ;
    sh:description "Time for which the section is valid." ;
    sh:order 3 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:SectionTimer-d_sectionTimerStopLoc
    a sh:PropertyShape ;
    sh:path era:d_sectionTimerStopLoc ;
    sh:name "d_sectionTimerStopLoc" ;
    sh:description "Distance from beginning of section to the Section Time-out stop location" ;
