### ETCSTrackToTrainPacket_0 ##########################################
ss026-sh:ETCSTrackToTrainPacket_0Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_0 ;
    sh:name "ETCSTrackToTrainPacket_0" ;
    sh:description "Virtual Balise Cover marker (Indication to on-board that the telegram can be ignored according to a VBC)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_0-nid_vbcmk ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_0-nid_vbcmk
    a sh:PropertyShape ;
    sh:path era:nid_vbcmk ;
    sh:name "nid_vbcmk" ;
    sh:description "Marker for Virtual Balise Cover." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 63 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_2 ##########################################
ss026-sh:ETCSTrackToTrainPacket_2Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_2 ;
    sh:name "ETCSTrackToTrainPacket_2" ;
    sh:description "System Version order (This packet is used to tell the on-board which is the operated system version)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_2-etcsMVersion ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_2-etcsMVersion
    a sh:PropertyShape ;
    sh:path era:etcsMVersion ;
    sh:name "etcsMVersion" ;
    sh:description "This gives the version of the ETCS system. Each part indicates the first and second number of the version respectively: The first number distinguishes not compatible versions (The three MSBs)_ The second number indicates compatibility within a version X. (The four LSBs)" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-m-versions/10> <http://data.europa.eu/949/concepts/etcs-m-versions/11> <http://data.europa.eu/949/concepts/etcs-m-versions/20> <http://data.europa.eu/949/concepts/etcs-m-versions/21> <http://data.europa.eu/949/concepts/etcs-m-versions/22> <http://data.europa.eu/949/concepts/etcs-m-versions/23> <http://data.europa.eu/949/concepts/etcs-m-versions/30> <http://data.europa.eu/949/concepts/etcs-m-versions/00> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSMVersions concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### CorrectionFactor ##################################################
ss026-sh:CorrectionFactorShape
    a sh:NodeShape ;
    sh:targetClass era:CorrectionFactor ;
    sh:name "CorrectionFactor" ;
    sh:description "Defines the correction factors used to adjust train operation parameters based on train length. These factors are part of the National Values and are used to determine the integrated correction factor Kr for specific train length intervals." ;
    sh:sparql ss026-sh:CorrectionFactor-m_nvkrint-multipleOf ;
    sh:property ss026-sh:CorrectionFactor-l_nvkrint ;
    sh:property ss026-sh:CorrectionFactor-m_nvkrint ;
    sh:severity sh:Violation ;
    .

ss026-sh:CorrectionFactor-l_nvkrint
    a sh:PropertyShape ;
    sh:path era:l_nvkrint ;
    sh:name "l_nvkrint" ;
    sh:description "Train length step used to define the integrated correction factor Kr. This variable is part of the National Values." ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 2700 ;
    sh:in ( "0"^^xsd:unsignedInt "25"^^xsd:unsignedInt "50"^^xsd:unsignedInt "75"^^xsd:unsignedInt "100"^^xsd:unsignedInt "150"^^xsd:unsignedInt "200"^^xsd:unsignedInt "300"^^xsd:unsignedInt "400"^^xsd:unsignedInt "500"^^xsd:unsignedInt "600"^^xsd:unsignedInt "700"^^xsd:unsignedInt "800"^^xsd:unsignedInt "900"^^xsd:unsignedInt "1000"^^xsd:unsignedInt "1100"^^xsd:unsignedInt "1200"^^xsd:unsignedInt "1300"^^xsd:unsignedInt "1400"^^xsd:unsignedInt "1500"^^xsd:unsignedInt "1600"^^xsd:unsignedInt "1700"^^xsd:unsignedInt "1800"^^xsd:unsignedInt "1900"^^xsd:unsignedInt "2000"^^xsd:unsignedInt "2100"^^xsd:unsignedInt "2200"^^xsd:unsignedInt "2300"^^xsd:unsignedInt "2400"^^xsd:unsignedInt "2500"^^xsd:unsignedInt "2600"^^xsd:unsignedInt "2700"^^xsd:unsignedInt ) ;
    sh:message "l_nvkrint must be one of 0, 25, 50, 75, 100, 150, 200, 300, then 400 to 2700 in steps of 100 m."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:CorrectionFactor-m_nvkrint
    a sh:PropertyShape ;
    sh:path era:m_nvkrint ;
    sh:name "m_nvkrint" ;
    sh:description "Integrated correction factor Kr. This is the train length dependent integrated correction factor. M_NVKRINT(l) is valid for a train length between L_NVKRINT(l) and L_NVKRINT(l+1). M_NVKRINT is valid between 0m and L_NVKRINT(1)Th variable is part of the National Values." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 1.55 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:CorrectionFactor-m_nvkrint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "m_nvkrint must be a multiple of 0.05."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvkrint ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

### NVKSubItem ########################################################
ss026-sh:NVKSubItemShape
    a sh:NodeShape ;
    sh:targetClass era:NVKSubItem ;
    sh:name "NVKSubItem" ;
    sh:description "Defines the speed-dependent correction factors used for braking calculations as part of the National Values. These factors determine the integrated correction factor Kv based on estimated train speed and emergency brake deceleration conditions" ;
    sh:sparql ss026-sh:NVKSubItem-v_nvkvint-multipleOf ;
    sh:sparql ss026-sh:NVKSubItem-m_nvkvint-multipleOf ;
    sh:sparql ss026-sh:NVKSubItem-m_nvkvint_2-multipleOf ;
    sh:property ss026-sh:NVKSubItem-v_nvkvint ;
    sh:property ss026-sh:NVKSubItem-m_nvkvint ;
    sh:property ss026-sh:NVKSubItem-m_nvkvint_2 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKSubItem-v_nvkvint
    a sh:PropertyShape ;
    sh:path era:v_nvkvint ;
    sh:name "v_nvkvint" ;
    sh:description "Speed step used to define the integrated correction factor Kv. This variable is part of the National Values." ;
    sh:order 1 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKSubItem-m_nvkvint
    a sh:PropertyShape ;
    sh:path era:m_nvkvint ;
    sh:name "m_nvkvint" ;
    sh:description "Integrated correction factor Kv. This is the speed dependent integrated correction factor. M_NVKVINT(n) is valid for an estimated speed between V_NVKVINT(n) and V_NVKVINT(n+1). M_NVKVINT is valid between 0 km/h and V_NVKVINT(1)This variable is part of the National Values. Comment : Valid between V_NVKVINT and V_NVKVINT(1) If Q_NVKVINTSET = 1, gives the correction factor if maximum emergency brake deceleration is lower than A_NVP12" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 2.54 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKSubItem-m_nvkvint_2
    a sh:PropertyShape ;
    sh:path era:m_nvkvint_2 ;
    sh:name "m_nvkvint_2" ;
    sh:description "Only if q_nvkvintset = 1; valid between v_nvkvint(n) and v_nvkvint(n+1). Gives the correction factor if maximum emergency brake deceleration is higher than a_nvp23" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 2.54 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKSubItem-v_nvkvint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "v_nvkvint must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_nvkvint ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

ss026-sh:NVKSubItem-m_nvkvint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "m_nvkvint must be a multiple of 0.02."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvkvint ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.02) * 0.02)) > 0.000000001 )
            }
        """ ;
    .

ss026-sh:NVKSubItem-m_nvkvint_2-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "m_nvkvint_2 must be a multiple of 0.02."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvkvint_2 ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.02) * 0.02)) > 0.000000001 )
            }
        """ ;
    .

### NVKItem ###########################################################
ss026-sh:NVKItemShape
    a sh:NodeShape ;
    sh:targetClass era:NVKItem ;
    sh:name "NVKItem" ;
    sh:description "Defines the correction factor set Kv used for braking calculations based on speed and deceleration limits. This includes thresholds for selecting the appropriate Kv set, speed-dependent correction factors, and associated sub-items. These values are part of the National Values and are used to refine braking performance for Conventional Passenger trains." ;
    sh:sparql ss026-sh:NVKItem-a_nvp12-multipleOf ;
    sh:sparql ss026-sh:NVKItem-a_nvp23-multipleOf ;
    sh:sparql ss026-sh:NVKItem-v_nvkvint-multipleOf ;
    sh:sparql ss026-sh:NVKItem-m_nvkvint-multipleOf ;
    sh:sparql ss026-sh:NVKItem-m_nvkvint_2-multipleOf ;
    sh:property ss026-sh:NVKItem-q_nvkvintset ;
    sh:property ss026-sh:NVKItem-a_nvp12 ;
    sh:property ss026-sh:NVKItem-a_nvp23 ;
    sh:property ss026-sh:NVKItem-v_nvkvint ;
    sh:property ss026-sh:NVKItem-m_nvkvint ;
    sh:property ss026-sh:NVKItem-m_nvkvint_2 ;
    sh:property ss026-sh:NVKItem-nvkSubItems ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKItem-q_nvkvintset
    a sh:PropertyShape ;
    sh:path era:q_nvkvintset ;
    sh:name "q_nvkvintset" ;
    sh:description "Type of kv_int set. True, if it is Conventional passenger trains; False, if its Freight Trains." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKItem-a_nvp12
    a sh:PropertyShape ;
    sh:path era:a_nvp12 ;
    sh:name "a_nvp12" ;
    sh:description "Lower deceleration limit to determine the set of Kv to be used. Lower deceleration limit to determine the set of correction factor Kv to be used for Conventional Passenger trains. This variable is part of the National Values." ;
    sh:order 2 ;
    qudt:hasUnit unit:M-PER-SEC2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 3.15 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKItem-a_nvp23
    a sh:PropertyShape ;
    sh:path era:a_nvp23 ;
    sh:name "a_nvp23" ;
    sh:description "Upper deceleration limit to determine the set of Kv to be used. Upper deceleration limit to determine the set of correction factor Kv to be used for Conventional Passenger trains. This variable is part of the National Values." ;
    sh:order 3 ;
    qudt:hasUnit unit:M-PER-SEC2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 3.15 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKItem-v_nvkvint
    a sh:PropertyShape ;
    sh:path era:v_nvkvint ;
    sh:name "v_nvkvint" ;
    sh:description "Speed step used to define the integrated correction factor Kv. This variable is part of the National Values." ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKItem-m_nvkvint
    a sh:PropertyShape ;
    sh:path era:m_nvkvint ;
    sh:name "m_nvkvint" ;
    sh:description "Integrated correction factor Kv. This is the speed dependent integrated correction factor. M_NVKVINT(n) is valid for an estimated speed between V_NVKVINT(n) and V_NVKVINT(n+1). M_NVKVINT is valid between 0 km/h and V_NVKVINT(1)This variable is part of the National Values. Comment : Valid between V_NVKVINT and V_NVKVINT(1) If Q_NVKVINTSET = 1, gives the correction factor if maximum emergency brake deceleration is lower than A_NVP12" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 2.54 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKItem-m_nvkvint_2
    a sh:PropertyShape ;
    sh:path era:m_nvkvint_2 ;
    sh:name "m_nvkvint_2" ;
    sh:description "Only if q_nvkvintset = 1; valid between v_nvkvint and v_nvkvint(1). Gives the correction factor if maximum emergency brake deceleration is higher than a_nvp23" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 2.54 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKItem-nvkSubItems
    a sh:PropertyShape ;
    sh:path era:nvkSubItems ;
    sh:name "nvkSubItems" ;
    sh:description "List of NVKSubItem" ;
    sh:order 7 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:NVKSubItemShape ;
    sh:message "nvkSubItems must be a well-formed NVKSubItem (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVKItem-a_nvp12-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "a_nvp12 must be a multiple of 0.05 m/s2."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:a_nvp12 ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

ss026-sh:NVKItem-a_nvp23-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "a_nvp23 must be a multiple of 0.05 m/s2."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:a_nvp23 ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

ss026-sh:NVKItem-v_nvkvint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "v_nvkvint must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_nvkvint ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

ss026-sh:NVKItem-m_nvkvint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "m_nvkvint must be a multiple of 0.02."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvkvint ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.02) * 0.02)) > 0.000000001 )
            }
        """ ;
    .

ss026-sh:NVKItem-m_nvkvint_2-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "m_nvkvint_2 must be a multiple of 0.02."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvkvint_2 ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.02) * 0.02)) > 0.000000001 )
            }
        """ ;
    .

### NVK ###############################################################
ss026-sh:NVKShape
    a sh:NodeShape ;
    sh:targetClass era:NVK ;
    sh:name "NVK" ;
    sh:description "Defines the integrated correction factors Kv, Kr, and Kt used for speed- and train length-dependent braking performance adjustments. It aggregates multiple correction factor sets, including train length steps, speed-dependent correction factors, and their associated validation parameters, as part of the National Values." ;
    sh:sparql ss026-sh:NVK-m_nvkrint-multipleOf ;
    sh:sparql ss026-sh:NVK-m_nvktint-multipleOf ;
    sh:property ss026-sh:NVK-nvkItems ;
    sh:property ss026-sh:NVK-l_nvkrint ;
    sh:property ss026-sh:NVK-m_nvkrint ;
    sh:property ss026-sh:NVK-correctionFactors ;
    sh:property ss026-sh:NVK-m_nvktint ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVK-nvkItems
    a sh:PropertyShape ;
    sh:path era:nvkItems ;
    sh:name "nvkItems" ;
    sh:description "q_nvkvintset and other variables follows" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:NVKItemShape ;
    sh:message "nvkItems must be a well-formed NVKItem (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 32 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVK-l_nvkrint
    a sh:PropertyShape ;
    sh:path era:l_nvkrint ;
    sh:name "l_nvkrint" ;
    sh:description "Train length step used to define the integrated correction factor Kr. This variable is part of the National Values." ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 2700 ;
    sh:in ( "0"^^xsd:unsignedInt "25"^^xsd:unsignedInt "50"^^xsd:unsignedInt "75"^^xsd:unsignedInt "100"^^xsd:unsignedInt "150"^^xsd:unsignedInt "200"^^xsd:unsignedInt "300"^^xsd:unsignedInt "400"^^xsd:unsignedInt "500"^^xsd:unsignedInt "600"^^xsd:unsignedInt "700"^^xsd:unsignedInt "800"^^xsd:unsignedInt "900"^^xsd:unsignedInt "1000"^^xsd:unsignedInt "1100"^^xsd:unsignedInt "1200"^^xsd:unsignedInt "1300"^^xsd:unsignedInt "1400"^^xsd:unsignedInt "1500"^^xsd:unsignedInt "1600"^^xsd:unsignedInt "1700"^^xsd:unsignedInt "1800"^^xsd:unsignedInt "1900"^^xsd:unsignedInt "2000"^^xsd:unsignedInt "2100"^^xsd:unsignedInt "2200"^^xsd:unsignedInt "2300"^^xsd:unsignedInt "2400"^^xsd:unsignedInt "2500"^^xsd:unsignedInt "2600"^^xsd:unsignedInt "2700"^^xsd:unsignedInt ) ;
    sh:message "l_nvkrint must be one of 0, 25, 50, 75, 100, 150, 200, 300, then 400 to 2700 in steps of 100 m."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVK-m_nvkrint
    a sh:PropertyShape ;
    sh:path era:m_nvkrint ;
    sh:name "m_nvkrint" ;
    sh:description "Integrated correction factor Kr. This is the train length dependent integrated correction factor. M_NVKRINT(l) is valid for a train length between L_NVKRINT(l) and L_NVKRINT(l+1). M_NVKRINT is valid between 0m and L_NVKRINT(1)This variable is part of the National Values." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 1.55 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVK-correctionFactors
    a sh:PropertyShape ;
    sh:path era:correctionFactors ;
    sh:name "correctionFactors" ;
    sh:description "integration correction factors" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:CorrectionFactorShape ;
    sh:message "correctionFactors must be a well-formed CorrectionFactor (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVK-m_nvktint
    a sh:PropertyShape ;
    sh:path era:m_nvktint ;
    sh:name "m_nvktint" ;
    sh:description "Integrated correction factor Kt." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.00 ;
    sh:maxInclusive 1.55 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:NVK-m_nvkrint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "m_nvkrint must be a multiple of 0.05."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvkrint ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

ss026-sh:NVK-m_nvktint-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "m_nvktint must be a multiple of 0.05."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvktint ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

