ss026-sh:ETCSTrackToTrainRM_4-t_train
    a sh:PropertyShape ;
    sh:path era:t_train ;
    sh:name "t_train" ;
    sh:description "Time stamp of the Supervised Manoeuvre request. Resolution is 10 ms" ;
    sh:order 1 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -2 (stored value x 10^-2 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_4-q_scale
    a sh:PropertyShape ;
    sh:path era:q_scale ;
    sh:name "q_scale" ;
    sh:description "An indicator specifying the uniform scale applied to describe distances within the packet containing Q_SCALE" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 2 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_4-d_ref
    a sh:PropertyShape ;
    sh:path era:d_ref ;
    sh:name "d_ref" ;
    sh:description "Distance between the LRBG and the new shifted location reference. The positive values are in the nominal direction of the LRBG. Note that the negative value are coded in 2’s complement" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:int ;
    sh:minInclusive -327680 ;
    sh:maxInclusive 327670 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_4-v_sm
    a sh:PropertyShape ;
    sh:path era:v_sm ;
    sh:name "v_sm" ;
    sh:description "Supervised Manoeuvre mode speed limit. Resolution is 5 km/h" ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_4-trackToTrainPacket_15
    a sh:PropertyShape ;
    sh:path era:trackToTrainPacket_15 ;
    sh:name "trackToTrainPacket_15" ;
    sh:description "Level 2 Movement Authority" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
