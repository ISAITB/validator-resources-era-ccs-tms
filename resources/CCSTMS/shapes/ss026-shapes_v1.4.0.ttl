ss026-sh:ETCSTrackToTrainPacket_3-a_nvmaxredadh1
    a sh:PropertyShape ;
    sh:path era:a_nvmaxredadh1 ;
    sh:name "a_nvmaxredadh1" ;
    sh:description "Maximumdeceleration under reduced adhesion conditions (1) (Maximum deceleration under reduced adhesion conditions applicable for trains: With brake position (Passenger train in P) and with special/additional brakes independent from wheel/rail adhesion. This variable is part of the National Values.)" ;
