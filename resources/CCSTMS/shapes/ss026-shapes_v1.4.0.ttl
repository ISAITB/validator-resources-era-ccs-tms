    .

### ETCSTrackToTrainPacket_21 #########################################
ss026-sh:ETCSTrackToTrainPacket_21Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_21 ;
    sh:name "ETCSTrackToTrainPacket_21" ;
    sh:description "Gradient Profile. Transmission of the gradient" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_21-hasTransmittedGradient ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_21-hasTransmittedGradient
    a sh:PropertyShape ;
    sh:path era:hasTransmittedGradient ;
    sh:name "hasTransmittedGradient" ;
    sh:description "referes to the transmitted gradients" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:TransmittedGradientShape ;
    sh:message "hasTransmittedGradient must be a well-formed TransmittedGradient (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 32 ;
    sh:severity sh:Violation ;
    .

### TransmittedSpecificStaticSpeed ####################################
ss026-sh:TransmittedSpecificStaticSpeedShape
    a sh:NodeShape ;
    sh:targetClass era:TransmittedSpecificStaticSpeed ;
    sh:name "TransmittedSpecificStaticSpeed" ;
    sh:description "Defines a single specific static speed restriction transmitted as part of the Static Speed Profile (SSP). It specifies conditions under which a different static line speed applies to certain train categories or cant deficiency classes." ;
    sh:sparql ss026-sh:TransmittedSpecificStaticSpeed-v_diff-multipleOf ;
    sh:property ss026-sh:TransmittedSpecificStaticSpeed-q_diff ;
    sh:property ss026-sh:TransmittedSpecificStaticSpeed-nc_cddiff ;
    sh:property ss026-sh:TransmittedSpecificStaticSpeed-nc_diff ;
    sh:property ss026-sh:TransmittedSpecificStaticSpeed-v_diff ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedSpecificStaticSpeed-q_diff
    a sh:PropertyShape ;
    sh:path era:q_diff ;
    sh:name "q_diff" ;
    sh:description "Qualifier for specific SSP categories. In case of 'other specific' SSP, it tells ERTMS/ETCS on-board equipment whether it replaces or not the Cant Deficiency SSP as selected by on-board (ref. 3.11.3.2.3), when the train belongs to an 'other international' train category to which the 'other specific' SSP applies" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 2 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedSpecificStaticSpeed-nc_cddiff
    a sh:PropertyShape ;
    sh:path era:nc_cddiff ;
    sh:name "nc_cddiff" ;
    sh:description "It is the 'Cant Deficiency' SSP category for which a different value for the static line speed exists. Used together with V_DIFF to permit certain trains to go faster or lower than the 'international basic static speed' given by V_STATIC. Note: nc_cddiff only needed If Q_DIFF(n) = 0" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/cant-deficiencies/80> <http://data.europa.eu/949/concepts/cant-deficiencies/100> <http://data.europa.eu/949/concepts/cant-deficiencies/130> <http://data.europa.eu/949/concepts/cant-deficiencies/150> <http://data.europa.eu/949/concepts/cant-deficiencies/165> <http://data.europa.eu/949/concepts/cant-deficiencies/180> <http://data.europa.eu/949/concepts/cant-deficiencies/210> <http://data.europa.eu/949/concepts/cant-deficiencies/225> <http://data.europa.eu/949/concepts/cant-deficiencies/245> <http://data.europa.eu/949/concepts/cant-deficiencies/275> <http://data.europa.eu/949/concepts/cant-deficiencies/300> ) ;
    sh:message "Value must be one of the CCSTMS-scoped CantDeficiencies concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedSpecificStaticSpeed-nc_diff
    a sh:PropertyShape ;
    sh:path era:nc_diff ;
    sh:name "nc_diff" ;
    sh:description "It is the 'other specific' SSP category for which a different value for the static line speed exists. Used together with V_DIFF to permit trains belonging to the corresponding 'other international' train category to go faster or lower than the 'international basic static speed' given by V_STATIC. Value 0 of NC_DIFF corresponds to the LSB of NC_TRAIN, value 14 of NC_DIFF to MSB (15-bit variable) of NC_TRAIN." ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_freightTrainP> <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_freightTrainG> <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_passengerTrain> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OtherSpecificStaticSpeedProfileCategory concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedSpecificStaticSpeed-v_diff
    a sh:PropertyShape ;
    sh:path era:v_diff ;
    sh:name "v_diff" ;
    sh:description "Absolute Positive Speed associated to a train category. Resolution is 5 km/h" ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedSpecificStaticSpeed-v_diff-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "v_diff must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_diff ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

### TransmittedStaticSpeed ############################################
ss026-sh:TransmittedStaticSpeedShape
    a sh:NodeShape ;
    sh:targetClass era:TransmittedStaticSpeed ;
    sh:name "TransmittedStaticSpeed" ;
    sh:description "Static speed profile and optionally speed limits depending on the international train category" ;
    sh:property ss026-sh:TransmittedStaticSpeed-d_static ;
    sh:property ss026-sh:TransmittedStaticSpeed-v_static ;
    sh:property ss026-sh:TransmittedStaticSpeed-q_front ;
    sh:property ss026-sh:TransmittedStaticSpeed-hasTransmittedSpecificStaticSpeed ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedStaticSpeed-d_static
    a sh:PropertyShape ;
    sh:path era:d_static ;
    sh:name "d_static" ;
    sh:description "Incremental distance to next discontinuity in a international SSP profile" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedStaticSpeed-v_static
    a sh:PropertyShape ;
    sh:path era:v_static ;
    sh:name "v_static" ;
    sh:description "Basic static speed profile speed after discontinuity (k). Resolution is 5 km/h" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 127 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedStaticSpeed-q_front
    a sh:PropertyShape ;
    sh:path era:q_front ;
    sh:name "q_front" ;
    sh:description "Qualifier for validity end point of profile element (Qualifier to indicate if a speed limit given for a profile element is to be applied until the front of the train (no train length delay) or the end of the train (train length delay) has left the element)" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedStaticSpeed-hasTransmittedSpecificStaticSpeed
    a sh:PropertyShape ;
    sh:path era:hasTransmittedSpecificStaticSpeed ;
    sh:name "hasTransmittedSpecificStaticSpeed" ;
    sh:description "refers to the transmitted specific static speed profile" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:TransmittedSpecificStaticSpeedShape ;
    sh:message "hasTransmittedSpecificStaticSpeed must be a well-formed TransmittedSpecificStaticSpeed (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_27 #########################################
ss026-sh:ETCSTrackToTrainPacket_27Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_27 ;
    sh:name "ETCSTrackToTrainPacket_27" ;
    sh:description "International Static Speed Profile" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_27-hasTransmittedStaticSpeed ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_27-hasTransmittedStaticSpeed
    a sh:PropertyShape ;
    sh:path era:hasTransmittedStaticSpeed ;
    sh:name "hasTransmittedStaticSpeed" ;
    sh:description "Incremental distance to next discontinuity in a international SSP profile" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:TransmittedStaticSpeedShape ;
    sh:message "hasTransmittedStaticSpeed must be a well-formed TransmittedStaticSpeed (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 32 ;
    sh:severity sh:Violation ;
    .

