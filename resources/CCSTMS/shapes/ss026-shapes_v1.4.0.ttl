        ss026-sh:TrackToTrainPacket-trackToTrainPacket_73-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_74-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_79-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_80-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_88-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_90-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_131-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_132-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_133-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_134-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_135-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_136-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_137-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_138-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_139-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_140-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_141-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_145-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_180-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_181-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_254-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_255-present
    ) ;
    sh:message "TrackToTrainPacket is a union: exactly one of (trackToTrainPacket_0, trackToTrainPacket_2, trackToTrainPacket_3, trackToTrainPacket_5, trackToTrainPacket_6, trackToTrainPacket_15, trackToTrainPacket_16, trackToTrainPacket_21, trackToTrainPacket_27, trackToTrainPacket_31, trackToTrainPacket_32, trackToTrainPacket_39, trackToTrainPacket_40, trackToTrainPacket_41, trackToTrainPacket_42, trackToTrainPacket_44, trackToTrainPacket_45, trackToTrainPacket_46, trackToTrainPacket_49, trackToTrainPacket_51, trackToTrainPacket_52, trackToTrainPacket_57, trackToTrainPacket_58, trackToTrainPacket_63, trackToTrainPacket_64, trackToTrainPacket_65, trackToTrainPacket_66, trackToTrainPacket_67, trackToTrainPacket_68, trackToTrainPacket_69, trackToTrainPacket_70, trackToTrainPacket_71, trackToTrainPacket_73, trackToTrainPacket_74, trackToTrainPacket_79, trackToTrainPacket_80, trackToTrainPacket_88, trackToTrainPacket_90, trackToTrainPacket_131, trackToTrainPacket_132, trackToTrainPacket_133, trackToTrainPacket_134, trackToTrainPacket_135, trackToTrainPacket_136, trackToTrainPacket_137, trackToTrainPacket_138, trackToTrainPacket_139, trackToTrainPacket_140, trackToTrainPacket_141, trackToTrainPacket_145, trackToTrainPacket_180, trackToTrainPacket_181, trackToTrainPacket_254, trackToTrainPacket_255) must be present."@en ;
