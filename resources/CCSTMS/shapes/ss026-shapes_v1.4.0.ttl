    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_49 #########################################
ss026-sh:ETCSTrackToTrainPacket_49Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_49 ;
    sh:name "ETCSTrackToTrainPacket_49" ;
    sh:description "List of balises for SH Area (Used to list balise group(s) which the train can pass over in SH mode)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_49-hasCountryBalise ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_49-hasCountryBalise
    a sh:PropertyShape ;
    sh:path era:hasCountryBalise ;
    sh:name "hasCountryBalise" ;
    sh:description "List of the additional country balises for Shunting Area or SR Authority" ;
