    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_69-trackCondPlatformSelection
    a sh:PropertyShape ;
    sh:path era:trackCondPlatformSelection ;
    sh:name "trackCondPlatformSelection" ;
    sh:description "List the conditions related to track characteristics and platform parameters" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:TCSPConditionShape ;
    sh:message "trackCondPlatformSelection must be a well-formed TCSPCondition (blank node or IRI)."@en ;
