### ETCSTrackToTrainRM_2 ##############################################
ss026-sh:ETCSTrackToTrainRM_2Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainRM_2 ;
    sh:name "ETCSTrackToTrainRM_2" ;
    sh:description "SR Authorisation" ;
    sh:property ss026-sh:ETCSTrackToTrainRM_2-q_scale ;
    sh:property ss026-sh:ETCSTrackToTrainRM_2-d_sr ;
    sh:property ss026-sh:ETCSTrackToTrainRM_2-trackToTrainPacket_63 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_2-q_scale
    a sh:PropertyShape ;
    sh:path era:q_scale ;
    sh:name "q_scale" ;
    sh:description "An indicator specifying the uniform scale applied to describe distances within the packet containing Q_SCALE" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 2 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_2-d_sr
    a sh:PropertyShape ;
    sh:path era:d_sr ;
    sh:name "d_sr" ;
    sh:description "Distance that can be run in SR mode" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_2-trackToTrainPacket_63
    a sh:PropertyShape ;
    sh:path era:trackToTrainPacket_63 ;
    sh:name "trackToTrainPacket_63" ;
    sh:description "List of Balise Groups in SR Authority" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:ETCSTrackToTrainPacket_63Shape ;
    sh:message "trackToTrainPacket_63 must be a well-formed ETCSTrackToTrainPacket_63 (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

