    .

### DLMCondition ######################################################
ss026-sh:DLMConditionShape
    a sh:NodeShape ;
    sh:targetClass era:DLMCondition ;
    sh:name "DLMCondition" ;
    sh:description "Defines the track conditions, specifying the distance to track condition changes, the validity length of the condition, and the type of track condition to ensure safe and efficient train movement." ;
    sh:property ss026-sh:DLMCondition-d_trackcond ;
    sh:property ss026-sh:DLMCondition-l_trackcond ;
    sh:property ss026-sh:DLMCondition-m_trackcond ;
    sh:severity sh:Violation ;
    .

ss026-sh:DLMCondition-d_trackcond
    a sh:PropertyShape ;
    sh:path era:d_trackcond ;
    sh:name "d_trackcond" ;
    sh:description "Track condition distance (The incremental distance to where the track conditions change. Comment : Only if Q_TRACKINIT = 0, D_TRACKCOND and the following variables follow)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:DLMCondition-l_trackcond
    a sh:PropertyShape ;
    sh:path era:l_trackcond ;
    sh:name "l_trackcond" ;
    sh:description "Length for which the defined track condition is valid." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:DLMCondition-m_trackcond
    a sh:PropertyShape ;
    sh:path era:m_trackcond ;
    sh:name "m_trackcond" ;
    sh:description "Type of track condition" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-a> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-b> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-e> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-h> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-c> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-g> <http://data.europa.eu/949/concepts/transmitted-tcs/bigMetalMasses> <http://data.europa.eu/949/concepts/transmitted-tcs/5-8-12-d> <http://data.europa.eu/949/concepts/transmitted-tcs/switchOffRegenerativeBrake> <http://data.europa.eu/949/concepts/transmitted-tcs/switchOffEddyCurrentBrakeForServiceBrake> <http://data.europa.eu/949/concepts/transmitted-tcs/switchOffEddyCurrentBrakeForEmergencyBrake> <http://data.europa.eu/949/concepts/transmitted-tcs/switchOffMagneticShoeBrake> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TransmittedTrackConditions concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

