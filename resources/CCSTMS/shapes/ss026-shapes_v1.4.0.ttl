    sh:property ss026-sh:ETCSTrackToTrainPacket_133-q_riu ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_133-nid_c ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_133-nid_riu ;
