    .

### TransmittedGradient ###############################################
ss026-sh:TransmittedGradientShape
    a sh:NodeShape ;
    sh:targetClass era:TransmittedGradient ;
    sh:name "TransmittedGradient" ;
    sh:description "Parameters of the transmitted gradients through the Balise or RBC" ;
    sh:property ss026-sh:TransmittedGradient-d_gradient ;
    sh:property ss026-sh:TransmittedGradient-q_gdir ;
    sh:property ss026-sh:TransmittedGradient-g_a ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedGradient-d_gradient
    a sh:PropertyShape ;
    sh:path era:d_gradient ;
    sh:name "d_gradient" ;
    sh:description "Incremental distance to next change of gradient" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TransmittedGradient-q_gdir
    a sh:PropertyShape ;
    sh:path era:q_gdir ;
    sh:name "q_gdir" ;
    sh:description "Qualifier for gradient slope. Note: 0 = downhill, 1 = uphill" ;
