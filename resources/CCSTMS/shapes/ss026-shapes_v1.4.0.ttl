### ETCSTrainToTrackPacket_44 #########################################
ss026-sh:ETCSTrainToTrackPacket_44Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackPacket_44 ;
    sh:name "ETCSTrainToTrackPacket_44" ;
    sh:description "Data used by applications outside the ERTMS/ETCS system. Messages between on-board and trackside devices, which contain information used by applications outside the ERTMS/ETCS system." ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_44-nid_xuser ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_44-otherData ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_44-nid_xuser
    a sh:PropertyShape ;
    sh:path era:nid_xuser ;
    sh:name "nid_xuser" ;
    sh:description "Identity of user system (Identity of user system for which remainder of packet is intended)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 511 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_44-otherData
    a sh:PropertyShape ;
    sh:path era:otherData ;
    sh:name "otherData" ;
    sh:description "Other data, depending on the Identity of user system - NID_XUSER" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:base64Binary ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainRM ################################################
ss026-sh:ETCSTrackToTrainRMShape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainRM ;
    sh:name "ETCSTrackToTrainRM" ;
    sh:description "Defines the structure of an ETCS Track-to-Train radio message, including the standard message header and the payload containing the encoded TrackToTrain message content." ;
    sh:property ss026-sh:ETCSTrackToTrainRM-msgId ;
    sh:property ss026-sh:ETCSTrackToTrainRM-l_message ;
    sh:property ss026-sh:ETCSTrackToTrainRM-t_train ;
    sh:property ss026-sh:ETCSTrackToTrainRM-m_ack ;
    sh:property ss026-sh:ETCSTrackToTrainRM-nid_lrbg ;
    sh:property ss026-sh:ETCSTrackToTrainRM-trackToTrainRM ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM-msgId
    a sh:PropertyShape ;
    sh:path era:msgId ;
    sh:name "msgId" ;
    sh:description "Message identifier with respect to the defined values of NID_MESSAGE, refer to chapters 8.5.2 and 8.5.3" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM-l_message
    a sh:PropertyShape ;
    sh:path era:l_message ;
    sh:name "l_message" ;
    sh:description "L_MESSAGE indicates the length of the message in bytes, including all packets and all variables defined in the message header (NID_MESSAGE and L_MESSAGE also)." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM-t_train
    a sh:PropertyShape ;
    sh:path era:t_train ;
    sh:name "t_train" ;
    sh:description "Time, according to trainborne clock, at which message is sent. Resolution is 10 ms" ;
    sh:order 3 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -2 (stored value x 10^-2 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM-m_ack
    a sh:PropertyShape ;
    sh:path era:m_ack ;
    sh:name "m_ack" ;
    sh:description "A qualifier for acknowledgement request that iIndicates whether the message must be acknowledged or not. False - No acknowledgement required; True - Acknowledgement required" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM-nid_lrbg
    a sh:PropertyShape ;
    sh:path era:nid_lrbg ;
    sh:name "nid_lrbg" ;
    sh:description "Country/region identity (NID_C 10 bits) + balise identity number of last relevant balise group (NID_BG 14 bits)." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16777215 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM-trackToTrainRM
    a sh:PropertyShape ;
    sh:path era:trackToTrainRM ;
    sh:name "trackToTrainRM" ;
    sh:description "Defines the payload containing the encoded Track-to-Train radio message content." ;
    sh:order 6 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:TrackToTrainRMShape ;
    sh:message "trackToTrainRM must be a well-formed TrackToTrainRM (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### TrackToTrainRM ####################################################
ss026-sh:TrackToTrainRMShape
    a sh:NodeShape ;
    sh:targetClass era:TrackToTrainRM ;
    sh:name "TrackToTrainRM" ;
    sh:description "multiple variables of track-to-train radio messages grouped into a single unit, with a defined internal structure" ;
    sh:xone (
        ss026-sh:TrackToTrainRM-trackToTrainRM_2-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_3-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_4-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_5-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_6-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_7-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_8-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_9-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_15-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_16-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_18-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_24-present
