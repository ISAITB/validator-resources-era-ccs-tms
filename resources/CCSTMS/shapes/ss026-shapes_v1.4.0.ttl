### ETCSTrackToTrainPacket_133 ########################################
ss026-sh:ETCSTrackToTrainPacket_133Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_133 ;
    sh:name "ETCSTrackToTrainPacket_133" ;
