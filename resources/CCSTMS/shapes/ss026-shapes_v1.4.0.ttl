ss026-sh:ETCSTrackToTrainPacket_3-v_nvunfit-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "v_nvunfit must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
