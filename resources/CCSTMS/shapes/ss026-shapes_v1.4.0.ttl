    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_4-trackToTrainPacket_21
    a sh:PropertyShape ;
    sh:path era:trackToTrainPacket_21 ;
    sh:name "trackToTrainPacket_21" ;
    sh:description "refers to transmission of the gradient" ;
    sh:order 6 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:ETCSTrackToTrainPacket_21Shape ;
    sh:message "trackToTrainPacket_21 must be a well-formed ETCSTrackToTrainPacket_21 (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_4-trackToTrainPacket_27
    a sh:PropertyShape ;
    sh:path era:trackToTrainPacket_27 ;
    sh:name "trackToTrainPacket_27" ;
    sh:description "refers to international Static Speed Profile" ;
    sh:order 7 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:ETCSTrackToTrainPacket_27Shape ;
    sh:message "trackToTrainPacket_27 must be a well-formed ETCSTrackToTrainPacket_27 (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_4-hasOptionalTrackToTrainPackets
    a sh:PropertyShape ;
    sh:path era:hasOptionalTrackToTrainPackets ;
    sh:name "hasOptionalTrackToTrainPackets" ;
    sh:description "refers to the option track-to-train packets. See Subset026-8, CH 8.4.4" ;
    sh:order 8 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:ETCSTrackToTrainPacketShape ;
    sh:message "hasOptionalTrackToTrainPackets must be a well-formed ETCSTrackToTrainPacket (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainRM_4-v_sm-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "v_sm must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_sm ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

