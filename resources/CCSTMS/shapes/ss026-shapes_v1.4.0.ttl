### ETCSTrackToTrainPacket_39 #########################################
ss026-sh:ETCSTrackToTrainPacket_39Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_39 ;
    sh:name "ETCSTrackToTrainPacket_39" ;
    sh:description "Track Condition Change of traction system (The packet gives information about change of the traction system)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_39-d_traction ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_39-m_voltage ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_39-nid_ctraction ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_39-d_traction
    a sh:PropertyShape ;
    sh:path era:d_traction ;
    sh:name "d_traction" ;
    sh:description "Distance to change of traction" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_39-m_voltage
    a sh:PropertyShape ;
    sh:path era:m_voltage ;
    sh:name "m_voltage" ;
    sh:description "Special/Reserved values for Traction System voltage. It indicates the voltage of the traction system installed on a specific line or respectively that can be used by an engine. The identity of the traction system is given by M_VOLTAGE and, if M_VOLTAGE ≠ 0, by the country identifier of the traction system (NID_CTRACTION). Note that values from 6 to 15 are currently unassigned" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/energy-supply-systems/notFitted> <http://data.europa.eu/949/concepts/energy-supply-systems/AC10> <http://data.europa.eu/949/concepts/energy-supply-systems/AC20> <http://data.europa.eu/949/concepts/energy-supply-systems/DC30> <http://data.europa.eu/949/concepts/energy-supply-systems/DC40> <http://data.europa.eu/949/concepts/energy-supply-systems/DC80> <http://data.europa.eu/949/concepts/energy-supply-systems/DC70> <http://data.europa.eu/949/concepts/energy-supply-systems/DC60> <http://data.europa.eu/949/concepts/energy-supply-systems/DC90> ) ;
    sh:message "Value must be one of the CCSTMS-scoped EnergySupplySystems concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_39-nid_ctraction
    a sh:PropertyShape ;
    sh:path era:nid_ctraction ;
    sh:name "nid_ctraction" ;
    sh:description "Country identifier of the traction system. It identifies the information, additional to M_VOLTAGE, required to fully define the traction system. Note that NID_CTRACTION given only if M_VOLTAGE ≠ 0" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_40 #########################################
ss026-sh:ETCSTrackToTrainPacket_40Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_40 ;
    sh:name "ETCSTrackToTrainPacket_40" ;
    sh:description "Track Condition Change of allowed current consumption (The packet gives information about change of the allowed current consumption)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_40-d_current ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_40-m_current ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_40-d_current
    a sh:PropertyShape ;
    sh:path era:d_current ;
    sh:name "d_current" ;
    sh:description "Distance to change of allowed current consumption" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_40-m_current
    a sh:PropertyShape ;
    sh:path era:m_current ;
    sh:name "m_current" ;
    sh:description "Allowed current consumption (It defines the allowed current consumption to be used by the train), Resolution is 10 A." ;
    sh:order 2 ;
    qudt:hasUnit unit:A ;
    rdfs:comment "scaling exponent 1 (stored value x 10^1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### LevelTransitionWithAck ############################################
ss026-sh:LevelTransitionWithAckShape
    a sh:NodeShape ;
    sh:targetClass era:LevelTransitionWithAck ;
    sh:name "LevelTransitionWithAck" ;
    sh:description "Defines the parameters for level transitions requiring acknowledgment in ETCS operations. This includes the target ETCS level, the associated national system identity, and the length of the acknowledgment area required for a safe transition." ;
    sh:property ss026-sh:LevelTransitionWithAck-m_leveltr ;
    sh:property ss026-sh:LevelTransitionWithAck-nid_ntc ;
    sh:property ss026-sh:LevelTransitionWithAck-l_ackleveltr ;
    sh:severity sh:Violation ;
    .

ss026-sh:LevelTransitionWithAck-m_leveltr
    a sh:PropertyShape ;
    sh:path era:m_leveltr ;
    sh:name "m_leveltr" ;
    sh:description "Required level" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-levels/50> <http://data.europa.eu/949/concepts/etcs-levels/60> <http://data.europa.eu/949/concepts/etcs-levels/20> <http://data.europa.eu/949/concepts/etcs-levels/30> <http://data.europa.eu/949/concepts/etcs-levels/80> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSLevels concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:LevelTransitionWithAck-nid_ntc
    a sh:PropertyShape ;
    sh:path era:nid_ntc ;
    sh:name "nid_ntc" ;
    sh:description "National System identity (Each value of this variable represents the identity of a National System)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:LevelTransitionWithAck-l_ackleveltr
    a sh:PropertyShape ;
    sh:path era:l_ackleveltr ;
    sh:name "l_ackleveltr" ;
    sh:description "Length of the acknowledgement area in rear of the required level." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

