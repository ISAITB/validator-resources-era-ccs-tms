### ETCSTrainToTrackPacket_0 ##########################################
ss026-sh:ETCSTrainToTrackPacket_0Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackPacket_0 ;
    sh:name "ETCSTrainToTrackPacket_0" ;
    sh:description "Position Report.This packet is used to report the train position and speed as well as some additional information (e.g. mode, level, etc.)" ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-nid_lrbg ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-d_lrbg ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-q_dirlrbg ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-q_dlrbg ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-l_doubtover ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-l_doubtunder ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-q_integrity ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-l_trainint ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-vTrain ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-q_dirtrain ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-m_mode ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-m_level ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_0-nid_ntc ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-nid_lrbg
    a sh:PropertyShape ;
    sh:path era:nid_lrbg ;
    sh:name "nid_lrbg" ;
    sh:description "Country/region identity (NID_C 10 bits) + balise identity number of last relevant balise group (NID_BG 14 bits)." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16777215 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-d_lrbg
    a sh:PropertyShape ;
    sh:path era:d_lrbg ;
    sh:name "d_lrbg" ;
    sh:description "Distance between the last relevant balise group and the estimated front end of the train (the side of the active cab)." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-q_dirlrbg
    a sh:PropertyShape ;
    sh:path era:q_dirlrbg ;
    sh:name "q_dirlrbg" ;
    sh:description "Orientation of the train in relation to the direction of the LRBG" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/running-direction/reverse> <http://data.europa.eu/949/concepts/running-direction/nominal> <http://data.europa.eu/949/concepts/running-direction/unknown> ) ;
    sh:message "Value must be one of the CCSTMS-scoped RunningDirection concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-q_dlrbg
    a sh:PropertyShape ;
    sh:path era:q_dlrbg ;
    sh:name "q_dlrbg" ;
    sh:description "Qualifier telling on which side of the LRBG the estimated front end is" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/running-direction/reverse> <http://data.europa.eu/949/concepts/running-direction/nominal> <http://data.europa.eu/949/concepts/running-direction/unknown> ) ;
    sh:message "Value must be one of the CCSTMS-scoped RunningDirection concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-l_doubtover
    a sh:PropertyShape ;
    sh:path era:l_doubtover ;
    sh:name "l_doubtover" ;
    sh:description "L_DOUBTOVER is the over-reading amount plus the Q_LOCACC (location accuracy) of the LRBG" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-l_doubtunder
    a sh:PropertyShape ;
    sh:path era:l_doubtunder ;
    sh:name "l_doubtunder" ;
    sh:description "L_DOUBTUNDER is the under-reading amount plus the Q_LOCACC (location accuracy) of the LRBG" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-q_integrity
    a sh:PropertyShape ;
    sh:path era:q_integrity ;
    sh:name "q_integrity" ;
    sh:description "Qualifier for train integrity status. It identifies the train integrity informaiton available. The releated safe train length information is given by l_trainint" ;
    sh:order 7 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-integrity-type/noInfoAvailable> <http://data.europa.eu/949/concepts/train-integrity-type/byMonitoringDevice> <http://data.europa.eu/949/concepts/train-integrity-type/byDriver> <http://data.europa.eu/949/concepts/train-integrity-type/lost> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TrainIntegrityType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-l_trainint
    a sh:PropertyShape ;
    sh:path era:l_trainint ;
    sh:name "l_trainint" ;
    sh:description "Safe train length.Information sent to the RBC allowing the trackside to retrieve what was the position of the min safe rear end of the train at the time the train was last known to be integer. It is counted from the estimated position of the train front reported to the RBC. Only If Q_INTEGRITY = 'Train integrity confirmed by external source' or 'Train integrity confirmed by driver'. In binary protocols use 0 as not_available" ;
    sh:order 8 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-vTrain
    a sh:PropertyShape ;
    sh:path era:vTrain ;
    sh:name "vTrain" ;
    sh:description "Train speed with a resolution of 5km/h" ;
    sh:order 9 ;
    rdfs:comment "ERTMS subset variable: V_TRAIN"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 127 ;
    sh:not [ sh:minInclusive 121 ; sh:maxInclusive 126 ] ;
    sh:message "Values 121 to 126 are spare/invalid for vTrain and must not be used."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-q_dirtrain
    a sh:PropertyShape ;
    sh:path era:q_dirtrain ;
    sh:name "q_dirtrain" ;
    sh:description "Direction of train movement in relation to the LRBG orientation" ;
    sh:order 10 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/running-direction/reverse> <http://data.europa.eu/949/concepts/running-direction/nominal> <http://data.europa.eu/949/concepts/running-direction/unknown> ) ;
    sh:message "Value must be one of the CCSTMS-scoped RunningDirection concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-m_mode
    a sh:PropertyShape ;
    sh:path era:m_mode ;
    sh:name "m_mode" ;
    sh:description "Onboard operating mode" ;
    sh:order 11 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/onboard-operating-mode/fullSupervision> <http://data.europa.eu/949/concepts/onboard-operating-mode/onSight> <http://data.europa.eu/949/concepts/onboard-operating-mode/staffResponsible> <http://data.europa.eu/949/concepts/onboard-operating-mode/shunting> <http://data.europa.eu/949/concepts/onboard-operating-mode/unfitted> <http://data.europa.eu/949/concepts/onboard-operating-mode/sleeping> <http://data.europa.eu/949/concepts/onboard-operating-mode/standBy> <http://data.europa.eu/949/concepts/onboard-operating-mode/trip> <http://data.europa.eu/949/concepts/onboard-operating-mode/postTrip> <http://data.europa.eu/949/concepts/onboard-operating-mode/systemFailure> <http://data.europa.eu/949/concepts/onboard-operating-mode/isolation> <http://data.europa.eu/949/concepts/onboard-operating-mode/nonLeading> <http://data.europa.eu/949/concepts/onboard-operating-mode/limitedSupervision> <http://data.europa.eu/949/concepts/onboard-operating-mode/nationalSystem> <http://data.europa.eu/949/concepts/onboard-operating-mode/reversing> <http://data.europa.eu/949/concepts/onboard-operating-mode/passiveShunting> <http://data.europa.eu/949/concepts/onboard-operating-mode/automaticDriving> <http://data.europa.eu/949/concepts/onboard-operating-mode/supervisedManoeuvre> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OnboardOperatingMode concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-m_level
    a sh:PropertyShape ;
    sh:path era:m_level ;
    sh:name "m_level" ;
    sh:description "current operating ETCS-level" ;
    sh:order 12 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-levels/50> <http://data.europa.eu/949/concepts/etcs-levels/60> <http://data.europa.eu/949/concepts/etcs-levels/20> <http://data.europa.eu/949/concepts/etcs-levels/30> <http://data.europa.eu/949/concepts/etcs-levels/80> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSLevels concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_0-nid_ntc
    a sh:PropertyShape ;
    sh:path era:nid_ntc ;
    sh:name "nid_ntc" ;
    sh:description "National system identity (Each value of this variable represents the identity of a National System.), If m_level = NTC" ;
    sh:order 13 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrainToTrackPacket_1 ##########################################
ss026-sh:ETCSTrainToTrackPacket_1Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackPacket_1 ;
    sh:name "ETCSTrainToTrackPacket_1" ;
    sh:description "Position Report based on two balise groups. This packet is an extension of the 'standard position report' packet 0. It is used in case of single balise groups if the orientation of the LRBG is unknown but the on-board equipment is able to report a second balise group (the one detected before) to give a direction reference for the directional information in the position report." ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-nid_lrbg ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-nid_prvlrbg ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-d_lrbg ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-q_dirlrbg ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-q_dlrbg ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-l_doubtover ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-l_doubtunder ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-q_integrity ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-l_trainint ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-vTrain ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-q_dirtrain ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-m_mode ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-m_level ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_1-nid_ntc ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-nid_lrbg
    a sh:PropertyShape ;
    sh:path era:nid_lrbg ;
    sh:name "nid_lrbg" ;
    sh:description "Country/region identity (NID_C 10 bits) + balise identity number of last relevant balise group (NID_BG + 14 bits)." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16777215 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-nid_prvlrbg
    a sh:PropertyShape ;
    sh:path era:nid_prvlrbg ;
    sh:name "nid_prvlrbg" ;
    sh:description "Used as reference for all directional information in the packet: a move from PRVLRBG towards the LRBG defines the 'nominal' direction" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16777215 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-d_lrbg
    a sh:PropertyShape ;
    sh:path era:d_lrbg ;
    sh:name "d_lrbg" ;
    sh:description "Distance between the last relevant balise group and the estimated front end of the train (the side of the active cab)." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-q_dirlrbg
    a sh:PropertyShape ;
    sh:path era:q_dirlrbg ;
    sh:name "q_dirlrbg" ;
    sh:description "Orientation of the train in relation to the direction of the LRBG" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/running-direction/reverse> <http://data.europa.eu/949/concepts/running-direction/nominal> <http://data.europa.eu/949/concepts/running-direction/unknown> ) ;
    sh:message "Value must be one of the CCSTMS-scoped RunningDirection concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-q_dlrbg
    a sh:PropertyShape ;
    sh:path era:q_dlrbg ;
    sh:name "q_dlrbg" ;
    sh:description "Qualifier telling on which side of the LRBG the estimated front end is" ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/running-direction/reverse> <http://data.europa.eu/949/concepts/running-direction/nominal> <http://data.europa.eu/949/concepts/running-direction/unknown> ) ;
    sh:message "Value must be one of the CCSTMS-scoped RunningDirection concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-l_doubtover
    a sh:PropertyShape ;
    sh:path era:l_doubtover ;
    sh:name "l_doubtover" ;
    sh:description "L_DOUBTOVER is the over-reading amount plus the Q_LOCACC (location accuracy) of the LRBG" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-l_doubtunder
    a sh:PropertyShape ;
    sh:path era:l_doubtunder ;
    sh:name "l_doubtunder" ;
    sh:description "L_DOUBTUNDER is the under-reading amount plus the Q_LOCACC (location accuracy) of the LRBG" ;
    sh:order 7 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-q_integrity
    a sh:PropertyShape ;
    sh:path era:q_integrity ;
    sh:name "q_integrity" ;
    sh:description "Qualifier for train integrity status. It identifies the train integrity informaiton available. The releated safe train length information is given by l_trainint" ;
    sh:order 8 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-integrity-type/noInfoAvailable> <http://data.europa.eu/949/concepts/train-integrity-type/byMonitoringDevice> <http://data.europa.eu/949/concepts/train-integrity-type/byDriver> <http://data.europa.eu/949/concepts/train-integrity-type/lost> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TrainIntegrityType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-l_trainint
    a sh:PropertyShape ;
    sh:path era:l_trainint ;
    sh:name "l_trainint" ;
    sh:description "Safe train length.Information sent to the RBC allowing the trackside to retrieve what was the position of the min safe rear end of the train at the time the train was last known to be integer. It is counted from the estimated position of the train front reported to the RBC. Only If Q_INTEGRITY = 'Train integrity confirmed by external source' or 'Train integrity confirmed by driver'. In binary protocols use 0 as not_available" ;
    sh:order 9 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-vTrain
    a sh:PropertyShape ;
    sh:path era:vTrain ;
    sh:name "vTrain" ;
    sh:description "Train speed with a resolution of 5km/h" ;
    sh:order 10 ;
    rdfs:comment "ERTMS subset variable: V_TRAIN"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 127 ;
    sh:not [ sh:minInclusive 121 ; sh:maxInclusive 126 ] ;
    sh:message "Values 121 to 126 are spare/invalid for vTrain and must not be used."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-q_dirtrain
    a sh:PropertyShape ;
    sh:path era:q_dirtrain ;
    sh:name "q_dirtrain" ;
    sh:description "Direction of train movement in relation to the LRBG orientation" ;
    sh:order 11 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/running-direction/reverse> <http://data.europa.eu/949/concepts/running-direction/nominal> <http://data.europa.eu/949/concepts/running-direction/unknown> ) ;
    sh:message "Value must be one of the CCSTMS-scoped RunningDirection concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-m_mode
    a sh:PropertyShape ;
    sh:path era:m_mode ;
    sh:name "m_mode" ;
    sh:description "Onboard operating mode" ;
    sh:order 12 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/onboard-operating-mode/fullSupervision> <http://data.europa.eu/949/concepts/onboard-operating-mode/onSight> <http://data.europa.eu/949/concepts/onboard-operating-mode/staffResponsible> <http://data.europa.eu/949/concepts/onboard-operating-mode/shunting> <http://data.europa.eu/949/concepts/onboard-operating-mode/unfitted> <http://data.europa.eu/949/concepts/onboard-operating-mode/sleeping> <http://data.europa.eu/949/concepts/onboard-operating-mode/standBy> <http://data.europa.eu/949/concepts/onboard-operating-mode/trip> <http://data.europa.eu/949/concepts/onboard-operating-mode/postTrip> <http://data.europa.eu/949/concepts/onboard-operating-mode/systemFailure> <http://data.europa.eu/949/concepts/onboard-operating-mode/isolation> <http://data.europa.eu/949/concepts/onboard-operating-mode/nonLeading> <http://data.europa.eu/949/concepts/onboard-operating-mode/limitedSupervision> <http://data.europa.eu/949/concepts/onboard-operating-mode/nationalSystem> <http://data.europa.eu/949/concepts/onboard-operating-mode/reversing> <http://data.europa.eu/949/concepts/onboard-operating-mode/passiveShunting> <http://data.europa.eu/949/concepts/onboard-operating-mode/automaticDriving> <http://data.europa.eu/949/concepts/onboard-operating-mode/supervisedManoeuvre> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OnboardOperatingMode concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-m_level
    a sh:PropertyShape ;
    sh:path era:m_level ;
    sh:name "m_level" ;
    sh:description "current operating ETCS-level" ;
    sh:order 13 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-levels/50> <http://data.europa.eu/949/concepts/etcs-levels/60> <http://data.europa.eu/949/concepts/etcs-levels/20> <http://data.europa.eu/949/concepts/etcs-levels/30> <http://data.europa.eu/949/concepts/etcs-levels/80> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSLevels concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_1-nid_ntc
    a sh:PropertyShape ;
    sh:path era:nid_ntc ;
    sh:name "nid_ntc" ;
    sh:description "National system identity (Each value of this variable represents the identity of a National System.), If m_level = NTC" ;
    sh:order 14 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### SystemVersion #####################################################
ss026-sh:SystemVersionShape
    a sh:NodeShape ;
    sh:targetClass era:SystemVersion ;
    sh:name "SystemVersion" ;
    sh:description "System versions that the on-board equipment is able to operate." ;
    sh:property ss026-sh:SystemVersion-etcsMVersion ;
    sh:severity sh:Violation ;
    .

ss026-sh:SystemVersion-etcsMVersion
    a sh:PropertyShape ;
    sh:path era:etcsMVersion ;
    sh:name "etcsMVersion" ;
    sh:description "This gives the version of the ETCS system. Each part indicates the first and second number of the version respectively: The first number distinguishes not compatible versions (The three MSBs)_ The second number indicates compatibility within a version X. (The four LSBs)" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-m-versions/10> <http://data.europa.eu/949/concepts/etcs-m-versions/11> <http://data.europa.eu/949/concepts/etcs-m-versions/20> <http://data.europa.eu/949/concepts/etcs-m-versions/21> <http://data.europa.eu/949/concepts/etcs-m-versions/22> <http://data.europa.eu/949/concepts/etcs-m-versions/23> <http://data.europa.eu/949/concepts/etcs-m-versions/30> <http://data.europa.eu/949/concepts/etcs-m-versions/00> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSMVersions concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrainToTrackPacket_2 ##########################################
ss026-sh:ETCSTrainToTrackPacket_2Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackPacket_2 ;
    sh:name "ETCSTrainToTrackPacket_2" ;
    sh:description "Onboard supported system versions." ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_2-hasSystemVersion ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_2-hasSystemVersion
    a sh:PropertyShape ;
    sh:path era:hasSystemVersion ;
    sh:name "hasSystemVersion" ;
    sh:description "supported system versions" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:SystemVersionShape ;
    sh:message "hasSystemVersion must be a well-formed SystemVersion (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 32 ;
    sh:severity sh:Violation ;
    .

### ETCSTrainToTrackPacket_4 ##########################################
ss026-sh:ETCSTrainToTrackPacket_4Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackPacket_4 ;
    sh:name "ETCSTrainToTrackPacket_4" ;
    sh:description "Error reporting to the RBC." ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_4-m_error ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_4-m_error
    a sh:PropertyShape ;
    sh:path era:m_error ;
    sh:name "m_error" ;
    sh:description "Identifier of the type of error in accordance with UNISIG Subset 26-7, Chapter 7.5.1.64" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrainToTrackPacket_5 ##########################################
ss026-sh:ETCSTrainToTrackPacket_5Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackPacket_5 ;
    sh:name "ETCSTrainToTrackPacket_5" ;
    sh:description "Train running number" ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_5-nid_operational ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_5-nid_operational
    a sh:PropertyShape ;
    sh:path era:nid_operational ;
    sh:name "nid_operational" ;
    sh:description "This is the operational train running number. The NID_OPERATIONAL consists of up to 8 digits which are entered left adjusted into the data field, the leftmost digit is the digit to be entered first. In case the NID_OPERATIONAL is shorter than 8 digits, the remaining space is to be filled with special character 'F' in the binary representation as uint32." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]{8}$" ;
    sh:message "nid_operational is Binary Coded Decimal: exactly 8 decimal digits (0-9), no other characters."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrainToTrackPacket_9 ##########################################
ss026-sh:ETCSTrainToTrackPacket_9Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackPacket_9 ;
    sh:name "ETCSTrainToTrackPacket_9" ;
    sh:description "Level 2/3 transition information, contains identity of the level 2 transition balise group" ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_9-nid_ltrbg ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_9-nid_ltrbg
    a sh:PropertyShape ;
    sh:path era:nid_ltrbg ;
    sh:name "nid_ltrbg" ;
    sh:description "Identity of the balise group at the level 2 transition location towards which the train is running. Country/region identity (NID_C) + balise identity number of the level 2 transition location balise group (NID_BG)." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16777215 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrainToTrackPacket_10 #########################################
ss026-sh:ETCSTrainToTrackPacket_10Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackPacket_10 ;
    sh:name "ETCSTrainToTrackPacket_10" ;
    sh:description "Safe consist length information for Supervised Manoeuvre." ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_10-q_safeconsistlength ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_10-safeConsistInfo ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_10-q_safeconsistlength
    a sh:PropertyShape ;
    sh:path era:q_safeconsistlength ;
    sh:name "q_safeconsistlength" ;
    sh:description "Qualifier to indicate if the safe consist length information is available. True when Safe consist length information available, and False when no safe consist length information is available" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_10-safeConsistInfo
    a sh:PropertyShape ;
    sh:path era:safeConsistInfo ;
    sh:name "safeConsistInfo" ;
    sh:description "safe consist length information.Only if Q_SAFECONSISTLENGTH = 1" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:SafeConsistShape ;
    sh:message "safeConsistInfo must be a well-formed SafeConsist (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### SafeConsist #######################################################
ss026-sh:SafeConsistShape
    a sh:NodeShape ;
    sh:targetClass era:SafeConsist ;
    sh:name "SafeConsist" ;
    sh:description "Actualsafe consist length information for Supervised Manoeuvre." ;
    sh:property ss026-sh:SafeConsist-l_consistFrontEngineNom ;
    sh:property ss026-sh:SafeConsist-l_consistFrontEngineMin ;
    sh:property ss026-sh:SafeConsist-l_consistFrontEngineMax ;
    sh:property ss026-sh:SafeConsist-l_consistRearEngineNom ;
    sh:property ss026-sh:SafeConsist-l_consistRearEngineMin ;
    sh:property ss026-sh:SafeConsist-l_consistRearEngineMax ;
    sh:severity sh:Violation ;
    .

ss026-sh:SafeConsist-l_consistFrontEngineNom
    a sh:PropertyShape ;
    sh:path era:l_consistFrontEngineNom ;
    sh:name "l_consistFrontEngineNom" ;
    sh:description "This is the nominal length of the consist in front of the engine without any coupling play and/or any other uncertainties in the consist length information, counted from the front end of the engine taking into account the active cab." ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 4095 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:SafeConsist-l_consistFrontEngineMin
    a sh:PropertyShape ;
    sh:path era:l_consistFrontEngineMin ;
    sh:name "l_consistFrontEngineMin" ;
    sh:description "This is the minimum length of the consist in front of the engine, counted from the front end of the engine taking into account the active cab, and considering the coupling play and/or any other uncertainties in the consist length information." ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 4095 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:SafeConsist-l_consistFrontEngineMax
    a sh:PropertyShape ;
    sh:path era:l_consistFrontEngineMax ;
    sh:name "l_consistFrontEngineMax" ;
    sh:description "This is the maximum length of the consist in front of the engine, counted from the front end of the engine taking into account the active cab, and considering the coupling play and/or any other uncertainties in the consist length information." ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 4095 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:SafeConsist-l_consistRearEngineNom
    a sh:PropertyShape ;
    sh:path era:l_consistRearEngineNom ;
    sh:name "l_consistRearEngineNom" ;
    sh:description "This is the nominal length of the consist in rear of the engine without any coupling play and/or any other uncertainties in the consist length information, counted from the front end of the engine taking into account the active cab." ;
    sh:order 4 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 4095 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:SafeConsist-l_consistRearEngineMin
    a sh:PropertyShape ;
    sh:path era:l_consistRearEngineMin ;
    sh:name "l_consistRearEngineMin" ;
    sh:description "This is the minimum length of the consist in front of the engine, counted from the front end of the engine taking into account the active cab, and considering the coupling play and/or any other uncertainties in the consist length information." ;
    sh:order 5 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 4095 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:SafeConsist-l_consistRearEngineMax
    a sh:PropertyShape ;
    sh:path era:l_consistRearEngineMax ;
    sh:name "l_consistRearEngineMax" ;
    sh:description "This is the maximum length of the consist in rear of the engine, counted from the front end of the engine taking into account the active cab, and considering the coupling play and/or any other uncertainties in the consist length information." ;
    sh:order 6 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 4095 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrainToTrackPacket_11 #########################################
ss026-sh:ETCSTrainToTrackPacket_11Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackPacket_11 ;
    sh:name "ETCSTrainToTrackPacket_11" ;
    sh:description "Validated train data." ;
    sh:sparql ss026-sh:ETCSTrainToTrackPacket_11-vMaxTrain-multipleOf ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_11-cantDeficiencyCategory ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_11-otherTrainCategory ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_11-trainLength ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_11-vMaxTrain ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_11-loadingGaugeType ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_11-axleLoadCategory ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_11-airtight ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_11-axleNumber ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_11-tractionVoltage ;
    sh:property ss026-sh:ETCSTrainToTrackPacket_11-nidNtc ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-cantDeficiencyCategory
    a sh:PropertyShape ;
    sh:path era:cantDeficiencyCategory ;
    sh:name "cantDeficiencyCategory" ;
    sh:description "Defines the Cant Deficiency Train category to which the train belongs. see ss026, 7.5.1.82.2 NC_CDTRAIN" ;
    sh:order 1 ;
    rdfs:comment "ERTMS subset variable: NC_CDTRAIN"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/cant-deficiencies/80> <http://data.europa.eu/949/concepts/cant-deficiencies/100> <http://data.europa.eu/949/concepts/cant-deficiencies/130> <http://data.europa.eu/949/concepts/cant-deficiencies/150> <http://data.europa.eu/949/concepts/cant-deficiencies/165> <http://data.europa.eu/949/concepts/cant-deficiencies/180> <http://data.europa.eu/949/concepts/cant-deficiencies/210> <http://data.europa.eu/949/concepts/cant-deficiencies/225> <http://data.europa.eu/949/concepts/cant-deficiencies/245> <http://data.europa.eu/949/concepts/cant-deficiencies/275> <http://data.europa.eu/949/concepts/cant-deficiencies/300> ) ;
    sh:message "Value must be one of the CCSTMS-scoped CantDeficiencies concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-otherTrainCategory
    a sh:PropertyShape ;
    sh:path era:otherTrainCategory ;
    sh:name "otherTrainCategory" ;
    sh:description "Other train category (different from Cant Deficiency) to which the train belongs. Thanks to NC_TRAIN, the train knows the 'Other specific' SSP category it must consider. By receiving a list of static speed profile, thanks to NC_DIFF, the train can select the SSP it must obey. Each bit represents one category. A train can belong to various categories. see ss026, 7.5.1.84 NC_TRAIN" ;
    sh:order 2 ;
    rdfs:comment "ERTMS subset variable: NC_TRAIN"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/other-international-train-category/noCategory> <http://data.europa.eu/949/concepts/other-international-train-category/freightTrainP> <http://data.europa.eu/949/concepts/other-international-train-category/freightTrainG> <http://data.europa.eu/949/concepts/other-international-train-category/passengerTrain> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OtherInternationalTrainCategory concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-trainLength
    a sh:PropertyShape ;
    sh:path era:trainLength ;
    sh:name "trainLength" ;
    sh:description "This is the length of the train acquired as Train Data. When the safe consist length is captured as part of valid Train Data, L_TRAIN is equal to L_CONSISTREARENGINEMAX, considering that valid Train Data can only be captured and sent to the RBC with the leading engine/cab located at the very front of the train. see ss026, 7.5.1.56 L_TRAIN" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    rdfs:comment "ERTMS subset variable: L_TRAIN"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 4095 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-vMaxTrain
    a sh:PropertyShape ;
    sh:path era:vMaxTrain ;
    sh:name "vMaxTrain" ;
    sh:description "Maximum train speed. Resolution is 5 Km/h. see ss026, 7.5.1.160 V_MAXTRAIN" ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    rdfs:comment "ERTMS subset variable: V_MAXTRAIN"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-loadingGaugeType
    a sh:PropertyShape ;
    sh:path era:loadingGaugeType ;
    sh:name "loadingGaugeType" ;
    sh:description "Defining the loading gauge profile of a train (refer to LOC&PAS TSI). see ss026, 7.5.1.68 M_LOADINGGAUGE" ;
    sh:order 5 ;
    rdfs:comment "ERTMS subset variable: M_LOADINGGAUGE"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/loading-gauge-type/loadingGaugeIncompatible> <http://data.europa.eu/949/concepts/loading-gauge-type/g1> <http://data.europa.eu/949/concepts/loading-gauge-type/gA> <http://data.europa.eu/949/concepts/loading-gauge-type/gB> <http://data.europa.eu/949/concepts/loading-gauge-type/gC> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LoadingGaugeType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-axleLoadCategory
    a sh:PropertyShape ;
    sh:path era:axleLoadCategory ;
    sh:name "axleLoadCategory" ;
    sh:description "Axle load category (The values allocated below correspond to a list of increasing axle load categories (i.e. B1 > HS17, B2 > B1, D2 > C4, ….etc) and it is used by the on-board equipment to compare its axle load category with the axle load category sent by trackside.For the underlying meaning of the axle load categories listed (with the exception of HS17) refer to CR INF TSI.The category HS17 (axle load <= 17t) corresponds to a static load per axle only, as specified in HS RST TSI clause 4.2.3.2. The introduction of this artefact is necessary to ensure backward compatibility, without any negative performance impact, in case ASPs are used on lines operated with system version X = 1).see ss026, 7.5.1.62 M_AXLELOADCAT" ;
    sh:order 6 ;
    rdfs:comment "ERTMS subset variable: M_AXLELOADCAT"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/load-capability-line-categories/10> <http://data.europa.eu/949/concepts/load-capability-line-categories/230> <http://data.europa.eu/949/concepts/load-capability-line-categories/20> <http://data.europa.eu/949/concepts/load-capability-line-categories/30> <http://data.europa.eu/949/concepts/load-capability-line-categories/40> <http://data.europa.eu/949/concepts/load-capability-line-categories/50> <http://data.europa.eu/949/concepts/load-capability-line-categories/60> <http://data.europa.eu/949/concepts/load-capability-line-categories/70> <http://data.europa.eu/949/concepts/load-capability-line-categories/80> <http://data.europa.eu/949/concepts/load-capability-line-categories/90> <http://data.europa.eu/949/concepts/load-capability-line-categories/100> <http://data.europa.eu/949/concepts/load-capability-line-categories/110> <http://data.europa.eu/949/concepts/load-capability-line-categories/120> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LoadCapabilityLineCategories concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-airtight
    a sh:PropertyShape ;
    sh:path era:airtight ;
    sh:name "airtight" ;
    sh:description "indicates whether the train is fitted with an airtight system or not. see ss026, 7.5.1.61 M_AIRTIGHT" ;
    sh:order 7 ;
    rdfs:comment "ERTMS subset variable: M_AIRTIGHT"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/airtight-type/notFitted> <http://data.europa.eu/949/concepts/airtight-type/fitted> ) ;
    sh:message "Value must be one of the CCSTMS-scoped AirtightType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-axleNumber
    a sh:PropertyShape ;
    sh:path era:axleNumber ;
    sh:name "axleNumber" ;
    sh:description "This gives the number of axles of the single unit (fixed train set or locomotive) in which the onboard equipment is fitted. See ss026, 7.5.1.79.1 N_AXLE" ;
    sh:order 8 ;
    rdfs:comment "ERTMS subset variable: N_AXLE"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-tractionVoltage
    a sh:PropertyShape ;
    sh:path era:tractionVoltage ;
    sh:name "tractionVoltage" ;
    sh:description "supported Traction System voltage. see ss026, 7.4.3.5. Identity of the traction system NID_CTRACTION(k) given only if M_VOLTAGE(k) ≠ 0" ;
    sh:order 9 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:TractionVoltageShape ;
    sh:message "tractionVoltage must be a well-formed TractionVoltage (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-nidNtc
    a sh:PropertyShape ;
    sh:path era:nidNtc ;
    sh:name "nidNtc" ;
    sh:description "National System identity (Each value of this variable represents the identity of a National System).see ss026, 7.5.1.98 NID_NTC" ;
    sh:order 10 ;
    rdfs:comment "ERTMS subset variable: NID_NTC"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket_11-vMaxTrain-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "vMaxTrain must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:vMaxTrain ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

### TractionVoltage ###################################################
ss026-sh:TractionVoltageShape
    a sh:NodeShape ;
    sh:targetClass era:TractionVoltage ;
    sh:name "TractionVoltage" ;
    sh:description "It indicates the voltage of the traction system installed on a specific line or respectively that can be used by an engine" ;
    sh:property ss026-sh:TractionVoltage-mVoltage ;
    sh:property ss026-sh:TractionVoltage-countryTractionId ;
    sh:severity sh:Violation ;
    .

ss026-sh:TractionVoltage-mVoltage
    a sh:PropertyShape ;
    sh:path era:mVoltage ;
    sh:name "mVoltage" ;
    sh:description "Special/Reserved values for Traction System voltage. It indicates the voltage of the traction system installed on a specific line or respectively that can be used by an engine. The identity of the traction system is given by M_VOLTAGE and, if M_VOLTAGE ≠ 0, by the country identifier of the traction system (NID_CTRACTION). see ss026,7.5.1.78 M_VOLTAGE" ;
    sh:order 1 ;
    rdfs:comment "ERTMS subset variable: M_VOLTAGE"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/energy-supply-systems/notFitted> <http://data.europa.eu/949/concepts/energy-supply-systems/AC10> <http://data.europa.eu/949/concepts/energy-supply-systems/AC20> <http://data.europa.eu/949/concepts/energy-supply-systems/DC30> <http://data.europa.eu/949/concepts/energy-supply-systems/DC40> <http://data.europa.eu/949/concepts/energy-supply-systems/DC80> <http://data.europa.eu/949/concepts/energy-supply-systems/DC70> <http://data.europa.eu/949/concepts/energy-supply-systems/DC60> <http://data.europa.eu/949/concepts/energy-supply-systems/DC90> ) ;
    sh:message "Value must be one of the CCSTMS-scoped EnergySupplySystems concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TractionVoltage-countryTractionId
    a sh:PropertyShape ;
    sh:path era:countryTractionId ;
    sh:name "countryTractionId" ;
    sh:description "Country identifier of the traction system. It identifies the information, additional to M_VOLTAGE, required to fully define the traction system. Note that NID_CTRACTION given only if M_VOLTAGE ≠ 0. see ss026,7.5.1.86.1 NID_CTRACTION" ;
    sh:order 2 ;
    rdfs:comment "ERTMS subset variable: NID_CTRACTION"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

