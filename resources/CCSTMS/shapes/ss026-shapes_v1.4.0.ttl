    .

ss026-sh:ETCSTrackToTrainPacket_133-q_riu
    a sh:PropertyShape ;
    sh:path era:q_riu ;
    sh:name "q_riu" ;
    sh:description "Qualifier for communication session order." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_133-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "Identity number of the country or region (Code used to identify the country or region in which the balise group, the RBC or the RIU is situated. These need not necessarily follow administrative or political boundaries )" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_133-nid_riu
    a sh:PropertyShape ;
    sh:path era:nid_riu ;
    sh:name "nid_riu" ;
    sh:description "Identity of radio infill unit. This variable provides the identity of the RIU belonging to NID_C. The RIU ETCS identity is given by NID_C + NID_RIU." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_133-rbcPhone
    a sh:PropertyShape ;
    sh:path era:rbcPhone ;
    sh:name "rbcPhone" ;
    sh:description "Radio subscriber number. (Quoted as a 16 digit decimal number. The number is to be entered “left adjusted” starting with the first digit to be dialled. Padding by the special value F shall be added after the least significant digit of the number.)" ;
    sh:order 4 ;
    rdfs:comment "ERTMS subset variable: NID_RADIO"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]{16}$" ;
    sh:message "rbcPhone is Binary Coded Decimal: exactly 16 decimal digits (0-9), no other characters."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_133-d_infill
    a sh:PropertyShape ;
    sh:path era:d_infill ;
    sh:name "d_infill" ;
    sh:description "Distance to location where to connect/disconnect to a radio infill unit." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_133-nid_c_next
    a sh:PropertyShape ;
    sh:path era:nid_c_next ;
    sh:name "nid_c_next" ;
    sh:description "Refers to the next main signal balise group (relevant only for the case of establishing a communication session" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_133-nid_bg
    a sh:PropertyShape ;
    sh:path era:nid_bg ;
    sh:name "nid_bg" ;
    sh:description "Identity number of the balise group. Identity number of a balise group or loop within the country or region defined by NID_C." ;
    sh:order 7 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

