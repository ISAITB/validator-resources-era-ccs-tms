### ETCSTrackToTrainPacket_64 #########################################
ss026-sh:ETCSTrackToTrainPacket_64Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_64 ;
    sh:name "ETCSTrackToTrainPacket_64" ;
