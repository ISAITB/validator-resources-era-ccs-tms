    sh:path era:g_tsr ;
    sh:name "g_tsr" ;
    sh:description "Default gradient for TSR supervision. Defines a default gradient to be used for TSR supervision when no gradient profile (packet 21) is available." ;
    sh:order 2 ;
    qudt:hasUnit unit:MilliM-PER-M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_145 ########################################
