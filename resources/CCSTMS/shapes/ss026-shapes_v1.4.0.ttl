    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:TrainToTrackPacketShape ;
    sh:message "trainToTrackPacket must be a well-formed TrainToTrackPacket (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### TrainToTrackPacket ################################################
ss026-sh:TrainToTrackPacketShape
    a sh:NodeShape ;
    sh:targetClass era:TrainToTrackPacket ;
    sh:name "TrainToTrackPacket" ;
    sh:description "multiple variables of track-to-train packets grouped into a single unit, with a defined internal structure" ;
    sh:xone (
        ss026-sh:TrainToTrackPacket-trainToTrackPacket_0-present
        ss026-sh:TrainToTrackPacket-trainToTrackPacket_1-present
        ss026-sh:TrainToTrackPacket-trainToTrackPacket_2-present
        ss026-sh:TrainToTrackPacket-trainToTrackPacket_4-present
        ss026-sh:TrainToTrackPacket-trainToTrackPacket_5-present
        ss026-sh:TrainToTrackPacket-trainToTrackPacket_9-present
        ss026-sh:TrainToTrackPacket-trainToTrackPacket_10-present
        ss026-sh:TrainToTrackPacket-trainToTrackPacket_11-present
        ss026-sh:TrainToTrackPacket-trainToTrackPacket_12-present
        ss026-sh:TrainToTrackPacket-trainToTrackPacket_44-present
    ) ;
    sh:message "TrainToTrackPacket is a union: exactly one of (trainToTrackPacket_0, trainToTrackPacket_1, trainToTrackPacket_2, trainToTrackPacket_4, trainToTrackPacket_5, trainToTrackPacket_9, trainToTrackPacket_10, trainToTrackPacket_11, trainToTrackPacket_12, trainToTrackPacket_44) must be present."@en ;
    sh:property ss026-sh:TrainToTrackPacket-trainToTrackPacket_0 ;
    sh:property ss026-sh:TrainToTrackPacket-trainToTrackPacket_1 ;
    sh:property ss026-sh:TrainToTrackPacket-trainToTrackPacket_2 ;
    sh:property ss026-sh:TrainToTrackPacket-trainToTrackPacket_4 ;
    sh:property ss026-sh:TrainToTrackPacket-trainToTrackPacket_5 ;
    sh:property ss026-sh:TrainToTrackPacket-trainToTrackPacket_9 ;
    sh:property ss026-sh:TrainToTrackPacket-trainToTrackPacket_10 ;
    sh:property ss026-sh:TrainToTrackPacket-trainToTrackPacket_11 ;
    sh:property ss026-sh:TrainToTrackPacket-trainToTrackPacket_12 ;
    sh:property ss026-sh:TrainToTrackPacket-trainToTrackPacket_44 ;
    sh:severity sh:Violation ;
    .

