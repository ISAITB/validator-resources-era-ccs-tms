### GeoPosItem ########################################################
ss026-sh:GeoPosItemShape
    a sh:NodeShape ;
    sh:targetClass era:GeoPosItem ;
    sh:name "GeoPosItem" ;
    sh:description "Defines the parameters for geographical position referencing in railway operations. This includes balise group identity, position offsets, track kilometre references, and direction qualifiers to support accurate location tracking and reporting along the railway network." ;
    sh:property ss026-sh:GeoPosItem-nid_c ;
    sh:property ss026-sh:GeoPosItem-nid_bg ;
    sh:property ss026-sh:GeoPosItem-d_posoff ;
    sh:property ss026-sh:GeoPosItem-q_mposition ;
    sh:property ss026-sh:GeoPosItem-m_position ;
    sh:severity sh:Violation ;
    .

ss026-sh:GeoPosItem-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "Identity number of the country or region (Code used to identify the country or region in which the balise group, the RBC or the RIU is situated. These need not necessarily follow administrative or political boundaries )" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:GeoPosItem-nid_bg
    a sh:PropertyShape ;
    sh:path era:nid_bg ;
    sh:name "nid_bg" ;
    sh:description "Identity number of the balise group. Identity number of a balise group or loop within the country or region defined by NID_C." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:GeoPosItem-d_posoff
    a sh:PropertyShape ;
    sh:path era:d_posoff ;
    sh:name "d_posoff" ;
    sh:description "Offset from the location reference of the geographical position reference balise group to the related track kilometre reference..The geographical position reporting function uses this variables content as an offset from the location reference of the geographical position reference balise group to the related track kilometre reference." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:GeoPosItem-q_mposition
    a sh:PropertyShape ;
    sh:path era:q_mposition ;
    sh:name "q_mposition" ;
    sh:description "Qualifier for track kilometre direction. Qualifier to indicate the direction of counting of the geographical position track kilometre in relation to the geographical position reference balise group directionality." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:GeoPosItem-m_position
    a sh:PropertyShape ;
    sh:path era:m_position ;
    sh:name "m_position" ;
    sh:description "Track kilometre reference value. The geographical position reporting function uses this variables content as a reference value." ;
    sh:order 5 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16777215 ;
    sh:not [ sh:minInclusive 10000000 ; sh:maxInclusive 16777214 ] ;
    sh:message "Values 10000000 to 16777214 are spare/invalid for m_position and must not be used."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_79 #########################################
ss026-sh:ETCSTrackToTrainPacket_79Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_79 ;
    sh:name "ETCSTrackToTrainPacket_79" ;
    sh:description "Geographical Position Information. This packet gives geographical location information for one or multiple references to the train" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_79-geoPosItems ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_79-geoPosItems
    a sh:PropertyShape ;
    sh:path era:geoPosItems ;
    sh:name "geoPosItems" ;
    sh:description "List of Geographical Position Reference" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:GeoPosItemShape ;
    sh:message "geoPosItems must be a well-formed GeoPosItem (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 32 ;
    sh:severity sh:Violation ;
    .

### ModeProfileItem ###################################################
ss026-sh:ModeProfileItemShape
    a sh:NodeShape ;
    sh:targetClass era:ModeProfileItem ;
    sh:name "ModeProfileItem" ;
    sh:description "Defines the parameters for mode profile transitions in railway operations, specifying the required mode, associated speed limits, and spatial constraints. This includes incremental distances, supervision qualifiers, and acknowledgment areas to ensure proper mode application within the movement authority framework." ;
    sh:property ss026-sh:ModeProfileItem-d_mamode ;
    sh:property ss026-sh:ModeProfileItem-m_mamode ;
    sh:property ss026-sh:ModeProfileItem-v_mamode ;
    sh:property ss026-sh:ModeProfileItem-l_mamode ;
    sh:property ss026-sh:ModeProfileItem-l_ackmamode ;
    sh:property ss026-sh:ModeProfileItem-q_mamode ;
    sh:severity sh:Violation ;
    .

ss026-sh:ModeProfileItem-d_mamode
    a sh:PropertyShape ;
    sh:path era:d_mamode ;
    sh:name "d_mamode" ;
    sh:description "Incremental distance to the start of the next Mode Profile" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ModeProfileItem-m_mamode
    a sh:PropertyShape ;
    sh:path era:m_mamode ;
    sh:name "m_mamode" ;
    sh:description "Required mode for a part of the MA. None. Comment : OS, LS, SH" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/ma-mode/onSight> <http://data.europa.eu/949/concepts/ma-mode/shunting> <http://data.europa.eu/949/concepts/ma-mode/limitedSupervision> ) ;
    sh:message "Value must be one of the CCSTMS-scoped MAMode concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ModeProfileItem-v_mamode
    a sh:PropertyShape ;
    sh:path era:v_mamode ;
    sh:name "v_mamode" ;
    sh:description "Required mode related speed." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 127 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ModeProfileItem-l_mamode
    a sh:PropertyShape ;
    sh:path era:l_mamode ;
    sh:name "l_mamode" ;
    sh:description "Length of the area of the required mode." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ModeProfileItem-l_ackmamode
    a sh:PropertyShape ;
    sh:path era:l_ackmamode ;
    sh:name "l_ackmamode" ;
    sh:description "Length of the acknowledgement area in rear of the start of the required mode." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ModeProfileItem-q_mamode
    a sh:PropertyShape ;
    sh:path era:q_mamode ;
    sh:name "q_mamode" ;
    sh:description "Qualifier to indicate the supervision of the beginning of the mode profile. This qualifier defines whether the beginning of the mode profile shall be considered as the SvL, or if the SvL shall be derived from the movement authority." ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_80 #########################################
ss026-sh:ETCSTrackToTrainPacket_80Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_80 ;
    sh:name "ETCSTrackToTrainPacket_80" ;
    sh:description "Mode profileassociated to an MA" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_80-modeProfiles ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_80-modeProfiles
    a sh:PropertyShape ;
    sh:path era:modeProfiles ;
    sh:name "modeProfiles" ;
    sh:description "List of mode profile transition items" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:ModeProfileItemShape ;
    sh:message "modeProfiles must be a well-formed ModeProfileItem (blank node or IRI)."@en ;
    sh:minCount 1 ;
