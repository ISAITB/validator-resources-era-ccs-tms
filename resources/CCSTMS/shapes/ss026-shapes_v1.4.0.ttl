### ETCSTrainToTrackRM ################################################
ss026-sh:ETCSTrainToTrackRMShape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackRM ;
    sh:name "ETCSTrainToTrackRM" ;
    sh:description "Represents the ETCS Train-to-Track Radio Message, which is the top-level structure of messages transmitted from the onboard ETCS subsystem to the Radio Block Centre (RBC). It contains the common message header (message identifier, length, time, and onboard identity) followed by the message-specific content defined in the TrainToTrackRM structure. These messages support train reporting, acknowledgements, and operational data exchange required by the ERTMS/ETCS communication protocol." ;
    sh:property ss026-sh:ETCSTrainToTrackRM-msgId ;
    sh:property ss026-sh:ETCSTrainToTrackRM-l_message ;
    sh:property ss026-sh:ETCSTrainToTrackRM-t_train ;
    sh:property ss026-sh:ETCSTrainToTrackRM-nid_engine ;
    sh:property ss026-sh:ETCSTrainToTrackRM-trainToTrackRM ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackRM-msgId
    a sh:PropertyShape ;
    sh:path era:msgId ;
    sh:name "msgId" ;
    sh:description "Message identifier with respect to the defined values of NID_MESSAGE, refer to chapters 8.5.2 and 8.5.3" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackRM-l_message
    a sh:PropertyShape ;
    sh:path era:l_message ;
    sh:name "l_message" ;
    sh:description "L_MESSAGE indicates the length of the message in bytes, including all packets and all variables defined in the message header (NID_MESSAGE and L_MESSAGE also)." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackRM-t_train
    a sh:PropertyShape ;
    sh:path era:t_train ;
    sh:name "t_train" ;
    sh:description "Time, according to trainborne clock, at which message is sent. Resolution is 10 ms" ;
    sh:order 3 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -2 (stored value x 10^-2 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackRM-nid_engine
    a sh:PropertyShape ;
    sh:path era:nid_engine ;
    sh:name "nid_engine" ;
    sh:description "Onboard ETCS identity. The ETCS identity number is uniquely defined for ERTMS/ETCS purposes." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16777215 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackRM-trainToTrackRM
    a sh:PropertyShape ;
    sh:path era:trainToTrackRM ;
    sh:name "trainToTrackRM" ;
    sh:description "Message-specific content of the Train-to-Track Radio Message, containing the variables and packets defined for the specific message type referenced by msgId." ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:TrainToTrackRMShape ;
    sh:message "trainToTrackRM must be a well-formed TrainToTrackRM (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### TrainToTrackRM ####################################################
