### PacketMgmt ########################################################
ss026-sh:PacketMgmtShape
    a sh:NodeShape ;
    sh:targetClass era:PacketMgmt ;
    sh:name "PacketMgmt" ;
    sh:description "Defines the container for ETCS track-to-train and train-to-track packet definitions." ;
    sh:property ss026-sh:PacketMgmt-hasETCSTrackToTrainPacket ;
    sh:property ss026-sh:PacketMgmt-hasETCSTrainToTrackPackets ;
    sh:severity sh:Violation ;
    .

ss026-sh:PacketMgmt-hasETCSTrackToTrainPacket
    a sh:PropertyShape ;
    sh:path era:hasETCSTrackToTrainPacket ;
    sh:name "hasETCSTrackToTrainPacket" ;
    sh:description "Defines the collection of ETCS track-to-train packet definitions." ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:ETCSTrackToTrainPacketShape ;
    sh:message "hasETCSTrackToTrainPacket must be a well-formed ETCSTrackToTrainPacket (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

ss026-sh:PacketMgmt-hasETCSTrainToTrackPackets
    a sh:PropertyShape ;
    sh:path era:hasETCSTrainToTrackPackets ;
    sh:name "hasETCSTrainToTrackPackets" ;
    sh:description "Defines the collection of ETCS train-to-track packet definitions." ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:ETCSTrainToTrackPacketShape ;
    sh:message "hasETCSTrainToTrackPackets must be a well-formed ETCSTrainToTrackPacket (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

### ETCSTrainToTrackPacket ############################################
ss026-sh:ETCSTrainToTrackPacketShape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrainToTrackPacket ;
    sh:name "ETCSTrainToTrackPacket" ;
    sh:description "a unique packet number, the length of the packet in bits, the orientation information, optionally the scale for distance/length information and an information section containing a defined set of variables" ;
    sh:property ss026-sh:ETCSTrainToTrackPacket-packetId ;
    sh:property ss026-sh:ETCSTrainToTrackPacket-q_scale ;
    sh:property ss026-sh:ETCSTrainToTrackPacket-trainToTrackPacket ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrainToTrackPacket-packetId
    a sh:PropertyShape ;
    sh:path era:packetId ;
    sh:name "packetId" ;
    sh:description "defines the packet identifier" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

