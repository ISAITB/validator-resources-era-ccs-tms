    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_3-nVKs
    a sh:PropertyShape ;
    sh:path era:nVKs ;
    sh:name "nVKs" ;
    sh:description "exists only if Q_NVKINT is true." ;
    sh:order 33 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:NVKShape ;
    sh:message "nVKs must be a well-formed NVK (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_3-v_nvshunt-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "v_nvshunt must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_nvshunt ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

ss026-sh:ETCSTrackToTrainPacket_3-v_nvstff-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
