@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix era:     <http://data.europa.eu/949/> .

@prefix ss026-sh: <http://data.europa.eu/949/shapes/ss026#> .


########################################################################
#  SPARQL prefix declarations
#
#  SHACL 5.3: the Turtle @prefix declarations above do NOT apply inside
#  sh:select - only sh:prefixes does. Without this, a query writing era:...
#  fails with "Unknown namespace prefix : era" on any data graph that does
#  not itself bind the same prefix (e.g. data written with full IRIs).
########################################################################

ss026-sh:PrefixDeclarations
    a owl:Ontology ;
    rdfs:label "Prefixes available to every sh:select in this file"@en ;
    sh:declare
        [ sh:prefix "era"  ; sh:namespace "http://data.europa.eu/949/"^^xsd:anyURI ] ,
        [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd"  ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ;
    .

########################################################################
#  ss026 node shapes
########################################################################
### ETCSTrackToTrainPacket ############################################
ss026-sh:ETCSTrackToTrainPacketShape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket ;
    sh:name "ETCSTrackToTrainPacket" ;
    sh:description "a unique packet number, the length of the packet in bits, the orientation information, optionally the scale for distance/length information and an information section containing a defined set of variables" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket-packetId ;
    sh:property ss026-sh:ETCSTrackToTrainPacket-q_dir ;
    sh:property ss026-sh:ETCSTrackToTrainPacket-q_scale ;
    sh:property ss026-sh:ETCSTrackToTrainPacket-trackToTrainPacket ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket-packetId
    a sh:PropertyShape ;
    sh:path era:packetId ;
    sh:name "packetId" ;
    sh:description "defines the packet identifier" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket-q_dir
    a sh:PropertyShape ;
    sh:path era:q_dir ;
    sh:name "q_dir" ;
    sh:description "specifies the validity direction of transmitted data" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/q-dir/reverse> <http://data.europa.eu/949/concepts/q-dir/nominal> <http://data.europa.eu/949/concepts/q-dir/both> ) ;
    sh:message "Value must be one of the CCSTMS-scoped QDir concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket-q_scale
    a sh:PropertyShape ;
    sh:path era:q_scale ;
    sh:name "q_scale" ;
    sh:description "An indicator specifying the uniform scale applied to describe distances within the packet containing Q_SCALE" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 2 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket-trackToTrainPacket
    a sh:PropertyShape ;
    sh:path era:trackToTrainPacket ;
    sh:name "trackToTrainPacket" ;
    sh:description "consists of variable group of the track-to-train ETCS-Packet" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:TrackToTrainPacketShape ;
    sh:message "trackToTrainPacket must be a well-formed TrackToTrainPacket (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### TrackToTrainPacket ################################################
ss026-sh:TrackToTrainPacketShape
    a sh:NodeShape ;
    sh:targetClass era:TrackToTrainPacket ;
    sh:name "TrackToTrainPacket" ;
    sh:description "multiple variables of track-to-train packets grouped into a single unit, with a defined internal structure" ;
    sh:xone (
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_0-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_2-present
        ss026-sh:TrackToTrainPacket-trackToTrainPacket_3-present
