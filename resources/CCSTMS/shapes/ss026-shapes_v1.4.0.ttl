ss026-sh:ETCSTrackToTrainPacket_6-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "Identity number of the country or region (Code used to identify the country or region in which the balise group, the RBC or the RIU is situated. These need not necessarily follow administrative or political boundaries )" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_6-t_vbc
    a sh:PropertyShape ;
    sh:path era:t_vbc ;
    sh:name "t_vbc" ;
    sh:description "Virtual Balise Cover (VBC) validity period" ;
    sh:order 4 ;
    qudt:hasUnit unit:DAY ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_15 #########################################
ss026-sh:ETCSTrackToTrainPacket_15Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_15 ;
    sh:name "ETCSTrackToTrainPacket_15" ;
    sh:description "Transmission of a movement authority for level 2." ;
    sh:sparql ss026-sh:ETCSTrackToTrainPacket_15-v_ema-multipleOf ;
    sh:sparql ss026-sh:ETCSTrackToTrainPacket_15-v_releaseDP-multipleOf ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-v_ema ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-t_ema ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-hasSectionTimer ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-q_endTimer ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-t_endTimer ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-d_endTimerStartLoc ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-q_dangerPoint ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-d_dp ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-v_releaseDP ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-q_overlap ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-d_startOL ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-t_ol ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-d_ol ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_15-v_releaseOL ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-v_ema
    a sh:PropertyShape ;
    sh:path era:v_ema ;
    sh:name "v_ema" ;
    sh:description "Permitted speed at the End of Movement Authority. Resolution is 5 km/h" ;
    sh:order 1 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-t_ema
    a sh:PropertyShape ;
    sh:path era:t_ema ;
    sh:name "t_ema" ;
    sh:description "Time for which the target speed is valid measured from the moment information is received" ;
    sh:order 2 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-hasSectionTimer
    a sh:PropertyShape ;
    sh:path era:hasSectionTimer ;
    sh:name "hasSectionTimer" ;
    sh:description "refers to section timer information" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:SectionTimerShape ;
    sh:message "hasSectionTimer must be a well-formed SectionTimer (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 32 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-q_endTimer
    a sh:PropertyShape ;
    sh:path era:q_endTimer ;
    sh:name "q_endTimer" ;
    sh:description "Qualifier to indicate whether end section timer information exists for the End section in the MA" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-t_endTimer
    a sh:PropertyShape ;
    sh:path era:t_endTimer ;
    sh:name "t_endTimer" ;
    sh:description "Time for which the End section is valid measured from the moment the train reaches the location defined by D_ENDTIMERSTARTLOC." ;
    sh:order 5 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-d_endTimerStartLoc
    a sh:PropertyShape ;
    sh:path era:d_endTimerStartLoc ;
    sh:name "d_endTimerStartLoc" ;
    sh:description "Distance from the End section timer start location to the End of Movement Authority" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-q_dangerPoint
    a sh:PropertyShape ;
    sh:path era:q_dangerPoint ;
    sh:name "q_dangerPoint" ;
    sh:description "This variable is set to 1 if either a danger point exists or a release speed has to be specified" ;
    sh:order 7 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-d_dp
    a sh:PropertyShape ;
    sh:path era:d_dp ;
    sh:name "d_dp" ;
    sh:description "Distance from the End of Movement Authority to danger point" ;
    sh:order 8 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-v_releaseDP
    a sh:PropertyShape ;
    sh:path era:v_releaseDP ;
    sh:name "v_releaseDP" ;
    sh:description "Release speed associated with the danger point" ;
    sh:order 9 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-q_overlap
    a sh:PropertyShape ;
    sh:path era:q_overlap ;
    sh:name "q_overlap" ;
    sh:description "This variable is set to 1 if either an overlap exists or a release speed has to be specified" ;
    sh:order 10 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-d_startOL
    a sh:PropertyShape ;
    sh:path era:d_startOL ;
    sh:name "d_startOL" ;
    sh:description "Distance from the overlap timer start location to the End of Movement Authority" ;
    sh:order 11 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-t_ol
    a sh:PropertyShape ;
    sh:path era:t_ol ;
    sh:name "t_ol" ;
    sh:description "The time span the train can expect the overlap to be available, measured from the moment the train reaches the location defined by D_STARTOL." ;
    sh:order 12 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-d_ol
    a sh:PropertyShape ;
    sh:path era:d_ol ;
    sh:name "d_ol" ;
    sh:description "The distance from the End of Movement Authority to the end of overlap" ;
    sh:order 13 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-v_releaseOL
    a sh:PropertyShape ;
    sh:path era:v_releaseOL ;
    sh:name "v_releaseOL" ;
    sh:description "Release speed associated with the overlap" ;
    sh:order 14 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 127 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-v_ema-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "v_ema must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_ema ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

ss026-sh:ETCSTrackToTrainPacket_15-v_releaseDP-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "v_releaseDP must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_releaseDP ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

