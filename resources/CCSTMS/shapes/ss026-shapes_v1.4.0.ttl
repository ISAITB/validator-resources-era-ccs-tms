### RouteSuitability ##################################################
ss026-sh:RouteSuitabilityShape
    a sh:NodeShape ;
    sh:targetClass era:RouteSuitability ;
    sh:name "RouteSuitability" ;
    sh:description "Defines the parameters for route suitability assessment, ensuring compatibility between railway infrastructure and rolling stock. This includes route suitability changes, loading gauge constraints, axle load categories, traction system voltage, and country-specific traction system identifiers, allowing on-board systems to validate operational feasibility." ;
    sh:property ss026-sh:RouteSuitability-d_suitability ;
    sh:property ss026-sh:RouteSuitability-q_suitability ;
    sh:property ss026-sh:RouteSuitability-m_lineGauge ;
    sh:property ss026-sh:RouteSuitability-axleLoadCategory ;
    sh:property ss026-sh:RouteSuitability-m_voltage ;
    sh:property ss026-sh:RouteSuitability-nid_ctraction ;
    sh:severity sh:Violation ;
    .

ss026-sh:RouteSuitability-d_suitability
    a sh:PropertyShape ;
    sh:path era:d_suitability ;
    sh:name "d_suitability" ;
    sh:description "Distance to change in route suitability (The incremental distance to where the route suitability data changes.)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:RouteSuitability-q_suitability
    a sh:PropertyShape ;
    sh:path era:q_suitability ;
    sh:name "q_suitability" ;
    sh:description "Type of route suitability data" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/q-suitability/loadingGuage> <http://data.europa.eu/949/concepts/q-suitability/maxAxleLoad> <http://data.europa.eu/949/concepts/q-suitability/tractionSystem> ) ;
    sh:message "Value must be one of the CCSTMS-scoped Q_Suitability concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:RouteSuitability-m_lineGauge
    a sh:PropertyShape ;
    sh:path era:m_lineGauge ;
    sh:name "m_lineGauge" ;
    sh:description "defining which loading gauge(s) are permitted on a line (refer to TSI INF)" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/line-guage/g1> <http://data.europa.eu/949/concepts/line-guage/gA> <http://data.europa.eu/949/concepts/line-guage/gB> <http://data.europa.eu/949/concepts/line-guage/gC> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LineGauge concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:RouteSuitability-axleLoadCategory
    a sh:PropertyShape ;
    sh:path era:axleLoadCategory ;
    sh:name "axleLoadCategory" ;
    sh:description "Axle load category (The values allocated below correspond to a list of increasing axle load categories (i.e. B1 > HS17, B2 > B1, D2 > C4, ….etc) and it is used by the on-board equipment to compare its axle load category with the axle load category sent by trackside.For the underlying meaning of the axle load categories listed (with the exception of HS17) refer to CR INF TSI.The category HS17 (axle load <= 17t) corresponds to a static load per axle only, as specified in HS RST TSI clause 4.2.3.2. The introduction of this artefact is necessary to ensure backward compatibility, without any negative performance impact, in case ASPs are used on lines operated with system version X = 1).see ss026, 7.5.1.62 M_AXLELOADCAT" ;
    sh:order 4 ;
    rdfs:comment "ERTMS subset variable: M_AXLELOADCAT"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/load-capability-line-categories/10> <http://data.europa.eu/949/concepts/load-capability-line-categories/230> <http://data.europa.eu/949/concepts/load-capability-line-categories/20> <http://data.europa.eu/949/concepts/load-capability-line-categories/30> <http://data.europa.eu/949/concepts/load-capability-line-categories/40> <http://data.europa.eu/949/concepts/load-capability-line-categories/50> <http://data.europa.eu/949/concepts/load-capability-line-categories/60> <http://data.europa.eu/949/concepts/load-capability-line-categories/70> <http://data.europa.eu/949/concepts/load-capability-line-categories/80> <http://data.europa.eu/949/concepts/load-capability-line-categories/90> <http://data.europa.eu/949/concepts/load-capability-line-categories/100> <http://data.europa.eu/949/concepts/load-capability-line-categories/110> <http://data.europa.eu/949/concepts/load-capability-line-categories/120> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LoadCapabilityLineCategories concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:RouteSuitability-m_voltage
    a sh:PropertyShape ;
    sh:path era:m_voltage ;
    sh:name "m_voltage" ;
    sh:description "Special/Reserved values for Traction System voltage. It indicates the voltage of the traction system installed on a specific line or respectively that can be used by an engine. The identity of the traction system is given by M_VOLTAGE and, if M_VOLTAGE ≠ 0, by the country identifier of the traction system (NID_CTRACTION). Note that values from 6 to 15 are currently unassigned" ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/energy-supply-systems/notFitted> <http://data.europa.eu/949/concepts/energy-supply-systems/AC10> <http://data.europa.eu/949/concepts/energy-supply-systems/AC20> <http://data.europa.eu/949/concepts/energy-supply-systems/DC30> <http://data.europa.eu/949/concepts/energy-supply-systems/DC40> <http://data.europa.eu/949/concepts/energy-supply-systems/DC80> <http://data.europa.eu/949/concepts/energy-supply-systems/DC70> <http://data.europa.eu/949/concepts/energy-supply-systems/DC60> <http://data.europa.eu/949/concepts/energy-supply-systems/DC90> ) ;
    sh:message "Value must be one of the CCSTMS-scoped EnergySupplySystems concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:RouteSuitability-nid_ctraction
    a sh:PropertyShape ;
    sh:path era:nid_ctraction ;
    sh:name "nid_ctraction" ;
    sh:description "Country identifier of the traction system. It identifies the information, additional to M_VOLTAGE, required to fully define the traction system." ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

