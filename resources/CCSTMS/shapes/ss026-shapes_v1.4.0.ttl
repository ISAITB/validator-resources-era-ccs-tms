        ss026-sh:TrackToTrainRM-trackToTrainRM_33-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_34-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_38-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_39-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_40-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_41-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_43-present
        ss026-sh:TrackToTrainRM-trackToTrainRM_45-present
    ) ;
    sh:message "TrackToTrainRM is a union: exactly one of (trackToTrainRM_2, trackToTrainRM_3, trackToTrainRM_4, trackToTrainRM_5, trackToTrainRM_6, trackToTrainRM_7, trackToTrainRM_8, trackToTrainRM_9, trackToTrainRM_15, trackToTrainRM_16, trackToTrainRM_18, trackToTrainRM_24, trackToTrainRM_27, trackToTrainRM_28, trackToTrainRM_32, trackToTrainRM_33, trackToTrainRM_34, trackToTrainRM_38, trackToTrainRM_39, trackToTrainRM_40, trackToTrainRM_41, trackToTrainRM_43, trackToTrainRM_45) must be present."@en ;
    sh:property ss026-sh:TrackToTrainRM-trackToTrainRM_2 ;
    sh:property ss026-sh:TrackToTrainRM-trackToTrainRM_3 ;
    sh:property ss026-sh:TrackToTrainRM-trackToTrainRM_4 ;
    sh:property ss026-sh:TrackToTrainRM-trackToTrainRM_5 ;
