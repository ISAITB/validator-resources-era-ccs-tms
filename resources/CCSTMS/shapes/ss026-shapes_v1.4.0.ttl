    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TCSPCondition-m_platform
    a sh:PropertyShape ;
    sh:path era:m_platform ;
    sh:name "m_platform" ;
    sh:description "Special/Reserved values for the Nominal height of platform above rail level (refer to TSI infrastructure)" ;
    sh:order 3 ;
    qudt:hasUnit unit:MilliM ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 200 ;
    sh:maxInclusive 1100 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TCSPCondition-q_platform
