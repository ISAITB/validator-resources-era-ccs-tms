ss026-sh:ETCSTrackToTrainPacket_41Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_41 ;
    sh:name "ETCSTrackToTrainPacket_41" ;
    sh:description "Level Transition Order (Packet to identify where a level transition shall take place. In case of mixed levels, the successive M_LEVELTR’s go from the highest priority level to the lowest one)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_41-d_leveltr ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_41-m_leveltr ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_41-nid_ntc ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_41-l_ackleveltr ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_41-levelTransitionWithAck ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_41-d_leveltr
    a sh:PropertyShape ;
    sh:path era:d_leveltr ;
    sh:name "d_leveltr" ;
    sh:description "Distance to level transition" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_41-m_leveltr
    a sh:PropertyShape ;
    sh:path era:m_leveltr ;
    sh:name "m_leveltr" ;
    sh:description "Required level" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-levels/50> <http://data.europa.eu/949/concepts/etcs-levels/60> <http://data.europa.eu/949/concepts/etcs-levels/20> <http://data.europa.eu/949/concepts/etcs-levels/30> <http://data.europa.eu/949/concepts/etcs-levels/80> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSLevels concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_41-nid_ntc
    a sh:PropertyShape ;
    sh:path era:nid_ntc ;
    sh:name "nid_ntc" ;
    sh:description "National System identity. Each value of this variable represents the identity of a National System." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_41-l_ackleveltr
    a sh:PropertyShape ;
    sh:path era:l_ackleveltr ;
    sh:name "l_ackleveltr" ;
    sh:description "Length of the acknowledgement area in rear of the required level." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_41-levelTransitionWithAck
    a sh:PropertyShape ;
    sh:path era:levelTransitionWithAck ;
    sh:name "levelTransitionWithAck" ;
    sh:description "List of level transitions requiring acknowledgment in ETCS operation" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:LevelTransitionWithAckShape ;
    sh:message "levelTransitionWithAck must be a well-formed LevelTransitionWithAck (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 32 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_42 #########################################
ss026-sh:ETCSTrackToTrainPacket_42Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_42 ;
    sh:name "ETCSTrackToTrainPacket_42" ;
    sh:description "Session Management (Packet to give the identity and telephone number of the RBC with which a session shall be established or terminated)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_42-q_rbc ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_42-nid_c ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_42-nid_rbc ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_42-rbcPhone ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_42-q_sleepsession ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_42-q_rbc
    a sh:PropertyShape ;
    sh:path era:q_rbc ;
    sh:name "q_rbc" ;
    sh:description "Qualifier for communication session order" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_42-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "Identity number of the country or region (Code used to identify the country or region in which the balise group, the RBC or the RIU is situated. These need not necessarily follow administrative or political boundaries )" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_42-nid_rbc
    a sh:PropertyShape ;
    sh:path era:nid_rbc ;
    sh:name "nid_rbc" ;
    sh:description "RBC ETCS identity number (This variable provides the identity of the RBC belonging to NID_C. The RBC ETCS identity is given by NID_C + NID_RBC )" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_42-rbcPhone
    a sh:PropertyShape ;
    sh:path era:rbcPhone ;
    sh:name "rbcPhone" ;
    sh:description "Radio subscriber number (Quoted as a 16 digit decimal number. The number is to be entered “left adjusted” starting with the first digit to be dialed. Padding by the special value F shall be added after the least significant digit of the number. For further information about NID_RADIO refer to SUBSET-054.)" ;
    sh:order 4 ;
    rdfs:comment "ERTMS subset variable: NID_RADIO"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]{16}$" ;
    sh:message "rbcPhone is Binary Coded Decimal: exactly 16 decimal digits (0-9), no other characters."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_42-q_sleepsession
    a sh:PropertyShape ;
    sh:path era:q_sleepsession ;
    sh:name "q_sleepsession" ;
    sh:description "Session management for sleeping equipment (Qualifier for a Sleeping onboard equipment to execute or not the (session establishment) order)" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_44 #########################################
ss026-sh:ETCSTrackToTrainPacket_44Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_44 ;
    sh:name "ETCSTrackToTrainPacket_44" ;
    sh:description "Data used by applications outside the ERTMS/ETCS system (Messages between trackside and on-board devices, which contain information used by applications outside the ERTMS/ETCS system)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_44-nid_xuser ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_44-nid_ntc ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_44-otherData ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_44-nid_xuser
    a sh:PropertyShape ;
    sh:path era:nid_xuser ;
    sh:name "nid_xuser" ;
    sh:description "Identity of user system (Identity of user system for which remainder of packet is intended)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 511 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_44-nid_ntc
    a sh:PropertyShape ;
    sh:path era:nid_ntc ;
    sh:name "nid_ntc" ;
    sh:description "National System identity (Each value of this variable represents the identity of a National System). Applicable only if nid_xuser = 102 (National System Functions)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_44-otherData
    a sh:PropertyShape ;
    sh:path era:otherData ;
    sh:name "otherData" ;
    sh:description "Other data, depending on the Identity of user system - NID_XUSER" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:base64Binary ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_45 #########################################
ss026-sh:ETCSTrackToTrainPacket_45Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_45 ;
    sh:name "ETCSTrackToTrainPacket_45" ;
    sh:description "Radio Network transition order (Packet to give the Radio Network type and, if any, the GSM-R Radio Network identity)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_45-q_networktype ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_45-nid_mn ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_45-q_networktype
    a sh:PropertyShape ;
    sh:path era:q_networktype ;
    sh:name "q_networktype" ;
    sh:description "Indicates with which radio communication system(s) the trackside is fitted." ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/network-type/FRMCS> <http://data.europa.eu/949/concepts/network-type/FRMCS_GSMR> <http://data.europa.eu/949/concepts/network-type/GSMR> ) ;
    sh:message "Value must be one of the CCSTMS-scoped NetworkType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_45-nid_mn
    a sh:PropertyShape ;
    sh:path era:nid_mn ;
    sh:name "nid_mn" ;
    sh:description "Identity of Radio Network. The NID_MN identifies the GSM-R network the calling mobile station has to register with. The NID_MN consists of up to 6 digits which are entered left adjusted into the data field, the leftmost digit is the digit to be dialled first. In case the NID_MN is shorter than 6 digits, the remaining space is to be filled with special character F" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]{6}$" ;
    sh:message "nid_mn is Binary Coded Decimal: exactly 6 decimal digits (0-9), no other characters."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### LevelTransition ###################################################
ss026-sh:LevelTransitionShape
    a sh:NodeShape ;
    sh:targetClass era:LevelTransition ;
    sh:name "LevelTransition" ;
    sh:description "Defines the parameters for level transitions in ETCS operations, specifying the required ETCS level and the associated national system identity to ensure seamless interoperability between signaling systems." ;
    sh:property ss026-sh:LevelTransition-m_leveltr ;
    sh:property ss026-sh:LevelTransition-nid_ntc ;
    sh:severity sh:Violation ;
    .

ss026-sh:LevelTransition-m_leveltr
    a sh:PropertyShape ;
    sh:path era:m_leveltr ;
    sh:name "m_leveltr" ;
    sh:description "Required level" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-levels/50> <http://data.europa.eu/949/concepts/etcs-levels/60> <http://data.europa.eu/949/concepts/etcs-levels/20> <http://data.europa.eu/949/concepts/etcs-levels/30> <http://data.europa.eu/949/concepts/etcs-levels/80> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSLevels concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:LevelTransition-nid_ntc
    a sh:PropertyShape ;
    sh:path era:nid_ntc ;
    sh:name "nid_ntc" ;
    sh:description "National System identity (Each value of this variable represents the identity of a National System.)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_46 #########################################
ss026-sh:ETCSTrackToTrainPacket_46Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_46 ;
    sh:name "ETCSTrackToTrainPacket_46" ;
    sh:description "Conditional Level Transition Order (Packet for a conditional level transition. The successive M_LEVELTR’s go from the highest priority level to the lowest one)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_46-m_leveltr ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_46-nid_ntc ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_46-levelTransitions ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_46-m_leveltr
    a sh:PropertyShape ;
    sh:path era:m_leveltr ;
    sh:name "m_leveltr" ;
    sh:description "Required level" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-levels/50> <http://data.europa.eu/949/concepts/etcs-levels/60> <http://data.europa.eu/949/concepts/etcs-levels/20> <http://data.europa.eu/949/concepts/etcs-levels/30> <http://data.europa.eu/949/concepts/etcs-levels/80> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSLevels concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_46-nid_ntc
    a sh:PropertyShape ;
    sh:path era:nid_ntc ;
    sh:name "nid_ntc" ;
    sh:description "National System identity (Each value of this variable represents the identity of a National System.)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_46-levelTransitions
    a sh:PropertyShape ;
    sh:path era:levelTransitions ;
    sh:name "levelTransitions" ;
    sh:description "List of level transitions parameters" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node ss026-sh:LevelTransitionShape ;
    sh:message "levelTransitions must be a well-formed LevelTransition (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

### CountryBalise #####################################################
ss026-sh:CountryBaliseShape
    a sh:NodeShape ;
