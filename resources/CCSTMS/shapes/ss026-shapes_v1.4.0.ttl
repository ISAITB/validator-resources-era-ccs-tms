    sh:property ss026-sh:TrackToTrainRM-trackToTrainRM_18 ;
    sh:property ss026-sh:TrackToTrainRM-trackToTrainRM_24 ;
    sh:property ss026-sh:TrackToTrainRM-trackToTrainRM_27 ;
    sh:property ss026-sh:TrackToTrainRM-trackToTrainRM_28 ;
    sh:property ss026-sh:TrackToTrainRM-trackToTrainRM_32 ;
