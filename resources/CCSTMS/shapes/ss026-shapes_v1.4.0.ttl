ss026-sh:ETCSTrackToTrainPacket_3-m_nvavadh-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "m_nvavadh must be a multiple of 0.05."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:m_nvavadh ?v .
                FILTER ( ABS(?v - (ROUND(?v / 0.05) * 0.05)) > 0.000000001 )
            }
        """ ;
    .

### LinkItem ##########################################################
ss026-sh:LinkItemShape
    a sh:NodeShape ;
    sh:targetClass era:LinkItem ;
    sh:name "LinkItem" ;
    sh:description "Defines the attributes for linking balise groups in railway signaling, ensuring proper navigation and train positioning. This includes linking distances, country and region qualifiers, balise group identity, link orientation, reaction to inconsistencies, and location accuracy to maintain safe and reliable operations." ;
    sh:property ss026-sh:LinkItem-d_link ;
    sh:property ss026-sh:LinkItem-nid_c ;
    sh:property ss026-sh:LinkItem-nid_bg ;
    sh:property ss026-sh:LinkItem-q_linkorientation ;
    sh:property ss026-sh:LinkItem-q_linkreaction ;
    sh:property ss026-sh:LinkItem-q_locacc ;
    sh:severity sh:Violation ;
    .

ss026-sh:LinkItem-d_link
    a sh:PropertyShape ;
    sh:path era:d_link ;
    sh:name "d_link" ;
    sh:description "Incremental linking distance to next linked balise group" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:LinkItem-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "New Country Qualifier (Qualifier to indicate whether the next balise group is in the same country / railway administration as the one before inside the packet or not.For the first balise group in the packet, if not provided, it is the same country / railway administration as the one of the LRBG within the radio message, the one of balise group within the balise telegram giving the packet, or the one of the loop within the loop message giving the packet)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:LinkItem-nid_bg
    a sh:PropertyShape ;
    sh:path era:nid_bg ;
    sh:name "nid_bg" ;
    sh:description "Identity number of the balise group. Identity number of a balise group or loop within the country or region defined by NID_C." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:LinkItem-q_linkorientation
    a sh:PropertyShape ;
    sh:path era:q_linkorientation ;
    sh:name "q_linkorientation" ;
    sh:description "Qualifier for the direction of the linked balise group. Indicates whether the linked balise group will be overpassed by the train in nominal or reverse directio" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:LinkItem-q_linkreaction
    a sh:PropertyShape ;
    sh:path era:q_linkreaction ;
    sh:name "q_linkreaction" ;
    sh:description "linking reaction. Qualifier for the reaction to be performed if a linking or a balise group message consistency problem occurs with the balise group linked to." ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/etcs-reactions-contact/00> <http://data.europa.eu/949/concepts/etcs-reactions-contact/01> <http://data.europa.eu/949/concepts/etcs-reactions-contact/10> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ETCSReactionsNVContact concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:LinkItem-q_locacc
    a sh:PropertyShape ;
    sh:path era:q_locacc ;
    sh:name "q_locacc" ;
    sh:description "Accuracy of the balise location. This Qualifier defines the absolute value of the accuracy of the Balise location" ;
    sh:order 6 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 63 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

