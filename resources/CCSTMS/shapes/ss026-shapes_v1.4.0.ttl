### ETCSTrackToTrainPacket_90 #########################################
ss026-sh:ETCSTrackToTrainPacket_90Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_90 ;
    sh:name "ETCSTrackToTrainPacket_90" ;
    sh:description "Track Ahead Free up to level 2/3 transition location (Notification to on-board that track ahead is free from the balise group transmitting this information up to the level 2/3 transition location)" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_90-nid_c ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_90-nid_bg ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_90-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "New Country Qualifier (Qualifier to indicate whether the next balise group is in the same country / railway administration as the one before inside the packet or not.For the first balise group in the packet, if Q_NEWCOUNTRY = 0, it is the same country / railway administration as the one of the LRBG within the radio message, the one of balise group within the balise telegram giving the packet, or the one of the loop within the loop message giving the packet.)" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_90-nid_bg
    a sh:PropertyShape ;
    sh:path era:nid_bg ;
    sh:name "nid_bg" ;
    sh:description "Identity number of Level 2/3 transition location balise group (Identity number of a balise group or loop within the country or region defined by NID_C.)" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ETCSTrackToTrainPacket_131 ########################################
ss026-sh:ETCSTrackToTrainPacket_131Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_131 ;
    sh:name "ETCSTrackToTrainPacket_131" ;
    sh:description "Packet to order an RBC transition. RBC transition order for RBC interfaced to GSM-R" ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_131-d_rbctr ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_131-nid_c ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_131-nid_rbc ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_131-rbcPhone ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_131-q_sleepsession ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_131-d_rbctr
    a sh:PropertyShape ;
    sh:path era:d_rbctr ;
    sh:name "d_rbctr" ;
    sh:description "Distance to RBC transition:" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_131-nid_c
    a sh:PropertyShape ;
    sh:path era:nid_c ;
    sh:name "nid_c" ;
    sh:description "Identity number of the country or region (Code used to identify the country or region in which the balise group, the RBC or the RIU is situated. These need not necessarily follow administrative or political boundaries )" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_131-nid_rbc
    a sh:PropertyShape ;
    sh:path era:nid_rbc ;
    sh:name "nid_rbc" ;
    sh:description "RBC ETCS identity number (This variable provides the identity of the RBC belonging to NID_C. The RBC ETCS identity is given by NID_C + NID_RBC.)" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16383 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_131-rbcPhone
    a sh:PropertyShape ;
    sh:path era:rbcPhone ;
    sh:name "rbcPhone" ;
    sh:description "Radio subscriber number (Quoted as a 16 digit decimal number. The number is to be entered “left adjusted” starting with the first digit to be dialled. Padding by the special value F shall be added after the least significant digit of the number. For further information about NID_RADIO refer to SUBSET-054.)" ;
    sh:order 4 ;
    rdfs:comment "ERTMS subset variable: NID_RADIO"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]{16}$" ;
    sh:message "rbcPhone is Binary Coded Decimal: exactly 16 decimal digits (0-9), no other characters."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_131-q_sleepsession
    a sh:PropertyShape ;
    sh:path era:q_sleepsession ;
    sh:name "q_sleepsession" ;
    sh:description "Session management for sleeping equipment. (Set to False when ignoring session establishment order; True when executing sessions establishment order.)" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

