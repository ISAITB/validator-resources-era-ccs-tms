### TextMessageConfig #################################################
ss026-sh:TextMessageConfigShape
    a sh:NodeShape ;
    sh:targetClass era:TextMessageConfig ;
    sh:name "TextMessageConfig" ;
    sh:description "Defines the configuration parameters for text message display and acknowledgment in railway operations. This includes message classification, display conditions based on distance, mode, and level, as well as qualifiers for text confirmation, reporting, and national system identity. These parameters ensure proper handling of onboard text messages and their interaction with trackside signaling and RBC communication." ;
    sh:property ss026-sh:TextMessageConfig-q_textclass ;
    sh:property ss026-sh:TextMessageConfig-q_textdisplay ;
    sh:property ss026-sh:TextMessageConfig-d_textdisplay ;
    sh:property ss026-sh:TextMessageConfig-m_modetextdisplay ;
    sh:property ss026-sh:TextMessageConfig-m_leveltextdisplay ;
    sh:property ss026-sh:TextMessageConfig-nid_ntc ;
    sh:property ss026-sh:TextMessageConfig-l_textdisplay ;
    sh:property ss026-sh:TextMessageConfig-t_textdisplay ;
    sh:property ss026-sh:TextMessageConfig-m_modetextdisplay_e ;
    sh:property ss026-sh:TextMessageConfig-m_leveltextdisplay_e ;
    sh:property ss026-sh:TextMessageConfig-nid_ntc_e ;
    sh:property ss026-sh:TextMessageConfig-q_textconfirm ;
    sh:property ss026-sh:TextMessageConfig-q_conftextdisplay ;
    sh:property ss026-sh:TextMessageConfig-q_textreport ;
    sh:property ss026-sh:TextMessageConfig-nid_textmessage ;
    sh:property ss026-sh:TextMessageConfig-nid_c ;
    sh:property ss026-sh:TextMessageConfig-nid_rbc ;
    sh:severity sh:Violation ;
    .

ss026-sh:TextMessageConfig-q_textclass
    a sh:PropertyShape ;
    sh:path era:q_textclass ;
    sh:name "q_textclass" ;
    sh:description "Class of message to be displayed (Q_TEXTCLASS specifies the class of the text message included in the same packet (either plain or fixed message))" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/text-class/auxiliary> <http://data.europa.eu/949/concepts/text-class/important> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TextClass concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:TextMessageConfig-q_textdisplay
    a sh:PropertyShape ;
    sh:path era:q_textdisplay ;
    sh:name "q_textdisplay" ;
