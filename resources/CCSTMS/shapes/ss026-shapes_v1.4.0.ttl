### ETCSTrackToTrainPacket_65 #########################################
ss026-sh:ETCSTrackToTrainPacket_65Shape
    a sh:NodeShape ;
    sh:targetClass era:ETCSTrackToTrainPacket_65 ;
    sh:name "ETCSTrackToTrainPacket_65" ;
    sh:description "Temporary Speed Restriction (Transmission of temporary speed restriction)" ;
    sh:sparql ss026-sh:ETCSTrackToTrainPacket_65-v_tsr-multipleOf ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_65-nid_tsr ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_65-d_tsr ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_65-l_tsr ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_65-q_front ;
    sh:property ss026-sh:ETCSTrackToTrainPacket_65-v_tsr ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_65-nid_tsr
    a sh:PropertyShape ;
    sh:path era:nid_tsr ;
    sh:name "nid_tsr" ;
    sh:description "Identity number of Temporary Speed Restriction" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_65-d_tsr
    a sh:PropertyShape ;
    sh:path era:d_tsr ;
    sh:name "d_tsr" ;
    sh:description "Distance to beginning of temporary speed restriction" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_65-l_tsr
    a sh:PropertyShape ;
    sh:path era:l_tsr ;
    sh:name "l_tsr" ;
    sh:description "Length of the temporary speed restriction" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_65-q_front
    a sh:PropertyShape ;
    sh:path era:q_front ;
    sh:name "q_front" ;
    sh:description "Qualifier for validity end point of profile element (Qualifier to indicate if a speed limit given for a profile element is to be applied until the front of the train (no train length delay) or the end of the train (train length delay) has left the element)" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_65-v_tsr
    a sh:PropertyShape ;
    sh:path era:v_tsr ;
    sh:name "v_tsr" ;
    sh:description "Permitted speed for the temporary speed restriction." ;
    sh:order 5 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:ETCSTrackToTrainPacket_65-v_tsr-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes ss026-sh:PrefixDeclarations ;
    sh:message "v_tsr must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:v_tsr ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

