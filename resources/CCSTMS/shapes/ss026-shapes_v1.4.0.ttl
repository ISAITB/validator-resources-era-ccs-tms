    a sh:NodeShape ;
    sh:targetClass era:TrainToTrackRM ;
    sh:name "TrainToTrackRM" ;
    sh:description "Message-specific content of the Train-to-Track Radio Message, containing the variables and packets defined for the specific message type" ;
    sh:xone (
        ss026-sh:TrainToTrackRM-trainToTrackRM_129-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_130-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_131-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_132-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_133-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_136-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_137-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_138-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_146-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_147-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_149-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_150-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_153-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_154-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_155-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_156-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_157-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_158-present
        ss026-sh:TrainToTrackRM-trainToTrackRM_159-present
    ) ;
    sh:message "TrainToTrackRM is a union: exactly one of (trainToTrackRM_129, trainToTrackRM_130, trainToTrackRM_131, trainToTrackRM_132, trainToTrackRM_133, trainToTrackRM_136, trainToTrackRM_137, trainToTrackRM_138, trainToTrackRM_146, trainToTrackRM_147, trainToTrackRM_149, trainToTrackRM_150, trainToTrackRM_153, trainToTrackRM_154, trainToTrackRM_155, trainToTrackRM_156, trainToTrackRM_157, trainToTrackRM_158, trainToTrackRM_159) must be present."@en ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_129 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_130 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_131 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_132 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_133 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_136 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_137 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_138 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_146 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_147 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_149 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_150 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_153 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_154 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_155 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_156 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_157 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_158 ;
    sh:property ss026-sh:TrainToTrackRM-trainToTrackRM_159 ;
    sh:severity sh:Violation ;
    .

