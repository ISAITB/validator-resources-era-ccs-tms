    sh:property ss026-sh:ETCSTrackToTrainRM_4-q_scale ;
    sh:property ss026-sh:ETCSTrackToTrainRM_4-d_ref ;
    sh:property ss026-sh:ETCSTrackToTrainRM_4-v_sm ;
