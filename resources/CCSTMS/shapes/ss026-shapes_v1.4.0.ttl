    sh:description "Length of section in the MA" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:SectionTimer-q_sectionTimer
    a sh:PropertyShape ;
    sh:path era:q_sectionTimer ;
