### PBDSelection ######################################################
ss026-sh:PBDSelectionShape
    a sh:NodeShape ;
    sh:targetClass era:PBDSelection ;
    sh:name "PBDSelection" ;
    sh:description "Defines the selection criteria for Permitted Braking Distance (PBD) constraints, ensuring safe braking within defined limits. This includes parameters such as braking distance, gradient slope, speed restrictions, and braking mode qualifiers, which influence braking performance calculations." ;
    sh:property ss026-sh:PBDSelection-d_pbd ;
    sh:property ss026-sh:PBDSelection-q_gdir ;
    sh:property ss026-sh:PBDSelection-g_pbdsr ;
    sh:property ss026-sh:PBDSelection-q_pbdsr ;
    sh:property ss026-sh:PBDSelection-d_pbdsr ;
    sh:property ss026-sh:PBDSelection-l_pbdsr ;
    sh:severity sh:Violation ;
    .

ss026-sh:PBDSelection-d_pbd
    a sh:PropertyShape ;
    sh:path era:d_pbd ;
    sh:name "d_pbd" ;
    sh:description "Permitted Braking Distance. Only if Q_TRACKINIT = 0, D_PBDand the following variables follow" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:PBDSelection-q_gdir
    a sh:PropertyShape ;
    sh:path era:q_gdir ;
    sh:name "q_gdir" ;
    sh:description "Qualifier for gradient slope. Note: 0 = downhill, 1 = uphill" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:PBDSelection-g_pbdsr
    a sh:PropertyShape ;
    sh:path era:g_pbdsr ;
    sh:name "g_pbdsr" ;
    sh:description "Default gradient for PBD Speed restriction (Defines a default gradient to be used for calculation of speed restriction to ensure permitted braking distance.)" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:PBDSelection-q_pbdsr
    a sh:PropertyShape ;
    sh:path era:q_pbdsr ;
    sh:name "q_pbdsr" ;
    sh:description "Qualifier for Permitted Braking Distance (Qualifier defining whether the permitted braking distance is to be achieved with the Service Brake or Emergency Brake)" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:PBDSelection-d_pbdsr
    a sh:PropertyShape ;
    sh:path era:d_pbdsr ;
    sh:name "d_pbdsr" ;
    sh:description "Incremental distance to the start of the next speed restriction to ensure permitted braking distance." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

ss026-sh:PBDSelection-l_pbdsr
    a sh:PropertyShape ;
    sh:path era:l_pbdsr ;
    sh:name "l_pbdsr" ;
    sh:description "Length of speed restriction to ensure permitted braking distance." ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 327670.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

