        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_3 must have exactly one a_nvmaxredadh3 (unsigned integer 0-63, max reduced adhesion factor 3)."@en ;
        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für a_nvmaxredadh3 haben (vorzeichenlose Ganzzahl 0-63, max reduced adhesion factor 3)."@de ;
