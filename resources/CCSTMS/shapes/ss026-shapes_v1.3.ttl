        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für d_validnv haben (vorzeichenlose Ganzzahl 0-32767, validity distance for national values)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour d_validnv (entier non signé 0-32767, validity distance for national values)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Speed-related national values
