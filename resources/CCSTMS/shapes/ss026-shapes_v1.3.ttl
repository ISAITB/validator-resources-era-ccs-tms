        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_3 must have exactly one d_nvstff (unsigned integer 0-32767, Staff Responsible distance)."@en ;
        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für d_nvstff haben (vorzeichenlose Ganzzahl 0-32767, Staff Responsible distance)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour d_nvstff (entier non signé 0-32767, Staff Responsible distance)."@fr ;
