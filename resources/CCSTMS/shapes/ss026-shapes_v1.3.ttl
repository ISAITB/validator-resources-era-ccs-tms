        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_3 must have exactly one t_nvcontact (unsigned integer 0-255, max time for driver contact in seconds)."@en ;
        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für t_nvcontact haben (vorzeichenlose Ganzzahl 0-255, max time for driver contact in Sekunden)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour t_nvcontact (entier non signé 0-255, max time for driver contact en secondes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    sh:property [ 
