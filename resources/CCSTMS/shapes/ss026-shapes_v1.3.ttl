        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für a_nvmaxredadh1 haben (vorzeichenlose Ganzzahl 0-63, max reduced adhesion factor 1)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour a_nvmaxredadh1 (entier non signé 0-63, max reduced adhesion factor 1)."@fr ;
        sh:severity sh:Violation ;
