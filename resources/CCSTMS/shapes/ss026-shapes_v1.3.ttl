        sh:message "Each ETCSPacket_3 must have exactly one d_nvpotrp (unsigned integer 0-32767, post-trip distance)."@en ;
        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für d_nvpotrp haben (vorzeichenlose Ganzzahl 0-32767, post-trip distance)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour d_nvpotrp (entier non signé 0-32767, post-trip distance)."@fr ;
