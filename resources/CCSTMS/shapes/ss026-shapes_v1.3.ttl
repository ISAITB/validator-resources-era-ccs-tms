        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour v_nvallowovtrp (entier non signé 0-127, allowed override trip vitesse en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Distance-related national values
    sh:property [ 
