    ] ;
    
    sh:property [ 
        sh:path era:q_nvsbfbperm ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_3 must have exactly one q_nvsbfbperm (boolean, service brake feedback permission)."@en ;
        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für q_nvsbfbperm haben (boolescher Wert, service brake feedback permission)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour q_nvsbfbperm (booléen, service brake feedback permission)."@fr ;
