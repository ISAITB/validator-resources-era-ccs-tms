        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für q_nvsbtsmperm haben (boolescher Wert, service brake test permission)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour q_nvsbtsmperm (booléen, service brake test permission)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Emergency brake confidence level
    sh:property [ 
        sh:path era:m_nvebcl ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 15 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_3 must have exactly one m_nvebcl (unsigned integer 0-15, emergency brake confidence level)."@en ;
        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für m_nvebcl haben (vorzeichenlose Ganzzahl 0-15, emergency brake confidence level)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour m_nvebcl (entier non signé 0-15, emergency brake confidence level)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_NVCONTACT (required, controlled vocabulary - contact reaction)
    sh:property [ 
        sh:path era:mNvcontact ;
        sh:in (
            <http://data.europa.eu/949/concepts/etcs-reactions-contact/trainTrip>
            <http://data.europa.eu/949/concepts/etcs-reactions-contact/applyServiceBrake>
            <http://data.europa.eu/949/concepts/etcs-reactions-contact/noReaction>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property mNvcontact must have a value from the defined SKOS concept scheme (trainTrip, applyServiceBrake, or noReaction)."@en ;
        sh:message "Die Eigenschaft mNvcontact muss einen Wert aus dem definierten SKOS-Konzeptschema haben (trainTrip, applyServiceBrake, or noReaction)."@de ;
        sh:message "La propriété mNvcontact doit avoir une valeur issue du schéma de concepts SKOS défini (trainTrip, applyServiceBrake, or noReaction)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NVKs (optional, national value correction factors)
    sh:property [ 
        sh:path era:nVKs ;
        sh:node era:NVKShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "An ETCSPacket_3 may have at most one nVKs that conforms to NVK object."@en ;
        sh:message "Ein ETCSPacket_3 kann höchstens einen nVKs-Eintrag/Einträge haben, der/die der Form NVK entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_3 peut avoir au plus une entrée(s) nVKs, conforme(s) à la forme NVK."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== ETCS Packet 40 Shape =====
era:ETCSPacket_40Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_40 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 40 (Track condition: change of allowed current consumption) is missing its d_current or m_current value, or a value is outside the valid range. Both fields are required to define the distance to and new maximum current value."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 40 (Streckenbedingung: Änderung der zulässigen Stromaufnahme) der Wert d_current oder m_current fehlt oder außerhalb des gültigen Bereichs liegt. Beide Felder sind erforderlich, um Entfernung und neuen Höchstwert zu definieren."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 40 (condition de voie : changement de consommation de courant autorisée) ne précise pas sa valeur d_current ou m_current, ou qu'une valeur est hors de la plage valide. Les deux champs sont requis pour définir la distance et la nouvelle valeur maximale."@fr ;
    sh:message "ETCS Packet 40 - Track Condition - Change of Allowed Current Consumption."@en ;
    sh:message "ETCS Paket 40 - Streckenbedingung - Änderung der zulässigen Stromaufnahme."@de ;
    sh:message "Paquet ETCS 40 - Condition de voie - changement de la consommation de courant autorisée."@fr ;
    
    # D_CURRENT (required, unsigned integer 0-32767 - distance to current limitation change)
    sh:property [ 
        sh:path era:d_current ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_40 must have exactly one d_current (unsigned integer 0-32767, distance to current consumption change)."@en ;
        sh:message "Jedes ETCSPacket_40 muss genau einen Wert für d_current haben (vorzeichenlose Ganzzahl 0-32767, distance to current consumption change)."@de ;
        sh:message "Chaque ETCSPacket_40 doit avoir exactement une valeur pour d_current (entier non signé 0-32767, distance to current consumption change)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_CURRENT (required, unsigned integer 0-1023 - maximum allowed current in amperes)
    sh:property [ 
        sh:path era:m_current ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_40 must have exactly one m_current (unsigned integer 0-1023, maximum current in amperes)."@en ;
        sh:message "Jedes ETCSPacket_40 muss genau einen Wert für m_current haben (vorzeichenlose Ganzzahl 0-1023, maximum current in amperes)."@de ;
        sh:message "Chaque ETCSPacket_40 doit avoir exactement une valeur pour m_current (entier non signé 0-1023, maximum current in amperes)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 41 Shape =====
era:ETCSPacket_41Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_41 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 41 (Level Transition Order) is missing its d_leveltr, m_leveltr, or l_ackleveltr value, or a value is outside its valid range, or m_leveltr is not one of the defined ETCS levels. These fields are required to identify the distance, target level and acknowledgement length for a level transition."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 41 (Übergangsauftrag ETCS-Level) der Wert d_leveltr, m_leveltr oder l_ackleveltr fehlt, außerhalb des gültigen Bereichs liegt oder m_leveltr keinem der definierten ETCS-Level entspricht. Diese Felder sind erforderlich, um Entfernung, Ziel-Level und Quittierungslänge für einen Levelübergang anzugeben."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 41 (ordre de transition de niveau) ne précise pas sa valeur d_leveltr, m_leveltr ou l_ackleveltr, qu'une valeur est hors de sa plage valide, ou que m_leveltr ne correspond à aucun des niveaux ETCS définis. Ces champs sont requis pour identifier la distance, le niveau cible et la longueur d'accusé de réception d'une transition de niveau."@fr ;
    sh:message "ETCS Packet 41 - Level Transition Order."@en ;
    sh:message "ETCS Paket 41 - Übergangsauftrag ETCS-Level."@de ;
    sh:message "Paquet ETCS 41 - Ordre de transition de niveau."@fr ;
    
    # D_LEVELTR (required, unsigned integer 0-32767 - distance to level transition)
    sh:property [ 
        sh:path era:d_leveltr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_41 must have exactly one d_leveltr (unsigned integer 0-32767, distance to level transition point)."@en ;
        sh:message "Jedes ETCSPacket_41 muss genau einen Wert für d_leveltr haben (vorzeichenlose Ganzzahl 0-32767, distance to level transition point)."@de ;
        sh:message "Chaque ETCSPacket_41 doit avoir exactement une valeur pour d_leveltr (entier non signé 0-32767, distance to level transition point)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_LEVELTR (required, controlled vocabulary - target ETCS level)
    sh:property [ 
        sh:path era:m_leveltr ;
        sh:in (
            <http://data.europa.eu/949/concepts/etcs-levels/level0>
            <http://data.europa.eu/949/concepts/etcs-levels/levelNTC>
            <http://data.europa.eu/949/concepts/etcs-levels/level1>
            <http://data.europa.eu/949/concepts/etcs-levels/level2>
            <http://data.europa.eu/949/concepts/etcs-levels/level3>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_leveltr must have a value from the defined SKOS concept scheme (level0, level1, level2, level3, or levelNTC)."@en ;
        sh:message "Die Eigenschaft m_leveltr muss einen Wert aus dem definierten SKOS-Konzeptschema haben (level0, level1, level2, level3, or levelNTC)."@de ;
        sh:message "La propriété m_leveltr doit avoir une valeur issue du schéma de concepts SKOS défini (level0, level1, level2, level3, or levelNTC)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_NTC (required, unsigned integer 0-255 - National Train Control system ID)
    sh:property [ 
        sh:path era:nid_ntc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_41 must have exactly one nid_ntc (unsigned integer 0-255, NTC system identifier)."@en ;
        sh:message "Jedes ETCSPacket_41 muss genau einen Wert für nid_ntc haben (vorzeichenlose Ganzzahl 0-255, NTC system Kennung)."@de ;
        sh:message "Chaque ETCSPacket_41 doit avoir exactement une valeur pour nid_ntc (entier non signé 0-255, NTC system identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_ACKLEVELTR (required, unsigned integer 0-32767 - acknowledgement length)
    sh:property [ 
        sh:path era:l_ackleveltr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_41 must have exactly one l_ackleveltr (unsigned integer 0-32767, acknowledgement length)."@en ;
        sh:message "Jedes ETCSPacket_41 muss genau einen Wert für l_ackleveltr haben (vorzeichenlose Ganzzahl 0-32767, acknowledgement length)."@de ;
        sh:message "Chaque ETCSPacket_41 doit avoir exactement une valeur pour l_ackleveltr (entier non signé 0-32767, acknowledgement length)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Level Transition With Acknowledgement (optional, up to 32 allowed)
    sh:property [ 
        sh:path era:levelTransitionWithAck ;
        sh:node era:LevelTransitionWithAckShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 32 ;
        sh:message "An ETCSPacket_41 may have at most 32 levelTransitionWithAck that conform to LevelTransitionWithAck object."@en ;
        sh:message "Ein ETCSPacket_41 kann höchstens 32 levelTransitionWithAck-Eintrag/Einträge haben, der/die der Form LevelTransitionWithAck entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_41 peut avoir au plus 32 entrée(s) levelTransitionWithAck, conforme(s) à la forme LevelTransitionWithAck."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 42 Shape =====
era:ETCSPacket_42Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_42 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 42 (Session Management) is missing its q_rbc or q_sleepsession value, or a value is outside its valid range. q_rbc and q_sleepsession are required to indicate whether the order is to establish or terminate an RBC session."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 42 (Sitzungsverwaltung) der Wert q_rbc oder q_sleepsession fehlt oder außerhalb des gültigen Bereichs liegt. q_rbc und q_sleepsession sind erforderlich, um anzugeben, ob eine RBC-Sitzung auf- oder abgebaut werden soll."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 42 (gestion de session) ne précise pas sa valeur q_rbc ou q_sleepsession, ou qu'une valeur est hors de sa plage valide. q_rbc et q_sleepsession sont requis pour indiquer si l'ordre est d'établir ou de terminer une session RBC."@fr ;
    sh:message "ETCS Packet 42 - Session Management."@en ;
    sh:message "ETCS Paket 42 - Sitzungsverwaltung."@de ;
    sh:message "Paquet ETCS 42 - Gestion de session."@fr ;
    
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_42 must have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes ETCSPacket_42 muss genau einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque ETCSPacket_42 doit avoir exactement une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_RBC (required, unsigned integer 0-16383 - Radio Block Centre identity)
    sh:property [ 
        sh:path era:nid_rbc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_42 must have exactly one nid_rbc (unsigned integer 0-16383, RBC identifier)."@en ;
        sh:message "Jedes ETCSPacket_42 muss genau einen Wert für nid_rbc haben (vorzeichenlose Ganzzahl 0-16383, RBC Kennung)."@de ;
        sh:message "Chaque ETCSPacket_42 doit avoir exactement une valeur pour nid_rbc (entier non signé 0-16383, RBC identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_RBC (required, boolean - RBC type qualifier)
    sh:property [ 
        sh:path era:q_rbc ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_42 must have exactly one q_rbc (boolean, RBC type: start/terminate session)."@en ;
        sh:message "Jedes ETCSPacket_42 muss genau einen Wert für q_rbc haben (boolescher Wert, RBC type: start/terminate session)."@de ;
        sh:message "Chaque ETCSPacket_42 doit avoir exactement une valeur pour q_rbc (booléen, RBC type: start/terminate session)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_SLEEPSESSION (required, boolean - sleep session permitted)
    sh:property [ 
        sh:path era:q_sleepsession ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_42 must have exactly one q_sleepsession (boolean, whether sleep session is allowed)."@en ;
        sh:message "Jedes ETCSPacket_42 muss genau einen Wert für q_sleepsession haben (boolescher Wert, whether sleep session is allowed)."@de ;
        sh:message "Chaque ETCSPacket_42 doit avoir exactement une valeur pour q_sleepsession (booléen, whether sleep session is allowed)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_RADIO (optional, string - radio network identity/phone number)
    sh:property [ 
        sh:path era:nid_radio ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "An ETCSPacket_42 may have at most one nid_radio (string, radio network ID or phone number for RBC)."@en ;
        sh:message "Ein ETCSPacket_42 kann höchstens einen Wert für nid_radio haben (Zeichenkette, radio network ID or phone number for RBC)."@de ;
        sh:message "Un ETCSPacket_42 peut avoir au plus une valeur pour nid_radio (chaîne de caractères, radio network ID or phone number for RBC)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 44 Shape =====
era:ETCSPacket_44Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_44 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 44 (Data for applications outside ERTMS/ETCS) is missing its nid_xuser or otherData value, or a value is outside its valid range. nid_xuser and otherData are required to identify the target external system and carry its data."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 44 (Daten für Anwendungen außerhalb ERTMS/ETCS) der Wert nid_xuser oder otherData fehlt oder außerhalb des gültigen Bereichs liegt. nid_xuser und otherData sind erforderlich, um das externe Zielsystem zu identifizieren und dessen Daten zu übertragen."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 44 (données pour applications extérieures à l'ERTMS/ETCS) ne précise pas sa valeur nid_xuser ou otherData, ou qu'une valeur est hors de sa plage valide. nid_xuser et otherData sont requis pour identifier le système externe cible et transporter ses données."@fr ;
    sh:message "ETCS Packet 44 - Data Used by Applications Outside the ERTMS/ETCS System."@en ;
    sh:message "ETCS Paket 44 - Daten für Anwendungen außerhalb des ERTMS/ETCS-Systems."@de ;
    sh:message "Paquet ETCS 44 - Données utilisées par des applications extérieures au système ERTMS/ETCS."@fr ;
    
    # NID_NTC (required, unsigned integer 0-255 - National Train Control system ID)
    sh:property [ 
        sh:path era:nid_ntc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_44 must have exactly one nid_ntc (unsigned integer 0-255, NTC system identifier)."@en ;
        sh:message "Jedes ETCSPacket_44 muss genau einen Wert für nid_ntc haben (vorzeichenlose Ganzzahl 0-255, NTC system Kennung)."@de ;
        sh:message "Chaque ETCSPacket_44 doit avoir exactement une valeur pour nid_ntc (entier non signé 0-255, NTC system identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_XUSER (required, unsigned integer 0-511 - external user identity)
    sh:property [ 
        sh:path era:nid_xuser ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 511 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_44 must have exactly one nid_xuser (unsigned integer 0-511, external user/application identifier)."@en ;
        sh:message "Jedes ETCSPacket_44 muss genau einen Wert für nid_xuser haben (vorzeichenlose Ganzzahl 0-511, external user/application Kennung)."@de ;
        sh:message "Chaque ETCSPacket_44 doit avoir exactement une valeur pour nid_xuser (entier non signé 0-511, external user/application identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Other Data (required, base64Binary - application-specific data)
    sh:property [ 
        sh:path era:otherData ;
        sh:datatype xsd:base64Binary ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_44 must have exactly one otherData (base64Binary, external system data)."@en ;
        sh:message "Jedes ETCSPacket_44 muss genau einen Wert für otherData haben (base64Binary, external system data)."@de ;
        sh:message "Chaque ETCSPacket_44 doit avoir exactement une valeur pour otherData (base64Binary, external system data)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 45 Shape =====
era:ETCSPacket_45Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_45 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 45 (Radio network registration) is missing its nid_mn value. This field is required and identifies the radio network with which the onboard shall register."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 45 (Funknetz-Registrierung) der Wert nid_mn fehlt. Dieses Feld ist erforderlich und identifiziert das Funknetz, bei dem sich das Fahrzeuggerät registrieren soll."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 45 (enregistrement au réseau radio) ne précise pas sa valeur nid_mn. Ce champ est requis et identifie le réseau radio auprès duquel le système embarqué doit s'enregistrer."@fr ;
    sh:message "ETCS Packet 45 - Radio Network Registration."@en ;
    sh:message "ETCS Paket 45 - Funknetz-Registrierung."@de ;
    sh:message "Paquet ETCS 45 - Enregistrement au réseau radio."@fr ;
    
    # NID_MN (required, string - mobile network identity)
    sh:property [ 
        sh:path era:nid_mn ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_45 must have exactly one nid_mn (string, mobile network identifier for GSM-R registration)."@en ;
        sh:message "Jedes ETCSPacket_45 muss genau einen Wert für nid_mn haben (Zeichenkette, mobile network Kennung for GSM-R registration)."@de ;
        sh:message "Chaque ETCSPacket_45 doit avoir exactement une valeur pour nid_mn (chaîne de caractères, mobile network identifiant for GSM-R registration)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 46 Shape =====
era:ETCSPacket_46Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_46 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 46 (Conditional Level Transition Order) is missing its m_leveltr value, the value is not one of the defined ETCS levels, or its levelTransitions list exceeds 31 entries. m_leveltr is required and gives the primary permitted level in the priority-ordered list."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 46 (Bedingter Übergangsauftrag) der Wert m_leveltr fehlt, keinem der definierten ETCS-Level entspricht oder die levelTransitions-Liste mehr als 31 Einträge enthält. m_leveltr ist erforderlich und gibt den primären zulässigen Level in der priorisierten Liste an."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 46 (ordre conditionnel de transition de niveau) ne précise pas sa valeur m_leveltr, que celle-ci ne correspond à aucun des niveaux ETCS définis, ou que sa liste levelTransitions dépasse 31 entrées. m_leveltr est requis et indique le niveau principal autorisé dans la liste priorisée."@fr ;
    sh:message "ETCS Packet 46 - Conditional Level Transition Order."@en ;
    sh:message "ETCS Paket 46 - Bedingter Übergangsauftrag ETCS-Level."@de ;
    sh:message "Paquet ETCS 46 - Ordre conditionnel de transition de niveau."@fr ;
    
    # M_LEVELTR (required, controlled vocabulary - target ETCS level)
    sh:property [ 
        sh:path era:m_leveltr ;
        sh:in (
            <http://data.europa.eu/949/concepts/etcs-levels/level0>
            <http://data.europa.eu/949/concepts/etcs-levels/levelNTC>
            <http://data.europa.eu/949/concepts/etcs-levels/level1>
            <http://data.europa.eu/949/concepts/etcs-levels/level2>
            <http://data.europa.eu/949/concepts/etcs-levels/level3>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_leveltr must have a value from the defined SKOS concept scheme (level0, level1, level2, level3, or levelNTC)."@en ;
        sh:message "Die Eigenschaft m_leveltr muss einen Wert aus dem definierten SKOS-Konzeptschema haben (level0, level1, level2, level3, or levelNTC)."@de ;
        sh:message "La propriété m_leveltr doit avoir une valeur issue du schéma de concepts SKOS défini (level0, level1, level2, level3, or levelNTC)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_NTC (required, unsigned integer 0-255 - National Train Control system ID)
    sh:property [ 
        sh:path era:nid_ntc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_46 may have exactly one nid_ntc (unsigned integer 0-255, NTC system identifier)."@en ;
        sh:message "Jedes ETCSPacket_46 kann höchstens einen Wert für nid_ntc haben (vorzeichenlose Ganzzahl 0-255, NTC system Kennung)."@de ;
        sh:message "Chaque ETCSPacket_46 peut avoir au plus une valeur pour nid_ntc (entier non signé 0-255, NTC system identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Level Transitions (optional, up to 31 conditional transitions)
    sh:property [ 
        sh:path era:levelTransitions ;
        sh:node era:LevelTransitionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 31 ;
        sh:message "An ETCSPacket_46 may have at most 31 levelTransitions that conform to LevelTransition object."@en ;
        sh:message "Ein ETCSPacket_46 kann höchstens 31 levelTransitions-Eintrag/Einträge haben, der/die der Form LevelTransition entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_46 peut avoir au plus 31 entrée(s) levelTransitions, conforme(s) à la forme LevelTransition."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== ETCS Packet 49 Shape =====
era:ETCSPacket_49Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_49 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 49 (List of balises for SH area) has a countryBalises list exceeding 31 entries, or one of its entries does not conform to the CountryBalise shape. This list identifies the balise groups the train may pass over while in Shunting mode."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 49 (Liste der Balisen für den Rangierbereich) die countryBalises-Liste mehr als 31 Einträge enthält oder ein Eintrag nicht der CountryBalise-Form entspricht. Diese Liste identifiziert die Balisengruppen, die der Zug im Rangiermodus überfahren darf."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 49 (liste des balises pour zone de manœuvre) a une liste countryBalises dépassant 31 entrées, ou qu'une entrée n'est pas conforme à la forme CountryBalise. Cette liste identifie les groupes de balises que le train peut franchir en mode manœuvre."@fr ;
    sh:message "ETCS Packet 49 - List of Balises for SH Area."@en ;
    sh:message "ETCS Paket 49 - Liste der Balisen für den Rangierbereich."@de ;
    sh:message "Paquet ETCS 49 - Liste des balises pour la zone de manœuvre."@fr ;
    
    # Country Balises (optional, up to 31 balise group references)
    sh:property [ 
        sh:path era:countryBalises ;
        sh:node era:CountryBaliseShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 31 ;
        sh:message "An ETCSPacket_49 may have at most 31 countryBalises that conform to CountryBalise object."@en ;
        sh:message "Ein ETCSPacket_49 kann höchstens 31 countryBalises-Eintrag/Einträge haben, der/die der Form CountryBalise entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_49 peut avoir au plus 31 entrée(s) countryBalises, conforme(s) à la forme CountryBalise."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 51 Shape =====
era:ETCSPacket_51Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_51 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 51 (Axle Load Speed Profile) is missing its q_trackinit value, or its axleLoadRestrictions or axleLoadSelections list exceeds 31 entries, or a distance/length value is outside its valid range. q_trackinit is required; the two lists together define speed restrictions per axle load category along the route."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 51 (Achslast-Geschwindigkeitsprofil) der Wert q_trackinit fehlt, die Liste axleLoadRestrictions oder axleLoadSelections mehr als 31 Einträge enthält oder ein Entfernungs-/Längenwert außerhalb des gültigen Bereichs liegt. q_trackinit ist erforderlich; die beiden Listen definieren gemeinsam die Geschwindigkeitsbeschränkungen je Achslastkategorie entlang der Strecke."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 51 (profil de vitesse selon la charge à l'essieu) ne précise pas sa valeur q_trackinit, que sa liste axleLoadRestrictions ou axleLoadSelections dépasse 31 entrées, ou qu'une valeur de distance/longueur est hors de sa plage valide. q_trackinit est requis; les deux listes définissent ensemble les restrictions de vitesse par catégorie de charge à l'essieu le long de l'itinéraire."@fr ;
    sh:message "ETCS Packet 51 - Axle Load Speed Profile."@en ;
    sh:message "ETCS Paket 51 - Achslast-Geschwindigkeitsprofil."@de ;
    sh:message "Paquet ETCS 51 - Profil de vitesse selon la charge à l'essieu."@fr ;
    
    # D_TRACKINIT (required, unsigned integer 0-32767 - distance to profile start)
    sh:property [ 
        sh:path era:d_trackinit ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_51 may have exactly one d_trackinit (unsigned integer 0-32767, distance to track description start)."@en ;
        sh:message "Jedes ETCSPacket_51 kann höchstens einen Wert für d_trackinit haben (vorzeichenlose Ganzzahl 0-32767, distance to track description start)."@de ;
        sh:message "Chaque ETCSPacket_51 peut avoir au plus une valeur pour d_trackinit (entier non signé 0-32767, distance to track description start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_TRACKINIT (required, boolean - initial/update indicator)
    sh:property [ 
        sh:path era:q_trackinit ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_51 must have exactly one q_trackinit (boolean, initial or update profile)."@en ;
        sh:message "Jedes ETCSPacket_51 muss genau einen Wert für q_trackinit haben (boolescher Wert, initial or update profile)."@de ;
        sh:message "Chaque ETCSPacket_51 doit avoir exactement une valeur pour q_trackinit (booléen, initial or update profile)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # D_AXLELOAD (required, unsigned integer 0-32767 - distance to axle load start)
    sh:property [ 
        sh:path era:d_axleload ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_51 may have exactly one d_axleload (unsigned integer 0-32767, distance to axle load profile start)."@en ;
        sh:message "Jedes ETCSPacket_51 kann höchstens einen Wert für d_axleload haben (vorzeichenlose Ganzzahl 0-32767, distance to axle load profile start)."@de ;
        sh:message "Chaque ETCSPacket_51 peut avoir au plus une valeur pour d_axleload (entier non signé 0-32767, distance to axle load profile start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_AXLELOAD (required, unsigned integer 0-32767 - length of profile)
    sh:property [ 
        sh:path era:l_axleload ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_51 may have exactly one l_axleload (unsigned integer 0-32767, length of axle load profile)."@en ;
        sh:message "Jedes ETCSPacket_51 kann höchstens einen Wert für l_axleload haben (vorzeichenlose Ganzzahl 0-32767, length of axle load profile)."@de ;
        sh:message "Chaque ETCSPacket_51 peut avoir au plus une valeur pour l_axleload (entier non signé 0-32767, length of axle load profile)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_FRONT (optional, boolean - applies to train front only)
    sh:property [ 
        sh:path era:q_front ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "An ETCSPacket_51 may have at most one q_front (boolean, applies to train front)."@en ;
        sh:message "Ein ETCSPacket_51 kann höchstens einen Wert für q_front haben (boolescher Wert, applies to train front)."@de ;
        sh:message "Un ETCSPacket_51 peut avoir au plus une valeur pour q_front (booléen, applies to train front)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Axle Load Restrictions (optional, up to 31 restrictions)
    sh:property [ 
        sh:path era:axleLoadRestrictions ;
        sh:node era:AxleLoadRestrictionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 31 ;
        sh:message "An ETCSPacket_51 may have at most 31 axleLoadRestrictions that conform to AxleLoadRestriction object."@en ;
        sh:message "Ein ETCSPacket_51 kann höchstens 31 axleLoadRestrictions-Eintrag/Einträge haben, der/die der Form AxleLoadRestriction entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_51 peut avoir au plus 31 entrée(s) axleLoadRestrictions, conforme(s) à la forme AxleLoadRestriction."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Axle Load Selections (optional, up to 31 selections)
    sh:property [ 
        sh:path era:axleLoadSelections ;
        sh:node era:AxleLoadSelectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 31 ;
        sh:message "An ETCSPacket_51 may have at most 31 axleLoadSelections that conform to AxleLoadSelection object."@en ;
        sh:message "Ein ETCSPacket_51 kann höchstens 31 axleLoadSelections-Eintrag/Einträge haben, der/die der Form AxleLoadSelection entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_51 peut avoir au plus 31 entrée(s) axleLoadSelections, conforme(s) à la forme AxleLoadSelection."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 52 Shape =====
era:ETCSPacket_52Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_52 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 52 (Permitted Braking Distance information) is missing its q_trackinit value, or its pbdSelection list exceeds 32 entries. q_trackinit is required; pbdSelection defines the braking-distance-related speed restrictions to be calculated by the onboard."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 52 (Informationen zur zulässigen Bremsweglänge) der Wert q_trackinit fehlt oder die pbdSelection-Liste mehr als 32 Einträge enthält. q_trackinit ist erforderlich; pbdSelection definiert die vom Fahrzeuggerät zu berechnenden bremswegbezogenen Geschwindigkeitsbeschränkungen."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 52 (informations sur la distance de freinage autorisée) ne précise pas sa valeur q_trackinit, ou que sa liste pbdSelection dépasse 32 entrées. q_trackinit est requis; pbdSelection définit les restrictions de vitesse liées à la distance de freinage à calculer par le système embarqué."@fr ;
    sh:message "ETCS Packet 52 - Permitted Braking Distance Information."@en ;
    sh:message "ETCS Paket 52 - Informationen zur zulässigen Bremsweglänge."@de ;
    sh:message "Paquet ETCS 52 - Informations sur la distance de freinage autorisée."@fr ;
    
    # D_TRACKINIT (required, unsigned integer 0-32767 - distance to profile start)
    sh:property [ 
        sh:path era:d_trackinit ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_52 may have exactly one d_trackinit (unsigned integer 0-32767, distance to track description start)."@en ;
        sh:message "Jedes ETCSPacket_52 kann höchstens einen Wert für d_trackinit haben (vorzeichenlose Ganzzahl 0-32767, distance to track description start)."@de ;
        sh:message "Chaque ETCSPacket_52 peut avoir au plus une valeur pour d_trackinit (entier non signé 0-32767, distance to track description start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_TRACKINIT (required, boolean - initial/update indicator)
    sh:property [ 
        sh:path era:q_trackinit ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_52 must have exactly one q_trackinit (boolean, initial or update profile)."@en ;
        sh:message "Jedes ETCSPacket_52 muss genau einen Wert für q_trackinit haben (boolescher Wert, initial or update profile)."@de ;
        sh:message "Chaque ETCSPacket_52 doit avoir exactement une valeur pour q_trackinit (booléen, initial or update profile)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # PBD Selection (optional, up to 32 braking distance selections)
    sh:property [ 
        sh:path era:pbdSelection ;
        sh:node era:PBDSelectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 32 ;
        sh:message "An ETCSPacket_52 may have at most 32 pbdSelection that conform to PBDSelection object."@en ;
        sh:message "Ein ETCSPacket_52 kann höchstens 32 pbdSelection-Eintrag/Einträge haben, der/die der Form PBDSelection entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_52 peut avoir au plus 32 entrée(s) pbdSelection, conforme(s) à la forme PBDSelection."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 5 Shape =====
era:ETCSPacket_5Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_5 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 5 (Linking) has a links list that is empty or exceeds 33 entries, or one of its entries does not conform to the LinkItem shape. Between 1 and 33 links are required, giving the balise groups the onboard should expect to encounter next."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 5 (Verknüpfung) die links-Liste leer ist oder mehr als 33 Einträge enthält, oder ein Eintrag nicht der LinkItem-Form entspricht. Es sind 1 bis 33 Links erforderlich, die angeben, welche Balisengruppen das Fahrzeuggerät als Nächstes erwarten soll."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 5 (liaison) a une liste links vide ou dépassant 33 entrées, ou qu'une entrée n'est pas conforme à la forme LinkItem. Entre 1 et 33 liens sont requis, indiquant les groupes de balises que le système embarqué doit s'attendre à rencontrer ensuite."@fr ;
    sh:message "ETCS Packet 5 - Linking."@en ;
    sh:message "ETCS Paket 5 - Verknüpfung."@de ;
    sh:message "Paquet ETCS 5 - Liaison."@fr ;
    
    # Links (required, 1-33 link items for train positioning)
    sh:property [ 
        sh:path era:links ;
        sh:node era:LinkItemShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 33 ;
        sh:message "Each ETCSPacket_5 must have between 1 and 33 links that conform to LinkItem object."@en ;
        sh:message "Jedes ETCSPacket_5 muss zwischen 1 und 33 links-Einträge enthalten, die der Form LinkItem entsprechen."@de ;
        sh:message "Chaque ETCSPacket_5 doit contenir entre 1 et 33 entrées links, conformes à la forme LinkItem."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 65 Shape =====
era:ETCSPacket_65Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_65 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 65 (Temporary Speed Restriction) is missing one of its required fields — nid_tsr, d_tsr, l_tsr, v_tsr, or q_front — or a value is outside its valid range. All five fields are required to define the identity, distance, length, speed and validity qualifier of the restriction."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 65 (Temporäre Geschwindigkeitsbeschränkung) eines der erforderlichen Felder — nid_tsr, d_tsr, l_tsr, v_tsr oder q_front — fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Alle fünf Felder sind erforderlich, um Kennung, Entfernung, Länge, Geschwindigkeit und Gültigkeitsqualifizierer der Beschränkung zu definieren."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 65 (restriction temporaire de vitesse) ne précise pas l'un de ses champs requis — nid_tsr, d_tsr, l_tsr, v_tsr ou q_front — ou qu'une valeur est hors de sa plage valide. Les cinq champs sont requis pour définir l'identité, la distance, la longueur, la vitesse et le qualificateur de validité de la restriction."@fr ;
    sh:message "ETCS Packet 65 - Temporary Speed Restriction."@en ;
    sh:message "ETCS Paket 65 - Temporäre Geschwindigkeitsbeschränkung."@de ;
    sh:message "Paquet ETCS 65 - Restriction temporaire de vitesse."@fr ;
    
    # NID_TSR (required, unsigned integer 0-255 - TSR identity)
    sh:property [ 
        sh:path era:nid_tsr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_65 must have exactly one nid_tsr (unsigned integer 0-255, temporary speed restriction identifier)."@en ;
        sh:message "Jedes ETCSPacket_65 muss genau einen Wert für nid_tsr haben (vorzeichenlose Ganzzahl 0-255, temporary speed restriction Kennung)."@de ;
        sh:message "Chaque ETCSPacket_65 doit avoir exactement une valeur pour nid_tsr (entier non signé 0-255, temporary speed restriction identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # D_TSR (required, unsigned integer 0-32767 - distance to TSR start)
    sh:property [ 
        sh:path era:d_tsr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_65 must have exactly one d_tsr (unsigned integer 0-32767, distance to TSR start)."@en ;
        sh:message "Jedes ETCSPacket_65 muss genau einen Wert für d_tsr haben (vorzeichenlose Ganzzahl 0-32767, distance to TSR start)."@de ;
        sh:message "Chaque ETCSPacket_65 doit avoir exactement une valeur pour d_tsr (entier non signé 0-32767, distance to TSR start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_TSR (required, unsigned integer 0-32767 - length of TSR)
    sh:property [ 
        sh:path era:l_tsr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_65 must have exactly one l_tsr (unsigned integer 0-32767, length of TSR section)."@en ;
        sh:message "Jedes ETCSPacket_65 muss genau einen Wert für l_tsr haben (vorzeichenlose Ganzzahl 0-32767, length of TSR section)."@de ;
        sh:message "Chaque ETCSPacket_65 doit avoir exactement une valeur pour l_tsr (entier non signé 0-32767, length of TSR section)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # V_TSR (required, unsigned integer 0-127 - TSR speed in km/h)
    sh:property [ 
        sh:path era:v_tsr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_65 must have exactly one v_tsr (unsigned integer 0-127, temporary speed limit in km/h)."@en ;
        sh:message "Jedes ETCSPacket_65 muss genau einen Wert für v_tsr haben (vorzeichenlose Ganzzahl 0-127, temporary speed limit in km/h)."@de ;
        sh:message "Chaque ETCSPacket_65 doit avoir exactement une valeur pour v_tsr (entier non signé 0-127, temporary speed limit in km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_FRONT (required, boolean - applies to train front only)
    sh:property [ 
        sh:path era:q_front ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_65 must have exactly one q_front (boolean, applies to train front)."@en ;
        sh:message "Jedes ETCSPacket_65 muss genau einen Wert für q_front haben (boolescher Wert, applies to train front)."@de ;
        sh:message "Chaque ETCSPacket_65 doit avoir exactement une valeur pour q_front (booléen, applies to train front)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 66 Shape =====
era:ETCSPacket_66Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_66 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 66 (Temporary Speed Restriction Revocation) is missing its nid_tsr value or the value is outside the valid range. nid_tsr is the only field and identifies the TSR to be revoked."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 66 (Aufhebung einer temporären Geschwindigkeitsbeschränkung) der Wert nid_tsr fehlt oder außerhalb des gültigen Bereichs liegt. nid_tsr ist das einzige Feld und identifiziert die aufzuhebende TSR."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 66 (annulation d'une restriction temporaire de vitesse) ne précise pas sa valeur nid_tsr, ou que celle-ci est hors de la plage valide. nid_tsr est le seul champ et identifie la TSR à annuler."@fr ;
    sh:message "ETCS Packet 66 - Temporary Speed Restriction Revocation."@en ;
    sh:message "ETCS Paket 66 - Aufhebung einer temporären Geschwindigkeitsbeschränkung."@de ;
    sh:message "Paquet ETCS 66 - Annulation d'une restriction temporaire de vitesse."@fr ;
    
    # NID_TSR (required, unsigned integer 0-255 - TSR identity to revoke)
    sh:property [ 
        sh:path era:nid_tsr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_66 must have exactly one nid_tsr (unsigned integer 0-255, TSR identifier to revoke)."@en ;
        sh:message "Jedes ETCSPacket_66 muss genau einen Wert für nid_tsr haben (vorzeichenlose Ganzzahl 0-255, TSR Kennung to revoke)."@de ;
        sh:message "Chaque ETCSPacket_66 doit avoir exactement une valeur pour nid_tsr (entier non signé 0-255, TSR identifiant to revoke)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 67 Shape =====
era:ETCSPacket_67Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_67 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 67 (Track condition: big metal masses) has a dlTrackConditions list that is empty or exceeds 32 entries, or one of its entries does not conform to the DLTrackCond shape. Between 1 and 32 entries are required, each defining a zone where balise transmission integrity alarms should be ignored."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 67 (Streckenbedingung: große Metallmassen) die dlTrackConditions-Liste leer ist oder mehr als 32 Einträge enthält, oder ein Eintrag nicht der DLTrackCond-Form entspricht. Es sind 1 bis 32 Einträge erforderlich, die jeweils eine Zone definieren, in der Integritätsalarme der Balisenübertragung ignoriert werden sollen."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 67 (condition de voie : masses métalliques importantes) a une liste dlTrackConditions vide ou dépassant 32 entrées, ou qu'une entrée n'est pas conforme à la forme DLTrackCond. Entre 1 et 32 entrées sont requises, chacune définissant une zone où les alarmes d'intégrité de transmission des balises doivent être ignorées."@fr ;
    sh:message "ETCS Packet 67 - Track Condition (Data Link)."@en ;
    sh:message "ETCS Paket 67 - Streckenbedingung (große Metallmassen)."@de ;
    sh:message "Paquet ETCS 67 - Condition de voie (masses métalliques importantes)."@fr ;
    
    # DL Track Conditions (required, 1-32 track conditions)
    sh:property [ 
        sh:path era:dlTrackConditions ;
        sh:node era:DLTrackCondShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 32 ;
        sh:message "Each ETCSPacket_67 must have between 1 and 32 dlTrackConditions that conform to DLTrackCond object."@en ;
        sh:message "Jedes ETCSPacket_67 muss zwischen 1 und 32 dlTrackConditions-Einträge enthalten, die der Form DLTrackCond entsprechen."@de ;
        sh:message "Chaque ETCSPacket_67 doit contenir entre 1 et 32 entrées dlTrackConditions, conformes à la forme DLTrackCond."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 68 Shape =====
era:ETCSPacket_68Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_68 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 68 (Track condition) is missing its q_trackinit value, or its trackCondSelection list exceeds 32 entries. q_trackinit is required; trackCondSelection lists the track conditions ahead, such as powerless sections or air tightness zones."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 68 (Streckenbedingung) der Wert q_trackinit fehlt oder die trackCondSelection-Liste mehr als 32 Einträge enthält. q_trackinit ist erforderlich; trackCondSelection listet die voraus liegenden Streckenbedingungen auf, wie spannungslose Abschnitte oder Druckdichtheitszonen."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 68 (condition de voie) ne précise pas sa valeur q_trackinit, ou que sa liste trackCondSelection dépasse 32 entrées. q_trackinit est requis; trackCondSelection liste les conditions de voie à venir, telles que sections sans tension ou zones d'étanchéité."@fr ;
    sh:message "ETCS Packet 68 - Track Condition (Big Metal Masses)."@en ;
    sh:message "ETCS Paket 68 - Streckenbedingung (allgemein)."@de ;
    sh:message "Paquet ETCS 68 - Condition de voie (générale)."@fr ;
    
    # D_TRACKINIT (required, unsigned integer 0-32767 - distance to track description start)
    sh:property [ 
        sh:path era:d_trackinit ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_68 may have exactly one d_trackinit (unsigned integer 0-32767, distance to track description start)."@en ;
        sh:message "Jedes ETCSPacket_68 kann höchstens einen Wert für d_trackinit haben (vorzeichenlose Ganzzahl 0-32767, distance to track description start)."@de ;
        sh:message "Chaque ETCSPacket_68 peut avoir au plus une valeur pour d_trackinit (entier non signé 0-32767, distance to track description start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_TRACKINIT (required, boolean - initial/update indicator)
    sh:property [ 
        sh:path era:q_trackinit ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_68 must have exactly one q_trackinit (boolean, initial or update description)."@en ;
        sh:message "Jedes ETCSPacket_68 muss genau einen Wert für q_trackinit haben (boolescher Wert, initial or update description)."@de ;
        sh:message "Chaque ETCSPacket_68 doit avoir exactement une valeur pour q_trackinit (booléen, initial or update description)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Track Condition Selection (optional, up to 32 conditions)
    sh:property [ 
        sh:path era:trackCondSelection ;
        sh:node era:DLMConditionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 32 ;
        sh:message "An ETCSPacket_68 may have at most 32 trackCondSelection that conform to DLMCondition object."@en ;
        sh:message "Ein ETCSPacket_68 kann höchstens 32 trackCondSelection-Eintrag/Einträge haben, der/die der Form DLMCondition entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_68 peut avoir au plus 32 entrée(s) trackCondSelection, conforme(s) à la forme DLMCondition."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 69 Shape =====
era:ETCSPacket_69Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_69 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 69 (Track condition: station platforms) is missing its q_trackinit value, or its trackCondPlatformSelection list exceeds 32 entries. q_trackinit is required; the list gives the location, height and side of platforms for the door control system."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 69 (Streckenbedingung: Bahnsteige) der Wert q_trackinit fehlt oder die trackCondPlatformSelection-Liste mehr als 32 Einträge enthält. q_trackinit ist erforderlich; die Liste gibt Lage, Höhe und Seite der Bahnsteige für die Türsteuerung an."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 69 (condition de voie : quais de gare) ne précise pas sa valeur q_trackinit, ou que sa liste trackCondPlatformSelection dépasse 32 entrées. q_trackinit est requis; la liste indique l'emplacement, la hauteur et le côté des quais pour la commande des portes."@fr ;
    sh:message "ETCS Packet 69 - Track Condition Station Platforms."@en ;
    sh:message "ETCS Paket 69 - Streckenbedingung Bahnsteige."@de ;
    sh:message "Paquet ETCS 69 - Condition de voie : quais de gare."@fr ;
    
    # D_TRACKINIT (required, unsigned integer 0-32767 - distance to track description start)
    sh:property [ 
        sh:path era:d_trackinit ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_69 may have exactly one d_trackinit (unsigned integer 0-32767, distance to track description start)."@en ;
        sh:message "Jedes ETCSPacket_69 kann höchstens einen Wert für d_trackinit haben (vorzeichenlose Ganzzahl 0-32767, distance to track description start)."@de ;
        sh:message "Chaque ETCSPacket_69 peut avoir au plus une valeur pour d_trackinit (entier non signé 0-32767, distance to track description start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_TRACKINIT (required, boolean - initial/update indicator)
    sh:property [ 
        sh:path era:q_trackinit ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_69 must have exactly one q_trackinit (boolean, initial or update description)."@en ;
        sh:message "Jedes ETCSPacket_69 muss genau einen Wert für q_trackinit haben (boolescher Wert, initial or update description)."@de ;
        sh:message "Chaque ETCSPacket_69 doit avoir exactement une valeur pour q_trackinit (booléen, initial or update description)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Track Condition Platform Selection (optional, up to 32 platform conditions)
    sh:property [ 
        sh:path era:trackCondPlatformSelection ;
        sh:node era:TCSPConditionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 32 ;
        sh:message "An ETCSPacket_69 may have at most 32 trackCondPlatformSelection that conform to TCSPCondition object."@en ;
        sh:message "Ein ETCSPacket_69 kann höchstens 32 trackCondPlatformSelection-Eintrag/Einträge haben, der/die der Form TCSPCondition entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_69 peut avoir au plus 32 entrée(s) trackCondPlatformSelection, conforme(s) à la forme TCSPCondition."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 6 Shape =====
era:ETCSPacket_6Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_6 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 6 (Virtual Balise Cover order) is missing one of its required fields — nid_c, nid_vbcmk, or q_vbco — or a value is outside its valid range. These three fields are required to set or remove a VBC; t_vbc is additionally required when setting."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 6 (Auftrag zur virtuellen Balisenabdeckung) eines der erforderlichen Felder — nid_c, nid_vbcmk oder q_vbco — fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Diese drei Felder sind erforderlich, um eine VBC zu setzen oder zu entfernen; t_vbc ist beim Setzen zusätzlich erforderlich."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 6 (ordre de couverture virtuelle de balise) ne précise pas l'un de ses champs requis — nid_c, nid_vbcmk ou q_vbco — ou qu'une valeur est hors de sa plage valide. Ces trois champs sont requis pour activer ou supprimer une VBC; t_vbc est en outre requis lors de l'activation."@fr ;
    sh:message "ETCS Packet 6 - Virtual Balise Cover Order."@en ;
    sh:message "ETCS Paket 6 - Auftrag zur virtuellen Balisenabdeckung."@de ;
    sh:message "Paquet ETCS 6 - Ordre de couverture virtuelle de balise."@fr ;
    
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_6 must have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes ETCSPacket_6 muss genau einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque ETCSPacket_6 doit avoir exactement une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_VBCMK (required, unsigned integer 0-63 - virtual balise cover marker identity)
    sh:property [ 
        sh:path era:nid_vbcmk ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 63 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_6 must have exactly one nid_vbcmk (unsigned integer 0-63, virtual balise cover marker ID)."@en ;
        sh:message "Jedes ETCSPacket_6 muss genau einen Wert für nid_vbcmk haben (vorzeichenlose Ganzzahl 0-63, virtual balise cover marker ID)."@de ;
        sh:message "Chaque ETCSPacket_6 doit avoir exactement une valeur pour nid_vbcmk (entier non signé 0-63, virtual balise cover marker ID)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_VBCO (required, boolean - virtual balise cover order)
    sh:property [ 
        sh:path era:q_vbco ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_6 must have exactly one q_vbco (boolean, set/remove virtual balise cover)."@en ;
        sh:message "Jedes ETCSPacket_6 muss genau einen Wert für q_vbco haben (boolescher Wert, set/remove virtual balise cover)."@de ;
        sh:message "Chaque ETCSPacket_6 doit avoir exactement une valeur pour q_vbco (booléen, set/remove virtual balise cover)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # T_VBC (required, unsigned integer 0-255 - time for virtual balise cover in seconds)
    sh:property [ 
        sh:path era:t_vbc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_6 must have exactly one t_vbc (unsigned integer 0-255, time for virtual balise cover in seconds)."@en ;
        sh:message "Jedes ETCSPacket_6 muss genau einen Wert für t_vbc haben (vorzeichenlose Ganzzahl 0-255, time for virtual balise cover in Sekunden)."@de ;
        sh:message "Chaque ETCSPacket_6 doit avoir exactement une valeur pour t_vbc (entier non signé 0-255, time for virtual balise cover en secondes)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== ETCS Packet 70 Shape =====
era:ETCSPacket_70Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_70 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 70 (Route suitability data) is missing its q_trackinit value, or its routeSuitabilities list exceeds 32 entries. q_trackinit is required; the list gives the loading gauge, axle load category and traction system characteristics needed for a train to enter the route."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 70 (Streckenverträglichkeitsdaten) der Wert q_trackinit fehlt oder die routeSuitabilities-Liste mehr als 32 Einträge enthält. q_trackinit ist erforderlich; die Liste gibt die für die Streckenzulassung erforderlichen Eigenschaften an (Lichtraumprofil, Achslastkategorie, Traktionssystem)."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 70 (données d'aptitude à l'itinéraire) ne précise pas sa valeur q_trackinit, ou que sa liste routeSuitabilities dépasse 32 entrées. q_trackinit est requis; la liste indique les caractéristiques (gabarit, charge à l'essieu, système de traction) requises pour qu'un train emprunte l'itinéraire."@fr ;
    sh:message "ETCS Packet 70 - Route Suitability Data."@en ;
    sh:message "ETCS Paket 70 - Streckenverträglichkeitsdaten."@de ;
    sh:message "Paquet ETCS 70 - Données d'aptitude à l'itinéraire."@fr ;
    
    # D_TRACKINIT (required, unsigned integer 0-32767 - distance to track description start)
    sh:property [ 
        sh:path era:d_trackinit ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_70 may have exactly one d_trackinit (unsigned integer 0-32767, distance to track description start)."@en ;
        sh:message "Jedes ETCSPacket_70 kann höchstens einen Wert für d_trackinit haben (vorzeichenlose Ganzzahl 0-32767, distance to track description start)."@de ;
        sh:message "Chaque ETCSPacket_70 peut avoir au plus une valeur pour d_trackinit (entier non signé 0-32767, distance to track description start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_TRACKINIT (required, boolean - initial/update indicator)
    sh:property [ 
        sh:path era:q_trackinit ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_70 must have exactly one q_trackinit (boolean, initial or update description)."@en ;
        sh:message "Jedes ETCSPacket_70 muss genau einen Wert für q_trackinit haben (boolescher Wert, initial or update description)."@de ;
        sh:message "Chaque ETCSPacket_70 doit avoir exactement une valeur pour q_trackinit (booléen, initial or update description)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Route Suitabilities (optional, up to 32 route suitability definitions)
    sh:property [ 
        sh:path era:routeSuitabilities ;
        sh:node era:RouteSuitabilityShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 32 ;
        sh:message "An ETCSPacket_70 may have at most 32 routeSuitabilities that conform to RouteSuitability object."@en ;
        sh:message "Ein ETCSPacket_70 kann höchstens 32 routeSuitabilities-Eintrag/Einträge haben, der/die der Form RouteSuitability entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_70 peut avoir au plus 32 entrée(s) routeSuitabilities, conforme(s) à la forme RouteSuitability."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 71 Shape =====
era:ETCSPacket_71Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_71 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 71 (Adhesion factor) is missing one of its required fields — d_adhesion, l_adhesion, or m_adhesion — or a value is outside its valid range. All three fields are required to define the distance, length and adhesion factor qualifier for the affected section."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 71 (Haftwertfaktor) eines der erforderlichen Felder — d_adhesion, l_adhesion oder m_adhesion — fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Alle drei Felder sind erforderlich, um Entfernung, Länge und Haftwertqualifizierer für den betroffenen Abschnitt zu definieren."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 71 (facteur d'adhérence) ne précise pas l'un de ses champs requis — d_adhesion, l_adhesion ou m_adhesion — ou qu'une valeur est hors de sa plage valide. Les trois champs sont requis pour définir la distance, la longueur et le qualificateur du facteur d'adhérence pour la section concernée."@fr ;
    sh:message "ETCS Packet 71 - Adhesion Factor."@en ;
    sh:message "ETCS Paket 71 - Haftwertfaktor."@de ;
    sh:message "Paquet ETCS 71 - Facteur d'adhérence."@fr ;
    
    # D_ADHESION (required, unsigned integer 0-32767 - distance to adhesion change)
    sh:property [ 
        sh:path era:d_adhesion ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_71 must have exactly one d_adhesion (unsigned integer 0-32767, distance to adhesion factor change)."@en ;
        sh:message "Jedes ETCSPacket_71 muss genau einen Wert für d_adhesion haben (vorzeichenlose Ganzzahl 0-32767, distance to adhesion factor change)."@de ;
        sh:message "Chaque ETCSPacket_71 doit avoir exactement une valeur pour d_adhesion (entier non signé 0-32767, distance to adhesion factor change)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_ADHESION (required, unsigned integer 0-32767 - length of adhesion section)
    sh:property [ 
        sh:path era:l_adhesion ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_71 must have exactly one l_adhesion (unsigned integer 0-32767, length of adhesion section)."@en ;
        sh:message "Jedes ETCSPacket_71 muss genau einen Wert für l_adhesion haben (vorzeichenlose Ganzzahl 0-32767, length of adhesion section)."@de ;
        sh:message "Chaque ETCSPacket_71 doit avoir exactement une valeur pour l_adhesion (entier non signé 0-32767, length of adhesion section)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_ADHESION (required, boolean - adhesion factor qualifier)
    sh:property [ 
        sh:path era:m_adhesion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_71 must have exactly one m_adhesion (boolean, slippery rail indicator)."@en ;
        sh:message "Jedes ETCSPacket_71 muss genau einen Wert für m_adhesion haben (boolescher Wert, slippery rail indicator)."@de ;
        sh:message "Chaque ETCSPacket_71 doit avoir exactement une valeur pour m_adhesion (booléen, slippery rail indicator)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 72 Shape =====
era:ETCSPacket_72Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_72 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 72 (Plain text message) is missing its l_text, x_text, or textMessageConfig value, or a value is outside its valid range. All three are required to carry the free text and its display/acknowledgement configuration for the driver."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 72 (Freitextnachricht) der Wert l_text, x_text oder textMessageConfig fehlt oder außerhalb des gültigen Bereichs liegt. Alle drei sind erforderlich, um den Freitext und seine Anzeige-/Quittierungskonfiguration für den Triebfahrzeugführer zu übertragen."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 72 (message en texte libre) ne précise pas sa valeur l_text, x_text ou textMessageConfig, ou qu'une valeur est hors de sa plage valide. Les trois sont requis pour transporter le texte libre et sa configuration d'affichage/d'accusé de réception pour le conducteur."@fr ;
    sh:message "ETCS Packet 72 - Plain Text Message."@en ;
    sh:message "ETCS Paket 72 - Freitextnachricht."@de ;
    sh:message "Paquet ETCS 72 - Message en texte libre."@fr ;
    
    # L_TEXT (required, unsigned integer 0-225 - length of text in bytes)
    sh:property [ 
        sh:path era:l_text ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 225 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_72 must have exactly one l_text (unsigned integer 0-225, text length in bytes)."@en ;
        sh:message "Jedes ETCSPacket_72 muss genau einen Wert für l_text haben (vorzeichenlose Ganzzahl 0-225, text length in bytes)."@de ;
        sh:message "Chaque ETCSPacket_72 doit avoir exactement une valeur pour l_text (entier non signé 0-225, text length in bytes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # X_TEXT (required, string - plain text message content)
    sh:property [ 
        sh:path era:x_text ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_72 must have exactly one x_text (string, message text content)."@en ;
        sh:message "Jedes ETCSPacket_72 muss genau einen Wert für x_text haben (Zeichenkette, message text content)."@de ;
        sh:message "Chaque ETCSPacket_72 doit avoir exactement une valeur pour x_text (chaîne de caractères, message text content)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Text Message Configuration (required, can be inline or referenced)
    sh:property [ 
        sh:path era:textMessageConfig ;
        sh:node era:TextMessageConfigShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_72 must have exactly one textMessageConfig that conforms to TextMessageConfig object."@en ;
        sh:message "Jedes ETCSPacket_72 muss genau einen textMessageConfig-Eintrag haben, der der Form TextMessageConfig entspricht."@de ;
        sh:message "Chaque ETCSPacket_72 doit avoir exactement une entrée textMessageConfig, conforme à la forme TextMessageConfig."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 76 Shape =====
era:ETCSPacket_76Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_76 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 76 (Plain text message with confirmation) is missing its q_text or textMessageConfig value, or a value is outside its valid range. Both are required to point to the fixed predefined text and carry its display/acknowledgement configuration."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 76 (Freitextnachricht mit Bestätigung) der Wert q_text oder textMessageConfig fehlt oder außerhalb des gültigen Bereichs liegt. Beide sind erforderlich, um auf den festgelegten vordefinierten Text zu verweisen und dessen Anzeige-/Quittierungskonfiguration zu übertragen."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 76 (message en texte libre avec confirmation) ne précise pas sa valeur q_text ou textMessageConfig, ou qu'une valeur est hors de sa plage valide. Les deux sont requis pour pointer vers le texte prédéfini fixe et transporter sa configuration d'affichage/d'accusé de réception."@fr ;
    sh:message "ETCS Packet 76 - Plain Text Message with Confirmation."@en ;
    sh:message "ETCS Paket 76 - Freitextnachricht mit Bestätigung."@de ;
    sh:message "Paquet ETCS 76 - Message en texte libre avec confirmation."@fr ;
    
    # Q_TEXT (required, unsigned integer 0-225 - text qualifier/priority)
    sh:property [ 
        sh:path era:q_text ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 225 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_76 must have exactly one q_text (unsigned integer 0-225, text priority/acknowledgement requirement)."@en ;
        sh:message "Jedes ETCSPacket_76 muss genau einen Wert für q_text haben (vorzeichenlose Ganzzahl 0-225, text priority/acknowledgement requirement)."@de ;
        sh:message "Chaque ETCSPacket_76 doit avoir exactement une valeur pour q_text (entier non signé 0-225, text priority/acknowledgement requirement)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Text Message Configuration (required, can be inline or referenced)
    sh:property [ 
        sh:path era:textMessageConfig ;
        sh:node era:TextMessageConfigShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_76 must have exactly one textMessageConfig that conforms to TextMessageConfig object."@en ;
        sh:message "Jedes ETCSPacket_76 muss genau einen textMessageConfig-Eintrag haben, der der Form TextMessageConfig entspricht."@de ;
        sh:message "Chaque ETCSPacket_76 doit avoir exactement une entrée textMessageConfig, conforme à la forme TextMessageConfig."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 79 Shape =====
era:ETCSPacket_79Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_79 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 79 (Geographical position information) has a geoPosItems list that is empty or exceeds 32 entries, or one of its entries does not conform to the GeoPosItem shape. Between 1 and 32 entries are required."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 79 (Geografische Positionsinformationen) die geoPosItems-Liste leer ist oder mehr als 32 Einträge enthält, oder ein Eintrag nicht der GeoPosItem-Form entspricht. Es sind 1 bis 32 Einträge erforderlich."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 79 (informations de position géographique) a une liste geoPosItems vide ou dépassant 32 entrées, ou qu'une entrée n'est pas conforme à la forme GeoPosItem. Entre 1 et 32 entrées sont requises."@fr ;
    sh:message "ETCS Packet 79 - Geographical Position Information."@en ;
    sh:message "ETCS Paket 79 - Geografische Positionsinformationen."@de ;
    sh:message "Paquet ETCS 79 - Informations de position géographique."@fr ;
    
    # Geographic Position Items (required, 1-32 position references)
    sh:property [ 
        sh:path era:geoPosItems ;
        sh:node era:GeoPosItemShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 32 ;
        sh:message "Each ETCSPacket_79 must have between 1 and 32 geoPosItems that conform to GeoPosItem object."@en ;
        sh:message "Jedes ETCSPacket_79 muss zwischen 1 und 32 geoPosItems-Einträge enthalten, die der Form GeoPosItem entsprechen."@de ;
        sh:message "Chaque ETCSPacket_79 doit contenir entre 1 et 32 entrées geoPosItems, conformes à la forme GeoPosItem."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 80 Shape =====
era:ETCSPacket_80Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_80 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 80 (Mode Profile) has a modeProfiles list that is empty or exceeds 32 entries, or one of its entries does not conform to the ModeProfileItem shape. Between 1 and 32 zones are required, each defining a required operating mode along the route."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 80 (Modusprofil) die modeProfiles-Liste leer ist oder mehr als 32 Einträge enthält, oder ein Eintrag nicht der ModeProfileItem-Form entspricht. Es sind 1 bis 32 Zonen erforderlich, die jeweils einen vorgeschriebenen Betriebsmodus entlang der Strecke definieren."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 80 (profil de mode) a une liste modeProfiles vide ou dépassant 32 entrées, ou qu'une entrée n'est pas conforme à la forme ModeProfileItem. Entre 1 et 32 zones sont requises, chacune définissant un mode d'exploitation requis le long de l'itinéraire."@fr ;
    sh:message "ETCS Packet 80 - Mode Profile."@en ;
    sh:message "ETCS Paket 80 - Modusprofil."@de ;
    sh:message "Paquet ETCS 80 - Profil de mode."@fr ;
    
    # Mode Profiles (required, 1-32 mode profile items)
    sh:property [ 
        sh:path era:modeProfiles ;
        sh:node era:ModeProfileItemShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 32 ;
        sh:message "Each ETCSPacket_80 must have between 1 and 32 modeProfiles that conform to ModeProfileItem object."@en ;
        sh:message "Jedes ETCSPacket_80 muss zwischen 1 und 32 modeProfiles-Einträge enthalten, die der Form ModeProfileItem entsprechen."@de ;
        sh:message "Chaque ETCSPacket_80 doit contenir entre 1 et 32 entrées modeProfiles, conformes à la forme ModeProfileItem."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 88 Shape =====
era:ETCSPacket_88Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_88 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 88 (Level crossing information) is missing one of its required fields — nid_lx, d_lx, l_lx, or q_lxstatus — or a value is outside its valid range. All four are required to identify, locate and give the protection status of a level crossing."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 88 (Informationen zum Bahnübergang) eines der erforderlichen Felder — nid_lx, d_lx, l_lx oder q_lxstatus — fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Alle vier sind erforderlich, um einen Bahnübergang zu identifizieren, zu lokalisieren und seinen Sicherungsstatus anzugeben."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 88 (informations sur le passage à niveau) ne précise pas l'un de ses champs requis — nid_lx, d_lx, l_lx ou q_lxstatus — ou qu'une valeur est hors de sa plage valide. Les quatre sont requis pour identifier, localiser et indiquer l'état de protection d'un passage à niveau."@fr ;
    sh:message "ETCS Packet 88 - Level Crossing Information."@en ;
    sh:message "ETCS Paket 88 - Informationen zum Bahnübergang."@de ;
    sh:message "Paquet ETCS 88 - Informations sur le passage à niveau."@fr ;
    
    # NID_LX (required, unsigned integer 0-255 - level crossing identity)
    sh:property [ 
        sh:path era:nid_lx ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_88 must have exactly one nid_lx (unsigned integer 0-255, level crossing identifier)."@en ;
        sh:message "Jedes ETCSPacket_88 muss genau einen Wert für nid_lx haben (vorzeichenlose Ganzzahl 0-255, level crossing Kennung)."@de ;
        sh:message "Chaque ETCSPacket_88 doit avoir exactement une valeur pour nid_lx (entier non signé 0-255, level crossing identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # D_LX (required, unsigned integer 0-32767 - distance to level crossing)
    sh:property [ 
        sh:path era:d_lx ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_88 must have exactly one d_lx (unsigned integer 0-32767, distance to level crossing)."@en ;
        sh:message "Jedes ETCSPacket_88 muss genau einen Wert für d_lx haben (vorzeichenlose Ganzzahl 0-32767, distance to level crossing)."@de ;
        sh:message "Chaque ETCSPacket_88 doit avoir exactement une valeur pour d_lx (entier non signé 0-32767, distance to level crossing)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_LX (required, unsigned integer 0-32767 - length of level crossing)
    sh:property [ 
        sh:path era:l_lx ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_88 must have exactly one l_lx (unsigned integer 0-32767, length of level crossing)."@en ;
        sh:message "Jedes ETCSPacket_88 muss genau einen Wert für l_lx haben (vorzeichenlose Ganzzahl 0-32767, length of level crossing)."@de ;
        sh:message "Chaque ETCSPacket_88 doit avoir exactement une valeur pour l_lx (entier non signé 0-32767, length of level crossing)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_LXSTATUS (required, boolean - level crossing status qualifier)
    sh:property [ 
        sh:path era:q_lxstatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_88 must have exactly one q_lxstatus (boolean, whether status information follows)."@en ;
        sh:message "Jedes ETCSPacket_88 muss genau einen Wert für q_lxstatus haben (boolescher Wert, whether status information follows)."@de ;
        sh:message "Chaque ETCSPacket_88 doit avoir exactement une valeur pour q_lxstatus (booléen, whether status information follows)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Level Crossing Status (optional, detailed status information)
    sh:property [ 
        sh:path era:lx_Status ;
        sh:node era:LXStatusShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "An ETCSPacket_88 may have at most one lx_Status that conforms to LXStatus object."@en ;
        sh:message "Ein ETCSPacket_88 kann höchstens einen lx_Status-Eintrag/Einträge haben, der/die der Form LXStatus entspricht/entsprechen."@de ;
        sh:message "Un ETCSPacket_88 peut avoir au plus une entrée(s) lx_Status, conforme(s) à la forme LXStatus."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 90 Shape =====
era:ETCSPacket_90Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_90 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 90 (Track ahead free up to Level 2/3 transition) is missing its nid_bg value or the value is outside the valid range. nid_bg is required and identifies the balise group at the level transition location."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 90 (Strecke frei bis zum Level-2/3-Übergang) der Wert nid_bg fehlt oder außerhalb des gültigen Bereichs liegt. nid_bg ist erforderlich und identifiziert die Balisengruppe am Übergangsort."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 90 (voie libre jusqu'à la transition Niveau 2/3) ne précise pas sa valeur nid_bg, ou que celle-ci est hors de la plage valide. nid_bg est requis et identifie le groupe de balises à l'emplacement de la transition de niveau."@fr ;
    sh:message "ETCS Packet 90 - Track Ahead Free Up to Level 2/3 Transition Location."@en ;
    sh:message "ETCS Paket 90 - Strecke frei bis zum Level-2/3-Übergangsort."@de ;
    sh:message "Paquet ETCS 90 - Voie libre jusqu'à l'emplacement de transition Niveau 2/3."@fr ;
    
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_90 may have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes ETCSPacket_90 kann höchstens einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque ETCSPacket_90 peut avoir au plus une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_BG (required, unsigned integer 0-16383 - balise group identity at transition)
    sh:property [ 
        sh:path era:nid_bg ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_90 must have exactly one nid_bg (unsigned integer 0-16383, balise group at L2/L3 transition)."@en ;
        sh:message "Jedes ETCSPacket_90 muss genau einen Wert für nid_bg haben (vorzeichenlose Ganzzahl 0-16383, balise group at L2/L3 transition)."@de ;
        sh:message "Chaque ETCSPacket_90 doit avoir exactement une valeur pour nid_bg (entier non signé 0-16383, balise group at L2/L3 transition)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Geographic Position Item Shape =====
era:GeoPosItemShape a sh:NodeShape ;
    sh:targetClass era:GeoPosItem ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a GeoPosItem is missing its nid_bg, d_posoff, q_mposition, or m_position value, or a value is outside its valid range. These fields together define one geographic position reference relative to a balise group."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einem GeoPosItem der Wert nid_bg, d_posoff, q_mposition oder m_position fehlt oder außerhalb des gültigen Bereichs liegt. Diese Felder definieren gemeinsam einen geografischen Positionsbezug relativ zu einer Balisengruppe."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'un GeoPosItem ne précise pas sa valeur nid_bg, d_posoff, q_mposition ou m_position, ou qu'une valeur est hors de sa plage valide. Ces champs définissent ensemble une référence de position géographique par rapport à un groupe de balises."@fr ;
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each GeoPosItem may have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes GeoPosItem kann höchstens einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque GeoPosItem peut avoir au plus une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_BG (required, unsigned integer 0-16383 - balise group identity)
    sh:property [ 
        sh:path era:nid_bg ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each GeoPosItem must have exactly one nid_bg (unsigned integer 0-16383, balise group identifier)."@en ;
        sh:message "Jedes GeoPosItem muss genau einen Wert für nid_bg haben (vorzeichenlose Ganzzahl 0-16383, balise group Kennung)."@de ;
        sh:message "Chaque GeoPosItem doit avoir exactement une valeur pour nid_bg (entier non signé 0-16383, balise group identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # D_POSOFF (required, unsigned integer 0-32767 - position offset)
    sh:property [ 
        sh:path era:d_posoff ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each GeoPosItem must have exactly one d_posoff (unsigned integer 0-32767, position offset from balise group)."@en ;
        sh:message "Jedes GeoPosItem muss genau einen Wert für d_posoff haben (vorzeichenlose Ganzzahl 0-32767, position offset from balise group)."@de ;
        sh:message "Chaque GeoPosItem doit avoir exactement une valeur pour d_posoff (entier non signé 0-32767, position offset from balise group)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_MPOSITION (required, boolean - position type qualifier)
    sh:property [ 
        sh:path era:q_mposition ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each GeoPosItem must have exactly one q_mposition (boolean, geographic position resolution)."@en ;
        sh:message "Jedes GeoPosItem muss genau einen Wert für q_mposition haben (boolescher Wert, geographic position resolution)."@de ;
        sh:message "Chaque GeoPosItem doit avoir exactement une valeur pour q_mposition (booléen, geographic position resolution)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_POSITION (required, unsigned integer 0-16777215 - geographic position value)
    sh:property [ 
        sh:path era:m_position ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16777215 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each GeoPosItem must have exactly one m_position (unsigned integer 0-16777215, latitude/longitude coordinate)."@en ;
        sh:message "Jedes GeoPosItem muss genau einen Wert für m_position haben (vorzeichenlose Ganzzahl 0-16777215, latitude/longitude coordinate)."@de ;
        sh:message "Chaque GeoPosItem doit avoir exactement une valeur pour m_position (entier non signé 0-16777215, latitude/longitude coordinate)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Level Crossing Status Shape =====
era:LXStatusShape a sh:NodeShape ;
    sh:targetClass era:LXStatus ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because an LXStatus is missing its q_stoplx or v_lx value, or a value is outside its valid range. Both are required to define the protection status of a level crossing, including whether a stop is required and the permitted speed."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einem LXStatus der Wert q_stoplx oder v_lx fehlt oder außerhalb des gültigen Bereichs liegt. Beide sind erforderlich, um den Sicherungsstatus eines Bahnübergangs zu definieren, einschließlich der Frage, ob ein Halt erforderlich ist, und der zulässigen Geschwindigkeit."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'un LXStatus ne précise pas sa valeur q_stoplx ou v_lx, ou qu'une valeur est hors de sa plage valide. Les deux sont requis pour définir l'état de protection d'un passage à niveau, y compris si un arrêt est requis et la vitesse autorisée."@fr ;
    # Q_STOPLX (required, boolean - stop at level crossing qualifier)
    sh:property [ 
        sh:path era:q_stoplx ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LXStatus must have exactly one q_stoplx (boolean, whether stop is required at LX)."@en ;
        sh:message "Jedes LXStatus muss genau einen Wert für q_stoplx haben (boolescher Wert, whether stop is required at LX)."@de ;
        sh:message "Chaque LXStatus doit avoir exactement une valeur pour q_stoplx (booléen, whether stop is required at LX)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # V_LX (required, unsigned integer 0-127 - permitted speed at level crossing in km/h)
    sh:property [ 
        sh:path era:v_lx ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LXStatus must have exactly one v_lx (unsigned integer 0-127, permitted speed at LX in km/h)."@en ;
        sh:message "Jedes LXStatus muss genau einen Wert für v_lx haben (vorzeichenlose Ganzzahl 0-127, permitted speed at LX in km/h)."@de ;
        sh:message "Chaque LXStatus doit avoir exactement une valeur pour v_lx (entier non signé 0-127, permitted speed at LX in km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_STOPLX (required, unsigned integer 0-32767 - distance to stop at level crossing)
    sh:property [ 
        sh:path era:l_stoplx ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:maxCount 1 ;
        sh:message "Each LXStatus may have exactly one l_stoplx (unsigned integer 0-32767, stopping distance at LX)."@en ;
        sh:message "Jedes LXStatus kann höchstens einen Wert für l_stoplx haben (vorzeichenlose Ganzzahl 0-32767, stopping distance at LX)."@de ;
        sh:message "Chaque LXStatus peut avoir au plus une valeur pour l_stoplx (entier non signé 0-32767, stopping distance at LX)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Level Transition Shape =====
era:LevelTransitionShape a sh:NodeShape ;
    sh:targetClass era:LevelTransition ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a LevelTransition is missing its m_leveltr value or the value is not one of the defined ETCS levels. m_leveltr is required and defines one candidate target level within a Conditional Level Transition Order."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einer LevelTransition der Wert m_leveltr fehlt oder keinem der definierten ETCS-Level entspricht. m_leveltr ist erforderlich und definiert einen möglichen Ziel-Level innerhalb eines bedingten Übergangsauftrags."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'une LevelTransition ne précise pas sa valeur m_leveltr, ou que celle-ci ne correspond à aucun des niveaux ETCS définis. m_leveltr est requis et définit un niveau cible candidat au sein d'un ordre conditionnel de transition de niveau."@fr ;
    # M_LEVELTR (required, controlled vocabulary - target ETCS level)
    sh:property [ 
        sh:path era:m_leveltr ;
        sh:in (
            <http://data.europa.eu/949/concepts/etcs-levels/level0>
            <http://data.europa.eu/949/concepts/etcs-levels/levelNTC>
            <http://data.europa.eu/949/concepts/etcs-levels/level1>
            <http://data.europa.eu/949/concepts/etcs-levels/level2>
            <http://data.europa.eu/949/concepts/etcs-levels/level3>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_leveltr must have a value from the defined SKOS concept scheme (level0, level1, level2, level3, or levelNTC)."@en ;
        sh:message "Die Eigenschaft m_leveltr muss einen Wert aus dem definierten SKOS-Konzeptschema haben (level0, level1, level2, level3, or levelNTC)."@de ;
        sh:message "La propriété m_leveltr doit avoir une valeur issue du schéma de concepts SKOS défini (level0, level1, level2, level3, or levelNTC)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_NTC (required, unsigned integer 0-255 - National Train Control system ID)
    sh:property [ 
        sh:path era:nid_ntc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:maxCount 1 ;
        sh:message "Each LevelTransition may have exactly one nid_ntc (unsigned integer 0-255, NTC system identifier)."@en ;
        sh:message "Jedes LevelTransition kann höchstens einen Wert für nid_ntc haben (vorzeichenlose Ganzzahl 0-255, NTC system Kennung)."@de ;
        sh:message "Chaque LevelTransition peut avoir au plus une valeur pour nid_ntc (entier non signé 0-255, NTC system identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
# ===== Level Transition With Acknowledgement Shape =====
era:LevelTransitionWithAckShape a sh:NodeShape ;
    sh:targetClass era:LevelTransitionWithAck ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a LevelTransitionWithAck is missing its m_leveltr or l_ackleveltr value, or a value is outside its valid range or not one of the defined ETCS levels. Both fields are required to define a candidate target level requiring driver acknowledgment, and the length of the acknowledgement area."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einer LevelTransitionWithAck der Wert m_leveltr oder l_ackleveltr fehlt, außerhalb des gültigen Bereichs liegt oder keinem der definierten ETCS-Level entspricht. Beide Felder sind erforderlich, um einen Ziel-Level mit Quittierungspflicht sowie die Länge des Quittierungsbereichs zu definieren."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'une LevelTransitionWithAck ne précise pas sa valeur m_leveltr ou l_ackleveltr, qu'une valeur est hors de sa plage valide, ou que m_leveltr ne correspond à aucun des niveaux ETCS définis. Les deux champs sont requis pour définir un niveau cible candidat nécessitant un accusé de réception du conducteur, et la longueur de la zone d'accusé de réception."@fr ;
    # M_LEVELTR (required, controlled vocabulary - target ETCS level)
    sh:property [ 
        sh:path era:m_leveltr ;
        sh:in (
            <http://data.europa.eu/949/concepts/etcs-levels/level0>
            <http://data.europa.eu/949/concepts/etcs-levels/levelNTC>
            <http://data.europa.eu/949/concepts/etcs-levels/level1>
            <http://data.europa.eu/949/concepts/etcs-levels/level2>
            <http://data.europa.eu/949/concepts/etcs-levels/level3>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_leveltr must have a value from the defined SKOS concept scheme (level0, level1, level2, level3, or levelNTC)."@en ;
        sh:message "Die Eigenschaft m_leveltr muss einen Wert aus dem definierten SKOS-Konzeptschema haben (level0, level1, level2, level3, or levelNTC)."@de ;
        sh:message "La propriété m_leveltr doit avoir une valeur issue du schéma de concepts SKOS défini (level0, level1, level2, level3, or levelNTC)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_NTC (required, unsigned integer 0-255 - National Train Control system ID)
    sh:property [ 
        sh:path era:nid_ntc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:maxCount 1 ;
        sh:message "Each LevelTransitionWithAck must have exactly one nid_ntc (unsigned integer 0-255, NTC system identifier)."@en ;
        sh:message "Jedes LevelTransitionWithAck muss genau einen Wert für nid_ntc haben (vorzeichenlose Ganzzahl 0-255, NTC system Kennung)."@de ;
        sh:message "Chaque LevelTransitionWithAck doit avoir exactement une valeur pour nid_ntc (entier non signé 0-255, NTC system identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_ACKLEVELTR (required, unsigned integer 0-32767 - acknowledgement length)
    sh:property [ 
        sh:path era:l_ackleveltr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LevelTransitionWithAck must have exactly one l_ackleveltr (unsigned integer 0-32767, distance where driver must acknowledge)."@en ;
        sh:message "Jedes LevelTransitionWithAck muss genau einen Wert für l_ackleveltr haben (vorzeichenlose Ganzzahl 0-32767, distance where driver must acknowledge)."@de ;
        sh:message "Chaque LevelTransitionWithAck doit avoir exactement une valeur pour l_ackleveltr (entier non signé 0-32767, distance where driver must acknowledge)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Link Item Shape =====
era:LinkItemShape a sh:NodeShape ;
    sh:targetClass era:LinkItem ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a LinkItem is missing one of its required fields — d_link, nid_bg, q_linkorientation, q_locacc, or q_linkreaction — or a value is outside its valid range. These fields together identify a balise group expected next along the route, its orientation, location accuracy and reaction if the link fails."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einem LinkItem eines der erforderlichen Felder — d_link, nid_bg, q_linkorientation, q_locacc oder q_linkreaction — fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Diese Felder identifizieren gemeinsam eine als Nächstes erwartete Balisengruppe, ihre Ausrichtung, Standortgenauigkeit und die Reaktion bei Verknüpfungsfehler."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'un LinkItem ne précise pas l'un de ses champs requis — d_link, nid_bg, q_linkorientation, q_locacc ou q_linkreaction — ou qu'une valeur est hors de sa plage valide. Ces champs identifient ensemble un groupe de balises attendu prochainement le long de l'itinéraire, son orientation, la précision de sa localisation et la réaction en cas d'échec de la liaison."@fr ;
    # D_LINK (required, unsigned integer 0-32767 - distance to linked balise group)
    sh:property [ 
        sh:path era:d_link ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinkItem must have exactly one d_link (unsigned integer 0-32767, distance to linked balise group)."@en ;
        sh:message "Jedes LinkItem muss genau einen Wert für d_link haben (vorzeichenlose Ganzzahl 0-32767, distance to linked balise group)."@de ;
        sh:message "Chaque LinkItem doit avoir exactement une valeur pour d_link (entier non signé 0-32767, distance to linked balise group)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each LinkItem must have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes LinkItem muss genau einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque LinkItem doit avoir exactement une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_BG (required, unsigned integer 0-16383 - balise group identity)
    sh:property [ 
        sh:path era:nid_bg ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinkItem must have exactly one nid_bg (unsigned integer 0-16383, expected balise group identifier)."@en ;
        sh:message "Jedes LinkItem muss genau einen Wert für nid_bg haben (vorzeichenlose Ganzzahl 0-16383, expected balise group Kennung)."@de ;
        sh:message "Chaque LinkItem doit avoir exactement une valeur pour nid_bg (entier non signé 0-16383, expected balise group identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_LINKORIENTATION (required, boolean - link orientation)
    sh:property [ 
        sh:path era:q_linkorientation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinkItem must have exactly one q_linkorientation (boolean, balise group orientation: nominal/reverse)."@en ;
        sh:message "Jedes LinkItem muss genau einen Wert für q_linkorientation haben (boolescher Wert, balise group orientation: nominal/reverse)."@de ;
        sh:message "Chaque LinkItem doit avoir exactement une valeur pour q_linkorientation (booléen, balise group orientation: nominal/reverse)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_LOCACC (required, unsigned integer 0-63 - location accuracy)
    sh:property [ 
        sh:path era:q_locacc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 63 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinkItem must have exactly one q_locacc (unsigned integer 0-63, confidence level for link distance)."@en ;
        sh:message "Jedes LinkItem muss genau einen Wert für q_locacc haben (vorzeichenlose Ganzzahl 0-63, confidence level for link distance)."@de ;
        sh:message "Chaque LinkItem doit avoir exactement une valeur pour q_locacc (entier non signé 0-63, confidence level for link distance)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_LINKREACTION (required, controlled vocabulary - reaction if link fails)
    sh:property [ 
        sh:path era:q_linkreaction ;
        sh:in (
            <http://data.europa.eu/949/concepts/etcs-reactions-contact/trainTrip>
            <http://data.europa.eu/949/concepts/etcs-reactions-contact/applyServiceBrake>
            <http://data.europa.eu/949/concepts/etcs-reactions-contact/noReaction>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property q_linkreaction must have a value from the defined SKOS concept scheme (trainTrip, applyServiceBrake, or noReaction)."@en ;
        sh:message "Die Eigenschaft q_linkreaction muss einen Wert aus dem definierten SKOS-Konzeptschema haben (trainTrip, applyServiceBrake, or noReaction)."@de ;
        sh:message "La propriété q_linkreaction doit avoir une valeur issue du schéma de concepts SKOS défini (trainTrip, applyServiceBrake, or noReaction)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Mode Profile Item Shape =====
era:ModeProfileItemShape a sh:NodeShape ;
    sh:targetClass era:ModeProfileItem ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a ModeProfileItem is missing one of its required fields — d_mamode, l_mamode, m_mamode, v_mamode, q_mamode, or l_ackmamode — or a value is outside its valid range or m_mamode is not one of onSight, shunting or limitedSupervision. These fields together define one zone of a Mode Profile: its distance, length, required mode, maximum speed and acknowledgement distance."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einem ModeProfileItem eines der erforderlichen Felder — d_mamode, l_mamode, m_mamode, v_mamode, q_mamode oder l_ackmamode — fehlt, ein Wert außerhalb des gültigen Bereichs liegt oder m_mamode nicht onSight, shunting oder limitedSupervision entspricht. Diese Felder definieren gemeinsam eine Zone eines Modusprofils: Entfernung, Länge, vorgeschriebener Modus, Höchstgeschwindigkeit und Quittierungsentfernung."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'un ModeProfileItem ne précise pas l'un de ses champs requis — d_mamode, l_mamode, m_mamode, v_mamode, q_mamode ou l_ackmamode — ou qu'une valeur est hors de sa plage valide, ou que m_mamode ne correspond ni à onSight, ni à shunting, ni à limitedSupervision. Ces champs définissent ensemble une zone d'un profil de mode : sa distance, sa longueur, le mode requis, la vitesse maximale et la distance d'accusé de réception."@fr ;
    # D_MAMODE (required, unsigned integer 0-32767 - distance to mode profile start)
    sh:property [ 
        sh:path era:d_mamode ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ModeProfileItem must have exactly one d_mamode (unsigned integer 0-32767, distance to mode profile start)."@en ;
        sh:message "Jedes ModeProfileItem muss genau einen Wert für d_mamode haben (vorzeichenlose Ganzzahl 0-32767, distance to mode profile start)."@de ;
        sh:message "Chaque ModeProfileItem doit avoir exactement une valeur pour d_mamode (entier non signé 0-32767, distance to mode profile start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_MAMODE (required, unsigned integer 0-32767 - length of mode profile section)
    sh:property [ 
        sh:path era:l_mamode ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ModeProfileItem must have exactly one l_mamode (unsigned integer 0-32767, length of mode restriction)."@en ;
        sh:message "Jedes ModeProfileItem muss genau einen Wert für l_mamode haben (vorzeichenlose Ganzzahl 0-32767, length of mode restriction)."@de ;
        sh:message "Chaque ModeProfileItem doit avoir exactement une valeur pour l_mamode (entier non signé 0-32767, length of mode restriction)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_MAMODE (required, controlled vocabulary - mode restriction type)
    sh:property [ 
        sh:path era:m_mamode ;
        sh:in (
            <http://data.europa.eu/949/concepts/ma-mode/onSight>
            <http://data.europa.eu/949/concepts/ma-mode/shunting>
            <http://data.europa.eu/949/concepts/ma-mode/limitedSupervision>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_mamode must have a value from the defined SKOS concept scheme (onSight, shunting, or limitedSupervision)."@en ;
        sh:message "Die Eigenschaft m_mamode muss einen Wert aus dem definierten SKOS-Konzeptschema haben (onSight, shunting, or limitedSupervision)."@de ;
        sh:message "La propriété m_mamode doit avoir une valeur issue du schéma de concepts SKOS défini (onSight, shunting, or limitedSupervision)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # V_MAMODE (required, unsigned integer 0-127 - maximum speed in mode in km/h)
    sh:property [ 
        sh:path era:v_mamode ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ModeProfileItem must have exactly one v_mamode (unsigned integer 0-127, maximum speed in this mode in km/h)."@en ;
        sh:message "Jedes ModeProfileItem muss genau einen Wert für v_mamode haben (vorzeichenlose Ganzzahl 0-127, maximum speed in this mode in km/h)."@de ;
        sh:message "Chaque ModeProfileItem doit avoir exactement une valeur pour v_mamode (entier non signé 0-127, maximum speed in this mode in km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_MAMODE (required, boolean - mode qualifier)
    sh:property [ 
        sh:path era:q_mamode ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ModeProfileItem must have exactly one q_mamode (boolean, mode restriction qualifier)."@en ;
        sh:message "Jedes ModeProfileItem muss genau einen Wert für q_mamode haben (boolescher Wert, mode restriction qualifier)."@de ;
        sh:message "Chaque ModeProfileItem doit avoir exactement une valeur pour q_mamode (booléen, mode restriction qualifier)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_ACKMAMODE (required, unsigned integer 0-32767 - acknowledgement length)
    sh:property [ 
        sh:path era:l_ackmamode ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ModeProfileItem must have exactly one l_ackmamode (unsigned integer 0-32767, distance where driver must acknowledge mode)."@en ;
        sh:message "Jedes ModeProfileItem muss genau einen Wert für l_ackmamode haben (vorzeichenlose Ganzzahl 0-32767, distance where driver must acknowledge mode)."@de ;
        sh:message "Chaque ModeProfileItem doit avoir exactement une valeur pour l_ackmamode (entier non signé 0-32767, distance where driver must acknowledge mode)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== NVK (National Value K - Braking Curves) Shape =====
era:NVKShape a sh:NodeShape ;
    sh:targetClass era:NVK ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because an NVK is missing one of its required fields — m_nvkrint, l_nvkrint, m_nvktint, or nvkItems — or a value is outside its valid range, or the nvkItems list is empty or exceeds 32 entries. These fields define the national braking model parameters used to correct kinematic braking calculations."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einem NVK eines der erforderlichen Felder — m_nvkrint, l_nvkrint, m_nvktint oder nvkItems — fehlt, ein Wert außerhalb des gültigen Bereichs liegt oder die nvkItems-Liste leer ist oder mehr als 32 Einträge enthält. Diese Felder definieren die Parameter des nationalen Bremsmodells zur Korrektur der kinematischen Bremsberechnungen."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'un NVK ne précise pas l'un de ses champs requis — m_nvkrint, l_nvkrint, m_nvktint ou nvkItems — ou qu'une valeur est hors de sa plage valide, ou que la liste nvkItems est vide ou dépasse 32 entrées. Ces champs définissent les paramètres du modèle national de freinage utilisés pour corriger les calculs cinématiques de freinage."@fr ;
    # M_NVKRINT (required, unsigned integer 0-31 - correction value)
    sh:property [ 
        sh:path era:m_nvkrint ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 31 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NVK must have exactly one m_nvkrint (unsigned integer 0-31, kinematic correction factor)."@en ;
        sh:message "Jedes NVK muss genau einen Wert für m_nvkrint haben (vorzeichenlose Ganzzahl 0-31, kinematic correction factor)."@de ;
        sh:message "Chaque NVK doit avoir exactement une valeur pour m_nvkrint (entier non signé 0-31, kinematic correction factor)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_NVKRINT (required, unsigned integer 0-31 - distance parameter)
    sh:property [ 
        sh:path era:l_nvkrint ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 31 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NVK must have exactly one l_nvkrint (unsigned integer 0-31, distance parameter for correction)."@en ;
        sh:message "Jedes NVK muss genau einen Wert für l_nvkrint haben (vorzeichenlose Ganzzahl 0-31, distance parameter for correction)."@de ;
        sh:message "Chaque NVK doit avoir exactement une valeur pour l_nvkrint (entier non signé 0-31, distance parameter for correction)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_NVKTINT (required, unsigned integer 0-31 - time interval parameter)
    sh:property [ 
        sh:path era:m_nvktint ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 31 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NVK must have exactly one m_nvktint (unsigned integer 0-31, time interval for kinematic calculations)."@en ;
        sh:message "Jedes NVK muss genau einen Wert für m_nvktint haben (vorzeichenlose Ganzzahl 0-31, time interval for kinematic calculations)."@de ;
        sh:message "Chaque NVK doit avoir exactement une valeur pour m_nvktint (entier non signé 0-31, time interval for kinematic calculations)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NVK Items (required, 1-32 braking curve parameters)
    sh:property [ 
        sh:path era:nvkItems ;
        sh:node era:NVKItemShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 32 ;
        sh:message "Each NVK must have between 1 and 32 nvkItems that conform to NVKItem object."@en ;
        sh:message "Jedes NVK muss zwischen 1 und 32 nvkItems-Einträge enthalten, die der Form NVKItem entsprechen."@de ;
        sh:message "Chaque NVK doit contenir entre 1 et 32 entrées nvkItems, conformes à la forme NVKItem."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Correction Factors (optional, up to 31 correction factors)
    sh:property [ 
        sh:path era:correctionFactors ;
        sh:node era:CorrectionFactorShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 31 ;
        sh:message "An NVK may have at most 31 correctionFactors that conform to CorrectionFactor object."@en ;
        sh:message "Ein NVK kann höchstens 31 correctionFactors-Eintrag/Einträge haben, der/die der Form CorrectionFactor entspricht/entsprechen."@de ;
        sh:message "Un NVK peut avoir au plus 31 entrée(s) correctionFactors, conforme(s) à la forme CorrectionFactor."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== NVK Item Shape =====
era:NVKItemShape a sh:NodeShape ;
    sh:targetClass era:NVKItem ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because an NVKItem is missing its q_nvkvintset or v_nvkvint value, or a value is outside its valid range or q_nvkvintset is not one of the defined train categories. These fields define one national braking curve parameter set applicable to a given train category."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einem NVKItem der Wert q_nvkvintset oder v_nvkvint fehlt, ein Wert außerhalb des gültigen Bereichs liegt oder q_nvkvintset keiner der definierten Zugkategorien entspricht. Diese Felder definieren einen Parametersatz der nationalen Bremskurve für eine bestimmte Zugkategorie."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'un NVKItem ne précise pas sa valeur q_nvkvintset ou v_nvkvint, qu'une valeur est hors de sa plage valide, ou que q_nvkvintset ne correspond à aucune des catégories de train définies. Ces champs définissent un jeu de paramètres de courbe de freinage nationale applicable à une catégorie de train donnée."@fr ;
    # Q_NVKVINTSET (required, controlled vocabulary - train category for braking curves)
    sh:property [ 
        sh:path era:q_nvkvintset ;
        sh:in (
            <http://data.europa.eu/949/concepts/kv-type/freightTrains>
            <http://data.europa.eu/949/concepts/kv-type/conventionalPassengerTrains>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property q_nvkvintset must have a value from the defined SKOS concept scheme (freightTrains or conventionalPassengerTrains)."@en ;
        sh:message "Die Eigenschaft q_nvkvintset muss einen Wert aus dem definierten SKOS-Konzeptschema haben (freightTrains or conventionalPassengerTrains)."@de ;
        sh:message "La propriété q_nvkvintset doit avoir une valeur issue du schéma de concepts SKOS défini (freightTrains or conventionalPassengerTrains)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_NVKVINT (required, unsigned integer 0-127 - kinematic value 1)
    sh:property [ 
        sh:path era:m_nvkvint ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:maxCount 1 ;
        sh:message "Each NVKItem must have exactly one m_nvkvint (unsigned integer 0-127, kinematic braking curve parameter 1)."@en ;
        sh:message "Jedes NVKItem muss genau einen Wert für m_nvkvint haben (vorzeichenlose Ganzzahl 0-127, kinematic braking curve parameter 1)."@de ;
        sh:message "Chaque NVKItem doit avoir exactement une valeur pour m_nvkvint (entier non signé 0-127, kinematic braking curve parameter 1)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_NVKVINT_2 (required, unsigned integer 0-127 - kinematic value 2)
    sh:property [ 
        sh:path era:m_nvkvint_2 ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:maxCount 1 ;
        sh:message "Each NVKItem must have exactly one m_nvkvint_2 (unsigned integer 0-127, kinematic braking curve parameter 2)."@en ;
        sh:message "Jedes NVKItem muss genau einen Wert für m_nvkvint_2 haben (vorzeichenlose Ganzzahl 0-127, kinematic braking curve parameter 2)."@de ;
        sh:message "Chaque NVKItem doit avoir exactement une valeur pour m_nvkvint_2 (entier non signé 0-127, kinematic braking curve parameter 2)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # V_NVKVINT (required, unsigned integer 0-127 - speed for kinematic calculation in km/h)
    sh:property [ 
        sh:path era:v_nvkvint ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NVKItem must have exactly one v_nvkvint (unsigned integer 0-127, speed for braking curve in km/h)."@en ;
        sh:message "Jedes NVKItem muss genau einen Wert für v_nvkvint haben (vorzeichenlose Ganzzahl 0-127, speed for braking curve in km/h)."@de ;
        sh:message "Chaque NVKItem doit avoir exactement une valeur pour v_nvkvint (entier non signé 0-127, speed for braking curve in km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # A_NVP12 (required, unsigned integer 0-63 - acceleration between phases 1 and 2)
    sh:property [ 
        sh:path era:a_nvp12 ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 63 ;
        sh:maxCount 1 ;
        sh:message "Each NVKItem must have exactly one a_nvp12 (unsigned integer 0-63, acceleration between brake phases 1-2)."@en ;
        sh:message "Jedes NVKItem muss genau einen Wert für a_nvp12 haben (vorzeichenlose Ganzzahl 0-63, acceleration between brake phases 1-2)."@de ;
        sh:message "Chaque NVKItem doit avoir exactement une valeur pour a_nvp12 (entier non signé 0-63, acceleration between brake phases 1-2)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # A_NVP23 (required, unsigned integer 0-63 - acceleration between phases 2 and 3)
    sh:property [ 
        sh:path era:a_nvp23 ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 63 ;
        sh:maxCount 1 ;
        sh:message "Each NVKItem must have exactly one a_nvp23 (unsigned integer 0-63, acceleration between brake phases 2-3)."@en ;
        sh:message "Jedes NVKItem muss genau einen Wert für a_nvp23 haben (vorzeichenlose Ganzzahl 0-63, acceleration between brake phases 2-3)."@de ;
        sh:message "Chaque NVKItem doit avoir exactement une valeur pour a_nvp23 (entier non signé 0-63, acceleration between brake phases 2-3)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NVK Sub Items (optional, up to 31 sub-items for speed-dependent curves)
    sh:property [ 
        sh:path era:nvkSubItems ;
        sh:node era:NVKSubItemShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 31 ;
        sh:message "An NVKItem may have at most 31 nvkSubItems that conform to NVKSubItem object."@en ;
        sh:message "Ein NVKItem kann höchstens 31 nvkSubItems-Eintrag/Einträge haben, der/die der Form NVKSubItem entspricht/entsprechen."@de ;
        sh:message "Un NVKItem peut avoir au plus 31 entrée(s) nvkSubItems, conforme(s) à la forme NVKSubItem."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== NVK Sub Item Shape =====
era:NVKSubItemShape a sh:NodeShape ;
    sh:targetClass era:NVKSubItem ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because an NVKSubItem is missing its v_nvkvint value or a value is outside its valid range. This field is required and adds an additional speed-dependent kinematic value point refining the national braking curve."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einem NVKSubItem der Wert v_nvkvint fehlt oder außerhalb des gültigen Bereichs liegt. Dieses Feld ist erforderlich und fügt einen zusätzlichen geschwindigkeitsabhängigen kinematischen Wertepunkt zur Verfeinerung der nationalen Bremskurve hinzu."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'un NVKSubItem ne précise pas sa valeur v_nvkvint, ou que celle-ci est hors de la plage valide. Ce champ est requis et ajoute un point de valeur cinématique supplémentaire dépendant de la vitesse, affinant la courbe de freinage nationale."@fr ;
    # V_NVKVINT (required, unsigned integer 0-127 - speed for kinematic calculation in km/h)
    sh:property [ 
        sh:path era:v_nvkvint ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NVKSubItem must have exactly one v_nvkvint (unsigned integer 0-127, speed for braking curve in km/h)."@en ;
        sh:message "Jedes NVKSubItem muss genau einen Wert für v_nvkvint haben (vorzeichenlose Ganzzahl 0-127, speed for braking curve in km/h)."@de ;
        sh:message "Chaque NVKSubItem doit avoir exactement une valeur pour v_nvkvint (entier non signé 0-127, speed for braking curve in km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    
    # M_NVKVINT (required, unsigned integer 0-127 - kinematic value 1)
    sh:property [ 
        sh:path era:m_nvkvint ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:maxCount 1 ;
        sh:message "Each NVKSubItem must have exactly one m_nvkvint (unsigned integer 0-127, kinematic braking parameter 1)." ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_NVKVINT_2 (required, unsigned integer 0-127 - kinematic value 2)
    sh:property [ 
        sh:path era:m_nvkvint_2 ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:maxCount 1 ;
        sh:message "Each NVKSubItem must have exactly one m_nvkvint_2 (unsigned integer 0-127, kinematic braking parameter 2)."@en ;
        sh:message "Jedes NVKSubItem muss genau einen Wert für m_nvkvint_2 haben (vorzeichenlose Ganzzahl 0-127, kinematic braking parameter 2)."@de ;
        sh:message "Chaque NVKSubItem doit avoir exactement une valeur pour m_nvkvint_2 (entier non signé 0-127, kinematic braking parameter 2)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== PBD Selection Shape =====
era:PBDSelectionShape a sh:NodeShape ;
    sh:targetClass era:PBDSelection ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a PBDSelection is missing one of its required fields — d_pbd, q_gdir, g_pbdsr, q_pbdsr, d_pbdsr, or l_pbdsr — or a value is outside its valid range. These fields together define a segment used to calculate a speed restriction ensuring a permitted braking distance."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einer PBDSelection eines der erforderlichen Felder — d_pbd, q_gdir, g_pbdsr, q_pbdsr, d_pbdsr oder l_pbdsr — fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Diese Felder definieren gemeinsam einen Abschnitt zur Berechnung einer Geschwindigkeitsbeschränkung zur Einhaltung eines zulässigen Bremswegs."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'une PBDSelection ne précise pas l'un de ses champs requis — d_pbd, q_gdir, g_pbdsr, q_pbdsr, d_pbdsr ou l_pbdsr — ou qu'une valeur est hors de sa plage valide. Ces champs définissent ensemble un segment utilisé pour calculer une restriction de vitesse garantissant une distance de freinage autorisée."@fr ;
    # D_PBD (required, unsigned integer 0-32767 - distance to permitted braking distance start)
    sh:property [ 
        sh:path era:d_pbd ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PBDSelection must have exactly one d_pbd (unsigned integer 0-32767, distance to PBD start)."@en ;
        sh:message "Jedes PBDSelection muss genau einen Wert für d_pbd haben (vorzeichenlose Ganzzahl 0-32767, distance to PBD start)."@de ;
        sh:message "Chaque PBDSelection doit avoir exactement une valeur pour d_pbd (entier non signé 0-32767, distance to PBD start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_GDIR (required, boolean - gradient direction)
    sh:property [ 
        sh:path era:q_gdir ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PBDSelection must have exactly one q_gdir (boolean, gradient direction: downhill/uphill)."@en ;
        sh:message "Jedes PBDSelection muss genau einen Wert für q_gdir haben (boolescher Wert, gradient direction: downhill/uphill)."@de ;
        sh:message "Chaque PBDSelection doit avoir exactement une valeur pour q_gdir (booléen, gradient direction: downhill/uphill)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # G_PBDSR (required, unsigned integer 0-255 - gradient for speed restriction in per mille)
    sh:property [ 
        sh:path era:g_pbdsr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PBDSelection must have exactly one g_pbdsr (unsigned integer 0-255, gradient in per mille)."@en ;
        sh:message "Jedes PBDSelection muss genau einen Wert für g_pbdsr haben (vorzeichenlose Ganzzahl 0-255, gradient in per mille)."@de ;
        sh:message "Chaque PBDSelection doit avoir exactement une valeur pour g_pbdsr (entier non signé 0-255, gradient in per mille)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_PBDSR (required, boolean - PBD speed restriction qualifier)
    sh:property [ 
        sh:path era:q_pbdsr ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PBDSelection must have exactly one q_pbdsr (boolean, whether speed restriction follows)."@en ;
        sh:message "Jedes PBDSelection muss genau einen Wert für q_pbdsr haben (boolescher Wert, whether speed restriction follows)."@de ;
        sh:message "Chaque PBDSelection doit avoir exactement une valeur pour q_pbdsr (booléen, whether speed restriction follows)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # D_PBDSR (required, unsigned integer 0-32767 - distance to PBD speed restriction)
    sh:property [ 
        sh:path era:d_pbdsr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PBDSelection must have exactly one d_pbdsr (unsigned integer 0-32767, distance to speed restriction)."@en ;
        sh:message "Jedes PBDSelection muss genau einen Wert für d_pbdsr haben (vorzeichenlose Ganzzahl 0-32767, distance to speed restriction)."@de ;
        sh:message "Chaque PBDSelection doit avoir exactement une valeur pour d_pbdsr (entier non signé 0-32767, distance to speed restriction)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_PBDSR (required, unsigned integer 0-32767 - length of PBD speed restriction)
    sh:property [ 
        sh:path era:l_pbdsr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PBDSelection must have exactly one l_pbdsr (unsigned integer 0-32767, length of speed restriction)."@en ;
        sh:message "Jedes PBDSelection muss genau einen Wert für l_pbdsr haben (vorzeichenlose Ganzzahl 0-32767, length of speed restriction)."@de ;
        sh:message "Chaque PBDSelection doit avoir exactement une valeur pour l_pbdsr (entier non signé 0-32767, length of speed restriction)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Packet Shape (Discriminator Union) =====
era:PacketShape a sh:NodeShape ;
    sh:targetClass era:Packet ;
    era:additionalInfo "[BUSINESS RULE] This error might be because a Packet instance does not contain exactly one of the defined ETCS packet types (packets 0-255), or the content it does contain does not conform to that packet's own shape. Every Packet must carry exactly one packet_N property, matching one and only one of the 44 defined ETCS packet shapes, and the value must itself satisfy all requirements of that specific packet shape."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass eine Packet-Instanz nicht genau einen der definierten ETCS-Pakettypen (Pakete 0-255) enthält, oder dass der enthaltene Inhalt nicht der Form des jeweiligen Pakets entspricht. Jedes Packet muss genau eine packet_N-Eigenschaft tragen, die genau einer der 44 definierten ETCS-Paketformen entspricht, und der Wert muss selbst alle Anforderungen dieser spezifischen Paketform erfüllen."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'une instance de Packet ne contient pas exactement l'un des types de paquet ETCS définis (paquets 0-255), ou que le contenu qu'elle contient n'est pas conforme à la forme de ce paquet. Chaque Packet doit porter exactement une propriété packet_N, correspondant à une seule des 44 formes de paquet ETCS définies, et la valeur doit elle-même satisfaire toutes les exigences de cette forme de paquet spécifique."@fr ;
    sh:message "A Packet must contain exactly one ETCS packet type (packets 0-255). Also, ensure conformance to the specific packet object"@en ;
    sh:message "Ein Packet muss genau einen ETCS-Pakettyp enthalten (Pakete 0-255). Zudem muss die Konformität mit dem jeweiligen Paketobjekt sichergestellt sein."@de ;
    sh:message "Un Packet doit contenir exactement un type de paquet ETCS (paquets 0-255). Veillez également à respecter la conformité avec l'objet de paquet spécifique."@fr ;
    
    # Each Packet instance must have exactly ONE of the packet types
    sh:xone (
        [ sh:path era:packet_0 ;
          sh:node era:ETCSPacket_0Shape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Packet contains ETCSPacket_0 (Position Report)."@en ;
          sh:message "Packet enthält ETCSPacket_0 (Positionsmeldung)."@de ;
          sh:message "Packet contient ETCSPacket_0 (Rapport de position)."@fr ]
        
        [ sh:path era:packet_2 ;
          sh:node era:ETCSPacket_2Shape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Packet contains ETCSPacket_2 (System Version Order)."@en ;
          sh:message "Packet enthält ETCSPacket_2 (Systemversionsauftrag)."@de ;
          sh:message "Packet contient ETCSPacket_2 (Ordre de version système)."@fr ]
        
        [ sh:path era:packet_3 ;
          sh:node era:ETCSPacket_3Shape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Packet contains ETCSPacket_3 (National Values)."@en ;
          sh:message "Packet enthält ETCSPacket_3 (Nationale Werte)."@de ;
          sh:message "Packet contient ETCSPacket_3 (Valeurs nationales)."@fr ]
        
        [ sh:path era:packet_5 ;
          sh:node era:ETCSPacket_5Shape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Packet contains ETCSPacket_5 (Linking)."@en ;
          sh:message "Packet enthält ETCSPacket_5 (Verknüpfung)."@de ;
          sh:message "Packet contient ETCSPacket_5 (Liaison)."@fr ]
        
        [ sh:path era:packet_6 ;
