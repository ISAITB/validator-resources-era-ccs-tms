        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für q_nvinhsmicperm haben (boolescher Wert, inhibit SMIC permission)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour q_nvinhsmicperm (booléen, inhibit SMIC permission)."@fr ;
