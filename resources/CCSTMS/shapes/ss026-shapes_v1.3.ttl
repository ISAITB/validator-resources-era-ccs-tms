          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Packet contains ETCSPacket_6 (Virtual Balise Cover Order)."@en ;
          sh:message "Packet enthält ETCSPacket_6 (Auftrag zur virtuellen Balisenabdeckung)."@de ;
          sh:message "Packet contient ETCSPacket_6 (Ordre de couverture virtuelle de balise)."@fr ]
        
        [ sh:path era:packet_16 ;
