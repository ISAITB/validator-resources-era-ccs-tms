@prefix era: <http://data.europa.eu/949/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== Axle Load Restriction Shape =====
era:AxleLoadRestrictionShape a sh:NodeShape ;
    sh:targetClass era:AxleLoadRestriction ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because an AxleLoadRestriction is missing its axle load category or speed value, or the speed value is outside the valid range. Each AxleLoadRestriction must specify a v_axleLoad (0-127 km/h) and a valid m_axleLoadCat concept, defining the speed restriction that applies to trains of that axle load category or above."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einer AxleLoadRestriction die Achslastkategorie oder der Geschwindigkeitswert fehlt oder der Geschwindigkeitswert außerhalb des gültigen Bereichs liegt. Jede AxleLoadRestriction muss einen v_axleLoad-Wert (0-127 km/h) und ein gültiges m_axleLoadCat-Konzept angeben, das die Geschwindigkeitsbeschränkung für Züge dieser Achslastkategorie oder höher definiert."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'une AxleLoadRestriction ne précise pas sa catégorie de charge à l'essieu ou sa valeur de vitesse, ou que cette valeur est hors de la plage valide. Chaque AxleLoadRestriction doit indiquer une valeur v_axleLoad (0-127 km/h) et un concept m_axleLoadCat valide, définissant la restriction de vitesse applicable aux trains de cette catégorie de charge à l'essieu ou supérieure."@fr ;
    # V_AXLELOAD (required, unsigned integer 0-127 - speed in km/h)
    sh:property [ 
        sh:path era:v_axleLoad ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AxleLoadRestriction must have exactly one v_axleLoad value (unsigned integer 0-127, speed in km/h)."@en ;
        sh:message "Jedes AxleLoadRestriction muss genau einen Wert für v_axleLoad haben (vorzeichenlose Ganzzahl 0-127, Geschwindigkeit in km/h)."@de ;
        sh:message "Chaque AxleLoadRestriction doit avoir exactement une valeur pour v_axleLoad (entier non signé 0-127, vitesse en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_AXLELOADCAT (required, controlled vocabulary - axle load category)
    sh:property [ 
        sh:path era:m_axleLoadCat ;
        sh:in (
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_A>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_HS17>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B1>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4XL>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E5>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_axleLoadCat must have a value from the defined SKOS concept scheme (AL_A through AL_E5)."@en ;
        sh:message "Die Eigenschaft m_axleLoadCat muss einen Wert aus dem definierten SKOS-Konzeptschema haben (AL_A through AL_E5)."@de ;
        sh:message "La propriété m_axleLoadCat doit avoir une valeur issue du schéma de concepts SKOS défini (AL_A through AL_E5)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Axle Load Selection Shape =====
era:AxleLoadSelectionShape a sh:NodeShape ;
    sh:targetClass era:AxleLoadSelection ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because an AxleLoadSelection's distance or length value is outside the valid range, or its list of axleLoadRestrictions exceeds 31 entries. Each AxleLoadSelection defines one segment of track over which axle-load-dependent speed restrictions apply."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass der Entfernungs- oder Längenwert einer AxleLoadSelection außerhalb des gültigen Bereichs liegt oder die Liste der axleLoadRestrictions mehr als 31 Einträge enthält. Jede AxleLoadSelection definiert einen Gleisabschnitt, für den achslastabhängige Geschwindigkeitsbeschränkungen gelten."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que la valeur de distance ou de longueur d'une AxleLoadSelection est hors de la plage valide, ou que sa liste d'axleLoadRestrictions dépasse 31 entrées. Chaque AxleLoadSelection définit un segment de voie sur lequel s'appliquent des restrictions de vitesse liées à la charge à l'essieu."@fr ;
    # D_AXLELOAD (required, unsigned integer 0-32767 - distance in meters)
    sh:property [ 
        sh:path era:d_axleload ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:maxCount 1 ;
        sh:message "Each AxleLoadSelection may have exactly one d_axleload value (unsigned integer 0-32767, distance in meters)."@en ;
        sh:message "Jedes AxleLoadSelection kann höchstens einen Wert für d_axleload haben (vorzeichenlose Ganzzahl 0-32767, Entfernung in Metern)."@de ;
        sh:message "Chaque AxleLoadSelection peut avoir au plus une valeur pour d_axleload (entier non signé 0-32767, distance en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_AXLELOAD (required, unsigned integer 0-32767 - length in meters)
    sh:property [ 
        sh:path era:l_axleload ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:maxCount 1 ;
        sh:message "Each AxleLoadSelection may have exactly one l_axleload value (unsigned integer 0-32767, length in meters)."@en ;
        sh:message "Jedes AxleLoadSelection kann höchstens einen Wert für l_axleload haben (vorzeichenlose Ganzzahl 0-32767, Länge in Metern)."@de ;
        sh:message "Chaque AxleLoadSelection peut avoir au plus une valeur pour l_axleload (entier non signé 0-32767, longueur en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_FRONT (optional, boolean - applies to front of train)
    sh:property [ 
        sh:path era:q_front ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "An AxleLoadSelection may have at most one q_front value (boolean)."@en ;
        sh:message "Ein AxleLoadSelection kann höchstens einen Wert für q_front haben (boolescher Wert)."@de ;
        sh:message "Un AxleLoadSelection peut avoir au plus une valeur pour q_front (booléen)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Axle Load Restrictions (optional, up to 31 allowed per ETCS spec)
    sh:property [ 
        sh:path era:axleLoadRestrictions ;
        sh:node era:AxleLoadRestrictionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 31 ;
        sh:message "An AxleLoadSelection may have at most 31 axleLoadRestrictions that conform to AxleLoadRestriction object."@en ;
        sh:message "Ein AxleLoadSelection kann höchstens 31 axleLoadRestrictions-Eintrag/Einträge haben, der/die der Form AxleLoadRestriction entspricht/entsprechen."@de ;
        sh:message "Un AxleLoadSelection peut avoir au plus 31 entrée(s) axleLoadRestrictions, conforme(s) à la forme AxleLoadRestriction."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Balise Packet Shape =====
era:BalisePacketShape a sh:NodeShape ;
    sh:targetClass era:BalisePacket ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a BalisePacket is missing its packetId, has an invalid q_dir value, or does not contain exactly one conforming packet object. Every BalisePacket must have exactly one packetId (0-255) and one packet, which must itself conform to one of the defined ETCS packet shapes."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einem BalisePacket die packetId fehlt, der q_dir-Wert ungültig ist oder es nicht genau ein konformes Packet-Objekt enthält. Jedes BalisePacket muss genau eine packetId (0-255) und genau ein Paket enthalten, das seinerseits einer der definierten ETCS-Paket-Formen entsprechen muss."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'un BalisePacket n'a pas de packetId, a une valeur q_dir invalide, ou ne contient pas exactement un objet packet conforme. Chaque BalisePacket doit avoir exactement une packetId (0-255) et un packet, qui doit lui-même être conforme à l'une des formes de paquet ETCS définies."@fr ;
    # Packet ID (required, unsigned integer 0-255 - ETCS packet number)
    sh:property [ 
        sh:path era:packetId ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each BalisePacket must have exactly one packetId (unsigned integer 0-255, ETCS packet number)."@en ;
        sh:message "Jedes BalisePacket muss genau einen Wert für packetId haben (vorzeichenlose Ganzzahl 0-255, ETCS packet number)."@de ;
        sh:message "Chaque BalisePacket doit avoir exactement une valeur pour packetId (entier non signé 0-255, ETCS packet number)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_SCALE (required, unsigned integer 0-2 - distance scale factor)
    sh:property [ 
        sh:path era:q_scale ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 2 ;
        sh:maxCount 1 ;
        sh:message "Each BalisePacket may have maximum of one q_scale value (unsigned integer 0-2: 0=10cm, 1=1m, 2=10m resolution)."@en ;
        sh:message "Jedes BalisePacket kann höchstens einen Wert für q_scale haben (vorzeichenlose Ganzzahl 0-2: 0=10cm, 1=1m, 2=10m resolution)."@de ;
        sh:message "Chaque BalisePacket peut avoir au plus une valeur pour q_scale (entier non signé 0-2: 0=10cm, 1=1m, 2=10m resolution)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_DIR (optional, controlled vocabulary - validity direction)
    sh:property [ 
        sh:path era:q_dir ;
        sh:in (
            <http://data.europa.eu/949/concepts/q-dir/reverse>
            <http://data.europa.eu/949/concepts/q-dir/nominal>
            <http://data.europa.eu/949/concepts/q-dir/both>
        ) ;
        sh:maxCount 1 ;
        sh:message "The property q_dir may have a value from the defined SKOS concept scheme (reverse, nominal, or both)."@en ;
        sh:message "Die Eigenschaft q_dir muss einen Wert aus dem definierten SKOS-Konzeptschema haben (reverse, nominal oder both)."@de ;
        sh:message "La propriété q_dir doit avoir une valeur issue du schéma de concepts SKOS défini (reverse, nominal, ou both)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Packet (required, can be inline or referenced)
    sh:property [ 
        sh:path era:packet ;
        sh:node era:PacketShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each BalisePacket must have exactly one packet that conforms to Packet object."@en ;
        sh:message "Jedes BalisePacket muss genau einen packet-Eintrag haben, der der Form Packet entspricht."@de ;
        sh:message "Chaque BalisePacket doit avoir exactement une entrée packet, conforme à la forme Packet."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Correction Factor Shape =====
era:CorrectionFactorShape a sh:NodeShape ;
    sh:targetClass era:CorrectionFactor ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a CorrectionFactor is missing its m_nvkrint or l_nvkrint value, or a value is outside the 0-31 range. Both fields are required, together defining a correction to the national braking model (NVK) kinematic parameters."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einem CorrectionFactor der Wert m_nvkrint oder l_nvkrint fehlt oder außerhalb des Bereichs 0-31 liegt. Beide Felder sind erforderlich und definieren gemeinsam eine Korrektur der kinematischen Parameter des nationalen Bremsmodells (NVK)."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'un CorrectionFactor ne précise pas sa valeur m_nvkrint ou l_nvkrint, ou qu'une valeur est hors de la plage 0-31. Les deux champs sont requis et définissent ensemble une correction des paramètres cinématiques du modèle de freinage national (NVK)."@fr ;
    # M_NVKRINT (required, unsigned integer 0-31 - correction value)
    sh:property [ 
        sh:path era:m_nvkrint ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 31 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CorrectionFactor must have exactly one m_nvkrint value (unsigned integer 0-31)."@en ;
        sh:message "Jedes CorrectionFactor muss genau einen Wert für m_nvkrint haben (vorzeichenlose Ganzzahl 0-31)."@de ;
        sh:message "Chaque CorrectionFactor doit avoir exactement une valeur pour m_nvkrint (entier non signé 0-31)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_NVKRINT (required, unsigned integer 0-31 - distance parameter)
    sh:property [ 
        sh:path era:l_nvkrint ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 31 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CorrectionFactor must have exactly one l_nvkrint value (unsigned integer 0-31)."@en ;
        sh:message "Jedes CorrectionFactor muss genau einen Wert für l_nvkrint haben (vorzeichenlose Ganzzahl 0-31)."@de ;
        sh:message "Chaque CorrectionFactor doit avoir exactement une valeur pour l_nvkrint (entier non signé 0-31)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Country Balise Shape =====
era:CountryBaliseShape a sh:NodeShape ;
    sh:targetClass era:CountryBalise ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a CountryBalise is missing its nid_bg (balise group identity) or a value is outside the valid range. nid_bg is required to identify the balise group within a list such as an SR Authority or Shunting Area balise list; nid_c is optional and only needed when the country differs from context."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einer CountryBalise die nid_bg (Balisengruppenkennung) fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. nid_bg ist erforderlich, um die Balisengruppe innerhalb einer Liste (z. B. SR-Berechtigung oder Rangierbereich) zu identifizieren; nid_c ist optional."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'une CountryBalise ne précise pas sa nid_bg (identité du groupe de balises) ou qu'une valeur est hors de la plage valide. nid_bg est requis pour identifier le groupe de balises dans une liste (par ex. autorité SR ou zone de manœuvre); nid_c est optionnel."@fr ;
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each CountryBalise may have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes CountryBalise kann höchstens einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque CountryBalise peut avoir au plus une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_BG (required, unsigned integer 0-16383 - balise group identity)
    sh:property [ 
        sh:path era:nid_bg ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each CountryBalise must have exactly one nid_bg (unsigned integer 0-16383, balise group identifier)."@en ;
        sh:message "Jedes CountryBalise muss genau einen Wert für nid_bg haben (vorzeichenlose Ganzzahl 0-16383, balise group Kennung)."@de ;
        sh:message "Chaque CountryBalise doit avoir exactement une valeur pour nid_bg (entier non signé 0-16383, balise group identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== DLM Condition Shape =====
era:DLMConditionShape a sh:NodeShape ;
    sh:targetClass era:DLMCondition ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a DLMCondition is missing its distance, length, or track condition type, or a value is outside its valid range. All three fields (d_trackcond, l_trackcond, m_trackcond) are required to define a general track condition such as a powerless section or air tightness zone."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einer DLMCondition Entfernung, Länge oder Bedingungstyp fehlen oder ein Wert außerhalb des gültigen Bereichs liegt. Alle drei Felder (d_trackcond, l_trackcond, m_trackcond) sind erforderlich, um eine allgemeine Streckenbedingung wie eine spannungslose Strecke oder Druckdichtheitszone zu definieren."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'une DLMCondition ne précise pas sa distance, sa longueur ou son type de condition, ou qu'une valeur est hors de sa plage valide. Les trois champs (d_trackcond, l_trackcond, m_trackcond) sont requis pour définir une condition de voie générale telle qu'une section sans tension ou une zone d'étanchéité."@fr ;
    # D_TRACKCOND (required, unsigned integer 0-32767 - distance in scaled meters)
    sh:property [ 
        sh:path era:d_trackcond ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DLMCondition must have exactly one d_trackcond (unsigned integer 0-32767, distance from LRBG)."@en ;
        sh:message "Jedes DLMCondition muss genau einen Wert für d_trackcond haben (vorzeichenlose Ganzzahl 0-32767, distance from LRBG)."@de ;
        sh:message "Chaque DLMCondition doit avoir exactement une valeur pour d_trackcond (entier non signé 0-32767, distance from LRBG)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_TRACKCOND (required, unsigned integer 0-32767 - length in scaled meters)
    sh:property [ 
        sh:path era:l_trackcond ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DLMCondition must have exactly one l_trackcond (unsigned integer 0-32767, length of condition section)."@en ;
        sh:message "Jedes DLMCondition muss genau einen Wert für l_trackcond haben (vorzeichenlose Ganzzahl 0-32767, length of condition section)."@de ;
        sh:message "Chaque DLMCondition doit avoir exactement une valeur pour l_trackcond (entier non signé 0-32767, length of condition section)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_TRACKCOND (required, unsigned integer 0-15 - track condition type)
    sh:property [ 
        sh:path era:m_trackcond ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 15 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DLMCondition must have exactly one m_trackcond (unsigned integer 0-15, track condition type code)."@en ;
        sh:message "Jedes DLMCondition muss genau einen Wert für m_trackcond haben (vorzeichenlose Ganzzahl 0-15, track condition type code)."@de ;
        sh:message "Chaque DLMCondition doit avoir exactement une valeur pour m_trackcond (entier non signé 0-15, track condition type code)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== DL Track Condition Shape =====
era:DLTrackCondShape a sh:NodeShape ;
    sh:targetClass era:DLTrackCond ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a DLTrackCond is missing its distance or length, or a value is outside the valid range. Both fields are required to define a track section (e.g. near big metal masses) where balise transmission integrity alarms should be ignored."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einem DLTrackCond Entfernung oder Länge fehlen oder ein Wert außerhalb des gültigen Bereichs liegt. Beide Felder sind erforderlich, um einen Streckenabschnitt (z. B. bei großen Metallmassen) zu definieren, in dem Integritätsalarme der Balisenübertragung ignoriert werden sollen."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'un DLTrackCond ne précise pas sa distance ou sa longueur, ou qu'une valeur est hors de la plage valide. Les deux champs sont requis pour définir une section de voie (par ex. à proximité de masses métalliques) où les alarmes d'intégrité de transmission des balises doivent être ignorées."@fr ;
    # D_TRACKCOND (required, unsigned integer 0-32767 - distance in scaled meters)
    sh:property [ 
        sh:path era:d_trackcond ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DLTrackCond must have exactly one d_trackcond (unsigned integer 0-32767, distance from LRBG)."@en ;
        sh:message "Jedes DLTrackCond muss genau einen Wert für d_trackcond haben (vorzeichenlose Ganzzahl 0-32767, distance from LRBG)."@de ;
        sh:message "Chaque DLTrackCond doit avoir exactement une valeur pour d_trackcond (entier non signé 0-32767, distance from LRBG)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_TRACKCOND (required, unsigned integer 0-32767 - length in scaled meters)
    sh:property [ 
        sh:path era:l_trackcond ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DLTrackCond must have exactly one l_trackcond (unsigned integer 0-32767, length of condition section)."@en ;
        sh:message "Jedes DLTrackCond muss genau einen Wert für l_trackcond haben (vorzeichenlose Ganzzahl 0-32767, length of condition section)."@de ;
        sh:message "Chaque DLTrackCond doit avoir exactement une valeur pour l_trackcond (entier non signé 0-32767, length of condition section)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 0 Shape =====
era:ETCSPacket_0Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_0 ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 0 (Virtual Balise Cover marker) is missing its nid_vbcmk value or the value is outside the 0-63 range. nid_vbcmk is the only field on this packet and identifies which Virtual Balise Cover marker this telegram belongs to."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 0 (Kennung der virtuellen Balisenabdeckung) der Wert nid_vbcmk fehlt oder außerhalb des Bereichs 0-63 liegt. nid_vbcmk ist das einzige Feld dieses Pakets und identifiziert, zu welcher virtuellen Balisenabdeckung dieses Telegramm gehört."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 0 (marqueur de couverture virtuelle de balise) ne précise pas sa valeur nid_vbcmk ou que celle-ci est hors de la plage 0-63. nid_vbcmk est le seul champ de ce paquet et identifie à quel marqueur de couverture virtuelle ce télégramme appartient."@fr ;
    # NID_VBCMK (required, unsigned integer 0-63 - virtual balise cover marker identity)
    sh:property [ 
        sh:path era:nid_vbcmk ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 63 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_0 must have exactly one nid_vbcmk (unsigned integer 0-63, virtual balise cover marker ID)."@en ;
        sh:message "Jedes ETCSPacket_0 muss genau einen Wert für nid_vbcmk haben (vorzeichenlose Ganzzahl 0-63, virtual balise cover marker ID)."@de ;
        sh:message "Chaque ETCSPacket_0 doit avoir exactement une valeur pour nid_vbcmk (entier non signé 0-63, virtual balise cover marker ID)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 131 Shape =====
era:ETCSPacket_131Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_131 ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 131 (RBC transition order, System Version 1.1) is missing one of its required fields — nid_c, nid_rbc, d_rbctr, nid_radio, or q_sleepsession — or a value is outside its valid range. All five fields are required to announce the neighbouring RBC's identity, contact details and transition distance."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 131 (RBC-Übergangsauftrag, Systemversion 1.1) eines der erforderlichen Felder — nid_c, nid_rbc, d_rbctr, nid_radio oder q_sleepsession — fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Alle fünf Felder sind erforderlich, um Kennung, Kontaktdaten und Übergangsentfernung des benachbarten RBC anzukündigen."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 131 (ordre de transition RBC, version système 1.1) ne précise pas l'un de ses champs requis — nid_c, nid_rbc, d_rbctr, nid_radio ou q_sleepsession — ou qu'une valeur est hors de sa plage valide. Les cinq champs sont requis pour annoncer l'identité, les coordonnées et la distance de transition du RBC voisin."@fr ;
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_131 must have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes ETCSPacket_131 muss genau einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque ETCSPacket_131 doit avoir exactement une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_RBC (required, unsigned integer 0-16383 - RBC identity)
    sh:property [ 
        sh:path era:nid_rbc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_131 must have exactly one nid_rbc (unsigned integer 0-16383, Radio Block Centre identifier)."@en ;
        sh:message "Jedes ETCSPacket_131 muss genau einen Wert für nid_rbc haben (vorzeichenlose Ganzzahl 0-16383, Radio Block Centre Kennung)."@de ;
        sh:message "Chaque ETCSPacket_131 doit avoir exactement une valeur pour nid_rbc (entier non signé 0-16383, Radio Block Centre identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # D_RBCTR (required, unsigned integer 0-32767 - distance to RBC transition in scaled meters)
    sh:property [ 
        sh:path era:d_rbctr ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_131 must have exactly one d_rbctr (unsigned integer 0-32767, distance to RBC transition)."@en ;
        sh:message "Jedes ETCSPacket_131 muss genau einen Wert für d_rbctr haben (vorzeichenlose Ganzzahl 0-32767, distance to RBC transition)."@de ;
        sh:message "Chaque ETCSPacket_131 doit avoir exactement une valeur pour d_rbctr (entier non signé 0-32767, distance to RBC transition)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_RADIO (required, string - radio network identity/phone number)
    sh:property [ 
        sh:path era:nid_radio ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_131 must have exactly one nid_radio (string, radio network ID or phone number)."@en ;
        sh:message "Jedes ETCSPacket_131 muss genau einen Wert für nid_radio haben (Zeichenkette, radio network ID or phone number)."@de ;
        sh:message "Chaque ETCSPacket_131 doit avoir exactement une valeur pour nid_radio (chaîne de caractères, radio network ID or phone number)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_SLEEPSESSION (required, boolean - sleep session permitted)
    sh:property [ 
        sh:path era:q_sleepsession ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_131 must have exactly one q_sleepsession (boolean, whether sleep session is allowed)."@en ;
        sh:message "Jedes ETCSPacket_131 muss genau einen Wert für q_sleepsession haben (boolescher Wert, whether sleep session is allowed)."@de ;
        sh:message "Chaque ETCSPacket_131 doit avoir exactement une valeur pour q_sleepsession (booléen, whether sleep session is allowed)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 132 Shape =====
era:ETCSPacket_132Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_132 ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 132 (Danger for Shunting) is missing its q_aspect value. This single boolean field is required and indicates the stop/danger aspect for a train operating in Shunting mode."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 132 (Gefahr für Rangierfahrt) der Wert q_aspect fehlt. Dieses einzelne boolesche Feld ist erforderlich und zeigt den Halt-/Gefahrenaspekt für eine im Rangiermodus fahrende Einheit an."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 132 (danger pour manœuvre) ne précise pas sa valeur q_aspect. Ce champ booléen unique est requis et indique l'aspect d'arrêt/danger pour un train circulant en mode manœuvre."@fr ;
    # Q_ASPECT (required, boolean - danger aspect indicator)
    sh:property [ 
        sh:path era:q_aspect ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_132 must have exactly one q_aspect (boolean, stop/danger aspect indicator)."@en ;
        sh:message "Jedes ETCSPacket_132 muss genau einen Wert für q_aspect haben (boolescher Wert, stop/danger aspect indicator)."@de ;
        sh:message "Chaque ETCSPacket_132 doit avoir exactement une valeur pour q_aspect (booléen, stop/danger aspect indicator)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 133 Shape =====
era:ETCSPacket_133Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_133 ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 133 (RBC/RIU transition order, System Version 1.1) is missing one of its required fields — nid_riu, d_infill, q_riu, or nid_radio — or a value is outside its valid range. These fields identify the Radio Infill Unit and its infill balise group."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 133 (RBC/RIU-Übergangsauftrag, Systemversion 1.1) eines der erforderlichen Felder — nid_riu, d_infill, q_riu oder nid_radio — fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Diese Felder identifizieren die Funk-Infill-Einheit und ihre Infill-Balisengruppe."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 133 (ordre de transition RBC/RIU, version système 1.1) ne précise pas l'un de ses champs requis — nid_riu, d_infill, q_riu ou nid_radio — ou qu'une valeur est hors de sa plage valide. Ces champs identifient l'unité d'infill radio et son groupe de balises d'infill."@fr ;
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_133 must have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes ETCSPacket_133 muss genau einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque ETCSPacket_133 doit avoir exactement une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_BG (required, unsigned integer 0-16383 - balise group identity)
    sh:property [ 
        sh:path era:nid_bg ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_133 may have exactly one nid_bg (unsigned integer 0-16383, balise group identifier)."@en ;
        sh:message "Jedes ETCSPacket_133 kann höchstens einen Wert für nid_bg haben (vorzeichenlose Ganzzahl 0-16383, balise group Kennung)."@de ;
        sh:message "Chaque ETCSPacket_133 peut avoir au plus une valeur pour nid_bg (entier non signé 0-16383, balise group identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_C_NEXT (required, unsigned integer 0-1023 - next country identity)
    sh:property [ 
        sh:path era:nid_c_next ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_133 may have exactly one nid_c_next (unsigned integer 0-1023, next country identifier for infill)."@en ;
        sh:message "Jedes ETCSPacket_133 kann höchstens einen Wert für nid_c_next haben (vorzeichenlose Ganzzahl 0-1023, next country Kennung for infill)."@de ;
        sh:message "Chaque ETCSPacket_133 peut avoir au plus une valeur pour nid_c_next (entier non signé 0-1023, next country identifiant for infill)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_RIU (required, unsigned integer 0-16383 - Radio Infill Unit identity)
    sh:property [ 
        sh:path era:nid_riu ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_133 must have exactly one nid_riu (unsigned integer 0-16383, Radio Infill Unit identifier)."@en ;
        sh:message "Jedes ETCSPacket_133 muss genau einen Wert für nid_riu haben (vorzeichenlose Ganzzahl 0-16383, Radio Infill Unit Kennung)."@de ;
        sh:message "Chaque ETCSPacket_133 doit avoir exactement une valeur pour nid_riu (entier non signé 0-16383, Radio Infill Unit identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # D_INFILL (required, unsigned integer 0-32767 - distance to infill location)
    sh:property [ 
        sh:path era:d_infill ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_133 must have exactly one d_infill (unsigned integer 0-32767, distance to infill balise group)."@en ;
        sh:message "Jedes ETCSPacket_133 muss genau einen Wert für d_infill haben (vorzeichenlose Ganzzahl 0-32767, distance to infill balise group)."@de ;
        sh:message "Chaque ETCSPacket_133 doit avoir exactement une valeur pour d_infill (entier non signé 0-32767, distance to infill balise group)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_RIU (required, boolean - infill balise in opposite or same direction)
    sh:property [ 
        sh:path era:q_riu ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_133 must have exactly one q_riu (boolean, infill direction indicator)."@en ;
        sh:message "Jedes ETCSPacket_133 muss genau einen Wert für q_riu haben (boolescher Wert, infill direction indicator)."@de ;
        sh:message "Chaque ETCSPacket_133 doit avoir exactement une valeur pour q_riu (booléen, infill direction indicator)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_RADIO (required, string - radio network identity/phone number for RIU)
    sh:property [ 
        sh:path era:nid_radio ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_133 must have exactly one nid_radio (string, radio network ID for contacting RIU)."@en ;
        sh:message "Jedes ETCSPacket_133 muss genau einen Wert für nid_radio haben (Zeichenkette, radio network ID for contacting RIU)."@de ;
        sh:message "Chaque ETCSPacket_133 doit avoir exactement une valeur pour nid_radio (chaîne de caractères, radio network ID for contacting RIU)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 134 Shape =====
era:ETCSPacket_134Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_134 ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 134 (Euroloop/EOLM information) is missing one of its required fields — d_loop, l_loop, nid_loop, q_loopdir, or q_sscode — or a value is outside its valid range. All five fields are required to describe the position, length, identity, direction and spread-spectrum code of a Euroloop."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 134 (Euroloop/EOLM-Informationen) eines der erforderlichen Felder — d_loop, l_loop, nid_loop, q_loopdir oder q_sscode — fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Alle fünf Felder sind erforderlich, um Position, Länge, Kennung, Richtung und Spreizspektrum-Code eines Euroloops zu beschreiben."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 134 (informations Euroloop/EOLM) ne précise pas l'un de ses champs requis — d_loop, l_loop, nid_loop, q_loopdir ou q_sscode — ou qu'une valeur est hors de sa plage valide. Les cinq champs sont requis pour décrire la position, la longueur, l'identité, la direction et le code à spectre étalé d'une boucle Euroloop."@fr ;
    # D_LOOP (required, unsigned integer 0-32767 - distance to loop start)
    sh:property [ 
        sh:path era:d_loop ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_134 must have exactly one d_loop (unsigned integer 0-32767, distance to loop start)."@en ;
        sh:message "Jedes ETCSPacket_134 muss genau einen Wert für d_loop haben (vorzeichenlose Ganzzahl 0-32767, distance to loop start)."@de ;
        sh:message "Chaque ETCSPacket_134 doit avoir exactement une valeur pour d_loop (entier non signé 0-32767, distance to loop start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_LOOP (required, unsigned integer 0-32767 - length of loop)
    sh:property [ 
        sh:path era:l_loop ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_134 must have exactly one l_loop (unsigned integer 0-32767, length of loop)."@en ;
        sh:message "Jedes ETCSPacket_134 muss genau einen Wert für l_loop haben (vorzeichenlose Ganzzahl 0-32767, length of loop)."@de ;
        sh:message "Chaque ETCSPacket_134 doit avoir exactement une valeur pour l_loop (entier non signé 0-32767, length of loop)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_LOOP (required, unsigned integer 0-16383 - loop identity)
    sh:property [ 
        sh:path era:nid_loop ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_134 must have exactly one nid_loop (unsigned integer 0-16383, loop identifier)."@en ;
        sh:message "Jedes ETCSPacket_134 muss genau einen Wert für nid_loop haben (vorzeichenlose Ganzzahl 0-16383, loop Kennung)."@de ;
        sh:message "Chaque ETCSPacket_134 doit avoir exactement une valeur pour nid_loop (entier non signé 0-16383, loop identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_LOOPDIR (required, boolean - loop direction)
    sh:property [ 
        sh:path era:q_loopdir ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_134 must have exactly one q_loopdir (boolean, loop direction indicator)."@en ;
        sh:message "Jedes ETCSPacket_134 muss genau einen Wert für q_loopdir haben (boolescher Wert, loop direction indicator)."@de ;
        sh:message "Chaque ETCSPacket_134 doit avoir exactement une valeur pour q_loopdir (booléen, loop direction indicator)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_SSCODE (required, unsigned integer 0-15 - spread spectrum code)
    sh:property [ 
        sh:path era:q_sscode ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 15 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_134 must have exactly one q_sscode (unsigned integer 0-15, spread spectrum code for Euroloop)."@en ;
        sh:message "Jedes ETCSPacket_134 muss genau einen Wert für q_sscode haben (vorzeichenlose Ganzzahl 0-15, spread spectrum code for Euroloop)."@de ;
        sh:message "Chaque ETCSPacket_134 doit avoir exactement une valeur pour q_sscode (entier non signé 0-15, spread spectrum code for Euroloop)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 135 Shape =====
era:ETCSPacket_135Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_135 ;
    era:additionalInfo "[BUSINESS RULE] Packet 135 (Stop if in Staff Responsible mode) carries no variable data. This shape simply confirms the instance is correctly typed as ETCSPacket_135; an error here likely indicates the instance is missing this type declaration."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Paket 135 (Halt bei Fahren im SR-Modus) enthält keine variablen Daten. Diese Form bestätigt lediglich, dass die Instanz korrekt als ETCSPacket_135 typisiert ist; ein Fehler hier deutet meist auf eine fehlende Typdeklaration hin."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Le Paquet 135 (arrêt si en mode SR) ne contient aucune donnée variable. Cette forme confirme simplement que l'instance est correctement typée comme ETCSPacket_135; une erreur ici indique probablement une déclaration de type manquante sur l'instance."@fr ;
    sh:message "ETCS Packet 135 - Stop if in Staff Responsible mode. This packet has no variables."@en ;
    sh:message "ETCS Paket 135 - Halt bei Fahren im SR-Modus. Dieses Paket enthält keine Variablen."@de ;
    sh:message "Paquet ETCS 135 - Arrêt si en mode SR. Ce paquet ne contient aucune variable."@fr .

# ===== ETCS Packet 136 Shape =====
era:ETCSPacket_136Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_136 ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 136 (Infill location reference) is missing its nid_bg (balise group identity) value or it is outside the valid range. nid_bg is required and identifies the balise group serving as the location reference for the infill information that follows."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 136 (Infill-Standortreferenz) der Wert nid_bg (Balisengruppenkennung) fehlt oder außerhalb des gültigen Bereichs liegt. nid_bg ist erforderlich und identifiziert die Balisengruppe, die als Standortreferenz für die nachfolgenden Infill-Informationen dient."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 136 (référence de localisation d'infill) ne précise pas sa valeur nid_bg (identité du groupe de balises) ou que celle-ci est hors de la plage valide. nid_bg est requis et identifie le groupe de balises servant de référence de position pour les informations d'infill qui suivent."@fr ;
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_136 may have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes ETCSPacket_136 kann höchstens einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque ETCSPacket_136 peut avoir au plus une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_BG (required, unsigned integer 0-16383 - balise group identity)
    sh:property [ 
        sh:path era:nid_bg ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_136 must have exactly one nid_bg (unsigned integer 0-16383, balise group identifier for infill reference)."@en ;
        sh:message "Jedes ETCSPacket_136 muss genau einen Wert für nid_bg haben (vorzeichenlose Ganzzahl 0-16383, balise group Kennung for infill reference)."@de ;
        sh:message "Chaque ETCSPacket_136 doit avoir exactement une valeur pour nid_bg (entier non signé 0-16383, balise group identifiant for infill reference)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== ETCS Packet 137 Shape =====
era:ETCSPacket_137Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_137 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 137 (Stop if in Staff Responsible, with condition) is missing its q_srstop value. This single boolean field is required and defines the SR stop condition."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 137 (Halt bei SR-Modus, mit Bedingung) der Wert q_srstop fehlt. Dieses einzelne boolesche Feld ist erforderlich und definiert die SR-Haltebedingung."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 137 (arrêt si en mode SR, avec condition) ne précise pas sa valeur q_srstop. Ce champ booléen unique est requis et définit la condition d'arrêt SR."@fr ;
    sh:message "ETCS Packet 137 - Stop if in Staff Responsible (SR) mode with additional conditions."@en ;
    sh:message "ETCS Paket 137 - Halt bei Fahren im SR-Modus mit zusätzlichen Bedingungen."@de ;
    sh:message "Paquet ETCS 137 - Arrêt si en mode SR avec conditions supplémentaires."@fr ;
    
    # Q_SRSTOP (required, boolean - SR stop condition qualifier)
    sh:property [ 
        sh:path era:q_srstop ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_137 must have exactly one q_srstop (boolean, SR stop condition)."@en ;
        sh:message "Jedes ETCSPacket_137 muss genau einen Wert für q_srstop haben (boolescher Wert, SR stop condition)."@de ;
        sh:message "Chaque ETCSPacket_137 doit avoir exactement une valeur pour q_srstop (booléen, SR stop condition)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 138 Shape =====
era:ETCSPacket_138Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_138 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 138 (Reverse area information) is missing its d_startreverse or l_reversearea value, or a value is outside the valid range. Both fields are required to define the start distance and length of the area where reversing is permitted."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 138 (Informationen zum Rückfahrbereich) der Wert d_startreverse oder l_reversearea fehlt oder außerhalb des gültigen Bereichs liegt. Beide Felder sind erforderlich, um Startentfernung und Länge des Bereichs zu definieren, in dem Rückwärtsfahren erlaubt ist."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 138 (informations sur la zone de recul) ne précise pas sa valeur d_startreverse ou l_reversearea, ou qu'une valeur est hors de la plage valide. Les deux champs sont requis pour définir la distance de début et la longueur de la zone où le recul est autorisé."@fr ;
    sh:message "ETCS Packet 138 - Reverse Area Information."@en ;
    sh:message "ETCS Paket 138 - Informationen zum Rückfahrbereich."@de ;
    sh:message "Paquet ETCS 138 - Informations sur la zone de recul."@fr ;
    
    # D_STARTREVERSE (required, unsigned integer 0-32767 - distance to reverse area start)
    sh:property [ 
        sh:path era:d_startreverse ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_138 must have exactly one d_startreverse (unsigned integer 0-32767, distance to reverse area start)."@en ;
        sh:message "Jedes ETCSPacket_138 muss genau einen Wert für d_startreverse haben (vorzeichenlose Ganzzahl 0-32767, distance to reverse area start)."@de ;
        sh:message "Chaque ETCSPacket_138 doit avoir exactement une valeur pour d_startreverse (entier non signé 0-32767, distance to reverse area start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_REVERSEAREA (required, unsigned integer 0-32767 - length of reverse area)
    sh:property [ 
        sh:path era:l_reversearea ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_138 must have exactly one l_reversearea (unsigned integer 0-32767, length of reverse area)."@en ;
        sh:message "Jedes ETCSPacket_138 muss genau einen Wert für l_reversearea haben (vorzeichenlose Ganzzahl 0-32767, length of reverse area)."@de ;
        sh:message "Chaque ETCSPacket_138 doit avoir exactement une valeur pour l_reversearea (entier non signé 0-32767, length of reverse area)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 139 Shape =====
era:ETCSPacket_139Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_139 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 139 (Reverse supervision information) is missing its d_reverse or v_reverse value, or a value is outside the valid range. Both fields are required to define the supervised distance and maximum permitted speed while reversing."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 139 (Informationen zur Rückfahrüberwachung) der Wert d_reverse oder v_reverse fehlt oder außerhalb des gültigen Bereichs liegt. Beide Felder sind erforderlich, um die überwachte Entfernung und die maximal zulässige Geschwindigkeit beim Rückwärtsfahren zu definieren."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 139 (informations de supervision en marche arrière) ne précise pas sa valeur d_reverse ou v_reverse, ou qu'une valeur est hors de la plage valide. Les deux champs sont requis pour définir la distance supervisée et la vitesse maximale autorisée en marche arrière."@fr ;
    sh:message "ETCS Packet 139 - Reverse Supervision Information."@en ;
    sh:message "ETCS Paket 139 - Informationen zur Rückfahrüberwachung."@de ;
    sh:message "Paquet ETCS 139 - Informations de supervision en marche arrière."@fr ;
    
    # D_REVERSE (required, unsigned integer 0-32767 - distance for reverse supervision)
    sh:property [ 
        sh:path era:d_reverse ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_139 must have exactly one d_reverse (unsigned integer 0-32767, distance for reverse supervision)."@en ;
        sh:message "Jedes ETCSPacket_139 muss genau einen Wert für d_reverse haben (vorzeichenlose Ganzzahl 0-32767, distance for reverse supervision)."@de ;
        sh:message "Chaque ETCSPacket_139 doit avoir exactement une valeur pour d_reverse (entier non signé 0-32767, distance for reverse supervision)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # V_REVERSE (required, unsigned integer 0-127 - maximum reverse speed in km/h)
    sh:property [ 
        sh:path era:v_reverse ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_139 must have exactly one v_reverse (unsigned integer 0-127, maximum reverse speed in km/h)."@en ;
        sh:message "Jedes ETCSPacket_139 muss genau einen Wert für v_reverse haben (vorzeichenlose Ganzzahl 0-127, maximum reverse Geschwindigkeit in km/h)."@de ;
        sh:message "Chaque ETCSPacket_139 doit avoir exactement une valeur pour v_reverse (entier non signé 0-127, maximum reverse vitesse en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 141 Shape =====
era:ETCSPacket_141Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_141 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 141 (Default gradient for TSR) is missing its g_tsr or q_gdir value, or a value is outside the valid range. Both fields are required to define the default gradient used for TSR supervision when no gradient profile (Packet 21) is available."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 141 (Standardneigung für TSR) der Wert g_tsr oder q_gdir fehlt oder außerhalb des gültigen Bereichs liegt. Beide Felder sind erforderlich, um die Standardneigung zur TSR-Überwachung zu definieren, wenn kein Neigungsprofil (Paket 21) verfügbar ist."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 141 (pente par défaut pour TSR) ne précise pas sa valeur g_tsr ou q_gdir, ou qu'une valeur est hors de la plage valide. Les deux champs sont requis pour définir la pente par défaut utilisée pour la supervision d'une TSR lorsqu'aucun profil de pente (Paquet 21) n'est disponible."@fr ;
    sh:message "ETCS Packet 141 - Default Gradient for Temporary Speed Restriction."@en ;
    sh:message "ETCS Paket 141 - Standardneigung für temporäre Geschwindigkeitsbeschränkung."@de ;
    sh:message "Paquet ETCS 141 - Pente par défaut pour restriction temporaire de vitesse."@fr ;
    
    # G_TSR (required, signed integer 0-255 - gradient value in per mille)
    sh:property [ 
        sh:path era:g_tsr ;
        sh:datatype xsd:int ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_141 must have exactly one g_tsr (signed integer 0-255, gradient in per mille)."@en ;
        sh:message "Jedes ETCSPacket_141 muss genau einen Wert für g_tsr haben (vorzeichenbehaftete Ganzzahl 0-255, gradient in per mille)."@de ;
        sh:message "Chaque ETCSPacket_141 doit avoir exactement une valeur pour g_tsr (entier signé 0-255, gradient in per mille)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_GDIR (required, boolean - gradient direction)
    sh:property [ 
        sh:path era:q_gdir ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_141 must have exactly one q_gdir (boolean, gradient direction: downhill/uphill)."@en ;
        sh:message "Jedes ETCSPacket_141 muss genau einen Wert für q_gdir haben (boolescher Wert, gradient direction: downhill/uphill)."@de ;
        sh:message "Chaque ETCSPacket_141 doit avoir exactement une valeur pour q_gdir (booléen, gradient direction: downhill/uphill)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 145 Shape =====
era:ETCSPacket_145Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_145 ;
    era:additionalInfo "[BUSINESS RULE] Packet 145 (Inhibition of balise group message consistency reaction) carries no variable data. This shape simply confirms the instance is correctly typed as ETCSPacket_145; an error here likely indicates a missing type declaration."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Paket 145 (Unterdrückung der Reaktion auf Konsistenzprüfung) enthält keine variablen Daten. Diese Form bestätigt lediglich, dass die Instanz korrekt als ETCSPacket_145 typisiert ist; ein Fehler hier deutet meist auf eine fehlende Typdeklaration hin."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Le Paquet 145 (inhibition de la réaction de cohérence) ne contient aucune donnée variable. Cette forme confirme simplement que l'instance est correctement typée comme ETCSPacket_145; une erreur ici indique probablement une déclaration de type manquante."@fr ;
    sh:message "ETCS Packet 145 - Inhibition of Balise Group Message Consistency Reaction. This packet has no variables."@en ;
    sh:message "ETCS Paket 145 - Unterdrückung der Reaktion auf Konsistenzprüfung der Balisengruppen-Nachricht. Dieses Paket enthält keine Variablen."@de ;
    sh:message "Paquet ETCS 145 - Inhibition de la réaction de cohérence du message de groupe de balises. Ce paquet ne contient aucune variable."@fr .

# ===== ETCS Packet 16 Shape =====
era:ETCSPacket_16Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_16 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 16 (International Static Speed Profile) is missing its l_section value or the value is outside the valid range. l_section is the only field and gives the length of the speed profile section."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 16 (Internationales statisches Geschwindigkeitsprofil) der Wert l_section fehlt oder außerhalb des gültigen Bereichs liegt. l_section ist das einzige Feld und gibt die Länge des Profilabschnitts an."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 16 (profil de vitesse statique international) ne précise pas sa valeur l_section ou que celle-ci est hors de la plage valide. l_section est le seul champ et indique la longueur du tronçon de profil."@fr ;
    sh:message "ETCS Packet 16 - International Static Speed Profile."@en ;
    sh:message "ETCS Paket 16 - Internationales statisches Geschwindigkeitsprofil."@de ;
    sh:message "Paquet ETCS 16 - Profil de vitesse statique international."@fr ;
    
    # L_SECTION (required, unsigned integer 0-32767 - length of section)
    sh:property [ 
        sh:path era:l_section ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_16 must have exactly one l_section (unsigned integer 0-32767, length of speed profile section)."@en ;
        sh:message "Jedes ETCSPacket_16 muss genau einen Wert für l_section haben (vorzeichenlose Ganzzahl 0-32767, length of speed profile section)."@de ;
        sh:message "Chaque ETCSPacket_16 doit avoir exactement une valeur pour l_section (entier non signé 0-32767, length of speed profile section)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 180 Shape =====
era:ETCSPacket_180Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_180 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 180 (Level crossing supervision) is missing its q_lssma value or the t_lssma value is outside the valid range. q_lssma is required; t_lssma is optional and gives the supervision time in seconds."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 180 (Bahnübergangsüberwachung) der Wert q_lssma fehlt oder der Wert t_lssma außerhalb des gültigen Bereichs liegt. q_lssma ist erforderlich; t_lssma ist optional und gibt die Überwachungszeit in Sekunden an."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 180 (supervision de passage à niveau) ne précise pas sa valeur q_lssma, ou que la valeur t_lssma est hors de la plage valide. q_lssma est requis; t_lssma est optionnel et indique le temps de supervision en secondes."@fr ;
    sh:message "ETCS Packet 180 - Level Crossing Information."@en ;
    sh:message "ETCS Paket 180 - Informationen zum Bahnübergang."@de ;
    sh:message "Paquet ETCS 180 - Informations sur le passage à niveau."@fr ;
    
    # Q_LSSMA (required, boolean - level crossing supervision qualifier)
    sh:property [ 
        sh:path era:q_lssma ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_180 must have exactly one q_lssma (boolean, level crossing supervision qualifier)."@en ;
        sh:message "Jedes ETCSPacket_180 muss genau einen Wert für q_lssma haben (boolescher Wert, level crossing supervision qualifier)."@de ;
        sh:message "Chaque ETCSPacket_180 doit avoir exactement une valeur pour q_lssma (booléen, level crossing supervision qualifier)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # T_LSSMA (required, unsigned integer 0-255 - time for level crossing supervision in seconds)
    sh:property [ 
        sh:path era:t_lssma ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_180 may have exactly one t_lssma (unsigned integer 0-255, time in seconds)."@en ;
        sh:message "Jedes ETCSPacket_180 kann höchstens einen Wert für t_lssma haben (vorzeichenlose Ganzzahl 0-255, time in Sekunden)."@de ;
        sh:message "Chaque ETCSPacket_180 peut avoir au plus une valeur pour t_lssma (entier non signé 0-255, time en secondes)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 181 Shape =====
era:ETCSPacket_181Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_181 ;
    era:additionalInfo "[BUSINESS RULE] Packet 181 (Geographical position information) has no standard variables defined in this model. This shape simply confirms the instance is correctly typed as ETCSPacket_181."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Paket 181 (Geografische Positionsinformationen) hat in diesem Modell keine definierten Standardvariablen. Diese Form bestätigt lediglich, dass die Instanz korrekt als ETCSPacket_181 typisiert ist."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Le Paquet 181 (informations de position géographique) n'a aucune variable standard définie dans ce modèle. Cette forme confirme simplement que l'instance est correctement typée comme ETCSPacket_181."@fr ;
    sh:message "ETCS Packet 181 - Geographical Position Information. This packet has no standard variables (contains only latitude/longitude which may be structured differently)."@en ;
    sh:message "ETCS Paket 181 - Geografische Positionsinformationen. Dieses Paket hat keine Standardvariablen (enthält nur Breiten-/Längengrad, die ggf. anders strukturiert sind)."@de ;
    sh:message "Paquet ETCS 181 - Informations de position géographique. Ce paquet n'a pas de variables standard (contient uniquement latitude/longitude, pouvant être structurées différemment)."@fr .

# ===== ETCS Packet 254 Shape =====
era:ETCSPacket_254Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_254 ;
    era:additionalInfo "[BUSINESS RULE] Packet 254 (Default balise/loop/RIU information) carries no variable data. This shape simply confirms the instance is correctly typed as ETCSPacket_254; an error here likely indicates a missing type declaration."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Paket 254 (Standardinformationen für Balise/Loop/RIU) enthält keine variablen Daten. Diese Form bestätigt lediglich, dass die Instanz korrekt als ETCSPacket_254 typisiert ist; ein Fehler hier deutet meist auf eine fehlende Typdeklaration hin."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Le Paquet 254 (informations par défaut balise/boucle/RIU) ne contient aucune donnée variable. Cette forme confirme simplement que l'instance est correctement typée comme ETCSPacket_254; une erreur ici indique probablement une déclaration de type manquante."@fr ;
    sh:message "ETCS Packet 254 - Default Balise/Loop or RIU Information. This packet has no variables."@en ;
    sh:message "ETCS Paket 254 - Standardinformationen für Balise/Loop/RIU. Dieses Paket enthält keine Variablen."@de ;
    sh:message "Paquet ETCS 254 - Informations par défaut balise/boucle/RIU. Ce paquet ne contient aucune variable."@fr .

# ===== ETCS Packet 255 Shape =====
era:ETCSPacket_255Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_255 ;
    era:additionalInfo "[BUSINESS RULE] Packet 255 (End of information) carries no variable data. This shape simply confirms the instance is correctly typed as ETCSPacket_255, marking the end of a telegram's packet sequence."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Paket 255 (Ende der Information) enthält keine variablen Daten. Diese Form bestätigt lediglich, dass die Instanz korrekt als ETCSPacket_255 typisiert ist und das Ende der Paketsequenz eines Telegramms markiert."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Le Paquet 255 (fin de l'information) ne contient aucune donnée variable. Cette forme confirme simplement que l'instance est correctement typée comme ETCSPacket_255, marquant la fin de la séquence de paquets d'un télégramme."@fr ;
    sh:message "ETCS Packet 255 - End of Information. This packet has no variables - marks end of transmission."@en ;
    sh:message "ETCS Paket 255 - Ende der Information. Dieses Paket enthält keine Variablen und markiert das Ende der Übertragung."@de ;
    sh:message "Paquet ETCS 255 - Fin de l'information. Ce paquet ne contient aucune variable et marque la fin de la transmission."@fr .

# ===== ETCS Packet 2 Shape =====
era:ETCSPacket_2Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_2 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 2 (System Version order) is missing its etcsMVersion value or the value is not one of the defined system versions (v1.0, v1.1, v2.0, v2.1). This field is required to order the onboard to operate using a specific ETCS system version."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 2 (Systemversionsauftrag) der Wert etcsMVersion fehlt oder nicht einer der definierten Systemversionen (v1.0, v1.1, v2.0, v2.1) entspricht. Dieses Feld ist erforderlich, um das Fahrzeuggerät anzuweisen, mit einer bestimmten ETCS-Systemversion zu arbeiten."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 2 (ordre de version système) ne précise pas sa valeur etcsMVersion, ou que celle-ci ne correspond à aucune des versions système définies (v1.0, v1.1, v2.0, v2.1). Ce champ est requis pour ordonner au système embarqué de fonctionner avec une version système ETCS spécifique."@fr ;
    sh:message "ETCS Packet 2 - System Version Order."@en ;
    sh:message "ETCS Paket 2 - Systemversionsauftrag."@de ;
    sh:message "Paquet ETCS 2 - Ordre de version système."@fr ;
    
    # ETCS M_VERSION (required, controlled vocabulary - ETCS message version)
    sh:property [ 
        sh:path era:etcsMVersion ;
        sh:in (
            <http://data.europa.eu/949/concepts/etcs-m-versions/v1_0>
            <http://data.europa.eu/949/concepts/etcs-m-versions/v1_1>
            <http://data.europa.eu/949/concepts/etcs-m-versions/v2_0>
            <http://data.europa.eu/949/concepts/etcs-m-versions/v2_1>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property etcsMVersion must have a value from the defined SKOS concept scheme (v1.0, v1.1, v2.0, or v2.1)."@en ;
        sh:message "Die Eigenschaft etcsMVersion muss einen Wert aus dem definierten SKOS-Konzeptschema haben (v1.0, v1.1, v2.0, or v2.1)."@de ;
        sh:message "La propriété etcsMVersion doit avoir une valeur issue du schéma de concepts SKOS défini (v1.0, v1.1, v2.0, or v2.1)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 39 Shape =====
era:ETCSPacket_39Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_39 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 39 (Track condition: change of traction system) is missing its d_traction or m_voltage value, or a value is outside the valid range. d_traction and m_voltage are required; nid_ctraction is only required when m_voltage indicates a country-specific system."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 39 (Streckenbedingung: Wechsel des Traktionssystems) der Wert d_traction oder m_voltage fehlt oder außerhalb des gültigen Bereichs liegt. d_traction und m_voltage sind erforderlich; nid_ctraction ist nur erforderlich, wenn m_voltage ein länderspezifisches System angibt."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 39 (condition de voie : changement de système de traction) ne précise pas sa valeur d_traction ou m_voltage, ou qu'une valeur est hors de la plage valide. d_traction et m_voltage sont requis; nid_ctraction n'est requis que si m_voltage indique un système spécifique à un pays."@fr ;
    sh:message "ETCS Packet 39 - Track Condition Change of Traction System."@en ;
    sh:message "ETCS Paket 39 - Streckenbedingung Wechsel des Traktionssystems."@de ;
    sh:message "Paquet ETCS 39 - Condition de voie : changement de système de traction."@fr ;
    
    # D_TRACTION (required, unsigned integer 0-32767 - distance to traction change)
    sh:property [ 
        sh:path era:d_traction ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_39 must have exactly one d_traction (unsigned integer 0-32767, distance to traction system change)."@en ;
        sh:message "Jedes ETCSPacket_39 muss genau einen Wert für d_traction haben (vorzeichenlose Ganzzahl 0-32767, distance to traction system change)."@de ;
        sh:message "Chaque ETCSPacket_39 doit avoir exactement une valeur pour d_traction (entier non signé 0-32767, distance to traction system change)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_VOLTAGE (required, unsigned integer 0-15 - voltage/traction system type)
    sh:property [ 
        sh:path era:m_voltage ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 15 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_39 must have exactly one m_voltage (unsigned integer 0-15, traction system type code)."@en ;
        sh:message "Jedes ETCSPacket_39 muss genau einen Wert für m_voltage haben (vorzeichenlose Ganzzahl 0-15, traction system type code)."@de ;
        sh:message "Chaque ETCSPacket_39 doit avoir exactement une valeur pour m_voltage (entier non signé 0-15, traction system type code)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_CTRACTION (required, unsigned integer 0-1023 - country-specific traction identifier)
    sh:property [ 
        sh:path era:nid_ctraction ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_39 must have exactly one nid_ctraction (unsigned integer 0-1023, country-specific traction ID)."@en ;
        sh:message "Jedes ETCSPacket_39 muss genau einen Wert für nid_ctraction haben (vorzeichenlose Ganzzahl 0-1023, country-specific traction ID)."@de ;
        sh:message "Chaque ETCSPacket_39 doit avoir exactement une valeur pour nid_ctraction (entier non signé 0-1023, country-specific traction ID)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Packet 3 Shape (National Values) =====
era:ETCSPacket_3Shape a sh:NodeShape ;
    sh:targetClass era:ETCSPacket_3 ;
    era:additionalInfo "[BUSINESS RULE] This error might be because Packet 3 (National Values) is missing one of its many required fields (e.g. nid_c, d_validnv, the various speed/distance/adhesion/time national parameters, or mNvcontact), or a value is outside its valid range. National Values must be complete for the onboard to apply the correct country-specific ETCS parameters."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei Paket 3 (Nationale Werte) eines der zahlreichen erforderlichen Felder (z. B. nid_c, d_validnv, die verschiedenen nationalen Geschwindigkeits-, Entfernungs-, Haft- oder Zeitparameter oder mNvcontact) fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Die nationalen Werte müssen vollständig sein, damit das Fahrzeuggerät die richtigen länderspezifischen ETCS-Parameter anwendet."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait que le Paquet 3 (valeurs nationales) ne précise pas l'un de ses nombreux champs requis (par ex. nid_c, d_validnv, les divers paramètres nationaux de vitesse, distance, adhérence ou temps, ou mNvcontact), ou qu'une valeur est hors de sa plage valide. Les valeurs nationales doivent être complètes pour que le système embarqué applique les bons paramètres ETCS spécifiques au pays."@fr ;
    sh:message "ETCS Packet 3 - National Values - contains country-specific ETCS parameters."@en ;
    sh:message "ETCS Paket 3 - Nationale Werte - enthält länderspezifische ETCS-Parameter."@de ;
    sh:message "Paquet ETCS 3 - Valeurs nationales - contient des paramètres ETCS spécifiques au pays."@fr ;
    
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_3 must have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_C_NEXT (required, unsigned integer 0-1023 - next country identity)
    sh:property [ 
        sh:path era:nid_c_next ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSPacket_3 must have exactly one nid_c_next (unsigned integer 0-1023, next country identifier for border crossing)."@en ;
        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für nid_c_next haben (vorzeichenlose Ganzzahl 0-1023, next country Kennung for border crossing)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour nid_c_next (entier non signé 0-1023, next country identifiant for border crossing)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # D_VALIDNV (required, unsigned integer 0-32767 - distance where national values are valid)
    sh:property [ 
        sh:path era:d_validnv ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
