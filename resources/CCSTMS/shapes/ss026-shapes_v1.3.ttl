        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für q_nvguiperm haben (boolescher Wert, GUI permission)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour q_nvguiperm (booléen, GUI permission)."@fr ;
