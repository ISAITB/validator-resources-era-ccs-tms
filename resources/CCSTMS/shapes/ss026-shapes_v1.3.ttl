          sh:maxCount 1 ;
          sh:message "Packet contains ETCSPacket_181 (Geographical Position Information)."@en ;
          sh:message "Packet enthält ETCSPacket_181 (Geografische Positionsinformationen)."@de ;
          sh:message "Packet contient ETCSPacket_181 (Informations de position géographique)."@fr ]
        
        [ sh:path era:packet_254 ;
          sh:node era:ETCSPacket_254Shape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Packet contains ETCSPacket_254 (Default Balise/Loop/RIU Information)."@en ;
          sh:message "Packet enthält ETCSPacket_254 (Standardinformationen für Balise/Loop/RIU)."@de ;
          sh:message "Packet contient ETCSPacket_254 (Informations par défaut balise/boucle/RIU)."@fr ]
        
        [ sh:path era:packet_255 ;
          sh:node era:ETCSPacket_255Shape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Packet contains ETCSPacket_255 (End of Information)."@en ;
          sh:message "Packet enthält ETCSPacket_255 (Ende der Information)."@de ;
          sh:message "Packet contient ETCSPacket_255 (Fin de l'information)."@fr ]
        
    ) .

        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 127 ;
        sh:maxCount 1 ;
        sh:message "Each NVKSubItem must have exactly one m_nvkvint (unsigned integer 0-127, kinematic braking parameter 1)."@en ;
        sh:message "Jedes NVKSubItem muss genau einen Wert für m_nvkvint haben (vorzeichenlose Ganzzahl 0-127, kinematic braking parameter 1)."@de ;
        sh:message "Chaque NVKSubItem doit avoir exactement une valeur pour m_nvkvint (entier non signé 0-127, kinematic braking parameter 1)."@fr ;
        sh:severity sh:Violation ;
    
# ===== Route Suitability Shape =====
era:RouteSuitabilityShape a sh:NodeShape ;
    sh:targetClass era:RouteSuitability ;
    era:additionalInfo "[BUSINESS RULE] This error might be because a RouteSuitability is missing its q_suitability or d_suitability value, or a value is outside its valid range or q_suitability is not one of loadingGuage, maxAxleLoad, or tractionSystem. These fields define one characteristic required for a train to enter the route."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einer RouteSuitability der Wert q_suitability oder d_suitability fehlt, ein Wert außerhalb des gültigen Bereichs liegt oder q_suitability keinem von loadingGuage, maxAxleLoad oder tractionSystem entspricht. Diese Felder definieren eine für die Streckenzulassung erforderliche Eigenschaft."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'une RouteSuitability ne précise pas sa valeur q_suitability ou d_suitability, qu'une valeur est hors de sa plage valide, ou que q_suitability ne correspond ni à loadingGuage, ni à maxAxleLoad, ni à tractionSystem. Ces champs définissent une caractéristique requise pour qu'un train emprunte l'itinéraire."@fr ;
    sh:message "Defines route compatibility characteristics for ETCS train suitability checking."@en ;
    sh:message "Definiert Streckenverträglichkeitseigenschaften zur ETCS-Zugeignungsprüfung."@de ;
    sh:message "Définit les caractéristiques de compatibilité d'itinéraire pour la vérification d'aptitude du train ETCS."@fr ;
    
    # Q Suitability (required, controlled vocabulary - suitability qualifier type)
    sh:property [ 
        sh:path era:q_suitability ;
        sh:in (
            <http://data.europa.eu/949/concepts/q-suitability/loadingGuage>
            <http://data.europa.eu/949/concepts/q-suitability/maxAxleLoad>
            <http://data.europa.eu/949/concepts/q-suitability/tractionSystem>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property q_suitability must have a value from the defined SKOS concept scheme (loadingGuage, maxAxleLoad, or tractionSystem)."@en ;
        sh:message "Die Eigenschaft q_suitability muss einen Wert aus dem definierten SKOS-Konzeptschema haben (loadingGuage, maxAxleLoad, or tractionSystem)."@de ;
        sh:message "La propriété q_suitability doit avoir une valeur issue du schéma de concepts SKOS défini (loadingGuage, maxAxleLoad, or tractionSystem)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # D Suitability (required, unsigned integer 0-32767 - distance parameter)
    sh:property [ 
        sh:path era:d_suitability ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RouteSuitability must have exactly one d_suitability (unsigned integer 0-32767, distance parameter in meters)."@en ;
        sh:message "Jedes RouteSuitability muss genau einen Wert für d_suitability haben (vorzeichenlose Ganzzahl 0-32767, distance parameter in meters)."@de ;
        sh:message "Chaque RouteSuitability doit avoir exactement une valeur pour d_suitability (entier non signé 0-32767, distance parameter in meters)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M Voltage (required, unsigned integer 0-15 - voltage identifier)
    sh:property [ 
        sh:path era:m_voltage ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 15 ;
        sh:maxCount 1 ;
        sh:message "Each RouteSuitability may have exactly one m_voltage (unsigned integer 0-15, ETCS voltage system identifier)."@en ;
        sh:message "Jedes RouteSuitability kann höchstens einen Wert für m_voltage haben (vorzeichenlose Ganzzahl 0-15, ETCS voltage system Kennung)."@de ;
        sh:message "Chaque RouteSuitability peut avoir au plus une valeur pour m_voltage (entier non signé 0-15, ETCS voltage system identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID C Traction (required, unsigned integer 0-1023 - traction system identifier)
    sh:property [ 
        sh:path era:nid_ctraction ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each RouteSuitability may have exactly one nid_ctraction (unsigned integer 0-1023, ETCS traction system country identifier)."@en ;
        sh:message "Jedes RouteSuitability kann höchstens einen Wert für nid_ctraction haben (vorzeichenlose Ganzzahl 0-1023, ETCS traction system country Kennung)."@de ;
        sh:message "Chaque RouteSuitability peut avoir au plus une valeur pour nid_ctraction (entier non signé 0-1023, ETCS traction system country identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M Axle Load Category (optional, controlled vocabulary)
    sh:property [ 
        sh:path era:m_axleLoadCat ;
        sh:in (
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_A>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_HS17>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B1>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4XL>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E5>
        ) ;
        sh:maxCount 1 ;
        sh:message "The property m_axleLoadCat must have a value from the defined SKOS concept scheme (AL_A through AL_E5)."@en ;
        sh:message "Die Eigenschaft m_axleLoadCat muss einen Wert aus dem definierten SKOS-Konzeptschema haben (AL_A through AL_E5)."@de ;
        sh:message "La propriété m_axleLoadCat doit avoir une valeur issue du schéma de concepts SKOS défini (AL_A through AL_E5)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M Line Gauge (optional, controlled vocabulary - loading gauge profile)
    sh:property [ 
        sh:path era:m_lineGauge ;
        sh:in (
            <http://data.europa.eu/949/concepts/loading-gauge-type/g1>
            <http://data.europa.eu/949/concepts/loading-gauge-type/gA>
            <http://data.europa.eu/949/concepts/loading-gauge-type/gB>
            <http://data.europa.eu/949/concepts/loading-gauge-type/gC>
        ) ;
        sh:maxCount 1 ;
        sh:message "The property m_lineGauge must have a value from the defined SKOS concept scheme (g1, gA, gB, or gC)."@en ;
        sh:message "Die Eigenschaft m_lineGauge muss einen Wert aus dem definierten SKOS-Konzeptschema haben (g1, gA, gB, or gC)."@de ;
        sh:message "La propriété m_lineGauge doit avoir une valeur issue du schéma de concepts SKOS défini (g1, gA, gB, or gC)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== TCSP Condition (Track Condition Station Platform) Shape =====
era:TCSPConditionShape a sh:NodeShape ;
    sh:targetClass era:TCSPCondition ;
    
    era:additionalInfo "[BUSINESS RULE] This error might be because a TCSPCondition is missing one of its required fields — d_trackcond, l_trackcond, m_platform, or q_platform — or a value is outside its valid range or q_platform is not one of ppLeft, ppRight, or ppBoth. These fields define one station platform track condition."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einer TCSPCondition eines der erforderlichen Felder — d_trackcond, l_trackcond, m_platform oder q_platform — fehlt oder ein Wert außerhalb des gültigen Bereichs liegt oder q_platform keinem von ppLeft, ppRight oder ppBoth entspricht. Diese Felder definieren eine Bahnsteig-Streckenbedingung."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'une TCSPCondition ne précise pas l'un de ses champs requis — d_trackcond, l_trackcond, m_platform ou q_platform — ou qu'une valeur est hors de sa plage valide, ou que q_platform ne correspond ni à ppLeft, ni à ppRight, ni à ppBoth. Ces champs définissent une condition de voie liée à un quai de gare."@fr ;
    # D_TRACKCOND (required, unsigned integer 0-32767 - distance to platform start)
    sh:property [ 
        sh:path era:d_trackcond ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TCSPCondition must have exactly one d_trackcond (unsigned integer 0-32767, distance to platform start)."@en ;
        sh:message "Jedes TCSPCondition muss genau einen Wert für d_trackcond haben (vorzeichenlose Ganzzahl 0-32767, distance to platform start)."@de ;
        sh:message "Chaque TCSPCondition doit avoir exactement une valeur pour d_trackcond (entier non signé 0-32767, distance to platform start)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_TRACKCOND (required, unsigned integer 0-32767 - length of platform)
    sh:property [ 
        sh:path era:l_trackcond ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TCSPCondition must have exactly one l_trackcond (unsigned integer 0-32767, length of platform section)."@en ;
        sh:message "Jedes TCSPCondition muss genau einen Wert für l_trackcond haben (vorzeichenlose Ganzzahl 0-32767, length of platform section)."@de ;
        sh:message "Chaque TCSPCondition doit avoir exactement une valeur pour l_trackcond (entier non signé 0-32767, length of platform section)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_PLATFORM (required, unsigned integer 0-15 - platform height code)
    sh:property [ 
        sh:path era:m_platform ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 15 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TCSPCondition must have exactly one m_platform (unsigned integer 0-15, platform height category)."@en ;
        sh:message "Jedes TCSPCondition muss genau einen Wert für m_platform haben (vorzeichenlose Ganzzahl 0-15, platform height category)."@de ;
        sh:message "Chaque TCSPCondition doit avoir exactement une valeur pour m_platform (entier non signé 0-15, platform height category)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_PLATFORM (required, controlled vocabulary - platform position)
    sh:property [ 
        sh:path era:q_platform ;
        sh:in (
            <http://data.europa.eu/949/concepts/platform-position/ppLeft>
            <http://data.europa.eu/949/concepts/platform-position/ppRight>
            <http://data.europa.eu/949/concepts/platform-position/ppBoth>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property q_platform must have a value from the defined SKOS concept scheme (ppLeft, ppRight, or ppBoth)."@en ;
        sh:message "Die Eigenschaft q_platform muss einen Wert aus dem definierten SKOS-Konzeptschema haben (ppLeft, ppRight, or ppBoth)."@de ;
        sh:message "La propriété q_platform doit avoir une valeur issue du schéma de concepts SKOS défini (ppLeft, ppRight, or ppBoth)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== Text Message Configuration Shape =====
era:TextMessageConfigShape a sh:NodeShape ;
    sh:targetClass era:TextMessageConfig ;
    era:additionalInfo "[BUSINESS RULE] This error might be because a TextMessageConfig is missing one of its many required fields (q_textconfirm, q_textdisplay, d_textdisplay, l_textdisplay, t_textdisplay, m_modetextdisplay, m_leveltextdisplay, m_modetextdisplay_e, or m_leveltextdisplay_e) or a value is outside its valid range. These fields together define the start/end display conditions and acknowledgement requirements for a text message."@en ;
    era:additionalInfo "[GESCHÄFTSREGEL] Dieser Fehler könnte daran liegen, dass bei einer TextMessageConfig eines der zahlreichen erforderlichen Felder (q_textconfirm, q_textdisplay, d_textdisplay, l_textdisplay, t_textdisplay, m_modetextdisplay, m_leveltextdisplay, m_modetextdisplay_e oder m_leveltextdisplay_e) fehlt oder ein Wert außerhalb des gültigen Bereichs liegt. Diese Felder definieren gemeinsam die Start-/Endanzeigebedingungen und Quittierungsanforderungen einer Textnachricht."@de ;
    era:additionalInfo "[RÈGLE MÉTIER] Cette erreur peut être due au fait qu'une TextMessageConfig ne précise pas l'un de ses nombreux champs requis (q_textconfirm, q_textdisplay, d_textdisplay, l_textdisplay, t_textdisplay, m_modetextdisplay, m_leveltextdisplay, m_modetextdisplay_e ou m_leveltextdisplay_e), ou qu'une valeur est hors de sa plage valide. Ces champs définissent ensemble les conditions d'affichage de début/fin et les exigences d'accusé de réception d'un message texte."@fr ;
    sh:message "Configuration for displaying text messages to drivers (used in Packets 72 and 76)."@en ;
    sh:message "Konfiguration zur Anzeige von Textnachrichten für Triebfahrzeugführer (verwendet in Paket 72 und 76)."@de ;
    sh:message "Configuration pour l'affichage des messages texte aux conducteurs (utilisée dans les paquets 72 et 76)."@fr ;
    
    # NID_C (required, unsigned integer 0-1023 - country/region identity)
    sh:property [ 
        sh:path era:nid_c ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:maxCount 1 ;
        sh:message "Each TextMessageConfig may have exactly one nid_c (unsigned integer 0-1023, country/region identifier)."@en ;
        sh:message "Jedes TextMessageConfig kann höchstens einen Wert für nid_c haben (vorzeichenlose Ganzzahl 0-1023, country/region Kennung)."@de ;
        sh:message "Chaque TextMessageConfig peut avoir au plus une valeur pour nid_c (entier non signé 0-1023, country/region identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_RBC (required, unsigned integer 0-16383 - Radio Block Centre identity)
    sh:property [ 
        sh:path era:nid_rbc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 16383 ;
        sh:maxCount 1 ;
        sh:message "Each TextMessageConfig may have exactly one nid_rbc (unsigned integer 0-16383, RBC identifier)."@en ;
        sh:message "Jedes TextMessageConfig kann höchstens einen Wert für nid_rbc haben (vorzeichenlose Ganzzahl 0-16383, RBC Kennung)."@de ;
        sh:message "Chaque TextMessageConfig peut avoir au plus une valeur pour nid_rbc (entier non signé 0-16383, RBC identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_TEXTMESSAGE (required, unsigned integer 0-255 - text message identity)
    sh:property [ 
        sh:path era:nid_textmessage ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:maxCount 1 ;
        sh:message "Each TextMessageConfig may have exactly one nid_textmessage (unsigned integer 0-255, unique message identifier)."@en ;
        sh:message "Jedes TextMessageConfig kann höchstens einen Wert für nid_textmessage haben (vorzeichenlose Ganzzahl 0-255, unique message Kennung)."@de ;
        sh:message "Chaque TextMessageConfig peut avoir au plus une valeur pour nid_textmessage (entier non signé 0-255, unique message identifiant)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_TEXTCLASS (required, controlled vocabulary - message importance class)
    sh:property [ 
        sh:path era:q_textclass ;
        sh:in (
            <http://data.europa.eu/949/concepts/text-class/auxiliary>
            <http://data.europa.eu/949/concepts/text-class/important>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property q_textclass must have a value from the defined SKOS concept scheme (auxiliary or important)."@en ;
        sh:message "Die Eigenschaft q_textclass muss einen Wert aus dem definierten SKOS-Konzeptschema haben (auxiliary or important)."@de ;
        sh:message "La propriété q_textclass doit avoir une valeur issue du schéma de concepts SKOS défini (auxiliary or important)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_TEXTCONFIRM (required, unsigned integer 0-3 - confirmation requirement level)
    sh:property [ 
        sh:path era:q_textconfirm ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TextMessageConfig must have exactly one q_textconfirm (unsigned integer 0-3: 0=no ack, 1=ack required, 2=ack with timestamp, 3=special)."@en ;
        sh:message "Jedes TextMessageConfig muss genau einen Wert für q_textconfirm haben (vorzeichenlose Ganzzahl 0-3: 0=no ack, 1=ack required, 2=ack with timestamp, 3=special)."@de ;
        sh:message "Chaque TextMessageConfig doit avoir exactement une valeur pour q_textconfirm (entier non signé 0-3: 0=no ack, 1=ack required, 2=ack with timestamp, 3=special)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_TEXTDISPLAY (required, boolean - display trigger qualifier)
    sh:property [ 
        sh:path era:q_textdisplay ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TextMessageConfig must have exactly one q_textdisplay (boolean, display based on geographical or time trigger)."@en ;
        sh:message "Jedes TextMessageConfig muss genau einen Wert für q_textdisplay haben (boolescher Wert, display based on geographical or time trigger)."@de ;
        sh:message "Chaque TextMessageConfig doit avoir exactement une valeur pour q_textdisplay (booléen, display based on geographical or time trigger)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # D_TEXTDISPLAY (required, unsigned integer 0-32767 - distance to display trigger)
    sh:property [ 
        sh:path era:d_textdisplay ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TextMessageConfig must have exactly one d_textdisplay (unsigned integer 0-32767, distance where message should appear)."@en ;
        sh:message "Jedes TextMessageConfig muss genau einen Wert für d_textdisplay haben (vorzeichenlose Ganzzahl 0-32767, distance where message should appear)."@de ;
        sh:message "Chaque TextMessageConfig doit avoir exactement une valeur pour d_textdisplay (entier non signé 0-32767, distance where message should appear)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # L_TEXTDISPLAY (required, unsigned integer 0-32767 - length/duration of display)
    sh:property [ 
        sh:path era:l_textdisplay ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32767 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TextMessageConfig must have exactly one l_textdisplay (unsigned integer 0-32767, display distance or duration)."@en ;
        sh:message "Jedes TextMessageConfig muss genau einen Wert für l_textdisplay haben (vorzeichenlose Ganzzahl 0-32767, display distance or duration)."@de ;
        sh:message "Chaque TextMessageConfig doit avoir exactement une valeur pour l_textdisplay (entier non signé 0-32767, display distance or duration)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # T_TEXTDISPLAY (required, unsigned integer 0-1023 - time for text display in seconds)
    sh:property [ 
        sh:path era:t_textdisplay ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TextMessageConfig must have exactly one t_textdisplay (unsigned integer 0-1023, time to display message in seconds)."@en ;
        sh:message "Jedes TextMessageConfig muss genau einen Wert für t_textdisplay haben (vorzeichenlose Ganzzahl 0-1023, time to display message in Sekunden)."@de ;
        sh:message "Chaque TextMessageConfig doit avoir exactement une valeur pour t_textdisplay (entier non signé 0-1023, time to display message en secondes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_MODETEXTDISPLAY (required, controlled vocabulary - display in specific mode)
    sh:property [ 
        sh:path era:m_modetextdisplay ;
        sh:in (
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_fullSupervision>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_onSight>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_staffResponsible>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_unfitted>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare1>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_standBy>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_trip>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_postTrip>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare2>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare3>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare4>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_limitedSupervision>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare5>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_reversing>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_notLimitedByMode>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_modetextdisplay must have a value from the defined SKOS concept scheme (ETCS operating modes)."@en ;
        sh:message "Die Eigenschaft m_modetextdisplay muss einen Wert aus dem definierten SKOS-Konzeptschema haben (ETCS operating modes)."@de ;
        sh:message "La propriété m_modetextdisplay doit avoir une valeur issue du schéma de concepts SKOS défini (ETCS operating modes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_MODETEXTDISPLAY - Warning for reserved/spare values
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "WARNING: The m_modetextdisplay value appears to be one of the reserved (spare) values in accordance with ETCS Subset-026 v3.6.0. Reserved values (DOM_spare, DOM_spare1, DOM_spare2, DOM_spare3, DOM_spare4, DOM_spare5) are not assigned specific meanings and should only be used for future extensions or special purposes."@en ;
        sh:message "WARNUNG: Der Wert m_modetextdisplay scheint einer der reservierten (Spare-)Werte gemäß ETCS Subset-026 v3.6.0 zu sein. Reservierte Werte (DOM_spare, DOM_spare1, DOM_spare2, DOM_spare3, DOM_spare4, DOM_spare5) haben keine festgelegte Bedeutung und sollten nur für künftige Erweiterungen oder besondere Zwecke verwendet werden."@de ;
        sh:message "AVERTISSEMENT : la valeur m_modetextdisplay semble être l'une des valeurs réservées (spare) selon ETCS Subset-026 v3.6.0. Les valeurs réservées (DOM_spare, DOM_spare1, DOM_spare2, DOM_spare3, DOM_spare4, DOM_spare5) n'ont pas de signification définie et ne doivent être utilisées que pour de futures extensions ou des besoins particuliers."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            
            SELECT $this
            WHERE {
                $this era:m_modetextdisplay ?mode .
                
                FILTER (
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare> ||
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare1> ||
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare2> ||
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare3> ||
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare4> ||
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare5>
                )
            }
        """ ;
        sh:severity sh:Warning ;
    ] ;
    
    # M_LEVELTEXTDISPLAY (required, controlled vocabulary - display in specific level)
    sh:property [ 
        sh:path era:m_leveltextdisplay ;
        sh:in (
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_level0>
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_levelNTC>
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_level1>
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_level2>
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_level3>
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_notLimited>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_leveltextdisplay must have a value from the defined SKOS concept scheme (ETCS levels)."@en ;
        sh:message "Die Eigenschaft m_leveltextdisplay muss einen Wert aus dem definierten SKOS-Konzeptschema haben (ETCS levels)."@de ;
        sh:message "La propriété m_leveltextdisplay doit avoir une valeur issue du schéma de concepts SKOS défini (ETCS levels)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_NTC (required, unsigned integer 0-255 - National Train Control system ID)
    sh:property [ 
        sh:path era:nid_ntc ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:maxCount 1 ;
        sh:message "Each TextMessageConfig may have exactly one nid_ntc (unsigned integer 0-255, NTC system identifier for level display filter)."@en ;
        sh:message "Jedes TextMessageConfig kann höchstens einen Wert für nid_ntc haben (vorzeichenlose Ganzzahl 0-255, NTC system Kennung for level display filter)."@de ;
        sh:message "Chaque TextMessageConfig peut avoir au plus une valeur pour nid_ntc (entier non signé 0-255, NTC system identifiant for level display filter)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_MODETEXTDISPLAY_E (required, controlled vocabulary - end display mode condition)
    sh:property [ 
        sh:path era:m_modetextdisplay_e ;
        sh:in (
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_fullSupervision>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_onSight>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_staffResponsible>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_unfitted>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare1>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_standBy>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_trip>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_postTrip>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare2>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare3>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare4>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_limitedSupervision>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare5>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_reversing>
            <http://data.europa.eu/949/concepts/display-operating-mode/DOM_notLimitedByMode>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_modetextdisplay_e must have a value from the defined SKOS concept scheme (mode when display ends)."@en ;
        sh:message "Die Eigenschaft m_modetextdisplay_e muss einen Wert aus dem definierten SKOS-Konzeptschema haben (mode when display ends)."@de ;
        sh:message "La propriété m_modetextdisplay_e doit avoir une valeur issue du schéma de concepts SKOS défini (mode when display ends)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # M_MODETEXTDISPLAY_E - Warning for reserved/spare values
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "WARNING: The m_modetextdisplay_e value appears to be one of the reserved (spare) values in accordance with ETCS Subset-026 v3.6.0. Reserved values (DOM_spare, DOM_spare1, DOM_spare2, DOM_spare3, DOM_spare4, DOM_spare5) are not assigned specific meanings and should only be used for future extensions or special purposes."@en ;
        sh:message "WARNUNG: Der Wert m_modetextdisplay_e scheint einer der reservierten (Spare-)Werte gemäß ETCS Subset-026 v3.6.0 zu sein. Reservierte Werte (DOM_spare, DOM_spare1, DOM_spare2, DOM_spare3, DOM_spare4, DOM_spare5) haben keine festgelegte Bedeutung und sollten nur für künftige Erweiterungen oder besondere Zwecke verwendet werden."@de ;
        sh:message "AVERTISSEMENT : la valeur m_modetextdisplay_e semble être l'une des valeurs réservées (spare) selon ETCS Subset-026 v3.6.0. Les valeurs réservées (DOM_spare, DOM_spare1, DOM_spare2, DOM_spare3, DOM_spare4, DOM_spare5) n'ont pas de signification définie et ne doivent être utilisées que pour de futures extensions ou des besoins particuliers."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            
            SELECT $this
            WHERE {
                $this era:m_modetextdisplay_e ?mode .
                
                FILTER (
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare> ||
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare1> ||
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare2> ||
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare3> ||
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare4> ||
                    ?mode = <http://data.europa.eu/949/concepts/display-operating-mode/DOM_spare5>
                )
            }
        """ ;
        sh:severity sh:Warning ;
    ] ;
    
    # M_LEVELTEXTDISPLAY_E (required, controlled vocabulary - end display level condition)
    sh:property [ 
        sh:path era:m_leveltextdisplay_e ;
        sh:in (
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_level0>
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_levelNTC>
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_level1>
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_level2>
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_level3>
            <http://data.europa.eu/949/concepts/display-operating-level/DOL_notLimited>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property m_leveltextdisplay_e must have a value from the defined SKOS concept scheme (level when display ends)."@en ;
        sh:message "Die Eigenschaft m_leveltextdisplay_e muss einen Wert aus dem definierten SKOS-Konzeptschema haben (level when display ends)."@de ;
        sh:message "La propriété m_leveltextdisplay_e doit avoir une valeur issue du schéma de concepts SKOS défini (level when display ends)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # NID_NTC_E (required, unsigned integer 0-255 - NTC system ID for end condition)
    sh:property [ 
        sh:path era:nid_ntc_e ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:maxCount 1 ;
        sh:message "Each TextMessageConfig may have exactly one nid_ntc_e (unsigned integer 0-255, NTC identifier for end display filter)."@en ;
        sh:message "Jedes TextMessageConfig kann höchstens einen Wert für nid_ntc_e haben (vorzeichenlose Ganzzahl 0-255, NTC Kennung for end display filter)."@de ;
        sh:message "Chaque TextMessageConfig peut avoir au plus une valeur pour nid_ntc_e (entier non signé 0-255, NTC identifiant for end display filter)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_CONFTEXTDISPLAY (optional, boolean - confirm text display qualifier)
    sh:property [ 
        sh:path era:q_conftextdisplay ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "A TextMessageConfig may have at most one q_conftextdisplay (boolean, whether confirmation affects display)."@en ;
        sh:message "Ein TextMessageConfig kann höchstens einen Wert für q_conftextdisplay haben (boolescher Wert, whether confirmation affects display)."@de ;
        sh:message "Un TextMessageConfig peut avoir au plus une valeur pour q_conftextdisplay (booléen, whether confirmation affects display)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Q_TEXTREPORT (optional, boolean - report text acknowledgement to RBC)
    sh:property [ 
        sh:path era:q_textreport ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "A TextMessageConfig may have at most one q_textreport (boolean, whether to report acknowledgement to RBC)."@en ;
        sh:message "Ein TextMessageConfig kann höchstens einen Wert für q_textreport haben (boolescher Wert, whether to report acknowledgement to RBC)."@de ;
        sh:message "Un TextMessageConfig peut avoir au plus une valeur pour q_textreport (booléen, whether to report acknowledgement to RBC)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	

# Shape to check that at least one ETCS Balise Packet class exists
era:AtLeastOneETCSBalisePacketClassShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            SELECT ?this
            WHERE {
                BIND (era:ValidationRoot as ?this)
            }
        """ ;
    ] ;
    
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The data must contain at least one instance of the required ETCS Balise Packet classes (e.g., BalisePacket, Packet). This error may indicate that the provided data significantly deviates from the expected ETCS balise packet structure as defined in the extended ERA Ontology & ERA UNISIG SUBSET-026-7 specifications."@en ;
        sh:message "Die Daten müssen mindestens eine Instanz der erforderlichen ETCS-Balisenpaket-Klassen enthalten (z. B. BalisePacket, Packet). Dieser Fehler kann darauf hinweisen, dass die bereitgestellten Daten erheblich von der erwarteten ETCS-Balisenpaketstruktur gemäß der erweiterten ERA-Ontologie und den ERA-UNISIG-SUBSET-026-7-Spezifikationen abweichen."@de ;
        sh:message "Les données doivent contenir au moins une instance des classes de paquets de balise ETCS requises (par ex. BalisePacket, Packet). Cette erreur peut indiquer que les données fournies s'écartent significativement de la structure de paquet de balise ETCS attendue, telle que définie dans l'ontologie ERA étendue et les spécifications ERA UNISIG SUBSET-026-7."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    # ETCS Balise Packet Classes
                    { ?instance rdf:type era:BalisePacket . }
                    UNION { ?instance rdf:type era:Packet . }
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .