        sh:message "Jedes ETCSPacket_3 muss genau einen Wert für q_nvdriver_adhes haben (boolescher Wert, driver adhesion notification)."@de ;
        sh:message "Chaque ETCSPacket_3 doit avoir exactement une valeur pour q_nvdriver_adhes (booléen, driver adhesion notification)."@fr ;
        sh:severity sh:Violation ;
