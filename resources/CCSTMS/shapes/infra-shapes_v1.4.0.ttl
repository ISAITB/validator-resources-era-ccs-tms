    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:CurveSamplePoint-sampleCurveRadius
    a sh:PropertyShape ;
    sh:path era:sampleCurveRadius ;
    sh:name "sampleCurveRadius" ;
    sh:description "Defines the radius at a specific location along the linear element, negative-counter-clockwise/left-curve, positive-clockwise/right-curve" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
