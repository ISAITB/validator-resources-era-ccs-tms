    sh:property infra-sh:FunctionalArea-opPoints ;
    sh:property infra-sh:FunctionalArea-switches ;
    sh:property infra-sh:FunctionalArea-slipCrossings ;
    sh:property infra-sh:FunctionalArea-derailers ;
