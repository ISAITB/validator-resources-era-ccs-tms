### TPActiveObject ####################################################
infra-sh:TPActiveObjectShape
    a sh:NodeShape ;
    sh:targetClass era:TPActiveObject ;
    sh:name "TPActiveObject" ;
    sh:description "Defines a functional object infront of which a TimingPoint is located and active" ;
    sh:xone (
        infra-sh:TPActiveObject-etcsMarker-present
        infra-sh:TPActiveObject-stopLocation-present
        infra-sh:TPActiveObject-timeMeasurePoint-present
    ) ;
    sh:message "TPActiveObject is a union: exactly one of (etcsMarker, stopLocation, timeMeasurePoint) must be present."@en ;
    sh:property infra-sh:TPActiveObject-etcsMarker ;
    sh:property infra-sh:TPActiveObject-stopLocation ;
    sh:property infra-sh:TPActiveObject-timeMeasurePoint ;
    sh:severity sh:Violation ;
    .

infra-sh:TPActiveObject-etcsMarker
    a sh:PropertyShape ;
    sh:path era:etcsMarker ;
    sh:name "etcsMarker" ;
    sh:description "refers to ETCS marker" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:ETCSMarker ;
    sh:message "etcsMarker must reference an existing era:ETCSMarker by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:TPActiveObject-stopLocation
    a sh:PropertyShape ;
    sh:path era:stopLocation ;
    sh:name "stopLocation" ;
    sh:description "refers to stop location" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:StopLocation ;
    sh:message "stopLocation must reference an existing era:StopLocation by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:TPActiveObject-timeMeasurePoint
    a sh:PropertyShape ;
    sh:path era:timeMeasurePoint ;
    sh:name "timeMeasurePoint" ;
    sh:description "refers to travel time measurement point" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TravelTimeMeasurementPoint ;
    sh:message "timeMeasurePoint must reference an existing era:TravelTimeMeasurementPoint by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:TPActiveObject-etcsMarker-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:etcsMarker is present"@en ;
    sh:property infra-sh:TPActiveObject-etcsMarker-required ;
    .

infra-sh:TPActiveObject-etcsMarker-required
    a sh:PropertyShape ;
    sh:path era:etcsMarker ;
    sh:minCount 1 ;
    .

infra-sh:TPActiveObject-stopLocation-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:stopLocation is present"@en ;
    sh:property infra-sh:TPActiveObject-stopLocation-required ;
    .

infra-sh:TPActiveObject-stopLocation-required
    a sh:PropertyShape ;
    sh:path era:stopLocation ;
    sh:minCount 1 ;
    .

infra-sh:TPActiveObject-timeMeasurePoint-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:timeMeasurePoint is present"@en ;
    sh:property infra-sh:TPActiveObject-timeMeasurePoint-required ;
    .

infra-sh:TPActiveObject-timeMeasurePoint-required
    a sh:PropertyShape ;
    sh:path era:timeMeasurePoint ;
    sh:minCount 1 ;
    .

### Tunnel ############################################################
infra-sh:TunnelShape
    a sh:NodeShape ;
    sh:targetClass era:Tunnel ;
    sh:name "Tunnel" ;
    sh:description "A railway tunnel is an excavation or a construction around the track provided to allow the railway to pass for example higher land, buildings or water." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "Globally identified by 'tunnelIdentification'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property infra-sh:Tunnel-tunnelIdentification ;
    sh:property infra-sh:Tunnel-name ;
    sh:property infra-sh:Tunnel-tunnelTubes ;
    sh:severity sh:Violation ;
    .

infra-sh:Tunnel-tunnelIdentification
    a sh:PropertyShape ;
    sh:path era:tunnelIdentification ;
    sh:name "tunnelIdentification" ;
    sh:description "Unique tunnel identification or unique tunnel number within Member State" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:Tunnel-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:Tunnel-tunnelTubes
    a sh:PropertyShape ;
    sh:path era:tunnelTubes ;
    sh:name "tunnelTubes" ;
    sh:description "composes of tunnel tubes" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:TunnelTubeShape ;
    sh:message "tunnelTubes must be a well-formed TunnelTube (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

### TunnelTube ########################################################
infra-sh:TunnelTubeShape
    a sh:NodeShape ;
    sh:targetClass era:TunnelTube ;
    sh:name "TunnelTube" ;
    sh:description "Defines the tunnels tubes within a tunnel. Main Use-Case identify emergency management with rescue into neighbour tube" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property infra-sh:TunnelTube-areaReference ;
    sh:property infra-sh:TunnelTube-crossSection ;
    sh:severity sh:Violation ;
