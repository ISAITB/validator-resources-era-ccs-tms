    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/nominal-track-gauges/10> <http://data.europa.eu/949/concepts/nominal-track-gauges/80> <http://data.europa.eu/949/concepts/nominal-track-gauges/20> <http://data.europa.eu/949/concepts/nominal-track-gauges/30> <http://data.europa.eu/949/concepts/nominal-track-gauges/40> <http://data.europa.eu/949/concepts/nominal-track-gauges/50> <http://data.europa.eu/949/concepts/nominal-track-gauges/60> <http://data.europa.eu/949/concepts/nominal-track-gauges/70> ) ;
