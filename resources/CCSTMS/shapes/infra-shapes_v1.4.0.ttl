### OperationalPoint ##################################################
infra-sh:OperationalPointShape
    a sh:NodeShape ;
    sh:targetClass era:OperationalPoint ;
    sh:name "OperationalPoint" ;
    sh:description "An operational point (OP) means any location for train service operations, where train services may begin and end or change route, and where passenger or freight services may be provided; operational point also means any location at boundaries between Member States or infrastructure managers. In https://eur-lex.europa.eu/eli/reg_impl/2019/773/oj 2.1.2 Principal locations (stations, yards, junctions, freight terminals)." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "Globally identified by 'uopid'."@en ;
    sh:nodeKind sh:IRI ;
    sh:sparql infra-sh:OperationalPoint-platforms-listWellFormed ;
    sh:property infra-sh:OperationalPoint-uopid ;
    sh:property infra-sh:OperationalPoint-opName ;
    sh:property infra-sh:OperationalPoint-travelTimeMeasurementPoints ;
    sh:property infra-sh:OperationalPoint-opType ;
    sh:property infra-sh:OperationalPoint-platforms ;
    sh:severity sh:Violation ;
    .

infra-sh:OperationalPoint-uopid
    a sh:PropertyShape ;
    sh:path era:uopid ;
    sh:name "uopid" ;
    sh:description "Code composed of country code and alphanumeric operational point code." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Z]{2}[A-Za-z0-9]{1,10}$" ;
    sh:message "uopid must have the form CCAAAAAAAAAA: a two-letter ISO 3166-1 country code followed by 1 to 10 alphanumeric characters identifying the operational point within the Member State."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:OperationalPoint-opName
    a sh:PropertyShape ;
    sh:path era:opName ;
    sh:name "opName" ;
    sh:description "Name normally related to the town or village or to traffic control purpose." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:OperationalPoint-travelTimeMeasurementPoints
    a sh:PropertyShape ;
    sh:path era:travelTimeMeasurementPoints ;
    sh:name "travelTimeMeasurementPoints" ;
    sh:description "Defined to measure/define timestamps for passing trains. Stopping-timingPoints can be found via platforms.platformEdges.stopLocations and timingPoint.stopLocation" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:TravelTimeMeasurementPointShape ;
    sh:message "travelTimeMeasurementPoints must be a well-formed TravelTimeMeasurementPoint (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

infra-sh:OperationalPoint-opType
    a sh:PropertyShape ;
    sh:path era:opType ;
    sh:name "opType" ;
    sh:description "Defines the Type of operational point in relation to the dominating operational functions." ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/op-types/10> <http://data.europa.eu/949/concepts/op-types/50> <http://data.europa.eu/949/concepts/op-types/130> <http://data.europa.eu/949/concepts/op-types/60> <http://data.europa.eu/949/concepts/op-types/100> <http://data.europa.eu/949/concepts/op-types/90> <http://data.europa.eu/949/concepts/op-types/110> <http://data.europa.eu/949/concepts/op-types/140> <http://data.europa.eu/949/concepts/op-types/40> <http://data.europa.eu/949/concepts/op-types/80> <http://data.europa.eu/949/concepts/op-types/70> <http://data.europa.eu/949/concepts/op-types/30> <http://data.europa.eu/949/concepts/op-types/120> <http://data.europa.eu/949/concepts/op-types/20> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OperationalPointTypes concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:OperationalPoint-platforms
    a sh:PropertyShape ;
    sh:path era:platforms ;
    sh:name "platforms" ;
    sh:description "Defines the sequence (one after the another) of platforms according to the real location, so neighbours are the same in array and reality" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "platforms is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node infra-sh:OperationalPoint-platforms-items ;
    sh:severity sh:Violation ;
    .

infra-sh:OperationalPoint-platforms-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "era:platforms is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:platforms ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

infra-sh:OperationalPoint-platforms-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:platforms"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node infra-sh:PlatformShape ;
        sh:message "platforms must be a well-formed Platform (blank node or IRI)."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

### TravelTimeMeasurementPoint ########################################
infra-sh:TravelTimeMeasurementPointShape
    a sh:NodeShape ;
    sh:targetClass era:TravelTimeMeasurementPoint ;
    sh:name "TravelTimeMeasurementPoint" ;
    sh:description "a preciselydefined location within an OperationalPoint where the actual passing time of a train is measured or recorded. It provides a topological reference used for running-time calculation, performance monitoring, and comparison with planned timetable data." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property infra-sh:TravelTimeMeasurementPoint-topologicalCoordinate ;
    sh:severity sh:Violation ;
    .

infra-sh:TravelTimeMeasurementPoint-topologicalCoordinate
    a sh:PropertyShape ;
    sh:path era:topologicalCoordinate ;
    sh:name "topologicalCoordinate" ;
    sh:description "defines the location on linear element" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:TopologicalCoordinateShape ;
    sh:message "topologicalCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

