### Infrastructure ####################################################
infra-sh:InfrastructureShape
    a sh:NodeShape ;
    sh:targetClass era:Infrastructure ;
    sh:name "Infrastructure" ;
    sh:description "Defines the Containter for Infrastructure (INFRA)" ;
    sh:property infra-sh:Infrastructure-topoAreas ;
    sh:property infra-sh:Infrastructure-geometryAreas ;
    sh:property infra-sh:Infrastructure-sampledGeometryAreas ;
    sh:property infra-sh:Infrastructure-functionalAreas ;
    sh:property infra-sh:Infrastructure-propertiesAreas ;
    sh:property infra-sh:Infrastructure-trackUsageAreas ;
    sh:severity sh:Violation ;
    .

