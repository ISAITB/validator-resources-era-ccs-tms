@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix era:     <http://data.europa.eu/949/> .

@prefix infra-sh: <http://data.europa.eu/949/shapes/infra#> .


########################################################################
#  SPARQL prefix declarations
#
#  SHACL 5.3: the Turtle @prefix declarations above do NOT apply inside
#  sh:select - only sh:prefixes does. Without this, a query writing era:...
#  fails with "Unknown namespace prefix : era" on any data graph that does
#  not itself bind the same prefix (e.g. data written with full IRIs).
########################################################################

infra-sh:PrefixDeclarations
    a owl:Ontology ;
    rdfs:label "Prefixes available to every sh:select in this file"@en ;
    sh:declare
        [ sh:prefix "era"  ; sh:namespace "http://data.europa.eu/949/"^^xsd:anyURI ] ,
        [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd"  ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ;
    .

########################################################################
#  infra node shapes
########################################################################
### TopoArea ##########################################################
infra-sh:TopoAreaShape
    a sh:NodeShape ;
    sh:targetClass era:TopoArea ;
    sh:name "TopoArea" ;
    sh:description "Defines a container for rail network topology" ;
    rdfs:comment "sub-package: topology" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property infra-sh:TopoArea-taVersionTimestamp ;
    sh:property infra-sh:TopoArea-linearElements ;
    sh:property infra-sh:TopoArea-netRelations ;
    sh:property infra-sh:TopoArea-name ;
    sh:severity sh:Violation ;
    .

infra-sh:TopoArea-taVersionTimestamp
    a sh:PropertyShape ;
    sh:path era:taVersionTimestamp ;
    sh:name "taVersionTimestamp" ;
    sh:description "version information of the topo-area which is valid since timestamp" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "taVersionTimestamp records the point in time from which this specific version of the topo-area's data is considered valid - it versions the whole topology container, not any single element within it. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid date-time. A common way the first cause occurs is a property name mismatch in the source data - for example, a similarly-named property such as versionTimestamp (without the ta prefix) being used instead of taVersionTimestamp; the check will report the value as entirely absent even though a value clearly intended to be it is present under the wrong name."@en ;
    era:additionalInfo "taVersionTimestamp erfasst den Zeitpunkt, ab dem diese konkrete Version der Daten des Topo-Bereichs als gültig gilt - sie versioniert den gesamten Topologie-Container, nicht ein einzelnes Element darin. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein gültiges Datum/Zeit. Eine häufige Ursache für den ersten Fall ist eine falsche Eigenschaftsbezeichnung in den Quelldaten - etwa die Verwendung einer ähnlich benannten Eigenschaft wie versionTimestamp (ohne das Präfix ta) anstelle von taVersionTimestamp; die Prüfung meldet den Wert dann als vollständig fehlend, obwohl ein offensichtlich dafür vorgesehener Wert unter dem falschen Namen vorhanden ist."@de ;
    era:additionalInfo "taVersionTimestamp enregistre le moment à partir duquel cette version précise des données de la zone topologique est considérée comme valide - elle versionne l'ensemble du conteneur de topologie, non un élément individuel qu'il contient. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas une date-heure valide. Une cause fréquente du premier cas est une incohérence de nom de propriété dans les données source - par exemple l'utilisation d'une propriété au nom similaire comme versionTimestamp (sans le préfixe ta) au lieu de taVersionTimestamp ; la vérification signale alors la valeur comme totalement absente, alors qu'une valeur manifestement destinée à ce champ est présente sous le mauvais nom."@fr ;
    .

infra-sh:TopoArea-linearElements
    a sh:PropertyShape ;
    sh:path era:linearElements ;
    sh:name "linearElements" ;
    sh:description "composes of linear elements = Edges in the graph" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:LinearElementShape ;
    sh:message "linearElements must be a well-formed LinearElement (blank node or IRI)."@en ;
    sh:message "linearElements muss ein wohlgeformtes LinearElement sein (Blank Node oder IRI)."@de ;
    sh:message "linearElements doit être un LinearElement bien formé (nœud vide ou IRI)."@fr ;
    sh:severity sh:Violation ;
    era:additionalInfo "linearElements composes the set of LinearElements that make up this TopoArea's own topology graph - the edges of the network within this area. There is no limit on how many a TopoArea may have, and each one is checked independently: if one particular linear element is malformed, only that specific value is reported as a violation, not the whole set. Note that the message shown is shared across two different possible causes: the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested LinearElement shape itself."@en ;
    era:additionalInfo "linearElements setzt sich aus der Menge der LinearElements zusammen, die den eigenen Topologiegraphen dieses TopoArea bilden - die Kanten des Netzes innerhalb dieses Bereichs. Es gibt keine Begrenzung, wie viele ein TopoArea besitzen darf, und jedes wird unabhängig geprüft: ist ein bestimmtes lineares Element fehlerhaft, wird nur dieser konkrete Wert als Verstoß gemeldet, nicht die gesamte Menge. Beachten Sie, dass die angezeigte Meldung zwei unterschiedliche mögliche Ursachen abdeckt: der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte LinearElement-Shape selbst nicht."@de ;
    era:additionalInfo "linearElements compose l'ensemble des LinearElements qui constituent le graphe de topologie propre à ce TopoArea - les arêtes du réseau au sein de cette zone. Il n'existe aucune limite au nombre qu'un TopoArea peut posséder, et chacun est vérifié indépendamment : si un élément linéaire particulier est malformé, seule cette valeur précise est signalée comme violation, non l'ensemble. Notez que le message affiché couvre deux causes possibles distinctes : la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape LinearElement imbriquée elle-même."@fr ;
    .

infra-sh:TopoArea-netRelations
    a sh:PropertyShape ;
    sh:path era:netRelations ;
    sh:name "netRelations" ;
    sh:description "composes of net relations = links between edges in the graph" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:NetRelationShape ;
    sh:message "netRelations must be a well-formed NetRelation (blank node or IRI)."@en ;
    sh:message "netRelations muss ein wohlgeformtes NetRelation sein (Blank Node oder IRI)."@de ;
    sh:message "netRelations doit être un NetRelation bien formé (nœud vide ou IRI)."@fr ;
    sh:severity sh:Violation ;
    era:additionalInfo "netRelations composes the set of NetRelations that connect this TopoArea's linear elements to one another - the links between edges in the graph. There is no limit on how many a TopoArea may have, and each one is checked independently: if one particular relation is malformed, only that specific value is reported as a violation, not the whole set. Note that the message shown is shared across two different possible causes: the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetRelation shape itself."@en ;
    era:additionalInfo "netRelations setzt sich aus der Menge der NetRelations zusammen, die die linearen Elemente dieses TopoArea miteinander verbinden - die Verknüpfungen zwischen den Kanten im Graphen. Es gibt keine Begrenzung, wie viele ein TopoArea besitzen darf, und jede wird unabhängig geprüft: ist eine bestimmte Relation fehlerhaft, wird nur dieser konkrete Wert als Verstoß gemeldet, nicht die gesamte Menge. Beachten Sie, dass die angezeigte Meldung zwei unterschiedliche mögliche Ursachen abdeckt: der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetRelation-Shape selbst nicht."@de ;
    era:additionalInfo "netRelations compose l'ensemble des NetRelations qui relient entre eux les éléments linéaires de ce TopoArea - les liens entre les arêtes du graphe. Il n'existe aucune limite au nombre qu'un TopoArea peut posséder, et chacune est vérifiée indépendamment : si une relation particulière est malformée, seule cette valeur précise est signalée comme violation, non l'ensemble. Notez que le message affiché couvre deux causes possibles distinctes : la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetRelation imbriquée elle-même."@fr ;
    .

infra-sh:TopoArea-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this topo-area, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diesen Topo-Bereich, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cette zone topologique, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### LinearElement #####################################################
infra-sh:LinearElementShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElement ;
    sh:name "LinearElement" ;
    sh:description "A linear element is an uninterrupted stretch of railway track, without divergence or convergence." ;
    rdfs:comment "sub-package: topology" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property infra-sh:LinearElement-lengthOfNetLinearElement ;
    sh:property infra-sh:LinearElement-name ;
    sh:severity sh:Violation ;
    .

infra-sh:LinearElement-lengthOfNetLinearElement
    a sh:PropertyShape ;
    sh:path era:lengthOfNetLinearElement ;
    sh:name "lengthOfNetLinearElement" ;
    sh:description "Defines the distance along the LinearElement's track centre line." ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "lengthOfNetLinearElement is the total length of this element's own track centre line, measured in metres from its origin to its far end. This value is what every position-and-offset check elsewhere in this data model is ultimately bounded against - a KilometricPost's pos, a StaticSpeedLimit's position, a TopologicalCoordinate's offsetFromOrigin, and many others all rely on this being present and correct to know where the far end of their own element actually is. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number. This check does not require the value to be positive; a zero or negative length is a separate, unrelated check."@en ;
    era:additionalInfo "lengthOfNetLinearElement ist die Gesamtlänge der eigenen Gleisachse dieses Elements, gemessen in Metern von seinem Ursprung bis zu seinem fernen Ende. Dieser Wert ist das, wogegen jede Positions- und Offset-Prüfung an anderer Stelle in diesem Datenmodell letztlich begrenzt wird - pos eines KilometricPost, die Position eines StaticSpeedLimit, offsetFromOrigin einer TopologicalCoordinate und viele andere verlassen sich darauf, dass dieser Wert vorhanden und korrekt ist, um zu wissen, wo das ferne Ende ihres eigenen Elements tatsächlich liegt. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zahl. Diese Prüfung verlangt nicht, dass der Wert positiv ist; eine Länge von null oder negativ ist eine separate, unabhängige Prüfung."@de ;
    era:additionalInfo "lengthOfNetLinearElement est la longueur totale de l'axe de voie propre à cet élément, mesurée en mètres depuis son origine jusqu'à son extrémité éloignée. Cette valeur est celle par rapport à laquelle toute vérification de position et de décalage ailleurs dans ce modèle de données est en définitive bornée - le pos d'un KilometricPost, la position d'un StaticSpeedLimit, l'offsetFromOrigin d'une TopologicalCoordinate, et bien d'autres, dépendent tous de sa présence et de son exactitude pour savoir où se situe réellement l'extrémité éloignée de leur propre élément. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un nombre valide. Cette vérification n'exige pas que la valeur soit positive ; une longueur nulle ou négative est une vérification distincte et sans rapport."@fr ;
    .

infra-sh:LinearElement-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this linear element, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für dieses lineare Element, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cet élément linéaire, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### NetRelation #######################################################
infra-sh:NetRelationShape
    a sh:NodeShape ;
    sh:targetClass era:NetRelation ;
    sh:name "NetRelation" ;
    sh:description "Defines a relation between two elements." ;
    rdfs:comment "sub-package: topology" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property infra-sh:NetRelation-elementA ;
    sh:property infra-sh:NetRelation-elementB ;
    sh:property infra-sh:NetRelation-isOnOriginOfElementA ;
    sh:property infra-sh:NetRelation-isOnOriginOfElementB ;
    sh:severity sh:Violation ;
    .

infra-sh:NetRelation-elementA
    a sh:PropertyShape ;
    sh:path era:elementA ;
    sh:name "elementA" ;
    sh:description "References the first linear element in an oriented relation." ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "elementA must reference an existing era:LinearElement by IRI."@en ;
    sh:message "elementA muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
    sh:message "elementA doit référencer un era:LinearElement existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a LinearElement. elementA identifies one of the two elements this relation joins, but on its own says nothing about which end of that element connects - that is specified separately by isOnOriginOfElementA."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als LinearElement typisiertes Objekt. elementA identifiziert eines der beiden Elemente, die diese Relation verbindet, sagt für sich genommen aber nichts darüber aus, welches Ende dieses Elements verbunden wird - dies wird separat über isOnOriginOfElementA festgelegt."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme LinearElement. elementA identifie l'un des deux éléments que cette relation relie, mais n'indique pas en soi quelle extrémité de cet élément est connectée - cela est précisé séparément par isOnOriginOfElementA."@fr ;
    .

infra-sh:NetRelation-elementB
    a sh:PropertyShape ;
    sh:path era:elementB ;
    sh:name "elementB" ;
    sh:description "References the second linear element in an oriented relation." ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "elementB must reference an existing era:LinearElement by IRI."@en ;
    sh:message "elementB muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
    sh:message "elementB doit référencer un era:LinearElement existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a LinearElement. elementB identifies the second of the two elements this relation joins, but on its own says nothing about which end of that element connects - that is specified separately by isOnOriginOfElementB."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als LinearElement typisiertes Objekt. elementB identifiziert das zweite der beiden Elemente, die diese Relation verbindet, sagt für sich genommen aber nichts darüber aus, welches Ende dieses Elements verbunden wird - dies wird separat über isOnOriginOfElementB festgelegt."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme LinearElement. elementB identifie le second des deux éléments que cette relation relie, mais n'indique pas en soi quelle extrémité de cet élément est connectée - cela est précisé séparément par isOnOriginOfElementB."@fr ;
    .

infra-sh:NetRelation-isOnOriginOfElementA
    a sh:PropertyShape ;
    sh:path era:isOnOriginOfElementA ;
    sh:name "isOnOriginOfElementA" ;
    sh:description "Determines if the position of the topological element A in a relation is the origin of element A." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean. This specifies which end of elementA the relation connects to: true means anchored at elementA's origin end, false means its other end. This property has no meaning on its own - it only makes sense read together with elementA."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert. Dies legt fest, an welchem Ende von elementA die Relation ansetzt: true bedeutet Verankerung am Ursprungsende von elementA, false am anderen Ende. Diese Eigenschaft hat für sich genommen keine Bedeutung - sie ergibt nur zusammen mit elementA Sinn."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique. Ceci précise à quelle extrémité de elementA la relation se rattache : true signifie un ancrage à l'extrémité d'origine de elementA, false à son autre extrémité. Cette propriété n'a pas de sens en elle-même - elle n'en prend qu'associée à elementA."@fr ;
    .

infra-sh:NetRelation-isOnOriginOfElementB
    a sh:PropertyShape ;
    sh:path era:isOnOriginOfElementB ;
    sh:name "isOnOriginOfElementB" ;
    sh:description "Determines if the position of the topological element B in a relation is the origin of element B." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean. This specifies which end of elementB the relation connects to: true means anchored at elementB's origin end, false means its other end. This property has no meaning on its own - it only makes sense read together with elementB."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert. Dies legt fest, an welchem Ende von elementB die Relation ansetzt: true bedeutet Verankerung am Ursprungsende von elementB, false am anderen Ende. Diese Eigenschaft hat für sich genommen keine Bedeutung - sie ergibt nur zusammen mit elementB Sinn."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique. Ceci précise à quelle extrémité de elementB la relation se rattache : true signifie un ancrage à l'extrémité d'origine de elementB, false à son autre extrémité. Cette propriété n'a pas de sens en elle-même - elle n'en prend qu'associée à elementB."@fr ;
    .

### NetPointReference #################################################
infra-sh:NetPointReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetPointReference ;
    sh:name "NetPointReference" ;
    sh:description "Represents a point reference in the network." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property infra-sh:NetPointReference-hasTopoCoordinate ;
    sh:property infra-sh:NetPointReference-appliesToDirection ;
    sh:severity sh:Violation ;
    .

infra-sh:NetPointReference-hasTopoCoordinate
    a sh:PropertyShape ;
    sh:path era:hasTopoCoordinate ;
    sh:name "hasTopoCoordinate" ;
    sh:description "Defines the topological coordinate of a network point reference" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:TopologicalCoordinateShape ;
    sh:message "hasTopoCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:message "hasTopoCoordinate muss ein wohlgeformtes TopologicalCoordinate sein (Blank Node oder IRI)."@de ;
    sh:message "hasTopoCoordinate doit être un TopologicalCoordinate bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:NetPointReference-appliesToDirection
    a sh:PropertyShape ;
    sh:path era:appliesToDirection ;
    sh:name "appliesToDirection" ;
    sh:description "The direction relative to the origin of the linear element towards the point reference applies" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/orientations/02> <http://data.europa.eu/949/concepts/orientations/00> <http://data.europa.eu/949/concepts/orientations/01> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OrientationDirections concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von OrientationDirections entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de OrientationDirections."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "same, opposite, and both describe direction relative to the linear element's own origin-to-far-end orientation, not an absolute or geographic direction - 'same' means the point reference applies in the direction the element itself runs, 'opposite' means against it, and 'both' means regardless of direction. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of the three defined concepts."@en ;
    era:additionalInfo "same, opposite und both beschreiben eine Richtung relativ zur eigenen Ausrichtung des linearen Elements vom Ursprung zum fernen Ende, nicht eine absolute oder geografische Richtung - 'same' bedeutet, dass die Punktreferenz in der Richtung gilt, in der das Element selbst verläuft, 'opposite' bedeutet dagegen, und 'both' bedeutet unabhängig von der Richtung. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines der drei definierten Konzepte."@de ;
    era:additionalInfo "same, opposite et both décrivent une direction relative à l'orientation propre de l'élément linéaire, de son origine vers son extrémité éloignée, non une direction absolue ou géographique - 'same' signifie que la référence de point s'applique dans le sens où l'élément lui-même s'oriente, 'opposite' signifie dans le sens contraire, et 'both' signifie indépendamment de la direction. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun des trois concepts définis."@fr ;
    .

### TopologicalCoordinate #############################################
infra-sh:TopologicalCoordinateShape
    a sh:NodeShape ;
    sh:targetClass era:TopologicalCoordinate ;
    sh:name "TopologicalCoordinate" ;
    sh:description "Defines a topological coordinate on the track" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property infra-sh:TopologicalCoordinate-onLinearElement ;
    sh:property infra-sh:TopologicalCoordinate-offsetFromOrigin ;
    sh:severity sh:Violation ;
    .

infra-sh:TopologicalCoordinate-onLinearElement
    a sh:PropertyShape ;
    sh:path era:onLinearElement ;
    sh:name "onLinearElement" ;
    sh:description "is positioned on linear element" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "onLinearElement must reference an existing era:LinearElement by IRI."@en ;
    sh:message "onLinearElement muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
    sh:message "onLinearElement doit référencer un era:LinearElement existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "onLinearElement anchors this coordinate to a specific LinearElement; offsetFromOrigin (the sibling property) is measured from that same element's origin. TopologicalCoordinate has no identity of its own - it is deliberately designed as a simple, non-referenceable container, always embedded directly inside whichever object needs a position (a Balise, a DangerPoint, one of a Crossing's two coordinates, and others), so a violation here is reported against that parent object, not against any TopologicalCoordinate itself. This same shape is reused wherever any object embeds a position this way, so a violation on this exact message can originate from many different kinds of parent objects, not just one. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a LinearElement."@en ;
    era:additionalInfo "onLinearElement verankert diese Koordinate an einem bestimmten LinearElement; offsetFromOrigin (die Schwestereigenschaft) wird vom Ursprung desselben Elements aus gemessen. TopologicalCoordinate besitzt keine eigene Identität - sie ist bewusst als einfacher, nicht referenzierbarer Container konzipiert, der stets direkt in dasjenige Objekt eingebettet ist, das eine Position benötigt (eine Balise, ein DangerPoint, eine der beiden Koordinaten einer Crossing, und andere), sodass ein Verstoß hier gegen dieses übergeordnete Objekt gemeldet wird, nicht gegen eine TopologicalCoordinate selbst. Diese Shape wird überall dort wiederverwendet, wo ein Objekt auf diese Weise eine Position einbettet, sodass ein Verstoß bei genau dieser Meldung von vielen verschiedenen Arten übergeordneter Objekte stammen kann, nicht nur von einer. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als LinearElement typisiertes Objekt."@de ;
    era:additionalInfo "onLinearElement ancre cette coordonnée à un LinearElement précis ; offsetFromOrigin (la propriété sœur) est mesuré depuis l'origine de ce même élément. TopologicalCoordinate n'a pas d'identité propre - elle est délibérément conçue comme un simple conteneur non référençable, toujours intégré directement dans l'objet qui a besoin d'une position (une Balise, un DangerPoint, l'une des deux coordonnées d'un Crossing, et d'autres), la violation est donc signalée sur cet objet parent, non sur une TopologicalCoordinate elle-même. Cette shape est réutilisée partout où un objet intègre une position de cette manière, si bien qu'une violation sur exactement ce message peut provenir de nombreux types d'objets parents différents, pas d'un seul. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme LinearElement."@fr ;
    .

infra-sh:TopologicalCoordinate-offsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:offsetFromOrigin ;
    sh:name "offsetFromOrigin" ;
    sh:description "position on the associated NetElement" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "offsetFromOrigin is the distance, in metres, from the origin of the LinearElement named in the sibling onLinearElement property, to this specific point. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number. This check does not require the value to stay within the bounds of the element's own length."@en ;
    era:additionalInfo "offsetFromOrigin ist die Distanz in Metern vom Ursprung des in der Schwestereigenschaft onLinearElement genannten LinearElement bis zu diesem konkreten Punkt. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der Wert ist vorhanden, aber keine gültige Zahl. Diese Prüfung verlangt nicht, dass der Wert innerhalb der Grenzen der eigenen Länge des Elements bleibt."@de ;
    era:additionalInfo "offsetFromOrigin est la distance, en mètres, depuis l'origine du LinearElement nommé dans la propriété sœur onLinearElement, jusqu'à ce point précis. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur est présente mais n'est pas un nombre valide. Cette vérification n'exige pas que la valeur reste dans les limites de la longueur propre de l'élément."@fr ;
    .

### LinearElementSection ##############################################
infra-sh:LinearElementSectionShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElementSection ;
    sh:name "LinearElementSection" ;
    sh:description "Defines adirected linear object (with a linear extension) located on a LinearElement" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property infra-sh:LinearElementSection-onElement ;
    sh:property infra-sh:LinearElementSection-startOffsetFromOrigin ;
    sh:property infra-sh:LinearElementSection-endOffsetFromOrigin ;
    sh:property infra-sh:LinearElementSection-appliesInBothDirections ;
    sh:severity sh:Violation ;
    .

infra-sh:LinearElementSection-onElement
    a sh:PropertyShape ;
    sh:path era:onElement ;
    sh:name "onElement" ;
    sh:description "Specifies the linear element a section belongs to." ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "onElement must reference an existing era:LinearElement by IRI."@en ;
    sh:message "onElement muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
    sh:message "onElement doit référencer un era:LinearElement existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "onElement anchors this section to exactly one LinearElement - a LinearElementSection is explicitly defined as limited to a single element and cannot span across several. That same element is also the reference frame startOffsetFromOrigin and endOffsetFromOrigin are measured against. LinearElementSection has no identity of its own; it exists only as a component inside another object (such as a TvpSection or a track properties record), so a violation here is reported against whichever parent object actually holds this section. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all (for example a plain text literal), or the value is an IRI but does not point at something actually typed as a LinearElement (for example, it points at a LinearElementKm or another unrelated object by mistake)."@en ;
    era:additionalInfo "onElement verankert diesen Abschnitt an genau einem LinearElement - eine LinearElementSection ist ausdrücklich auf ein einzelnes Element beschränkt und kann sich nicht über mehrere erstrecken. Dasselbe Element ist auch der Bezugsrahmen, gegen den startOffsetFromOrigin und endOffsetFromOrigin gemessen werden. LinearElementSection besitzt keine eigene Identität; sie existiert nur als Bestandteil innerhalb eines anderen Objekts (etwa einer TvpSection oder eines Gleiseigenschaften-Eintrags), sodass ein Verstoß hier gegen das jeweilige übergeordnete Objekt gemeldet wird, das diesen Abschnitt tatsächlich enthält. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI (zum Beispiel ein reiner Textliteral), oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als LinearElement typisiertes Objekt (er verweist beispielsweise versehentlich auf ein LinearElementKm oder ein anderes, nicht zugehöriges Objekt)."@de ;
    era:additionalInfo "onElement ancre cette section à exactement un LinearElement - une LinearElementSection est explicitement définie comme limitée à un seul élément et ne peut s'étendre sur plusieurs. Ce même élément est aussi le référentiel par rapport auquel startOffsetFromOrigin et endOffsetFromOrigin sont mesurés. LinearElementSection n'a pas d'identité propre ; elle n'existe que comme composant à l'intérieur d'un autre objet (tel qu'un TvpSection ou un enregistrement de propriétés de voie), la violation est donc signalée sur l'objet parent qui contient réellement cette section. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI (par exemple un simple littéral texte), ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme LinearElement (elle pointe par exemple par erreur vers un LinearElementKm ou un autre objet sans rapport)."@fr ;
    .

infra-sh:LinearElementSection-startOffsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:startOffsetFromOrigin ;
    sh:name "startOffsetFromOrigin" ;
    sh:description "Defines the start offset from the origin" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "startOffsetFromOrigin is a distance skip, in metres, measured forward from the origin (start) of the LinearElement named in onElement, marking where this section begins. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number. This check does not compare it against endOffsetFromOrigin, nor does it require it to be non-negative."@en ;
    era:additionalInfo "startOffsetFromOrigin ist ein Distanzversatz in Metern, gemessen vorwärts vom Ursprung (Anfang) des in onElement genannten LinearElement, der markiert, wo dieser Abschnitt beginnt. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der Wert ist vorhanden, aber keine gültige Zahl. Diese Prüfung vergleicht ihn nicht mit endOffsetFromOrigin, noch verlangt sie, dass er nicht negativ ist."@de ;
    era:additionalInfo "startOffsetFromOrigin est un décalage de distance, en mètres, mesuré vers l'avant depuis l'origine (le début) du LinearElement nommé dans onElement, marquant où cette section commence. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur est présente mais n'est pas un nombre valide. Cette vérification ne la compare pas à endOffsetFromOrigin, et n'exige pas non plus qu'elle soit non négative."@fr ;
    .

infra-sh:LinearElementSection-endOffsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:endOffsetFromOrigin ;
    sh:name "endOffsetFromOrigin" ;
    sh:description "Defines the end offset from the origin" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "endOffsetFromOrigin is a distance skip, in metres, measured forward from the origin (start) of the LinearElement named in onElement, marking where this section ends. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number. This check does not compare it against startOffsetFromOrigin, nor does it require it to stay within the element's own length."@en ;
    era:additionalInfo "endOffsetFromOrigin ist ein Distanzversatz in Metern, gemessen vorwärts vom Ursprung (Anfang) des in onElement genannten LinearElement, der markiert, wo dieser Abschnitt endet. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der Wert ist vorhanden, aber keine gültige Zahl. Diese Prüfung vergleicht ihn nicht mit startOffsetFromOrigin, noch verlangt sie, dass er innerhalb der eigenen Länge des Elements bleibt."@de ;
    era:additionalInfo "endOffsetFromOrigin est un décalage de distance, en mètres, mesuré vers l'avant depuis l'origine (le début) du LinearElement nommé dans onElement, marquant où cette section se termine. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur est présente mais n'est pas un nombre valide. Cette vérification ne la compare pas à startOffsetFromOrigin, et n'exige pas non plus qu'elle reste dans la longueur propre de l'élément."@fr ;
    .

infra-sh:LinearElementSection-appliesInBothDirections
    a sh:PropertyShape ;
    sh:path era:appliesInBothDirections ;
    sh:name "appliesInBothDirections" ;
    sh:description "Defines if the section applies in both directions" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "appliesInBothDirections indicates whether this section's content is valid only when traversing its LinearElement in the element's own defined direction, or valid regardless of the direction of travel across it - consistent with how 'direction' is used elsewhere in this data model, relative to the element's own orientation rather than any absolute or geographic sense. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean (true/false)."@en ;
    era:additionalInfo "appliesInBothDirections gibt an, ob der Inhalt dieses Abschnitts nur gilt, wenn sein LinearElement in der eigenen definierten Richtung des Elements durchfahren wird, oder unabhängig von der Fahrtrichtung über es hinweg gilt - konsistent damit, wie 'Richtung' an anderer Stelle in diesem Datenmodell verwendet wird, bezogen auf die eigene Ausrichtung des Elements und nicht in einem absoluten oder geografischen Sinn. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert (true/false)."@de ;
    era:additionalInfo "appliesInBothDirections indique si le contenu de cette section n'est valide que lorsque son LinearElement est parcouru dans la direction propre définie de l'élément, ou valide quel que soit le sens de circulation le long de celui-ci - cohérent avec la façon dont « direction » est utilisée ailleurs dans ce modèle de données, par rapport à l'orientation propre de l'élément plutôt que dans un sens absolu ou géographique. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur est présente mais n'est pas un booléen authentique (true/false)."@fr ;
    .

### NetLinearReference ################################################
infra-sh:NetLinearReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetLinearReference ;
    sh:name "NetLinearReference" ;
    sh:description "Defines a linked path on the topology" ;
    sh:sparql infra-sh:NetLinearReference-hasSequence-listWellFormed ;
    sh:property infra-sh:NetLinearReference-startsAt ;
    sh:property infra-sh:NetLinearReference-endsAt ;
    sh:property infra-sh:NetLinearReference-hasSequence ;
    sh:severity sh:Violation ;
    .

infra-sh:NetLinearReference-startsAt
    a sh:PropertyShape ;
    sh:path era:startsAt ;
    sh:name "startsAt" ;
    sh:description "Definesthe starting point of a linear reference" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:NetPointReferenceShape ;
    sh:message "startsAt must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:message "startsAt muss ein wohlgeformtes NetPointReference sein (Blank Node oder IRI)."@de ;
    sh:message "startsAt doit être un NetPointReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "startsAt marks the beginning of this linked path via a nested NetPointReference, which itself must contain a valid position (a LinearElement plus an offset) and may carry a direction qualifier. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetPointReference shape itself. A common way the last cause occurs is that the value points directly at a TopologicalCoordinate instead of at a NetPointReference that wraps one - NetPointReference requires its own hasTopoCoordinate property pointing to the coordinate; a TopologicalCoordinate used directly here will have onLinearElement and offsetFromOrigin but no hasTopoCoordinate property, and will fail this check even though it is a perfectly valid TopologicalCoordinate in its own right."@en ;
    era:additionalInfo "startsAt markiert den Anfang dieses verbundenen Pfades über eine verschachtelte NetPointReference, die selbst eine gültige Position enthalten muss (ein LinearElement plus ein Offset) und zusätzlich einen Richtungsqualifizierer tragen kann. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetPointReference-Shape selbst nicht. Eine häufige Ursache für den letzten Fall ist, dass der Wert direkt auf eine TopologicalCoordinate verweist, statt auf eine NetPointReference, die eine solche umschließt - NetPointReference verlangt eine eigene hasTopoCoordinate-Eigenschaft, die auf die Koordinate verweist; eine direkt hier verwendete TopologicalCoordinate besitzt onLinearElement und offsetFromOrigin, aber keine hasTopoCoordinate-Eigenschaft, und scheitert an dieser Prüfung, obwohl sie als TopologicalCoordinate für sich genommen vollkommen gültig ist."@de ;
    era:additionalInfo "startsAt marque le début de ce chemin lié via une NetPointReference imbriquée, laquelle doit elle-même contenir une position valide (un LinearElement plus un décalage) et peut porter un qualificatif de direction. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetPointReference imbriquée elle-même. Une cause fréquente de ce dernier cas est que la valeur pointe directement vers une TopologicalCoordinate au lieu d'une NetPointReference qui en englobe une - NetPointReference exige sa propre propriété hasTopoCoordinate pointant vers la coordonnée ; une TopologicalCoordinate utilisée directement ici possédera onLinearElement et offsetFromOrigin mais aucune propriété hasTopoCoordinate, et échouera à cette vérification bien qu'elle soit parfaitement valide en tant que TopologicalCoordinate."@fr ;
    .

infra-sh:NetLinearReference-endsAt
    a sh:PropertyShape ;
    sh:path era:endsAt ;
    sh:name "endsAt" ;
    sh:description "Specifies the ending point of a linear reference" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:NetPointReferenceShape ;
    sh:message "endsAt must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:message "endsAt muss ein wohlgeformtes NetPointReference sein (Blank Node oder IRI)."@de ;
    sh:message "endsAt doit être un NetPointReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "endsAt marks the end of this linked path via a nested NetPointReference, which itself must contain a valid position (a LinearElement plus an offset) and may carry a direction qualifier. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetPointReference shape itself. A common way the last cause occurs is that the value points directly at a TopologicalCoordinate instead of at a NetPointReference that wraps one - NetPointReference requires its own hasTopoCoordinate property pointing to the coordinate; a TopologicalCoordinate used directly here will have onLinearElement and offsetFromOrigin but no hasTopoCoordinate property, and will fail this check even though it is a perfectly valid TopologicalCoordinate in its own right."@en ;
    era:additionalInfo "endsAt markiert das Ende dieses verbundenen Pfades über eine verschachtelte NetPointReference, die selbst eine gültige Position enthalten muss (ein LinearElement plus ein Offset) und zusätzlich einen Richtungsqualifizierer tragen kann. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetPointReference-Shape selbst nicht. Eine häufige Ursache für den letzten Fall ist, dass der Wert direkt auf eine TopologicalCoordinate verweist, statt auf eine NetPointReference, die eine solche umschließt - NetPointReference verlangt eine eigene hasTopoCoordinate-Eigenschaft, die auf die Koordinate verweist; eine direkt hier verwendete TopologicalCoordinate besitzt onLinearElement und offsetFromOrigin, aber keine hasTopoCoordinate-Eigenschaft, und scheitert an dieser Prüfung, obwohl sie als TopologicalCoordinate für sich genommen vollkommen gültig ist."@de ;
    era:additionalInfo "endsAt marque la fin de ce chemin lié via une NetPointReference imbriquée, laquelle doit elle-même contenir une position valide (un LinearElement plus un décalage) et peut porter un qualificatif de direction. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetPointReference imbriquée elle-même. Une cause fréquente de ce dernier cas est que la valeur pointe directement vers une TopologicalCoordinate au lieu d'une NetPointReference qui en englobe une - NetPointReference exige sa propre propriété hasTopoCoordinate pointant vers la coordonnée ; une TopologicalCoordinate utilisée directement ici possédera onLinearElement et offsetFromOrigin mais aucune propriété hasTopoCoordinate, et échouera à cette vérification bien qu'elle soit parfaitement valide en tant que TopologicalCoordinate."@fr ;
    .

infra-sh:NetLinearReference-hasSequence
    a sh:PropertyShape ;
    sh:path era:hasSequence ;
    sh:name "hasSequence" ;
    sh:description "The ordered sequence of topological linear elements which create a linear net reference." ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "hasSequence is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:message "hasSequence ist mit byIndex geordnet: es muss genau eine rdf:List tragen."@de ;
    sh:message "hasSequence est ordonné par byIndex : il doit porter exactement une rdf:List."@fr ;
    sh:node infra-sh:NetLinearReference-hasSequence-items ;
    sh:severity sh:Violation ;
    era:additionalInfo "hasSequence lists the LinearElements a path passes through BETWEEN its startsAt and endsAt - it is optional, since a path that goes directly from one element to an adjacent one has nothing in between; an empty or absent hasSequence is entirely normal in that case. Note that the message shown is shared across three different possible causes: more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the underlying list fails the well-formedness or item-type checks carried out separately - in the last case, this message and the more specific one describing exactly what is wrong inside the list will both appear together as two separate findings for the same root problem."@en ;
    era:additionalInfo "hasSequence listet die LinearElements auf, die ein Pfad ZWISCHEN seinem startsAt und endsAt durchläuft - es ist optional, da ein Pfad, der direkt von einem Element zu einem benachbarten führt, nichts dazwischen hat; ein leeres oder fehlendes hasSequence ist in diesem Fall völlig normal. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder die zugrunde liegende Liste scheitert an den separat durchgeführten Wohlgeformtheits- oder Elementtyp-Prüfungen - im letzten Fall erscheinen diese Meldung und die genauere Meldung, die beschreibt, was innerhalb der Liste konkret falsch ist, gemeinsam als zwei getrennte Befunde für dasselbe zugrunde liegende Problem."@de ;
    era:additionalInfo "hasSequence liste les LinearElements qu'un chemin traverse ENTRE son startsAt et son endsAt - elle est optionnelle, car un chemin allant directement d'un élément à un élément adjacent n'a rien entre les deux ; un hasSequence vide ou absent est alors parfaitement normal. Notez que le message affiché couvre trois causes possibles distinctes : plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la liste sous-jacente échoue aux vérifications de bonne formation ou de type d'élément effectuées séparément - dans ce dernier cas, ce message et le message plus précis décrivant exactement ce qui ne va pas à l'intérieur de la liste apparaîtront tous deux ensemble comme deux constats distincts pour le même problème de fond."@fr ;
    .

infra-sh:NetLinearReference-hasSequence-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "era:hasSequence is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:message "era:hasSequence ist mit byIndex geordnet und muss daher eine wohlgeformte, terminierte rdf:List sein: jede Listenzelle benötigt genau ein rdf:first und genau ein rdf:rest."@de ;
    sh:message "era:hasSequence est ordonné par byIndex et doit donc être une rdf:List bien formée et terminée : chaque cellule de la liste nécessite exactement un rdf:first et exactement un rdf:rest."@fr ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:hasSequence ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

infra-sh:NetLinearReference-hasSequence-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:hasSequence"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:IRI ;
        sh:class era:LinearElement ;
        sh:message "hasSequence must reference an existing era:LinearElement by IRI."@en ;
        sh:message "hasSequence muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
        sh:message "hasSequence doit référencer un era:LinearElement existant par IRI."@fr ;
        sh:severity sh:Violation ;
    ] ;
    .

### NetAreaReference ##################################################
infra-sh:NetAreaReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetAreaReference ;
    sh:name "NetAreaReference" ;
    sh:description "Represents an area reference in the network." ;
    sh:property infra-sh:NetAreaReference-includes ;
    sh:severity sh:Violation ;
    .

infra-sh:NetAreaReference-includes
    a sh:PropertyShape ;
    sh:path era:includes ;
    sh:name "includes" ;
    sh:description "List of linear references included in an network area reference." ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:NetLinearReferenceShape ;
    sh:message "includes must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:message "includes muss ein wohlgeformtes NetLinearReference sein (Blank Node oder IRI)."@de ;
    sh:message "includes doit être un NetLinearReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "This property has no maxCount, so having several included paths is not itself a problem - a single area reference can genuinely bundle more than one NetLinearReference, for example where it spans multiple parallel tracks. Note that the message shown is shared across three different possible causes: the value is missing entirely, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetLinearReference shape itself."@en ;
    era:additionalInfo "Diese Eigenschaft hat kein maxCount, mehrere eingeschlossene Pfade sind also kein Problem für sich - eine einzelne Area-Referenz kann tatsächlich mehr als eine NetLinearReference bündeln, etwa wenn sie mehrere parallele Gleise überspannt. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetLinearReference-Shape selbst nicht."@de ;
    era:additionalInfo "Cette propriété n'a pas de maxCount, avoir plusieurs chemins inclus n'est donc pas un problème en soi - une seule référence de zone peut effectivement regrouper plusieurs NetLinearReference, par exemple lorsqu'elle s'étend sur plusieurs voies parallèles. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetLinearReference imbriquée elle-même."@fr ;
    .

### GeometryArea ######################################################
infra-sh:GeometryAreaShape
    a sh:NodeShape ;
    sh:targetClass era:GeometryArea ;
    sh:name "GeometryArea" ;
    sh:description "Defines the container geometry area within INFRA Domain" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property infra-sh:GeometryArea-topoArea ;
    sh:property infra-sh:GeometryArea-gaVersionTimestamp ;
    sh:property infra-sh:GeometryArea-alignment3d ;
    sh:property infra-sh:GeometryArea-linearElementGeometries ;
    sh:severity sh:Violation ;
    .

infra-sh:GeometryArea-topoArea
    a sh:PropertyShape ;
    sh:path era:topoArea ;
    sh:name "topoArea" ;
    sh:description "reference to the corresponding TopoArea" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TopoArea ;
    sh:message "topoArea must reference an existing era:TopoArea by IRI."@en ;
    sh:message "topoArea muss über eine IRI auf ein bestehendes era:TopoArea verweisen."@de ;
    sh:message "topoArea doit référencer un era:TopoArea existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a TopoArea."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als TopoArea typisiertes Objekt."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme TopoArea."@fr ;
    .

infra-sh:GeometryArea-gaVersionTimestamp
    a sh:PropertyShape ;
    sh:path era:gaVersionTimestamp ;
    sh:name "gaVersionTimestamp" ;
    sh:description "version information of the geometry area which is valid since timestamp" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid date-time."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein gültiges Datum/Zeit."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas une date-heure valide."@fr ;
    .

infra-sh:GeometryArea-alignment3d
    a sh:PropertyShape ;
    sh:path era:alignment3d ;
    sh:name "alignment3d" ;
    sh:description "Defines the 3d alignment information for the geometry area. if true, all positions and length calculated on 3d line. if false - on 2d projection" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "alignment3d's own description states that true means all positions and lengths in this geometry area are calculated on the actual 3D line, and false means they are calculated on its 2D projection instead. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean."@en ;
    era:additionalInfo "Die eigene Beschreibung von alignment3d besagt, dass true bedeutet, dass alle Positionen und Längen in diesem Geometriebereich auf der tatsächlichen 3D-Linie berechnet werden, und false, dass sie stattdessen auf ihrer 2D-Projektion berechnet werden. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert."@de ;
    era:additionalInfo "La propre description de alignment3d indique que true signifie que toutes les positions et longueurs de cette zone géométrique sont calculées sur la ligne 3D réelle, et false qu'elles sont calculées sur sa projection 2D à la place. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique."@fr ;
    .

infra-sh:GeometryArea-linearElementGeometries
    a sh:PropertyShape ;
    sh:path era:linearElementGeometries ;
    sh:name "linearElementGeometries" ;
    sh:description "composes of linear element geometries" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:LinearElementGeometryShape ;
    sh:message "linearElementGeometries must be a well-formed LinearElementGeometry (blank node or IRI)."@en ;
    sh:message "linearElementGeometries muss ein wohlgeformtes LinearElementGeometry sein (Blank Node oder IRI)."@de ;
    sh:message "linearElementGeometries doit être un LinearElementGeometry bien formé (nœud vide ou IRI)."@fr ;
    sh:severity sh:Violation ;
    era:additionalInfo "This property has neither minCount nor maxCount, so an area with no linear element geometries at all, or with several, is equally valid. Note that the message shown is shared across two different possible causes: the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested LinearElementGeometry shape itself."@en ;
    era:additionalInfo "Diese Eigenschaft hat weder minCount noch maxCount, ein Bereich ganz ohne Geometrien linearer Elemente oder mit mehreren ist also gleichermaßen gültig. Beachten Sie, dass die angezeigte Meldung zwei unterschiedliche mögliche Ursachen abdeckt: der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte LinearElementGeometry-Shape selbst nicht."@de ;
    era:additionalInfo "Cette propriété n'a ni minCount ni maxCount, une zone sans aucune géométrie d'élément linéaire ou avec plusieurs est donc également valide. Notez que le message affiché couvre deux causes possibles distinctes : la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape LinearElementGeometry imbriquée elle-même."@fr ;
    .

### LinearElementGeometry #############################################
infra-sh:LinearElementGeometryShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElementGeometry ;
    sh:name "LinearElementGeometry" ;
    sh:description "Defines the geometry of the linear element centre line as a list of parametrised curves. The geometry is smooth; no discontinuities in azimuth or inclination." ;
    rdfs:comment "sub-package: geometry" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:sparql infra-sh:LinearElementGeometry-horizontalAlignments-listWellFormed ;
    sh:sparql infra-sh:LinearElementGeometry-horizontalAlignments-listItemCount ;
    sh:sparql infra-sh:LinearElementGeometry-verticalAlignments-listWellFormed ;
    sh:sparql infra-sh:LinearElementGeometry-verticalAlignments-listItemCount ;
    sh:sparql infra-sh:LinearElementGeometry-cantPoints-listWellFormed ;
    sh:property infra-sh:LinearElementGeometry-linearElement ;
    sh:property infra-sh:LinearElementGeometry-horizontalAlignments ;
    sh:property infra-sh:LinearElementGeometry-verticalAlignments ;
    sh:property infra-sh:LinearElementGeometry-cantPoints ;
    sh:severity sh:Violation ;
    .

infra-sh:LinearElementGeometry-linearElement
    a sh:PropertyShape ;
    sh:path era:linearElement ;
    sh:name "linearElement" ;
    sh:description "reference to the corresponding LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "linearElement must reference an existing era:LinearElement by IRI."@en ;
    sh:message "linearElement muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
    sh:message "linearElement doit référencer un era:LinearElement existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a LinearElement."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als LinearElement typisiertes Objekt."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme LinearElement."@fr ;
    .

infra-sh:LinearElementGeometry-horizontalAlignments
    a sh:PropertyShape ;
    sh:path era:horizontalAlignments ;
    sh:name "horizontalAlignments" ;
    sh:description "Defines a sequence of geometric primitives, i.e. arc, line or clothoid, that compose this track geometry" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "horizontalAlignments is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:message "horizontalAlignments ist mit byIndex geordnet: es muss genau eine rdf:List tragen."@de ;
    sh:message "horizontalAlignments est ordonné par byIndex : il doit porter exactement une rdf:List."@fr ;
    sh:node infra-sh:LinearElementGeometry-horizontalAlignments-items ;
    sh:severity sh:Violation ;
    era:additionalInfo "Unlike some similar ordered-list properties elsewhere in this data model, this one is required (has a minCount) - a LinearElementGeometry must always have at least one horizontal alignment segment. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the underlying list fails the well-formedness, minimum-item-count, or item-type checks carried out separately."@en ;
    era:additionalInfo "Anders als einige ähnliche geordnete Listeneigenschaften an anderer Stelle in diesem Datenmodell ist diese erforderlich (besitzt ein minCount) - eine LinearElementGeometry muss stets mindestens ein horizontales Ausrichtungssegment besitzen. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder die zugrunde liegende Liste scheitert an den separat durchgeführten Wohlgeformtheits-, Mindestanzahl- oder Elementtyp-Prüfungen."@de ;
    era:additionalInfo "Contrairement à certaines propriétés de liste ordonnée similaires ailleurs dans ce modèle de données, celle-ci est requise (possède un minCount) - une LinearElementGeometry doit toujours avoir au moins un segment d'alignement horizontal. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la liste sous-jacente échoue aux vérifications de bonne formation, de nombre minimal d'éléments, ou de type d'élément effectuées séparément."@fr ;
    .

infra-sh:LinearElementGeometry-verticalAlignments
    a sh:PropertyShape ;
    sh:path era:verticalAlignments ;
    sh:name "verticalAlignments" ;
    sh:description "Defines a sequence of geometric primitives, i.e. arc, line or clothoid, that compose this track geometry" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "verticalAlignments is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:message "verticalAlignments ist mit byIndex geordnet: es muss genau eine rdf:List tragen."@de ;
    sh:message "verticalAlignments est ordonné par byIndex : il doit porter exactement une rdf:List."@fr ;
    sh:node infra-sh:LinearElementGeometry-verticalAlignments-items ;
    sh:severity sh:Violation ;
    era:additionalInfo "Unlike some similar ordered-list properties elsewhere in this data model, this one is required (has a minCount) - a LinearElementGeometry must always have at least one vertical alignment segment. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the underlying list fails the well-formedness, minimum-item-count, or item-type checks carried out separately."@en ;
    era:additionalInfo "Anders als einige ähnliche geordnete Listeneigenschaften an anderer Stelle in diesem Datenmodell ist diese erforderlich (besitzt ein minCount) - eine LinearElementGeometry muss stets mindestens ein vertikales Ausrichtungssegment besitzen. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder die zugrunde liegende Liste scheitert an den separat durchgeführten Wohlgeformtheits-, Mindestanzahl- oder Elementtyp-Prüfungen."@de ;
    era:additionalInfo "Contrairement à certaines propriétés de liste ordonnée similaires ailleurs dans ce modèle de données, celle-ci est requise (possède un minCount) - une LinearElementGeometry doit toujours avoir au moins un segment d'alignement vertical. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la liste sous-jacente échoue aux vérifications de bonne formation, de nombre minimal d'éléments, ou de type d'élément effectuées séparément."@fr ;
    .

infra-sh:LinearElementGeometry-cantPoints
    a sh:PropertyShape ;
    sh:path era:cantPoints ;
    sh:name "cantPoints" ;
    sh:description "Defines the cant points along the linear element. The linear element must be completely defined, at least at beginning and end. Empty means undefined" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "cantPoints is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:message "cantPoints ist mit byIndex geordnet: es muss genau eine rdf:List tragen."@de ;
    sh:message "cantPoints est ordonné par byIndex : il doit porter exactement une rdf:List."@fr ;
    sh:node infra-sh:LinearElementGeometry-cantPoints-items ;
    sh:severity sh:Violation ;
    era:additionalInfo "cantPoints's own description states that an empty list means cant is undefined for this element, and that if cant is defined at all, it must be defined at least at the element's beginning and end. This property has no minCount, so an entirely empty or absent list is valid - that is how undefined cant is expressed. Note that the message shown is shared across three different possible causes: more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the underlying list fails the well-formedness or item-type checks carried out separately."@en ;
    era:additionalInfo "Die eigene Beschreibung von cantPoints besagt, dass eine leere Liste bedeutet, dass die Überhöhung für dieses Element nicht definiert ist, und dass, falls die Überhöhung überhaupt definiert ist, sie mindestens am Anfang und Ende des Elements definiert sein muss. Diese Eigenschaft hat kein minCount, eine vollständig leere oder fehlende Liste ist also gültig - so wird eine nicht definierte Überhöhung ausgedrückt. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder die zugrunde liegende Liste scheitert an den separat durchgeführten Wohlgeformtheits- oder Elementtyp-Prüfungen."@de ;
    era:additionalInfo "La propre description de cantPoints indique qu'une liste vide signifie que le dévers n'est pas défini pour cet élément, et que si le dévers est défini, il doit l'être au moins au début et à la fin de l'élément. Cette propriété n'a pas de minCount, une liste totalement vide ou absente est donc valide - c'est ainsi qu'un dévers non défini est exprimé. Notez que le message affiché couvre trois causes possibles distinctes : plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la liste sous-jacente échoue aux vérifications de bonne formation ou de type d'élément effectuées séparément."@fr ;
    .

infra-sh:LinearElementGeometry-horizontalAlignments-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "era:horizontalAlignments is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:message "era:horizontalAlignments ist mit byIndex geordnet und muss daher eine wohlgeformte, terminierte rdf:List sein: jede Listenzelle benötigt genau ein rdf:first und genau ein rdf:rest."@de ;
    sh:message "era:horizontalAlignments est ordonné par byIndex et doit donc être une rdf:List bien formée et terminée : chaque cellule de la liste nécessite exactement un rdf:first et exactement un rdf:rest."@fr ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:horizontalAlignments ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

infra-sh:LinearElementGeometry-horizontalAlignments-listItemCount
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "The single rdf:List carried by era:horizontalAlignments must hold at least 1 item(s); the multiplicity bounds the items inside the list, not the number of lists."@en ;
    sh:message "Die einzelne rdf:List, die von era:horizontalAlignments getragen wird, muss mindestens 1 Element(e) enthalten; die Multiplizität begrenzt die Elemente innerhalb der Liste, nicht die Anzahl der Listen."@de ;
    sh:message "L'unique rdf:List portée par era:horizontalAlignments doit contenir au moins 1 élément(s) ; la multiplicité borne les éléments à l'intérieur de la liste, pas le nombre de listes."@fr ;
    sh:select """
            SELECT $this (COUNT(?item) AS ?itemCount)
            WHERE {
                $this era:horizontalAlignments ?head .
                OPTIONAL {
                    ?head rdf:rest* ?cell .
                    FILTER ( ?cell != rdf:nil )
                    BIND ( ?cell AS ?item )
                }
            }
            GROUP BY $this
            HAVING ( COUNT(?item) < 1 )
        """ ;
    .

infra-sh:LinearElementGeometry-verticalAlignments-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "era:verticalAlignments is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:message "era:verticalAlignments ist mit byIndex geordnet und muss daher eine wohlgeformte, terminierte rdf:List sein: jede Listenzelle benötigt genau ein rdf:first und genau ein rdf:rest."@de ;
    sh:message "era:verticalAlignments est ordonné par byIndex et doit donc être une rdf:List bien formée et terminée : chaque cellule de la liste nécessite exactement un rdf:first et exactement un rdf:rest."@fr ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:verticalAlignments ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

infra-sh:LinearElementGeometry-verticalAlignments-listItemCount
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "The single rdf:List carried by era:verticalAlignments must hold at least 1 item(s); the multiplicity bounds the items inside the list, not the number of lists."@en ;
    sh:message "Die einzelne rdf:List, die von era:verticalAlignments getragen wird, muss mindestens 1 Element(e) enthalten; die Multiplizität begrenzt die Elemente innerhalb der Liste, nicht die Anzahl der Listen."@de ;
    sh:message "L'unique rdf:List portée par era:verticalAlignments doit contenir au moins 1 élément(s) ; la multiplicité borne les éléments à l'intérieur de la liste, pas le nombre de listes."@fr ;
    sh:select """
            SELECT $this (COUNT(?item) AS ?itemCount)
            WHERE {
