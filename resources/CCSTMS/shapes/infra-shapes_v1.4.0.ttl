    .

infra-sh:HorizontalLine-elementGeometryPos
    a sh:PropertyShape ;
    sh:path era:elementGeometryPos ;
    sh:name "elementGeometryPos" ;
    sh:description "Defines the position on the associated Linear Element" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:HorizontalLine-azimuth
    a sh:PropertyShape ;
    sh:path era:azimuth ;
    sh:name "azimuth" ;
    sh:description "Defines the azimuth at pos, i.e. bearing measured clockwise with respect to geographic north" ;
    sh:order 2 ;
    qudt:hasUnit unit:DEG ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minInclusive 0 ;
    sh:maxInclusive 360 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

