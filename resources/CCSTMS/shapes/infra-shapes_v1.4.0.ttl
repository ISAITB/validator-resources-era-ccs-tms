    sh:order 2 ;
    qudt:hasUnit unit:DEG ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minInclusive 0 ;
    sh:maxInclusive 360 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:HorizontalArc-radius
    a sh:PropertyShape ;
    sh:path era:radius ;
    sh:name "radius" ;
    sh:description "Defines the radius at pos, negative-counter-clockwise/left-curve, positive-clockwise/right-curve" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### HorizontalTransition ##############################################
infra-sh:HorizontalTransitionShape
    a sh:NodeShape ;
    sh:targetClass era:HorizontalTransition ;
    sh:name "HorizontalTransition" ;
    sh:description "Defines a geometric primitive for a horizontal transition curve, a clothoid." ;
    rdfs:comment "sub-package: geometry" ;
    sh:property infra-sh:HorizontalTransition-elementGeometryPos ;
    sh:property infra-sh:HorizontalTransition-azimuth ;
    sh:property infra-sh:HorizontalTransition-radius ;
    sh:property infra-sh:HorizontalTransition-transitionType ;
    sh:severity sh:Violation ;
    .

infra-sh:HorizontalTransition-elementGeometryPos
    a sh:PropertyShape ;
    sh:path era:elementGeometryPos ;
    sh:name "elementGeometryPos" ;
    sh:description "position on the associated Linear Element" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:HorizontalTransition-azimuth
    a sh:PropertyShape ;
    sh:path era:azimuth ;
    sh:name "azimuth" ;
    sh:description "Defines the azimuth at pos, i.e. bearing measured clockwise with respect to geographic north" ;
    sh:order 2 ;
    qudt:hasUnit unit:DEG ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minInclusive 0 ;
    sh:maxInclusive 360 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:HorizontalTransition-radius
    a sh:PropertyShape ;
    sh:path era:radius ;
    sh:name "radius" ;
    sh:description "Defines the radius at pos, negative-counter-clockwise/left-curve, positive-clockwise/right-curve" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:HorizontalTransition-transitionType
    a sh:PropertyShape ;
    sh:path era:transitionType ;
    sh:name "transitionType" ;
    sh:description "defines different transition types" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/transition-type/clothoidCurve> <http://data.europa.eu/949/concepts/transition-type/biquadraticParabola> <http://data.europa.eu/949/concepts/transition-type/blossCurve> <http://data.europa.eu/949/concepts/transition-type/cosineCurve> <http://data.europa.eu/949/concepts/transition-type/cubicParabola> <http://data.europa.eu/949/concepts/transition-type/sineCurve> <http://data.europa.eu/949/concepts/transition-type/wienerBogen> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TransitionType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

