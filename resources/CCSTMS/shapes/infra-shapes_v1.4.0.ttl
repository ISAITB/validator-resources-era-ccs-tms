### TrackUsageArea ####################################################
infra-sh:TrackUsageAreaShape
    a sh:NodeShape ;
    sh:targetClass era:TrackUsageArea ;
    sh:name "TrackUsageArea" ;
    sh:description "Defines the preferred usage specification, most usable for TMS and planning" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property infra-sh:TrackUsageArea-topoArea ;
    sh:property infra-sh:TrackUsageArea-tuaVersionTimestamp ;
    sh:property infra-sh:TrackUsageArea-secondaryTracks ;
    sh:property infra-sh:TrackUsageArea-shuntingTracks ;
    sh:property infra-sh:TrackUsageArea-preferredSameDir ;
    sh:property infra-sh:TrackUsageArea-preferredOppositeDir ;
    sh:severity sh:Violation ;
    .

infra-sh:TrackUsageArea-topoArea
    a sh:PropertyShape ;
    sh:path era:topoArea ;
    sh:name "topoArea" ;
    sh:description "reference to the corresponding TopoArea" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TopoArea ;
    sh:message "topoArea must reference an existing era:TopoArea by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:TrackUsageArea-tuaVersionTimestamp
    a sh:PropertyShape ;
    sh:path era:tuaVersionTimestamp ;
    sh:name "tuaVersionTimestamp" ;
    sh:description "version information of the track usage area which is valid since timestamp" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:TrackUsageArea-secondaryTracks
    a sh:PropertyShape ;
    sh:path era:secondaryTracks ;
    sh:name "secondaryTracks" ;
    sh:description "Defines the list of secondary tracks. All tracks except 'shuntingTracks' and 'secondaryTracks' are 'mainTracks'" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "secondaryTracks must reference an existing era:LinearElement by IRI."@en ;
    sh:severity sh:Violation ;
    .

infra-sh:TrackUsageArea-shuntingTracks
    a sh:PropertyShape ;
    sh:path era:shuntingTracks ;
    sh:name "shuntingTracks" ;
    sh:description "Defines the list of shunting tracks. All tracks except 'shuntingTracks' and 'secondaryTracks' are 'mainTracks'" ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "shuntingTracks must reference an existing era:LinearElement by IRI."@en ;
    sh:severity sh:Violation ;
    .

infra-sh:TrackUsageArea-preferredSameDir
    a sh:PropertyShape ;
    sh:path era:preferredSameDir ;
    sh:name "preferredSameDir" ;
    sh:description "Defines the list of linear elements with preferred direction identical to the Linear element-Direction" ;
    sh:order 6 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "preferredSameDir must reference an existing era:LinearElement by IRI."@en ;
    sh:severity sh:Violation ;
    .

infra-sh:TrackUsageArea-preferredOppositeDir
    a sh:PropertyShape ;
    sh:path era:preferredOppositeDir ;
    sh:name "preferredOppositeDir" ;
    sh:description "Defines the list of linear elements with preferred direction opposite to the Linear element-Direction" ;
    sh:order 7 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "preferredOppositeDir must reference an existing era:LinearElement by IRI."@en ;
    sh:severity sh:Violation ;
    .

### LinearElementSpeedProfile #########################################
infra-sh:LinearElementSpeedProfileShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElementSpeedProfile ;
    sh:name "LinearElementSpeedProfile" ;
    sh:description "Defines the permitted speeds for a linear element in both directions" ;
    rdfs:comment "sub-package: PropertiesArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property infra-sh:LinearElementSpeedProfile-linearElement ;
    sh:property infra-sh:LinearElementSpeedProfile-sameDirProfile ;
    sh:property infra-sh:LinearElementSpeedProfile-oppositeDirProfile ;
    sh:severity sh:Violation ;
    .

infra-sh:LinearElementSpeedProfile-linearElement
    a sh:PropertyShape ;
    sh:path era:linearElement ;
    sh:name "linearElement" ;
    sh:description "reference to the corresponding LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "linearElement must reference an existing era:LinearElement by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:LinearElementSpeedProfile-sameDirProfile
    a sh:PropertyShape ;
    sh:path era:sameDirProfile ;
    sh:name "sameDirProfile" ;
    sh:description "Defines the speed profile valid in the same direction as the Linear element" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:SpeedProfileShape ;
    sh:message "sameDirProfile must be a well-formed SpeedProfile (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:LinearElementSpeedProfile-oppositeDirProfile
    a sh:PropertyShape ;
    sh:path era:oppositeDirProfile ;
    sh:name "oppositeDirProfile" ;
    sh:description "Defines the applicable speed profile for the opposite direction of travel with reference to linear element. valid in the opposite direction as the Linear Element. Skip if the same in both directions." ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:SpeedProfileShape ;
    sh:message "oppositeDirProfile must be a well-formed SpeedProfile (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### SpeedProfile ######################################################
infra-sh:SpeedProfileShape
    a sh:NodeShape ;
    sh:targetClass era:SpeedProfile ;
    sh:name "SpeedProfile" ;
    sh:description "Defines the different applicable speed profiles on the sections of track" ;
    sh:property infra-sh:SpeedProfile-staticSpeedProfile ;
    sh:property infra-sh:SpeedProfile-axleLoadSpeedProfiles ;
    sh:severity sh:Violation ;
    .

infra-sh:SpeedProfile-staticSpeedProfile
    a sh:PropertyShape ;
    sh:path era:staticSpeedProfile ;
    sh:name "staticSpeedProfile" ;
    sh:description "composes of static speed profiles" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:StaticSpeedLimitShape ;
    sh:message "staticSpeedProfile must be a well-formed StaticSpeedLimit (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:SpeedProfile-axleLoadSpeedProfiles
    a sh:PropertyShape ;
    sh:path era:axleLoadSpeedProfiles ;
    sh:name "axleLoadSpeedProfiles" ;
    sh:description "composes of axle load speed profiles" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:AxleLoadSpeedProfileShape ;
    sh:message "axleLoadSpeedProfiles must be a well-formed AxleLoadSpeedProfile (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

### StaticSpeedLimit ##################################################
infra-sh:StaticSpeedLimitShape
    a sh:NodeShape ;
    sh:targetClass era:StaticSpeedLimit ;
    sh:name "StaticSpeedLimit" ;
    sh:description "Defines the static speed profile for a section of linear element or segment profile" ;
    rdfs:comment "sub-package: PropertiesArea" ;
    sh:property infra-sh:StaticSpeedLimit-pos ;
    sh:property infra-sh:StaticSpeedLimit-speed ;
    sh:property infra-sh:StaticSpeedLimit-specificStaticSpeedLimits ;
    sh:property infra-sh:StaticSpeedLimit-trainEndApplicability ;
    sh:severity sh:Violation ;
    .

infra-sh:StaticSpeedLimit-pos
    a sh:PropertyShape ;
    sh:path era:pos ;
    sh:name "pos" ;
    sh:description "position on the associated LinearElement" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:StaticSpeedLimit-speed
    a sh:PropertyShape ;
    sh:path era:speed ;
    sh:name "speed" ;
    sh:description "Defines the applicable speed for the section of track" ;
    sh:order 2 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    rdfs:comment "ERTMS subset variable: V_STATIC"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:StaticSpeedLimit-specificStaticSpeedLimits
    a sh:PropertyShape ;
    sh:path era:specificStaticSpeedLimits ;
    sh:name "specificStaticSpeedLimits" ;
    sh:description "composes of specific static speed profiles" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:SpecificStaticSpeedLimitShape ;
    sh:message "specificStaticSpeedLimits must be a well-formed SpecificStaticSpeedLimit (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

infra-sh:StaticSpeedLimit-trainEndApplicability
    a sh:PropertyShape ;
    sh:path era:trainEndApplicability ;
    sh:name "trainEndApplicability" ;
    sh:description "Indicates if a speed limit given for a profile element is to be applied until the front of the train (no train length delay) or the end of the train (train length delay) has left the element." ;
    sh:order 4 ;
    rdfs:comment "ERTMS subset variable: Q_FRONT"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-end-applicability/lengthDelay> <http://data.europa.eu/949/concepts/train-end-applicability/noLengthDelay> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TrainEndApplicability concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### SpecificStaticSpeedLimit ##########################################
infra-sh:SpecificStaticSpeedLimitShape
    a sh:NodeShape ;
    sh:targetClass era:SpecificStaticSpeedLimit ;
    sh:name "SpecificStaticSpeedLimit" ;
    sh:description "Defines the specific static speed profile for a section of track" ;
    rdfs:comment "sub-package: PropertiesArea" ;
    sh:property infra-sh:SpecificStaticSpeedLimit-absolutePositiveSpeed ;
    sh:property infra-sh:SpecificStaticSpeedLimit-speedLimitCategory ;
    sh:severity sh:Violation ;
    .

infra-sh:SpecificStaticSpeedLimit-absolutePositiveSpeed
    a sh:PropertyShape ;
    sh:path era:absolutePositiveSpeed ;
    sh:name "absolutePositiveSpeed" ;
    sh:description "Defines the absolute Positive Speed associated to a train category" ;
    sh:order 1 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    rdfs:comment "ERTMS subset variable: V_DIFF"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:SpecificStaticSpeedLimit-speedLimitCategory
    a sh:PropertyShape ;
    sh:path era:speedLimitCategory ;
    sh:name "speedLimitCategory" ;
    sh:description "defines different specific speed limit categories" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:SpeedLimitCategoryShape ;
    sh:message "speedLimitCategory must be a well-formed SpeedLimitCategory (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### SpeedLimitCategory ################################################
infra-sh:SpeedLimitCategoryShape
    a sh:NodeShape ;
    sh:targetClass era:SpeedLimitCategory ;
    sh:name "SpeedLimitCategory" ;
    sh:description "Defines the different applicable speed limit categories on the sections of track" ;
    sh:xone (
        infra-sh:SpeedLimitCategory-otherCategoryReplacesCantDeficiencySSP-present
        infra-sh:SpeedLimitCategory-otherCategoryDoesNotReplaceCantDeficiencySSP-present
        infra-sh:SpeedLimitCategory-cantDeficiencyCategory-present
    ) ;
    sh:message "SpeedLimitCategory is a union: exactly one of (otherCategoryReplacesCantDeficiencySSP, otherCategoryDoesNotReplaceCantDeficiencySSP, cantDeficiencyCategory) must be present."@en ;
    sh:property infra-sh:SpeedLimitCategory-otherCategoryReplacesCantDeficiencySSP ;
    sh:property infra-sh:SpeedLimitCategory-otherCategoryDoesNotReplaceCantDeficiencySSP ;
    sh:property infra-sh:SpeedLimitCategory-cantDeficiencyCategory ;
    sh:severity sh:Violation ;
    .

infra-sh:SpeedLimitCategory-otherCategoryReplacesCantDeficiencySSP
    a sh:PropertyShape ;
    sh:path era:otherCategoryReplacesCantDeficiencySSP ;
    sh:name "otherCategoryReplacesCantDeficiencySSP" ;
    sh:description "is of type other Category Replaces Cant Deficiency SSP" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_freightTrainP> <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_freightTrainG> <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_passengerTrain> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OtherSpecificStaticSpeedProfileCategory concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:SpeedLimitCategory-otherCategoryDoesNotReplaceCantDeficiencySSP
    a sh:PropertyShape ;
    sh:path era:otherCategoryDoesNotReplaceCantDeficiencySSP ;
    sh:name "otherCategoryDoesNotReplaceCantDeficiencySSP" ;
    sh:description "is of type other Category Replaces Cant Deficiency SSP" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_freightTrainP> <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_freightTrainG> <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_passengerTrain> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OtherSpecificStaticSpeedProfileCategory concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:SpeedLimitCategory-cantDeficiencyCategory
    a sh:PropertyShape ;
    sh:path era:cantDeficiencyCategory ;
    sh:name "cantDeficiencyCategory" ;
    sh:description "is of type Cant Deficiency Category" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/cant-deficiencies/80> <http://data.europa.eu/949/concepts/cant-deficiencies/100> <http://data.europa.eu/949/concepts/cant-deficiencies/130> <http://data.europa.eu/949/concepts/cant-deficiencies/150> <http://data.europa.eu/949/concepts/cant-deficiencies/165> <http://data.europa.eu/949/concepts/cant-deficiencies/180> <http://data.europa.eu/949/concepts/cant-deficiencies/210> <http://data.europa.eu/949/concepts/cant-deficiencies/225> <http://data.europa.eu/949/concepts/cant-deficiencies/245> <http://data.europa.eu/949/concepts/cant-deficiencies/275> <http://data.europa.eu/949/concepts/cant-deficiencies/300> ) ;
    sh:message "Value must be one of the CCSTMS-scoped CantDeficiencies concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:SpeedLimitCategory-otherCategoryReplacesCantDeficiencySSP-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:otherCategoryReplacesCantDeficiencySSP is present"@en ;
    sh:property infra-sh:SpeedLimitCategory-otherCategoryReplacesCantDeficiencySSP-required ;
    .

infra-sh:SpeedLimitCategory-otherCategoryReplacesCantDeficiencySSP-required
    a sh:PropertyShape ;
    sh:path era:otherCategoryReplacesCantDeficiencySSP ;
    sh:minCount 1 ;
    .

infra-sh:SpeedLimitCategory-otherCategoryDoesNotReplaceCantDeficiencySSP-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:otherCategoryDoesNotReplaceCantDeficiencySSP is present"@en ;
    sh:property infra-sh:SpeedLimitCategory-otherCategoryDoesNotReplaceCantDeficiencySSP-required ;
    .

infra-sh:SpeedLimitCategory-otherCategoryDoesNotReplaceCantDeficiencySSP-required
    a sh:PropertyShape ;
    sh:path era:otherCategoryDoesNotReplaceCantDeficiencySSP ;
    sh:minCount 1 ;
    .

infra-sh:SpeedLimitCategory-cantDeficiencyCategory-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:cantDeficiencyCategory is present"@en ;
    sh:property infra-sh:SpeedLimitCategory-cantDeficiencyCategory-required ;
    .

infra-sh:SpeedLimitCategory-cantDeficiencyCategory-required
    a sh:PropertyShape ;
    sh:path era:cantDeficiencyCategory ;
    sh:minCount 1 ;
    .

### AxleLoadSpeedProfile ##############################################
