infra-sh:LinearElementGeometry-horizontalAlignments-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:horizontalAlignments"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node infra-sh:HorizontalSegmentShape ;
        sh:message "horizontalAlignments must be a well-formed HorizontalSegment (blank node or IRI)."@en ;
        sh:message "horizontalAlignments muss ein wohlgeformtes HorizontalSegment sein (Blank Node oder IRI)."@de ;
        sh:message "horizontalAlignments doit être un HorizontalSegment bien formé (nœud vide ou IRI)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    .

infra-sh:LinearElementGeometry-verticalAlignments-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:verticalAlignments"@en ;
