### VerticalLine ######################################################
infra-sh:VerticalLineShape
    a sh:NodeShape ;
    sh:targetClass era:VerticalLine ;
    sh:name "VerticalLine" ;
    sh:description "Defines the geometric primitive for vertical linear segment" ;
    rdfs:comment "sub-package: geometry" ;
    sh:property infra-sh:VerticalLine-elementGeometryPos ;
    sh:property infra-sh:VerticalLine-slope ;
    sh:severity sh:Violation ;
    .

infra-sh:VerticalLine-elementGeometryPos
    a sh:PropertyShape ;
    sh:path era:elementGeometryPos ;
    sh:name "elementGeometryPos" ;
    sh:description "position on the associated LinearElement" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:VerticalLine-slope
    a sh:PropertyShape ;
    sh:path era:slope ;
    sh:name "slope" ;
    sh:description "Defines the vertical slope at pos, between the horizon and the track centre line. Viewed in the direction of the linear element. Positive for rising slope and negative for falling slope." ;
    sh:order 2 ;
    qudt:hasUnit unit:MilliM-PER-M ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:int ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

