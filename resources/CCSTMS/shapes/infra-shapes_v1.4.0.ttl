    sh:severity sh:Violation ;
    .

infra-sh:VerticalArc-radius
    a sh:PropertyShape ;
    sh:path era:radius ;
    sh:name "radius" ;
    sh:description "Defines the radius at pos" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:VerticalArc-arcType
    a sh:PropertyShape ;
    sh:path era:arcType ;
    sh:name "arcType" ;
    sh:description "Defines the type of Arc. For more details see https://ifc43-docs.standards.buildingsmart.org/IFC/RELEASE/IFC4x3/HTML/lexical/IfcAlignmentVerticalSegmentTypeEnum.htm" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/arc-type/circularArc> <http://data.europa.eu/949/concepts/arc-type/parabola> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ArcType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### CantPoint #########################################################
infra-sh:CantPointShape
    a sh:NodeShape ;
    sh:targetClass era:CantPoint ;
    sh:name "CantPoint" ;
    sh:description "Defines Cant (Superelevation) at the locations of start and end Cant Ramps on the track." ;
    sh:property infra-sh:CantPoint-elementGeometryPos ;
    sh:property infra-sh:CantPoint-appliedCant ;
    sh:severity sh:Violation ;
    .

infra-sh:CantPoint-elementGeometryPos
    a sh:PropertyShape ;
    sh:path era:elementGeometryPos ;
    sh:name "elementGeometryPos" ;
    sh:description "position on the associated LinearElement" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:CantPoint-appliedCant
    a sh:PropertyShape ;
    sh:path era:appliedCant ;
    sh:name "appliedCant" ;
    sh:description "Height of the outer rail minus the inner rail. Outer rail and inner rail are defined according to the direction of curve. Rollangle=(arcsin(cant/gauge)), gauge is distance between middle of the railheads, e.g. 1500mm for EU-standard gauge '1435mm' ; The applied cant is defined for the start" ;
    sh:order 2 ;
    qudt:hasUnit unit:MilliM ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:int ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### SampledGeometryArea ###############################################
infra-sh:SampledGeometryAreaShape
    a sh:NodeShape ;
    sh:targetClass era:SampledGeometryArea ;
    sh:name "SampledGeometryArea" ;
    sh:description "Defines the container sampled geometry area within INFRA Domain" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property infra-sh:SampledGeometryArea-topoArea ;
    sh:property infra-sh:SampledGeometryArea-sgaVersionTimestamp ;
    sh:property infra-sh:SampledGeometryArea-sampledLinearElementGeometries ;
    sh:severity sh:Violation ;
    .

infra-sh:SampledGeometryArea-topoArea
    a sh:PropertyShape ;
    sh:path era:topoArea ;
    sh:name "topoArea" ;
    sh:description "reference to the corresponding TopoArea" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TopoArea ;
    sh:message "topoArea must reference an existing era:TopoArea by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:SampledGeometryArea-sgaVersionTimestamp
    a sh:PropertyShape ;
    sh:path era:sgaVersionTimestamp ;
    sh:name "sgaVersionTimestamp" ;
    sh:description "version information of the samples geometry area which is valid since timestamp" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:SampledGeometryArea-sampledLinearElementGeometries
    a sh:PropertyShape ;
    sh:path era:sampledLinearElementGeometries ;
    sh:name "sampledLinearElementGeometries" ;
    sh:description "composes of sampled linear element geometries" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:SampledLinearElementGeometryShape ;
    sh:message "sampledLinearElementGeometries must be a well-formed SampledLinearElementGeometry (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

### SampledLinearElementGeometry ######################################
infra-sh:SampledLinearElementGeometryShape
    a sh:NodeShape ;
    sh:targetClass era:SampledLinearElementGeometry ;
    sh:name "SampledLinearElementGeometry" ;
    sh:description "Defines the container sampled linear element geometry within INFRA Domain" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:sparql infra-sh:SampledLinearElementGeometry-slopes-listWellFormed ;
    sh:sparql infra-sh:SampledLinearElementGeometry-slopes-listItemCount ;
    sh:sparql infra-sh:SampledLinearElementGeometry-curves-listWellFormed ;
    sh:sparql infra-sh:SampledLinearElementGeometry-curves-listItemCount ;
    sh:sparql infra-sh:SampledLinearElementGeometry-cants-listWellFormed ;
    sh:sparql infra-sh:SampledLinearElementGeometry-cants-listItemCount ;
    sh:property infra-sh:SampledLinearElementGeometry-linearElement ;
    sh:property infra-sh:SampledLinearElementGeometry-slopes ;
    sh:property infra-sh:SampledLinearElementGeometry-curves ;
    sh:property infra-sh:SampledLinearElementGeometry-cants ;
    sh:severity sh:Violation ;
    .

infra-sh:SampledLinearElementGeometry-linearElement
    a sh:PropertyShape ;
    sh:path era:linearElement ;
    sh:name "linearElement" ;
    sh:description "reference to the corresponding LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "linearElement must reference an existing era:LinearElement by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:SampledLinearElementGeometry-slopes
    a sh:PropertyShape ;
    sh:path era:slopes ;
    sh:name "slopes" ;
    sh:description "composes of slope sample points" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "slopes is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node infra-sh:SampledLinearElementGeometry-slopes-items ;
    sh:severity sh:Violation ;
    .

infra-sh:SampledLinearElementGeometry-curves
    a sh:PropertyShape ;
    sh:path era:curves ;
    sh:name "curves" ;
    sh:description "composes of curve sample points" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "curves is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node infra-sh:SampledLinearElementGeometry-curves-items ;
    sh:severity sh:Violation ;
    .

infra-sh:SampledLinearElementGeometry-cants
    a sh:PropertyShape ;
    sh:path era:cants ;
    sh:name "cants" ;
    sh:description "composes of cant sample points" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "cants is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node infra-sh:SampledLinearElementGeometry-cants-items ;
    sh:severity sh:Violation ;
    .

infra-sh:SampledLinearElementGeometry-slopes-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "era:slopes is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:slopes ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

infra-sh:SampledLinearElementGeometry-slopes-listItemCount
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "The single rdf:List carried by era:slopes must hold at least 1 item(s); the multiplicity bounds the items inside the list, not the number of lists."@en ;
    sh:select """
            SELECT $this (COUNT(?item) AS ?itemCount)
            WHERE {
                $this era:slopes ?head .
                OPTIONAL {
                    ?head rdf:rest* ?cell .
                    FILTER ( ?cell != rdf:nil )
                    BIND ( ?cell AS ?item )
                }
            }
            GROUP BY $this
            HAVING ( COUNT(?item) < 1 )
        """ ;
    .

infra-sh:SampledLinearElementGeometry-curves-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "era:curves is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:curves ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

infra-sh:SampledLinearElementGeometry-curves-listItemCount
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "The single rdf:List carried by era:curves must hold at least 1 item(s); the multiplicity bounds the items inside the list, not the number of lists."@en ;
    sh:select """
            SELECT $this (COUNT(?item) AS ?itemCount)
            WHERE {
                $this era:curves ?head .
                OPTIONAL {
                    ?head rdf:rest* ?cell .
                    FILTER ( ?cell != rdf:nil )
                    BIND ( ?cell AS ?item )
                }
            }
            GROUP BY $this
            HAVING ( COUNT(?item) < 1 )
        """ ;
    .

infra-sh:SampledLinearElementGeometry-cants-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "era:cants is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:cants ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

infra-sh:SampledLinearElementGeometry-cants-listItemCount
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "The single rdf:List carried by era:cants must hold at least 1 item(s); the multiplicity bounds the items inside the list, not the number of lists."@en ;
    sh:select """
            SELECT $this (COUNT(?item) AS ?itemCount)
            WHERE {
                $this era:cants ?head .
                OPTIONAL {
                    ?head rdf:rest* ?cell .
                    FILTER ( ?cell != rdf:nil )
                    BIND ( ?cell AS ?item )
                }
            }
            GROUP BY $this
            HAVING ( COUNT(?item) < 1 )
        """ ;
    .

infra-sh:SampledLinearElementGeometry-slopes-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:slopes"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node infra-sh:SlopeSamplePointShape ;
        sh:message "slopes must be a well-formed SlopeSamplePoint (blank node or IRI)."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

infra-sh:SampledLinearElementGeometry-curves-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:curves"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node infra-sh:CurveSamplePointShape ;
        sh:message "curves must be a well-formed CurveSamplePoint (blank node or IRI)."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

infra-sh:SampledLinearElementGeometry-cants-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:cants"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node infra-sh:CantSamplePointShape ;
        sh:message "cants must be a well-formed CantSamplePoint (blank node or IRI)."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

### SlopeSamplePoint ##################################################
infra-sh:SlopeSamplePointShape
    a sh:NodeShape ;
    sh:targetClass era:SlopeSamplePoint ;
    sh:name "SlopeSamplePoint" ;
    sh:description "Defines the Slope (gradient) of the track at a given location on the track." ;
    sh:property infra-sh:SlopeSamplePoint-elementGeometryPos ;
    sh:property infra-sh:SlopeSamplePoint-samplePointSlope ;
    sh:severity sh:Violation ;
    .

infra-sh:SlopeSamplePoint-elementGeometryPos
    a sh:PropertyShape ;
    sh:path era:elementGeometryPos ;
    sh:name "elementGeometryPos" ;
    sh:description "position on the associated LinearElement" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:SlopeSamplePoint-samplePointSlope
    a sh:PropertyShape ;
    sh:path era:samplePointSlope ;
    sh:name "samplePointSlope" ;
    sh:description "Defines the vertical slope at pos, between the horizon and the track centre line. Viewed in the direction of the LinearElement. Positive for rising slope and negative for falling slope." ;
    sh:order 2 ;
    qudt:hasUnit unit:MilliM-PER-M ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:int ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### CantSamplePoint ###################################################
infra-sh:CantSamplePointShape
    a sh:NodeShape ;
    sh:targetClass era:CantSamplePoint ;
    sh:name "CantSamplePoint" ;
    sh:description "Defines the cant(superelevation) of the track at a given location on the track." ;
    sh:property infra-sh:CantSamplePoint-elementGeometryPos ;
    sh:property infra-sh:CantSamplePoint-samplePointCant ;
    sh:severity sh:Violation ;
    .

infra-sh:CantSamplePoint-elementGeometryPos
    a sh:PropertyShape ;
    sh:path era:elementGeometryPos ;
    sh:name "elementGeometryPos" ;
    sh:description "position on the associated LinearElement" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:CantSamplePoint-samplePointCant
    a sh:PropertyShape ;
    sh:path era:samplePointCant ;
    sh:name "samplePointCant" ;
    sh:description "Defines the height of the outer rail minus the inner rail. Outer rail and inner rail are defined according to the direction of curve. Rollangle=(arcsin(cant/gauge), gauge is distance between centers of rail-heads, e.g. 1500mm for EU-standard gauge." ;
    sh:order 2 ;
    qudt:hasUnit unit:MilliM ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:int ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### CurveSamplePoint ##################################################
infra-sh:CurveSamplePointShape
    a sh:NodeShape ;
    sh:targetClass era:CurveSamplePoint ;
    sh:name "CurveSamplePoint" ;
    sh:description "Defines curve (radius) of the track at a given location on the track." ;
    sh:property infra-sh:CurveSamplePoint-elementGeometryPos ;
    sh:property infra-sh:CurveSamplePoint-sampleCurveRadius ;
    sh:severity sh:Violation ;
    .

infra-sh:CurveSamplePoint-elementGeometryPos
