                    FILTER ( ?cell != rdf:nil )
                    BIND ( ?cell AS ?item )
                }
            }
            GROUP BY $this
            HAVING ( COUNT(?item) < 1 )
        """ ;
    .

infra-sh:LinearElementGeometry-cantPoints-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes infra-sh:PrefixDeclarations ;
    sh:message "era:cantPoints is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:message "era:cantPoints ist mit byIndex geordnet und muss daher eine wohlgeformte, terminierte rdf:List sein: jede Listenzelle benötigt genau ein rdf:first und genau ein rdf:rest."@de ;
    sh:message "era:cantPoints est ordonné par byIndex et doit donc être une rdf:List bien formée et terminée : chaque cellule de la liste nécessite exactement un rdf:first et exactement un rdf:rest."@fr ;
    sh:select """
