### Switch ############################################################
infra-sh:SwitchShape
    a sh:NodeShape ;
    sh:targetClass era:Switch ;
    sh:name "Switch" ;
    sh:description "A unit of track comprising two fixed rails (stock rails) and two movable rails (switch rails) used to direct vehicles from one track to another track." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property infra-sh:Switch-reversalTime ;
    sh:property infra-sh:Switch-leftBranch ;
    sh:property infra-sh:Switch-rightBranch ;
    sh:property infra-sh:Switch-name ;
    sh:severity sh:Violation ;
    .

infra-sh:Switch-reversalTime
    a sh:PropertyShape ;
    sh:path era:reversalTime ;
    sh:name "reversalTime" ;
    sh:description "Defines the time in seconds to switch from one position to the other" ;
    sh:order 2 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:Switch-leftBranch
    a sh:PropertyShape ;
    sh:path era:leftBranch ;
    sh:name "leftBranch" ;
    sh:description "NetRelation referencing the left side of the switch in the facing direction of the switch" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:NetRelation ;
    sh:message "leftBranch must reference an existing era:NetRelation by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:Switch-rightBranch
    a sh:PropertyShape ;
    sh:path era:rightBranch ;
    sh:name "rightBranch" ;
    sh:description "NetRelation referencing the right side of the switch in the facing direction of the switch" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:class era:NetRelation ;
    sh:message "rightBranch must reference an existing era:NetRelation by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:Switch-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### SlipCrossing ######################################################
infra-sh:SlipCrossingShape
    a sh:NodeShape ;
    sh:targetClass era:SlipCrossing ;
    sh:name "SlipCrossing" ;
    sh:description "Defines the physical track asset Slip Crossing ; 2 instances switch point define a single slip crossing and 4 instances of switch point defined a double slip crossing ; Reversal time is the maximum of known reversal times of switches. If the reversal time of at least one switch in the slip point is unknown, the reversal time of the slip point is unknown as well." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:or (
        [ sh:property [ sh:path era:switches ; sh:minCount 2 ; sh:maxCount 2 ] ]
        [ sh:property [ sh:path era:switches ; sh:minCount 4 ; sh:maxCount 4 ] ]
    ) ;
    sh:message "A SlipCrossing must reference exactly two switches (single slip crossing) or exactly four switches (double slip crossing) - never three (see formatNote on SlipCrossing.switches)."@en ;
    sh:property infra-sh:SlipCrossing-switches ;
    sh:property infra-sh:SlipCrossing-crossing ;
    sh:property infra-sh:SlipCrossing-name ;
    sh:severity sh:Violation ;
    .

infra-sh:SlipCrossing-switches
    a sh:PropertyShape ;
    sh:path era:switches ;
    sh:name "switches" ;
    sh:description "Consists of simple points" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Switch ;
    sh:message "switches must reference an existing era:Switch by IRI."@en ;
    sh:severity sh:Violation ;
    .

infra-sh:SlipCrossing-crossing
    a sh:PropertyShape ;
    sh:path era:crossing ;
    sh:name "crossing" ;
    sh:description "Consists of crossing" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Crossing ;
    sh:message "crossing must reference an existing era:Crossing by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:SlipCrossing-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

