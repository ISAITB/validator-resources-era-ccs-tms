    .

infra-sh:TunnelTube-crossSection
    a sh:PropertyShape ;
    sh:path era:crossSection ;
    sh:name "crossSection" ;
    sh:description "Defines the standard Cross section dimensions of a tunnel tube for calculation of air-resistance" ;
    sh:order 2 ;
    qudt:hasUnit unit:M2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

