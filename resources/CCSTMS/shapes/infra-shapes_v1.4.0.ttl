    sh:targetClass era:CurrentLimitation ;
    sh:name "CurrentLimitation" ;
    sh:description "Defines max current for a list of track sections" ;
    sh:property infra-sh:CurrentLimitation-linearElementSections ;
    sh:property infra-sh:CurrentLimitation-maxCurrent ;
    sh:severity sh:Violation ;
    .

infra-sh:CurrentLimitation-linearElementSections
    a sh:PropertyShape ;
    sh:path era:linearElementSections ;
    sh:name "linearElementSections" ;
    sh:description "composes of linear element sections" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:LinearElementSectionShape ;
    sh:message "linearElementSections must be a well-formed LinearElementSection (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:CurrentLimitation-maxCurrent
    a sh:PropertyShape ;
    sh:path era:maxCurrent ;
    sh:name "maxCurrent" ;
    sh:description "defines max current value" ;
    sh:order 2 ;
    qudt:hasUnit unit:A ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### PermittedBrakingDistance ##########################################
infra-sh:PermittedBrakingDistanceShape
    a sh:NodeShape ;
    sh:targetClass era:PermittedBrakingDistance ;
    sh:name "PermittedBrakingDistance" ;
    sh:description "Defines max allowed braking distance for a list of linear element sections" ;
    sh:property infra-sh:PermittedBrakingDistance-linearElementSections ;
    sh:property infra-sh:PermittedBrakingDistance-distance ;
    sh:property infra-sh:PermittedBrakingDistance-byEmergencyBrake ;
    sh:property infra-sh:PermittedBrakingDistance-gradientValue ;
    sh:property infra-sh:PermittedBrakingDistance-sameDir ;
    sh:severity sh:Violation ;
    .

infra-sh:PermittedBrakingDistance-linearElementSections
    a sh:PropertyShape ;
    sh:path era:linearElementSections ;
    sh:name "linearElementSections" ;
    sh:description "Defines the set of linear element sections composing the application area" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node infra-sh:LinearElementSectionShape ;
    sh:message "linearElementSections must be a well-formed LinearElementSection (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:PermittedBrakingDistance-distance
    a sh:PropertyShape ;
    sh:path era:distance ;
    sh:name "distance" ;
    sh:description "Defines the applicable permitted braking distance" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:PermittedBrakingDistance-byEmergencyBrake
    a sh:PropertyShape ;
    sh:path era:byEmergencyBrake ;
    sh:name "byEmergencyBrake" ;
    sh:description "Whether the permitted braking distance is to be achieved with the Service Brake or Emergency Brake. True if Braking is to be achieved using Emergency brake ; False if braking is to be achieved by service brake" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:PermittedBrakingDistance-gradientValue
    a sh:PropertyShape ;
    sh:path era:gradientValue ;
    sh:name "gradientValue" ;
    sh:description "Defines the gradient value. Required Resolution is 0.1 permill; positiv: uphill, negative: downhill" ;
    sh:order 4 ;
    qudt:hasUnit unit:MilliM-PER-M ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value); ERTMS subset variable: G_New_Gradient"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:int ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

infra-sh:PermittedBrakingDistance-sameDir
    a sh:PropertyShape ;
    sh:path era:sameDir ;
    sh:name "sameDir" ;
    sh:description "Defines the usage direction of the linear element ;true: active in same direction as linear element, false: active in opposite direction" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

