    sh:property infra-sh:FunctionalArea-bridges ;
    sh:property infra-sh:FunctionalArea-underpasses ;
    sh:property infra-sh:FunctionalArea-tvps ;
    sh:property infra-sh:FunctionalArea-levelCrossings ;
    sh:property infra-sh:FunctionalArea-nationalBorders ;
