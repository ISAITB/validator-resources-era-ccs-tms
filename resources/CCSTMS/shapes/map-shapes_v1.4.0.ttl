@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix era:     <http://data.europa.eu/949/> .

@prefix map-sh: <http://data.europa.eu/949/shapes/map#> .



########################################################################
#  SPARQL prefix declarations
#
#  SHACL 5.3: the Turtle @prefix declarations above do NOT apply inside
#  sh:select - only sh:prefixes does. Without this, a query writing era:...
#  fails with "Unknown namespace prefix : era" on any data graph that does
#  not itself bind the same prefix (e.g. data written with full IRIs).
########################################################################

map-sh:PrefixDeclarations
    a owl:Ontology ;
    rdfs:label "Prefixes available to every sh:select in this file"@en ;
    sh:declare
        [ sh:prefix "era"  ; sh:namespace "http://data.europa.eu/949/"^^xsd:anyURI ] ,
        [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd"  ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ;
    .

########################################################################
#  Imported shapes
#
#  map references or composes these structs from other
#  modules, so their shapes are inlined here for completeness (rule 17).
#  They are minted in this module's namespace, prefixed with the source
#  module, so this file never collides with the owning module's own
#  shapes file. Loading both simply reports shared classes twice.
########################################################################

### LinearElement #####################################################
map-sh:infra-LinearElementShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElement ;
    sh:name "LinearElement" ;
    sh:description "A linear element is an uninterrupted stretch of railway track, without divergence or convergence." ;
    rdfs:comment "sub-package: topology" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-LinearElement-lengthOfNetLinearElement ;
    sh:property map-sh:infra-LinearElement-name ;
    sh:severity sh:Violation ;
    .

map-sh:infra-LinearElement-lengthOfNetLinearElement
    a sh:PropertyShape ;
    sh:path era:lengthOfNetLinearElement ;
    sh:name "lengthOfNetLinearElement" ;
    sh:description "Defines the distance along the LinearElement's track centre line." ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "lengthOfNetLinearElement is the total length of this element's own track centre line, measured in metres from its origin to its far end. This value is what every position-and-offset check elsewhere in this data model is ultimately bounded against - a KilometricPost's pos, a StaticSpeedLimit's position, a TopologicalCoordinate's offsetFromOrigin, and many others all rely on this being present and correct to know where the far end of their own element actually is. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number. This check does not require the value to be positive; a zero or negative length is a separate, unrelated check."@en ;
    era:additionalInfo "lengthOfNetLinearElement ist die Gesamtlänge der eigenen Gleisachse dieses Elements, gemessen in Metern von seinem Ursprung bis zu seinem fernen Ende. Dieser Wert ist das, wogegen jede Positions- und Offset-Prüfung an anderer Stelle in diesem Datenmodell letztlich begrenzt wird - pos eines KilometricPost, die Position eines StaticSpeedLimit, offsetFromOrigin einer TopologicalCoordinate und viele andere verlassen sich darauf, dass dieser Wert vorhanden und korrekt ist, um zu wissen, wo das ferne Ende ihres eigenen Elements tatsächlich liegt. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zahl. Diese Prüfung verlangt nicht, dass der Wert positiv ist; eine Länge von null oder negativ ist eine separate, unabhängige Prüfung."@de ;
    era:additionalInfo "lengthOfNetLinearElement est la longueur totale de l'axe de voie propre à cet élément, mesurée en mètres depuis son origine jusqu'à son extrémité éloignée. Cette valeur est celle par rapport à laquelle toute vérification de position et de décalage ailleurs dans ce modèle de données est en définitive bornée - le pos d'un KilometricPost, la position d'un StaticSpeedLimit, l'offsetFromOrigin d'une TopologicalCoordinate, et bien d'autres, dépendent tous de sa présence et de son exactitude pour savoir où se situe réellement l'extrémité éloignée de leur propre élément. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un nombre valide. Cette vérification n'exige pas que la valeur soit positive ; une longueur nulle ou négative est une vérification distincte et sans rapport."@fr ;
    .

map-sh:infra-LinearElement-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this linear element, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für dieses lineare Element, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cet élément linéaire, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### Switch ############################################################
map-sh:infra-SwitchShape
    a sh:NodeShape ;
    sh:targetClass era:Switch ;
    sh:name "Switch" ;
    sh:description "A unit of track comprising two fixed rails (stock rails) and two movable rails (switch rails) used to direct vehicles from one track to another track." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-Switch-reversalTime ;
    sh:property map-sh:infra-Switch-leftBranch ;
    sh:property map-sh:infra-Switch-rightBranch ;
    sh:property map-sh:infra-Switch-name ;
    sh:severity sh:Violation ;
    .

map-sh:infra-Switch-reversalTime
    a sh:PropertyShape ;
    sh:path era:reversalTime ;
    sh:name "reversalTime" ;
    sh:description "Defines the time in seconds to switch from one position to the other" ;
    sh:order 2 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "reversalTime is stored with a scaling exponent of -1: the raw stored integer must be multiplied by 0.1 to get the actual physical value in seconds - a stored value of 50 means an actual reversal time of 5.0 seconds, not 50. This property is optional; its absence is not a violation. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "reversalTime wird mit einem Skalierungsexponenten von -1 gespeichert: der roh gespeicherte Ganzzahlwert muss mit 0,1 multipliziert werden, um den tatsächlichen physikalischen Wert in Sekunden zu erhalten - ein gespeicherter Wert von 50 bedeutet eine tatsächliche Umstellzeit von 5,0 Sekunden, nicht 50. Diese Eigenschaft ist optional; ihr Fehlen ist kein Verstoß. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "reversalTime est stocké avec un exposant d'échelle de -1 : l'entier brut stocké doit être multiplié par 0,1 pour obtenir la valeur physique réelle en secondes - une valeur stockée de 50 signifie un temps de retournement réel de 5,0 secondes, non 50. Cette propriété est optionnelle ; son absence n'est pas une violation. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

map-sh:infra-Switch-leftBranch
    a sh:PropertyShape ;
    sh:path era:leftBranch ;
    sh:name "leftBranch" ;
    sh:description "NetRelation referencing the left side of the switch in the facing direction of the switch" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:NetRelation ;
    sh:message "leftBranch must reference an existing era:NetRelation by IRI."@en ;
    sh:message "leftBranch muss über eine IRI auf ein bestehendes era:NetRelation verweisen."@de ;
    sh:message "leftBranch doit référencer un era:NetRelation existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "leftBranch's own description states it references the left side of the switch specifically in the switch's own facing direction - not an absolute or geographic left, and reversed if the switch is approached from the other end. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a NetRelation."@en ;
    era:additionalInfo "Die eigene Beschreibung von leftBranch besagt, dass sie die linke Seite der Weiche speziell in der eigenen Zeigerichtung der Weiche referenziert - nicht ein absolutes oder geografisches Links, und umgekehrt, wenn die Weiche vom anderen Ende her angefahren wird. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als NetRelation typisiertes Objekt."@de ;
    era:additionalInfo "La propre description de leftBranch indique qu'elle référence le côté gauche de l'aiguillage spécifiquement dans le sens de pointe propre de l'aiguillage - non une gauche absolue ou géographique, et inversée si l'aiguillage est abordé depuis l'autre extrémité. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme NetRelation."@fr ;
    .

map-sh:infra-Switch-rightBranch
    a sh:PropertyShape ;
    sh:path era:rightBranch ;
    sh:name "rightBranch" ;
    sh:description "NetRelation referencing the right side of the switch in the facing direction of the switch" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:class era:NetRelation ;
    sh:message "rightBranch must reference an existing era:NetRelation by IRI."@en ;
    sh:message "rightBranch muss über eine IRI auf ein bestehendes era:NetRelation verweisen."@de ;
    sh:message "rightBranch doit référencer un era:NetRelation existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "rightBranch's own description states it references the right side of the switch specifically in the switch's own facing direction - not an absolute or geographic right, and reversed if the switch is approached from the other end. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a NetRelation."@en ;
    era:additionalInfo "Die eigene Beschreibung von rightBranch besagt, dass sie die rechte Seite der Weiche speziell in der eigenen Zeigerichtung der Weiche referenziert - nicht ein absolutes oder geografisches Rechts, und umgekehrt, wenn die Weiche vom anderen Ende her angefahren wird. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als NetRelation typisiertes Objekt."@de ;
    era:additionalInfo "La propre description de rightBranch indique qu'elle référence le côté droit de l'aiguillage spécifiquement dans le sens de pointe propre de l'aiguillage - non une droite absolue ou géographique, et inversée si l'aiguillage est abordé depuis l'autre extrémité. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme NetRelation."@fr ;
    .

map-sh:infra-Switch-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this switch, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diese Weiche, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cet aiguillage, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### ETCSMarker ########################################################
map-sh:infra-ETCSMarkerShape
    a sh:NodeShape ;
    sh:targetClass era:ETCSMarker ;
    sh:name "ETCSMarker" ;
    sh:description "Defines the ETCS Marker Boards" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-ETCSMarker-netPointReference ;
    sh:property map-sh:infra-ETCSMarker-markerFunctionStop ;
    sh:property map-sh:infra-ETCSMarker-name ;
    sh:severity sh:Violation ;
    .

map-sh:infra-ETCSMarker-netPointReference
    a sh:PropertyShape ;
    sh:path era:netPointReference ;
    sh:name "netPointReference" ;
    sh:description "Defines position on LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-NetPointReferenceShape ;
    sh:message "netPointReference must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:message "netPointReference muss ein wohlgeformtes NetPointReference sein (Blank Node oder IRI)."@de ;
    sh:message "netPointReference doit être un NetPointReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "netPointReference locates this marker board on the network via a nested NetPointReference, which itself must contain a valid position (a TopologicalCoordinate: a LinearElement plus an offset) and may also carry a direction qualifier relative to that element's own orientation. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetPointReference shape itself."@en ;
    era:additionalInfo "netPointReference lokalisiert dieses Markierungsschild im Netz über eine verschachtelte NetPointReference, die selbst eine gültige Position enthalten muss (eine TopologicalCoordinate: ein LinearElement plus ein Offset) und zusätzlich einen Richtungsqualifizierer relativ zur eigenen Ausrichtung dieses Elements tragen kann. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetPointReference-Shape selbst nicht."@de ;
    era:additionalInfo "netPointReference localise ce panneau de signalisation sur le réseau via une NetPointReference imbriquée, laquelle doit elle-même contenir une position valide (une TopologicalCoordinate : un LinearElement plus un décalage) et peut également porter un qualificatif de direction relatif à l'orientation propre de cet élément. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetPointReference imbriquée elle-même."@fr ;
    .

map-sh:infra-ETCSMarker-markerFunctionStop
    a sh:PropertyShape ;
    sh:path era:markerFunctionStop ;
    sh:name "markerFunctionStop" ;
    sh:description "Defines the function associated with the ETCS marker board. true=stop, false=location (when the ETCS marker is a location marker)" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "markerFunctionStop's own description states that true means this marker board functions as a stop marker, and false means it is a location marker. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean."@en ;
    era:additionalInfo "Die eigene Beschreibung von markerFunctionStop besagt, dass true bedeutet, dass dieses Markierungsschild als Halt-Markierung fungiert, und false, dass es eine Standort-Markierung ist. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert."@de ;
    era:additionalInfo "La propre description de markerFunctionStop indique que true signifie que ce panneau fonctionne comme un repère d'arrêt, et false qu'il s'agit d'un repère de localisation. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique."@fr ;
    .

map-sh:infra-ETCSMarker-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this marker board, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für dieses Markierungsschild, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour ce panneau de signalisation, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### StopLocation ######################################################
map-sh:infra-StopLocationShape
    a sh:NodeShape ;
    sh:targetClass era:StopLocation ;
    sh:name "StopLocation" ;
    sh:description "Defines the stop locations" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-StopLocation-netPointReference ;
    sh:property map-sh:infra-StopLocation-stopTrainLimit ;
    sh:property map-sh:infra-StopLocation-trainLoadType ;
    sh:property map-sh:infra-StopLocation-doorOpeningSide ;
    sh:property map-sh:infra-StopLocation-name ;
    sh:severity sh:Violation ;
    .

map-sh:infra-StopLocation-netPointReference
    a sh:PropertyShape ;
    sh:path era:netPointReference ;
    sh:name "netPointReference" ;
    sh:description "Defines position on LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-NetPointReferenceShape ;
    sh:message "netPointReference must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:message "netPointReference muss ein wohlgeformtes NetPointReference sein (Blank Node oder IRI)."@de ;
    sh:message "netPointReference doit être un NetPointReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "netPointReference locates this stop location on the network via a nested NetPointReference, which itself must contain a valid position (a TopologicalCoordinate: a LinearElement plus an offset) and may also carry a direction qualifier relative to that element's own orientation. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetPointReference shape itself."@en ;
    era:additionalInfo "netPointReference lokalisiert diese Haltestelle im Netz über eine verschachtelte NetPointReference, die selbst eine gültige Position enthalten muss (eine TopologicalCoordinate: ein LinearElement plus ein Offset) und zusätzlich einen Richtungsqualifizierer relativ zur eigenen Ausrichtung dieses Elements tragen kann. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetPointReference-Shape selbst nicht."@de ;
    era:additionalInfo "netPointReference localise cet emplacement d'arrêt sur le réseau via une NetPointReference imbriquée, laquelle doit elle-même contenir une position valide (une TopologicalCoordinate : un LinearElement plus un décalage) et peut également porter un qualificatif de direction relatif à l'orientation propre de cet élément. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetPointReference imbriquée elle-même."@fr ;
    .

map-sh:infra-StopLocation-stopTrainLimit
    a sh:PropertyShape ;
    sh:path era:stopTrainLimit ;
    sh:name "stopTrainLimit" ;
    sh:description "composes of stop train limits" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-StopTrainLimitShape ;
    sh:message "stopTrainLimit must be a well-formed StopTrainLimit (blank node or IRI)."@en ;
    sh:message "stopTrainLimit muss ein wohlgeformtes StopTrainLimit sein (Blank Node oder IRI)."@de ;
    sh:message "stopTrainLimit doit être un StopTrainLimit bien formé (nœud vide ou IRI)."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "This property has no minCount, so a stop location with no train limit recorded is valid. Note that the message shown is shared across three different possible causes: more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested StopTrainLimit shape itself."@en ;
    era:additionalInfo "Diese Eigenschaft hat kein minCount, eine Haltestelle ohne erfasstes Zuglimit ist also gültig. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte StopTrainLimit-Shape selbst nicht."@de ;
    era:additionalInfo "Cette propriété n'a pas de minCount, un emplacement d'arrêt sans limite de train enregistrée est donc valide. Notez que le message affiché couvre trois causes possibles distinctes : plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape StopTrainLimit imbriquée elle-même."@fr ;
    .

map-sh:infra-StopLocation-trainLoadType
    a sh:PropertyShape ;
    sh:path era:trainLoadType ;
    sh:name "trainLoadType" ;
    sh:description "composes of train load types" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-load-type/passengerTrain> <http://data.europa.eu/949/concepts/train-load-type/freightTrain> <http://data.europa.eu/949/concepts/train-load-type/anyTrain> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TrainLoadType concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von TrainLoadType entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de TrainLoadType."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "The three defined types are: passengerTrain, freightTrain, anyTrain. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these three defined concepts."@en ;
    era:additionalInfo "Die drei definierten Typen sind: passengerTrain, freightTrain, anyTrain. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser drei definierten Konzepte."@de ;
    era:additionalInfo "Les trois types définis sont : passengerTrain, freightTrain, anyTrain. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces trois concepts définis."@fr ;
    .

map-sh:infra-StopLocation-doorOpeningSide
    a sh:PropertyShape ;
    sh:path era:doorOpeningSide ;
    sh:name "doorOpeningSide" ;
    sh:description "defines different train opening sides" ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/door-opening-side/noSide> <http://data.europa.eu/949/concepts/door-opening-side/leftSide> <http://data.europa.eu/949/concepts/door-opening-side/rightSide> <http://data.europa.eu/949/concepts/door-opening-side/bothSides> ) ;
    sh:message "Value must be one of the CCSTMS-scoped DoorOpeningSide concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von DoorOpeningSide entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de DoorOpeningSide."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "The four defined sides are: noSide, leftSide, rightSide, bothSides. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these four defined concepts."@en ;
    era:additionalInfo "Die vier definierten Seiten sind: noSide, leftSide, rightSide, bothSides. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser vier definierten Konzepte."@de ;
    era:additionalInfo "Les quatre côtés définis sont : noSide, leftSide, rightSide, bothSides. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces quatre concepts définis."@fr ;
    .

map-sh:infra-StopLocation-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this stop location, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diese Haltestelle, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cet emplacement d'arrêt, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### TimingPoint #######################################################
map-sh:infra-TimingPointShape
    a sh:NodeShape ;
    sh:targetClass era:TimingPoint ;
    sh:name "TimingPoint" ;
    sh:description "Defines a fixed point on the infrastructure" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-TimingPoint-topologicalCoordinate ;
    sh:property map-sh:infra-TimingPoint-activeObject ;
    sh:property map-sh:infra-TimingPoint-nidTP ;
    sh:property map-sh:infra-TimingPoint-tpName ;
    sh:property map-sh:infra-TimingPoint-stopLocationTolerance ;
    sh:property map-sh:infra-TimingPoint-stoppingPointReachDistance ;
    sh:severity sh:Violation ;
    .

map-sh:infra-TimingPoint-topologicalCoordinate
    a sh:PropertyShape ;
    sh:path era:topologicalCoordinate ;
    sh:name "topologicalCoordinate" ;
    sh:description "defines the location on linear element" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-TopologicalCoordinateShape ;
    sh:message "topologicalCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:message "topologicalCoordinate muss ein wohlgeformtes TopologicalCoordinate sein (Blank Node oder IRI)."@de ;
    sh:message "topologicalCoordinate doit être un TopologicalCoordinate bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested TopologicalCoordinate shape itself."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte TopologicalCoordinate-Shape selbst nicht."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape TopologicalCoordinate imbriquée elle-même."@fr ;
    .

map-sh:infra-TimingPoint-activeObject
    a sh:PropertyShape ;
    sh:path era:activeObject ;
    sh:name "activeObject" ;
    sh:description "Defines the functional object infront of which a TimingPoint is located and is active" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-TPActiveObjectShape ;
    sh:message "activeObject must be a well-formed TPActiveObject (blank node or IRI)."@en ;
    sh:message "activeObject muss ein wohlgeformtes TPActiveObject sein (Blank Node oder IRI)."@de ;
    sh:message "activeObject doit être un TPActiveObject bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested TPActiveObject shape itself."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte TPActiveObject-Shape selbst nicht."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape TPActiveObject imbriquée elle-même."@fr ;
    .

map-sh:infra-TimingPoint-nidTP
    a sh:PropertyShape ;
    sh:path era:nidTP ;
    sh:name "nidTP" ;
    sh:description "defines national identifier for the timing point" ;
    sh:order 4 ;
    rdfs:comment "ERTMS subset variable: NID_TP"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "nidTP corresponds to the ERTMS subset variable NID_TP. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "nidTP entspricht der ERTMS-Subset-Variable NID_TP. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "nidTP correspond à la variable ERTMS Subset NID_TP. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

map-sh:infra-TimingPoint-tpName
    a sh:PropertyShape ;
    sh:path era:tpName ;
    sh:name "tpName" ;
    sh:description "User-friendly name for the timing point" ;
    sh:order 5 ;
    rdfs:comment "ERTMS subset variable: X_TEXT"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "tpName corresponds to the ERTMS subset variable X_TEXT. Unlike most similar name properties elsewhere in this data model, this one has a minCount and is therefore required, not optional. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "tpName entspricht der ERTMS-Subset-Variable X_TEXT. Anders als die meisten ähnlichen name-Eigenschaften an anderer Stelle in diesem Datenmodell besitzt diese ein minCount und ist somit erforderlich, nicht optional. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "tpName correspond à la variable ERTMS Subset X_TEXT. Contrairement à la plupart des propriétés name similaires ailleurs dans ce modèle de données, celle-ci possède un minCount et est donc requise, non optionnelle. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

map-sh:infra-TimingPoint-stopLocationTolerance
    a sh:PropertyShape ;
    sh:path era:stopLocationTolerance ;
    sh:name "stopLocationTolerance" ;
    sh:description "Defines the required stopping tolerance for a Timing Point" ;
    sh:order 6 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/stop-location-tolerance/T_10cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_20cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_30cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_40cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_50cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_1m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_150cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_2m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_250cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_3m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_5m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_750cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_10m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_15m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_20m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_25m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_30m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_50m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_75m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_100m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_Undefined> ) ;
    sh:message "Value must be one of the CCSTMS-scoped StopLocationTolerance concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von StopLocationTolerance entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de StopLocationTolerance."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "The defined values climb from T_10cm up to T_100m, plus a dedicated T_Undefined value for when no tolerance is actually specified - a sentinel concept rather than simply omitting the property. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these defined concepts."@en ;
    era:additionalInfo "Die definierten Werte reichen von T_10cm bis T_100m, zuzüglich eines eigenen Werts T_Undefined für den Fall, dass tatsächlich keine Toleranz angegeben ist - ein Platzhalterkonzept, statt die Eigenschaft einfach wegzulassen. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser definierten Konzepte."@de ;
    era:additionalInfo "Les valeurs définies s'échelonnent de T_10cm à T_100m, plus une valeur dédiée T_Undefined pour le cas où aucune tolérance n'est réellement spécifiée - un concept sentinelle plutôt que de simplement omettre la propriété. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces concepts définis."@fr ;
    .

map-sh:infra-TimingPoint-stoppingPointReachDistance
    a sh:PropertyShape ;
    sh:path era:stoppingPointReachDistance ;
    sh:name "stoppingPointReachDistance" ;
    sh:description "Defines the distance from a stopping point to consider it as reached." ;
    sh:order 7 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/stop-location-tolerance/T_10cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_20cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_30cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_40cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_50cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_1m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_150cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_2m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_250cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_3m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_5m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_750cm> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_10m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_15m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_20m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_25m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_30m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_50m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_75m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_100m> <http://data.europa.eu/949/concepts/stop-location-tolerance/T_Undefined> ) ;
    sh:message "Value must be one of the CCSTMS-scoped StopLocationTolerance concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von StopLocationTolerance entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de StopLocationTolerance."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "This reuses the same StopLocationTolerance concept scheme as stopLocationTolerance elsewhere on this same object, for a different purpose - defining the distance at which a stopping point is considered reached, rather than the required stopping accuracy itself. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these defined concepts."@en ;
    era:additionalInfo "Dies verwendet dasselbe Konzeptschema StopLocationTolerance wie stopLocationTolerance an anderer Stelle desselben Objekts, jedoch für einen anderen Zweck - es legt die Distanz fest, ab der ein Haltepunkt als erreicht gilt, statt die erforderliche Haltegenauigkeit selbst. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser definierten Konzepte."@de ;
    era:additionalInfo "Ceci réutilise le même schéma de concepts StopLocationTolerance que stopLocationTolerance ailleurs sur ce même objet, mais à des fins différentes - il définit la distance à laquelle un point d'arrêt est considéré comme atteint, plutôt que la précision d'arrêt requise elle-même. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces concepts définis."@fr ;
    .

### OperationalPoint ##################################################
map-sh:infra-OperationalPointShape
    a sh:NodeShape ;
    sh:targetClass era:OperationalPoint ;
    sh:name "OperationalPoint" ;
    sh:description "An operational point (OP) means any location for train service operations, where train services may begin and end or change route, and where passenger or freight services may be provided; operational point also means any location at boundaries between Member States or infrastructure managers. In https://eur-lex.europa.eu/eli/reg_impl/2019/773/oj 2.1.2 Principal locations (stations, yards, junctions, freight terminals)." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "Globally identified by 'uopid'."@en ;
    sh:nodeKind sh:IRI ;
    sh:sparql map-sh:infra-OperationalPoint-platforms-listWellFormed ;
    sh:property map-sh:infra-OperationalPoint-uopid ;
    sh:property map-sh:infra-OperationalPoint-opName ;
    sh:property map-sh:infra-OperationalPoint-travelTimeMeasurementPoints ;
    sh:property map-sh:infra-OperationalPoint-opType ;
    sh:property map-sh:infra-OperationalPoint-platforms ;
    sh:severity sh:Violation ;
    .

map-sh:infra-OperationalPoint-uopid
    a sh:PropertyShape ;
    sh:path era:uopid ;
    sh:name "uopid" ;
    sh:description "Code composed of country code and alphanumeric operational point code." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Z]{2}[A-Za-z0-9]{1,10}$" ;
    sh:message "uopid must have the form CCAAAAAAAAAA: a two-letter ISO 3166-1 country code followed by 1 to 10 alphanumeric characters identifying the operational point within the Member State."@en ;
    sh:message "uopid muss die Form CCAAAAAAAAAA haben: ein zweibuchstabiger ISO-3166-1-Ländercode, gefolgt von 1 bis 10 alphanumerischen Zeichen, die den Betriebspunkt innerhalb des Mitgliedstaats identifizieren."@de ;
    sh:message "uopid doit avoir la forme CCAAAAAAAAAA : un code pays ISO 3166-1 à deux lettres, suivi de 1 à 10 caractères alphanumériques identifiant le point opérationnel au sein de l'État membre."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "The message already fully explains the required format. Note that it is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present does not match that pattern."@en ;
    era:additionalInfo "Die Meldung erklärt das erforderliche Format bereits vollständig. Beachten Sie, dass sie drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert entspricht nicht diesem Muster."@de ;
    era:additionalInfo "Le message explique déjà pleinement le format requis. Notez qu'il couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond pas à ce motif."@fr ;
    .

map-sh:infra-OperationalPoint-opName
    a sh:PropertyShape ;
    sh:path era:opName ;
    sh:name "opName" ;
    sh:description "Name normally related to the town or village or to traffic control purpose." ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "opName's own description notes it is normally related to the name of the town or village, or chosen for traffic control purposes. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "Die eigene Beschreibung von opName merkt an, dass sie normalerweise mit dem Namen der Stadt oder des Dorfes zusammenhängt, oder aus verkehrsleittechnischen Gründen gewählt wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "La propre description de opName note qu'il est normalement lié au nom de la ville ou du village, ou choisi à des fins de contrôle du trafic. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

map-sh:infra-OperationalPoint-travelTimeMeasurementPoints
    a sh:PropertyShape ;
    sh:path era:travelTimeMeasurementPoints ;
    sh:name "travelTimeMeasurementPoints" ;
    sh:description "Defined to measure/define timestamps for passing trains. Stopping-timingPoints can be found via platforms.platformEdges.stopLocations and timingPoint.stopLocation" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-TravelTimeMeasurementPointShape ;
    sh:message "travelTimeMeasurementPoints must be a well-formed TravelTimeMeasurementPoint (blank node or IRI)."@en ;
    sh:message "travelTimeMeasurementPoints muss ein wohlgeformtes TravelTimeMeasurementPoint sein (Blank Node oder IRI)."@de ;
    sh:message "travelTimeMeasurementPoints doit être un TravelTimeMeasurementPoint bien formé (nœud vide ou IRI)."@fr ;
    sh:severity sh:Violation ;
    era:additionalInfo "travelTimeMeasurementPoints's own description clarifies that this is specifically for measuring passing times, not stopping times - timing points where a train actually stops are found through a different path, via platforms, their platform edges, and stop locations. This property has neither minCount nor maxCount, so an operational point with none at all, or with several, is equally valid. Note that the message shown is shared across two different possible causes: the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested TravelTimeMeasurementPoint shape itself."@en ;
    era:additionalInfo "Die eigene Beschreibung von travelTimeMeasurementPoints stellt klar, dass dies speziell für die Messung von Durchfahrtszeiten dient, nicht von Haltezeiten - Zeitmesspunkte, an denen ein Zug tatsächlich hält, werden über einen anderen Pfad gefunden, über Bahnsteige, deren Bahnsteigkanten und Haltestellen. Diese Eigenschaft hat weder minCount noch maxCount, ein Betriebspunkt ganz ohne solche oder mit mehreren ist also gleichermaßen gültig. Beachten Sie, dass die angezeigte Meldung zwei unterschiedliche mögliche Ursachen abdeckt: der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte TravelTimeMeasurementPoint-Shape selbst nicht."@de ;
    era:additionalInfo "La propre description de travelTimeMeasurementPoints précise qu'il s'agit spécifiquement de mesurer les heures de passage, non les heures d'arrêt - les points de chronométrage où un train s'arrête réellement se trouvent via un autre chemin, à travers les quais, leurs bords de quai et les emplacements d'arrêt. Cette propriété n'a ni minCount ni maxCount, un point d'exploitation n'en ayant aucun ou en ayant plusieurs est donc également valide. Notez que le message affiché couvre deux causes possibles distinctes : la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape TravelTimeMeasurementPoint imbriquée elle-même."@fr ;
    .

map-sh:infra-OperationalPoint-opType
    a sh:PropertyShape ;
    sh:path era:opType ;
    sh:name "opType" ;
    sh:description "Defines the Type of operational point in relation to the dominating operational functions." ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/op-types/10> <http://data.europa.eu/949/concepts/op-types/50> <http://data.europa.eu/949/concepts/op-types/130> <http://data.europa.eu/949/concepts/op-types/60> <http://data.europa.eu/949/concepts/op-types/100> <http://data.europa.eu/949/concepts/op-types/90> <http://data.europa.eu/949/concepts/op-types/110> <http://data.europa.eu/949/concepts/op-types/140> <http://data.europa.eu/949/concepts/op-types/40> <http://data.europa.eu/949/concepts/op-types/80> <http://data.europa.eu/949/concepts/op-types/70> <http://data.europa.eu/949/concepts/op-types/30> <http://data.europa.eu/949/concepts/op-types/120> <http://data.europa.eu/949/concepts/op-types/20> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OperationalPointTypes concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von OperationalPointTypes entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de OperationalPointTypes."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of the fourteen defined concepts."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines der vierzehn definierten Konzepte."@de ;
    era:additionalInfo "Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun des quatorze concepts définis."@fr ;
    .

map-sh:infra-OperationalPoint-platforms
    a sh:PropertyShape ;
    sh:path era:platforms ;
    sh:name "platforms" ;
    sh:description "Defines the sequence (one after the another) of platforms according to the real location, so neighbours are the same in array and reality" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "platforms is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:message "platforms ist mit byIndex geordnet: es muss genau eine rdf:List tragen."@de ;
    sh:message "platforms est ordonné par byIndex : il doit porter exactement une rdf:List."@fr ;
    sh:node map-sh:infra-OperationalPoint-platforms-items ;
    sh:severity sh:Violation ;
    era:additionalInfo "platforms's own description states that the order of this list is meaningful data, not incidental: it is expected to follow the real physical sequence of platforms at this location, so that neighbours in the list are the same as neighbours in reality. This property has no minCount, so an operational point with no platforms recorded is valid. Note that the message shown is shared across three different possible causes: more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the underlying list fails the well-formedness or item-type checks carried out separately."@en ;
    era:additionalInfo "Die eigene Beschreibung von platforms besagt, dass die Reihenfolge dieser Liste bedeutungstragende Information ist, nicht nebensächlich: sie soll der tatsächlichen physischen Abfolge der Bahnsteige an diesem Ort entsprechen, sodass Nachbarn in der Liste dieselben sind wie Nachbarn in der Realität. Diese Eigenschaft hat kein minCount, ein Betriebspunkt ohne erfasste Bahnsteige ist also gültig. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder die zugrunde liegende Liste scheitert an den separat durchgeführten Wohlgeformtheits- oder Elementtyp-Prüfungen."@de ;
    era:additionalInfo "La propre description de platforms indique que l'ordre de cette liste est une information porteuse de sens, non accessoire : il est censé suivre la séquence physique réelle des quais à cet endroit, de sorte que les voisins dans la liste soient les mêmes que les voisins dans la réalité. Cette propriété n'a pas de minCount, un point d'exploitation sans quai enregistré est donc valide. Notez que le message affiché couvre trois causes possibles distinctes : plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la liste sous-jacente échoue aux vérifications de bonne formation ou de type d'élément effectuées séparément."@fr ;
    .

map-sh:infra-OperationalPoint-platforms-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes map-sh:PrefixDeclarations ;
    sh:message "era:platforms is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:message "era:platforms ist mit byIndex geordnet und muss daher eine wohlgeformte, terminierte rdf:List sein: jede Listenzelle benötigt genau ein rdf:first und genau ein rdf:rest."@de ;
    sh:message "era:platforms est ordonné par byIndex et doit donc être une rdf:List bien formée et terminée : chaque cellule de la liste nécessite exactement un rdf:first et exactement un rdf:rest."@fr ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:platforms ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

map-sh:infra-OperationalPoint-platforms-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:platforms"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node map-sh:infra-PlatformShape ;
        sh:message "platforms must be a well-formed Platform (blank node or IRI)."@en ;
        sh:message "platforms muss ein wohlgeformtes Platform sein (Blank Node oder IRI)."@de ;
        sh:message "platforms doit être un Platform bien formé (nœud vide ou IRI)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    .

### Balise ############################################################
map-sh:infra-BaliseShape
    a sh:NodeShape ;
    sh:targetClass era:Balise ;
    sh:name "Balise" ;
    sh:description "Defines a technical device on the railway trackbed" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-Balise-topologicalCoordinate ;
    sh:severity sh:Violation ;
    .

map-sh:infra-Balise-topologicalCoordinate
    a sh:PropertyShape ;
    sh:path era:topologicalCoordinate ;
    sh:name "topologicalCoordinate" ;
    sh:description "defines the location on Linear Element" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-TopologicalCoordinateShape ;
    sh:message "topologicalCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:message "topologicalCoordinate muss ein wohlgeformtes TopologicalCoordinate sein (Blank Node oder IRI)."@de ;
    sh:message "topologicalCoordinate doit être un TopologicalCoordinate bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "This is the topology-side definition of Balise, concerned only with its physical position - the ETCS-specific behavioural properties of a balise (such as its telegram content or direction qualifiers) are defined and checked separately, elsewhere in this data model. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested TopologicalCoordinate shape itself."@en ;
    era:additionalInfo "Dies ist die topologieseitige Definition von Balise, die sich nur mit ihrer physischen Position befasst - die ETCS-spezifischen Verhaltenseigenschaften einer Balise (etwa ihr Telegrammeinhalt oder Richtungsqualifizierer) werden separat an anderer Stelle in diesem Datenmodell definiert und geprüft. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte TopologicalCoordinate-Shape selbst nicht."@de ;
    era:additionalInfo "Il s'agit de la définition topologique de Balise, concernée uniquement par sa position physique - les propriétés comportementales spécifiques à l'ETCS d'une balise (comme le contenu de son télégramme ou ses qualificatifs de direction) sont définies et vérifiées séparément, ailleurs dans ce modèle de données. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape TopologicalCoordinate imbriquée elle-même."@fr ;
    .

### Derailer ##########################################################
map-sh:infra-DerailerShape
    a sh:NodeShape ;
    sh:targetClass era:Derailer ;
    sh:name "Derailer" ;
    sh:description "Defines the physical track asset Derailer" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-Derailer-netPointReference ;
    sh:property map-sh:infra-Derailer-reversalTime ;
    sh:property map-sh:infra-Derailer-derailToRight ;
    sh:property map-sh:infra-Derailer-name ;
    sh:severity sh:Violation ;
    .

map-sh:infra-Derailer-netPointReference
    a sh:PropertyShape ;
    sh:path era:netPointReference ;
    sh:name "netPointReference" ;
    sh:description "Defines position on LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-NetPointReferenceShape ;
    sh:message "netPointReference must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:message "netPointReference muss ein wohlgeformtes NetPointReference sein (Blank Node oder IRI)."@de ;
    sh:message "netPointReference doit être un NetPointReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "netPointReference locates this derailer on the network via a nested NetPointReference, which itself must contain a valid position (a TopologicalCoordinate: a LinearElement plus an offset) and may also carry a direction qualifier relative to that element's own orientation. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetPointReference shape itself."@en ;
    era:additionalInfo "netPointReference lokalisiert diese Gleissperre im Netz über eine verschachtelte NetPointReference, die selbst eine gültige Position enthalten muss (eine TopologicalCoordinate: ein LinearElement plus ein Offset) und zusätzlich einen Richtungsqualifizierer relativ zur eigenen Ausrichtung dieses Elements tragen kann. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetPointReference-Shape selbst nicht."@de ;
    era:additionalInfo "netPointReference localise ce dispositif de déraillement sur le réseau via une NetPointReference imbriquée, laquelle doit elle-même contenir une position valide (une TopologicalCoordinate : un LinearElement plus un décalage) et peut également porter un qualificatif de direction relatif à l'orientation propre de cet élément. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetPointReference imbriquée elle-même."@fr ;
    .

map-sh:infra-Derailer-reversalTime
    a sh:PropertyShape ;
    sh:path era:reversalTime ;
    sh:name "reversalTime" ;
    sh:description "Defines the time in seconds to switch from one position to the other" ;
    sh:order 3 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "reversalTime is stored with a scaling exponent of -1: the raw stored integer must be multiplied by 0.1 to get the actual physical value in seconds - a stored value of 50 means an actual reversal time of 5.0 seconds, not 50. This property is optional; its absence is not a violation. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "reversalTime wird mit einem Skalierungsexponenten von -1 gespeichert: der roh gespeicherte Ganzzahlwert muss mit 0,1 multipliziert werden, um den tatsächlichen physikalischen Wert in Sekunden zu erhalten - ein gespeicherter Wert von 50 bedeutet eine tatsächliche Umstellzeit von 5,0 Sekunden, nicht 50. Diese Eigenschaft ist optional; ihr Fehlen ist kein Verstoß. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "reversalTime est stocké avec un exposant d'échelle de -1 : l'entier brut stocké doit être multiplié par 0,1 pour obtenir la valeur physique réelle en secondes - une valeur stockée de 50 signifie un temps de retournement réel de 5,0 secondes, non 50. Cette propriété est optionnelle ; son absence n'est pas une violation. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

map-sh:infra-Derailer-derailToRight
    a sh:PropertyShape ;
    sh:path era:derailToRight ;
    sh:name "derailToRight" ;
    sh:description "Defines the side on which the derailer derails. If false = derailToLeft" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique."@fr ;
    .

map-sh:infra-Derailer-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label, only meant to be populated when a more human-readable name is wanted in addition to the derailer's own id - most derailers are not expected to need one. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id der Gleissperre ein besser lesbarer Name gewünscht wird - die meisten Gleissperren benötigen voraussichtlich keinen. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de l'id propre du dispositif de déraillement - la plupart des dispositifs de déraillement ne devraient pas en avoir besoin. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### TrainDetectionSystem ##############################################
map-sh:infra-TrainDetectionSystemShape
    a sh:NodeShape ;
    sh:targetClass era:TrainDetectionSystem ;
    sh:name "TrainDetectionSystem" ;
    sh:description "Safety system used to detect the presence of vehicles on the railway track." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-TrainDetectionSystem-topologicalCoordinate ;
    sh:property map-sh:infra-TrainDetectionSystem-trainDetectionSystemType ;
    sh:property map-sh:infra-TrainDetectionSystem-referenceDir ;
    sh:severity sh:Violation ;
    .

map-sh:infra-TrainDetectionSystem-topologicalCoordinate
    a sh:PropertyShape ;
    sh:path era:topologicalCoordinate ;
    sh:name "topologicalCoordinate" ;
    sh:description "defines the location on linear element" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-TopologicalCoordinateShape ;
    sh:message "topologicalCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:message "topologicalCoordinate muss ein wohlgeformtes TopologicalCoordinate sein (Blank Node oder IRI)."@de ;
    sh:message "topologicalCoordinate doit être un TopologicalCoordinate bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested TopologicalCoordinate shape itself."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte TopologicalCoordinate-Shape selbst nicht."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape TopologicalCoordinate imbriquée elle-même."@fr ;
    .

map-sh:infra-TrainDetectionSystem-trainDetectionSystemType
    a sh:PropertyShape ;
    sh:path era:trainDetectionSystemType ;
    sh:name "trainDetectionSystemType" ;
    sh:description "Defines the train detection system applicable for the TVPS" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-detection/20> <http://data.europa.eu/949/concepts/train-detection/10> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TrainDetectionSystems concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von TrainDetectionSystems entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de TrainDetectionSystems."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of the two defined concepts."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines der zwei definierten Konzepte."@de ;
    era:additionalInfo "Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun des deux concepts définis."@fr ;
    .

map-sh:infra-TrainDetectionSystem-referenceDir
    a sh:PropertyShape ;
    sh:path era:referenceDir ;
    sh:name "referenceDir" ;
    sh:description "Reference direction corresponding to linear element in which the train detector detects trains: same/opposite for axleCounter, both for trackCircuit" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/orientations/02> <http://data.europa.eu/949/concepts/orientations/00> <http://data.europa.eu/949/concepts/orientations/01> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OrientationDirections concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von OrientationDirections entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de OrientationDirections."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "referenceDir's own description ties its meaning directly to trainDetectionSystemType on this same object: an axle counter is expected to use same or opposite, since it detects direction, while a track circuit is expected to use both, since it cannot distinguish direction. This uses the same three orientation concepts (same, opposite, both) as appliesToDirection elsewhere in this data model. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these three defined concepts."@en ;
    era:additionalInfo "Die eigene Beschreibung von referenceDir verknüpft ihre Bedeutung direkt mit trainDetectionSystemType an demselben Objekt: ein Achszähler soll same oder opposite verwenden, da er die Richtung erkennt, während ein Gleisstromkreis both verwenden soll, da er die Richtung nicht unterscheiden kann. Dies verwendet dieselben drei Orientierungskonzepte (same, opposite, both) wie appliesToDirection an anderer Stelle in diesem Datenmodell. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser drei definierten Konzepte."@de ;
    era:additionalInfo "La propre description de referenceDir lie directement sa signification à trainDetectionSystemType sur ce même objet : un compteur d'essieux est censé utiliser same ou opposite, car il détecte la direction, tandis qu'un circuit de voie est censé utiliser both, car il ne peut pas distinguer la direction. Ceci utilise les trois mêmes concepts d'orientation (same, opposite, both) que appliesToDirection ailleurs dans ce modèle de données. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces trois concepts définis."@fr ;
    .

### BufferStop ########################################################
map-sh:infra-BufferStopShape
    a sh:NodeShape ;
    sh:targetClass era:BufferStop ;
    sh:name "BufferStop" ;
    sh:description "An infrastructure element installed at the end of a track to prevent rolling stock from moving beyond the track termination. It serves as the physical end point of the track and may provide energy absorption in the event of a train overrun." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-BufferStop-netPointReference ;
    sh:property map-sh:infra-BufferStop-name ;
    sh:severity sh:Violation ;
    .

map-sh:infra-BufferStop-netPointReference
    a sh:PropertyShape ;
    sh:path era:netPointReference ;
    sh:name "netPointReference" ;
    sh:description "Defines position corresponding to the buffers of the buffer stop on LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-NetPointReferenceShape ;
    sh:message "netPointReference must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:message "netPointReference muss ein wohlgeformtes NetPointReference sein (Blank Node oder IRI)."@de ;
    sh:message "netPointReference doit être un NetPointReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "netPointReference's own description clarifies that the position recorded here corresponds specifically to the buffers themselves, not some other point on the buffer stop structure. It locates the buffer stop on the network via a nested NetPointReference, which itself must contain a valid position (a TopologicalCoordinate: a LinearElement plus an offset) and may also carry a direction qualifier. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetPointReference shape itself."@en ;
    era:additionalInfo "Die eigene Beschreibung von netPointReference stellt klar, dass die hier erfasste Position speziell den Puffern selbst entspricht, nicht einem anderen Punkt der Prellbock-Struktur. Sie lokalisiert den Prellbock im Netz über eine verschachtelte NetPointReference, die selbst eine gültige Position enthalten muss (eine TopologicalCoordinate: ein LinearElement plus ein Offset) und zusätzlich einen Richtungsqualifizierer tragen kann. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetPointReference-Shape selbst nicht."@de ;
    era:additionalInfo "La propre description de netPointReference précise que la position enregistrée ici correspond spécifiquement aux tampons eux-mêmes, non à un autre point de la structure du heurtoir. Elle localise le heurtoir sur le réseau via une NetPointReference imbriquée, laquelle doit elle-même contenir une position valide (une TopologicalCoordinate : un LinearElement plus un décalage) et peut également porter un qualificatif de direction. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetPointReference imbriquée elle-même."@fr ;
    .

map-sh:infra-BufferStop-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this buffer stop, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diesen Prellbock, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour ce heurtoir, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

### NetRelation #######################################################
map-sh:infra-NetRelationShape
    a sh:NodeShape ;
    sh:targetClass era:NetRelation ;
    sh:name "NetRelation" ;
    sh:description "Defines a relation between two elements." ;
    rdfs:comment "sub-package: topology" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-NetRelation-elementA ;
    sh:property map-sh:infra-NetRelation-elementB ;
    sh:property map-sh:infra-NetRelation-isOnOriginOfElementA ;
    sh:property map-sh:infra-NetRelation-isOnOriginOfElementB ;
    sh:severity sh:Violation ;
    .

map-sh:infra-NetRelation-elementA
    a sh:PropertyShape ;
    sh:path era:elementA ;
    sh:name "elementA" ;
    sh:description "References the first linear element in an oriented relation." ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "elementA must reference an existing era:LinearElement by IRI."@en ;
    sh:message "elementA muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
    sh:message "elementA doit référencer un era:LinearElement existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a LinearElement. elementA identifies one of the two elements this relation joins, but on its own says nothing about which end of that element connects - that is specified separately by isOnOriginOfElementA."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als LinearElement typisiertes Objekt. elementA identifiziert eines der beiden Elemente, die diese Relation verbindet, sagt für sich genommen aber nichts darüber aus, welches Ende dieses Elements verbunden wird - dies wird separat über isOnOriginOfElementA festgelegt."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme LinearElement. elementA identifie l'un des deux éléments que cette relation relie, mais n'indique pas en soi quelle extrémité de cet élément est connectée - cela est précisé séparément par isOnOriginOfElementA."@fr ;
    .

map-sh:infra-NetRelation-elementB
    a sh:PropertyShape ;
    sh:path era:elementB ;
    sh:name "elementB" ;
    sh:description "References the second linear element in an oriented relation." ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "elementB must reference an existing era:LinearElement by IRI."@en ;
    sh:message "elementB muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
    sh:message "elementB doit référencer un era:LinearElement existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a LinearElement. elementB identifies the second of the two elements this relation joins, but on its own says nothing about which end of that element connects - that is specified separately by isOnOriginOfElementB."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als LinearElement typisiertes Objekt. elementB identifiziert das zweite der beiden Elemente, die diese Relation verbindet, sagt für sich genommen aber nichts darüber aus, welches Ende dieses Elements verbunden wird - dies wird separat über isOnOriginOfElementB festgelegt."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme LinearElement. elementB identifie le second des deux éléments que cette relation relie, mais n'indique pas en soi quelle extrémité de cet élément est connectée - cela est précisé séparément par isOnOriginOfElementB."@fr ;
    .

map-sh:infra-NetRelation-isOnOriginOfElementA
    a sh:PropertyShape ;
    sh:path era:isOnOriginOfElementA ;
    sh:name "isOnOriginOfElementA" ;
    sh:description "Determines if the position of the topological element A in a relation is the origin of element A." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean. This specifies which end of elementA the relation connects to: true means anchored at elementA's origin end, false means its other end. This property has no meaning on its own - it only makes sense read together with elementA."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert. Dies legt fest, an welchem Ende von elementA die Relation ansetzt: true bedeutet Verankerung am Ursprungsende von elementA, false am anderen Ende. Diese Eigenschaft hat für sich genommen keine Bedeutung - sie ergibt nur zusammen mit elementA Sinn."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique. Ceci précise à quelle extrémité de elementA la relation se rattache : true signifie un ancrage à l'extrémité d'origine de elementA, false à son autre extrémité. Cette propriété n'a pas de sens en elle-même - elle n'en prend qu'associée à elementA."@fr ;
    .

map-sh:infra-NetRelation-isOnOriginOfElementB
    a sh:PropertyShape ;
    sh:path era:isOnOriginOfElementB ;
    sh:name "isOnOriginOfElementB" ;
    sh:description "Determines if the position of the topological element B in a relation is the origin of element B." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean. This specifies which end of elementB the relation connects to: true means anchored at elementB's origin end, false means its other end. This property has no meaning on its own - it only makes sense read together with elementB."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert. Dies legt fest, an welchem Ende von elementB die Relation ansetzt: true bedeutet Verankerung am Ursprungsende von elementB, false am anderen Ende. Diese Eigenschaft hat für sich genommen keine Bedeutung - sie ergibt nur zusammen mit elementB Sinn."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique. Ceci précise à quelle extrémité de elementB la relation se rattache : true signifie un ancrage à l'extrémité d'origine de elementB, false à son autre extrémité. Cette propriété n'a pas de sens en elle-même - elle n'en prend qu'associée à elementB."@fr ;
    .

### NetPointReference #################################################
map-sh:infra-NetPointReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetPointReference ;
    sh:name "NetPointReference" ;
    sh:description "Represents a point reference in the network." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property map-sh:infra-NetPointReference-hasTopoCoordinate ;
    sh:property map-sh:infra-NetPointReference-appliesToDirection ;
    sh:severity sh:Violation ;
    .

map-sh:infra-NetPointReference-hasTopoCoordinate
    a sh:PropertyShape ;
    sh:path era:hasTopoCoordinate ;
    sh:name "hasTopoCoordinate" ;
    sh:description "Defines the topological coordinate of a network point reference" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-TopologicalCoordinateShape ;
    sh:message "hasTopoCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:message "hasTopoCoordinate muss ein wohlgeformtes TopologicalCoordinate sein (Blank Node oder IRI)."@de ;
    sh:message "hasTopoCoordinate doit être un TopologicalCoordinate bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

map-sh:infra-NetPointReference-appliesToDirection
    a sh:PropertyShape ;
    sh:path era:appliesToDirection ;
    sh:name "appliesToDirection" ;
    sh:description "The direction relative to the origin of the linear element towards the point reference applies" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/orientations/02> <http://data.europa.eu/949/concepts/orientations/00> <http://data.europa.eu/949/concepts/orientations/01> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OrientationDirections concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von OrientationDirections entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de OrientationDirections."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "same, opposite, and both describe direction relative to the linear element's own origin-to-far-end orientation, not an absolute or geographic direction - 'same' means the point reference applies in the direction the element itself runs, 'opposite' means against it, and 'both' means regardless of direction. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of the three defined concepts."@en ;
    era:additionalInfo "same, opposite und both beschreiben eine Richtung relativ zur eigenen Ausrichtung des linearen Elements vom Ursprung zum fernen Ende, nicht eine absolute oder geografische Richtung - 'same' bedeutet, dass die Punktreferenz in der Richtung gilt, in der das Element selbst verläuft, 'opposite' bedeutet dagegen, und 'both' bedeutet unabhängig von der Richtung. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines der drei definierten Konzepte."@de ;
    era:additionalInfo "same, opposite et both décrivent une direction relative à l'orientation propre de l'élément linéaire, de son origine vers son extrémité éloignée, non une direction absolue ou géographique - 'same' signifie que la référence de point s'applique dans le sens où l'élément lui-même s'oriente, 'opposite' signifie dans le sens contraire, et 'both' signifie indépendamment de la direction. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun des trois concepts définis."@fr ;
    .

### StopTrainLimit ####################################################
map-sh:infra-StopTrainLimitShape
    a sh:NodeShape ;
    sh:targetClass era:StopTrainLimit ;
    sh:name "StopTrainLimit" ;
    sh:description "Defines the different stop limits for train on the track" ;
    sh:property map-sh:infra-StopTrainLimit-trainMaxLength ;
    sh:property map-sh:infra-StopTrainLimit-trainMaxAxles ;
    sh:property map-sh:infra-StopTrainLimit-trainMaxWagons ;
    sh:property map-sh:infra-StopTrainLimit-trainMaxSize ;
    sh:severity sh:Violation ;
    .

map-sh:infra-StopTrainLimit-trainMaxLength
    a sh:PropertyShape ;
    sh:path era:trainMaxLength ;
    sh:name "trainMaxLength" ;
    sh:description "Defines the maximum train length associated with stop train limit. use zero if not defined" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "trainMaxLength's own description states that zero should be used specifically to mean 'not defined' - it is a sentinel value, not a literal claim that trains of zero length are permitted. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von trainMaxLength besagt, dass null speziell verwendet werden soll, um 'nicht definiert' zu bedeuten - es handelt sich um einen Platzhalterwert, nicht um die wörtliche Aussage, dass Züge mit der Länge null zulässig sind. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "La propre description de trainMaxLength indique que zéro doit être utilisé spécifiquement pour signifier « non défini » - il s'agit d'une valeur sentinelle, non d'une affirmation littérale que des trains de longueur nulle sont autorisés. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

map-sh:infra-StopTrainLimit-trainMaxAxles
    a sh:PropertyShape ;
    sh:path era:trainMaxAxles ;
    sh:name "trainMaxAxles" ;
    sh:description "Defines the maximum train axles associated with stop train limit. use zero if not defined" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "trainMaxAxles's own description states that zero should be used specifically to mean 'not defined' - it is a sentinel value, not a literal claim that trains with zero axles are permitted. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von trainMaxAxles besagt, dass null speziell verwendet werden soll, um 'nicht definiert' zu bedeuten - es handelt sich um einen Platzhalterwert, nicht um die wörtliche Aussage, dass Züge mit null Achsen zulässig sind. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "La propre description de trainMaxAxles indique que zéro doit être utilisé spécifiquement pour signifier « non défini » - il s'agit d'une valeur sentinelle, non d'une affirmation littérale que des trains avec zéro essieu sont autorisés. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

map-sh:infra-StopTrainLimit-trainMaxWagons
    a sh:PropertyShape ;
    sh:path era:trainMaxWagons ;
    sh:name "trainMaxWagons" ;
    sh:description "Defines the maximum train wagons associated with stope train limit. including Locomotives, use zero if not defined" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "trainMaxWagons's own description states that locomotives are included in this count, and that zero should be used specifically to mean 'not defined' - a sentinel value, not a literal claim that trains with zero wagons are permitted. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von trainMaxWagons besagt, dass Lokomotiven in diese Zählung einbezogen sind, und dass null speziell verwendet werden soll, um 'nicht definiert' zu bedeuten - ein Platzhalterwert, nicht die wörtliche Aussage, dass Züge mit null Wagen zulässig sind. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "La propre description de trainMaxWagons indique que les locomotives sont incluses dans ce décompte, et que zéro doit être utilisé spécifiquement pour signifier « non défini » - une valeur sentinelle, non une affirmation littérale que des trains avec zéro wagon sont autorisés. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

map-sh:infra-StopTrainLimit-trainMaxSize
    a sh:PropertyShape ;
    sh:path era:trainMaxSize ;
    sh:name "trainMaxSize" ;
    sh:description "Defines the size of train applicable for this stop train limit. use undefinedTrainSize if not defined" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-size/undefinedTrainSize> <http://data.europa.eu/949/concepts/train-size/shortTrain> <http://data.europa.eu/949/concepts/train-size/halfTrain> <http://data.europa.eu/949/concepts/train-size/fullTrain> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TrainSize concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von TrainSize entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de TrainSize."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "The four defined values are: undefinedTrainSize, shortTrain, halfTrain, fullTrain. Its own description states that undefinedTrainSize should be used specifically to mean the value is not defined - the same sentinel pattern used by zero on the other StopTrainLimit properties, expressed here through a dedicated concept instead. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these four defined concepts."@en ;
    era:additionalInfo "Die vier definierten Werte sind: undefinedTrainSize, shortTrain, halfTrain, fullTrain. Die eigene Beschreibung besagt, dass undefinedTrainSize speziell verwendet werden soll, um auszudrücken, dass der Wert nicht definiert ist - dasselbe Platzhaltermuster, das bei den anderen StopTrainLimit-Eigenschaften durch null ausgedrückt wird, hier jedoch über ein eigenes Konzept. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser vier definierten Konzepte."@de ;
    era:additionalInfo "Les quatre valeurs définies sont : undefinedTrainSize, shortTrain, halfTrain, fullTrain. Sa propre description indique que undefinedTrainSize doit être utilisé spécifiquement pour signifier que la valeur n'est pas définie - le même schéma de valeur sentinelle qu'exprime zéro sur les autres propriétés de StopTrainLimit, exprimé ici via un concept dédié. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces quatre concepts définis."@fr ;
    .

### TopologicalCoordinate #############################################
map-sh:infra-TopologicalCoordinateShape
    a sh:NodeShape ;
    sh:targetClass era:TopologicalCoordinate ;
    sh:name "TopologicalCoordinate" ;
    sh:description "Defines a topological coordinate on the track" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property map-sh:infra-TopologicalCoordinate-onLinearElement ;
    sh:property map-sh:infra-TopologicalCoordinate-offsetFromOrigin ;
    sh:severity sh:Violation ;
    .

map-sh:infra-TopologicalCoordinate-onLinearElement
    a sh:PropertyShape ;
    sh:path era:onLinearElement ;
    sh:name "onLinearElement" ;
    sh:description "is positioned on linear element" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "onLinearElement must reference an existing era:LinearElement by IRI."@en ;
    sh:message "onLinearElement muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
    sh:message "onLinearElement doit référencer un era:LinearElement existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "onLinearElement anchors this coordinate to a specific LinearElement; offsetFromOrigin (the sibling property) is measured from that same element's origin. TopologicalCoordinate has no identity of its own - it is deliberately designed as a simple, non-referenceable container, always embedded directly inside whichever object needs a position (a Balise, a DangerPoint, one of a Crossing's two coordinates, and others), so a violation here is reported against that parent object, not against any TopologicalCoordinate itself. This same shape is reused wherever any object embeds a position this way, so a violation on this exact message can originate from many different kinds of parent objects, not just one. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a LinearElement."@en ;
    era:additionalInfo "onLinearElement verankert diese Koordinate an einem bestimmten LinearElement; offsetFromOrigin (die Schwestereigenschaft) wird vom Ursprung desselben Elements aus gemessen. TopologicalCoordinate besitzt keine eigene Identität - sie ist bewusst als einfacher, nicht referenzierbarer Container konzipiert, der stets direkt in dasjenige Objekt eingebettet ist, das eine Position benötigt (eine Balise, ein DangerPoint, eine der beiden Koordinaten einer Crossing, und andere), sodass ein Verstoß hier gegen dieses übergeordnete Objekt gemeldet wird, nicht gegen eine TopologicalCoordinate selbst. Diese Shape wird überall dort wiederverwendet, wo ein Objekt auf diese Weise eine Position einbettet, sodass ein Verstoß bei genau dieser Meldung von vielen verschiedenen Arten übergeordneter Objekte stammen kann, nicht nur von einer. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als LinearElement typisiertes Objekt."@de ;
    era:additionalInfo "onLinearElement ancre cette coordonnée à un LinearElement précis ; offsetFromOrigin (la propriété sœur) est mesuré depuis l'origine de ce même élément. TopologicalCoordinate n'a pas d'identité propre - elle est délibérément conçue comme un simple conteneur non référençable, toujours intégré directement dans l'objet qui a besoin d'une position (une Balise, un DangerPoint, l'une des deux coordonnées d'un Crossing, et d'autres), la violation est donc signalée sur cet objet parent, non sur une TopologicalCoordinate elle-même. Cette shape est réutilisée partout où un objet intègre une position de cette manière, si bien qu'une violation sur exactement ce message peut provenir de nombreux types d'objets parents différents, pas d'un seul. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme LinearElement."@fr ;
    .

map-sh:infra-TopologicalCoordinate-offsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:offsetFromOrigin ;
    sh:name "offsetFromOrigin" ;
    sh:description "position on the associated NetElement" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "offsetFromOrigin is the distance, in metres, from the origin of the LinearElement named in the sibling onLinearElement property, to this specific point. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number. This check does not require the value to stay within the bounds of the element's own length."@en ;
    era:additionalInfo "offsetFromOrigin ist die Distanz in Metern vom Ursprung des in der Schwestereigenschaft onLinearElement genannten LinearElement bis zu diesem konkreten Punkt. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der Wert ist vorhanden, aber keine gültige Zahl. Diese Prüfung verlangt nicht, dass der Wert innerhalb der Grenzen der eigenen Länge des Elements bleibt."@de ;
    era:additionalInfo "offsetFromOrigin est la distance, en mètres, depuis l'origine du LinearElement nommé dans la propriété sœur onLinearElement, jusqu'à ce point précis. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur est présente mais n'est pas un nombre valide. Cette vérification n'exige pas que la valeur reste dans les limites de la longueur propre de l'élément."@fr ;
    .

### TPActiveObject ####################################################
map-sh:infra-TPActiveObjectShape
    a sh:NodeShape ;
    sh:targetClass era:TPActiveObject ;
    sh:name "TPActiveObject" ;
    sh:description "Defines a functional object infront of which a TimingPoint is located and active" ;
    sh:xone (
        map-sh:infra-TPActiveObject-etcsMarker-present
        map-sh:infra-TPActiveObject-stopLocation-present
        map-sh:infra-TPActiveObject-timeMeasurePoint-present
    ) ;
    sh:message "TPActiveObject is a union: exactly one of (etcsMarker, stopLocation, timeMeasurePoint) must be present."@en ;
    sh:message "TPActiveObject ist eine Union: genau eines von (etcsMarker, stopLocation, timeMeasurePoint) muss vorhanden sein."@de ;
    sh:message "TPActiveObject est une union : exactement l'un de (etcsMarker, stopLocation, timeMeasurePoint) doit être présent."@fr ;
    sh:property map-sh:infra-TPActiveObject-etcsMarker ;
    sh:property map-sh:infra-TPActiveObject-stopLocation ;
    sh:property map-sh:infra-TPActiveObject-timeMeasurePoint ;
    sh:severity sh:Violation ;
    .

map-sh:infra-TPActiveObject-etcsMarker
    a sh:PropertyShape ;
    sh:path era:etcsMarker ;
    sh:name "etcsMarker" ;
    sh:description "refers to ETCS marker" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:ETCSMarker ;
    sh:message "etcsMarker must reference an existing era:ETCSMarker by IRI."@en ;
    sh:message "etcsMarker muss über eine IRI auf ein bestehendes era:ETCSMarker verweisen."@de ;
    sh:message "etcsMarker doit référencer un era:ETCSMarker existant par IRI."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "TPActiveObject is a union of three alternatives - exactly one is expected to be present, never more than one and never none. This property has no minCount, so its own absence alone is not a problem; the union check elsewhere is what actually requires one of the three to exist. Note that the message shown is shared across three different possible causes: more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as an ETCSMarker."@en ;
    era:additionalInfo "TPActiveObject ist eine Union aus drei Alternativen - genau eine soll vorhanden sein, nie mehr als eine und nie keine. Diese Eigenschaft hat kein minCount, ihr eigenes Fehlen ist also für sich kein Problem; die an anderer Stelle durchgeführte Union-Prüfung verlangt tatsächlich, dass eine der drei existiert. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als ETCSMarker typisiertes Objekt."@de ;
    era:additionalInfo "TPActiveObject est une union de trois alternatives - exactement une doit être présente, jamais plus d'une et jamais aucune. Cette propriété n'a pas de minCount, son absence seule n'est donc pas un problème ; la vérification d'union effectuée ailleurs exige effectivement qu'une des trois existe. Notez que le message affiché couvre trois causes possibles distinctes : plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme ETCSMarker."@fr ;
    .

map-sh:infra-TPActiveObject-stopLocation
    a sh:PropertyShape ;
    sh:path era:stopLocation ;
    sh:name "stopLocation" ;
    sh:description "refers to stop location" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:StopLocation ;
    sh:message "stopLocation must reference an existing era:StopLocation by IRI."@en ;
    sh:message "stopLocation muss über eine IRI auf ein bestehendes era:StopLocation verweisen."@de ;
    sh:message "stopLocation doit référencer un era:StopLocation existant par IRI."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "TPActiveObject is a union of three alternatives - exactly one is expected to be present, never more than one and never none. This property has no minCount, so its own absence alone is not a problem; the union check elsewhere is what actually requires one of the three to exist. Note that the message shown is shared across three different possible causes: more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a StopLocation."@en ;
    era:additionalInfo "TPActiveObject ist eine Union aus drei Alternativen - genau eine soll vorhanden sein, nie mehr als eine und nie keine. Diese Eigenschaft hat kein minCount, ihr eigenes Fehlen ist also für sich kein Problem; die an anderer Stelle durchgeführte Union-Prüfung verlangt tatsächlich, dass eine der drei existiert. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als StopLocation typisiertes Objekt."@de ;
    era:additionalInfo "TPActiveObject est une union de trois alternatives - exactement une doit être présente, jamais plus d'une et jamais aucune. Cette propriété n'a pas de minCount, son absence seule n'est donc pas un problème ; la vérification d'union effectuée ailleurs exige effectivement qu'une des trois existe. Notez que le message affiché couvre trois causes possibles distinctes : plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme StopLocation."@fr ;
    .

map-sh:infra-TPActiveObject-timeMeasurePoint
    a sh:PropertyShape ;
    sh:path era:timeMeasurePoint ;
    sh:name "timeMeasurePoint" ;
    sh:description "refers to travel time measurement point" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TravelTimeMeasurementPoint ;
    sh:message "timeMeasurePoint must reference an existing era:TravelTimeMeasurementPoint by IRI."@en ;
    sh:message "timeMeasurePoint muss über eine IRI auf ein bestehendes era:TravelTimeMeasurementPoint verweisen."@de ;
    sh:message "timeMeasurePoint doit référencer un era:TravelTimeMeasurementPoint existant par IRI."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "TPActiveObject is a union of three alternatives - exactly one is expected to be present, never more than one and never none. This property has no minCount, so its own absence alone is not a problem; the union check elsewhere is what actually requires one of the three to exist. Note that the message shown is shared across three different possible causes: more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a TravelTimeMeasurementPoint."@en ;
    era:additionalInfo "TPActiveObject ist eine Union aus drei Alternativen - genau eine soll vorhanden sein, nie mehr als eine und nie keine. Diese Eigenschaft hat kein minCount, ihr eigenes Fehlen ist also für sich kein Problem; die an anderer Stelle durchgeführte Union-Prüfung verlangt tatsächlich, dass eine der drei existiert. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als TravelTimeMeasurementPoint typisiertes Objekt."@de ;
    era:additionalInfo "TPActiveObject est une union de trois alternatives - exactement une doit être présente, jamais plus d'une et jamais aucune. Cette propriété n'a pas de minCount, son absence seule n'est donc pas un problème ; la vérification d'union effectuée ailleurs exige effectivement qu'une des trois existe. Notez que le message affiché couvre trois causes possibles distinctes : plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme TravelTimeMeasurementPoint."@fr ;
    .

map-sh:infra-TPActiveObject-etcsMarker-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:etcsMarker is present"@en ;
    sh:property map-sh:infra-TPActiveObject-etcsMarker-required ;
    .

map-sh:infra-TPActiveObject-etcsMarker-required
    a sh:PropertyShape ;
    sh:path era:etcsMarker ;
    sh:minCount 1 ;
    .

map-sh:infra-TPActiveObject-stopLocation-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:stopLocation is present"@en ;
    sh:property map-sh:infra-TPActiveObject-stopLocation-required ;
    .

map-sh:infra-TPActiveObject-stopLocation-required
    a sh:PropertyShape ;
    sh:path era:stopLocation ;
    sh:minCount 1 ;
    .

map-sh:infra-TPActiveObject-timeMeasurePoint-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:timeMeasurePoint is present"@en ;
    sh:property map-sh:infra-TPActiveObject-timeMeasurePoint-required ;
    .

map-sh:infra-TPActiveObject-timeMeasurePoint-required
    a sh:PropertyShape ;
    sh:path era:timeMeasurePoint ;
    sh:minCount 1 ;
    .

### TravelTimeMeasurementPoint ########################################
map-sh:infra-TravelTimeMeasurementPointShape
    a sh:NodeShape ;
    sh:targetClass era:TravelTimeMeasurementPoint ;
    sh:name "TravelTimeMeasurementPoint" ;
    sh:description "a preciselydefined location within an OperationalPoint where the actual passing time of a train is measured or recorded. It provides a topological reference used for running-time calculation, performance monitoring, and comparison with planned timetable data." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-TravelTimeMeasurementPoint-topologicalCoordinate ;
    sh:severity sh:Violation ;
    .

map-sh:infra-TravelTimeMeasurementPoint-topologicalCoordinate
    a sh:PropertyShape ;
    sh:path era:topologicalCoordinate ;
    sh:name "topologicalCoordinate" ;
    sh:description "defines the location on linear element" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-TopologicalCoordinateShape ;
    sh:message "topologicalCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:message "topologicalCoordinate muss ein wohlgeformtes TopologicalCoordinate sein (Blank Node oder IRI)."@de ;
    sh:message "topologicalCoordinate doit être un TopologicalCoordinate bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested TopologicalCoordinate shape itself."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte TopologicalCoordinate-Shape selbst nicht."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape TopologicalCoordinate imbriquée elle-même."@fr ;
    .

### Platform ##########################################################
map-sh:infra-PlatformShape
    a sh:NodeShape ;
    sh:targetClass era:Platform ;
    sh:name "Platform" ;
    sh:description "Defines the object platform" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:infra-Platform-name ;
    sh:property map-sh:infra-Platform-platformEdges ;
    sh:severity sh:Violation ;
    .

map-sh:infra-Platform-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this platform, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diesen Bahnsteig, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour ce quai, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

map-sh:infra-Platform-platformEdges
    a sh:PropertyShape ;
    sh:path era:platformEdges ;
    sh:name "platformEdges" ;
    sh:description "composes of platform edges" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-PlatformEdgeShape ;
    sh:message "platformEdges must be a well-formed PlatformEdge (blank node or IRI)."@en ;
    sh:message "platformEdges muss ein wohlgeformtes PlatformEdge sein (Blank Node oder IRI)."@de ;
    sh:message "platformEdges doit être un PlatformEdge bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "This property has no maxCount, so a platform composed of several platform edges is valid. Note that the message shown is shared across three different possible causes: the value is missing entirely, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested PlatformEdge shape itself."@en ;
    era:additionalInfo "Diese Eigenschaft hat kein maxCount, ein aus mehreren Bahnsteigkanten zusammengesetzter Bahnsteig ist also gültig. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte PlatformEdge-Shape selbst nicht."@de ;
    era:additionalInfo "Cette propriété n'a pas de maxCount, un quai composé de plusieurs bords de quai est donc valide. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape PlatformEdge imbriquée elle-même."@fr ;
    .

### PlatformEdge ######################################################
map-sh:infra-PlatformEdgeShape
    a sh:NodeShape ;
    sh:targetClass era:PlatformEdge ;
    sh:name "PlatformEdge" ;
    sh:description "Platform for the purpose of RINF is understood as a platform edge. A platform concerns only the part of the structure neighbouring to the track (interfaced with trains)." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property map-sh:infra-PlatformEdge-platformId ;
    sh:property map-sh:infra-PlatformEdge-name ;
    sh:property map-sh:infra-PlatformEdge-linearReference ;
    sh:property map-sh:infra-PlatformEdge-stopLocations ;
    sh:property map-sh:infra-PlatformEdge-platformHeight ;
    sh:severity sh:Violation ;
    .

map-sh:infra-PlatformEdge-platformId
    a sh:PropertyShape ;
    sh:path era:platformId ;
    sh:name "platformId" ;
    sh:description "Unique platform edge identification or unique platform edge number within an Operational Point." ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "platformId's own description states this only needs to be unique within a single Operational Point, not globally across the whole network. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "Die eigene Beschreibung von platformId besagt, dass sie nur innerhalb eines einzelnen Betriebspunkts eindeutig sein muss, nicht global im gesamten Netz. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "La propre description de platformId indique qu'elle ne doit être unique qu'au sein d'un seul point d'exploitation, non globalement sur l'ensemble du réseau. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

map-sh:infra-PlatformEdge-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this platform edge, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diese Bahnsteigkante, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour ce quai, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

map-sh:infra-PlatformEdge-linearReference
    a sh:PropertyShape ;
    sh:path era:linearReference ;
    sh:name "linearReference" ;
    sh:description "composes of linked path" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-NetLinearReferenceShape ;
    sh:message "linearReference must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:message "linearReference muss ein wohlgeformtes NetLinearReference sein (Blank Node oder IRI)."@de ;
    sh:message "linearReference doit être un NetLinearReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetLinearReference shape itself."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetLinearReference-Shape selbst nicht."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetLinearReference imbriquée elle-même."@fr ;
    .

map-sh:infra-PlatformEdge-stopLocations
    a sh:PropertyShape ;
    sh:path era:stopLocations ;
    sh:name "stopLocations" ;
    sh:description "Defines the stop locations. Add only, if stopLocation can be used on that PlatformEdge for passenger/freight exchange" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:class era:StopLocation ;
    sh:message "stopLocations must reference an existing era:StopLocation by IRI."@en ;
    sh:message "stopLocations muss über eine IRI auf ein bestehendes era:StopLocation verweisen."@de ;
    sh:message "stopLocations doit référencer un era:StopLocation existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "stopLocations's own description states this should only be populated when the given stop location can actually be used on this specific platform edge for passenger or freight exchange - not simply every stop location that happens to exist nearby. Note that the message shown is shared across three different possible causes: the value is missing entirely, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a StopLocation."@en ;
    era:additionalInfo "Die eigene Beschreibung von stopLocations besagt, dass sie nur ausgefüllt werden soll, wenn die angegebene Haltestelle an dieser konkreten Bahnsteigkante tatsächlich für den Fahrgast- oder Güteraustausch genutzt werden kann - nicht einfach jede Haltestelle, die zufällig in der Nähe existiert. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als StopLocation typisiertes Objekt."@de ;
    era:additionalInfo "La propre description de stopLocations indique qu'elle ne doit être renseignée que lorsque l'emplacement d'arrêt donné peut effectivement être utilisé sur ce quai spécifique pour l'échange de voyageurs ou de fret - non simplement chaque emplacement d'arrêt existant à proximité. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme StopLocation."@fr ;
    .

map-sh:infra-PlatformEdge-platformHeight
    a sh:PropertyShape ;
    sh:path era:platformHeight ;
    sh:name "platformHeight" ;
    sh:description "Distance between the upper surface of platform and running surface of the neighbouring track. It is the nominal value expressed in millimetres." ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/platform-heights/50> <http://data.europa.eu/949/concepts/platform-heights/60> <http://data.europa.eu/949/concepts/platform-heights/220> <http://data.europa.eu/949/concepts/platform-heights/10> <http://data.europa.eu/949/concepts/platform-heights/20> <http://data.europa.eu/949/concepts/platform-heights/300> <http://data.europa.eu/949/concepts/platform-heights/350> <http://data.europa.eu/949/concepts/platform-heights/380> <http://data.europa.eu/949/concepts/platform-heights/30> <http://data.europa.eu/949/concepts/platform-heights/70> <http://data.europa.eu/949/concepts/platform-heights/80> <http://data.europa.eu/949/concepts/platform-heights/90> <http://data.europa.eu/949/concepts/platform-heights/100> <http://data.europa.eu/949/concepts/platform-heights/40> <http://data.europa.eu/949/concepts/platform-heights/110> <http://data.europa.eu/949/concepts/platform-heights/120> <http://data.europa.eu/949/concepts/platform-heights/130> <http://data.europa.eu/949/concepts/platform-heights/140> <http://data.europa.eu/949/concepts/platform-heights/150> <http://data.europa.eu/949/concepts/platform-heights/160> ) ;
    sh:message "Value must be one of the CCSTMS-scoped PlatformHeights concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von PlatformHeights entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de PlatformHeights."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Unlike some other enumerations in this data model where the numeric codes in the concept IRIs are arbitrary, here the description states the height is genuinely expressed in millimetres, and the twenty defined values correspond directly to that: 50, 60, 220, 10, 20, 300, 350, 380, 30, 70, 80, 90, 100, 40, 110, 120, 130, 140, 150, 160. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these twenty defined concepts."@en ;
    era:additionalInfo "Anders als bei manchen anderen Aufzählungen in diesem Datenmodell, bei denen die numerischen Codes in den Konzept-IRIs willkürlich sind, besagt die Beschreibung hier, dass die Höhe tatsächlich in Millimetern ausgedrückt wird, und die zwanzig definierten Werte entsprechen direkt dem: 50, 60, 220, 10, 20, 300, 350, 380, 30, 70, 80, 90, 100, 40, 110, 120, 130, 140, 150, 160. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser zwanzig definierten Konzepte."@de ;
    era:additionalInfo "Contrairement à certaines autres énumérations de ce modèle de données où les codes numériques des IRI de concept sont arbitraires, la description indique ici que la hauteur est réellement exprimée en millimètres, et les vingt valeurs définies y correspondent directement : 50, 60, 220, 10, 20, 300, 350, 380, 30, 70, 80, 90, 100, 40, 110, 120, 130, 140, 150, 160. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces vingt concepts définis."@fr ;
    .

### NetLinearReference ################################################
map-sh:infra-NetLinearReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetLinearReference ;
    sh:name "NetLinearReference" ;
    sh:description "Defines a linked path on the topology" ;
    sh:sparql map-sh:infra-NetLinearReference-hasSequence-listWellFormed ;
    sh:property map-sh:infra-NetLinearReference-startsAt ;
    sh:property map-sh:infra-NetLinearReference-endsAt ;
    sh:property map-sh:infra-NetLinearReference-hasSequence ;
    sh:severity sh:Violation ;
    .

map-sh:infra-NetLinearReference-startsAt
    a sh:PropertyShape ;
    sh:path era:startsAt ;
    sh:name "startsAt" ;
    sh:description "Definesthe starting point of a linear reference" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-NetPointReferenceShape ;
    sh:message "startsAt must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:message "startsAt muss ein wohlgeformtes NetPointReference sein (Blank Node oder IRI)."@de ;
    sh:message "startsAt doit être un NetPointReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "startsAt marks the beginning of this linked path via a nested NetPointReference, which itself must contain a valid position (a LinearElement plus an offset) and may carry a direction qualifier. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetPointReference shape itself. A common way the last cause occurs is that the value points directly at a TopologicalCoordinate instead of at a NetPointReference that wraps one - NetPointReference requires its own hasTopoCoordinate property pointing to the coordinate; a TopologicalCoordinate used directly here will have onLinearElement and offsetFromOrigin but no hasTopoCoordinate property, and will fail this check even though it is a perfectly valid TopologicalCoordinate in its own right."@en ;
    era:additionalInfo "startsAt markiert den Anfang dieses verbundenen Pfades über eine verschachtelte NetPointReference, die selbst eine gültige Position enthalten muss (ein LinearElement plus ein Offset) und zusätzlich einen Richtungsqualifizierer tragen kann. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetPointReference-Shape selbst nicht. Eine häufige Ursache für den letzten Fall ist, dass der Wert direkt auf eine TopologicalCoordinate verweist, statt auf eine NetPointReference, die eine solche umschließt - NetPointReference verlangt eine eigene hasTopoCoordinate-Eigenschaft, die auf die Koordinate verweist; eine direkt hier verwendete TopologicalCoordinate besitzt onLinearElement und offsetFromOrigin, aber keine hasTopoCoordinate-Eigenschaft, und scheitert an dieser Prüfung, obwohl sie als TopologicalCoordinate für sich genommen vollkommen gültig ist."@de ;
    era:additionalInfo "startsAt marque le début de ce chemin lié via une NetPointReference imbriquée, laquelle doit elle-même contenir une position valide (un LinearElement plus un décalage) et peut porter un qualificatif de direction. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetPointReference imbriquée elle-même. Une cause fréquente de ce dernier cas est que la valeur pointe directement vers une TopologicalCoordinate au lieu d'une NetPointReference qui en englobe une - NetPointReference exige sa propre propriété hasTopoCoordinate pointant vers la coordonnée ; une TopologicalCoordinate utilisée directement ici possédera onLinearElement et offsetFromOrigin mais aucune propriété hasTopoCoordinate, et échouera à cette vérification bien qu'elle soit parfaitement valide en tant que TopologicalCoordinate."@fr ;
    .

map-sh:infra-NetLinearReference-endsAt
    a sh:PropertyShape ;
    sh:path era:endsAt ;
    sh:name "endsAt" ;
    sh:description "Specifies the ending point of a linear reference" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:infra-NetPointReferenceShape ;
    sh:message "endsAt must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:message "endsAt muss ein wohlgeformtes NetPointReference sein (Blank Node oder IRI)."@de ;
    sh:message "endsAt doit être un NetPointReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "endsAt marks the end of this linked path via a nested NetPointReference, which itself must contain a valid position (a LinearElement plus an offset) and may carry a direction qualifier. Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetPointReference shape itself. A common way the last cause occurs is that the value points directly at a TopologicalCoordinate instead of at a NetPointReference that wraps one - NetPointReference requires its own hasTopoCoordinate property pointing to the coordinate; a TopologicalCoordinate used directly here will have onLinearElement and offsetFromOrigin but no hasTopoCoordinate property, and will fail this check even though it is a perfectly valid TopologicalCoordinate in its own right."@en ;
    era:additionalInfo "endsAt markiert das Ende dieses verbundenen Pfades über eine verschachtelte NetPointReference, die selbst eine gültige Position enthalten muss (ein LinearElement plus ein Offset) und zusätzlich einen Richtungsqualifizierer tragen kann. Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetPointReference-Shape selbst nicht. Eine häufige Ursache für den letzten Fall ist, dass der Wert direkt auf eine TopologicalCoordinate verweist, statt auf eine NetPointReference, die eine solche umschließt - NetPointReference verlangt eine eigene hasTopoCoordinate-Eigenschaft, die auf die Koordinate verweist; eine direkt hier verwendete TopologicalCoordinate besitzt onLinearElement und offsetFromOrigin, aber keine hasTopoCoordinate-Eigenschaft, und scheitert an dieser Prüfung, obwohl sie als TopologicalCoordinate für sich genommen vollkommen gültig ist."@de ;
    era:additionalInfo "endsAt marque la fin de ce chemin lié via une NetPointReference imbriquée, laquelle doit elle-même contenir une position valide (un LinearElement plus un décalage) et peut porter un qualificatif de direction. Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetPointReference imbriquée elle-même. Une cause fréquente de ce dernier cas est que la valeur pointe directement vers une TopologicalCoordinate au lieu d'une NetPointReference qui en englobe une - NetPointReference exige sa propre propriété hasTopoCoordinate pointant vers la coordonnée ; une TopologicalCoordinate utilisée directement ici possédera onLinearElement et offsetFromOrigin mais aucune propriété hasTopoCoordinate, et échouera à cette vérification bien qu'elle soit parfaitement valide en tant que TopologicalCoordinate."@fr ;
    .

map-sh:infra-NetLinearReference-hasSequence
    a sh:PropertyShape ;
    sh:path era:hasSequence ;
    sh:name "hasSequence" ;
    sh:description "The ordered sequence of topological linear elements which create a linear net reference." ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "hasSequence is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:message "hasSequence ist mit byIndex geordnet: es muss genau eine rdf:List tragen."@de ;
    sh:message "hasSequence est ordonné par byIndex : il doit porter exactement une rdf:List."@fr ;
    sh:node map-sh:infra-NetLinearReference-hasSequence-items ;
    sh:severity sh:Violation ;
    era:additionalInfo "hasSequence lists the LinearElements a path passes through BETWEEN its startsAt and endsAt - it is optional, since a path that goes directly from one element to an adjacent one has nothing in between; an empty or absent hasSequence is entirely normal in that case. Note that the message shown is shared across three different possible causes: more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the underlying list fails the well-formedness or item-type checks carried out separately - in the last case, this message and the more specific one describing exactly what is wrong inside the list will both appear together as two separate findings for the same root problem."@en ;
    era:additionalInfo "hasSequence listet die LinearElements auf, die ein Pfad ZWISCHEN seinem startsAt und endsAt durchläuft - es ist optional, da ein Pfad, der direkt von einem Element zu einem benachbarten führt, nichts dazwischen hat; ein leeres oder fehlendes hasSequence ist in diesem Fall völlig normal. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder die zugrunde liegende Liste scheitert an den separat durchgeführten Wohlgeformtheits- oder Elementtyp-Prüfungen - im letzten Fall erscheinen diese Meldung und die genauere Meldung, die beschreibt, was innerhalb der Liste konkret falsch ist, gemeinsam als zwei getrennte Befunde für dasselbe zugrunde liegende Problem."@de ;
    era:additionalInfo "hasSequence liste les LinearElements qu'un chemin traverse ENTRE son startsAt et son endsAt - elle est optionnelle, car un chemin allant directement d'un élément à un élément adjacent n'a rien entre les deux ; un hasSequence vide ou absent est alors parfaitement normal. Notez que le message affiché couvre trois causes possibles distinctes : plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la liste sous-jacente échoue aux vérifications de bonne formation ou de type d'élément effectuées séparément - dans ce dernier cas, ce message et le message plus précis décrivant exactement ce qui ne va pas à l'intérieur de la liste apparaîtront tous deux ensemble comme deux constats distincts pour le même problème de fond."@fr ;
    .

map-sh:infra-NetLinearReference-hasSequence-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes map-sh:PrefixDeclarations ;
    sh:message "era:hasSequence is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:message "era:hasSequence ist mit byIndex geordnet und muss daher eine wohlgeformte, terminierte rdf:List sein: jede Listenzelle benötigt genau ein rdf:first und genau ein rdf:rest."@de ;
    sh:message "era:hasSequence est ordonné par byIndex et doit donc être une rdf:List bien formée et terminée : chaque cellule de la liste nécessite exactement un rdf:first et exactement un rdf:rest."@fr ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:hasSequence ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

map-sh:infra-NetLinearReference-hasSequence-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:hasSequence"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:IRI ;
        sh:class era:LinearElement ;
        sh:message "hasSequence must reference an existing era:LinearElement by IRI."@en ;
        sh:message "hasSequence muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
        sh:message "hasSequence doit référencer un era:LinearElement existant par IRI."@fr ;
        sh:severity sh:Violation ;
    ] ;
    .

########################################################################
#  map node shapes
########################################################################
### Map ###############################################################
map-sh:MapShape
    a sh:NodeShape ;
    sh:targetClass era:Map ;
    sh:name "Map" ;
    sh:description "Defines Map for an area" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property map-sh:Map-name ;
    sh:property map-sh:Map-versionTimestamp ;
    sh:property map-sh:Map-areaId ;
    sh:property map-sh:Map-epsg ;
    sh:property map-sh:Map-linearElementProjections ;
    sh:property map-sh:Map-functionalElements ;
    sh:severity sh:Violation ;
    .

map-sh:Map-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "name is an optional, purely descriptive label for this map, only meant to be populated when a more human-readable name is wanted in addition to its own id. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "name ist eine optionale, rein beschreibende Bezeichnung für diese Karte, die nur ausgefüllt werden soll, wenn zusätzlich zur eigenen id ein besser lesbarer Name gewünscht wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "name est une étiquette optionnelle, purement descriptive, pour cette carte, destinée à n'être renseignée que lorsqu'un nom plus lisible est souhaité en complément de son propre id. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

map-sh:Map-versionTimestamp
    a sh:PropertyShape ;
    sh:path era:versionTimestamp ;
    sh:name "versionTimestamp" ;
    sh:description "Defines the version information which is valid since timestamp" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid date-time."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein gültiges Datum/Zeit."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas une date-heure valide."@fr ;
    .

map-sh:Map-areaId
    a sh:PropertyShape ;
    sh:path era:areaId ;
    sh:name "areaId" ;
    sh:description "Defines the areaIds for a Map. There could be several maps representing one area" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "areaId's own description states that several distinct maps can share the same area - this value does not uniquely identify a single Map, only the area it represents. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid string."@en ;
    era:additionalInfo "Die eigene Beschreibung von areaId besagt, dass mehrere verschiedene Karten denselben Bereich gemeinsam haben können - dieser Wert identifiziert also nicht eindeutig eine einzelne Map, sondern nur den von ihr dargestellten Bereich. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zeichenkette."@de ;
    era:additionalInfo "La propre description de areaId indique que plusieurs cartes distinctes peuvent partager la même zone - cette valeur n'identifie donc pas une Map unique de façon univoque, seulement la zone qu'elle représente. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas une chaîne de caractères valide."@fr ;
    .

map-sh:Map-epsg
    a sh:PropertyShape ;
    sh:path era:epsg ;
    sh:name "epsg" ;
    sh:description "Defines the applicable EPSG code for the map area. Use 1 for monitor coordinates" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "epsg's own description states that the value 1 is reserved specifically to mean monitor (screen) coordinates - this is a local convention of this data model, not a real code from the actual EPSG geodetic parameter registry, where 1 has no such meaning. Every coordinate recorded elsewhere under this Map (in LinearElementCoordinate and FunctionalElementProjection) is only meaningful once interpreted according to whichever code is set here. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von epsg besagt, dass der Wert 1 speziell reserviert ist, um Monitor-(Bildschirm-)Koordinaten zu bedeuten - dies ist eine lokale Konvention dieses Datenmodells, kein echter Code aus dem tatsächlichen EPSG-Register geodätischer Parameter, in dem 1 keine solche Bedeutung hat. Jede an anderer Stelle unter dieser Map erfasste Koordinate (in LinearElementCoordinate und FunctionalElementProjection) ist erst aussagekräftig, wenn sie gemäß dem hier gesetzten Code interpretiert wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "La propre description de epsg indique que la valeur 1 est réservée spécifiquement pour signifier des coordonnées écran (moniteur) - il s'agit d'une convention locale à ce modèle de données, non un code réel du registre géodésique EPSG effectif, où 1 n'a pas cette signification. Chaque coordonnée enregistrée ailleurs sous cette Map (dans LinearElementCoordinate et FunctionalElementProjection) n'a de sens qu'une fois interprétée selon le code défini ici. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

map-sh:Map-linearElementProjections
    a sh:PropertyShape ;
    sh:path era:linearElementProjections ;
    sh:name "linearElementProjections" ;
    sh:description "Defines container for projections of linearElements on same mapping system" ;
    sh:order 6 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:LinearElementProjectionShape ;
    sh:message "linearElementProjections must be a well-formed LinearElementProjection (blank node or IRI)."@en ;
    sh:message "linearElementProjections muss ein wohlgeformtes LinearElementProjection sein (Blank Node oder IRI)."@de ;
    sh:message "linearElementProjections doit être un LinearElementProjection bien formé (nœud vide ou IRI)."@fr ;
    sh:severity sh:Violation ;
    era:additionalInfo "This property has neither minCount nor maxCount, so a Map with none at all, or with several, is equally valid. Note that the message shown is shared across two different possible causes: the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested LinearElementProjection shape itself."@en ;
    era:additionalInfo "Diese Eigenschaft hat weder minCount noch maxCount, eine Map ganz ohne solche oder mit mehreren ist also gleichermaßen gültig. Beachten Sie, dass die angezeigte Meldung zwei unterschiedliche mögliche Ursachen abdeckt: der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte LinearElementProjection-Shape selbst nicht."@de ;
    era:additionalInfo "Cette propriété n'a ni minCount ni maxCount, une Map n'en ayant aucune ou en ayant plusieurs est donc également valide. Notez que le message affiché couvre deux causes possibles distinctes : la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape LinearElementProjection imbriquée elle-même."@fr ;
    .

map-sh:Map-functionalElements
    a sh:PropertyShape ;
    sh:path era:functionalElements ;
    sh:name "functionalElements" ;
    sh:description "Defines a container for a reference to a functional element of the infrastructure" ;
    sh:order 7 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:FunctionalElementProjectionShape ;
    sh:message "functionalElements must be a well-formed FunctionalElementProjection (blank node or IRI)."@en ;
    sh:message "functionalElements muss ein wohlgeformtes FunctionalElementProjection sein (Blank Node oder IRI)."@de ;
    sh:message "functionalElements doit être un FunctionalElementProjection bien formé (nœud vide ou IRI)."@fr ;
    sh:severity sh:Violation ;
    era:additionalInfo "This property has neither minCount nor maxCount, so a Map with none at all, or with several, is equally valid. Despite the plural name, each value here is checked against the FunctionalElementProjection shape, not a list - every functional element gets its own separate entry. Note that the message shown is shared across two different possible causes: the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested FunctionalElementProjection shape itself."@en ;
    era:additionalInfo "Diese Eigenschaft hat weder minCount noch maxCount, eine Map ganz ohne solche oder mit mehreren ist also gleichermaßen gültig. Trotz des Plural-Namens wird jeder hier vorhandene Wert gegen die FunctionalElementProjection-Shape geprüft, nicht gegen eine Liste - jedes funktionale Element erhält einen eigenen separaten Eintrag. Beachten Sie, dass die angezeigte Meldung zwei unterschiedliche mögliche Ursachen abdeckt: der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte FunctionalElementProjection-Shape selbst nicht."@de ;
    era:additionalInfo "Cette propriété n'a ni minCount ni maxCount, une Map n'en ayant aucun ou en ayant plusieurs est donc également valide. Malgré le nom au pluriel, chaque valeur ici est vérifiée par rapport à la shape FunctionalElementProjection, non une liste - chaque élément fonctionnel reçoit sa propre entrée distincte. Notez que le message affiché couvre deux causes possibles distinctes : la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape FunctionalElementProjection imbriquée elle-même."@fr ;
    .

### LinearElementProjection ###########################################
map-sh:LinearElementProjectionShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElementProjection ;
    sh:name "LinearElementProjection" ;
    sh:description "Defines the geometric projection of a LinearElement by mapping positions along the linear element to spatial coordinates." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:sparql map-sh:LinearElementProjection-coordinates-listWellFormed ;
    sh:sparql map-sh:LinearElementProjection-coordinates-listItemCount ;
    sh:property map-sh:LinearElementProjection-linearElement ;
    sh:property map-sh:LinearElementProjection-coordinates ;
    sh:severity sh:Violation ;
    .

map-sh:LinearElementProjection-linearElement
    a sh:PropertyShape ;
    sh:path era:linearElement ;
    sh:name "linearElement" ;
    sh:description "reference to the corresponding LinearElement" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "linearElement must reference an existing era:LinearElement by IRI."@en ;
    sh:message "linearElement muss über eine IRI auf ein bestehendes era:LinearElement verweisen."@de ;
    sh:message "linearElement doit référencer un era:LinearElement existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is not an IRI at all, or the value is an IRI but does not point at something actually typed as a LinearElement."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber überhaupt keine IRI, oder der Wert ist eine IRI, verweist aber nicht auf ein tatsächlich als LinearElement typisiertes Objekt."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est pas du tout une IRI, ou la valeur est une IRI mais ne pointe pas vers un objet réellement typé comme LinearElement."@fr ;
    .

map-sh:LinearElementProjection-coordinates
    a sh:PropertyShape ;
    sh:path era:coordinates ;
    sh:name "coordinates" ;
    sh:description "Defines a sequence of coordinates representing a mapping of a linear element" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "coordinates is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:message "coordinates ist mit byIndex geordnet: es muss genau eine rdf:List tragen."@de ;
    sh:message "coordinates est ordonné par byIndex : il doit porter exactement une rdf:List."@fr ;
    sh:node map-sh:LinearElementProjection-coordinates-items ;
    sh:severity sh:Violation ;
    era:additionalInfo "This property's own message covers only whether exactly one rdf:List is carried at all - a separate check, with its own message, additionally requires that list to hold at least 2 coordinate points once it exists, since a projection needs at least a start and an end point to describe a line. Note that the message shown here is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value is present but is neither a blank node nor an IRI."@en ;
    era:additionalInfo "Die eigene Meldung dieser Eigenschaft deckt nur ab, ob überhaupt genau eine rdf:List getragen wird - eine separate Prüfung mit eigener Meldung verlangt zusätzlich, dass diese Liste, sobald sie existiert, mindestens 2 Koordinatenpunkte enthält, da eine Projektion mindestens einen Start- und einen Endpunkt benötigt, um eine Linie zu beschreiben. Beachten Sie, dass die hier angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der Wert ist vorhanden, aber weder Blank Node noch IRI."@de ;
    era:additionalInfo "Le message propre à cette propriété ne couvre que le fait qu'exactement une rdf:List soit portée - une vérification distincte, avec son propre message, exige en outre que cette liste, une fois qu'elle existe, contienne au moins 2 points de coordonnées, car une projection nécessite au moins un point de départ et un point d'arrivée pour décrire une ligne. Notez que le message affiché ici couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur est présente mais n'est ni un nœud vide ni une IRI."@fr ;
    .

map-sh:LinearElementProjection-coordinates-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes map-sh:PrefixDeclarations ;
    sh:message "era:coordinates is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:message "era:coordinates ist mit byIndex geordnet und muss daher eine wohlgeformte, terminierte rdf:List sein: jede Listenzelle benötigt genau ein rdf:first und genau ein rdf:rest."@de ;
    sh:message "era:coordinates est ordonné par byIndex et doit donc être une rdf:List bien formée et terminée : chaque cellule de la liste nécessite exactement un rdf:first et exactement un rdf:rest."@fr ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:coordinates ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

map-sh:LinearElementProjection-coordinates-listItemCount
    a sh:SPARQLConstraint ;
    sh:prefixes map-sh:PrefixDeclarations ;
    sh:message "The single rdf:List carried by era:coordinates must hold at least 2 item(s); the multiplicity bounds the items inside the list, not the number of lists."@en ;
    sh:message "Die einzelne rdf:List, die von era:coordinates getragen wird, muss mindestens 2 Element(e) enthalten; die Multiplizität begrenzt die Elemente innerhalb der Liste, nicht die Anzahl der Listen."@de ;
    sh:message "L'unique rdf:List portée par era:coordinates doit contenir au moins 2 élément(s) ; la multiplicité borne les éléments à l'intérieur de la liste, pas le nombre de listes."@fr ;
    sh:select """
            SELECT $this (COUNT(?item) AS ?itemCount)
            WHERE {
                $this era:coordinates ?head .
                OPTIONAL {
                    ?head rdf:rest* ?cell .
                    FILTER ( ?cell != rdf:nil )
                    BIND ( ?cell AS ?item )
                }
            }
            GROUP BY $this
            HAVING ( COUNT(?item) < 2 )
        """ ;
    .

map-sh:LinearElementProjection-coordinates-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:coordinates"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node map-sh:LinearElementCoordinateShape ;
        sh:message "coordinates must be a well-formed LinearElementCoordinate (blank node or IRI)."@en ;
        sh:message "coordinates muss ein wohlgeformtes LinearElementCoordinate sein (Blank Node oder IRI)."@de ;
        sh:message "coordinates doit être un LinearElementCoordinate bien formé (nœud vide ou IRI)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    .

### LinearElementCoordinate ###########################################
map-sh:LinearElementCoordinateShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElementCoordinate ;
    sh:name "LinearElementCoordinate" ;
    sh:description "Defines a coordinate point associated with a position on a LinearElement, including its spatial coordinates and positional accuracy." ;
    sh:property map-sh:LinearElementCoordinate-pos ;
    sh:property map-sh:LinearElementCoordinate-x ;
    sh:property map-sh:LinearElementCoordinate-y ;
    sh:property map-sh:LinearElementCoordinate-z ;
    sh:property map-sh:LinearElementCoordinate-accPos ;
    sh:property map-sh:LinearElementCoordinate-accX ;
    sh:property map-sh:LinearElementCoordinate-accY ;
    sh:property map-sh:LinearElementCoordinate-accZ ;
    sh:severity sh:Violation ;
    .

map-sh:LinearElementCoordinate-pos
    a sh:PropertyShape ;
    sh:path era:pos ;
    sh:name "pos" ;
    sh:description "Defines position on the associated LinearElement" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
	sh:minInclusive 0.0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Unlike some similar position fields elsewhere in this data model, this one has a minInclusive of 0.0 - a negative position is explicitly rejected here, not merely left unchecked. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is negative or otherwise not a valid number."@en ;
    era:additionalInfo "Anders als einige ähnliche Positionsfelder an anderer Stelle in diesem Datenmodell besitzt dieses ein minInclusive von 0.0 - ein negativer Wert wird hier ausdrücklich zurückgewiesen, nicht lediglich ungeprüft gelassen. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist negativ oder anderweitig keine gültige Zahl."@de ;
    era:additionalInfo "Contrairement à certains champs de position similaires ailleurs dans ce modèle de données, celui-ci possède un minInclusive de 0.0 - une valeur négative est explicitement rejetée ici, non simplement laissée non vérifiée. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente est négative ou n'est pas autrement un nombre valide."@fr ;
    .

map-sh:LinearElementCoordinate-x
    a sh:PropertyShape ;
    sh:path era:x ;
    sh:name "x" ;
    sh:description "Defines the x coordiante value, mapping to each EPSG-code" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "x's own description notes its actual meaning depends on which EPSG code the enclosing Map specifies - the same raw number represents a different real-world position depending on that code. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number."@en ;
    era:additionalInfo "Die eigene Beschreibung von x merkt an, dass ihre tatsächliche Bedeutung davon abhängt, welchen EPSG-Code die umgebende Map angibt - dieselbe Rohzahl stellt je nach diesem Code eine andere reale Position dar. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zahl."@de ;
    era:additionalInfo "La propre description de x note que sa signification réelle dépend du code EPSG spécifié par la Map englobante - le même nombre brut représente une position réelle différente selon ce code. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un nombre valide."@fr ;
    .

map-sh:LinearElementCoordinate-y
    a sh:PropertyShape ;
    sh:path era:y ;
    sh:name "y" ;
    sh:description "Defines the y coordiante value, mapping to each EPSG-code" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "y's own description notes its actual meaning depends on which EPSG code the enclosing Map specifies - the same raw number represents a different real-world position depending on that code. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number."@en ;
    era:additionalInfo "Die eigene Beschreibung von y merkt an, dass ihre tatsächliche Bedeutung davon abhängt, welchen EPSG-Code die umgebende Map angibt - dieselbe Rohzahl stellt je nach diesem Code eine andere reale Position dar. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zahl."@de ;
    era:additionalInfo "La propre description de y note que sa signification réelle dépend du code EPSG spécifié par la Map englobante - le même nombre brut représente une position réelle différente selon ce code. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un nombre valide."@fr ;
    .

map-sh:LinearElementCoordinate-z
    a sh:PropertyShape ;
    sh:path era:z ;
    sh:name "z" ;
    sh:description "Defines the z coordiante value, mapping to each EPSG-code" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "z's own description notes its actual meaning depends on which EPSG code the enclosing Map specifies - the same raw number represents a different real-world position depending on that code. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid number."@en ;
    era:additionalInfo "Die eigene Beschreibung von z merkt an, dass ihre tatsächliche Bedeutung davon abhängt, welchen EPSG-Code die umgebende Map angibt - dieselbe Rohzahl stellt je nach diesem Code eine andere reale Position dar. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Zahl."@de ;
    era:additionalInfo "La propre description de z note que sa signification réelle dépend du code EPSG spécifié par la Map englobante - le même nombre brut représente une position réelle différente selon ce code. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un nombre valide."@fr ;
    .

map-sh:LinearElementCoordinate-accPos
    a sh:PropertyShape ;
    sh:path era:accPos ;
    sh:name "accPos" ;
    sh:description "absolute accuracy as 1sigma. Use 0 if not defined" ;
    sh:order 5 ;
    qudt:hasUnit unit:MilliM ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "accPos's own description states it is expressed as 1 sigma - a statistical measure of typical deviation, not an absolute worst-case bound - and that 0 should be used specifically to mean the accuracy is not defined, rather than claiming perfect accuracy. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von accPos besagt, dass sie als 1 Sigma ausgedrückt wird - ein statistisches Maß für die typische Abweichung, keine absolute Worst-Case-Grenze - und dass 0 speziell verwendet werden soll, um auszudrücken, dass die Genauigkeit nicht definiert ist, statt eine perfekte Genauigkeit zu behaupten. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "La propre description de accPos indique qu'elle est exprimée en 1 sigma - une mesure statistique de l'écart typique, non une borne absolue de pire cas - et que 0 doit être utilisé spécifiquement pour signifier que la précision n'est pas définie, plutôt que d'affirmer une précision parfaite. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

