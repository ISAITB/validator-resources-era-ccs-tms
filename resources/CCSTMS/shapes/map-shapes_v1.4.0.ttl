### FunctionalElementProjection #######################################
map-sh:FunctionalElementProjectionShape
    a sh:NodeShape ;
    sh:targetClass era:FunctionalElementProjection ;
    sh:name "FunctionalElementProjection" ;
    sh:description "Defines the spatial projection of a functional infrastructure element by associating it with geographic coordinates and their accuracy." ;
    sh:property map-sh:FunctionalElementProjection-elementRef ;
    sh:property map-sh:FunctionalElementProjection-x ;
    sh:property map-sh:FunctionalElementProjection-y ;
    sh:property map-sh:FunctionalElementProjection-z ;
    sh:property map-sh:FunctionalElementProjection-accX ;
    sh:property map-sh:FunctionalElementProjection-accY ;
    sh:property map-sh:FunctionalElementProjection-accZ ;
    sh:severity sh:Violation ;
    .

map-sh:FunctionalElementProjection-elementRef
    a sh:PropertyShape ;
    sh:path era:elementRef ;
    sh:name "elementRef" ;
    sh:description "Defines reference container for which the coodinate is defined" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node map-sh:FunctionalElementRefShape ;
    sh:message "elementRef must be a well-formed FunctionalElementRef (blank node or IRI)."@en ;
    sh:message "elementRef muss ein wohlgeformtes FunctionalElementRef sein (Blank Node oder IRI)."@de ;
    sh:message "elementRef doit être un FunctionalElementRef bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "Note that the message shown is shared across four different possible causes: the value is missing entirely, more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested FunctionalElementRef shape itself."@en ;
    era:additionalInfo "Beachten Sie, dass die angezeigte Meldung vier unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte FunctionalElementRef-Shape selbst nicht."@de ;
    era:additionalInfo "Notez que le message affiché couvre quatre causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape FunctionalElementRef imbriquée elle-même."@fr ;
    .

map-sh:FunctionalElementProjection-x
    a sh:PropertyShape ;
    sh:path era:x ;
    sh:name "x" ;
    sh:description "todo: mapping to each EPSG-code" ;
