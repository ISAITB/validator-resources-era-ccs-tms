### UsageRestrictionState #############################################
opp-sh:UsageRestrictionStateShape
    a sh:NodeShape ;
    sh:targetClass era:UsageRestrictionState ;
    sh:name "UsageRestrictionState" ;
    sh:description "Defines if the restriction is activated or deactivated" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:UsageRestrictionState-usageRestrictionState ;
    sh:property opp-sh:UsageRestrictionState-usageRestriction ;
    sh:property opp-sh:UsageRestrictionState-unsupervisedTrainsInRestrictionArea ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionState-usageRestrictionState
    a sh:PropertyShape ;
    sh:path era:usageRestrictionState ;
    sh:name "usageRestrictionState" ;
    sh:description "Defines if the area was activated or deactivated" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/event-state/activated> <http://data.europa.eu/949/concepts/event-state/deactivated> ) ;
    sh:message "Value must be one of the CCSTMS-scoped EventState concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von EventState entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de EventState."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionState-usageRestriction
    a sh:PropertyShape ;
    sh:path era:usageRestriction ;
    sh:name "usageRestriction" ;
    sh:description "Defines the restriction area associated to a restriction area state. Always provided = mandatory, except for deactivation." ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:UsageRestrictionShape ;
    sh:message "usageRestriction must be a well-formed UsageRestriction (blank node or IRI)."@en ;
    sh:message "usageRestriction muss ein wohlgeformtes UsageRestriction sein (Blank Node oder IRI)."@de ;
    sh:message "usageRestriction doit être un UsageRestriction bien formé (nœud vide ou IRI)."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionState-unsupervisedTrainsInRestrictionArea
    a sh:PropertyShape ;
    sh:path era:unsupervisedTrainsInRestrictionArea ;
    sh:name "unsupervisedTrainsInRestrictionArea" ;
    sh:description "in active state some unsupervised trains are still in the restriction area. So, it is not safe enter the area by maintainer. Signaller has to send manual instructions to unsupervised trains." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "unsupervisedTrainsInRestrictionArea's own description explains the operational consequence of true: while the restriction is active, some unsupervised trains remain physically present in the restriction area, so it is not safe for a maintainer to enter, and the signaller must send manual instructions to those trains directly. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a genuine boolean."@en ;
    era:additionalInfo "Die eigene Beschreibung von unsupervisedTrainsInRestrictionArea erklärt die betriebliche Konsequenz von true: während die Einschränkung aktiv ist, befinden sich noch unüberwachte Züge physisch im Einschränkungsbereich, sodass es für eine Instandhaltungskraft nicht sicher ist, den Bereich zu betreten, und der Fahrdienstleiter diesen Zügen direkt manuelle Anweisungen erteilen muss. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein echter boolescher Wert."@de ;
    era:additionalInfo "La propre description de unsupervisedTrainsInRestrictionArea explique la conséquence opérationnelle de true : tant que la restriction est active, certains trains non supervisés restent physiquement présents dans la zone de restriction, il n'est donc pas sûr pour un agent de maintenance d'y pénétrer, et l'aiguilleur doit envoyer des instructions manuelles directement à ces trains. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un booléen authentique."@fr ;
    .

