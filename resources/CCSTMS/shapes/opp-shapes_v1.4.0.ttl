opp-sh:TrainUnitReportAtoCapabilities-additionalTrainData
    a sh:PropertyShape ;
    sh:path era:additionalTrainData ;
    sh:name "additionalTrainData" ;
    sh:description "Defines additional train data as part of ATO capabilities report" ;
    sh:order 10 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:AdditionalTrainDataShape ;
    sh:message "additionalTrainData must be a well-formed AdditionalTrainData (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoCapabilities-physicalConsists
    a sh:PropertyShape ;
    sh:path era:physicalConsists ;
    sh:name "physicalConsists" ;
    sh:description "Defines the list of physical consists. Empty if unknown" ;
    sh:order 11 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "physicalConsists is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node opp-sh:TrainUnitReportAtoCapabilities-physicalConsists-items ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoCapabilities-physicalConsists-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "era:physicalConsists is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:physicalConsists ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

opp-sh:TrainUnitReportAtoCapabilities-physicalConsists-listItemCount
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "The single rdf:List carried by era:physicalConsists must hold between 0 and 255 item(s); the multiplicity bounds the items inside the list, not the number of lists."@en ;
    sh:select """
            SELECT $this (COUNT(?item) AS ?itemCount)
            WHERE {
                $this era:physicalConsists ?head .
                OPTIONAL {
                    ?head rdf:rest* ?cell .
                    FILTER ( ?cell != rdf:nil )
                    BIND ( ?cell AS ?item )
                }
            }
            GROUP BY $this
            HAVING ( COUNT(?item) > 255 )
        """ ;
    .

opp-sh:TrainUnitReportAtoCapabilities-physicalConsists-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:physicalConsists"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node opp-sh:PhysicalConsistShape ;
        sh:message "physicalConsists must be a well-formed PhysicalConsist (blank node or IRI)."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

### EtcsDataAto #######################################################
