    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanEventExecutionReport-deactivationRestrictionReport
    a sh:PropertyShape ;
    sh:path era:deactivationRestrictionReport ;
    sh:name "deactivationRestrictionReport" ;
    sh:description "Defines the result of removal of a restriction" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:UsageRestrictionEventExecutionReportShape ;
    sh:message "deactivationRestrictionReport must be a well-formed UsageRestrictionEventExecutionReport (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanEventExecutionReport-activationWarningMeasureReport
