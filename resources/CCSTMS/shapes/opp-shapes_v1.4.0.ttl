    a sh:NodeShape ;
    sh:targetClass era:WarningMeasureResponseCode ;
    sh:name "WarningMeasureResponseCode" ;
    sh:description "Defines a feedback from PES about received operationalPlanWarningMeasure" ;
    sh:property opp-sh:WarningMeasureResponseCode-responseCodeWarningMeasure ;
    sh:property opp-sh:WarningMeasureResponseCode-operationalPlanWarningMeasure ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningMeasureResponseCode-responseCodeWarningMeasure
    a sh:PropertyShape ;
    sh:path era:responseCodeWarningMeasure ;
    sh:name "responseCodeWarningMeasure" ;
    sh:description "Defines specific response code for the attached operationalPlanWarningMeasure" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/rcwm/accepted> <http://data.europa.eu/949/concepts/rcwm/anyRejectReason> ) ;
    sh:message "Value must be one of the CCSTMS-scoped ResponseCodeWarningMeasure concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningMeasureResponseCode-operationalPlanWarningMeasure
    a sh:PropertyShape ;
    sh:path era:operationalPlanWarningMeasure ;
    sh:name "operationalPlanWarningMeasure" ;
    sh:description "Refers the operational plan warning measure" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:OperationalPlanWarningMeasure ;
    sh:message "operationalPlanWarningMeasure must reference an existing era:OperationalPlanWarningMeasure by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### OperationalPlanResponse ###########################################
opp-sh:OperationalPlanResponseShape
    a sh:NodeShape ;
    sh:targetClass era:OperationalPlanResponse ;
    sh:name "OperationalPlanResponse" ;
    sh:description "Defines a Union containing specific responses for each type of the OperationalPlan" ;
    sh:xone (
        opp-sh:OperationalPlanResponse-movementResponse-present
        opp-sh:OperationalPlanResponse-usageRestrictionResponse-present
        opp-sh:OperationalPlanResponse-warningMeasureResponse-present
    ) ;
    sh:message "OperationalPlanResponse is a union: exactly one of (movementResponse, usageRestrictionResponse, warningMeasureResponse) must be present."@en ;
    sh:property opp-sh:OperationalPlanResponse-movementResponse ;
    sh:property opp-sh:OperationalPlanResponse-usageRestrictionResponse ;
    sh:property opp-sh:OperationalPlanResponse-warningMeasureResponse ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanResponse-movementResponse
    a sh:PropertyShape ;
    sh:path era:movementResponse ;
    sh:name "movementResponse" ;
    sh:description "Contains response from PES for a operationalPlanMovement" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:MovementResponseCodeShape ;
    sh:message "movementResponse must be a well-formed MovementResponseCode (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanResponse-usageRestrictionResponse
    a sh:PropertyShape ;
    sh:path era:usageRestrictionResponse ;
    sh:name "usageRestrictionResponse" ;
    sh:description "Contains response from PES for a operationalPlanUsageRestriction" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:UsageRestrictionResponseCodeShape ;
    sh:message "usageRestrictionResponse must be a well-formed UsageRestrictionResponseCode (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanResponse-warningMeasureResponse
    a sh:PropertyShape ;
    sh:path era:warningMeasureResponse ;
    sh:name "warningMeasureResponse" ;
    sh:description "Contains response from PES for a operationalPlanMeasureEvent" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:WarningMeasureResponseCodeShape ;
    sh:message "warningMeasureResponse must be a well-formed WarningMeasureResponseCode (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanResponse-movementResponse-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:movementResponse is present"@en ;
    sh:property opp-sh:OperationalPlanResponse-movementResponse-required ;
    .

opp-sh:OperationalPlanResponse-movementResponse-required
    a sh:PropertyShape ;
    sh:path era:movementResponse ;
    sh:minCount 1 ;
    .

opp-sh:OperationalPlanResponse-usageRestrictionResponse-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:usageRestrictionResponse is present"@en ;
    sh:property opp-sh:OperationalPlanResponse-usageRestrictionResponse-required ;
    .

opp-sh:OperationalPlanResponse-usageRestrictionResponse-required
    a sh:PropertyShape ;
    sh:path era:usageRestrictionResponse ;
    sh:minCount 1 ;
    .

opp-sh:OperationalPlanResponse-warningMeasureResponse-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:warningMeasureResponse is present"@en ;
    sh:property opp-sh:OperationalPlanResponse-warningMeasureResponse-required ;
    .

opp-sh:OperationalPlanResponse-warningMeasureResponse-required
    a sh:PropertyShape ;
    sh:path era:warningMeasureResponse ;
    sh:minCount 1 ;
    .

### OperationalPlanEventExecutionReport ###############################
opp-sh:OperationalPlanEventExecutionReportShape
    a sh:NodeShape ;
    sh:targetClass era:OperationalPlanEventExecutionReport ;
    sh:name "OperationalPlanEventExecutionReport" ;
    sh:description "Defines states of start/end of an event (success/failure, timestamp etc.)" ;
    sh:xone (
        opp-sh:OperationalPlanEventExecutionReport-arrivalReport-present
        opp-sh:OperationalPlanEventExecutionReport-departureReport-present
        opp-sh:OperationalPlanEventExecutionReport-activationRestrictionReport-present
        opp-sh:OperationalPlanEventExecutionReport-deactivationRestrictionReport-present
        opp-sh:OperationalPlanEventExecutionReport-activationWarningMeasureReport-present
        opp-sh:OperationalPlanEventExecutionReport-deactivationWarningMeasureReport-present
    ) ;
    sh:message "OperationalPlanEventExecutionReport is a union: exactly one of (arrivalReport, departureReport, activationRestrictionReport, deactivationRestrictionReport, activationWarningMeasureReport, deactivationWarningMeasureReport) must be present."@en ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-arrivalReport ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-departureReport ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-activationRestrictionReport ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-deactivationRestrictionReport ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-activationWarningMeasureReport ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-deactivationWarningMeasureReport ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanEventExecutionReport-arrivalReport
    a sh:PropertyShape ;
    sh:path era:arrivalReport ;
    sh:name "arrivalReport" ;
    sh:description "Defines the arrival reports. For passing only the departure reports are to be sent" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:MovementEventExecutionReportShape ;
    sh:message "arrivalReport must be a well-formed MovementEventExecutionReport (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanEventExecutionReport-departureReport
    a sh:PropertyShape ;
    sh:path era:departureReport ;
    sh:name "departureReport" ;
