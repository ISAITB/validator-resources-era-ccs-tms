### OperationalPlanEventExecutionReport ###############################
opp-sh:OperationalPlanEventExecutionReportShape
    a sh:NodeShape ;
    sh:targetClass era:OperationalPlanEventExecutionReport ;
    sh:name "OperationalPlanEventExecutionReport" ;
    sh:description "Defines states of start/end of an event (success/failure, timestamp etc.)" ;
    sh:xone (
        opp-sh:OperationalPlanEventExecutionReport-arrivalReport-present
        opp-sh:OperationalPlanEventExecutionReport-departureReport-present
        opp-sh:OperationalPlanEventExecutionReport-activationRestrictionReport-present
        opp-sh:OperationalPlanEventExecutionReport-deactivationRestrictionReport-present
        opp-sh:OperationalPlanEventExecutionReport-activationWarningMeasureReport-present
        opp-sh:OperationalPlanEventExecutionReport-deactivationWarningMeasureReport-present
    ) ;
    sh:message "OperationalPlanEventExecutionReport is a union: exactly one of (arrivalReport, departureReport, activationRestrictionReport, deactivationRestrictionReport, activationWarningMeasureReport, deactivationWarningMeasureReport) must be present."@en ;
    sh:message "OperationalPlanEventExecutionReport ist eine Union: genau eines von (arrivalReport, departureReport, activationRestrictionReport, deactivationRestrictionReport, activationWarningMeasureReport, deactivationWarningMeasureReport) muss vorhanden sein."@de ;
    sh:message "OperationalPlanEventExecutionReport est une union : exactement l'un de (arrivalReport, departureReport, activationRestrictionReport, deactivationRestrictionReport, activationWarningMeasureReport, deactivationWarningMeasureReport) doit être présent."@fr ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-arrivalReport ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-departureReport ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-activationRestrictionReport ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-deactivationRestrictionReport ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-activationWarningMeasureReport ;
    sh:property opp-sh:OperationalPlanEventExecutionReport-deactivationWarningMeasureReport ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanEventExecutionReport-arrivalReport
    a sh:PropertyShape ;
    sh:path era:arrivalReport ;
    sh:name "arrivalReport" ;
    sh:description "Defines the arrival reports. For passing only the departure reports are to be sent" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:MovementEventExecutionReportShape ;
    sh:message "arrivalReport must be a well-formed MovementEventExecutionReport (blank node or IRI)."@en ;
    sh:message "arrivalReport muss ein wohlgeformtes MovementEventExecutionReport sein (Blank Node oder IRI)."@de ;
    sh:message "arrivalReport doit être un MovementEventExecutionReport bien formé (nœud vide ou IRI)."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "OperationalPlanEventExecutionReport is a union of six alternatives - exactly one is expected to be present, never more than one and never none. This property has no minCount, so its own absence alone is not a problem. Its own description states that for a passing event, only a departureReport is expected to be sent, not this one. Note that the message shown is shared across three different possible causes: more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested MovementEventExecutionReport shape itself."@en ;
    era:additionalInfo "OperationalPlanEventExecutionReport ist eine Union aus sechs Alternativen - genau eine soll vorhanden sein, nie mehr als eine und nie keine. Diese Eigenschaft hat kein minCount, ihr eigenes Fehlen ist also für sich kein Problem. Die eigene Beschreibung besagt, dass bei einem Durchfahrtsereignis erwartungsgemäß nur ein departureReport gesendet wird, nicht dieses. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte MovementEventExecutionReport-Shape selbst nicht."@de ;
    era:additionalInfo "OperationalPlanEventExecutionReport est une union de six alternatives - exactement une doit être présente, jamais plus d'une et jamais aucune. Cette propriété n'a pas de minCount, son absence seule n'est donc pas un problème. Sa propre description indique que pour un événement de passage, seul un departureReport est censé être envoyé, non celui-ci. Notez que le message affiché couvre trois causes possibles distinctes : plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape MovementEventExecutionReport imbriquée elle-même."@fr ;
    .

