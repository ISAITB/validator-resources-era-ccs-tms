    sh:name "excludedSwitchableTracksideAssetsForFlankProtection" ;
    sh:description "Defines the list of SwitchableTracksideAssets to be excluded from flank protection calculation." ;
    sh:order 6 ;
    sh:nodeKind sh:IRI ;
    sh:class era:SwitchableTracksideAsset ;
    sh:message "excludedSwitchableTracksideAssetsForFlankProtection must reference an existing era:SwitchableTracksideAsset by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:SpecificMovementRestriction-speedRestriction-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:speedRestriction is present"@en ;
    sh:property opp-sh:SpecificMovementRestriction-speedRestriction-required ;
    .

opp-sh:SpecificMovementRestriction-speedRestriction-required
    a sh:PropertyShape ;
    sh:path era:speedRestriction ;
    sh:minCount 1 ;
    .

opp-sh:SpecificMovementRestriction-adhesionCategory-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:adhesionCategory is present"@en ;
    sh:property opp-sh:SpecificMovementRestriction-adhesionCategory-required ;
    .

opp-sh:SpecificMovementRestriction-adhesionCategory-required
