### UsageRestrictionState #############################################
opp-sh:UsageRestrictionStateShape
    a sh:NodeShape ;
    sh:targetClass era:UsageRestrictionState ;
    sh:name "UsageRestrictionState" ;
    sh:description "Defines if the restriction is activated or deactivated" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
