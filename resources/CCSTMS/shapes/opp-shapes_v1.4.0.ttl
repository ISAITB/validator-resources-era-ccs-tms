### TrainObject #######################################################
opp-sh:TrainObjectShape
    a sh:NodeShape ;
    sh:targetClass era:TrainObject ;
    sh:name "TrainObject" ;
    sh:description "Defines a train object as generated by ETPS including e.g. the validated train data and movement permission." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:TrainObject-obuIdentifier ;
    sh:property opp-sh:TrainObject-movementPermission ;
    sh:property opp-sh:TrainObject-safeTrainLength ;
    sh:property opp-sh:TrainObject-communicationActive ;
    sh:property opp-sh:TrainObject-trainRunningNumber ;
