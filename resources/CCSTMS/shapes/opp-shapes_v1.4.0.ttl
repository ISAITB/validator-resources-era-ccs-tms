### UnresolvedTrackboundObject ########################################
opp-sh:UnresolvedTrackboundObjectShape
    a sh:NodeShape ;
    sh:targetClass era:UnresolvedTrackboundObject ;
    sh:name "UnresolvedTrackboundObject" ;
    sh:description "Defines occupation state of a part of the infrastructure graph, sent by low-level system on each track occupation registered, contains CMD.UnresolvedTrackboundObject" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:UnresolvedTrackboundObject-utoExtent ;
    sh:property opp-sh:UnresolvedTrackboundObject-associatedTrainObject ;
    sh:property opp-sh:UnresolvedTrackboundObject-recordedTrainLength ;
    sh:property opp-sh:UnresolvedTrackboundObject-utoCreationReason ;
    sh:severity sh:Violation ;
    .

opp-sh:UnresolvedTrackboundObject-utoExtent
    a sh:PropertyShape ;
    sh:path era:utoExtent ;
    sh:name "utoExtent" ;
    sh:description "Extent of Unresolved Trackbound Object" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetAreaReferenceShape ;
    sh:message "utoExtent must be a well-formed NetAreaReference (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UnresolvedTrackboundObject-associatedTrainObject
    a sh:PropertyShape ;
    sh:path era:associatedTrainObject ;
    sh:name "associatedTrainObject" ;
    sh:description "Reference to Train Object associated to Unresolved Trackbound Object" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UnresolvedTrackboundObject-recordedTrainLength
    a sh:PropertyShape ;
    sh:path era:recordedTrainLength ;
    sh:name "recordedTrainLength" ;
    sh:description "Defines the recorded train length. Use 0 if undefined. Trainlength of the associated Train Object." ;
    sh:order 4 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UnresolvedTrackboundObject-utoCreationReason
    a sh:PropertyShape ;
    sh:path era:utoCreationReason ;
    sh:name "utoCreationReason" ;
    sh:description "Reason for creation of Unresolved Trackbound Object given by ETPS" ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/uto-creation-reason/ttdFree> <http://data.europa.eu/949/concepts/uto-creation-reason/systemInit> <http://data.europa.eu/949/concepts/uto-creation-reason/shorterLTrain> <http://data.europa.eu/949/concepts/uto-creation-reason/toCommLoss> <http://data.europa.eu/949/concepts/uto-creation-reason/ttdOccupation> ) ;
    sh:message "Value must be one of the CCSTMS-scoped UtoCreationReason concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### UnresolvedTrackboundObjectState ###################################
