### SafeTrainExtent ###################################################
opp-sh:SafeTrainExtentShape
    a sh:NodeShape ;
    sh:targetClass era:SafeTrainExtent ;
    sh:name "SafeTrainExtent" ;
    sh:description "Defines the safe train extent as provided by ETPS" ;
    sh:property opp-sh:SafeTrainExtent-linearReference ;
    sh:property opp-sh:SafeTrainExtent-trainPositionQualifier ;
    sh:severity sh:Violation ;
    .

opp-sh:SafeTrainExtent-linearReference
    a sh:PropertyShape ;
    sh:path era:linearReference ;
    sh:name "linearReference" ;
    sh:description "Defines the train extent on linear elements" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetLinearReferenceShape ;
    sh:message "linearReference must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:message "linearReference muss ein wohlgeformtes NetLinearReference sein (Blank Node oder IRI)."@de ;
    sh:message "linearReference doit être un NetLinearReference bien formé (nœud vide ou IRI)."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "This property has no minCount, so a safe train extent with no linear reference recorded is valid. Note that the message shown is shared across three different possible causes: more than one value is recorded, the value is present but is neither a blank node nor an IRI, or the value fails to satisfy the nested NetLinearReference shape itself."@en ;
    era:additionalInfo "Diese Eigenschaft hat kein minCount, eine sichere Zugausdehnung ohne erfassten linearen Bezug ist also gültig. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: es ist mehr als ein Wert erfasst, der Wert ist vorhanden, aber weder Blank Node noch IRI, oder der Wert erfüllt die verschachtelte NetLinearReference-Shape selbst nicht."@de ;
    era:additionalInfo "Cette propriété n'a pas de minCount, une étendue sûre de train sans référence linéaire enregistrée est donc valide. Notez que le message affiché couvre trois causes possibles distinctes : plus d'une valeur est enregistrée, la valeur est présente mais n'est ni un nœud vide ni une IRI, ou la valeur ne satisfait pas la shape NetLinearReference imbriquée elle-même."@fr ;
    .

opp-sh:SafeTrainExtent-trainPositionQualifier
    a sh:PropertyShape ;
    sh:path era:trainPositionQualifier ;
    sh:name "trainPositionQualifier" ;
    sh:description "Defines the quality of the train extent information." ;
    sh:order 2 ;
    rdfs:comment "ERTMS subset variable: Q_STATUSLRBG"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-position-qualifier/valid> <http://data.europa.eu/949/concepts/train-position-qualifier/ambiguous> <http://data.europa.eu/949/concepts/train-position-qualifier/unknown> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TrainPositionQualifier concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von TrainPositionQualifier entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de TrainPositionQualifier."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "The three defined values are: valid, ambiguous, unknown - corresponding to the ERTMS subset variable Q_STATUSLRBG. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these three defined concepts."@en ;
    era:additionalInfo "Die drei definierten Werte sind: valid, ambiguous, unknown - entsprechend der ERTMS-Subset-Variable Q_STATUSLRBG. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser drei definierten Konzepte."@de ;
    era:additionalInfo "Les trois valeurs définies sont : valid, ambiguous, unknown - correspondant à la variable ERTMS Subset Q_STATUSLRBG. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces trois concepts définis."@fr ;
    .

### ValidatedTrainData ################################################
opp-sh:ValidatedTrainDataShape
    a sh:NodeShape ;
    sh:targetClass era:ValidatedTrainData ;
    sh:name "ValidatedTrainData" ;
    sh:description "Defines the validated train data received from the train via ETCS" ;
    sh:sparql opp-sh:ValidatedTrainData-vMaxTrain-multipleOf ;
    sh:property opp-sh:ValidatedTrainData-cantDeficiencyCategory ;
    sh:property opp-sh:ValidatedTrainData-otherTrainCategory ;
    sh:property opp-sh:ValidatedTrainData-trainLength ;
    sh:property opp-sh:ValidatedTrainData-vMaxTrain ;
    sh:property opp-sh:ValidatedTrainData-loadingGaugeType ;
    sh:property opp-sh:ValidatedTrainData-axleLoadCategory ;
    sh:property opp-sh:ValidatedTrainData-airtight ;
    sh:property opp-sh:ValidatedTrainData-axleNumber ;
    sh:property opp-sh:ValidatedTrainData-tractionVoltage ;
    sh:property opp-sh:ValidatedTrainData-nidNtc ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-cantDeficiencyCategory
    a sh:PropertyShape ;
    sh:path era:cantDeficiencyCategory ;
    sh:name "cantDeficiencyCategory" ;
    sh:description "Defines the Cant Deficiency Train category to which the train belongs. see ss026, 7.5.1.82.2 NC_CDTRAIN" ;
    sh:order 1 ;
    rdfs:comment "ERTMS subset variable: NC_CDTRAIN"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/cant-deficiencies/80> <http://data.europa.eu/949/concepts/cant-deficiencies/100> <http://data.europa.eu/949/concepts/cant-deficiencies/130> <http://data.europa.eu/949/concepts/cant-deficiencies/150> <http://data.europa.eu/949/concepts/cant-deficiencies/165> <http://data.europa.eu/949/concepts/cant-deficiencies/180> <http://data.europa.eu/949/concepts/cant-deficiencies/210> <http://data.europa.eu/949/concepts/cant-deficiencies/225> <http://data.europa.eu/949/concepts/cant-deficiencies/245> <http://data.europa.eu/949/concepts/cant-deficiencies/275> <http://data.europa.eu/949/concepts/cant-deficiencies/300> ) ;
    sh:message "Value must be one of the CCSTMS-scoped CantDeficiencies concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von CantDeficiencies entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de CantDeficiencies."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "This uses the same eleven cant deficiency values (in millimetres) used elsewhere in this data model: 80, 100, 130, 150, 165, 180, 210, 225, 245, 275, 300, corresponding to the ERTMS subset variable NC_CDTRAIN (Subset 026, 7.5.1.82.2). Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these eleven defined concepts."@en ;
    era:additionalInfo "Dies verwendet dieselben elf Überhöhungsfehlbetrag-Werte (in Millimetern), die an anderer Stelle in diesem Datenmodell verwendet werden: 80, 100, 130, 150, 165, 180, 210, 225, 245, 275, 300, entsprechend der ERTMS-Subset-Variable NC_CDTRAIN (Subset 026, 7.5.1.82.2). Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser elf definierten Konzepte."@de ;
    era:additionalInfo "Ceci utilise les onze mêmes valeurs d'insuffisance de dévers (en millimètres) utilisées ailleurs dans ce modèle de données : 80, 100, 130, 150, 165, 180, 210, 225, 245, 275, 300, correspondant à la variable ERTMS Subset NC_CDTRAIN (Subset 026, 7.5.1.82.2). Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces onze concepts définis."@fr ;
    .

opp-sh:ValidatedTrainData-otherTrainCategory
    a sh:PropertyShape ;
    sh:path era:otherTrainCategory ;
    sh:name "otherTrainCategory" ;
    sh:description "Other train category (different from Cant Deficiency) to which the train belongs. Thanks to NC_TRAIN, the train knows the 'Other specific' SSP category it must consider. By receiving a list of static speed profile, thanks to NC_DIFF, the train can select the SSP it must obey. Each bit represents one category. A train can belong to various categories. see ss026, 7.5.1.84 NC_TRAIN" ;
    sh:order 2 ;
    rdfs:comment "ERTMS subset variable: NC_TRAIN"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/other-international-train-category/noCategory> <http://data.europa.eu/949/concepts/other-international-train-category/freightTrainP> <http://data.europa.eu/949/concepts/other-international-train-category/freightTrainG> <http://data.europa.eu/949/concepts/other-international-train-category/passengerTrain> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OtherInternationalTrainCategory concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von OtherInternationalTrainCategory entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de OtherInternationalTrainCategory."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "The four defined values are: noCategory, freightTrainP, freightTrainG, passengerTrain. Its own description explains the underlying mechanism: this tells the train which 'other specific' static speed profile category it must respect, and by receiving a matching list of static speed profiles (using the related NC_DIFF value), the train selects the one it must obey - each category is represented by one bit, so a train can genuinely belong to more than one category at once, even though this property itself only records one value at a time. There is no custom message defined beyond the shared enum check; note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these four defined concepts."@en ;
    era:additionalInfo "Die vier definierten Werte sind: noCategory, freightTrainP, freightTrainG, passengerTrain. Die eigene Beschreibung erklärt den zugrunde liegenden Mechanismus: dies teilt dem Zug mit, welche 'sonstige spezifische' statische Geschwindigkeitsprofilkategorie er beachten muss, und durch den Empfang einer passenden Liste statischer Geschwindigkeitsprofile (über den zugehörigen NC_DIFF-Wert) wählt der Zug dasjenige aus, dem er folgen muss - jede Kategorie wird durch ein Bit dargestellt, ein Zug kann also tatsächlich mehreren Kategorien gleichzeitig angehören, auch wenn diese Eigenschaft selbst nur einen Wert gleichzeitig erfasst. Über die geteilte Aufzählungsprüfung hinaus gibt es keine eigene Meldung; beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser vier definierten Konzepte."@de ;
    era:additionalInfo "Les quatre valeurs définies sont : noCategory, freightTrainP, freightTrainG, passengerTrain. Sa propre description explique le mécanisme sous-jacent : ceci indique au train quelle catégorie de profil de vitesse statique 'autre spécifique' il doit respecter, et en recevant une liste correspondante de profils de vitesse statiques (via la valeur NC_DIFF associée), le train sélectionne celui qu'il doit respecter - chaque catégorie est représentée par un bit, un train peut donc réellement appartenir à plusieurs catégories à la fois, même si cette propriété elle-même n'enregistre qu'une valeur à la fois. Au-delà de la vérification d'énumération partagée, il n'y a pas de message propre ; notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces quatre concepts définis."@fr ;
    .

opp-sh:ValidatedTrainData-trainLength
    a sh:PropertyShape ;
    sh:path era:trainLength ;
    sh:name "trainLength" ;
    sh:description "This is the length of the train acquired as Train Data. When the safe consist length is captured as part of valid Train Data, L_TRAIN is equal to L_CONSISTREARENGINEMAX, considering that valid Train Data can only be captured and sent to the RBC with the leading engine/cab located at the very front of the train. see ss026, 7.5.1.56 L_TRAIN" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    rdfs:comment "ERTMS subset variable: L_TRAIN"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 4095 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "trainLength's own description gives a specific relationship: when the safe consist length is what was captured as valid train data, this value equals L_CONSISTREARENGINEMAX, since valid train data can only be captured and sent to the RBC when the leading engine or cab is located at the very front of the train. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is outside the 0-4095 range."@en ;
    era:additionalInfo "Die eigene Beschreibung von trainLength nennt einen konkreten Zusammenhang: wenn die sichere Zugverbandslänge das ist, was als gültige Zugdaten erfasst wurde, entspricht dieser Wert L_CONSISTREARENGINEMAX, da gültige Zugdaten nur erfasst und an die RBC gesendet werden können, wenn sich die führende Lokomotive oder der Führerstand ganz vorne im Zug befindet. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert liegt außerhalb des Bereichs 0-4095."@de ;
    era:additionalInfo "La propre description de trainLength donne une relation précise : lorsque la longueur sûre de la rame est ce qui a été capturé comme données de train valides, cette valeur équivaut à L_CONSISTREARENGINEMAX, car des données de train valides ne peuvent être capturées et envoyées au RBC que lorsque la locomotive ou la cabine de tête se trouve tout à l'avant du train. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente est hors de la plage 0-4095."@fr ;
    .

opp-sh:ValidatedTrainData-vMaxTrain
    a sh:PropertyShape ;
    sh:path era:vMaxTrain ;
    sh:name "vMaxTrain" ;
    sh:description "Maximum train speed. Resolution is 5 Km/h. see ss026, 7.5.1.160 V_MAXTRAIN" ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    rdfs:comment "ERTMS subset variable: V_MAXTRAIN"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "vMaxTrain's own description states the resolution is 5 km/h, and unlike some similar speed fields elsewhere in this data model where that resolution is only documented, here it genuinely is enforced separately by a multiple-of-5 SPARQLConstraint with its own message. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is outside the 0-600 range."@en ;
    era:additionalInfo "Die eigene Beschreibung von vMaxTrain besagt, dass die Auflösung 5 km/h beträgt, und anders als bei einigen ähnlichen Geschwindigkeitsfeldern an anderer Stelle in diesem Datenmodell, wo diese Auflösung nur dokumentiert ist, wird sie hier tatsächlich separat durch eine Vielfaches-von-5-SPARQLConstraint mit eigener Meldung durchgesetzt. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert liegt außerhalb des Bereichs 0-600."@de ;
    era:additionalInfo "La propre description de vMaxTrain indique que la résolution est de 5 km/h, et contrairement à certains champs de vitesse similaires ailleurs dans ce modèle de données où cette résolution n'est que documentée, elle est ici réellement appliquée séparément par une SPARQLConstraint de multiple de 5 avec son propre message. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente est hors de la plage 0-600."@fr ;
    .

opp-sh:ValidatedTrainData-loadingGaugeType
    a sh:PropertyShape ;
    sh:path era:loadingGaugeType ;
    sh:name "loadingGaugeType" ;
    sh:description "Defining the loading gauge profile of a train (refer to LOC&PAS TSI). see ss026, 7.5.1.68 M_LOADINGGAUGE" ;
    sh:order 5 ;
    rdfs:comment "ERTMS subset variable: M_LOADINGGAUGE"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/loading-gauge-type/loadingGaugeIncompatible> <http://data.europa.eu/949/concepts/loading-gauge-type/g1> <http://data.europa.eu/949/concepts/loading-gauge-type/gA> <http://data.europa.eu/949/concepts/loading-gauge-type/gB> <http://data.europa.eu/949/concepts/loading-gauge-type/gC> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LoadingGaugeType concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von LoadingGaugeType entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de LoadingGaugeType."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "The five defined types are: loadingGaugeIncompatible, g1, gA, gB, gC - corresponding to the ERTMS subset variable M_LOADINGGAUGE (Subset 026, 7.5.1.68) and cross-referencing the LOC&PAS TSI. Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these five defined concepts."@en ;
    era:additionalInfo "Die fünf definierten Typen sind: loadingGaugeIncompatible, g1, gA, gB, gC - entsprechend der ERTMS-Subset-Variable M_LOADINGGAUGE (Subset 026, 7.5.1.68) und mit Querverweis auf die LOC&PAS-TSI. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser fünf definierten Konzepte."@de ;
    era:additionalInfo "Les cinq types définis sont : loadingGaugeIncompatible, g1, gA, gB, gC - correspondant à la variable ERTMS Subset M_LOADINGGAUGE (Subset 026, 7.5.1.68) et renvoyant à la TSI LOC&PAS. Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces cinq concepts définis."@fr ;
    .

opp-sh:ValidatedTrainData-axleLoadCategory
    a sh:PropertyShape ;
    sh:path era:axleLoadCategory ;
    sh:name "axleLoadCategory" ;
    sh:description "Axle load category (The values allocated below correspond to a list of increasing axle load categories (i.e. B1 > HS17, B2 > B1, D2 > C4, ….etc) and it is used by the on-board equipment to compare its axle load category with the axle load category sent by trackside.For the underlying meaning of the axle load categories listed below (with the exception of HS17) refer to CR INF TSI.The category HS17 (axle load <= 17t) corresponds to a static load per axle only, as specified in HS RST TSI clause 4.2.3.2. The introduction of this artefact is necessary to ensure backward compatibility, without any negative performance impact, in case ASPs are used on lines operated with system version X = 1).see ss026, 7.5.1.62 M_AXLELOADCAT" ;
    sh:order 6 ;
    rdfs:comment "ERTMS subset variable: M_AXLELOADCAT"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/load-capability-line-categories/10> <http://data.europa.eu/949/concepts/load-capability-line-categories/230> <http://data.europa.eu/949/concepts/load-capability-line-categories/20> <http://data.europa.eu/949/concepts/load-capability-line-categories/30> <http://data.europa.eu/949/concepts/load-capability-line-categories/40> <http://data.europa.eu/949/concepts/load-capability-line-categories/50> <http://data.europa.eu/949/concepts/load-capability-line-categories/60> <http://data.europa.eu/949/concepts/load-capability-line-categories/70> <http://data.europa.eu/949/concepts/load-capability-line-categories/80> <http://data.europa.eu/949/concepts/load-capability-line-categories/90> <http://data.europa.eu/949/concepts/load-capability-line-categories/100> <http://data.europa.eu/949/concepts/load-capability-line-categories/110> <http://data.europa.eu/949/concepts/load-capability-line-categories/120> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LoadCapabilityLineCategories concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von LoadCapabilityLineCategories entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de LoadCapabilityLineCategories."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "axleLoadCategory's own description states the thirteen values correspond to an ordered list of increasing axle load categories, with named worked examples: B1 is greater than HS17, B2 is greater than B1, and D2 is greater than C4. The on-board equipment compares its own category against the one sent by trackside using this ordering. The underlying meaning of each category (other than HS17) is defined in the CR INF TSI. HS17 (axle load 17 tonnes or less) is a special case: a simple static per-axle load limit rather than the fuller category definitions, introduced specifically for backward compatibility on lines still operating an older system version. This corresponds to the ERTMS subset variable M_AXLELOADCAT (Subset 026, 7.5.1.62). Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these thirteen defined concepts."@en ;
    era:additionalInfo "Die eigene Beschreibung von axleLoadCategory besagt, dass die dreizehn Werte einer geordneten Liste zunehmender Achslastkategorien entsprechen, mit benannten Beispielen: B1 ist größer als HS17, B2 ist größer als B1, und D2 ist größer als C4. Das Fahrzeuggerät vergleicht seine eigene Kategorie mit der von der Strecke gesendeten anhand dieser Reihenfolge. Die zugrunde liegende Bedeutung jeder Kategorie (außer HS17) ist in der CR INF TSI definiert. HS17 (Achslast 17 Tonnen oder weniger) ist ein Sonderfall: eine einfache statische Achslastgrenze statt der ausführlicheren Kategoriedefinitionen, speziell zur Abwärtskompatibilität auf Strecken eingeführt, die noch eine ältere Systemversion betreiben. Dies entspricht der ERTMS-Subset-Variable M_AXLELOADCAT (Subset 026, 7.5.1.62). Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser dreizehn definierten Konzepte."@de ;
    era:additionalInfo "La propre description de axleLoadCategory indique que les treize valeurs correspondent à une liste ordonnée de catégories de charge à l'essieu croissantes, avec des exemples nommés : B1 est supérieure à HS17, B2 est supérieure à B1, et D2 est supérieure à C4. L'équipement embarqué compare sa propre catégorie à celle envoyée par la voie en utilisant cet ordre. La signification sous-jacente de chaque catégorie (hormis HS17) est définie dans la CR INF TSI. HS17 (charge à l'essieu de 17 tonnes ou moins) est un cas particulier : une simple limite de charge statique par essieu plutôt que les définitions de catégorie plus complètes, introduite spécifiquement pour la compatibilité ascendante sur les lignes exploitant encore une ancienne version du système. Ceci correspond à la variable ERTMS Subset M_AXLELOADCAT (Subset 026, 7.5.1.62). Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces treize concepts définis."@fr ;
    .

opp-sh:ValidatedTrainData-airtight
    a sh:PropertyShape ;
    sh:path era:airtight ;
    sh:name "airtight" ;
    sh:description "indicates whether the train is fitted with an airtight system or not. see ss026, 7.5.1.61 M_AIRTIGHT" ;
    sh:order 7 ;
    rdfs:comment "ERTMS subset variable: M_AIRTIGHT"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/airtight-type/notFitted> <http://data.europa.eu/949/concepts/airtight-type/fitted> ) ;
    sh:message "Value must be one of the CCSTMS-scoped AirtightType concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von AirtightType entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de AirtightType."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "The two defined values are: notFitted, fitted - corresponding to the ERTMS subset variable M_AIRTIGHT (Subset 026, 7.5.1.61). Note that the message shown is shared across three different possible causes: the value is missing entirely, more than one value is recorded, or the value present is not one of these two defined concepts."@en ;
    era:additionalInfo "Die zwei definierten Werte sind: notFitted, fitted - entsprechend der ERTMS-Subset-Variable M_AIRTIGHT (Subset 026, 7.5.1.61). Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keines dieser zwei definierten Konzepte."@de ;
    era:additionalInfo "Les deux valeurs définies sont : notFitted, fitted - correspondant à la variable ERTMS Subset M_AIRTIGHT (Subset 026, 7.5.1.61). Notez que le message affiché couvre trois causes possibles distinctes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente ne correspond à aucun de ces deux concepts définis."@fr ;
    .

opp-sh:ValidatedTrainData-axleNumber
    a sh:PropertyShape ;
    sh:path era:axleNumber ;
    sh:name "axleNumber" ;
    sh:description "This gives the number of axles of the single unit (fixed train set or locomotive) in which the onboard equipment is fitted. See ss026, 7.5.1.79.1 N_AXLE" ;
    sh:order 8 ;
    rdfs:comment "ERTMS subset variable: N_AXLE"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "axleNumber is a 10-bit field - its range of 0 to 1023 is the largest value representable in 10 bits, matching the ERTMS subset variable N_AXLE (Subset 026, 7.5.1.79.1). Its own description clarifies this counts the axles of the single unit the on-board equipment is fitted in, not the whole train. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is outside the 0-1023 range."@en ;
    era:additionalInfo "axleNumber ist ein 10-Bit-Feld - sein Bereich von 0 bis 1023 ist der größte in 10 Bit darstellbare Wert, entsprechend der ERTMS-Subset-Variable N_AXLE (Subset 026, 7.5.1.79.1). Die eigene Beschreibung stellt klar, dass hierbei die Achsen der einzelnen Einheit gezählt werden, in der das Fahrzeuggerät verbaut ist, nicht des gesamten Zuges. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert liegt außerhalb des Bereichs 0-1023."@de ;
    era:additionalInfo "axleNumber est un champ de 10 bits - sa plage de 0 à 1023 est la plus grande valeur représentable sur 10 bits, correspondant à la variable ERTMS Subset N_AXLE (Subset 026, 7.5.1.79.1). Sa propre description précise que ceci compte les essieux de l'unité unique dans laquelle l'équipement embarqué est installé, non l'ensemble du train. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente est hors de la plage 0-1023."@fr ;
    .

opp-sh:ValidatedTrainData-tractionVoltage
    a sh:PropertyShape ;
    sh:path era:tractionVoltage ;
    sh:name "tractionVoltage" ;
    sh:description "supported Traction System voltage. see ss026, 7.4.3.5. Identity of the traction system NID_CTRACTION(k) given only if M_VOLTAGE(k) ≠ 0" ;
    sh:order 9 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:TractionVoltageShape ;
    sh:message "tractionVoltage must be a well-formed TractionVoltage (blank node or IRI)."@en ;
    sh:message "tractionVoltage muss ein wohlgeformtes TractionVoltage sein (Blank Node oder IRI)."@de ;
    sh:message "tractionVoltage doit être un TractionVoltage bien formé (nœud vide ou IRI)."@fr ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    era:additionalInfo "This property has no minCount, so a record with no traction voltage information at all is valid. Note that the message shown is shared across three different possible causes: more than 31 values are recorded, a value is present but is neither a blank node nor an IRI, or a value fails to satisfy the nested TractionVoltage shape itself."@en ;
    era:additionalInfo "Diese Eigenschaft hat kein minCount, ein Eintrag ganz ohne Traktionsspannungsinformationen ist also gültig. Beachten Sie, dass die angezeigte Meldung drei unterschiedliche mögliche Ursachen abdeckt: mehr als 31 Werte sind erfasst, ein Wert ist vorhanden, aber weder Blank Node noch IRI, oder ein Wert erfüllt die verschachtelte TractionVoltage-Shape selbst nicht."@de ;
    era:additionalInfo "Cette propriété n'a pas de minCount, un enregistrement sans aucune information de tension de traction est donc valide. Notez que le message affiché couvre trois causes possibles distinctes : plus de 31 valeurs sont enregistrées, une valeur est présente mais n'est ni un nœud vide ni une IRI, ou une valeur ne satisfait pas la shape TractionVoltage imbriquée elle-même."@fr ;
    .

opp-sh:ValidatedTrainData-nidNtc
    a sh:PropertyShape ;
    sh:path era:nidNtc ;
    sh:name "nidNtc" ;
    sh:description "National System identity (Each value of this variable represents the identity of a National System). see ss026, 7.5.1.98 NID_NTC" ;
    sh:order 10 ;
    rdfs:comment "ERTMS subset variable: NID_NTC"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    era:additionalInfo "nidNtc is an 8-bit field - its range of 0 to 255 is the largest value representable in 8 bits, corresponding to the ERTMS subset variable NID_NTC (Subset 026, 7.5.1.98). Unlike the singular nidNtc-style properties found elsewhere in this data model, this one may carry up to 31 values rather than exactly one, since a train may support several national systems at once. There is no custom message defined for this specific check, so the validation engine's own generic text is shown if a value present is outside the 0-255 range."@en ;
    era:additionalInfo "nidNtc ist ein 8-Bit-Feld - sein Bereich von 0 bis 255 ist der größte in 8 Bit darstellbare Wert, entsprechend der ERTMS-Subset-Variable NID_NTC (Subset 026, 7.5.1.98). Anders als die an anderer Stelle in diesem Datenmodell vorkommenden Eigenschaften im Stil eines einzelnen nid_ntc kann diese bis zu 31 Werte tragen statt genau einem, da ein Zug mehrere nationale Systeme gleichzeitig unterstützen kann. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine angezeigt, wenn ein vorhandener Wert außerhalb des Bereichs 0-255 liegt."@de ;
    era:additionalInfo "nidNtc est un champ de 8 bits - sa plage de 0 à 255 est la plus grande valeur représentable sur 8 bits, correspondant à la variable ERTMS Subset NID_NTC (Subset 026, 7.5.1.98). Contrairement aux propriétés de type nid_ntc singulier présentes ailleurs dans ce modèle de données, celle-ci peut porter jusqu'à 31 valeurs plutôt qu'exactement une, car un train peut prendre en charge plusieurs systèmes nationaux à la fois. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché si une valeur présente est hors de la plage 0-255."@fr ;
    .

opp-sh:ValidatedTrainData-vMaxTrain-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "vMaxTrain must be a multiple of 5 km/h."@en ;
    sh:message "vMaxTrain muss ein Vielfaches von 5 km/h sein."@de ;
    sh:message "vMaxTrain doit être un multiple de 5 km/h."@fr ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:vMaxTrain ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

### TractionVoltage ###################################################
opp-sh:TractionVoltageShape
    a sh:NodeShape ;
    sh:targetClass era:TractionVoltage ;
    sh:name "TractionVoltage" ;
    sh:description "It indicates the voltage of the traction system installed on a specific line or respectively that can be used by an engine" ;
    sh:property opp-sh:TractionVoltage-mVoltage ;
    sh:property opp-sh:TractionVoltage-countryTractionId ;
    sh:severity sh:Violation ;
    .

opp-sh:TractionVoltage-mVoltage
    a sh:PropertyShape ;
    sh:path era:mVoltage ;
    sh:name "mVoltage" ;
    sh:description "Special/Reserved values for Traction System voltage. It indicates the voltage of the traction system installed on a specific line or respectively that can be used by an engine. The identity of the traction system is given by M_VOLTAGE and, if M_VOLTAGE ≠ 0, by the country identifier of the traction system (NID_CTRACTION). see ss026,7.5.1.78 M_VOLTAGE" ;
    sh:order 1 ;
    rdfs:comment "ERTMS subset variable: M_VOLTAGE"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/energy-supply-systems/notFitted> <http://data.europa.eu/949/concepts/energy-supply-systems/AC10> <http://data.europa.eu/949/concepts/energy-supply-systems/AC20> <http://data.europa.eu/949/concepts/energy-supply-systems/DC30> <http://data.europa.eu/949/concepts/energy-supply-systems/DC40> <http://data.europa.eu/949/concepts/energy-supply-systems/DC80> <http://data.europa.eu/949/concepts/energy-supply-systems/DC70> <http://data.europa.eu/949/concepts/energy-supply-systems/DC60> <http://data.europa.eu/949/concepts/energy-supply-systems/DC90> ) ;
    sh:message "Value must be one of the CCSTMS-scoped EnergySupplySystems concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von EnergySupplySystems entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de EnergySupplySystems."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TractionVoltage-countryTractionId
    a sh:PropertyShape ;
    sh:path era:countryTractionId ;
    sh:name "countryTractionId" ;
    sh:description "Country identifier of the traction system. It identifies the information, additional to M_VOLTAGE, required to fully define the traction system. Note that NID_CTRACTION given only if M_VOLTAGE ≠ 0. see ss026,7.5.1.86.1 NID_CTRACTION" ;
    sh:order 2 ;
    rdfs:comment "ERTMS subset variable: NID_CTRACTION"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "countryTractionId is a 10-bit field - its range of 0 to 1023 is the largest value representable in 10 bits, corresponding to the ERTMS subset variable NID_CTRACTION (Subset 026, 7.5.1.86.1). Its own description states it is only meaningful together with mVoltage on this same object, providing the additional information needed to fully identify the traction system when mVoltage indicates one other than notFitted. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for either of two causes: more than one value is recorded, or the value present is outside the 0-1023 range."@en ;
    era:additionalInfo "countryTractionId ist ein 10-Bit-Feld - sein Bereich von 0 bis 1023 ist der größte in 10 Bit darstellbare Wert, entsprechend der ERTMS-Subset-Variable NID_CTRACTION (Subset 026, 7.5.1.86.1). Die eigene Beschreibung besagt, dass sie nur zusammen mit mVoltage an demselben Objekt aussagekräftig ist und die zusätzliche Information liefert, die zur vollständigen Identifizierung des Traktionssystems benötigt wird, wenn mVoltage etwas anderes als notFitted anzeigt. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für eine von zwei Ursachen angezeigt: es ist mehr als ein Wert erfasst, oder der vorhandene Wert liegt außerhalb des Bereichs 0-1023."@de ;
    era:additionalInfo "countryTractionId est un champ de 10 bits - sa plage de 0 à 1023 est la plus grande valeur représentable sur 10 bits, correspondant à la variable ERTMS Subset NID_CTRACTION (Subset 026, 7.5.1.86.1). Sa propre description indique qu'elle n'a de sens qu'avec mVoltage sur ce même objet, fournissant l'information supplémentaire nécessaire pour identifier pleinement le système de traction lorsque mVoltage indique autre chose que notFitted. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour l'une de deux causes : plus d'une valeur est enregistrée, ou la valeur présente est hors de la plage 0-1023."@fr ;
    .

### MovementPermission ################################################
opp-sh:MovementPermissionShape
    a sh:NodeShape ;
    sh:targetClass era:MovementPermission ;
    sh:name "MovementPermission" ;
    sh:description "Defines path and speed profiles assigned to a train for its next movement." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    sh:property opp-sh:MovementPermission-riskBuffer ;
    sh:property opp-sh:MovementPermission-riskPaths ;
    sh:property opp-sh:MovementPermission-permissionExtent ;
    sh:property opp-sh:MovementPermission-mpOnboardOperatingModes ;
    sh:property opp-sh:MovementPermission-mpSpeeds ;
    sh:property opp-sh:MovementPermission-excludedSTAForFlankProtection ;
    sh:property opp-sh:MovementPermission-currentEoA ;
    sh:property opp-sh:MovementPermission-pendingCooperativeShorteningRequests ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementPermission-riskBuffer
    a sh:PropertyShape ;
    sh:path era:riskBuffer ;
    sh:name "riskBuffer" ;
    sh:description "Defines the risk buffer for a movement permission = overlap after MP. Extent risk buffer for a Movement Permission." ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetLinearReferenceShape ;
    sh:message "riskBuffer must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:message "riskBuffer muss ein wohlgeformtes NetLinearReference sein (Blank Node oder IRI)."@de ;
    sh:message "riskBuffer doit être un NetLinearReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementPermission-riskPaths
    a sh:PropertyShape ;
    sh:path era:riskPaths ;
    sh:name "riskPaths" ;
    sh:description "Defines flank protection area on the neighbouring tracks. Collection of applied Risk Paths of Movement Permission" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetLinearReferenceShape ;
    sh:message "riskPaths must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:message "riskPaths muss ein wohlgeformtes NetLinearReference sein (Blank Node oder IRI)."@de ;
    sh:message "riskPaths doit être un NetLinearReference bien formé (nœud vide ou IRI)."@fr ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementPermission-permissionExtent
    a sh:PropertyShape ;
    sh:path era:permissionExtent ;
    sh:name "permissionExtent" ;
    sh:description "Extent of the Movement Permission" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetLinearReferenceShape ;
    sh:message "permissionExtent must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:message "permissionExtent muss ein wohlgeformtes NetLinearReference sein (Blank Node oder IRI)."@de ;
    sh:message "permissionExtent doit être un NetLinearReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementPermission-mpOnboardOperatingModes
    a sh:PropertyShape ;
    sh:path era:mpOnboardOperatingModes ;
    sh:name "mpOnboardOperatingModes" ;
    sh:description "Applied mode profile" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:MpOnboardOperatingModeShape ;
    sh:message "mpOnboardOperatingModes must be a well-formed MpOnboardOperatingMode (blank node or IRI)."@en ;
    sh:message "mpOnboardOperatingModes muss ein wohlgeformtes MpOnboardOperatingMode sein (Blank Node oder IRI)."@de ;
    sh:message "mpOnboardOperatingModes doit être un MpOnboardOperatingMode bien formé (nœud vide ou IRI)."@fr ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementPermission-mpSpeeds
    a sh:PropertyShape ;
    sh:path era:mpSpeeds ;
    sh:name "mpSpeeds" ;
    sh:description "Applied speed profile" ;
    sh:order 6 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:MpSpeedShape ;
    sh:message "mpSpeeds must be a well-formed MpSpeed (blank node or IRI)."@en ;
    sh:message "mpSpeeds muss ein wohlgeformtes MpSpeed sein (Blank Node oder IRI)."@de ;
    sh:message "mpSpeeds doit être un MpSpeed bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementPermission-excludedSTAForFlankProtection
    a sh:PropertyShape ;
    sh:path era:excludedSTAForFlankProtection ;
    sh:name "excludedSTAForFlankProtection" ;
    sh:description "Set of Switchable Trackside Assets excluded from flank protection" ;
    sh:order 7 ;
    sh:nodeKind sh:IRI ;
    sh:class era:SwitchableTracksideAsset ;
    sh:message "excludedSTAForFlankProtection must reference an existing era:SwitchableTracksideAsset by IRI."@en ;
    sh:message "excludedSTAForFlankProtection muss über eine IRI auf ein bestehendes era:SwitchableTracksideAsset verweisen."@de ;
    sh:message "excludedSTAForFlankProtection doit référencer un era:SwitchableTracksideAsset existant par IRI."@fr ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementPermission-currentEoA
    a sh:PropertyShape ;
    sh:path era:currentEoA ;
    sh:name "currentEoA" ;
    sh:description "Current End of Authority of associated Movement Authority" ;
    sh:order 8 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetPointReferenceShape ;
    sh:message "currentEoA must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:message "currentEoA muss ein wohlgeformtes NetPointReference sein (Blank Node oder IRI)."@de ;
    sh:message "currentEoA doit être un NetPointReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementPermission-pendingCooperativeShorteningRequests
    a sh:PropertyShape ;
    sh:path era:pendingCooperativeShorteningRequests ;
    sh:name "pendingCooperativeShorteningRequests" ;
    sh:description "Pending requests for cooperative shortening of Movement Authority" ;
    sh:order 9 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:CooperativeShorteningRequestShape ;
    sh:message "pendingCooperativeShorteningRequests must be a well-formed CooperativeShorteningRequest (blank node or IRI)."@en ;
    sh:message "pendingCooperativeShorteningRequests muss ein wohlgeformtes CooperativeShorteningRequest sein (Blank Node oder IRI)."@de ;
    sh:message "pendingCooperativeShorteningRequests doit être un CooperativeShorteningRequest bien formé (nœud vide ou IRI)."@fr ;
    sh:severity sh:Violation ;
    .

### MpSpeed ###########################################################
opp-sh:MpSpeedShape
    a sh:NodeShape ;
    sh:targetClass era:MpSpeed ;
    sh:name "MpSpeed" ;
    sh:description "Defines speed-restriction section of the path defined in a movement permission." ;
    sh:property opp-sh:MpSpeed-vMax ;
    sh:property opp-sh:MpSpeed-linkedPath ;
    sh:severity sh:Violation ;
    .

opp-sh:MpSpeed-vMax
    a sh:PropertyShape ;
    sh:path era:vMax ;
    sh:name "Maximum Applicable Speed" ;
    sh:description "Defines the maximum applicable speed for movement permission along the assigned path" ;
    sh:order 1 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

opp-sh:MpSpeed-linkedPath
    a sh:PropertyShape ;
    sh:path era:linkedPath ;
    sh:name "linkedPath" ;
    sh:description "refers the applicable path" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetLinearReferenceShape ;
    sh:message "linkedPath must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:message "linkedPath muss ein wohlgeformtes NetLinearReference sein (Blank Node oder IRI)."@de ;
    sh:message "linkedPath doit être un NetLinearReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### MpOnboardOperatingMode ############################################
opp-sh:MpOnboardOperatingModeShape
    a sh:NodeShape ;
    sh:targetClass era:MpOnboardOperatingMode ;
    sh:name "MpOnboardOperatingMode" ;
    sh:description "Defines inside of a movement permission, which parts of the reserved path can be driven in which ETCS mode." ;
    sh:property opp-sh:MpOnboardOperatingMode-onboardOperatingMode ;
    sh:property opp-sh:MpOnboardOperatingMode-linkedPath ;
    sh:severity sh:Violation ;
    .

opp-sh:MpOnboardOperatingMode-onboardOperatingMode
    a sh:PropertyShape ;
    sh:path era:onboardOperatingMode ;
    sh:name "onboardOperatingMode" ;
    sh:description "Defines the applicable driving mode along the associated path" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/onboard-operating-mode/fullSupervision> <http://data.europa.eu/949/concepts/onboard-operating-mode/onSight> <http://data.europa.eu/949/concepts/onboard-operating-mode/staffResponsible> <http://data.europa.eu/949/concepts/onboard-operating-mode/shunting> <http://data.europa.eu/949/concepts/onboard-operating-mode/unfitted> <http://data.europa.eu/949/concepts/onboard-operating-mode/sleeping> <http://data.europa.eu/949/concepts/onboard-operating-mode/standBy> <http://data.europa.eu/949/concepts/onboard-operating-mode/trip> <http://data.europa.eu/949/concepts/onboard-operating-mode/postTrip> <http://data.europa.eu/949/concepts/onboard-operating-mode/systemFailure> <http://data.europa.eu/949/concepts/onboard-operating-mode/isolation> <http://data.europa.eu/949/concepts/onboard-operating-mode/nonLeading> <http://data.europa.eu/949/concepts/onboard-operating-mode/limitedSupervision> <http://data.europa.eu/949/concepts/onboard-operating-mode/nationalSystem> <http://data.europa.eu/949/concepts/onboard-operating-mode/reversing> <http://data.europa.eu/949/concepts/onboard-operating-mode/passiveShunting> <http://data.europa.eu/949/concepts/onboard-operating-mode/automaticDriving> <http://data.europa.eu/949/concepts/onboard-operating-mode/supervisedManoeuvre> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OnboardOperatingMode concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von OnboardOperatingMode entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de OnboardOperatingMode."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MpOnboardOperatingMode-linkedPath
    a sh:PropertyShape ;
    sh:path era:linkedPath ;
    sh:name "linkedPath" ;
    sh:description "refers the applicable path" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetLinearReferenceShape ;
    sh:message "linkedPath must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:message "linkedPath muss ein wohlgeformtes NetLinearReference sein (Blank Node oder IRI)."@de ;
    sh:message "linkedPath doit être un NetLinearReference bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### CooperativeShorteningRequest ######################################
opp-sh:CooperativeShorteningRequestShape
    a sh:NodeShape ;
    sh:targetClass era:CooperativeShorteningRequest ;
    sh:name "CooperativeShorteningRequest" ;
    sh:description "Defines a request to PES to reduce the movement permission and the risk buffer for a slowed-down train" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    sh:property opp-sh:CooperativeShorteningRequest-trainObjectReference ;
    sh:property opp-sh:CooperativeShorteningRequest-newMpEnd ;
    sh:property opp-sh:CooperativeShorteningRequest-riskBuffer ;
    sh:severity sh:Violation ;
    .

opp-sh:CooperativeShorteningRequest-trainObjectReference
    a sh:PropertyShape ;
    sh:path era:trainObjectReference ;
    sh:name "trainObjectReference" ;
    sh:description "Defines a TrainObject-reference for which the shortening is needed" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:TrainObject ;
    sh:message "trainObjectReference must reference an existing era:TrainObject by IRI."@en ;
    sh:message "trainObjectReference muss über eine IRI auf ein bestehendes era:TrainObject verweisen."@de ;
    sh:message "trainObjectReference doit référencer un era:TrainObject existant par IRI."@fr ;
