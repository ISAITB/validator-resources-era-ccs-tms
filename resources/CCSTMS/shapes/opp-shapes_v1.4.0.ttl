    sh:property opp-sh:UsageRestrictionEventState-usageRestrictionEvent ;
    sh:property opp-sh:UsageRestrictionEventState-issuedAt ;
    sh:property opp-sh:UsageRestrictionEventState-usageRestrictionState ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionEventState-usageRestrictionEvent
    a sh:PropertyShape ;
    sh:path era:usageRestrictionEvent ;
    sh:name "usageRestrictionEvent" ;
    sh:description "refers to planned restriction event inclusive the operational plan restriction" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:UsageRestrictionEvent ;
    sh:message "usageRestrictionEvent must reference an existing era:UsageRestrictionEvent by IRI."@en ;
    sh:message "usageRestrictionEvent muss über eine IRI auf ein bestehendes era:UsageRestrictionEvent verweisen."@de ;
    sh:message "usageRestrictionEvent doit référencer un era:UsageRestrictionEvent existant par IRI."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionEventState-issuedAt
    a sh:PropertyShape ;
    sh:path era:issuedAt ;
    sh:name "issuedAt" ;
    sh:description "Defines the issue-point in time with microsecond-resolution builds a version-id for acknowledgements and validity-estimations, in UTC" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "issuedAt's own description states this microsecond-resolution timestamp itself functions as a version identifier, used for acknowledgements and validity checks. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid date-time."@en ;
    era:additionalInfo "Die eigene Beschreibung von issuedAt besagt, dass dieser Zeitstempel mit Mikrosekundenauflösung selbst als Versionskennung fungiert, die für Bestätigungen und Gültigkeitsprüfungen verwendet wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein gültiges Datum/Zeit."@de ;
    era:additionalInfo "La propre description de issuedAt indique que cet horodatage à résolution microseconde fonctionne lui-même comme un identifiant de version, utilisé pour les accusés de réception et les vérifications de validité. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas une date-heure valide."@fr ;
    .

opp-sh:UsageRestrictionEventState-usageRestrictionState
    a sh:PropertyShape ;
    sh:path era:usageRestrictionState ;
    sh:name "usageRestrictionState" ;
    sh:description "Defines the current state of the associated UsageRestriction." ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:UsageRestrictionStateShape ;
    sh:message "usageRestrictionState must be a well-formed UsageRestrictionState (blank node or IRI)."@en ;
    sh:message "usageRestrictionState muss ein wohlgeformtes UsageRestrictionState sein (Blank Node oder IRI)."@de ;
    sh:message "usageRestrictionState doit être un UsageRestrictionState bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### WarningAreaState ##################################################
opp-sh:WarningAreaStateShape
    a sh:NodeShape ;
    sh:targetClass era:WarningAreaState ;
    sh:name "WarningAreaState" ;
    sh:description "Defines the state of a WarningMeasureEvent (activated/deactivated)." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:WarningAreaState-warningState ;
    sh:property opp-sh:WarningAreaState-warningArea ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningAreaState-warningState
    a sh:PropertyShape ;
    sh:path era:warningState ;
    sh:name "warningState" ;
    sh:description "Defines if the warning area was activated or deactivated" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/event-state/activated> <http://data.europa.eu/949/concepts/event-state/deactivated> ) ;
    sh:message "Value must be one of the CCSTMS-scoped EventState concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von EventState entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de EventState."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningAreaState-warningArea
    a sh:PropertyShape ;
    sh:path era:warningArea ;
    sh:name "warningArea" ;
    sh:description "Defines the warning area associated with the warning area state. Always provided = mandatory, except for the warningState==deactivated." ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:WarningAreaShape ;
    sh:message "warningArea must be a well-formed WarningArea (blank node or IRI)."@en ;
    sh:message "warningArea muss ein wohlgeformtes WarningArea sein (Blank Node oder IRI)."@de ;
    sh:message "warningArea doit être un WarningArea bien formé (nœud vide ou IRI)."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### WarningMeasureEventState ##########################################
opp-sh:WarningMeasureEventStateShape
    a sh:NodeShape ;
    sh:targetClass era:WarningMeasureEventState ;
    sh:name "WarningMeasureEventState" ;
    sh:description "Defines the state of a planned Warning Measure Event or a newly created Warning Area" ;
    sh:property opp-sh:WarningMeasureEventState-warningMeasureEvent ;
    sh:property opp-sh:WarningMeasureEventState-issuedAt ;
    sh:property opp-sh:WarningMeasureEventState-warningAreaState ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningMeasureEventState-warningMeasureEvent
    a sh:PropertyShape ;
    sh:path era:warningMeasureEvent ;
    sh:name "warningMeasureEvent" ;
    sh:description "refers to planned warning measure event (if planned)" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:WarningMeasureEvent ;
    sh:message "warningMeasureEvent must reference an existing era:WarningMeasureEvent by IRI."@en ;
    sh:message "warningMeasureEvent muss über eine IRI auf ein bestehendes era:WarningMeasureEvent verweisen."@de ;
    sh:message "warningMeasureEvent doit référencer un era:WarningMeasureEvent existant par IRI."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

