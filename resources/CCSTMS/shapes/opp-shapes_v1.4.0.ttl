    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoStatus-isSlipping
    a sh:PropertyShape ;
    sh:path era:isSlipping ;
    sh:name "isSlipping" ;
    sh:description "Defines if the wheel slip occurs. Defined in SS126.STR.Q_STR_Indicators.bit7" ;
    sh:order 11 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoStatus-speed
    a sh:PropertyShape ;
    sh:path era:speed ;
    sh:name "speed" ;
    sh:description "current speed of the train. Defined in SS126.STR.V_TRAIN_ATO" ;
    sh:order 12 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoStatus-trainLength
    a sh:PropertyShape ;
    sh:path era:trainLength ;
    sh:name "trainLength" ;
    sh:description "Defines the train length. Defined in SS126.STR.L_TRAIN" ;
    sh:order 13 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoStatus-driverId
    a sh:PropertyShape ;
    sh:path era:driverId ;
    sh:name "driverId" ;
    sh:description "Defines the driver id for the train unit. Defined in SS126.STR.DRIVER_ID" ;
    sh:order 14 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoStatus-frontPosition
    a sh:PropertyShape ;
    sh:path era:frontPosition ;
    sh:name "frontPosition" ;
    sh:description "Defines the train front position with respect to the track edge direction. This direction can be deduced from JP and STR in SS 126. Optional as SS126 allows OBU to send 'undefined'" ;
    sh:order 15 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetPointReferenceShape ;
    sh:message "frontPosition must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoStatus-eventHandling
    a sh:PropertyShape ;
    sh:path era:eventHandling ;
    sh:name "eventHandling" ;
    sh:description "defines how the previous event was handled" ;
    sh:order 16 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:EventHandlingShape ;
    sh:message "eventHandling must be a well-formed EventHandling (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoStatus-eventEstimations
    a sh:PropertyShape ;
    sh:path era:eventEstimations ;
    sh:name "eventEstimations" ;
    sh:description "Refers to event estimations" ;
    sh:order 17 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "eventEstimations is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node opp-sh:TrainUnitReportAtoStatus-eventEstimations-items ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoStatus-eventEstimations-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "era:eventEstimations is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:eventEstimations ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

opp-sh:TrainUnitReportAtoStatus-eventEstimations-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:eventEstimations"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node opp-sh:EventEstimationShape ;
        sh:message "eventEstimations must be a well-formed EventEstimation (blank node or IRI)."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

### EventHandling #####################################################
opp-sh:EventHandlingShape
    a sh:NodeShape ;
