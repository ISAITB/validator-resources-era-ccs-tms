opp-sh:SpecificMovementRestriction-dasInhibition-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:dasInhibition is present"@en ;
    sh:property opp-sh:SpecificMovementRestriction-dasInhibition-required ;
    .

opp-sh:SpecificMovementRestriction-dasInhibition-required
    a sh:PropertyShape ;
    sh:path era:dasInhibition ;
    sh:minCount 1 ;
    .

opp-sh:SpecificMovementRestriction-excludedSwitchableTracksideAssetsForFlankProtection-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:excludedSwitchableTracksideAssetsForFlankProtection is present"@en ;
    sh:property opp-sh:SpecificMovementRestriction-excludedSwitchableTracksideAssetsForFlankProtection-required ;
    .

opp-sh:SpecificMovementRestriction-excludedSwitchableTracksideAssetsForFlankProtection-required
    a sh:PropertyShape ;
    sh:path era:excludedSwitchableTracksideAssetsForFlankProtection ;
    sh:minCount 1 ;
    .

### MovementEvent #####################################################
opp-sh:MovementEventShape
    a sh:NodeShape ;
    sh:targetClass era:MovementEvent ;
    sh:name "MovementEvent" ;
    sh:description "Defines an operational activity on a specific point in space and time for a train run." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:sparql opp-sh:MovementEvent-pathToNextEvent-listWellFormed ;
    sh:property opp-sh:MovementEvent-plannedType ;
    sh:property opp-sh:MovementEvent-scheduledType ;
    sh:property opp-sh:MovementEvent-alignment ;
    sh:property opp-sh:MovementEvent-position ;
    sh:property opp-sh:MovementEvent-pathToNextEvent ;
    sh:property opp-sh:MovementEvent-stopDescription ;
    sh:property opp-sh:MovementEvent-scheduledArrival ;
    sh:property opp-sh:MovementEvent-scheduledArrivalWindow ;
    sh:property opp-sh:MovementEvent-startsAfterEvents ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEvent-plannedType
    a sh:PropertyShape ;
    sh:path era:plannedType ;
    sh:name "plannedType" ;
    sh:description "Defines if stopping or passing was planned" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/movement-event-type/pass> <http://data.europa.eu/949/concepts/movement-event-type/stop> ) ;
    sh:message "Value must be one of the CCSTMS-scoped MovementEventType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEvent-scheduledType
    a sh:PropertyShape ;
    sh:path era:scheduledType ;
    sh:name "scheduledType" ;
    sh:description "Defines if stopping or passing is scheduled" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/movement-event-type/pass> <http://data.europa.eu/949/concepts/movement-event-type/stop> ) ;
    sh:message "Value must be one of the CCSTMS-scoped MovementEventType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEvent-alignment
    a sh:PropertyShape ;
    sh:path era:alignment ;
    sh:name "alignment" ;
    sh:description "Defines the train-alignment at position-attribute (head, center, end). Defined in SS126.STR." ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/alignment-type/head> <http://data.europa.eu/949/concepts/alignment-type/center> <http://data.europa.eu/949/concepts/alignment-type/rear> ) ;
    sh:message "Value must be one of the CCSTMS-scoped AlignmentType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEvent-position
    a sh:PropertyShape ;
    sh:path era:position ;
    sh:name "position" ;
    sh:description "Defines position on a linearElement for the movement event" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetPointReferenceShape ;
    sh:message "position must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEvent-pathToNextEvent
    a sh:PropertyShape ;
    sh:path era:pathToNextEvent ;
    sh:name "pathToNextEvent" ;
    sh:description "Defines the path-partafter the LinearElement of the position-value and before the linear element of the nextEvent (excluding). The path must be reconstructable without graph-search algorithms. The path remains empty, if 1) same linearElement in both events, 2) no driving activity in between e.g. in Joining, Splitting, turnAround, trainReplacement." ;
    sh:order 6 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "pathToNextEvent is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node opp-sh:MovementEvent-pathToNextEvent-items ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEvent-stopDescription
    a sh:PropertyShape ;
    sh:path era:stopDescription ;
    sh:name "stopDescription" ;
    sh:description "Defines the stop description in case of a stop of the train" ;
    sh:order 7 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:StopDescriptionShape ;
    sh:message "stopDescription must be a well-formed StopDescription (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEvent-scheduledArrival
    a sh:PropertyShape ;
    sh:path era:scheduledArrival ;
    sh:name "scheduledArrival" ;
    sh:description "Defines the scheduled arrival time. equal to scheduledDeparture for a passing train, see latestArrival inSS126. In the first station it is time of 'start of mission', in UTC" ;
    sh:order 8 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEvent-scheduledArrivalWindow
    a sh:PropertyShape ;
    sh:path era:scheduledArrivalWindow ;
    sh:name "scheduledArrivalWindow" ;
    sh:description "Defines the scheduled arrival window. scheduledEarliestArrival = scheduledArrival - scheduledArrivalWindow. For passing trains scheduledEarliestDeparture = scheduledEarliestArrival, see arrivalWindow in SS126. In the first station it is a time window for 'start of mission'." ;
    sh:order 9 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEvent-startsAfterEvents
    a sh:PropertyShape ;
    sh:path era:startsAfterEvents ;
    sh:name "startsAfterEvents" ;
    sh:description "Defines the set of operational events, which must be finished before the current event starts." ;
    sh:order 10 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:OperationalEventRefShape ;
    sh:message "startsAfterEvents must be a well-formed OperationalEventRef (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEvent-pathToNextEvent-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "era:pathToNextEvent is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:pathToNextEvent ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

opp-sh:MovementEvent-pathToNextEvent-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:pathToNextEvent"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:IRI ;
        sh:class era:LinearElement ;
        sh:message "pathToNextEvent must reference an existing era:LinearElement by IRI."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

### OperationalEventRef ###############################################
opp-sh:OperationalEventRefShape
    a sh:NodeShape ;
    sh:targetClass era:OperationalEventRef ;
    sh:name "OperationalEventRef" ;
    sh:description "Defines a reference to one of possible OperationalEvents (as a unit)" ;
    sh:xone (
        opp-sh:OperationalEventRef-movementEvent-present
        opp-sh:OperationalEventRef-restrictionEvent-present
        opp-sh:OperationalEventRef-warningMeasureEvent-present
    ) ;
    sh:message "OperationalEventRef is a union: exactly one of (movementEvent, restrictionEvent, warningMeasureEvent) must be present."@en ;
    sh:property opp-sh:OperationalEventRef-movementEvent ;
    sh:property opp-sh:OperationalEventRef-restrictionEvent ;
    sh:property opp-sh:OperationalEventRef-warningMeasureEvent ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalEventRef-movementEvent
    a sh:PropertyShape ;
    sh:path era:movementEvent ;
    sh:name "movementEvent" ;
    sh:description "refers a movement event including the movement plan" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:MovementEvent ;
    sh:message "movementEvent must reference an existing era:MovementEvent by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalEventRef-restrictionEvent
    a sh:PropertyShape ;
    sh:path era:restrictionEvent ;
    sh:name "restrictionEvent" ;
    sh:description "Refers a restriction event including restriction plan" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:UsageRestrictionEvent ;
    sh:message "restrictionEvent must reference an existing era:UsageRestrictionEvent by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalEventRef-warningMeasureEvent
    a sh:PropertyShape ;
    sh:path era:warningMeasureEvent ;
    sh:name "warningMeasureEvent" ;
    sh:description "Refers a warnning measure event including the warning plan" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:WarningMeasureEvent ;
    sh:message "warningMeasureEvent must reference an existing era:WarningMeasureEvent by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalEventRef-movementEvent-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:movementEvent is present"@en ;
    sh:property opp-sh:OperationalEventRef-movementEvent-required ;
    .

opp-sh:OperationalEventRef-movementEvent-required
    a sh:PropertyShape ;
    sh:path era:movementEvent ;
    sh:minCount 1 ;
    .

opp-sh:OperationalEventRef-restrictionEvent-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:restrictionEvent is present"@en ;
    sh:property opp-sh:OperationalEventRef-restrictionEvent-required ;
    .

opp-sh:OperationalEventRef-restrictionEvent-required
    a sh:PropertyShape ;
    sh:path era:restrictionEvent ;
    sh:minCount 1 ;
    .

opp-sh:OperationalEventRef-warningMeasureEvent-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:warningMeasureEvent is present"@en ;
    sh:property opp-sh:OperationalEventRef-warningMeasureEvent-required ;
    .

opp-sh:OperationalEventRef-warningMeasureEvent-required
    a sh:PropertyShape ;
    sh:path era:warningMeasureEvent ;
    sh:minCount 1 ;
    .

### StopDescription ###################################################
opp-sh:StopDescriptionShape
    a sh:NodeShape ;
    sh:targetClass era:StopDescription ;
    sh:name "StopDescription" ;
    sh:description "Defines the activities and operational behaviour to be implemented/performed by the train during a scheduled stop." ;
    sh:sparql opp-sh:StopDescription-activities-listWellFormed ;
    sh:property opp-sh:StopDescription-activities ;
    sh:property opp-sh:StopDescription-doorActivity ;
    sh:property opp-sh:StopDescription-relaxedCoupler ;
    sh:property opp-sh:StopDescription-holdTrain ;
    sh:property opp-sh:StopDescription-scheduledDeparture ;
    sh:property opp-sh:StopDescription-scheduledMinDwellTime ;
    sh:property opp-sh:StopDescription-additionalEventTimes ;
    sh:severity sh:Violation ;
    .

opp-sh:StopDescription-activities
    a sh:PropertyShape ;
    sh:path era:activities ;
    sh:name "activities" ;
    sh:description "Defines the sequence of changes of TrainUnit during the stop" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "activities is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node opp-sh:StopDescription-activities-items ;
    sh:severity sh:Violation ;
    .

opp-sh:StopDescription-doorActivity
    a sh:PropertyShape ;
    sh:path era:doorActivity ;
    sh:name "doorActivity" ;
    sh:description "Defines the door activity. If the attribute is not provided, the doors remain closed" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:DoorActivityShape ;
    sh:message "doorActivity must be a well-formed DoorActivity (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:StopDescription-relaxedCoupler
    a sh:PropertyShape ;
    sh:path era:relaxedCoupler ;
    sh:name "relaxedCoupler" ;
    sh:description "Defines the state of coupler. true - request for coupler relaxation, false -not, see Q_Relaxed_Coupler in SS126" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:StopDescription-holdTrain
    a sh:PropertyShape ;
    sh:path era:holdTrain ;
    sh:name "holdTrain" ;
    sh:description "Defines, if the train shall be hold until the next update. See JP in SS126" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:StopDescription-scheduledDeparture
    a sh:PropertyShape ;
    sh:path era:scheduledDeparture ;
    sh:name "scheduledDeparture" ;
    sh:description "Defines the scheduled departure time. see departure in SS126. In the last station it is 'end of mission', in UTC." ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:StopDescription-scheduledMinDwellTime
    a sh:PropertyShape ;
    sh:path era:scheduledMinDwellTime ;
    sh:name "scheduledMinDwellTime" ;
    sh:description "Defines if the train has to wait after actual arrival this number of seconds before departure. ActualEarliestDeparture = max(departure, arrival + minDwellTime) will be calculated by ATO-OB, see minDwellTime in SS126" ;
    sh:order 6 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:StopDescription-additionalEventTimes
    a sh:PropertyShape ;
    sh:path era:additionalEventTimes ;
    sh:name "additionalEventTimes" ;
    sh:description "Defines additional scheduled times associated with the stop for specific operational events." ;
    sh:order 7 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:AdditionalEventTimeShape ;
    sh:message "additionalEventTimes must be a well-formed AdditionalEventTime (blank node or IRI)."@en ;
    sh:maxCount 5 ;
    sh:severity sh:Violation ;
    .

opp-sh:StopDescription-activities-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "era:activities is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:activities ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

opp-sh:StopDescription-activities-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:activities"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node opp-sh:MovementEventActivityShape ;
        sh:message "activities must be a well-formed MovementEventActivity (blank node or IRI)."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

### AdditionalEventTime ###############################################
opp-sh:AdditionalEventTimeShape
    a sh:NodeShape ;
    sh:targetClass era:AdditionalEventTime ;
    sh:name "AdditionalEventTime" ;
    sh:description "Definestimes not required for ATO, but useful for CDAS (e.g. published arrival, plannedArrival etc.)" ;
    sh:property opp-sh:AdditionalEventTime-timeValue ;
    sh:property opp-sh:AdditionalEventTime-timeType ;
    sh:severity sh:Violation ;
    .

opp-sh:AdditionalEventTime-timeValue
    a sh:PropertyShape ;
    sh:path era:timeValue ;
    sh:name "timeValue" ;
    sh:description "Defines the time value in UTC" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:AdditionalEventTime-timeType
    a sh:PropertyShape ;
    sh:path era:timeType ;
    sh:name "timeType" ;
    sh:description "Defines the time type for a stop description" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/time-type/plannedArrival> <http://data.europa.eu/949/concepts/time-type/plannedDeparture> <http://data.europa.eu/949/concepts/time-type/plannedMinDwellTime> <http://data.europa.eu/949/concepts/time-type/publishedArrival> <http://data.europa.eu/949/concepts/time-type/publishedDeparture> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TimeType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### DoorActivity ######################################################
opp-sh:DoorActivityShape
    a sh:NodeShape ;
    sh:targetClass era:DoorActivity ;
    sh:name "DoorActivity" ;
    sh:description "Defines which doors shall be open and how they shall be open." ;
    sh:property opp-sh:DoorActivity-openingDoorSide ;
    sh:property opp-sh:DoorActivity-centralisedOpening ;
    sh:property opp-sh:DoorActivity-automaticClosing ;
    sh:severity sh:Violation ;
    .

opp-sh:DoorActivity-openingDoorSide
    a sh:PropertyShape ;
    sh:path era:openingDoorSide ;
    sh:name "openingDoorSide" ;
    sh:description "Defines the door opening side. noneSide if the doors are kept closed. noneSide if the doors are kept closed" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/door-side/doorSideLeft> <http://data.europa.eu/949/concepts/door-side/doorSideRight> <http://data.europa.eu/949/concepts/door-side/doorSideBoth> <http://data.europa.eu/949/concepts/door-side/doorNoneSide> <http://data.europa.eu/949/concepts/door-side/doorSideUnknown> ) ;
    sh:message "Value must be one of the CCSTMS-scoped DoorSide concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:DoorActivity-centralisedOpening
    a sh:PropertyShape ;
    sh:path era:centralisedOpening ;
    sh:name "centralisedOpening" ;
    sh:description "Defines if the doors can be centrally opened. true - centralised opening, false - opening by passengers/driver" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:DoorActivity-automaticClosing
    a sh:PropertyShape ;
    sh:path era:automaticClosing ;
    sh:name "automaticClosing" ;
    sh:description "Defines if automatic closing of doors is performed by ATO or not. True by ATO, false - without ATO" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### TrainUnitActivity #################################################
opp-sh:TrainUnitActivityShape
    a sh:NodeShape ;
    sh:targetClass era:TrainUnitActivity ;
    sh:name "TrainUnitActivity" ;
    sh:description "Defines, what happens with the rolling stock at this location." ;
    sh:property opp-sh:TrainUnitActivity-trainUnitActivityType ;
    sh:property opp-sh:TrainUnitActivity-actualTrainUnitIndex ;
    sh:property opp-sh:TrainUnitActivity-targetTrainUnitIndex ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitActivity-trainUnitActivityType
    a sh:PropertyShape ;
    sh:path era:trainUnitActivityType ;
    sh:name "trainUnitActivityType" ;
    sh:description "Defines the train unit activity type" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-unit-activity-type/joinActivity> <http://data.europa.eu/949/concepts/train-unit-activity-type/splitActivity> <http://data.europa.eu/949/concepts/train-unit-activity-type/collectActivity> <http://data.europa.eu/949/concepts/train-unit-activity-type/dropActivity> <http://data.europa.eu/949/concepts/train-unit-activity-type/turnAroundActivity> <http://data.europa.eu/949/concepts/train-unit-activity-type/meetActivity> <http://data.europa.eu/949/concepts/train-unit-activity-type/trainReplacementActivity> <http://data.europa.eu/949/concepts/train-unit-activity-type/otherActivity> ) ;
    sh:message "Value must be one of the CCSTMS-scoped TrainUnitActivityType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitActivity-actualTrainUnitIndex
    a sh:PropertyShape ;
    sh:path era:actualTrainUnitIndex ;
    sh:name "actualTrainUnitIndex" ;
    sh:description "Defines the index of TrainUnit in OperationalMovement. operationalTrainUnits before the activity. Index starts with 0" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitActivity-targetTrainUnitIndex
    a sh:PropertyShape ;
    sh:path era:targetTrainUnitIndex ;
    sh:name "targetTrainUnitIndex" ;
    sh:description "Defines the index of TrainUnit in OperationalMovement. operationalTrainUnits after the activity. Index starts with 0" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### MovementEventActivityJoin #########################################
opp-sh:MovementEventActivityJoinShape
    a sh:NodeShape ;
    sh:targetClass era:MovementEventActivityJoin ;
    sh:name "MovementEventActivityJoin" ;
    sh:description "Defines joining (coupling) of two trains" ;
    sh:property opp-sh:MovementEventActivityJoin-joiningMovement ;
    sh:property opp-sh:MovementEventActivityJoin-trainSides ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEventActivityJoin-joiningMovement
    a sh:PropertyShape ;
    sh:path era:joiningMovement ;
    sh:name "joiningMovement" ;
    sh:description "Defines the train movement, which is joining to the movement containing this object" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:MovementEvent ;
    sh:message "joiningMovement must reference an existing era:MovementEvent by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEventActivityJoin-trainSides
    a sh:PropertyShape ;
    sh:path era:trainSides ;
    sh:name "trainSides" ;
    sh:description "defines, at which sides the trains join" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-train-side/head2tail> <http://data.europa.eu/949/concepts/train-train-side/head2head> <http://data.europa.eu/949/concepts/train-train-side/tail2head> <http://data.europa.eu/949/concepts/train-train-side/tail2tail> <http://data.europa.eu/949/concepts/train-train-side/unknown> ) ;
    sh:message "Value must be one of the CCSTMS-scoped Train2TrainSide concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### MovementEventActivitySplit ########################################
opp-sh:MovementEventActivitySplitShape
    a sh:NodeShape ;
    sh:targetClass era:MovementEventActivitySplit ;
    sh:name "MovementEventActivitySplit" ;
    sh:description "Defines splitting of a train movement into two - the container-movement and a newly created one" ;
    sh:property opp-sh:MovementEventActivitySplit-splittingMovement ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEventActivitySplit-splittingMovement
    a sh:PropertyShape ;
    sh:path era:splittingMovement ;
    sh:name "splittingMovement" ;
    sh:description "Defines train movement which starts after splitting." ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:MovementEvent ;
    sh:message "splittingMovement must reference an existing era:MovementEvent by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### MovementEventActivityMeet #########################################
opp-sh:MovementEventActivityMeetShape
    a sh:NodeShape ;
    sh:targetClass era:MovementEventActivityMeet ;
    sh:name "MovementEventActivityMeet" ;
    sh:description "Defines two trains coming close to each other inside of one block without coupling." ;
    sh:property opp-sh:MovementEventActivityMeet-meetMovement ;
    sh:property opp-sh:MovementEventActivityMeet-trainSides ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEventActivityMeet-meetMovement
    a sh:PropertyShape ;
    sh:path era:meetMovement ;
    sh:name "meetMovement" ;
    sh:description "Defines the train movement, which is coming close to the movement containing this object" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:MovementEvent ;
    sh:message "meetMovement must reference an existing era:MovementEvent by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEventActivityMeet-trainSides
    a sh:PropertyShape ;
    sh:path era:trainSides ;
    sh:name "trainSides" ;
    sh:description "defines, at which sides the trains meet" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/train-train-side/head2tail> <http://data.europa.eu/949/concepts/train-train-side/head2head> <http://data.europa.eu/949/concepts/train-train-side/tail2head> <http://data.europa.eu/949/concepts/train-train-side/tail2tail> <http://data.europa.eu/949/concepts/train-train-side/unknown> ) ;
    sh:message "Value must be one of the CCSTMS-scoped Train2TrainSide concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### MovementEventActivity #############################################
opp-sh:MovementEventActivityShape
    a sh:NodeShape ;
    sh:targetClass era:MovementEventActivity ;
    sh:name "MovementEventActivity" ;
    sh:description "Defines, which activity is active in an MovementEvent" ;
    sh:xone (
        opp-sh:MovementEventActivity-joinActivity-present
        opp-sh:MovementEventActivity-splitActivity-present
        opp-sh:MovementEventActivity-meetActivity-present
        opp-sh:MovementEventActivity-trainUnitActivity-present
    ) ;
    sh:message "MovementEventActivity is a union: exactly one of (joinActivity, splitActivity, meetActivity, trainUnitActivity) must be present."@en ;
    sh:property opp-sh:MovementEventActivity-joinActivity ;
    sh:property opp-sh:MovementEventActivity-splitActivity ;
    sh:property opp-sh:MovementEventActivity-meetActivity ;
    sh:property opp-sh:MovementEventActivity-trainUnitActivity ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEventActivity-joinActivity
    a sh:PropertyShape ;
    sh:path era:joinActivity ;
    sh:name "joinActivity" ;
    sh:description "Contains definition of Join-activity" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:MovementEventActivityJoinShape ;
    sh:message "joinActivity must be a well-formed MovementEventActivityJoin (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEventActivity-splitActivity
    a sh:PropertyShape ;
    sh:path era:splitActivity ;
    sh:name "splitActivity" ;
    sh:description "Contains definition of Split-activity" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:MovementEventActivitySplitShape ;
    sh:message "splitActivity must be a well-formed MovementEventActivitySplit (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEventActivity-meetActivity
    a sh:PropertyShape ;
    sh:path era:meetActivity ;
    sh:name "meetActivity" ;
    sh:description "Contains definition of train-meet-activity" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:MovementEventActivityMeetShape ;
    sh:message "meetActivity must be a well-formed MovementEventActivityMeet (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEventActivity-trainUnitActivity
    a sh:PropertyShape ;
    sh:path era:trainUnitActivity ;
    sh:name "trainUnitActivity" ;
    sh:description "Contains definition of Train-Unit-Activity" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:TrainUnitActivityShape ;
    sh:message "trainUnitActivity must be a well-formed TrainUnitActivity (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:MovementEventActivity-joinActivity-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:joinActivity is present"@en ;
    sh:property opp-sh:MovementEventActivity-joinActivity-required ;
    .

opp-sh:MovementEventActivity-joinActivity-required
    a sh:PropertyShape ;
    sh:path era:joinActivity ;
    sh:minCount 1 ;
    .

opp-sh:MovementEventActivity-splitActivity-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:splitActivity is present"@en ;
    sh:property opp-sh:MovementEventActivity-splitActivity-required ;
    .

opp-sh:MovementEventActivity-splitActivity-required
    a sh:PropertyShape ;
    sh:path era:splitActivity ;
    sh:minCount 1 ;
    .

opp-sh:MovementEventActivity-meetActivity-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:meetActivity is present"@en ;
    sh:property opp-sh:MovementEventActivity-meetActivity-required ;
    .

opp-sh:MovementEventActivity-meetActivity-required
    a sh:PropertyShape ;
    sh:path era:meetActivity ;
    sh:minCount 1 ;
    .

opp-sh:MovementEventActivity-trainUnitActivity-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:trainUnitActivity is present"@en ;
    sh:property opp-sh:MovementEventActivity-trainUnitActivity-required ;
    .

opp-sh:MovementEventActivity-trainUnitActivity-required
    a sh:PropertyShape ;
    sh:path era:trainUnitActivity ;
    sh:minCount 1 ;
    .

### PhysicalTrainUnitIdentifier #######################################
opp-sh:PhysicalTrainUnitIdentifierShape
    a sh:NodeShape ;
    sh:targetClass era:PhysicalTrainUnitIdentifier ;
    sh:name "PhysicalTrainUnitIdentifier" ;
    sh:description "Defines a set of possible identifiers for a physical train (ETCS-trainRunningNumber, OBU-ID etc)." ;
    sh:property opp-sh:PhysicalTrainUnitIdentifier-trainRunningNumber ;
    sh:property opp-sh:PhysicalTrainUnitIdentifier-additionalTrainNumber ;
    sh:property opp-sh:PhysicalTrainUnitIdentifier-dailyReferenceTrainId ;
    sh:property opp-sh:PhysicalTrainUnitIdentifier-leadingNidEngine ;
    sh:property opp-sh:PhysicalTrainUnitIdentifier-companyId ;
    sh:property opp-sh:PhysicalTrainUnitIdentifier-startDate ;
    sh:severity sh:Violation ;
    .

opp-sh:PhysicalTrainUnitIdentifier-trainRunningNumber
    a sh:PropertyShape ;
    sh:path era:trainRunningNumber ;
    sh:name "trainRunningNumber" ;
    sh:description "Defines the Train Running Number for ETCS same as SS026.NID_OPERATIONAL. To be usable for ETCS must contain an integer [0..99999999]. Mapping to uint32 by filling with F. E.g.: 1233 -> 0x1233FFFF" ;
    sh:order 1 ;
    rdfs:comment "ERTMS subset variable: NID_OPERATIONAL"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:PhysicalTrainUnitIdentifier-additionalTrainNumber
    a sh:PropertyShape ;
    sh:path era:additionalTrainNumber ;
    sh:name "additionalTrainNumber" ;
    sh:description "Additional identifier for train number" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:PhysicalTrainUnitIdentifier-dailyReferenceTrainId
    a sh:PropertyShape ;
    sh:path era:dailyReferenceTrainId ;
    sh:name "dailyReferenceTrainId" ;
    sh:description "refers toTSI TELdailyReferenceTrainId" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:PhysicalTrainUnitIdentifier-leadingNidEngine
    a sh:PropertyShape ;
    sh:path era:leadingNidEngine ;
    sh:name "leadingNidEngine" ;
    sh:description "Defines NID_ENGINE (The 24 bits in ETCS-telegrams must be read as BigEndian 1c,2a,10 -> 0x1c2a10" ;
    sh:order 4 ;
    rdfs:comment "ERTMS subset variable: NID_ENGINE"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 16777215 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:PhysicalTrainUnitIdentifier-companyId
    a sh:PropertyShape ;
    sh:path era:companyId ;
    sh:name "companyId" ;
    sh:description "defined as CompanyCode in Telematics-TSI" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9A-Z]{4}$" ;
    sh:message "companyId must match the regular expression [0-9A-Z]{4} over its whole value."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:PhysicalTrainUnitIdentifier-startDate
    a sh:PropertyShape ;
    sh:path era:startDate ;
    sh:name "startDate" ;
    sh:description "YYYY-MM-DD according to ISO8601 represents the operational date to which the train movement belongs as defined by the TOC. It shall be used only for identification, not for calculation of date-times." ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### OperationalPlanUsageRestriction ###################################
opp-sh:OperationalPlanUsageRestrictionShape
    a sh:NodeShape ;
    sh:targetClass era:OperationalPlanUsageRestriction ;
    sh:name "OperationalPlanUsageRestriction" ;
    sh:description "Defines a temporary infrastructure restriction" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:OperationalPlanUsageRestriction-issuedAt ;
    sh:property opp-sh:OperationalPlanUsageRestriction-configurationDataVersionRef ;
    sh:property opp-sh:OperationalPlanUsageRestriction-restrictionEvents ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanUsageRestriction-issuedAt
    a sh:PropertyShape ;
    sh:path era:issuedAt ;
    sh:name "issuedAt" ;
    sh:description "Defines the issue-point in time with microsecond-resolution builds a version-id for acknowledgements and validity-estimations, in UTC" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanUsageRestriction-configurationDataVersionRef
    a sh:PropertyShape ;
    sh:path era:configurationDataVersionRef ;
    sh:name "configurationDataVersionRef" ;
    sh:description "Defines the configuration data version for which the operational plan is valid" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanUsageRestriction-restrictionEvents
    a sh:PropertyShape ;
    sh:path era:restrictionEvents ;
    sh:name "restrictionEvents" ;
    sh:description "Defines a set of restriction events assigned the the operational plan restriction" ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:UsageRestrictionEventShape ;
    sh:message "restrictionEvents must be a well-formed UsageRestrictionEvent (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

### UsageRestrictionEvent #############################################
opp-sh:UsageRestrictionEventShape
    a sh:NodeShape ;
    sh:targetClass era:UsageRestrictionEvent ;
    sh:name "UsageRestrictionEvent" ;
    sh:description "Defines a part of temporary infrastructure restriction, especially if one UsageRestriction plan contains several areas to be activate to different times." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:UsageRestrictionEvent-activationTime ;
    sh:property opp-sh:UsageRestrictionEvent-deactivationTime ;
    sh:property opp-sh:UsageRestrictionEvent-usageRestriction ;
    sh:property opp-sh:UsageRestrictionEvent-startsAfterEvents ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionEvent-activationTime
    a sh:PropertyShape ;
    sh:path era:activationTime ;
    sh:name "activationTime" ;
    sh:description "Defines the time when the restrictionArea shall be created=implemented=activated in interlocking, in UTC" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionEvent-deactivationTime
    a sh:PropertyShape ;
    sh:path era:deactivationTime ;
    sh:name "deactivationTime" ;
    sh:description "Defines the removal time in UTC. E.g. removal 10:04:20 means, that restriction is active until 10:04:19.999999. The relation is creationTime <= active < removalTime" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionEvent-usageRestriction
    a sh:PropertyShape ;
    sh:path era:usageRestriction ;
    sh:name "usageRestriction" ;
    sh:description "Defines the restriction areas associated to a usage restriction event" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:UsageRestrictionShape ;
    sh:message "usageRestriction must be a well-formed UsageRestriction (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionEvent-startsAfterEvents
    a sh:PropertyShape ;
    sh:path era:startsAfterEvents ;
    sh:name "startsAfterEvents" ;
    sh:description "Defines the set of operational events, which must be finished before the current event starts." ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:OperationalEventRefShape ;
    sh:message "startsAfterEvents must be a well-formed OperationalEventRef (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

### UsageRestriction ##################################################
opp-sh:UsageRestrictionShape
    a sh:NodeShape ;
    sh:targetClass era:UsageRestriction ;
    sh:name "UsageRestriction" ;
    sh:description "Defines a topological area and the usage restriction to be applied." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:UsageRestriction-linearElementSections ;
    sh:property opp-sh:UsageRestriction-restrictedAspect ;
    sh:property opp-sh:UsageRestriction-appliedToTrains ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestriction-linearElementSections
    a sh:PropertyShape ;
    sh:path era:linearElementSections ;
    sh:name "linearElementSections" ;
    sh:description "composes of linear element sections" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-LinearElementSectionShape ;
    sh:message "linearElementSections must be a well-formed LinearElementSection (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestriction-restrictedAspect
    a sh:PropertyShape ;
    sh:path era:restrictedAspect ;
    sh:name "restrictedAspect" ;
    sh:description "Defines the restriction aspect" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:RestrictedAspectShape ;
    sh:message "restrictedAspect must be a well-formed RestrictedAspect (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestriction-appliedToTrains
    a sh:PropertyShape ;
    sh:path era:appliedToTrains ;
    sh:name "appliedToTrains" ;
    sh:description "Defines the trains for the restriction to be applied. Empty if applied to all trains" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:TrainGroupFilterShape ;
    sh:message "appliedToTrains must be a well-formed TrainGroupFilter (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### TrainGroupFilter ##################################################
opp-sh:TrainGroupFilterShape
    a sh:NodeShape ;
    sh:targetClass era:TrainGroupFilter ;
    sh:name "TrainGroupFilter" ;
    sh:description "Defines the train aspects, which define if the train belongs to the restricted group." ;
    sh:property opp-sh:TrainGroupFilter-axleLoadCategories ;
    sh:property opp-sh:TrainGroupFilter-cantDeficiencyCategories ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainGroupFilter-axleLoadCategories
    a sh:PropertyShape ;
    sh:path era:axleLoadCategories ;
    sh:name "axleLoadCategories" ;
    sh:description "Trains with the listed Axle-Load-Category belong to the TrainGroup." ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/load-capability-line-categories/10> <http://data.europa.eu/949/concepts/load-capability-line-categories/230> <http://data.europa.eu/949/concepts/load-capability-line-categories/20> <http://data.europa.eu/949/concepts/load-capability-line-categories/30> <http://data.europa.eu/949/concepts/load-capability-line-categories/40> <http://data.europa.eu/949/concepts/load-capability-line-categories/50> <http://data.europa.eu/949/concepts/load-capability-line-categories/60> <http://data.europa.eu/949/concepts/load-capability-line-categories/70> <http://data.europa.eu/949/concepts/load-capability-line-categories/80> <http://data.europa.eu/949/concepts/load-capability-line-categories/90> <http://data.europa.eu/949/concepts/load-capability-line-categories/100> <http://data.europa.eu/949/concepts/load-capability-line-categories/110> <http://data.europa.eu/949/concepts/load-capability-line-categories/120> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LoadCapabilityLineCategories concepts."@en ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainGroupFilter-cantDeficiencyCategories
    a sh:PropertyShape ;
    sh:path era:cantDeficiencyCategories ;
    sh:name "cantDeficiencyCategories" ;
    sh:description "Trains with the listed Cant Deficiency Category belong to the TrainGroup." ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/cant-deficiencies/80> <http://data.europa.eu/949/concepts/cant-deficiencies/100> <http://data.europa.eu/949/concepts/cant-deficiencies/130> <http://data.europa.eu/949/concepts/cant-deficiencies/150> <http://data.europa.eu/949/concepts/cant-deficiencies/165> <http://data.europa.eu/949/concepts/cant-deficiencies/180> <http://data.europa.eu/949/concepts/cant-deficiencies/210> <http://data.europa.eu/949/concepts/cant-deficiencies/225> <http://data.europa.eu/949/concepts/cant-deficiencies/245> <http://data.europa.eu/949/concepts/cant-deficiencies/275> <http://data.europa.eu/949/concepts/cant-deficiencies/300> ) ;
    sh:message "Value must be one of the CCSTMS-scoped CantDeficiencies concepts."@en ;
    sh:severity sh:Violation ;
    .

### RestrictedAspect ##################################################
opp-sh:RestrictedAspectShape
    a sh:NodeShape ;
    sh:targetClass era:RestrictedAspect ;
    sh:name "RestrictedAspect" ;
    sh:description "Defines single aspects of the infrastructure restriction" ;
    sh:xone (
        opp-sh:RestrictedAspect-speedRestriction-present
        opp-sh:RestrictedAspect-allowedDrivingModes-present
        opp-sh:RestrictedAspect-nonStandstill-present
        opp-sh:RestrictedAspect-trackClosure-present
        opp-sh:RestrictedAspect-operationalRadioHole-present
        opp-sh:RestrictedAspect-maxAdhesion-present
        opp-sh:RestrictedAspect-atoInhibition-present
        opp-sh:RestrictedAspect-maxCurrent-present
        opp-sh:RestrictedAspect-soundHorn-present
        opp-sh:RestrictedAspect-nonSwitchability-present
        opp-sh:RestrictedAspect-safetyCriticalCommandOnly-present
        opp-sh:RestrictedAspect-manualOperationOnly-present
        opp-sh:RestrictedAspect-operationallyNonStandstill-present
    ) ;
    sh:message "RestrictedAspect is a union: exactly one of (speedRestriction, allowedDrivingModes, nonStandstill, trackClosure, operationalRadioHole, maxAdhesion, atoInhibition, maxCurrent, soundHorn, nonSwitchability, safetyCriticalCommandOnly, manualOperationOnly, operationallyNonStandstill) must be present."@en ;
    sh:property opp-sh:RestrictedAspect-speedRestriction ;
    sh:property opp-sh:RestrictedAspect-allowedDrivingModes ;
    sh:property opp-sh:RestrictedAspect-nonStandstill ;
    sh:property opp-sh:RestrictedAspect-trackClosure ;
    sh:property opp-sh:RestrictedAspect-operationalRadioHole ;
    sh:property opp-sh:RestrictedAspect-maxAdhesion ;
    sh:property opp-sh:RestrictedAspect-atoInhibition ;
    sh:property opp-sh:RestrictedAspect-maxCurrent ;
    sh:property opp-sh:RestrictedAspect-soundHorn ;
    sh:property opp-sh:RestrictedAspect-nonSwitchability ;
    sh:property opp-sh:RestrictedAspect-safetyCriticalCommandOnly ;
    sh:property opp-sh:RestrictedAspect-manualOperationOnly ;
    sh:property opp-sh:RestrictedAspect-operationallyNonStandstill ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-speedRestriction
    a sh:PropertyShape ;
    sh:path era:speedRestriction ;
    sh:name "speedRestriction" ;
    sh:description "Defines the allowed speed" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:SpeedRestrictionShape ;
    sh:message "speedRestriction must be a well-formed SpeedRestriction (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-allowedDrivingModes
    a sh:PropertyShape ;
    sh:path era:allowedDrivingModes ;
    sh:name "allowedDrivingModes" ;
    sh:description "Defines the allowed driving modes" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/onboard-operating-mode/fullSupervision> <http://data.europa.eu/949/concepts/onboard-operating-mode/onSight> <http://data.europa.eu/949/concepts/onboard-operating-mode/staffResponsible> <http://data.europa.eu/949/concepts/onboard-operating-mode/shunting> <http://data.europa.eu/949/concepts/onboard-operating-mode/unfitted> <http://data.europa.eu/949/concepts/onboard-operating-mode/sleeping> <http://data.europa.eu/949/concepts/onboard-operating-mode/standBy> <http://data.europa.eu/949/concepts/onboard-operating-mode/trip> <http://data.europa.eu/949/concepts/onboard-operating-mode/postTrip> <http://data.europa.eu/949/concepts/onboard-operating-mode/systemFailure> <http://data.europa.eu/949/concepts/onboard-operating-mode/isolation> <http://data.europa.eu/949/concepts/onboard-operating-mode/nonLeading> <http://data.europa.eu/949/concepts/onboard-operating-mode/limitedSupervision> <http://data.europa.eu/949/concepts/onboard-operating-mode/nationalSystem> <http://data.europa.eu/949/concepts/onboard-operating-mode/reversing> <http://data.europa.eu/949/concepts/onboard-operating-mode/passiveShunting> <http://data.europa.eu/949/concepts/onboard-operating-mode/automaticDriving> <http://data.europa.eu/949/concepts/onboard-operating-mode/supervisedManoeuvre> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OnboardOperatingMode concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-nonStandstill
    a sh:PropertyShape ;
    sh:path era:nonStandstill ;
    sh:name "nonStandstill" ;
    sh:description "Defines the non stopping area. If true, the trains defined in trainGroupFilter shall not stop within restriction area." ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-trackClosure
    a sh:PropertyShape ;
    sh:path era:trackClosure ;
    sh:name "trackClosure" ;
    sh:description "Defines track closure information. If true, the trains defined in trainGroupFilter shall not enter restriction area" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-operationalRadioHole
    a sh:PropertyShape ;
    sh:path era:operationalRadioHole ;
    sh:name "operationalRadioHole" ;
    sh:description "Defines the presence of operational radio holes. if true radio communication is restricted within restriction area" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-maxAdhesion
    a sh:PropertyShape ;
    sh:path era:maxAdhesion ;
    sh:name "maxAdhesion" ;
    sh:description "Defines the maximum adhesion" ;
    sh:order 6 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/adhesion-category/dryRailHigh> <http://data.europa.eu/949/concepts/adhesion-category/dryRailMedium> <http://data.europa.eu/949/concepts/adhesion-category/dryRailLow> <http://data.europa.eu/949/concepts/adhesion-category/lowAdhesion> <http://data.europa.eu/949/concepts/adhesion-category/veryLowAdhesion> <http://data.europa.eu/949/concepts/adhesion-category/extremelyLowAdhesion> <http://data.europa.eu/949/concepts/adhesion-category/unknownAdhesion> ) ;
    sh:message "Value must be one of the CCSTMS-scoped AdhesionCategory concepts."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-atoInhibition
    a sh:PropertyShape ;
    sh:path era:atoInhibition ;
    sh:name "atoInhibition" ;
    sh:description "Defined the ato inhibition zones. Exmaples: train section is not contantly monitored, or stimulate driver's attention, or approaching overcrouded station" ;
    sh:order 7 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-maxCurrent
    a sh:PropertyShape ;
    sh:path era:maxCurrent ;
    sh:name "maxCurrent" ;
    sh:description "Defines max current value. For ATO, SS126. Ignored by TrafficCS" ;
    sh:order 8 ;
    qudt:hasUnit unit:A ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-soundHorn
    a sh:PropertyShape ;
    sh:path era:soundHorn ;
    sh:name "soundHorn" ;
    sh:description "Defines that approaching trains needs to sound horn" ;
    sh:order 9 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-nonSwitchability
    a sh:PropertyShape ;
    sh:path era:nonSwitchability ;
    sh:name "nonSwitchability" ;
    sh:description "Defines that Switchable Trackside Asset cannot be switched. To be clarified." ;
    sh:order 10 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:RestrictedAspect-safetyCriticalCommandOnly
    a sh:PropertyShape ;
