    sh:property opp-sh:UsageRestrictionState-usageRestriction ;
    sh:property opp-sh:UsageRestrictionState-unsupervisedTrainsInRestrictionArea ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionState-usageRestrictionState
    a sh:PropertyShape ;
    sh:path era:usageRestrictionState ;
    sh:name "usageRestrictionState" ;
    sh:description "Defines if the area was activated or deactivated" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/event-state/activated> <http://data.europa.eu/949/concepts/event-state/deactivated> ) ;
    sh:message "Value must be one of the CCSTMS-scoped EventState concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionState-usageRestriction
    a sh:PropertyShape ;
    sh:path era:usageRestriction ;
    sh:name "usageRestriction" ;
    sh:description "Defines the restriction area associated to a restriction area state. Always provided = mandatory, except for deactivation." ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:UsageRestrictionShape ;
    sh:message "usageRestriction must be a well-formed UsageRestriction (blank node or IRI)."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:UsageRestrictionState-unsupervisedTrainsInRestrictionArea
    a sh:PropertyShape ;
    sh:path era:unsupervisedTrainsInRestrictionArea ;
    sh:name "unsupervisedTrainsInRestrictionArea" ;
    sh:description "in active state some unsupervised trains are still in the restriction area. So, it is not safe enter the area by maintainer. Signaller has to send manual instructions to unsupervised trains." ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

