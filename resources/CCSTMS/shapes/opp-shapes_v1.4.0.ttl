    a sh:PropertyShape ;
    sh:path era:departureReport ;
    sh:name "departureReport" ;
    sh:description "Defines the result of departure attempt" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:MovementEventExecutionReportShape ;
    sh:message "departureReport must be a well-formed MovementEventExecutionReport (blank node or IRI)."@en ;
    sh:message "departureReport muss ein wohlgeformtes MovementEventExecutionReport sein (Blank Node oder IRI)."@de ;
    sh:message "departureReport doit être un MovementEventExecutionReport bien formé (nœud vide ou IRI)."@fr ;
