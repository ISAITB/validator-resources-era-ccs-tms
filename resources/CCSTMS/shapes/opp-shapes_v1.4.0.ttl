### OperationalPlanWarningMeasure #####################################
opp-sh:OperationalPlanWarningMeasureShape
    a sh:NodeShape ;
    sh:targetClass era:OperationalPlanWarningMeasure ;
    sh:name "OperationalPlanWarningMeasure" ;
    sh:description "Defines a temporary warning area, required for e.g. a possession." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:OperationalPlanWarningMeasure-issuedAt ;
    sh:property opp-sh:OperationalPlanWarningMeasure-configurationDataVersionRef ;
    sh:property opp-sh:OperationalPlanWarningMeasure-warningMeasureEvents ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanWarningMeasure-issuedAt
    a sh:PropertyShape ;
    sh:path era:issuedAt ;
    sh:name "issuedAt" ;
    sh:description "Defines the issue-point in time with microsecond-resolution builds a version-id for acknowledgements and validity-estimations, in UTC" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanWarningMeasure-configurationDataVersionRef
    a sh:PropertyShape ;
    sh:path era:configurationDataVersionRef ;
    sh:name "configurationDataVersionRef" ;
    sh:description "Defines the configuration data version for which the operational plan is valid" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanWarningMeasure-warningMeasureEvents
    a sh:PropertyShape ;
    sh:path era:warningMeasureEvents ;
    sh:name "warningMeasureEvents" ;
    sh:description "Defines the list of warning measures events" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:WarningMeasureEventShape ;
    sh:message "warningMeasureEvents must be a well-formed WarningMeasureEvent (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

### WarningArea #######################################################
opp-sh:WarningAreaShape
    a sh:NodeShape ;
    sh:targetClass era:WarningArea ;
    sh:name "WarningArea" ;
    sh:description "Defines area in which Warning measures shall be implemented." ;
    sh:property opp-sh:WarningArea-trackArea ;
    sh:property opp-sh:WarningArea-warningDevices ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningArea-trackArea
    a sh:PropertyShape ;
    sh:path era:trackArea ;
    sh:name "trackArea" ;
    sh:description "protected area" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetAreaReferenceShape ;
    sh:message "trackArea must be a well-formed NetAreaReference (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningArea-warningDevices
    a sh:PropertyShape ;
    sh:path era:warningDevices ;
    sh:name "warningDevices" ;
    sh:description "Defines the list of warning devices" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:WarningDeviceShape ;
    sh:message "warningDevices must be a well-formed WarningDevice (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

### WarningDevice #####################################################
opp-sh:WarningDeviceShape
    a sh:NodeShape ;
    sh:targetClass era:WarningDevice ;
    sh:name "WarningDevice" ;
    sh:description "Defines functional warning device which must be activated to implement warning measure" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:WarningDevice-deviceType ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningDevice-deviceType
    a sh:PropertyShape ;
    sh:path era:deviceType ;
    sh:name "deviceType" ;
    sh:description "Defines a functional warning device type used for securing the warning area" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/device-type/acousticalIndicator> <http://data.europa.eu/949/concepts/device-type/opticalIndicator> <http://data.europa.eu/949/concepts/device-type/hapticIndicator> ) ;
    sh:message "Value must be one of the CCSTMS-scoped DeviceType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### WarningMeasureEvent ###############################################
opp-sh:WarningMeasureEventShape
    a sh:NodeShape ;
    sh:targetClass era:WarningMeasureEvent ;
    sh:name "WarningMeasureEvent" ;
    sh:description "Defines planned activation/removal of warning area" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:WarningMeasureEvent-activationTime ;
    sh:property opp-sh:WarningMeasureEvent-deactivationTime ;
    sh:property opp-sh:WarningMeasureEvent-warningArea ;
    sh:property opp-sh:WarningMeasureEvent-startsAfterEvents ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningMeasureEvent-activationTime
    a sh:PropertyShape ;
    sh:path era:activationTime ;
    sh:name "activationTime" ;
    sh:description "Defines the time when the warningArea shall be created=implemented=activated in interlocking, in UTC" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningMeasureEvent-deactivationTime
    a sh:PropertyShape ;
    sh:path era:deactivationTime ;
    sh:name "deactivationTime" ;
    sh:description "Defines the removal time in UTC" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningMeasureEvent-warningArea
    a sh:PropertyShape ;
    sh:path era:warningArea ;
    sh:name "warningArea" ;
    sh:description "Defines the infrastructure area and warning measures to be activated in this event" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:WarningAreaShape ;
    sh:message "warningArea must be a well-formed WarningArea (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:WarningMeasureEvent-startsAfterEvents
    a sh:PropertyShape ;
    sh:path era:startsAfterEvents ;
    sh:name "startsAfterEvents" ;
    sh:description "Defines the set of operational events, which must be finished before the current event starts." ;
    sh:order 5 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:OperationalEventRefShape ;
    sh:message "startsAfterEvents must be a well-formed OperationalEventRef (blank node or IRI)."@en ;
    sh:severity sh:Violation ;
    .

### OperationalPlanExecutionResponse ##################################
opp-sh:OperationalPlanExecutionResponseShape
    a sh:NodeShape ;
    sh:targetClass era:OperationalPlanExecutionResponse ;
    sh:name "OperationalPlanExecutionResponse" ;
    sh:description "Defines the result of evaluation of an operational plan from the TrafficCS (accepts/rejects)" ;
    sh:property opp-sh:OperationalPlanExecutionResponse-operationalPlanIssuedAt ;
    sh:property opp-sh:OperationalPlanExecutionResponse-issuedAt ;
    sh:property opp-sh:OperationalPlanExecutionResponse-response ;
    sh:property opp-sh:OperationalPlanExecutionResponse-rejectReason ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanExecutionResponse-operationalPlanIssuedAt
    a sh:PropertyShape ;
    sh:path era:operationalPlanIssuedAt ;
    sh:name "operationalPlanIssuedAt" ;
    sh:description "refers to the issuedAt-value of the operational plan request, in UTC" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanExecutionResponse-issuedAt
    a sh:PropertyShape ;
    sh:path era:issuedAt ;
    sh:name "issuedAt" ;
    sh:description "Defines the issue-point in time with microsecond-resolution builds a version-id for acknowledgements and validity-estimations, in UTC" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanExecutionResponse-response
    a sh:PropertyShape ;
    sh:path era:response ;
    sh:name "response" ;
    sh:description "Defines the outcome of the operational plan evaluation." ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:OperationalPlanResponseShape ;
    sh:message "response must be a well-formed OperationalPlanResponse (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:OperationalPlanExecutionResponse-rejectReason
    a sh:PropertyShape ;
    sh:path era:rejectReason ;
    sh:name "rejectReason" ;
    sh:description "Defines the reject reason for an event execution request" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

