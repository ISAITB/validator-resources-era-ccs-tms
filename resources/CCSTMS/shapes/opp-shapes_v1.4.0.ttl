opp-sh:EventHandling-passStopDepart
    a sh:PropertyShape ;
    sh:path era:passStopDepart ;
    sh:name "passStopDepart" ;
    sh:description "Defines the result of the event handling action" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/movement-event-action/passedEvent> <http://data.europa.eu/949/concepts/movement-event-action/stoppedAccurateAtEvent> <http://data.europa.eu/949/concepts/movement-event-action/stoppedWithOvershootAtEvent> <http://data.europa.eu/949/concepts/movement-event-action/stoppedWithUndershootAtEvent> <http://data.europa.eu/949/concepts/movement-event-action/departedFromEvent> ) ;
    sh:message "Value must be one of the CCSTMS-scoped MovementEventAction concepts."@en ;
