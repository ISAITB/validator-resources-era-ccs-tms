    sh:path era:adhesionCategory ;
    sh:minCount 1 ;
    .

opp-sh:SpecificMovementRestriction-maxCurrent-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:maxCurrent is present"@en ;
    sh:property opp-sh:SpecificMovementRestriction-maxCurrent-required ;
    .

opp-sh:SpecificMovementRestriction-maxCurrent-required
    a sh:PropertyShape ;
    sh:path era:maxCurrent ;
    sh:minCount 1 ;
    .

opp-sh:SpecificMovementRestriction-atoInhibition-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:atoInhibition is present"@en ;
    sh:property opp-sh:SpecificMovementRestriction-atoInhibition-required ;
    .

opp-sh:SpecificMovementRestriction-atoInhibition-required
