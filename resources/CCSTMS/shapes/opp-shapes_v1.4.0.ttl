### ValidatedTrainData ################################################
opp-sh:ValidatedTrainDataShape
    a sh:NodeShape ;
    sh:targetClass era:ValidatedTrainData ;
    sh:name "ValidatedTrainData" ;
    sh:description "Defines the validated train data received from the train via ETCS" ;
    sh:sparql opp-sh:ValidatedTrainData-vMaxTrain-multipleOf ;
    sh:property opp-sh:ValidatedTrainData-cantDeficiencyCategory ;
    sh:property opp-sh:ValidatedTrainData-otherTrainCategory ;
    sh:property opp-sh:ValidatedTrainData-trainLength ;
    sh:property opp-sh:ValidatedTrainData-vMaxTrain ;
    sh:property opp-sh:ValidatedTrainData-loadingGaugeType ;
    sh:property opp-sh:ValidatedTrainData-axleLoadCategory ;
    sh:property opp-sh:ValidatedTrainData-airtight ;
    sh:property opp-sh:ValidatedTrainData-axleNumber ;
    sh:property opp-sh:ValidatedTrainData-tractionVoltage ;
    sh:property opp-sh:ValidatedTrainData-nidNtc ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-cantDeficiencyCategory
    a sh:PropertyShape ;
    sh:path era:cantDeficiencyCategory ;
    sh:name "cantDeficiencyCategory" ;
    sh:description "Defines the Cant Deficiency Train category to which the train belongs. see ss026, 7.5.1.82.2 NC_CDTRAIN" ;
    sh:order 1 ;
    rdfs:comment "ERTMS subset variable: NC_CDTRAIN"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/cant-deficiencies/80> <http://data.europa.eu/949/concepts/cant-deficiencies/100> <http://data.europa.eu/949/concepts/cant-deficiencies/130> <http://data.europa.eu/949/concepts/cant-deficiencies/150> <http://data.europa.eu/949/concepts/cant-deficiencies/165> <http://data.europa.eu/949/concepts/cant-deficiencies/180> <http://data.europa.eu/949/concepts/cant-deficiencies/210> <http://data.europa.eu/949/concepts/cant-deficiencies/225> <http://data.europa.eu/949/concepts/cant-deficiencies/245> <http://data.europa.eu/949/concepts/cant-deficiencies/275> <http://data.europa.eu/949/concepts/cant-deficiencies/300> ) ;
    sh:message "Value must be one of the CCSTMS-scoped CantDeficiencies concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-otherTrainCategory
    a sh:PropertyShape ;
    sh:path era:otherTrainCategory ;
    sh:name "otherTrainCategory" ;
    sh:description "Other train category (different from Cant Deficiency) to which the train belongs. Thanks to NC_TRAIN, the train knows the 'Other specific' SSP category it must consider. By receiving a list of static speed profile, thanks to NC_DIFF, the train can select the SSP it must obey. Each bit represents one category. A train can belong to various categories. see ss026, 7.5.1.84 NC_TRAIN" ;
    sh:order 2 ;
    rdfs:comment "ERTMS subset variable: NC_TRAIN"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/other-international-train-category/noCategory> <http://data.europa.eu/949/concepts/other-international-train-category/freightTrainP> <http://data.europa.eu/949/concepts/other-international-train-category/freightTrainG> <http://data.europa.eu/949/concepts/other-international-train-category/passengerTrain> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OtherInternationalTrainCategory concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-trainLength
    a sh:PropertyShape ;
    sh:path era:trainLength ;
    sh:name "trainLength" ;
    sh:description "This is the length of the train acquired as Train Data. When the safe consist length is captured as part of valid Train Data, L_TRAIN is equal to L_CONSISTREARENGINEMAX, considering that valid Train Data can only be captured and sent to the RBC with the leading engine/cab located at the very front of the train. see ss026, 7.5.1.56 L_TRAIN" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    rdfs:comment "ERTMS subset variable: L_TRAIN"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 4095 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-vMaxTrain
    a sh:PropertyShape ;
    sh:path era:vMaxTrain ;
    sh:name "vMaxTrain" ;
    sh:description "Maximum train speed. Resolution is 5 Km/h. see ss026, 7.5.1.160 V_MAXTRAIN" ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    rdfs:comment "ERTMS subset variable: V_MAXTRAIN"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 600 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-loadingGaugeType
    a sh:PropertyShape ;
    sh:path era:loadingGaugeType ;
    sh:name "loadingGaugeType" ;
    sh:description "Defining the loading gauge profile of a train (refer to LOC&PAS TSI). see ss026, 7.5.1.68 M_LOADINGGAUGE" ;
    sh:order 5 ;
    rdfs:comment "ERTMS subset variable: M_LOADINGGAUGE"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/loading-gauge-type/loadingGaugeIncompatible> <http://data.europa.eu/949/concepts/loading-gauge-type/g1> <http://data.europa.eu/949/concepts/loading-gauge-type/gA> <http://data.europa.eu/949/concepts/loading-gauge-type/gB> <http://data.europa.eu/949/concepts/loading-gauge-type/gC> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LoadingGaugeType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-axleLoadCategory
    a sh:PropertyShape ;
    sh:path era:axleLoadCategory ;
    sh:name "axleLoadCategory" ;
    sh:description "Axle load category (The values allocated below correspond to a list of increasing axle load categories (i.e. B1 > HS17, B2 > B1, D2 > C4, ….etc) and it is used by the on-board equipment to compare its axle load category with the axle load category sent by trackside.For the underlying meaning of the axle load categories listed below (with the exception of HS17) refer to CR INF TSI.The category HS17 (axle load <= 17t) corresponds to a static load per axle only, as specified in HS RST TSI clause 4.2.3.2. The introduction of this artefact is necessary to ensure backward compatibility, without any negative performance impact, in case ASPs are used on lines operated with system version X = 1).see ss026, 7.5.1.62 M_AXLELOADCAT" ;
    sh:order 6 ;
    rdfs:comment "ERTMS subset variable: M_AXLELOADCAT"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/load-capability-line-categories/10> <http://data.europa.eu/949/concepts/load-capability-line-categories/230> <http://data.europa.eu/949/concepts/load-capability-line-categories/20> <http://data.europa.eu/949/concepts/load-capability-line-categories/30> <http://data.europa.eu/949/concepts/load-capability-line-categories/40> <http://data.europa.eu/949/concepts/load-capability-line-categories/50> <http://data.europa.eu/949/concepts/load-capability-line-categories/60> <http://data.europa.eu/949/concepts/load-capability-line-categories/70> <http://data.europa.eu/949/concepts/load-capability-line-categories/80> <http://data.europa.eu/949/concepts/load-capability-line-categories/90> <http://data.europa.eu/949/concepts/load-capability-line-categories/100> <http://data.europa.eu/949/concepts/load-capability-line-categories/110> <http://data.europa.eu/949/concepts/load-capability-line-categories/120> ) ;
    sh:message "Value must be one of the CCSTMS-scoped LoadCapabilityLineCategories concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-airtight
    a sh:PropertyShape ;
    sh:path era:airtight ;
    sh:name "airtight" ;
    sh:description "indicates whether the train is fitted with an airtight system or not. see ss026, 7.5.1.61 M_AIRTIGHT" ;
    sh:order 7 ;
    rdfs:comment "ERTMS subset variable: M_AIRTIGHT"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/airtight-type/notFitted> <http://data.europa.eu/949/concepts/airtight-type/fitted> ) ;
    sh:message "Value must be one of the CCSTMS-scoped AirtightType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-axleNumber
    a sh:PropertyShape ;
    sh:path era:axleNumber ;
    sh:name "axleNumber" ;
    sh:description "This gives the number of axles of the single unit (fixed train set or locomotive) in which the onboard equipment is fitted. See ss026, 7.5.1.79.1 N_AXLE" ;
    sh:order 8 ;
    rdfs:comment "ERTMS subset variable: N_AXLE"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-tractionVoltage
    a sh:PropertyShape ;
    sh:path era:tractionVoltage ;
    sh:name "tractionVoltage" ;
    sh:description "supported Traction System voltage. see ss026, 7.4.3.5. Identity of the traction system NID_CTRACTION(k) given only if M_VOLTAGE(k) ≠ 0" ;
    sh:order 9 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:TractionVoltageShape ;
    sh:message "tractionVoltage must be a well-formed TractionVoltage (blank node or IRI)."@en ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-nidNtc
    a sh:PropertyShape ;
    sh:path era:nidNtc ;
    sh:name "nidNtc" ;
    sh:description "National System identity (Each value of this variable represents the identity of a National System). see ss026, 7.5.1.98 NID_NTC" ;
    sh:order 10 ;
    rdfs:comment "ERTMS subset variable: NID_NTC"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:maxCount 31 ;
    sh:severity sh:Violation ;
    .

opp-sh:ValidatedTrainData-vMaxTrain-multipleOf
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "vMaxTrain must be a multiple of 5 km/h."@en ;
    sh:select """
            SELECT $this
            WHERE {
                $this era:vMaxTrain ?v .
                FILTER ( ?v != FLOOR(?v / 5) * 5 )
            }
        """ ;
    .

### TractionVoltage ###################################################
opp-sh:TractionVoltageShape
    a sh:NodeShape ;
    sh:targetClass era:TractionVoltage ;
    sh:name "TractionVoltage" ;
    sh:description "It indicates the voltage of the traction system installed on a specific line or respectively that can be used by an engine" ;
    sh:property opp-sh:TractionVoltage-mVoltage ;
    sh:property opp-sh:TractionVoltage-countryTractionId ;
    sh:severity sh:Violation ;
    .

opp-sh:TractionVoltage-mVoltage
    a sh:PropertyShape ;
    sh:path era:mVoltage ;
    sh:name "mVoltage" ;
    sh:description "Special/Reserved values for Traction System voltage. It indicates the voltage of the traction system installed on a specific line or respectively that can be used by an engine. The identity of the traction system is given by M_VOLTAGE and, if M_VOLTAGE ≠ 0, by the country identifier of the traction system (NID_CTRACTION). see ss026,7.5.1.78 M_VOLTAGE" ;
    sh:order 1 ;
    rdfs:comment "ERTMS subset variable: M_VOLTAGE"@en ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/energy-supply-systems/notFitted> <http://data.europa.eu/949/concepts/energy-supply-systems/AC10> <http://data.europa.eu/949/concepts/energy-supply-systems/AC20> <http://data.europa.eu/949/concepts/energy-supply-systems/DC30> <http://data.europa.eu/949/concepts/energy-supply-systems/DC40> <http://data.europa.eu/949/concepts/energy-supply-systems/DC80> <http://data.europa.eu/949/concepts/energy-supply-systems/DC70> <http://data.europa.eu/949/concepts/energy-supply-systems/DC60> <http://data.europa.eu/949/concepts/energy-supply-systems/DC90> ) ;
    sh:message "Value must be one of the CCSTMS-scoped EnergySupplySystems concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TractionVoltage-countryTractionId
    a sh:PropertyShape ;
    sh:path era:countryTractionId ;
    sh:name "countryTractionId" ;
    sh:description "Country identifier of the traction system. It identifies the information, additional to M_VOLTAGE, required to fully define the traction system. Note that NID_CTRACTION given only if M_VOLTAGE ≠ 0. see ss026,7.5.1.86.1 NID_CTRACTION" ;
    sh:order 2 ;
    rdfs:comment "ERTMS subset variable: NID_CTRACTION"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 1023 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### MovementPermission ################################################
opp-sh:MovementPermissionShape
    a sh:NodeShape ;
    sh:targetClass era:MovementPermission ;
    sh:name "MovementPermission" ;
    sh:description "Defines path and speed profiles assigned to a train for its next movement." ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    sh:property opp-sh:MovementPermission-riskBuffer ;
