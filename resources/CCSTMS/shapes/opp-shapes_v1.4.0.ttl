opp-sh:TrainUnitReportAtoStatus-eventEstimations
    a sh:PropertyShape ;
    sh:path era:eventEstimations ;
    sh:name "eventEstimations" ;
    sh:description "Refers to event estimations" ;
    sh:order 17 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "eventEstimations is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:message "eventEstimations ist mit byIndex geordnet: es muss genau eine rdf:List tragen."@de ;
    sh:message "eventEstimations est ordonné par byIndex : il doit porter exactement une rdf:List."@fr ;
    sh:node opp-sh:TrainUnitReportAtoStatus-eventEstimations-items ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoStatus-eventEstimations-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "era:eventEstimations is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:message "era:eventEstimations ist mit byIndex geordnet und muss daher eine wohlgeformte, terminierte rdf:List sein: jede Listenzelle benötigt genau ein rdf:first und genau ein rdf:rest."@de ;
    sh:message "era:eventEstimations est ordonné par byIndex et doit donc être une rdf:List bien formée et terminée : chaque cellule de la liste nécessite exactement un rdf:first et exactement un rdf:rest."@fr ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:eventEstimations ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

opp-sh:TrainUnitReportAtoStatus-eventEstimations-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:eventEstimations"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node opp-sh:EventEstimationShape ;
        sh:message "eventEstimations must be a well-formed EventEstimation (blank node or IRI)."@en ;
        sh:message "eventEstimations muss ein wohlgeformtes EventEstimation sein (Blank Node oder IRI)."@de ;
        sh:message "eventEstimations doit être un EventEstimation bien formé (nœud vide ou IRI)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    .

### EventHandling #####################################################
opp-sh:EventHandlingShape
    a sh:NodeShape ;
    sh:targetClass era:EventHandling ;
    sh:name "EventHandling" ;
    sh:description "Defines, how the previous event was handled." ;
    sh:property opp-sh:EventHandling-event ;
    sh:property opp-sh:EventHandling-passStopDepart ;
    sh:severity sh:Violation ;
    .

opp-sh:EventHandling-event
    a sh:PropertyShape ;
    sh:path era:event ;
    sh:name "event" ;
    sh:description "refers a movement event including the movement plan" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:MovementEvent ;
    sh:message "event must reference an existing era:MovementEvent by IRI."@en ;
    sh:message "event muss über eine IRI auf ein bestehendes era:MovementEvent verweisen."@de ;
    sh:message "event doit référencer un era:MovementEvent existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:EventHandling-passStopDepart
    a sh:PropertyShape ;
    sh:path era:passStopDepart ;
    sh:name "passStopDepart" ;
    sh:description "Defines the result of the event handling action" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/movement-event-action/passedEvent> <http://data.europa.eu/949/concepts/movement-event-action/stoppedAccurateAtEvent> <http://data.europa.eu/949/concepts/movement-event-action/stoppedWithOvershootAtEvent> <http://data.europa.eu/949/concepts/movement-event-action/stoppedWithUndershootAtEvent> <http://data.europa.eu/949/concepts/movement-event-action/departedFromEvent> ) ;
    sh:message "Value must be one of the CCSTMS-scoped MovementEventAction concepts."@en ;
    sh:message "Der Wert muss einem der CCSTMS-Konzepte von MovementEventAction entsprechen."@de ;
    sh:message "La valeur doit correspondre à l'un des concepts CCSTMS de MovementEventAction."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### EventEstimation ###################################################
opp-sh:EventEstimationShape
    a sh:NodeShape ;
    sh:targetClass era:EventEstimation ;
    sh:name "EventEstimation" ;
    sh:description "Defines forecast for events coming from ATO-Onboard" ;
    sh:property opp-sh:EventEstimation-event ;
    sh:property opp-sh:EventEstimation-arrival ;
    sh:severity sh:Violation ;
    .

opp-sh:EventEstimation-event
    a sh:PropertyShape ;
    sh:path era:event ;
    sh:name "event" ;
    sh:description "refers a movement event including the movement plan" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:MovementEvent ;
    sh:message "event must reference an existing era:MovementEvent by IRI."@en ;
    sh:message "event muss über eine IRI auf ein bestehendes era:MovementEvent verweisen."@de ;
    sh:message "event doit référencer un era:MovementEvent existant par IRI."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:EventEstimation-arrival
    a sh:PropertyShape ;
    sh:path era:arrival ;
    sh:name "arrival" ;
    sh:description "Defines the arrival time in UTC" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid date-time."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein gültiges Datum/Zeit."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas une date-heure valide."@fr ;
    .

### TrainUnitReportAtoCapabilities ####################################
opp-sh:TrainUnitReportAtoCapabilitiesShape
    a sh:NodeShape ;
    sh:targetClass era:TrainUnitReportAtoCapabilities ;
    sh:name "TrainUnitReportAtoCapabilities" ;
    sh:description "Defines train capabilities reported by ATO from the train." ;
    sh:sparql opp-sh:TrainUnitReportAtoCapabilities-physicalConsists-listWellFormed ;
    sh:sparql opp-sh:TrainUnitReportAtoCapabilities-physicalConsists-listItemCount ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-issuedAt ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-operationalPlanMovement ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-trainUnitIdentifier ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-mass ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-outsideTemperature ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-etcsData ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-passengerLoad ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-lastPassengerExchangeTime ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-elapsedStartPassengerExchange ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-additionalTrainData ;
    sh:property opp-sh:TrainUnitReportAtoCapabilities-physicalConsists ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoCapabilities-issuedAt
    a sh:PropertyShape ;
    sh:path era:issuedAt ;
    sh:name "issuedAt" ;
    sh:description "Defines the issue-point in time with microsecond-resolution builds a version-id for acknowledgements and validity-estimations, in UTC" ;
    sh:order 1 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "issuedAt's own description states this microsecond-resolution timestamp itself functions as a version identifier, used for acknowledgements and validity checks. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid date-time."@en ;
    era:additionalInfo "Die eigene Beschreibung von issuedAt besagt, dass dieser Zeitstempel mit Mikrosekundenauflösung selbst als Versionskennung fungiert, die für Bestätigungen und Gültigkeitsprüfungen verwendet wird. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist kein gültiges Datum/Zeit."@de ;
    era:additionalInfo "La propre description de issuedAt indique que cet horodatage à résolution microseconde fonctionne lui-même comme un identifiant de version, utilisé pour les accusés de réception et les vérifications de validité. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas une date-heure valide."@fr ;
    .

opp-sh:TrainUnitReportAtoCapabilities-operationalPlanMovement
    a sh:PropertyShape ;
    sh:path era:operationalPlanMovement ;
    sh:name "operationalPlanMovement" ;
    sh:description "Refers to the operational plan movement. If the new train was created in TrafficCS it does not have an operationalPlan (Movement) yet" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:OperationalPlanMovement ;
    sh:message "operationalPlanMovement must reference an existing era:OperationalPlanMovement by IRI."@en ;
    sh:message "operationalPlanMovement muss über eine IRI auf ein bestehendes era:OperationalPlanMovement verweisen."@de ;
    sh:message "operationalPlanMovement doit référencer un era:OperationalPlanMovement existant par IRI."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoCapabilities-trainUnitIdentifier
    a sh:PropertyShape ;
    sh:path era:trainUnitIdentifier ;
    sh:name "trainUnitIdentifier" ;
    sh:description "defines the physical train unit identifier" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:PhysicalTrainUnitIdentifierShape ;
    sh:message "trainUnitIdentifier must be a well-formed PhysicalTrainUnitIdentifier (blank node or IRI)."@en ;
    sh:message "trainUnitIdentifier muss ein wohlgeformtes PhysicalTrainUnitIdentifier sein (Blank Node oder IRI)."@de ;
    sh:message "trainUnitIdentifier doit être un PhysicalTrainUnitIdentifier bien formé (nœud vide ou IRI)."@fr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoCapabilities-mass
    a sh:PropertyShape ;
    sh:path era:mass ;
    sh:name "mass" ;
    sh:description "train mass including load, 0 if unknown" ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloGM ;
    rdfs:comment "scaling exponent 2 (stored value x 10^2 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "mass is stored with a scaling exponent of 2: the raw stored integer must be multiplied by 100 to get the actual physical value in kilograms - a stored value of 50 means an actual mass of 5000 kg, not 50. Its own description also states that 0 should be used specifically to mean the mass is unknown, not that the train has no mass. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "mass wird mit einem Skalierungsexponenten von 2 gespeichert: der roh gespeicherte Ganzzahlwert muss mit 100 multipliziert werden, um den tatsächlichen physikalischen Wert in Kilogramm zu erhalten - ein gespeicherter Wert von 50 bedeutet eine tatsächliche Masse von 5000 kg, nicht 50. Die eigene Beschreibung besagt außerdem, dass 0 speziell verwendet werden soll, um auszudrücken, dass die Masse unbekannt ist, nicht dass der Zug keine Masse hat. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "mass est stocké avec un exposant d'échelle de 2 : l'entier brut stocké doit être multiplié par 100 pour obtenir la valeur physique réelle en kilogrammes - une valeur stockée de 50 signifie une masse réelle de 5000 kg, non 50. Sa propre description indique également que 0 doit être utilisé spécifiquement pour signifier que la masse est inconnue, non que le train n'a aucune masse. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

opp-sh:TrainUnitReportAtoCapabilities-outsideTemperature
    a sh:PropertyShape ;
    sh:path era:outsideTemperature ;
    sh:name "outsideTemperature" ;
    sh:description "Defines the outside temperature. Use 127 if unknown" ;
    sh:order 5 ;
    qudt:hasUnit unit:DEG ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:int ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "outsideTemperature's own description states that 127 should be used specifically to mean the temperature is unknown, not a literal reading of 127 degrees. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von outsideTemperature besagt, dass 127 speziell verwendet werden soll, um auszudrücken, dass die Temperatur unbekannt ist, nicht als wörtlicher Messwert von 127 Grad. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige Ganzzahl."@de ;
    era:additionalInfo "La propre description de outsideTemperature indique que 127 doit être utilisé spécifiquement pour signifier que la température est inconnue, non comme une lecture littérale de 127 degrés. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier valide."@fr ;
    .

opp-sh:TrainUnitReportAtoCapabilities-etcsData
    a sh:PropertyShape ;
    sh:path era:etcsData ;
    sh:name "etcsData" ;
    sh:description "Defines the valid ETCS Data for the train. Not provided if invalid" ;
    sh:order 6 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:EtcsDataAtoShape ;
    sh:message "etcsData must be a well-formed EtcsDataAto (blank node or IRI)."@en ;
    sh:message "etcsData muss ein wohlgeformtes EtcsDataAto sein (Blank Node oder IRI)."@de ;
    sh:message "etcsData doit être un EtcsDataAto bien formé (nœud vide ou IRI)."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoCapabilities-passengerLoad
    a sh:PropertyShape ;
    sh:path era:passengerLoad ;
    sh:name "passengerLoad" ;
    sh:description "255 unknown" ;
    sh:order 7 ;
    qudt:hasUnit unit:PERCENT ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "passengerLoad's own description states that 255 should be used specifically to mean the load is unknown, not a literal 255 percent. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is outside the 0-255 range."@en ;
    era:additionalInfo "Die eigene Beschreibung von passengerLoad besagt, dass 255 speziell verwendet werden soll, um auszudrücken, dass die Auslastung unbekannt ist, nicht als wörtliche 255 Prozent. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert liegt außerhalb des Bereichs 0-255."@de ;
    era:additionalInfo "La propre description de passengerLoad indique que 255 doit être utilisé spécifiquement pour signifier que la charge est inconnue, non comme 255 pour cent littéraux. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente est hors de la plage 0-255."@fr ;
    .

opp-sh:TrainUnitReportAtoCapabilities-lastPassengerExchangeTime
    a sh:PropertyShape ;
    sh:path era:lastPassengerExchangeTime ;
    sh:name "lastPassengerExchangeTime" ;
    sh:description "65535: unknown" ;
    sh:order 8 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "lastPassengerExchangeTime's own description states that 65535 should be used specifically to mean the value is unknown, not a literal time of 65535 seconds. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von lastPassengerExchangeTime besagt, dass 65535 speziell verwendet werden soll, um auszudrücken, dass der Wert unbekannt ist, nicht als wörtliche Zeit von 65535 Sekunden. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "La propre description de lastPassengerExchangeTime indique que 65535 doit être utilisé spécifiquement pour signifier que la valeur est inconnue, non comme un temps littéral de 65535 secondes. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

opp-sh:TrainUnitReportAtoCapabilities-elapsedStartPassengerExchange
    a sh:PropertyShape ;
    sh:path era:elapsedStartPassengerExchange ;
    sh:name "elapsedStartPassengerExchange" ;
    sh:description "Defines the time elapsed between standstill and the doors are released for operation or opening; 4096: unknown" ;
    sh:order 9 ;
    qudt:hasUnit unit:SEC ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "elapsedStartPassengerExchange's own description states that 4096 should be used specifically to mean the value is unknown, not a literal elapsed time of 4096 seconds. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von elapsedStartPassengerExchange besagt, dass 4096 speziell verwendet werden soll, um auszudrücken, dass der Wert unbekannt ist, nicht als wörtliche verstrichene Zeit von 4096 Sekunden. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "La propre description de elapsedStartPassengerExchange indique que 4096 doit être utilisé spécifiquement pour signifier que la valeur est inconnue, non comme un temps écoulé littéral de 4096 secondes. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

opp-sh:TrainUnitReportAtoCapabilities-additionalTrainData
    a sh:PropertyShape ;
    sh:path era:additionalTrainData ;
    sh:name "additionalTrainData" ;
    sh:description "Defines additional train data as part of ATO capabilities report" ;
    sh:order 10 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:AdditionalTrainDataShape ;
    sh:message "additionalTrainData must be a well-formed AdditionalTrainData (blank node or IRI)."@en ;
    sh:message "additionalTrainData muss ein wohlgeformtes AdditionalTrainData sein (Blank Node oder IRI)."@de ;
    sh:message "additionalTrainData doit être un AdditionalTrainData bien formé (nœud vide ou IRI)."@fr ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoCapabilities-physicalConsists
    a sh:PropertyShape ;
    sh:path era:physicalConsists ;
    sh:name "physicalConsists" ;
    sh:description "Defines the list of physical consists. Empty if unknown" ;
    sh:order 11 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "physicalConsists is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:message "physicalConsists ist mit byIndex geordnet: es muss genau eine rdf:List tragen."@de ;
    sh:message "physicalConsists est ordonné par byIndex : il doit porter exactement une rdf:List."@fr ;
    sh:node opp-sh:TrainUnitReportAtoCapabilities-physicalConsists-items ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoCapabilities-physicalConsists-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "era:physicalConsists is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:message "era:physicalConsists ist mit byIndex geordnet und muss daher eine wohlgeformte, terminierte rdf:List sein: jede Listenzelle benötigt genau ein rdf:first und genau ein rdf:rest."@de ;
    sh:message "era:physicalConsists est ordonné par byIndex et doit donc être une rdf:List bien formée et terminée : chaque cellule de la liste nécessite exactement un rdf:first et exactement un rdf:rest."@fr ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:physicalConsists ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

opp-sh:TrainUnitReportAtoCapabilities-physicalConsists-listItemCount
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "The single rdf:List carried by era:physicalConsists must hold between 0 and 255 item(s); the multiplicity bounds the items inside the list, not the number of lists."@en ;
    sh:message "Die einzelne rdf:List, die von era:physicalConsists getragen wird, muss zwischen 0 und 255 Element(e) enthalten; die Multiplizität begrenzt die Elemente innerhalb der Liste, nicht die Anzahl der Listen."@de ;
    sh:message "L'unique rdf:List portée par era:physicalConsists doit contenir entre 0 et 255 élément(s) ; la multiplicité borne les éléments à l'intérieur de la liste, pas le nombre de listes."@fr ;
    sh:select """
            SELECT $this (COUNT(?item) AS ?itemCount)
            WHERE {
                $this era:physicalConsists ?head .
                OPTIONAL {
                    ?head rdf:rest* ?cell .
                    FILTER ( ?cell != rdf:nil )
                    BIND ( ?cell AS ?item )
                }
            }
            GROUP BY $this
            HAVING ( COUNT(?item) > 255 )
        """ ;
    .

opp-sh:TrainUnitReportAtoCapabilities-physicalConsists-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:physicalConsists"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node opp-sh:PhysicalConsistShape ;
        sh:message "physicalConsists must be a well-formed PhysicalConsist (blank node or IRI)."@en ;
        sh:message "physicalConsists muss ein wohlgeformtes PhysicalConsist sein (Blank Node oder IRI)."@de ;
        sh:message "physicalConsists doit être un PhysicalConsist bien formé (nœud vide ou IRI)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    .

### EtcsDataAto #######################################################
opp-sh:EtcsDataAtoShape
    a sh:NodeShape ;
    sh:targetClass era:EtcsDataAto ;
    sh:name "EtcsDataAto" ;
    sh:description "Defines static train capability data reported by ATO" ;
    sh:property opp-sh:EtcsDataAto-trainLength ;
    sh:property opp-sh:EtcsDataAto-maxSpeed ;
    sh:property opp-sh:EtcsDataAto-cantDeficiencyCategory ;
    sh:property opp-sh:EtcsDataAto-otherInternationalCategory ;
    sh:property opp-sh:EtcsDataAto-axleLoadCategory ;
    sh:property opp-sh:EtcsDataAto-nominalRotatingMass ;
    sh:property opp-sh:EtcsDataAto-brakePercentage ;
    sh:property opp-sh:EtcsDataAto-preconfiguredBrakingModel ;
    sh:property opp-sh:EtcsDataAto-brakePosition ;
    sh:severity sh:Violation ;
    .

opp-sh:EtcsDataAto-trainLength
    a sh:PropertyShape ;
    sh:path era:trainLength ;
    sh:name "trainLength" ;
    sh:description "Defines the train length, 0 if unknown" ;
    sh:order 1 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "trainLength's own description states that 0 should be used specifically to mean the length is unknown, not a literal claim that the train has zero length. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von trainLength besagt, dass 0 speziell verwendet werden soll, um auszudrücken, dass die Länge unbekannt ist, nicht die wörtliche Aussage, dass der Zug die Länge null hat. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "La propre description de trainLength indique que 0 doit être utilisé spécifiquement pour signifier que la longueur est inconnue, non une affirmation littérale que le train a une longueur nulle. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

opp-sh:EtcsDataAto-maxSpeed
    a sh:PropertyShape ;
    sh:path era:maxSpeed ;
    sh:name "maxSpeed" ;
    sh:description "Defines the maximum applicable speed, use 0 if unknown" ;
    sh:order 2 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "maxSpeed's own description states that 0 should be used specifically to mean the value is unknown, not a literal maximum speed of zero. There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Die eigene Beschreibung von maxSpeed besagt, dass 0 speziell verwendet werden soll, um auszudrücken, dass der Wert unbekannt ist, nicht eine wörtliche Höchstgeschwindigkeit von null. Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "La propre description de maxSpeed indique que 0 doit être utilisé spécifiquement pour signifier que la valeur est inconnue, non une vitesse maximale littérale de zéro. Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

opp-sh:EtcsDataAto-cantDeficiencyCategory
    a sh:PropertyShape ;
