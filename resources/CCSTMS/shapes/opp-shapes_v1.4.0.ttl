@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix era:     <http://data.europa.eu/949/> .

@prefix opp-sh: <http://data.europa.eu/949/shapes/opp#> .



########################################################################
#  SPARQL prefix declarations
#
#  SHACL 5.3: the Turtle @prefix declarations above do NOT apply inside
#  sh:select - only sh:prefixes does. Without this, a query writing era:...
#  fails with "Unknown namespace prefix : era" on any data graph that does
#  not itself bind the same prefix (e.g. data written with full IRIs).
########################################################################

opp-sh:PrefixDeclarations
    a owl:Ontology ;
    rdfs:label "Prefixes available to every sh:select in this file"@en ;
    sh:declare
        [ sh:prefix "era"  ; sh:namespace "http://data.europa.eu/949/"^^xsd:anyURI ] ,
        [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd"  ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ;
    .

########################################################################
#  Imported shapes
#
#  opp references or composes these structs from other
#  modules, so their shapes are inlined here for completeness (rule 17).
#  They are minted in this module's namespace, prefixed with the source
#  module, so this file never collides with the owning module's own
#  shapes file. Loading both simply reports shared classes twice.
########################################################################

### NetLinearReference ################################################
opp-sh:infra-NetLinearReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetLinearReference ;
    sh:name "NetLinearReference" ;
    sh:description "Defines a linked path on the topology" ;
    sh:sparql opp-sh:infra-NetLinearReference-hasSequence-listWellFormed ;
    sh:property opp-sh:infra-NetLinearReference-startsAt ;
    sh:property opp-sh:infra-NetLinearReference-endsAt ;
    sh:property opp-sh:infra-NetLinearReference-hasSequence ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-NetLinearReference-startsAt
    a sh:PropertyShape ;
    sh:path era:startsAt ;
    sh:name "startsAt" ;
    sh:description "Definesthe starting point of a linear reference" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetPointReferenceShape ;
    sh:message "startsAt must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-NetLinearReference-endsAt
    a sh:PropertyShape ;
    sh:path era:endsAt ;
    sh:name "endsAt" ;
    sh:description "Specifies the ending point of a linear reference" ;
    sh:order 2 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetPointReferenceShape ;
    sh:message "endsAt must be a well-formed NetPointReference (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-NetLinearReference-hasSequence
    a sh:PropertyShape ;
    sh:path era:hasSequence ;
    sh:name "hasSequence" ;
    sh:description "The ordered sequence of topological linear elements which create a linear net reference." ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:message "hasSequence is ordered byIndex: it must carry exactly one rdf:List."@en ;
    sh:node opp-sh:infra-NetLinearReference-hasSequence-items ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-NetLinearReference-hasSequence-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "era:hasSequence is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:hasSequence ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

opp-sh:infra-NetLinearReference-hasSequence-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:hasSequence"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:IRI ;
        sh:class era:LinearElement ;
        sh:message "hasSequence must reference an existing era:LinearElement by IRI."@en ;
        sh:severity sh:Violation ;
    ] ;
    .

### SwitchableTracksideAsset ##########################################
opp-sh:tp-SwitchableTracksideAssetShape
    a sh:NodeShape ;
    sh:targetClass era:SwitchableTracksideAsset ;
    sh:name "SwitchableTracksideAsset" ;
    sh:description "Defines Switchable Trackside Asset" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:tp-SwitchableTracksideAsset-name ;
    sh:property opp-sh:tp-SwitchableTracksideAsset-switchableTracksideAssetSections ;
    sh:property opp-sh:tp-SwitchableTracksideAsset-protectedInfraElements ;
    sh:property opp-sh:tp-SwitchableTracksideAsset-dependenciesType ;
    sh:property opp-sh:tp-SwitchableTracksideAsset-switchableTracksideAssetsDependencies ;
    sh:property opp-sh:tp-SwitchableTracksideAsset-runTime ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-SwitchableTracksideAsset-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-SwitchableTracksideAsset-switchableTracksideAssetSections
    a sh:PropertyShape ;
    sh:path era:switchableTracksideAssetSections ;
    sh:name "Switchable Trackside Asset Section" ;
    sh:description "Composes of Switchable Trackside Asset Sections" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:tp-SwitchableTracksideAssetSectionShape ;
    sh:message "switchableTracksideAssetSections must be a well-formed SwitchableTracksideAssetSection (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-SwitchableTracksideAsset-protectedInfraElements
    a sh:PropertyShape ;
    sh:path era:protectedInfraElements ;
    sh:name "Protected Infrastructure Elements" ;
    sh:description "Composes of Protected Infra Element" ;
    sh:order 4 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:tp-ProtectedInfraElementShape ;
    sh:message "protectedInfraElements must be a well-formed ProtectedInfraElement (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-SwitchableTracksideAsset-dependenciesType
    a sh:PropertyShape ;
    sh:path era:dependenciesType ;
    sh:name "dependenciesType" ;
    sh:description "defines dependencies between n Switchable Trackside Asset Sections" ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/dependency-type/exclusive> <http://data.europa.eu/949/concepts/dependency-type/equivalent> <http://data.europa.eu/949/concepts/dependency-type/specific> ) ;
    sh:message "Value must be one of the CCSTMS-scoped DependencyType concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-SwitchableTracksideAsset-switchableTracksideAssetsDependencies
    a sh:PropertyShape ;
    sh:path era:switchableTracksideAssetsDependencies ;
    sh:name "Switchable Trackside Assets Dependencies" ;
    sh:description "contains row-wise bit matrix with column = index of the element in DriveProtectionSectionGroup. 0 means not allowed to use ; 1 means allowed to use for rail traffic. Each line in the matrix contains a valid state of the DriveProtectionSectionGroup ; Use only if DPSDependencyType == Specific" ;
    sh:order 6 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-SwitchableTracksideAsset-runTime
    a sh:PropertyShape ;
    sh:path era:runTime ;
    sh:name "runTime" ;
    sh:description "Defines the total time required for the DPS(s) in a DPS Group to switch from one position to the other" ;
    sh:order 7 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### NetPointReference #################################################
opp-sh:infra-NetPointReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetPointReference ;
    sh:name "NetPointReference" ;
    sh:description "Represents a point reference in the network." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property opp-sh:infra-NetPointReference-hasTopoCoordinate ;
    sh:property opp-sh:infra-NetPointReference-appliesToDirection ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-NetPointReference-hasTopoCoordinate
    a sh:PropertyShape ;
    sh:path era:hasTopoCoordinate ;
    sh:name "hasTopoCoordinate" ;
    sh:description "Defines the topological coordinate of a network point reference" ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-TopologicalCoordinateShape ;
    sh:message "hasTopoCoordinate must be a well-formed TopologicalCoordinate (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-NetPointReference-appliesToDirection
    a sh:PropertyShape ;
    sh:path era:appliesToDirection ;
    sh:name "appliesToDirection" ;
    sh:description "The direction relative to the origin of the linear element towards the point reference applies" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:in ( <http://data.europa.eu/949/concepts/orientations/02> <http://data.europa.eu/949/concepts/orientations/00> <http://data.europa.eu/949/concepts/orientations/01> ) ;
    sh:message "Value must be one of the CCSTMS-scoped OrientationDirections concepts."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### LinearElement #####################################################
opp-sh:infra-LinearElementShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElement ;
    sh:name "LinearElement" ;
    sh:description "A linear element is an uninterrupted stretch of railway track, without divergence or convergence." ;
    rdfs:comment "sub-package: topology" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:infra-LinearElement-lengthOfNetLinearElement ;
    sh:property opp-sh:infra-LinearElement-name ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-LinearElement-lengthOfNetLinearElement
    a sh:PropertyShape ;
    sh:path era:lengthOfNetLinearElement ;
    sh:name "lengthOfNetLinearElement" ;
    sh:description "Defines the distance along the LinearElement's track centre line." ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-LinearElement-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 3 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### LinearElementSection ##############################################
opp-sh:infra-LinearElementSectionShape
    a sh:NodeShape ;
    sh:targetClass era:LinearElementSection ;
    sh:name "LinearElementSection" ;
    sh:description "Defines adirected linear object (with a linear extension) located on a LinearElement" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property opp-sh:infra-LinearElementSection-onElement ;
    sh:property opp-sh:infra-LinearElementSection-startOffsetFromOrigin ;
    sh:property opp-sh:infra-LinearElementSection-endOffsetFromOrigin ;
    sh:property opp-sh:infra-LinearElementSection-appliesInBothDirections ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-LinearElementSection-onElement
    a sh:PropertyShape ;
    sh:path era:onElement ;
    sh:name "onElement" ;
    sh:description "Specifies the linear element a section belongs to." ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "onElement must reference an existing era:LinearElement by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-LinearElementSection-startOffsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:startOffsetFromOrigin ;
    sh:name "startOffsetFromOrigin" ;
    sh:description "Defines the start offset from the origin" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-LinearElementSection-endOffsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:endOffsetFromOrigin ;
    sh:name "endOffsetFromOrigin" ;
    sh:description "Defines the end offset from the origin" ;
    sh:order 3 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-LinearElementSection-appliesInBothDirections
    a sh:PropertyShape ;
    sh:path era:appliesInBothDirections ;
    sh:name "appliesInBothDirections" ;
    sh:description "Defines if the section applies in both directions" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### NetAreaReference ##################################################
opp-sh:infra-NetAreaReferenceShape
    a sh:NodeShape ;
    sh:targetClass era:NetAreaReference ;
    sh:name "NetAreaReference" ;
    sh:description "Represents an area reference in the network." ;
    sh:property opp-sh:infra-NetAreaReference-includes ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-NetAreaReference-includes
    a sh:PropertyShape ;
    sh:path era:includes ;
    sh:name "includes" ;
    sh:description "List of linear references included in an network area reference." ;
    sh:order 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-NetLinearReferenceShape ;
    sh:message "includes must be a well-formed NetLinearReference (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    .

### SwitchableTracksideAssetSection ###################################
opp-sh:tp-SwitchableTracksideAssetSectionShape
    a sh:NodeShape ;
    sh:targetClass era:SwitchableTracksideAssetSection ;
    sh:name "SwitchableTracksideAssetSection" ;
    sh:description "Defines Switchable Trackside Asset Section" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:tp-SwitchableTracksideAssetSection-name ;
    sh:property opp-sh:tp-SwitchableTracksideAssetSection-linearElementSection ;
    sh:property opp-sh:tp-SwitchableTracksideAssetSection-maxFlankProtectionSpeed ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-SwitchableTracksideAssetSection-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 2 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-SwitchableTracksideAssetSection-linearElementSection
    a sh:PropertyShape ;
    sh:path era:linearElementSection ;
    sh:name "linearElementSection" ;
    sh:description "Composes of the Linear Element Section" ;
    sh:order 3 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node opp-sh:infra-LinearElementSectionShape ;
    sh:message "linearElementSection must be a well-formed LinearElementSection (blank node or IRI)."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-SwitchableTracksideAssetSection-maxFlankProtectionSpeed
    a sh:PropertyShape ;
    sh:path era:maxFlankProtectionSpeed ;
    sh:name "Maximum Flank Protection Speed" ;
    sh:description "Defines the Maximum Speed Allowed on the Switchable Trackside Asset when it is set for Flank Protection" ;
    sh:order 4 ;
    qudt:hasUnit unit:KiloM-PER-HR ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### ProtectedInfraElement #############################################
opp-sh:tp-ProtectedInfraElementShape
    a sh:NodeShape ;
    sh:targetClass era:ProtectedInfraElement ;
    sh:name "ProtectedInfraElement" ;
    sh:description "Defines Protected Infra Element" ;
    sh:xone (
        opp-sh:tp-ProtectedInfraElement-switch-present
        opp-sh:tp-ProtectedInfraElement-slipCrossing-present
        opp-sh:tp-ProtectedInfraElement-crossing-present
        opp-sh:tp-ProtectedInfraElement-derailer-present
        opp-sh:tp-ProtectedInfraElement-levelCrossing-present
    ) ;
    sh:message "ProtectedInfraElement is a union: exactly one of (switch, slipCrossing, crossing, derailer, levelCrossing) must be present."@en ;
    sh:property opp-sh:tp-ProtectedInfraElement-switch ;
    sh:property opp-sh:tp-ProtectedInfraElement-slipCrossing ;
    sh:property opp-sh:tp-ProtectedInfraElement-crossing ;
    sh:property opp-sh:tp-ProtectedInfraElement-derailer ;
    sh:property opp-sh:tp-ProtectedInfraElement-levelCrossing ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-ProtectedInfraElement-switch
    a sh:PropertyShape ;
    sh:path era:switch ;
    sh:name "switch" ;
    sh:description "References the infra switch" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Switch ;
    sh:message "switch must reference an existing era:Switch by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-ProtectedInfraElement-slipCrossing
    a sh:PropertyShape ;
    sh:path era:slipCrossing ;
    sh:name "slipCrossing" ;
    sh:description "References the infra slip crossing" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:SlipCrossing ;
    sh:message "slipCrossing must reference an existing era:SlipCrossing by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-ProtectedInfraElement-crossing
    a sh:PropertyShape ;
    sh:path era:crossing ;
    sh:name "crossing" ;
    sh:description "References the infra crossing" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Crossing ;
    sh:message "crossing must reference an existing era:Crossing by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-ProtectedInfraElement-derailer
    a sh:PropertyShape ;
    sh:path era:derailer ;
    sh:name "derailer" ;
    sh:description "References the infra derailer" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Derailer ;
    sh:message "derailer must reference an existing era:Derailer by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-ProtectedInfraElement-levelCrossing
    a sh:PropertyShape ;
    sh:path era:levelCrossing ;
    sh:name "levelCrossing" ;
    sh:description "References the infra level crossing" ;
    sh:order 5 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LevelCrossing ;
    sh:message "levelCrossing must reference an existing era:LevelCrossing by IRI."@en ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:tp-ProtectedInfraElement-switch-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:switch is present"@en ;
    sh:property opp-sh:tp-ProtectedInfraElement-switch-required ;
    .

opp-sh:tp-ProtectedInfraElement-switch-required
    a sh:PropertyShape ;
    sh:path era:switch ;
    sh:minCount 1 ;
    .

opp-sh:tp-ProtectedInfraElement-slipCrossing-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:slipCrossing is present"@en ;
    sh:property opp-sh:tp-ProtectedInfraElement-slipCrossing-required ;
    .

opp-sh:tp-ProtectedInfraElement-slipCrossing-required
    a sh:PropertyShape ;
    sh:path era:slipCrossing ;
    sh:minCount 1 ;
    .

opp-sh:tp-ProtectedInfraElement-crossing-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:crossing is present"@en ;
    sh:property opp-sh:tp-ProtectedInfraElement-crossing-required ;
    .

opp-sh:tp-ProtectedInfraElement-crossing-required
    a sh:PropertyShape ;
    sh:path era:crossing ;
    sh:minCount 1 ;
    .

opp-sh:tp-ProtectedInfraElement-derailer-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:derailer is present"@en ;
    sh:property opp-sh:tp-ProtectedInfraElement-derailer-required ;
    .

opp-sh:tp-ProtectedInfraElement-derailer-required
    a sh:PropertyShape ;
    sh:path era:derailer ;
    sh:minCount 1 ;
    .

opp-sh:tp-ProtectedInfraElement-levelCrossing-present
    a sh:NodeShape ;
    rdfs:label "Union alternative: era:levelCrossing is present"@en ;
    sh:property opp-sh:tp-ProtectedInfraElement-levelCrossing-required ;
    .

opp-sh:tp-ProtectedInfraElement-levelCrossing-required
    a sh:PropertyShape ;
    sh:path era:levelCrossing ;
    sh:minCount 1 ;
    .

### TopologicalCoordinate #############################################
opp-sh:infra-TopologicalCoordinateShape
    a sh:NodeShape ;
    sh:targetClass era:TopologicalCoordinate ;
    sh:name "TopologicalCoordinate" ;
    sh:description "Defines a topological coordinate on the track" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    sh:property opp-sh:infra-TopologicalCoordinate-onLinearElement ;
    sh:property opp-sh:infra-TopologicalCoordinate-offsetFromOrigin ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-TopologicalCoordinate-onLinearElement
    a sh:PropertyShape ;
    sh:path era:onLinearElement ;
    sh:name "onLinearElement" ;
    sh:description "is positioned on linear element" ;
    sh:order 1 ;
    sh:nodeKind sh:IRI ;
    sh:class era:LinearElement ;
    sh:message "onLinearElement must reference an existing era:LinearElement by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-TopologicalCoordinate-offsetFromOrigin
    a sh:PropertyShape ;
    sh:path era:offsetFromOrigin ;
    sh:name "offsetFromOrigin" ;
    sh:description "position on the associated NetElement" ;
    sh:order 2 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### Switch ############################################################
opp-sh:infra-SwitchShape
    a sh:NodeShape ;
    sh:targetClass era:Switch ;
    sh:name "Switch" ;
    sh:description "A unit of track comprising two fixed rails (stock rails) and two movable rails (switch rails) used to direct vehicles from one track to another track." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:property opp-sh:infra-Switch-reversalTime ;
    sh:property opp-sh:infra-Switch-leftBranch ;
    sh:property opp-sh:infra-Switch-rightBranch ;
    sh:property opp-sh:infra-Switch-name ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-Switch-reversalTime
    a sh:PropertyShape ;
    sh:path era:reversalTime ;
    sh:name "reversalTime" ;
    sh:description "Defines the time in seconds to switch from one position to the other" ;
    sh:order 2 ;
    qudt:hasUnit unit:SEC ;
    rdfs:comment "scaling exponent -1 (stored value x 10^-1 = physical value)"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-Switch-leftBranch
    a sh:PropertyShape ;
    sh:path era:leftBranch ;
    sh:name "leftBranch" ;
    sh:description "NetRelation referencing the left side of the switch in the facing direction of the switch" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:NetRelation ;
    sh:message "leftBranch must reference an existing era:NetRelation by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-Switch-rightBranch
    a sh:PropertyShape ;
    sh:path era:rightBranch ;
    sh:name "rightBranch" ;
    sh:description "NetRelation referencing the right side of the switch in the facing direction of the switch" ;
    sh:order 4 ;
    sh:nodeKind sh:IRI ;
    sh:class era:NetRelation ;
    sh:message "rightBranch must reference an existing era:NetRelation by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-Switch-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 5 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### SlipCrossing ######################################################
opp-sh:infra-SlipCrossingShape
    a sh:NodeShape ;
    sh:targetClass era:SlipCrossing ;
    sh:name "SlipCrossing" ;
    sh:description "Defines the physical track asset Slip Crossing ; 2 instances switch point define a single slip crossing and 4 instances of switch point defined a double slip crossing ; Reversal time is the maximum of known reversal times of switches. If the reversal time of at least one switch in the slip point is unknown, the reversal time of the slip point is unknown as well." ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
    rdfs:comment "Globally identified by 'id'."@en ;
    sh:nodeKind sh:IRI ;
    sh:or (
        [ sh:property [ sh:path era:switches ; sh:minCount 2 ; sh:maxCount 2 ] ]
        [ sh:property [ sh:path era:switches ; sh:minCount 4 ; sh:maxCount 4 ] ]
    ) ;
    sh:message "A SlipCrossing must reference exactly two switches (single slip crossing) or exactly four switches (double slip crossing) - never three (see formatNote on SlipCrossing.switches)."@en ;
    sh:property opp-sh:infra-SlipCrossing-switches ;
    sh:property opp-sh:infra-SlipCrossing-crossing ;
    sh:property opp-sh:infra-SlipCrossing-name ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-SlipCrossing-switches
    a sh:PropertyShape ;
    sh:path era:switches ;
    sh:name "switches" ;
    sh:description "Consists of simple points" ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Switch ;
    sh:message "switches must reference an existing era:Switch by IRI."@en ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-SlipCrossing-crossing
    a sh:PropertyShape ;
    sh:path era:crossing ;
    sh:name "crossing" ;
    sh:description "Consists of crossing" ;
    sh:order 3 ;
    sh:nodeKind sh:IRI ;
    sh:class era:Crossing ;
    sh:message "crossing must reference an existing era:Crossing by IRI."@en ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:infra-SlipCrossing-name
    a sh:PropertyShape ;
    sh:path era:name ;
    sh:name "name" ;
    sh:description "User-friendly name, only if different from id" ;
    sh:order 4 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

### Crossing ##########################################################
opp-sh:infra-CrossingShape
    a sh:NodeShape ;
    sh:targetClass era:Crossing ;
    sh:name "Crossing" ;
    sh:description "Defines the physical track asset Crossing without possibility to switch between two linear elements" ;
    rdfs:comment "sub-package: FunctionalArea" ;
    rdfs:comment "The 'id' attribute is not asserted as a property: in the ontology it is carried by the IRI."@en ;
