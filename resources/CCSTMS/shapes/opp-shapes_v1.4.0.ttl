    sh:order 9 ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    .

opp-sh:TrainUnitReportAtoStatus-unableToStopAtNextStoppingPoint
    a sh:PropertyShape ;
    sh:path era:unableToStopAtNextStoppingPoint ;
    sh:name "unableToStopAtNextStoppingPoint" ;
    sh:description "Defines if the the train is too close and/or too fast for stopping. Defined in SS126.STR.Q_STR_Indicators.bit6" ;
    sh:order 10 ;
