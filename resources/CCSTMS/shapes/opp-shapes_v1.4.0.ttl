    sh:name "scheduledTrainLength" ;
    sh:description "Defines the scheduled train length in meters" ;
    sh:order 10 ;
    qudt:hasUnit unit:M ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:unsignedInt ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    era:additionalInfo "There is no custom message defined for this specific check, so the validation engine's own generic text is shown for any of three different causes: the value is missing entirely, more than one value is recorded, or the value present is not a valid unsigned integer."@en ;
    era:additionalInfo "Für diese konkrete Prüfung ist keine eigene Meldung definiert, daher wird der allgemeine Text der Validierungs-Engine für drei unterschiedliche Ursachen angezeigt: der Wert fehlt vollständig, es ist mehr als ein Wert erfasst, oder der vorhandene Wert ist keine gültige vorzeichenlose Ganzzahl."@de ;
    era:additionalInfo "Aucun message personnalisé n'est défini pour cette vérification spécifique, le texte générique du moteur de validation est donc affiché pour trois causes différentes : la valeur est totalement absente, plus d'une valeur est enregistrée, ou la valeur présente n'est pas un entier non signé valide."@fr ;
    .

opp-sh:TrainUnit-operationalConsists-listWellFormed
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "era:operationalConsists is ordered byIndex and must therefore be a well-formed, terminated rdf:List: every list cell needs exactly one rdf:first and exactly one rdf:rest."@en ;
    sh:message "era:operationalConsists ist mit byIndex geordnet und muss daher eine wohlgeformte, terminierte rdf:List sein: jede Listenzelle benötigt genau ein rdf:first und genau ein rdf:rest."@de ;
    sh:message "era:operationalConsists est ordonné par byIndex et doit donc être une rdf:List bien formée et terminée : chaque cellule de la liste nécessite exactement un rdf:first et exactement un rdf:rest."@fr ;
    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this era:operationalConsists ?head .
                ?head rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                { FILTER NOT EXISTS { ?cell rdf:first ?f } }
                UNION
                { FILTER NOT EXISTS { ?cell rdf:rest ?r } }
                UNION
                { ?cell rdf:first ?f1, ?f2 . FILTER ( ?f1 != ?f2 ) }
                UNION
                { ?cell rdf:rest ?r1, ?r2 . FILTER ( ?r1 != ?r2 ) }
            }
        """ ;
    .

opp-sh:TrainUnit-operationalConsists-listItemCount
    a sh:SPARQLConstraint ;
    sh:prefixes opp-sh:PrefixDeclarations ;
    sh:message "The single rdf:List carried by era:operationalConsists must hold at least 1 item(s); the multiplicity bounds the items inside the list, not the number of lists."@en ;
    sh:message "Die einzelne rdf:List, die von era:operationalConsists getragen wird, muss mindestens 1 Element(e) enthalten; die Multiplizität begrenzt die Elemente innerhalb der Liste, nicht die Anzahl der Listen."@de ;
    sh:message "L'unique rdf:List portée par era:operationalConsists doit contenir au moins 1 élément(s) ; la multiplicité borne les éléments à l'intérieur de la liste, pas le nombre de listes."@fr ;
    sh:select """
            SELECT $this (COUNT(?item) AS ?itemCount)
            WHERE {
                $this era:operationalConsists ?head .
                OPTIONAL {
                    ?head rdf:rest* ?cell .
                    FILTER ( ?cell != rdf:nil )
                    BIND ( ?cell AS ?item )
                }
            }
            GROUP BY $this
            HAVING ( COUNT(?item) < 1 )
        """ ;
    .

opp-sh:TrainUnit-operationalConsists-items
    a sh:NodeShape ;
    rdfs:label "Items of the rdf:List carried by era:operationalConsists"@en ;
    sh:property [
        a sh:PropertyShape ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node opp-sh:OperationalConsistShape ;
        sh:message "operationalConsists must be a well-formed OperationalConsist (blank node or IRI)."@en ;
        sh:message "operationalConsists muss ein wohlgeformtes OperationalConsist sein (Blank Node oder IRI)."@de ;
        sh:message "operationalConsists doit être un OperationalConsist bien formé (nœud vide ou IRI)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    .

