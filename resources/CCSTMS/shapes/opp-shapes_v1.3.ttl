@prefix era: <http://data.europa.eu/949/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== Additional Event Time Shape =====
era:AdditionalEventTimeShape a sh:NodeShape ;
    sh:targetClass era:AdditionalEventTime ;
    sh:message "Represents additional timing information for train events at stations or operational points."@en ;
    sh:message "Stellt zusätzliche Zeitinformationen für Zugereignisse an Bahnhöfen oder Betriebspunkten dar."@de ;
    sh:message "Représente des informations de synchronisation supplémentaires pour les événements ferroviaires dans les gares ou les points opérationnels."@fr ;
    
    # Time Type (required, controlled vocabulary - type of timing event)
    sh:property [ 
        sh:path era:timeType ;
        sh:in (
            <http://data.europa.eu/949/concepts/time-type/plannedArrival>
            <http://data.europa.eu/949/concepts/time-type/plannedDeparture>
            <http://data.europa.eu/949/concepts/time-type/plannedMinDwellTime>
            <http://data.europa.eu/949/concepts/time-type/publishedArrival>
            <http://data.europa.eu/949/concepts/time-type/publishedDeparture>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property timeType must have a value from the defined SKOS concept scheme (plannedArrival, plannedDeparture, plannedMinDwellTime, publishedArrival, or publishedDeparture)."@en ;
        sh:message "Die Eigenschaft timeType muss einen Wert aus dem definierten SKOS-Konzeptschema (plannedArrival, plannedDeparture, plannedMinDwellTime, publishedArrival oder publishedDeparture) haben."@de ;
        sh:message "La propriété timeType doit avoir une valeur du schéma conceptuel SKOS défini (plannedArrival, plannedDeparture, plannedMinDwellTime, publishedArrival ou publishedDeparture)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Time Value (required, dateTime - actual timestamp)
    sh:property [ 
        sh:path era:timeValue ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AdditionalEventTime must have exactly one timeValue (xsd:dateTime)."@en ;
        sh:message "Jede AdditionalEventTime muss genau ein timeValue (xsd:dateTime) haben."@de ;
        sh:message "Chaque AdditionalEventTime doit avoir exactement un timeValue (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Additional Train Data Shape =====
era:AdditionalTrainDataShape a sh:NodeShape ;
    sh:targetClass era:AdditionalTrainData ;
    sh:message "Additional train performance and braking characteristics data (ETCS Train Data)."@en ;
    sh:message "Zusätzliche Zugleistungs- und Bremseigenschaftendaten (ETCS Train Data)."@de ;
    sh:message "Données supplémentaires sur les performances des trains et les caractéristiques de freinage (ETCS Train Data)."@fr ;
    
    # Available Adhesion Category (required, controlled vocabulary - rail-wheel adhesion level)
    sh:property [ 
        sh:path era:availableAdhesionCategory ;
        sh:in (
            <http://data.europa.eu/949/concepts/adhesion-category/dryRailHigh>
            <http://data.europa.eu/949/concepts/adhesion-category/dryRailMedium>
            <http://data.europa.eu/949/concepts/adhesion-category/dryRailLow>
            <http://data.europa.eu/949/concepts/adhesion-category/lowAdhesion>
            <http://data.europa.eu/949/concepts/adhesion-category/veryLowAdhesion>
            <http://data.europa.eu/949/concepts/adhesion-category/extremelyLowAdhesion>
            <http://data.europa.eu/949/concepts/adhesion-category/unknownAdhesion>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property availableAdhesionCategory must have a value from the defined SKOS concept scheme (dryRailHigh through extremelyLowAdhesion, or unknownAdhesion)."@en ;
        sh:message "Die Eigenschaft availableAdhesionCategory muss einen Wert aus dem definierten SKOS-Konzeptschema (dryRailHigh bis extremelyLowAdhesion oder unknownAdhesion) haben."@de ;
        sh:message "La propriété availableAdhesionCategory doit avoir une valeur du schéma de concept SKOS défini (dryRailHigh à extremelyLowAdhesion ou unknownAdhesion)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Available Adhesion Physical Value (required, unsigned integer - adhesion coefficient)
    sh:property [ 
        sh:path era:availableAdhesionPhysicalValue ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AdditionalTrainData must have exactly one availableAdhesionPhysicalValue (unsigned integer, adhesion coefficient as percentage * 100)."@en ;
        sh:message "Jedes AdditionalTrainData muss genau eine availableAdhesionPhysicalValue haben (vorzeichenlose Ganzzahl, Adhäsionskoeffizient als Prozentsatz * 100)."@de ;
        sh:message "Chaque AdditionalTrainData doit avoir exactement un availableAdhesionPhysicalValue (entier non signé, coefficient d'adhérence en pourcentage * 100)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Max Available Tractive Effort (required, unsigned integer 0-3000 - in kN)
    sh:property [ 
        sh:path era:maxAvailableTractiveEffort ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3000 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AdditionalTrainData must have exactly one maxAvailableTractiveEffort (unsigned integer 0-3000, in kilonewtons)."@en ;
        sh:message "Jedes AdditionalTrainData muss genau eine maxAvailableTractiveEffort (vorzeichenlose Ganzzahl 0-3000, in Kilonewton) haben."@de ;
        sh:message "Chaque AdditionalTrainData doit avoir exactement un maxAvailableTractiveEffort (entier non signé compris entre 0 et 3 000, en kilonewtons)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Max Available Tractive Power (required, unsigned integer 0-32000 - in kW)
    sh:property [ 
        sh:path era:maxAvailableTractivePower ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32000 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AdditionalTrainData must have exactly one maxAvailableTractivePower (unsigned integer 0-32000, in kilowatts)."@en ;
        sh:message "Jedes AdditionalTrainData muss genau eine maxAvailableTractivePower (vorzeichenlose Ganzzahl 0-32000, in Kilowatt) haben."@de ;
        sh:message "Chaque AdditionalTrainData doit avoir exactement un maxAvailableTractivePower (entier non signé compris entre 0 et 32 ​​000, en kilowatts)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Max Available Service Brake Force (required, unsigned integer 0-3000 - in kN)
    sh:property [ 
        sh:path era:maxAvailableServiceBrakeForce ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3000 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AdditionalTrainData must have exactly one maxAvailableServiceBrakeForce (unsigned integer 0-3000, in kilonewtons)."@en ;
        sh:message "Jedes AdditionalTrainData muss genau eine maxAvailableServiceBrakeForce (vorzeichenlose Ganzzahl 0-3000, in Kilonewton) haben."@de ;
        sh:message "Chaque AdditionalTrainData doit avoir exactement un maxAvailableServiceBrakeForce (entier non signé compris entre 0 et 3 000, en kilonewtons)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Max Available Dynamic Brake Force (required, unsigned integer 0-3000 - in kN)
    sh:property [ 
        sh:path era:maxAvailableDynamicBrakeForce ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3000 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AdditionalTrainData must have exactly one maxAvailableDynamicBrakeForce (unsigned integer 0-3000, in kilonewtons)."@en ;
        sh:message "Jedes AdditionalTrainData muss genau eine maxAvailableDynamicBrakeForce (vorzeichenlose Ganzzahl 0-3000, in Kilonewton) haben."@de ;
        sh:message "Chaque AdditionalTrainData doit avoir exactement un maxAvailableDynamicBrakeForce (entier non signé compris entre 0 et 3 000, en kilonewtons)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Max Available Dynamic Brake Power (required, unsigned integer 0-32000 - in kW)
    sh:property [ 
        sh:path era:maxAvailableDynamicBrakePower ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 32000 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AdditionalTrainData must have exactly one maxAvailableDynamicBrakePower (unsigned integer 0-32000, in kilowatts)."@en ;
        sh:message "Jedes AdditionalTrainData muss genau eine maxAvailableDynamicBrakePower (vorzeichenlose Ganzzahl 0-32000, in Kilowatt) haben."@de ;
        sh:message "Chaque AdditionalTrainData doit avoir exactement un maxAvailableDynamicBrakePower (entier non signé compris entre 0 et 32 ​​000, en kilowatts)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Electro-Pneumatic Brake State (required, controlled vocabulary - brake system active state)
    sh:property [ 
        sh:path era:electroPneumaticBrakeState ;
        sh:in (
            <http://data.europa.eu/949/concepts/active-state/activeState>
            <http://data.europa.eu/949/concepts/active-state/inactiveState>
            <http://data.europa.eu/949/concepts/active-state/undefinedState>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property electroPneumaticBrakeState must have a value from the defined SKOS concept scheme (activeState, inactiveState, or undefinedState)."@en ;
        sh:message "Die Eigenschaft electroPneumaticBrakeState muss einen Wert aus dem definierten SKOS-Konzeptschema (activeState, inactiveState oder undefinedState) haben."@de ;
        sh:message "La propriété electroPneumaticBrakeState doit avoir une valeur du schéma de concept SKOS défini (activeState, dansactiveState ou undefinedState)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Regenerative Brake State (required, controlled vocabulary - brake system active state)
    sh:property [ 
        sh:path era:regenerativeBrakeState ;
        sh:in (
            <http://data.europa.eu/949/concepts/active-state/activeState>
            <http://data.europa.eu/949/concepts/active-state/inactiveState>
            <http://data.europa.eu/949/concepts/active-state/undefinedState>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property regenerativeBrakeState must have a value from the defined SKOS concept scheme (activeState, inactiveState, or undefinedState)."@en ;
        sh:message "Die Eigenschaft regenerativeBrakeState muss einen Wert aus dem definierten SKOS-Konzeptschema (activeState, inactiveState oder undefinedState) haben."@de ;
        sh:message "La propriété regenerativeBrakeState doit avoir une valeur du schéma de concept SKOS défini (activeState, dansactiveState ou undefinedState)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Eddy Current Brake State (required, controlled vocabulary - brake system active state)
    sh:property [ 
        sh:path era:eddyCurrentBrakeState ;
        sh:in (
            <http://data.europa.eu/949/concepts/active-state/activeState>
            <http://data.europa.eu/949/concepts/active-state/inactiveState>
            <http://data.europa.eu/949/concepts/active-state/undefinedState>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property eddyCurrentBrakeState must have a value from the defined SKOS concept scheme (activeState, inactiveState, or undefinedState)."@en ;
        sh:message "Die Eigenschaft eddyCurrentBrakeState muss einen Wert aus dem definierten SKOS-Konzeptschema (activeState, inactiveState oder undefinedState) haben."@de ;
        sh:message "La propriété eddyCurrentBrakeState doit avoir une valeur du schéma de concept SKOS défini (activeState, dansactiveState ou undefinedState)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Magnetic Shoe Brake State (required, controlled vocabulary - brake system active state)
    sh:property [ 
        sh:path era:magneticShoeBrakeState ;
        sh:in (
            <http://data.europa.eu/949/concepts/active-state/activeState>
            <http://data.europa.eu/949/concepts/active-state/inactiveState>
            <http://data.europa.eu/949/concepts/active-state/undefinedState>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property magneticShoeBrakeState must have a value from the defined SKOS concept scheme (activeState, inactiveState, or undefinedState)."@en ;
        sh:message "Die Eigenschaft magneticShoeBrakeState muss einen Wert aus dem definierten SKOS-Konzeptschema (activeState, inactiveState oder undefinedState) haben."@de ;
        sh:message "La propriété magneticShoeBrakeState doit avoir une valeur du schéma de concept SKOS défini (activeState, dansactiveState ou undefinedState)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Adhesion Independent Brake State (required, controlled vocabulary - brake system active state)
    sh:property [ 
        sh:path era:adhesionIndependentBrakeState ;
        sh:in (
            <http://data.europa.eu/949/concepts/active-state/activeState>
            <http://data.europa.eu/949/concepts/active-state/inactiveState>
            <http://data.europa.eu/949/concepts/active-state/undefinedState>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property adhesionIndependentBrakeState must have a value from the defined SKOS concept scheme (activeState, inactiveState, or undefinedState)."@en ;
        sh:message "Die Eigenschaft adhesionIndependentBrakeState muss einen Wert aus dem definierten SKOS-Konzeptschema (activeState, inactiveState oder undefinedState) haben."@de ;
        sh:message "La propriété adhesionIndependentBrakeState doit avoir une valeur du schéma de concept SKOS défini (activeState, dansactiveState ou undefinedState)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
# ===== DPS Groups List Shape =====
era:DPSGroupsListShape a sh:NodeShape ;
    sh:targetClass era:DPSGroupsList ;
    sh:message "Container for Drive Protection Section Groups - electrical isolation sections for train power management."@en ;
    sh:message "Container für Antriebsschutzabschnittsgruppen – elektrische Isolationsabschnitte für das Zugstrommanagement."@de ;
    sh:message "Conteneur pour groupes de sections de protection de transmission - sections d'isolation électrique pour la gestion de l'énergie des trains."@fr ;
    
    # DPS Groups (optional, multiple allowed)
    sh:property [ 
        sh:path era:dpsGroups ;
        sh:class era:DriveProtectionSectionGroup ;
		sh:nodeKind sh:IRI ;
        sh:message "A DPSGroupsList may contain multiple dpsGroups that conform to DriveProtectionSectionGroup object."@en ;
        sh:message "Eine DPSGroupsList kann mehrere dpsGroups enthalten, die dem DriveProtectionSectionGroup-Objekt entsprechen."@de ;
        sh:message "Une DPSGroupsList peut contenir plusieurs dpsGroups conformes à l'objet DriveProtectionSectionGroup."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== DPS State Shape =====
era:DPSStateShape a sh:NodeShape ;
    sh:targetClass era:DPSState ;
    sh:message "State of a Drive Protection Section - whether train can draw power from this electrical section."@en ;
    sh:message "Zustand eines Antriebsschutzabschnitts – ob der Zug Strom aus diesem elektrischen Abschnitt beziehen kann."@de ;
    sh:message "État d'une section de protection de l'entraînement - si le train peut tirer de l'énergie de cette section électrique."@fr ;
    
    # DPS (required, reference to the Drive Protection Section)
    sh:property [ 
        sh:path era:dps ;
        sh:class era:DriveProtectionSection ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DPSState must reference exactly one dps (Drive Protection Section) that conforms to DriveProtectionSection object."@en ;
        sh:message "Jeder DPSState muss genau auf einen DPS (Drive Protection Section) verweisen, der dem DriveProtectionSection-Objekt entspricht."@de ;
        sh:message "Chaque DPSState doit faire référence à exactement un dps (Drive Protection Section) conforme à l’objet DriveProtectionSection."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Current Drivability (required, controlled vocabulary - actual power draw capability)
    sh:property [ 
        sh:path era:currentDrivability ;
        sh:in (
            <http://data.europa.eu/949/concepts/dps-drivability/full>
            <http://data.europa.eu/949/concepts/dps-drivability/none>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property currentDrivability must have a value from the defined SKOS concept scheme (full or none)."@en ;
        sh:message "Die Eigenschaft currentDrivability muss einen Wert aus dem definierten SKOS-Konzeptschema haben (vollständig oder keiner)."@de ;
        sh:message "La propriété currentDrivability doit avoir une valeur du schéma de concept SKOS défini (complet ou aucun)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Requested Drivability (required, controlled vocabulary - desired power draw capability)
    sh:property [ 
        sh:path era:requestedDrivability ;
        sh:in (
            <http://data.europa.eu/949/concepts/dps-drivability/full>
            <http://data.europa.eu/949/concepts/dps-drivability/none>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property requestedDrivability must have a value from the defined SKOS concept scheme (full or none)."@en ;
        sh:message "Die Eigenschaft requestedDrivability muss einen Wert aus dem definierten SKOS-Konzeptschema haben (vollständig oder keiner)."@de ;
        sh:message "La propriété requestedDrivability doit avoir une valeur du schéma de concept SKOS défini (complet ou aucun)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Door Activity Shape =====
era:DoorActivityShape a sh:NodeShape ;
    sh:targetClass era:DoorActivity ;
    sh:message "Configuration for automatic train door operation at stations."@en ;
    sh:message "Konfiguration für den automatischen Zugtürbetrieb an Bahnhöfen."@de ;
    sh:message "Configuration pour le fonctionnement automatique des portes des trains dans les gares."@fr ;
    
    # Opening Door Side (required, controlled vocabulary - which side doors open)
    sh:property [ 
        sh:path era:openingDoorSide ;
        sh:in (
            <http://data.europa.eu/949/concepts/door-side/doorSideLeft>
            <http://data.europa.eu/949/concepts/door-side/doorSideRight>
            <http://data.europa.eu/949/concepts/door-side/doorSideBoth>
            <http://data.europa.eu/949/concepts/door-side/doorNoneSide>
            <http://data.europa.eu/949/concepts/door-side/doorSideUnknown>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property openingDoorSide must have a value from the defined SKOS concept scheme (doorSideLeft, doorSideRight, doorSideBoth, doorNoneSide, or doorSideUnknown)."@en ;
        sh:message "Die Eigenschaft openingDoorSide muss einen Wert aus dem definierten SKOS-Konzeptschema (doorSideLeft, doorSideRight, doorSideBoth, doorNoneSide oder doorSideUnknown) haben."@de ;
        sh:message "La propriété openingDoorSide doit avoir une valeur du schéma conceptuel SKOS défini (doorSideLeft, doorSideRight, doorSideBoth, doorNoneSide ou doorSideUnknown)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Centralised Opening (required, boolean - conductor controls all doors)
    sh:property [ 
        sh:path era:centralisedOpening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DoorActivity must have exactly one centralisedOpening (boolean: true=conductor controlled, false=individual door control)."@en ;
        sh:message "Jede DoorActivity muss genau eine centralisedOpening haben (boolean: true=Leitergesteuert, false=einzelne Türsteuerung)."@de ;
        sh:message "Chaque DoorActivity doit avoir exactement un centralisedOpening (booléen : true = contrôlé par un conducteur, false = contrôle de porte individuel)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Automatic Closing (required, boolean - doors close automatically)
    sh:property [ 
        sh:path era:automaticClosing ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DoorActivity must have exactly one automaticClosing (boolean: true=automatic, false=manual close)."@en ;
        sh:message "Jede DoorActivity muss genau eine automaticClosing haben (boolean: true=automatisch, false=manuelles Schließen)."@de ;
        sh:message "Chaque DoorActivity doit avoir exactement un automaticClosing (booléen : true=automatic, false=manual close)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Door Data Shape =====
era:DoorDataShape a sh:NodeShape ;
    sh:targetClass era:DoorData ;
    sh:message "Current state and timing information for train doors."@en ;
    sh:message "Aktuelle Zustands- und Zeitinformationen für Zugtüren."@de ;
    sh:message "Informations sur l'état actuel et le timing des portes des trains."@fr ;
    
    # Door State (required, controlled vocabulary - operational status)
    sh:property [ 
        sh:path era:doorState ;
        sh:in (
            <http://data.europa.eu/949/concepts/door-state/doorStateAvailable>
            <http://data.europa.eu/949/concepts/door-state/doorStateBlocked>
            <http://data.europa.eu/949/concepts/door-state/doorStateUnknown>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property doorState must have a value from the defined SKOS concept scheme (doorStateAvailable, doorStateBlocked, or doorStateUnknown)."@en ;
        sh:message "Die Eigenschaft doorState muss einen Wert aus dem definierten SKOS-Konzeptschema haben (doorStateVerfügbar, doorStateBlockiert oder doorStateUnbekannt)."@de ;
        sh:message "La propriété doorState doit avoir une valeur du schéma de concept SKOS défini (doorStateDisponible, doorStateBloqué ou doorStateInconnu)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Last Passenger Exchange Time (required, unsigned integer - seconds since last door activity)
    sh:property [ 
        sh:path era:lastPassengerExchangeTime ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DoorData must have exactly one lastPassengerExchangeTime (unsigned integer, seconds since last passenger exchange)."@en ;
        sh:message "Jedes DoorData muss genau eine lastPassengerExchangeTime (vorzeichenlose Ganzzahl, Sekunden seit dem letzten Passagieraustausch) haben."@de ;
        sh:message "Chaque DoorData doit avoir exactement un lastPassengerExchangeTime (entier non signé, secondes depuis le dernier échange de passagers)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== DPS Group State Shape =====
era:DpsGroupStateShape a sh:NodeShape ;
    sh:targetClass era:DpsGroupState ;
    sh:message "State of a Drive Protection Section Group at a specific time during train operation."@en ;
    sh:message "Zustand einer Antriebsschutzabschnittsgruppe zu einem bestimmten Zeitpunkt während des Zugbetriebs."@de ;
    sh:message "État d'un groupe de la section de protection de la conduite à un moment précis pendant l'exploitation du train."@fr ;
    
    # DPS Group (required, reference to the group)
    sh:property [ 
        sh:path era:dpsGroup ;
        sh:class era:DriveProtectionSectionGroup ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DpsGroupState must reference exactly one dpsGroup that conforms to DriveProtectionSectionGroup object."@en ;
        sh:message "Jeder DpsGroupState muss auf genau einen dpsGroup verweisen, der dem DriveProtectionSectionGroup-Objekt entspricht."@de ;
        sh:message "Chaque DpsGroupState doit faire référence à exactement un dpsGroup conforme à l'objet DriveProtectionSectionGroup."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # DPSG State (required, controlled vocabulary - group operational state)
    sh:property [ 
        sh:path era:dpsgState ;
        sh:in (
            <http://data.europa.eu/949/concepts/dpsg-state/ready>
            <http://data.europa.eu/949/concepts/dpsg-state/processing>
            <http://data.europa.eu/949/concepts/dpsg-state/disturbed>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property dpsgState must have a value from the defined SKOS concept scheme (ready, processing, or disturbed)."@en ;
        sh:message "Die Eigenschaft dpsgState muss einen Wert aus dem definierten SKOS-Konzeptschema haben (bereit, in Verarbeitung oder gestört)."@de ;
        sh:message "La propriété dpsgState doit avoir une valeur du schéma de concept SKOS défini (prêt, en cours de traitement ou perturbé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime - timestamp of this state)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DpsGroupState must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder DpsGroupState muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque DpsGroupState doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # DPS States (optional, multiple individual section states)
    sh:property [ 
        sh:path era:dpsStates ;
        sh:node era:DPSStateShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A DpsGroupState may contain multiple dpsStates that conform to DPSState object."@en ;
        sh:message "Ein DpsGroupState kann mehrere dpsStates enthalten, die dem DPSState-Objekt entsprechen."@de ;
        sh:message "Un DpsGroupState peut contenir plusieurs dpsStates conformes à l'objet DPSState."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Movement (optional, associated movement plan)
    sh:property [ 
        sh:path era:operationalPlanMovement ;
        sh:class era:OperationalPlanMovement ;
		sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "A DpsGroupState may have at most one operationalPlanMovement that conforms to OperationalPlanMovement object."@en ;
        sh:message "Ein DpsGroupState kann höchstens einen operationalPlanMovement haben, der dem OperationalPlanMovement-Objekt entspricht."@de ;
        sh:message "Un DpsGroupState peut avoir au plus un operationalPlanMovement conforme à l'objet OperationalPlanMovement."@fr ;
        sh:severity sh:Violation ;
    ] .
	

# ===== ETCS Data for ATO Shape =====
era:EtcsDataAtoShape a sh:NodeShape ;
    sh:targetClass era:EtcsDataAto ;
    sh:message "ETCS train data required for Automatic Train Operation (ATO) over ETCS - essential characteristics for automatic driving."@en ;
    sh:message "ETCS-Zugdaten, die für den automatischen Zugbetrieb (ATO) über ETCS erforderlich sind – wesentliche Merkmale für automatisches Fahren."@de ;
    sh:message "Données de train ETCS requises pour l'exploitation automatique des trains (ATO) sur ETCS - caractéristiques essentielles pour la conduite automatique."@fr ;
    
    # Train Length (required, unsigned integer - total length in meters)
    sh:property [ 
        sh:path era:trainLength ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each EtcsDataAto must have exactly one trainLength (unsigned integer, total train length in meters)."@en ;
        sh:message "Jedes EtcsDataAto muss genau eine trainLength (vorzeichenlose Ganzzahl, Gesamtzuglänge in Metern) haben."@de ;
        sh:message "Chaque EtcsDataAto doit avoir exactement un trainLength (entier non signé, longueur totale du train en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Max Speed (required, unsigned integer - maximum permitted speed in km/h)
    sh:property [ 
        sh:path era:maxSpeed ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each EtcsDataAto must have exactly one maxSpeed (unsigned integer, maximum speed in km/h)."@en ;
        sh:message "Jedes EtcsDataAto muss genau eine maxSpeed (vorzeichenlose Ganzzahl, Höchstgeschwindigkeit in km/h) haben."@de ;
        sh:message "Chaque EtcsDataAto doit avoir exactement un maxSpeed (entier non signé, vitesse maximale en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Brake Percentage (required, unsigned integer - braking percentage Lambda)
    sh:property [ 
        sh:path era:brakePercentage ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each EtcsDataAto must have exactly one brakePercentage (unsigned integer, Lambda braking percentage)."@en ;
        sh:message "Jedes EtcsDataAto muss genau eine brakePercentage (vorzeichenlose Ganzzahl, Lambda-Bremsprozentsatz) haben."@de ;
        sh:message "Chaque EtcsDataAto doit avoir exactement un brakePercentage (entier non signé, pourcentage de freinage Lambda)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Brake Position (required, controlled vocabulary - brake lever position/train type)
    sh:property [ 
        sh:path era:brakePosition ;
        sh:in (
            <http://data.europa.eu/949/concepts/brake-position/passengerTrainInP>
            <http://data.europa.eu/949/concepts/brake-position/passengerTrainInR>
            <http://data.europa.eu/949/concepts/brake-position/freightTrainInP>
            <http://data.europa.eu/949/concepts/brake-position/freightTrainInG>
            <http://data.europa.eu/949/concepts/brake-position/brakePositionUnknown>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property brakePosition must have a value from the defined SKOS concept scheme (passengerTrainInP, passengerTrainInR, freightTrainInP, freightTrainInG, or brakePositionUnknown)."@en ;
        sh:message "Die Eigenschaft brakePosition muss einen Wert aus dem definierten SKOS-Konzeptschema haben (passengerTrainInP, passengerTrainInR, freightTrainInP, freightTrainInG oder brakePositionUnbekannt)."@de ;
        sh:message "La propriété brakePosition doit avoir une valeur du schéma de concept SKOS défini (passengerTrainInP, passengerTrainInR, freightTrainInP, freightTrainInG ou brakePositionInconnu)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Axle Load Category (required, controlled vocabulary - maximum axle load)
    sh:property [ 
        sh:path era:axleLoadCategory ;
        sh:in (
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_A>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_HS17>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B1>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4XL>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E5>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property axleLoadCategory must have a value from the defined SKOS concept scheme (AL_A through AL_E5)."@en ;
        sh:message "Die Eigenschaft axleLoadCategory muss einen Wert aus dem definierten SKOS-Konzeptschema (AL_A bis AL_E5) haben."@de ;
        sh:message "La propriété axleLoadCategory doit avoir une valeur du schéma de concept SKOS défini (AL_A à AL_E5)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Cant Deficiency Category (required, controlled vocabulary - superelevation compensation)
    sh:property [ 
        sh:path era:cantDeficiencyCategory ;
        sh:in (
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_Undefined>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_80mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_100mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_130mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_150mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_165mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_180mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_210mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_225mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_245mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_275mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_300mm>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property cantDeficiencyCategory must have a value from the defined SKOS concept scheme (CD_80mm through CD_300mm, or CD_Undefined)."@en ;
        sh:message "Die Eigenschaft cantDeficiencyCategory muss einen Wert aus dem definierten SKOS-Konzeptschema haben (CD_80mm bis CD_300mm oder CD_Undefiniert)."@de ;
        sh:message "La propriété cantDeficiencyCategory doit avoir une valeur du schéma de concept SKOS défini (CD_80mm à CD_300mm, ou CD_Undefined)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Nominal Rotating Mass (required, unsigned integer - equivalent mass including rotation)
    sh:property [ 
        sh:path era:nominalRotatingMass ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each EtcsDataAto must have exactly one nominalRotatingMass (unsigned integer, equivalent rotating mass in tonnes including wheels/axles)."@en ;
        sh:message "Jedes EtcsDataAto muss genau eine nominalRotatingMass (vorzeichenlose Ganzzahl, äquivalente rotierende Masse in Tonnen einschließlich Räder/Achsen) haben."@de ;
        sh:message "Chaque EtcsDataAto doit avoir exactement un nominalRotatingMass (entier non signé, masse rotative équivalente en tonnes, roues/essieux compris)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Other International Category (required, controlled vocabulary - international speed profile category)
    sh:property [ 
        sh:path era:otherInternationalCategory ;
        sh:in (
            <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_freightTrainP>
            <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_freightTrainG>
            <http://data.europa.eu/949/concepts/other-specific-static-speed-profile-category/SSSP_passengerTrain>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property otherInternationalCategory must have a value from the defined SKOS concept scheme (SSSP_freightTrainP, SSSP_freightTrainG, or SSSP_passengerTrain)."@en ;
        sh:message "Die Eigenschaft otherInternationalCategory muss einen Wert aus dem definierten SKOS-Konzeptschema (SSSP_freightTrainP, SSSP_freightTrainG oder SSSP_passengerTrain) haben."@de ;
        sh:message "La propriété otherInternationalCategory doit avoir une valeur du schéma conceptuel SKOS défini (SSSP_freightTrainP, SSSP_freightTrainG ou SSSP_passengerTrain)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Preconfigured Braking Model (required, unsigned integer - braking model identifier)
    sh:property [ 
        sh:path era:preconfiguredBrakingModel ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each EtcsDataAto must have exactly one preconfiguredBrakingModel (unsigned integer, identifier for predefined braking characteristics)."@en ;
        sh:message "Jedes EtcsDataAto muss genau eine preconfiguredBrakingModel (vorzeichenlose Ganzzahl, Kennung für vordefinierte Bremseigenschaften) haben."@de ;
        sh:message "Chaque EtcsDataAto doit avoir exactement un preconfiguredBrakingModel (entier non signé, identifiant des caractéristiques de freinage prédéfinies)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Event Estimation Shape =====
era:EventEstimationShape a sh:NodeShape ;
    sh:targetClass era:EventEstimation ;
    sh:message "Estimated arrival time for a specific movement event (station stop, passing point, etc.)."@en ;
    sh:message "Geschätzte Ankunftszeit für ein bestimmtes Bewegungsereignis (Haltestelle am Bahnhof, Durchgangsstelle usw.)."@de ;
    sh:message "Heure d'arrivée estimée pour un événement de mouvement spécifique (arrêt en gare, point de passage, etc.)."@fr ;
    
    # Event (required, reference to the movement event)
    sh:property [ 
        sh:path era:event ;
        sh:class era:MovementEvent ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each EventEstimation must reference exactly one event that conforms to MovementEvent object."@en ;
        sh:message "Jede EventEstimation muss genau ein Ereignis referenzieren, das dem MovementEvent-Objekt entspricht."@de ;
        sh:message "Chaque EventEstimation doit référencer exactement un événement conforme à l’objet MovementEvent."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Arrival (required, dateTime - estimated arrival timestamp)
    sh:property [ 
        sh:path era:arrival ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each EventEstimation must have exactly one arrival timestamp (xsd:dateTime, estimated time of arrival at event location)."@en ;
        sh:message "Jede EventEstimation muss genau einen Ankunftszeitstempel haben (xsd:dateTime, geschätzte Ankunftszeit am Veranstaltungsort)."@de ;
        sh:message "Chaque EventEstimation doit avoir exactement un horodatage d'arrivée (xsd:dateTime, heure d'arrivée estimée au lieu de l'événement)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Event Execution Report Shape =====
era:EventExecutionReportShape a sh:NodeShape ;
    sh:targetClass era:EventExecutionReport ;
    sh:message "Report documenting the execution of a specific event - must contain exactly one report type. Such report type object needs to be properly constituted."@en ;
    sh:message "Bericht, der die Durchführung eines bestimmten Ereignisses dokumentiert – muss genau einen Berichtstyp enthalten. Ein solches Berichtstypobjekt muss ordnungsgemäß konstituiert sein."@de ;
    sh:message "Rapport documentant l'exécution d'un événement spécifique - doit contenir exactement un type de rapport. Un tel objet de type rapport doit être correctement constitué."@fr ;
    
    # Each Event Execution Report must have exactly ONE of these report types
    sh:xone (
        [ sh:path era:arrivalReport ;
          sh:node era:MovementEventExecutionReportShape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Event execution report contains arrival report."@en ;
          sh:message "Der Ereignisausführungsbericht enthält den Ankunftsbericht."@de ;
          sh:message "Le rapport d'exécution d'événement contient le rapport d'arrivée."@fr ]
        
        [ sh:path era:departureReport ;
          sh:node era:MovementEventExecutionReportShape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Event execution report contains departure report."@en ;
          sh:message "Der Ereignisausführungsbericht enthält einen Abreisebericht."@de ;
          sh:message "Le rapport d'exécution d'événement contient un rapport de départ."@fr ]
        
        [ sh:path era:creationRestrictionReport ;
          sh:node era:RestrictionEventExecutionReportShape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Event execution report contains restriction creation report."@en ;
          sh:message "Der Ereignisausführungsbericht enthält einen Bericht zur Einschränkungserstellung."@de ;
          sh:message "Le rapport d'exécution d'événement contient un rapport de création de restrictions."@fr ]
        
        [ sh:path era:removalRestrictionReport ;
          sh:node era:RestrictionEventExecutionReportShape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Event execution report contains restriction removal report."@en ;
          sh:message "Der Ereignisausführungsbericht enthält einen Bericht zum Entfernen von Einschränkungen."@de ;
          sh:message "Le rapport d'exécution d'événement contient un rapport de suppression des restrictions."@fr ]
        
        [ sh:path era:creationWarningMeasureReport ;
          sh:node era:WarningMeasureEventExecutionReportShape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Event execution report contains warning measure creation report."@en ;
          sh:message "Der Ereignisausführungsbericht enthält einen Bericht zur Erstellung von Warnmaßnahmen."@de ;
          sh:message "Le rapport d'exécution d'événement contient un rapport de création de mesures d'avertissement."@fr ]
        
        [ sh:path era:removalWarningMeasureReport ;
          sh:node era:WarningMeasureEventExecutionReportShape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Event execution report contains warning measure removal report."@en ;
          sh:message "Der Ereignisausführungsbericht enthält einen Bericht zur Entfernung von Warnmaßnahmen."@de ;
          sh:message "Le rapport d'exécution d'événement contient un rapport de suppression des mesures d'avertissement."@fr ]
    ) .


# ===== Event Handling Shape =====
era:EventHandlingShape a sh:NodeShape ;
    sh:targetClass era:EventHandling ;
    sh:message "Records how a specific movement event was handled by the train (passed, stopped accurately, etc.)."@en ;
    sh:message "Zeichnet auf, wie ein bestimmtes Bewegungsereignis vom Zug gehandhabt wurde (genaues Passieren, Anhalten usw.)."@de ;
    sh:message "Enregistre la manière dont un événement de mouvement spécifique a été géré par le train (dépassé, arrêté avec précision, etc.)."@fr ;
    
    # Event (required, reference to the movement event)
    sh:property [ 
        sh:path era:event ;
        sh:class era:MovementEvent ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each EventHandling must reference exactly one event that conforms to MovementEvent object."@en ;
        sh:message "Jedes EventHandling muss auf genau ein Ereignis verweisen, das dem MovementEvent-Objekt entspricht."@de ;
        sh:message "Chaque EventHandling doit faire référence à exactement un événement conforme à l'objet MovementEvent."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Pass Stop Depart (required, controlled vocabulary - action taken at event)
    sh:property [ 
        sh:path era:passStopDepart ;
        sh:in (
            <http://data.europa.eu/949/concepts/movement-event-action/passedEvent>
            <http://data.europa.eu/949/concepts/movement-event-action/stoppedAccurateAtEvent>
            <http://data.europa.eu/949/concepts/movement-event-action/stoppedWithOvershootAtEvent>
            <http://data.europa.eu/949/concepts/movement-event-action/stoppedWithUndershootAtEvent>
            <http://data.europa.eu/949/concepts/movement-event-action/departedFromEvent>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property passStopDepart must have a value from the defined SKOS concept scheme (passedEvent, stoppedAccurateAtEvent, stoppedWithOvershootAtEvent, stoppedWithUndershootAtEvent, or departedFromEvent)."@en ;
        sh:message "Die Eigenschaft passStopDepart muss einen Wert aus dem definierten SKOS-Konzeptschema (passedEvent, stoppedAccurateAtEvent, stoppedWithOvershootAtEvent, stoppedWithUndershootAtEvent oder departedFromEvent) haben."@de ;
        sh:message "La propriété passStopDepart doit avoir une valeur du schéma conceptuel SKOS défini (passedEvent, stoppedAccurateAtEvent, stoppedWithOvershootAtEvent, stoppedWithUndershootAtEvent ou departedFromEvent)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Execution Response Shape =====
era:ExecutionResponseShape a sh:NodeShape ;
    sh:targetClass era:ExecutionResponse ;
    sh:message "Response from train/ATO system regarding acceptance or rejection of an operational plan."@en ;
    sh:message "Antwort des Zug-/ATO-Systems hinsichtlich der Annahme oder Ablehnung eines Einsatzplans."@de ;
    sh:message "Réponse du système train/ATO concernant l’acceptation ou le rejet d’un plan opérationnel."@fr ;
    
    # Operational Plan Reference (required, reference to the plan)
    sh:property [ 
        sh:path era:operationalPlanRef ;
        sh:node era:OperationalPlanReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ExecutionResponse must reference exactly one operationalPlanRef that conforms to OperationalPlanReference object."@en ;
        sh:message "Jede ExecutionResponse muss auf genau ein operationalPlanRef verweisen, das dem OperationalPlanReference-Objekt entspricht."@de ;
        sh:message "Chaque ExecutionResponse doit faire référence à exactement un operationalPlanRef conforme à l'objet OperationalPlanReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Issued At (required, dateTime - when plan was issued)
    sh:property [ 
        sh:path era:operationalPlanIssuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ExecutionResponse must have exactly one operationalPlanIssuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jede ExecutionResponse muss genau einen operationalPlanIssuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque ExecutionResponse doit avoir exactement un horodatage operationalPlanIssuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Response Code (required, controlled vocabulary - accepted or rejected)
    sh:property [ 
        sh:path era:responseCode ;
        sh:in (
            <http://data.europa.eu/949/concepts/response-code/accepted>
            <http://data.europa.eu/949/concepts/response-code/rejected>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property responseCode must have a value from the defined SKOS concept scheme (accepted or rejected)."@en ;
        sh:message "Die Eigenschaft responseCode muss einen Wert aus dem definierten SKOS-Konzeptschema haben (akzeptiert oder abgelehnt)."@de ;
        sh:message "La propriété responseCode doit avoir une valeur du schéma de concept SKOS défini (accepté ou rejeté)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime - when response was generated)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ExecutionResponse must have exactly one issuedAt timestamp (xsd:dateTime, when response was created)."@en ;
        sh:message "Jede ExecutionResponse muss genau einen issuedAt-Zeitstempel haben (xsd:dateTime, wann die Antwort erstellt wurde)."@de ;
        sh:message "Chaque ExecutionResponse doit avoir exactement un horodatage issuedAt (xsd:dateTime, lorsque la réponse a été créée)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Reject Reason (optional, string - explanation if rejected)
    sh:property [ 
        sh:path era:rejectReason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "An ExecutionResponse may have at most one rejectReason (string, required if responseCode is rejected)."@en ;
        sh:message "Eine ExecutionResponse darf höchstens eine rejectReason (Zeichenfolge, erforderlich, wenn responseCode abgelehnt wird) haben."@de ;
        sh:message "Une ExecutionResponse peut avoir au plus un rejectReason (chaîne, obligatoire si responseCode est rejeté)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Movement Event Execution Report Shape =====
era:MovementEventExecutionReportShape a sh:NodeShape ;
    sh:targetClass era:MovementEventExecutionReport ;
    sh:message "Report documenting the execution result of a movement event (arrival/departure at a location)."@en ;
    sh:message "Bericht, der das Ausführungsergebnis eines Bewegungsereignisses (Ankunft/Abfahrt an einem Ort) dokumentiert."@de ;
    sh:message "Rapport documentant le résultat de l'exécution d'un événement de mouvement (arrivée/départ à un endroit)."@fr ;
    
    # Movement Event (required, reference to the event)
    sh:property [ 
        sh:path era:movementEvent ;
        sh:class era:MovementEvent ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MovementEventExecutionReport must reference exactly one movementEvent that conforms to MovementEvent object."@en ;
        sh:message "Jeder MovementEventExecutionReport muss auf genau ein movementEvent verweisen, das dem MovementEvent-Objekt entspricht."@de ;
        sh:message "Chaque MovementEventExecutionReport doit faire référence à exactement un movementEvent conforme à l'objet MovementEvent."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Issued At (required, dateTime - when associated plan was issued)
    sh:property [ 
        sh:path era:operationalPlanIssuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MovementEventExecutionReport must have exactly one operationalPlanIssuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder MovementEventExecutionReport muss genau einen operationalPlanIssuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque MovementEventExecutionReport doit avoir exactement un horodatage operationalPlanIssuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Execution State (required, controlled vocabulary - outcome of event execution)
    sh:property [ 
        sh:path era:executionState ;
        sh:in (
            <http://data.europa.eu/949/concepts/event-execution-state/eventCompleted>
            <http://data.europa.eu/949/concepts/event-execution-state/eventFailed>
            <http://data.europa.eu/949/concepts/event-execution-state/eventWarning>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property executionState must have a value from the defined SKOS concept scheme (eventCompleted, eventFailed, or eventWarning)."@en ;
        sh:message "Die Eigenschaft executionState muss einen Wert aus dem definierten SKOS-Konzeptschema (eventCompleted, eventFailed oder eventWarning) haben."@de ;
        sh:message "La propriété executionState doit avoir une valeur du schéma de concept SKOS défini (eventCompleted, eventFailed ou eventWarning)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime - when report was generated)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MovementEventExecutionReport must have exactly one issuedAt timestamp (xsd:dateTime, when report was created)."@en ;
        sh:message "Jeder MovementEventExecutionReport muss genau einen issuedAt-Zeitstempel haben (xsd:dateTime, als der Bericht erstellt wurde)."@de ;
        sh:message "Chaque MovementEventExecutionReport doit avoir exactement un horodatage issuedAt (xsd:dateTime, lorsque le rapport a été créé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Failure Reason (optional, string - explanation if failed)
    sh:property [ 
        sh:path era:failureReason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A MovementEventExecutionReport may have at most one failureReason (string, required if executionState is eventFailed)."@en ;
        sh:message "Ein MovementEventExecutionReport darf höchstens eine failureReason (Zeichenfolge, erforderlich, wenn executionState eventFailed ist) haben."@de ;
        sh:message "Un MovementEventExecutionReport peut avoir au plus un failureReason (chaîne, obligatoire si executionState est eventFailed)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Warning (optional, string - warning details if warning state)
    sh:property [ 
        sh:path era:warning ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A MovementEventExecutionReport may have at most one warning (string, required if executionState is eventWarning)."@en ;
        sh:message "Ein MovementEventExecutionReport kann höchstens eine Warnung haben (Zeichenfolge, erforderlich, wenn executionState eventWarning ist)."@de ;
        sh:message "Un MovementEventExecutionReport peut avoir au plus un avertissement (chaîne, obligatoire si executionState est eventWarning)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Movement Event Shape =====
era:MovementEventShape a sh:NodeShape ;
    sh:targetClass era:MovementEvent ;
    sh:message "Defines a specific point in the train's journey (station stop, passing point, timing point, etc.)."@en ;
    sh:message "Definiert einen bestimmten Punkt auf der Fahrt des Zuges (Haltestelle, Durchgangspunkt, Zeitpunkt usw.)."@de ;
    sh:message "Définit un point précis du parcours du train (arrêt en gare, point de passage, point de chronométrage, etc.)."@fr ;
    
    # Position (required, reference to network location)
    sh:property [ 
        sh:path era:position ;
        sh:node era:NetPointReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MovementEvent must have exactly one position that conforms to NetPointReference object."@en ;
        sh:message "Jedes MovementEvent muss genau eine Position haben, die dem NetPointReference-Objekt entspricht."@de ;
        sh:message "Chaque MovementEvent doit avoir exactement une position conforme à l'objet NetPointReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Scheduled Type (required, controlled vocabulary - planned event type)
    sh:property [ 
        sh:path era:scheduledType ;
        sh:in (
            <http://data.europa.eu/949/concepts/movement-event-type/pass>
            <http://data.europa.eu/949/concepts/movement-event-type/stop>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property scheduledType must have a value from the defined SKOS concept scheme (pass or stop)."@en ;
        sh:message "Die Eigenschaft scheduledType muss einen Wert aus dem definierten SKOS-Konzeptschema (Pass oder Stop) haben."@de ;
        sh:message "La propriété scheduledType doit avoir une valeur du schéma conceptuel SKOS défini (pass ou stop)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Planned Type (required, controlled vocabulary - working timetable event type)
    sh:property [ 
        sh:path era:plannedType ;
        sh:in (
            <http://data.europa.eu/949/concepts/movement-event-type/pass>
            <http://data.europa.eu/949/concepts/movement-event-type/stop>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property plannedType must have a value from the defined SKOS concept scheme (pass or stop)."@en ;
        sh:message "Die Eigenschaft plannedType muss einen Wert aus dem definierten SKOS-Konzeptschema (Pass oder Stop) haben."@de ;
        sh:message "La propriété plannedType doit avoir une valeur du schéma conceptuel SKOS défini (pass ou stop)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Alignment (required, controlled vocabulary - train reference point)
    sh:property [ 
        sh:path era:alignment ;
        sh:in (
            <http://data.europa.eu/949/concepts/alignment-type/head>
            <http://data.europa.eu/949/concepts/alignment-type/center>
            <http://data.europa.eu/949/concepts/alignment-type/rear>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property alignment must have a value from the defined SKOS concept scheme (head, center, or rear)."@en ;
        sh:message "Die Eigenschaftsausrichtung muss einen Wert aus dem definierten SKOS-Konzeptschema (Kopf, Mitte oder Rückseite) haben."@de ;
        sh:message "L'alignement de la propriété doit avoir une valeur issue du schéma conceptuel SKOS défini (tête, centre ou arrière)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Scheduled Arrival (required, dateTime - public timetable time)
    sh:property [ 
        sh:path era:scheduledArrival ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MovementEvent must have exactly one scheduledArrival timestamp (xsd:dateTime, public timetable time)."@en ;
        sh:message "Jedes MovementEvent muss genau einen scheduledArrival-Zeitstempel haben (xsd:dateTime, öffentliche Fahrplanzeit)."@de ;
        sh:message "Chaque MovementEvent doit avoir exactement un horodatage scheduledArrival (xsd:dateTime, heure de l'horaire public)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Scheduled Arrival Window (required, unsigned integer - tolerance in seconds)
    sh:property [ 
        sh:path era:scheduledArrivalWindow ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MovementEvent must have exactly one scheduledArrivalWindow (unsigned integer, acceptable arrival time deviation in seconds)."@en ;
        sh:message "Jedes MovementEvent muss genau eine scheduledArrivalWindow haben (Ganzzahl ohne Vorzeichen, akzeptable Ankunftszeitabweichung in Sekunden)."@de ;
        sh:message "Chaque MovementEvent doit avoir exactement un scheduledArrivalWindow (entier non signé, écart d'heure d'arrivée acceptable en secondes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Path To Next Event (optional, RDF list of track elements)
    sh:property [ 
        sh:path era:pathToNextEvent ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A MovementEvent may have at most one pathToNextEvent pointing to an RDF list of track elements."@en ;
        sh:message "Ein MovementEvent kann höchstens einen pathToNextEvent haben, der auf eine RDF-Liste von Spurelementen verweist."@de ;
        sh:message "Un MovementEvent peut avoir au plus un pathToNextEvent pointant vers une liste RDF d'éléments de piste."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate path list items are LinearElements
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the pathToNextEvent list must be instances of era:LinearElement."@en ;
        sh:message "Alle Elemente in der Liste pathToNextEvent müssen Instanzen von era:LinearElement sein."@de ;
        sh:message "Tous les éléments de la liste pathToNextEvent doivent être des instances de era:LinearElement."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:pathToNextEvent ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                FILTER NOT EXISTS { ?item a era:LinearElement }
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # Stop Description (optional, details if this is a stop)
    sh:property [ 
        sh:path era:stopDescription ;
        sh:node era:StopDescriptionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A MovementEvent may have at most one stopDescription that conforms to StopDescription object (required if scheduledType or plannedType is stop)."@en ;
        sh:message "Ein MovementEvent kann höchstens ein stopDescription haben, das dem StopDescription-Objekt entspricht (erforderlich, wenn scheduledType oder plannedType Stop ist)."@de ;
        sh:message "Un MovementEvent peut avoir au plus un stopDescription conforme à l'objet StopDescription (obligatoire si scheduledType ou plannedType est stop)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Starts After Events (optional, references to prerequisite events)
    sh:property [ 
        sh:path era:startsAfterEvents ;
        sh:node era:OperationalEventRefShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A MovementEvent may reference multiple startsAfterEvents that must complete before this event starts. This error might be because of referencing improper :OperationalEventRef"@en ;
        sh:message "Ein MovementEvent kann auf mehrere startsAfterEvents verweisen, die abgeschlossen sein müssen, bevor dieses Ereignis beginnt. Dieser Fehler kann auf einen falschen Verweis auf :OperationalEventRef zurückzuführen sein"@de ;
        sh:message "Un MovementEvent peut faire référence à plusieurs startsAfterEvents qui doivent se terminer avant le début de cet événement. Cette erreur peut être due à un référencement incorrect :OperationalEventRef"@fr ;
        sh:severity sh:Violation ;
    ] .


# ===== Movement Permission Shape =====
era:MovementPermissionShape a sh:NodeShape ;
    sh:targetClass era:MovementPermission ;
    sh:message "Defines the permitted movement authority for a train - where it can go, how fast, and in what modes."@en ;
    sh:message "Definiert die zulässige Bewegungsberechtigung für einen Zug – wohin er fahren darf, wie schnell und in welchen Modi."@de ;
    sh:message "Définit l'autorité de mouvement autorisée pour un train : où il peut aller, à quelle vitesse et dans quels modes."@fr ;
    
    # Path Way (required, the main permitted route)
    sh:property [ 
        sh:path era:pathWay ;
        sh:node era:NetLinearReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MovementPermission must have exactly one pathWay (NetLinearReference defining the permitted route). A proper NetLinearReference is needed"@en ;
        sh:message "Jede MovementPermission muss genau eine pathWay haben (NetLinearReference, die die zulässige Route definiert). Es ist eine ordnungsgemäße NetLinearReference erforderlich"@de ;
        sh:message "Chaque MovementPermission doit avoir exactement un pathWay (NetLinearReference définissant l'itinéraire autorisé). Une NetLinearReference appropriée est nécessaire"@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Risk Buffer (required, safety buffer at end of movement authority)
    sh:property [ 
        sh:path era:riskBuffer ;
        sh:node era:NetLinearReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MovementPermission must have exactly one riskBuffer (NetLinearReference defining safety buffer zone). A proper NetLinearReference is needed"@en ;
        sh:message "Jede MovementPermission muss genau eine riskBuffer haben (NetLinearReference, die die Sicherheitspufferzone definiert). Es ist eine ordnungsgemäße NetLinearReference erforderlich"@de ;
        sh:message "Chaque MovementPermission doit avoir exactement un riskBuffer (NetLinearReference définissant la zone tampon de sécurité). Une NetLinearReference appropriée est nécessaire"@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Speeds (required, at least one speed restriction along route)
    sh:property [ 
        sh:path era:speeds ;
        sh:node era:MpSpeedShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each MovementPermission must have at least one speeds profile that conforms to MpSpeed object."@en ;
        sh:message "Jede MovementPermission muss mindestens ein Geschwindigkeitsprofil haben, das dem MpSpeed-Objekt entspricht."@de ;
        sh:message "Chaque MovementPermission doit avoir au moins un profil de vitesses conforme à l’objet MpSpeed."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Movement Modes (required, at least one driving mode section)
    sh:property [ 
        sh:path era:movementModes ;
        sh:node era:MpDrivingModeShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each MovementPermission must have at least one movementModes that conform to MpDrivingMode object."@en ;
        sh:message "Jede MovementPermission muss mindestens eine movementModes haben, die dem MpDrivingMode-Objekt entspricht."@de ;
        sh:message "Chaque MovementPermission doit avoir au moins un movementModes conforme à l'objet MpDrivingMode."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Risk Paths (optional, alternative conflicting routes)
    sh:property [ 
        sh:path era:riskPaths ;
        sh:node era:NetLinearReferenceShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A MovementPermission may have multiple riskPaths (routes that conflict with this permission). A proper NetLinearReference is needed"@en ;
        sh:message "Eine MovementPermission kann mehrere riskPaths haben (Routen, die mit dieser Berechtigung in Konflikt stehen). Es ist eine ordnungsgemäße NetLinearReference erforderlich"@de ;
        sh:message "Une MovementPermission peut avoir plusieurs riskPaths (itinéraires qui entrent en conflit avec cette autorisation). Une NetLinearReference appropriée est nécessaire"@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Movement Restriction Shape =====
era:MovementRestrictionShape a sh:NodeShape ;
    sh:targetClass era:MovementRestriction ;
    sh:message "Defines a restriction on train movement (speed limit, temporary restriction, etc.)."@en ;
    sh:message "Definiert eine Einschränkung der Zugbewegung (Geschwindigkeitsbegrenzung, vorübergehende Einschränkung usw.)."@de ;
    sh:message "Définit une restriction à la circulation des trains (limitation de vitesse, restriction temporaire, etc.)."@fr ;
    
    # Restricted Path (required, where restriction applies)
    sh:property [ 
        sh:path era:restrictedPath ;
        sh:node era:NetLinearReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MovementRestriction must have exactly one restrictedPath (NetLinearReference defining where restriction applies). A proper NetLinearReference is needed"@en ;
        sh:message "Jede MovementRestriction muss genau eine restrictedPath haben (NetLinearReference, die definiert, wo die Einschränkung gilt). Es ist eine ordnungsgemäße NetLinearReference erforderlich"@de ;
        sh:message "Chaque MovementRestriction doit avoir exactement un restrictedPath (NetLinearReference définissant où la restriction s'applique). Une NetLinearReference appropriée est nécessaire"@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Specific Restriction (required, details of the restriction)
    sh:property [ 
        sh:path era:specificRestriction ;
        sh:node era:SpecificMovementRestrictionShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MovementRestriction must have exactly one specificRestriction that conforms to SpecificMovementRestriction object."@en ;
        sh:message "Jede MovementRestriction muss genau ein specificRestriction haben, das dem SpecificMovementRestriction-Objekt entspricht."@de ;
        sh:message "Chaque MovementRestriction doit avoir exactement un specificRestriction conforme à l'objet SpecificMovementRestriction."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== MP Driving Mode Shape =====
era:MpDrivingModeShape a sh:NodeShape ;
    sh:targetClass era:MpDrivingMode ;
    sh:message "Defines the required ETCS driving mode for a specific section of the movement permission."@en ;
    sh:message "Definiert den erforderlichen ETCS-Fahrmodus für einen bestimmten Abschnitt der Bewegungsgenehmigung."@de ;
    sh:message "Définit le mode de conduite ETCS requis pour une section spécifique de l'autorisation de mouvement."@fr ;
    
    # Path (required, where this mode applies)
    sh:property [ 
        sh:path era:path ;
        sh:node era:NetLinearReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MpDrivingMode must have exactly one path (NetLinearReference defining where this driving mode applies). A proper NetLinearReference is needed."@en ;
        sh:message "Jeder MpDrivingMode muss genau einen Pfad haben (NetLinearReference definiert, wo dieser Fahrmodus gilt). Es ist eine ordnungsgemäße NetLinearReference erforderlich."@de ;
        sh:message "Chaque MpDrivingMode doit avoir exactement un chemin (NetLinearReference définissant où ce mode de conduite s'applique). Une NetLinearReference appropriée est nécessaire."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Driving Mode (required, controlled vocabulary - ETCS mode)
    sh:property [ 
        sh:path era:drivingMode ;
        sh:in (
            <http://data.europa.eu/949/concepts/onboard-operating-mode/undefined>
            <http://data.europa.eu/949/concepts/onboard-operating-mode/onSight>
            <http://data.europa.eu/949/concepts/onboard-operating-mode/fullSupervision>
            <http://data.europa.eu/949/concepts/onboard-operating-mode/standBy>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property drivingMode must have a value from the defined SKOS concept scheme (fullSupervision, onSight, standBy, or undefined)."@en ;
        sh:message "Die Eigenschaft drivingMode muss einen Wert aus dem definierten SKOS-Konzeptschema haben (fullSupervision, onSight, standBy oder undefiniert)."@de ;
        sh:message "La propriété drivingMode doit avoir une valeur du schéma de concept SKOS défini (fullSupervision, onSight, standBy ou non défini)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== MP Speed Shape =====
era:MpSpeedShape a sh:NodeShape ;
    sh:targetClass era:MpSpeed ;
    sh:message "Defines the maximum permitted speed for a specific section of the movement permission."@en ;
    sh:message "Definiert die maximal zulässige Geschwindigkeit für einen bestimmten Abschnitt der Bewegungserlaubnis."@de ;
    sh:message "Définit la vitesse maximale autorisée pour une section spécifique de l'autorisation de mouvement."@fr ;
    
    # Path (required, where this speed limit applies)
    sh:property [ 
        sh:path era:path ;
        sh:node era:NetLinearReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MpSpeed must have exactly one path (NetLinearReference defining where this speed limit applies). A proper NetLinearReference is needed."@en ;
        sh:message "Jeder MpSpeed ​​muss genau einen Pfad haben (NetLinearReference definiert, wo diese Geschwindigkeitsbegrenzung gilt). Es ist eine ordnungsgemäße NetLinearReference erforderlich."@de ;
        sh:message "Chaque MpSpeed ​​doit avoir exactement un chemin (NetLinearReference définissant où cette limite de vitesse s'applique). Une NetLinearReference appropriée est nécessaire."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # V Max (required, unsigned integer - maximum speed in km/h)
    sh:property [ 
        sh:path era:vMax ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each MpSpeed must have exactly one vMax (unsigned integer, maximum permitted speed in km/h)."@en ;
        sh:message "Jeder MpSpeed ​​muss genau eine vMax (vorzeichenlose Ganzzahl, maximal zulässige Geschwindigkeit in km/h) haben."@de ;
        sh:message "Chaque MpSpeed ​​doit avoir exactement un vMax (entier non signé, vitesse maximale autorisée en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== OnBoard Extension Shape =====
era:OnBoardExtensionShape a sh:NodeShape ;
    sh:targetClass era:OnBoardExtension ;
    sh:message "Extension data for vendor-specific or non-standard onboard systems."@en ;
    sh:message "Erweiterungsdaten für herstellerspezifische oder nicht standardmäßige Bordsysteme."@de ;
    sh:message "Données d'extension pour les systèmes embarqués spécifiques au fournisseur ou non standard."@fr ;
    
    # Content Type (required, string - MIME type or identifier)
    sh:property [ 
        sh:path era:contentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OnBoardExtension must have exactly one contentType (string, identifies the extension data format)."@en ;
        sh:message "Jede OnBoardExtension muss genau eine contentType (Zeichenfolge, identifiziert das Erweiterungsdatenformat) haben."@de ;
        sh:message "Chaque OnBoardExtension doit avoir exactement un contentType (chaîne, identifie le format des données d'extension)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Content (required, base64Binary - the extension data)
    sh:property [ 
        sh:path era:content ;
        sh:datatype xsd:base64Binary ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OnBoardExtension must have exactly one content (base64Binary, encoded extension data)."@en ;
        sh:message "Jede OnBoardExtension muss genau einen Inhalt haben (base64Binary, codierte Erweiterungsdaten)."@de ;
        sh:message "Chaque OnBoardExtension doit avoir exactement un contenu (base64Binary, données d'extension codées)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Operational Consist Shape =====
era:OperationalConsistShape a sh:NodeShape ;
    sh:targetClass era:OperationalConsist ;
    sh:message "Describes the operational train consist configuration and its supported equipment."@en ;
    sh:message "Beschreibt die betriebsbereite Zugverbandkonfiguration und die unterstützte Ausrüstung."@de ;
    sh:message "Décrit la configuration opérationnelle du groupe de train et les équipements pris en charge."@fr ;
    
    # Supported OnBoard Equipment (required, equipment capabilities)
    sh:property [ 
        sh:path era:supportedOnBoardEquipment ;
        sh:node era:SupportedOnBoardEquipmentShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OperationalConsist must have exactly one supportedOnBoardEquipment that conforms to SupportedOnBoardEquipment object."@en ;
        sh:message "Jeder OperationalConsist muss genau ein supportedOnBoardEquipment haben, das dem SupportedOnBoardEquipment-Objekt entspricht."@de ;
        sh:message "Chaque OperationalConsist doit avoir exactement un supportedOnBoardEquipment conforme à l'objet SupportedOnBoardEquipment."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Operational Event Reference Shape =====
era:OperationalEventRefShape a sh:NodeShape ;
    sh:targetClass era:OperationalEventRef ;
    sh:message "Reference to an operational event - must be exactly one 'proper' instance of event type (movement, restriction, or warning)."@en ;
    sh:message "Verweis auf ein betriebliches Ereignis – muss genau eine „richtige“ Instanz des Ereignistyps (Bewegung, Einschränkung oder Warnung) sein."@de ;
    sh:message "Référence à un événement opérationnel : doit être exactement une instance « appropriée » du type d'événement (mouvement, restriction ou avertissement)."@fr ;
    
    # Each Operational Event Reference must have exactly ONE of these event types
    sh:xone (
        [ sh:path era:movementEvent ;
          sh:class era:MovementEvent ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Operational event reference is a movement event."@en ;
          sh:message "Bei der operativen Ereignisreferenz handelt es sich um ein Bewegungsereignis."@de ;
          sh:message "La référence d'événement opérationnel est un événement de mouvement."@fr ]
        
        [ sh:path era:restrictionEvent ;
          sh:class era:RestrictionEvent ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Operational event reference is a restriction event."@en ;
          sh:message "Der Verweis auf ein Betriebsereignis ist ein Einschränkungsereignis."@de ;
          sh:message "La référence à un événement opérationnel est un événement de restriction."@fr ]
        
        [ sh:path era:warningMeasureEvent ;
          sh:class era:WarningMeasureEvent ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Operational event reference is a warning measure event."@en ;
          sh:message "Bei der Betriebsereignisreferenz handelt es sich um ein Warnmaßnahmeereignis."@de ;
          sh:message "La référence d'événement opérationnel est un événement de mesure d'avertissement."@fr ]
    ) .

# ===== Operational Plan Movement Shape =====
era:OperationalPlanMovementShape a sh:NodeShape ;
    sh:targetClass era:OperationalPlanMovement ;
    sh:message "Operational plan defining train movement including route, events, restrictions, and consist."@en ;
    sh:message "Betriebsplan, der den Zugverkehr einschließlich Route, Ereignissen, Einschränkungen und Zusammensetzung definiert."@de ;
    sh:message "Plan opérationnel définissant le mouvement des trains, y compris l'itinéraire, les événements, les restrictions et la composition."@fr ;
    
    # Configuration Data Version Reference (required, string - version identifier)
    sh:property [ 
        sh:path era:configurationDataVersionRef ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OperationalPlanMovement must have exactly one configurationDataVersionRef (string, identifies infrastructure data version)."@en ;
        sh:message "Jede OperationalPlanMovement muss genau eine configurationDataVersionRef (Zeichenfolge, identifiziert die Infrastrukturdatenversion) haben."@de ;
        sh:message "Chaque OperationalPlanMovement doit avoir exactement un configurationDataVersionRef (chaîne, identifie la version des données d'infrastructure)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime - when plan was created)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OperationalPlanMovement must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jede OperationalPlanMovement muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque OperationalPlanMovement doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Includes End of Journey (required, boolean - whether plan includes final destination)
    sh:property [ 
        sh:path era:includesEndOfJourney ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OperationalPlanMovement must have exactly one includesEndOfJourney (boolean, true if plan includes journey end)."@en ;
        sh:message "Jede OperationalPlanMovement muss genau eine includesEndOfJourney haben (boolean, true, wenn der Plan das Ende der Reise enthält)."@de ;
        sh:message "Chaque OperationalPlanMovement doit avoir exactement un includesEndOfJourney (booléen, vrai si le plan inclut la fin du voyage)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Movement Events (required, RDF list of at least 1 event)
    sh:property [ 
        sh:path era:movementEvents ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OperationalPlanMovement must have exactly one movementEvents property pointing to an RDF list with at least 1 event."@en ;
        sh:message "Jede OperationalPlanMovement muss genau eine movementEvents-Eigenschaft haben, die auf eine RDF-Liste mit mindestens einem Ereignis verweist."@de ;
        sh:message "Chaque OperationalPlanMovement doit avoir exactement une propriété movementEvents pointant vers une liste RDF avec au moins 1 événement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate list has at least 1 item
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "The movementEvents list must contain at least 1 MovementEvent item."@en ;
        sh:message "Die movementEvents-Liste muss mindestens 1 MovementEvent-Element enthalten."@de ;
        sh:message "La liste movementEvents doit contenir au moins un élément MovementEvent."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:movementEvents ?list .
                
                # Check if list is empty or has no items
                FILTER NOT EXISTS {
                    ?list rdf:rest*/rdf:first ?item .
                    ?item a era:MovementEvent .
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Train Units (required, at least one train unit)
    sh:property [ 
        sh:path era:operationalTrainUnits ;
        sh:node era:TrainUnitShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each OperationalPlanMovement must have at least one operationalTrainUnits that conform to TrainUnit object."@en ;
        sh:message "Jedes OperationalPlanMovement muss mindestens ein operationalTrainUnits haben, das dem TrainUnit-Objekt entspricht."@de ;
        sh:message "Chaque OperationalPlanMovement doit avoir au moins un operationalTrainUnits conforme à l'objet TrainUnit."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Movement Restrictions (optional, multiple restrictions allowed)
    sh:property [ 
        sh:path era:movementRestrictions ;
        sh:node era:MovementRestrictionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "An OperationalPlanMovement may have multiple movementRestrictions that conform to MovementRestriction object."@en ;
        sh:message "Ein OperationalPlanMovement kann mehrere movementRestrictions haben, die dem MovementRestriction-Objekt entsprechen."@de ;
        sh:message "Un OperationalPlanMovement peut avoir plusieurs movementRestrictions conformes à l'objet MovementRestriction."@fr ;
        sh:severity sh:Violation ;
    ] .


# ===== Operational Plan Reference Shape =====
era:OperationalPlanReferenceShape a sh:NodeShape ;
    sh:targetClass era:OperationalPlanReference ;
    sh:message "Reference to an operational plan - must be exactly one plan type (movement, restriction, or warning measure)."@en ;
    sh:message "Verweis auf einen Einsatzplan – muss genau eine Planart (Bewegung, Einschränkung oder Warnmaßnahme) sein."@de ;
    sh:message "Référence à un plan opérationnel - doit être exactement un type de plan (mouvement, restriction ou mesure d'avertissement)."@fr ;
    
    # Each Operational Plan Reference must have exactly ONE of these plan types
    sh:xone (
        [ sh:path era:operationalPlanMovementRef ;
          sh:class era:OperationalPlanMovement ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Operational plan reference is a movement plan."@en ;
          sh:message "Die operative Planreferenz ist ein Bewegungsplan."@de ;
          sh:message "La référence du plan opérationnel est un plan de mouvement."@fr ]
        
        [ sh:path era:operationalPlanRestrictionRef ;
          sh:class era:OperationalPlanRestriction ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Operational plan reference is a restriction plan."@en ;
          sh:message "Die Betriebsplanreferenz ist ein Restriktionsplan."@de ;
          sh:message "La référence du plan opérationnel est un plan de restriction."@fr ]
        
        [ sh:path era:operationalPlanWarningMeasureRef ;
          sh:class era:OperationalPlanWarningMeasure ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Operational plan reference is a warning measure plan."@en ;
          sh:message "Bei der Betriebsplanreferenz handelt es sich um einen Warnmaßnahmenplan."@de ;
          sh:message "La référence du plan opérationnel est un plan de mesures d’alerte."@fr ]
    ) .

# ===== Operational Plan Restriction Shape =====
era:OperationalPlanRestrictionShape a sh:NodeShape ;
    sh:targetClass era:OperationalPlanRestriction ;
    sh:message "Operational plan defining restrictions on train movement (TSRs, work zones, etc.)."@en ;
    sh:message "Betriebsplan, der Beschränkungen für den Zugverkehr festlegt (TSRs, Arbeitsbereiche usw.)."@de ;
    sh:message "Plan opérationnel définissant les restrictions de circulation des trains (TSR, zones de travaux, etc.)."@fr ;
    
    # Configuration Data Version Reference (required, string - infrastructure version)
    sh:property [ 
        sh:path era:configurationDataVersionRef ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OperationalPlanRestriction must have exactly one configurationDataVersionRef (string, identifies infrastructure data version)."@en ;
        sh:message "Jede OperationalPlanRestriction muss genau eine configurationDataVersionRef (Zeichenfolge, identifiziert die Infrastrukturdatenversion) haben."@de ;
        sh:message "Chaque OperationalPlanRestriction doit avoir exactement un configurationDataVersionRef (chaîne, identifie la version des données d'infrastructure)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime - when plan was created)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OperationalPlanRestriction must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jede OperationalPlanRestriction muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque OperationalPlanRestriction doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Restriction Events (required, at least one restriction event)
    sh:property [ 
        sh:path era:restrictionEvents ;
        sh:node era:RestrictionEventShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each OperationalPlanRestriction must have at least one restrictionEvents that conform to RestrictionEvent object."@en ;
        sh:message "Jede OperationalPlanRestriction muss mindestens ein restrictionEvents haben, das dem RestrictionEvent-Objekt entspricht."@de ;
        sh:message "Chaque OperationalPlanRestriction doit avoir au moins un restrictionEvents conforme à l'objet RestrictionEvent."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Operational Plan Warning Measure Shape =====
era:OperationalPlanWarningMeasureShape a sh:NodeShape ;
    sh:targetClass era:OperationalPlanWarningMeasure ;
    sh:message "Operational plan defining warning measures for train operation (adhesion warnings, track conditions, etc.)."@en ;
    sh:message "Betriebsplan zur Festlegung von Warnmaßnahmen für den Zugbetrieb (Haftungswarnungen, Gleiszustand etc.)."@de ;
    sh:message "Plan opérationnel définissant les mesures d'alerte pour l'exploitation des trains (avertissements d'adhérence, état des voies, etc.)."@fr ;
    
    # Configuration Data Version Reference (required, string - infrastructure version)
    sh:property [ 
        sh:path era:configurationDataVersionRef ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OperationalPlanWarningMeasure must have exactly one configurationDataVersionRef (string, identifies infrastructure data version)."@en ;
        sh:message "Jede OperationalPlanWarningMeasure muss genau eine configurationDataVersionRef (Zeichenfolge, identifiziert die Infrastrukturdatenversion) haben."@de ;
        sh:message "Chaque OperationalPlanWarningMeasure doit avoir exactement un configurationDataVersionRef (chaîne, identifie la version des données d'infrastructure)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime - when plan was created)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each OperationalPlanWarningMeasure must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jede OperationalPlanWarningMeasure muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque OperationalPlanWarningMeasure doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Warning Measure Events (required, at least one warning event)
    sh:property [ 
        sh:path era:warningMeasureEvents ;
        sh:node era:WarningMeasureEventShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each OperationalPlanWarningMeasure must have at least one warningMeasureEvents that conform to WarningMeasureEvent object."@en ;
        sh:message "Jedes OperationalPlanWarningMeasure muss mindestens ein warningMeasureEvents haben, das dem WarningMeasureEvent-Objekt entspricht."@de ;
        sh:message "Chaque OperationalPlanWarningMeasure doit avoir au moins un warningMeasureEvents conforme à l'objet WarningMeasureEvent."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Operational Traffic Plan Shape =====
era:OperationalTrafficPlanShape a sh:NodeShape ;
    sh:targetClass era:OperationalTrafficPlan ;
    sh:message "Complete operational traffic plan containing all movements, restrictions, and warnings for a time period or area."@en ;
    sh:message "Vollständiger betrieblicher Verkehrsplan, der alle Bewegungen, Einschränkungen und Warnungen für einen Zeitraum oder ein Gebiet enthält."@de ;
    sh:message "Plan de circulation opérationnel complet contenant tous les mouvements, restrictions et avertissements pour une période ou une zone."@fr ;
    
    # Operational Plan Movements (optional, multiple movement plans)
    sh:property [ 
        sh:path era:operationalPlanMovements ;
        sh:node era:OperationalPlanMovementShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "An OperationalTrafficPlan may contain multiple operationalPlanMovements that conform to OperationalPlanMovement object."@en ;
        sh:message "Ein OperationalTrafficPlan kann mehrere operationalPlanMovements enthalten, die dem OperationalPlanMovement-Objekt entsprechen."@de ;
        sh:message "Un OperationalTrafficPlan peut contenir plusieurs operationalPlanMovements conformes à l'objet OperationalPlanMovement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Restrictions (optional, multiple restriction plans)
    sh:property [ 
        sh:path era:operationalPlanRestrictions ;
        sh:node era:OperationalPlanRestrictionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "An OperationalTrafficPlan may contain multiple operationalPlanRestrictions that conform to OperationalPlanRestriction object."@en ;
        sh:message "Ein OperationalTrafficPlan kann mehrere operationalPlanRestrictions enthalten, die dem OperationalPlanRestriction-Objekt entsprechen."@de ;
        sh:message "Un OperationalTrafficPlan peut contenir plusieurs operationalPlanRestrictions conformes à l'objet OperationalPlanRestriction."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Warning Measures (optional, multiple warning plans)
    sh:property [ 
        sh:path era:operationalPlanWarningMeasures ;
        sh:node era:OperationalPlanWarningMeasureShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "An OperationalTrafficPlan may contain multiple operationalPlanWarningMeasures that conform to OperationalPlanWarningMeasure object."@en ;
        sh:message "Ein OperationalTrafficPlan kann mehrere operationalPlanWarningMeasures enthalten, die dem OperationalPlanWarningMeasure-Objekt entsprechen."@de ;
        sh:message "Un OperationalTrafficPlan peut contenir plusieurs operationalPlanWarningMeasures conformes à l'objet OperationalPlanWarningMeasure."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Operational Train Category Shape =====
era:OperationalTrainCategoryShape a sh:NodeShape ;
    sh:targetClass era:OperationalTrainCategory ;
    sh:message "Categorization of train by type and usage for operational and commercial purposes."@en ;
    sh:message "Kategorisierung von Zügen nach Typ und Nutzung für betriebliche und kommerzielle Zwecke."@de ;
    sh:message "Catégorisation des trains par type et utilisation à des fins opérationnelles et commerciales."@fr ;
    
    # Train Category Type (required, controlled vocabulary - train service type)
    sh:property [ 
        sh:path era:trainCategoryType ;
        sh:in (
            <http://data.europa.eu/949/concepts/train-category-type/trainCategoryUnknown>
            <http://data.europa.eu/949/concepts/train-category-type/highspeedTrain>
            <http://data.europa.eu/949/concepts/train-category-type/intercity>
            <http://data.europa.eu/949/concepts/train-category-type/interregional>
            <http://data.europa.eu/949/concepts/train-category-type/regional>
            <http://data.europa.eu/949/concepts/train-category-type/subUrban>
            <http://data.europa.eu/949/concepts/train-category-type/nightTrain>
            <http://data.europa.eu/949/concepts/train-category-type/motorRail>
            <http://data.europa.eu/949/concepts/train-category-type/mountainTrain>
            <http://data.europa.eu/949/concepts/train-category-type/historicTrain>
            <http://data.europa.eu/949/concepts/train-category-type/coachGroup>
            <http://data.europa.eu/949/concepts/train-category-type/tram>
            <http://data.europa.eu/949/concepts/train-category-type/underground>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property trainCategoryType must have a value from the defined SKOS concept scheme (highspeedTrain, intercity, regional, subUrban, nightTrain, etc.)."@en ;
        sh:message "Die Eigenschaft trainCategoryType muss einen Wert aus dem definierten SKOS-Konzeptschema haben (highspeedTrain, Intercity, Regional, subUrban, nightTrain usw.)."@de ;
        sh:message "La propriété trainCategoryType doit avoir une valeur issue du schéma conceptuel SKOS défini (highspeedTrain, interurbain, régional, subUrban, nightTrain, etc.)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Usage (required, controlled vocabulary - operational purpose)
    sh:property [ 
        sh:path era:trainUsage ;
        sh:in (
            <http://data.europa.eu/949/concepts/train-usage-type/trainUsageUndefined>
            <http://data.europa.eu/949/concepts/train-usage-type/commercialPassengerTrain>
            <http://data.europa.eu/949/concepts/train-usage-type/commercialCargoTrain>
            <http://data.europa.eu/949/concepts/train-usage-type/locomotiveRunningLight>
            <http://data.europa.eu/949/concepts/train-usage-type/lightRunning>
            <http://data.europa.eu/949/concepts/train-usage-type/notInService>
            <http://data.europa.eu/949/concepts/train-usage-type/engineeringTrain>
            <http://data.europa.eu/949/concepts/train-usage-type/breakdownTrain>
            <http://data.europa.eu/949/concepts/train-usage-type/mixedTrain>
            <http://data.europa.eu/949/concepts/train-usage-type/specialTrain>
            <http://data.europa.eu/949/concepts/train-usage-type/otherTrain>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property trainUsage must have a value from the defined SKOS concept scheme (commercialPassengerTrain, commercialCargoTrain, engineeringTrain, etc.)."@en ;
        sh:message "Die Eigenschaft trainUsage muss einen Wert aus dem definierten SKOS-Konzeptschema (commercialPassengerTrain, commercialCargoTrain, engineeringTrain usw.) haben."@de ;
        sh:message "La propriété trainUsage doit avoir une valeur du schéma conceptuel SKOS défini (commercialPassengerTrain, commercialCargoTrain, engineeringTrain, etc.)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Description (optional, string - human-readable description)
    sh:property [ 
        sh:path era:description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "An OperationalTrainCategory may have at most one description (string, human-readable category description)."@en ;
        sh:message "Eine OperationalTrainCategory darf höchstens eine Beschreibung haben (Zeichenfolge, für Menschen lesbare Kategoriebeschreibung)."@de ;
        sh:message "Un OperationalTrainCategory peut avoir au plus une description (chaîne, description de catégorie lisible par l'homme)."@fr ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Physical Consist Shape =====
era:PhysicalConsistShape a sh:NodeShape ;
    sh:targetClass era:PhysicalConsist ;
    sh:message "Describes the actual physical train composition including all vehicles and their current state."@en ;
    sh:message "Beschreibt die tatsächliche physische Zugzusammensetzung einschließlich aller Fahrzeuge und deren aktuellen Zustand."@de ;
    sh:message "Décrit la composition physique réelle du train, y compris tous les véhicules et leur état actuel."@fr ;
    
    # EVN Identifier (required, string - European Vehicle Number)
    sh:property [ 
        sh:path era:evnIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PhysicalConsist must have exactly one evnIdentifier (string, European Vehicle Number identifying the train consist)."@en ;
        sh:message "Jeder PhysicalConsist muss genau eine evnIdentifier haben (Zeichenfolge, europäische Fahrzeugnummer, die den Zugverband identifiziert)."@de ;
        sh:message "Chaque PhysicalConsist doit avoir exactement un evnIdentifier (chaîne, numéro de véhicule européen identifiant la composition du train)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Mass (required, unsigned integer - total train mass in tonnes)
    sh:property [ 
        sh:path era:mass ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PhysicalConsist must have exactly one mass (unsigned integer, total train mass in tonnes)."@en ;
        sh:message "Jeder PhysicalConsist muss genau eine Masse haben (ganzzahlige Zahl ohne Vorzeichen, Gesamtmasse des Zuges in Tonnen)."@de ;
        sh:message "Chaque PhysicalConsist doit avoir exactement une masse (entier non signé, masse totale du train en tonnes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Passenger Load (required, unsigned integer - total passenger count)
    sh:property [ 
        sh:path era:passengerLoad ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PhysicalConsist must have exactly one passengerLoad (unsigned integer, total number of passengers on board)."@en ;
        sh:message "Jeder PhysicalConsist muss genau eine passengerLoad (vorzeichenlose Ganzzahl, Gesamtzahl der Passagiere an Bord) haben."@de ;
        sh:message "Chaque PhysicalConsist doit avoir exactement un passengerLoad (entier non signé, nombre total de passagers à bord)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Max Current Consumption (required, unsigned integer 0-1023 - in amperes)
    sh:property [ 
        sh:path era:maxCurrentConsuption ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1023 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PhysicalConsist must have exactly one maxCurrentConsuption (unsigned integer 0-1023, maximum electrical current draw in amperes)."@en ;
        sh:message "Jeder PhysicalConsist muss genau eine maxCurrentConsuption haben (vorzeichenlose Ganzzahl 0-1023, maximale elektrische Stromaufnahme in Ampere)."@de ;
        sh:message "Chaque PhysicalConsist doit avoir exactement un maxCurrentConsuption (entier non signé 0-1023, consommation de courant électrique maximale en ampères)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Physical Vehicles (optional, RDF list of vehicles - max 255 per ETCS spec)
    sh:property [ 
        sh:path era:physicalVehicles ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A PhysicalConsist may have at most one physicalVehicles property pointing to an RDF list (max 255 vehicles)."@en ;
        sh:message "Ein PhysicalConsist darf höchstens eine physicalVehicles-Eigenschaft haben, die auf eine RDF-Liste verweist (maximal 255 Fahrzeuge)."@de ;
        sh:message "Un PhysicalConsist peut avoir au plus une propriété physicalVehicles pointant vers une liste RDF (max 255 véhicules)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate list has max 255 vehicles
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "The physicalVehicles list must contain at most 255 vehicles (ETCS specification limit)."@en ;
        sh:message "Die physicalVehicles-Liste darf höchstens 255 Fahrzeuge enthalten (ETCS-Spezifikationslimit)."@de ;
        sh:message "La liste physicalVehicles doit contenir au maximum 255 véhicules (limite de la spécification ETCS)."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:physicalVehicles ?list .
                {
                    SELECT $this (COUNT(?item) AS ?count)
                    WHERE {
                        $this era:physicalVehicles ?list .
                        ?list rdf:rest*/rdf:first ?item .
                    }
                    GROUP BY $this
                    HAVING (?count > 255)
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all vehicles are PhysicalVehicle instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the physicalVehicles list must be instances of era:PhysicalVehicle that conform to PhysicalVehicleShape."@en ;
        sh:message "Alle Elemente in der Liste physicalVehicles müssen Instanzen von era:PhysicalVehicle sein, die PhysicalVehicleShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste physicalVehicles doivent être des instances de era:PhysicalVehicle conformes à PhysicalVehicleShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:physicalVehicles ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                FILTER NOT EXISTS { ?item a era:PhysicalVehicle }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .

# ===== Physical Train Unit Identifier Shape =====
era:PhysicalTrainUnitIdentifierShape a sh:NodeShape ;
    sh:targetClass era:PhysicalTrainUnitIdentifier ;
    sh:message "Collection of identifiers used to uniquely identify a physical train unit in various systems."@en ;
    sh:message "Sammlung von Identifikatoren zur eindeutigen Identifizierung einer physischen Zugeinheit in verschiedenen Systemen."@de ;
    sh:message "Collection d'identifiants utilisés pour identifier de manière unique une unité de train physique dans divers systèmes."@fr ;
    
    # Train Running Number (optional, string - operational train number)
    sh:property [ 
        sh:path era:trainRunningNumber ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A PhysicalTrainUnitIdentifier may have at most one trainRunningNumber (string, operational train service number)."@en ;
        sh:message "Ein PhysicalTrainUnitIdentifier darf höchstens eine trainRunningNumber (Zeichenfolge, Betriebszugdienstnummer) haben."@de ;
        sh:message "Un PhysicalTrainUnitIdentifier peut avoir au plus un trainRunningNumber (chaîne, numéro de service de train opérationnel)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Additional Train Running Number (optional, string - supplementary identifier)
    sh:property [ 
        sh:path era:additionalTrainRunningNumber ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A PhysicalTrainUnitIdentifier may have at most one additionalTrainRunningNumber (string, supplementary operational number)."@en ;
        sh:message "Ein PhysicalTrainUnitIdentifier darf höchstens eine additionalTrainRunningNumber (Zeichenfolge, zusätzliche Betriebsnummer) haben."@de ;
        sh:message "Un PhysicalTrainUnitIdentifier peut avoir au plus un additionalTrainRunningNumber (chaîne, numéro opérationnel supplémentaire)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # TAF TAP TSI Train ID (optional, string - standard European train ID)
    sh:property [ 
        sh:path era:tafTapTsiTrainID ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A PhysicalTrainUnitIdentifier may have at most one tafTapTsiTrainID (string, TAF/TAP TSI standard train identifier)."@en ;
        sh:message "Ein PhysicalTrainUnitIdentifier darf höchstens eine tafTapTsiTrainID (Zeichenfolge, TAF/TAP TSI-Standardzugkennung) haben."@de ;
        sh:message "Un PhysicalTrainUnitIdentifier peut avoir au plus un tafTapTsiTrainID (chaîne, identifiant de train standard TAF/TAP TSI)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Leading OnBoard Unit ID (optional, string - primary onboard computer ID)
    sh:property [ 
        sh:path era:leadingOnBoardUnitId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A PhysicalTrainUnitIdentifier may have at most one leadingOnBoardUnitId (string, identifier of leading onboard unit)."@en ;
        sh:message "Ein PhysicalTrainUnitIdentifier darf höchstens einen leadingOnBoardUnitId (String, Kennung der führenden Onboard-Einheit) haben."@de ;
        sh:message "Un PhysicalTrainUnitIdentifier peut avoir au plus un leadingOnBoardUnitId (chaîne, identifiant de l'unité embarquée principale)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Physical Vehicle Shape =====
era:PhysicalVehicleShape a sh:NodeShape ;
    sh:targetClass era:PhysicalVehicle ;
    sh:message "Describes a single physical railway vehicle (coach, wagon, locomotive) within a train consist."@en ;
    sh:message "Beschreibt ein einzelnes physisches Schienenfahrzeug (Waggon, Waggon, Lokomotive) innerhalb eines Zugverbandes."@de ;
    sh:message "Décrit un seul véhicule ferroviaire physique (autocar, wagon, locomotive) au sein d'une composition de train."@fr ;
    
    # EVN Identifier (required, string - European Vehicle Number)
    sh:property [ 
        sh:path era:evnIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PhysicalVehicle must have exactly one evnIdentifier (string, unique European Vehicle Number for this vehicle)."@en ;
        sh:message "Jedes PhysicalVehicle muss genau eine evnIdentifier (Zeichenfolge, eindeutige europäische Fahrzeugnummer für dieses Fahrzeug) haben."@de ;
        sh:message "Chaque PhysicalVehicle doit avoir exactement un evnIdentifier (chaîne, numéro de véhicule européen unique pour ce véhicule)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Mass (required, unsigned integer - vehicle mass in tonnes)
    sh:property [ 
        sh:path era:mass ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PhysicalVehicle must have exactly one mass (unsigned integer, vehicle mass in tonnes including current load)."@en ;
        sh:message "Jedes PhysicalVehicle muss genau eine Masse haben (vorzeichenlose Ganzzahl, Fahrzeugmasse in Tonnen inklusive aktueller Beladung)."@de ;
        sh:message "Chaque véhicule physique doit avoir exactement une masse (entier non signé, masse du véhicule en tonnes, charge actuelle comprise)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Passenger Load (required, unsigned integer - passenger count for this vehicle)
    sh:property [ 
        sh:path era:passengerLoad ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each PhysicalVehicle must have exactly one passengerLoad (unsigned integer, number of passengers in this vehicle)."@en ;
        sh:message "Jedes PhysicalVehicle muss genau eine passengerLoad (vorzeichenlose Ganzzahl, Anzahl der Passagiere in diesem Fahrzeug) haben."@de ;
        sh:message "Chaque PhysicalVehicle doit avoir exactement un passengerLoad (entier non signé, nombre de passagers dans ce véhicule)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Vehicle Orientation (required, controlled vocabulary - direction relative to train)
    sh:property [ 
        sh:path era:vehicleOrientation ;
        sh:in (
            <http://data.europa.eu/949/concepts/vehicle-orientation/orientationUknown>
            <http://data.europa.eu/949/concepts/vehicle-orientation/orientationSameAsTrainUnit>
            <http://data.europa.eu/949/concepts/vehicle-orientation/orientationInverseToTrainUnit>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property vehicleOrientation must have a value from the defined SKOS concept scheme (orientationSameAsTrainUnit, orientationInverseToTrainUnit, or orientationUknown)."@en ;
        sh:message "Die Eigenschaft vehicleOrientation muss einen Wert aus dem definierten SKOS-Konzeptschema (orientationSameAsTrainUnit, orientationInverseToTrainUnit oder orientationUknown) haben."@de ;
        sh:message "La propriété vehicleOrientation doit avoir une valeur du schéma de concept SKOS défini (orientationSameAsTrainUnit, orientationInverseToTrainUnit ou orientationUknown)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Pantographs States (optional, up to 7 pantograph states - max 7 pantographs per vehicle)
    sh:property [ 
        sh:path era:pantographsStates ;
        sh:in (
            <http://data.europa.eu/949/concepts/pantograph-state/pantographRaised>
            <http://data.europa.eu/949/concepts/pantograph-state/pantographLowered>
            <http://data.europa.eu/949/concepts/pantograph-state/pantographBlocked>
            <http://data.europa.eu/949/concepts/pantograph-state/pantographStateUnknown>
        ) ;
        sh:maxCount 7 ;
        sh:message "The property pantographsStates may have up to 7 values from the defined SKOS concept scheme (pantographRaised, pantographLowered, pantographBlocked, or pantographStateUnknown)."@en ;
        sh:message "Die Eigenschaft pantographsStates kann bis zu 7 Werte aus dem definierten SKOS-Konzeptschema (pantographRaised, pantographLowered, pantographBlocked oder pantographStateUnknown) haben."@de ;
        sh:message "La propriété pantographsStates peut avoir jusqu'à 7 valeurs du schéma conceptuel SKOS défini (pantographRaised, pantographLowered, pantographBlocked ou pantographStateUnknown)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Door Data Left (optional, RDF list of door data for left side - max 7 doors)
    sh:property [ 
        sh:path era:doorDataLeft ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A PhysicalVehicle may have at most one doorDataLeft property pointing to an RDF list (max 7 doors)."@en ;
        sh:message "Ein PhysicalVehicle darf höchstens eine doorDataLeft-Eigenschaft haben, die auf eine RDF-Liste verweist (maximal 7 Türen)."@de ;
        sh:message "Un PhysicalVehicle peut avoir au plus une propriété doorDataLeft pointant vers une liste RDF (max 7 portes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate left door list has max 7 items
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "The doorDataLeft list must contain at most 7 door entries (typical maximum doors per vehicle side)."@en ;
        sh:message "Die doorDataLeft-Liste darf höchstens 7 Türeinträge enthalten (typische maximale Türen pro Fahrzeugseite)."@de ;
        sh:message "La liste doorDataLeft doit contenir au maximum sept entrées de porte (nombre maximum de portes par côté du véhicule)."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:doorDataLeft ?list .
                {
                    SELECT $this (COUNT(?item) AS ?count)
                    WHERE {
                        $this era:doorDataLeft ?list .
                        ?list rdf:rest*/rdf:first ?item .
                    }
                    GROUP BY $this
                    HAVING (?count > 7)
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all left door items are DoorData instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the doorDataLeft list must be instances of era:DoorData that conform to DoorDataShape."@en ;
        sh:message "Alle Elemente in der Liste doorDataLeft müssen Instanzen von era:DoorData sein, die DoorDataShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste doorDataLeft doivent être des instances de era:DoorData conformes à DoorDataShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:doorDataLeft ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                FILTER NOT EXISTS { ?item a era:DoorData }
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # Door Data Right (optional, RDF list of door data for right side - max 7 doors)
    sh:property [ 
        sh:path era:doorDataRight ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A PhysicalVehicle may have at most one doorDataRight property pointing to an RDF list (max 7 doors)."@en ;
        sh:message "Ein PhysicalVehicle darf höchstens eine doorDataRight-Eigenschaft haben, die auf eine RDF-Liste verweist (maximal 7 Türen)."@de ;
        sh:message "Un PhysicalVehicle peut avoir au plus une propriété doorDataRight pointant vers une liste RDF (max 7 portes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate right door list has max 7 items
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "The doorDataRight list must contain at most 7 door entries (typical maximum doors per vehicle side)."@en ;
        sh:message "Die doorDataRight-Liste darf höchstens 7 Türeinträge enthalten (typische maximale Türen pro Fahrzeugseite)."@de ;
        sh:message "La liste doorDataRight doit contenir au maximum sept entrées de porte (nombre maximum de portes par côté du véhicule)."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:doorDataRight ?list .
                {
                    SELECT $this (COUNT(?item) AS ?count)
                    WHERE {
                        $this era:doorDataRight ?list .
                        ?list rdf:rest*/rdf:first ?item .
                    }
                    GROUP BY $this
                    HAVING (?count > 7)
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all right door items are DoorData instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the doorDataRight list must be instances of era:DoorData that conform to DoorDataShape."@en ;
        sh:message "Alle Elemente in der Liste doorDataRight müssen Instanzen von era:DoorData sein, die DoorDataShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste doorDataRight doivent être des instances de era:DoorData conformes à DoorDataShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:doorDataRight ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                FILTER NOT EXISTS { ?item a era:DoorData }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== Restricted Aspect Shape =====
era:RestrictedAspectShape a sh:NodeShape ;
    sh:targetClass era:RestrictedAspect ;
    sh:message "Defines restrictions on train operation - must specify exactly one type of 'proper' restriction aspect."@en ;
    sh:message "Definiert Einschränkungen für den Zugbetrieb – muss genau einen Typ von „richtigem“ Einschränkungsaspekt angeben."@de ;
    sh:message "Définit les restrictions sur l'exploitation des trains - doit spécifier exactement un type d'aspect de restriction « approprié »."@fr ;
    
    # Each Restricted Aspect must have exactly ONE of these restriction types
    sh:xone (
        # Speed Restriction
        [ sh:path era:speedRestriction ;
          sh:node era:SpeedRestrictionShape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Restricted aspect is a speed restriction."@en ;
          sh:message "Eingeschränkter Aspekt ist eine Geschwindigkeitsbeschränkung."@de ;
          sh:message "L'aspect restreint est une limitation de vitesse."@fr ]
        
        # Maximum Adhesion Restriction
        [ sh:path era:maxAdhesion ;
          sh:in (
              <http://data.europa.eu/949/concepts/adhesion-category/dryRailHigh>
              <http://data.europa.eu/949/concepts/adhesion-category/dryRailMedium>
              <http://data.europa.eu/949/concepts/adhesion-category/dryRailLow>
              <http://data.europa.eu/949/concepts/adhesion-category/lowAdhesion>
              <http://data.europa.eu/949/concepts/adhesion-category/veryLowAdhesion>
              <http://data.europa.eu/949/concepts/adhesion-category/extremelyLowAdhesion>
              <http://data.europa.eu/949/concepts/adhesion-category/unknownAdhesion>
          ) ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "The property maxAdhesion must have a value from the defined SKOS concept scheme (dryRailHigh through extremelyLowAdhesion)."@en ;
          sh:message "Die Eigenschaft maxAdhesion muss einen Wert aus dem definierten SKOS-Konzeptschema (dryRailHigh bis extremelyLowAdhesion) haben."@de ;
          sh:message "La propriété maxAdhesion doit avoir une valeur du schéma de concept SKOS défini (dryRailHigh à extremelyLowAdhesion)."@fr ]
        
        # Allowed Driving Modes Restriction
        [ sh:path era:allowedDrivingModes ;
          sh:in (
              <http://data.europa.eu/949/concepts/onboard-operating-mode/undefined>
              <http://data.europa.eu/949/concepts/onboard-operating-mode/onSight>
              <http://data.europa.eu/949/concepts/onboard-operating-mode/fullSupervision>
              <http://data.europa.eu/949/concepts/onboard-operating-mode/standBy>
          ) ;
          sh:message "The property allowedDrivingModes must have values from the defined SKOS concept scheme (fullSupervision, onSight, standBy, or undefined)."@en ;
          sh:message "Die Eigenschaft allowedDrivingModes muss Werte aus dem definierten SKOS-Konzeptschema (fullSupervision, onSight, standBy oder undefiniert) haben."@de ;
          sh:message "La propriété allowedDrivingModes doit avoir des valeurs du schéma de concept SKOS défini (fullSupervision, onSight, standBy ou non défini)."@fr ]
        
        # Track Closure
        [ sh:path era:trackClosure ;
          sh:datatype xsd:boolean ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Restricted aspect is a track closure (boolean)."@en ;
          sh:message "Eingeschränkter Aspekt ist eine Spurschließung (boolean)."@de ;
          sh:message "L'aspect restreint est une fermeture de piste (booléen)."@fr ]
        
        # Non-Stopping Restriction
        [ sh:path era:nonStopping ;
          sh:datatype xsd:boolean ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Restricted aspect is a non-stopping requirement (boolean)."@en ;
          sh:message "Der eingeschränkte Aspekt ist eine ununterbrochene Anforderung (boolescher Wert)."@de ;
          sh:message "L'aspect restreint est une exigence non-stop (booléenne)."@fr ]
        
        # Operational Radio Hole
        [ sh:path era:operationalRadioHole ;
          sh:datatype xsd:boolean ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Restricted aspect is a radio coverage gap (boolean)."@en ;
          sh:message "Eingeschränkter Aspekt ist eine Funkabdeckungslücke (boolescher Wert)."@de ;
          sh:message "L'aspect restreint est un écart de couverture radio (booléen)."@fr ]
        
        # Maximum Current Restriction
        [ sh:path era:maxCurrent ;
          sh:datatype xsd:unsignedInt ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Restricted aspect is a maximum current limit (unsigned integer, in amperes)."@en ;
          sh:message "Der eingeschränkte Aspekt ist eine maximale Strombegrenzung (ganzzahlige Zahl ohne Vorzeichen, in Ampere)."@de ;
          sh:message "L'aspect restreint est une limite de courant maximale (entier non signé, en ampères)."@fr ]
        
        # ATO Inhibition
        [ sh:path era:atoInhibition ;
          sh:datatype xsd:boolean ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Restricted aspect is an ATO inhibition (boolean, prevents automatic train operation)."@en ;
          sh:message "Eingeschränkter Aspekt ist eine ATO-Hemmung (boolean, verhindert den automatischen Zugbetrieb)."@de ;
          sh:message "L'aspect restreint est une inhibition ATO (booléen, empêche le fonctionnement automatique du train)."@fr ]
    ) .

# ===== Restriction Area Shape =====
era:RestrictionAreaShape a sh:NodeShape ;
    sh:targetClass era:RestrictionArea ;
    sh:message "Defines a geographical area where operational restrictions apply."@en ;
    sh:message "Definiert einen geografischen Bereich, in dem Betriebsbeschränkungen gelten."@de ;
    sh:message "Définit une zone géographique où des restrictions opérationnelles s'appliquent."@fr ;
    
    # Linear Element Sections (required, at least one section defining the area)
    sh:property [ 
        sh:path era:linearElementSections ;
        sh:node era:LinearElementSectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each RestrictionArea must have at least one linearElementSections that conform to LinearElementSection object (defining where restriction applies)."@en ;
        sh:message "Jede RestrictionArea muss mindestens einen linearElementSections haben, der dem LinearElementSection-Objekt entspricht (und definiert, wo die Einschränkung gilt)."@de ;
        sh:message "Chaque RestrictionArea doit avoir au moins un linearElementSections conforme à l'objet LinearElementSection (définissant où la restriction s'applique)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Specific Restrictions (required, at least one restriction)
    sh:property [ 
        sh:path era:specificRestrictions ;
        sh:node era:SpecificRestrictionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each RestrictionArea must have at least one specificRestrictions that conform to SpecificRestriction object (defining what restrictions apply)."@en ;
        sh:message "Jede RestrictionArea muss mindestens ein specificRestrictions haben, das dem SpecificRestriction-Objekt entspricht (das definiert, welche Einschränkungen gelten)."@de ;
        sh:message "Chaque RestrictionArea doit avoir au moins un specificRestrictions conforme à l'objet SpecificRestriction (définissant les restrictions applicables)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Restriction Area State Shape =====
era:RestrictionAreaStateShape a sh:NodeShape ;
    sh:targetClass era:RestrictionAreaState ;
    sh:message "Records the state change of a restriction area at a specific time (creation or removal)."@en ;
    sh:message "Zeichnet die Zustandsänderung eines Sperrgebiets zu einem bestimmten Zeitpunkt (Erstellung oder Entfernung) auf."@de ;
    sh:message "Enregistre le changement d'état d'une zone de restriction à un moment précis (création ou suppression)."@fr ;
    
    # Restriction State (required, controlled vocabulary - created or removed)
    sh:property [ 
        sh:path era:restrictionState ;
        sh:in (
            <http://data.europa.eu/949/concepts/restriction-state/created>
            <http://data.europa.eu/949/concepts/restriction-state/removed>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property restrictionState must have a value from the defined SKOS concept scheme (created or removed)."@en ;
        sh:message "Die Eigenschaft restrictionState muss einen Wert aus dem definierten SKOS-Konzeptschema (erstellt oder entfernt) haben."@de ;
        sh:message "La propriété restrictionState doit avoir une valeur du schéma de concept SKOS défini (créé ou supprimé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime - when state change occurred)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RestrictionAreaState must have exactly one issuedAt timestamp (xsd:dateTime, when state change was recorded)."@en ;
        sh:message "Jeder RestrictionAreaState muss genau einen issuedAt-Zeitstempel haben (xsd:dateTime, wann die Statusänderung aufgezeichnet wurde)."@de ;
        sh:message "Chaque RestrictionAreaState doit avoir exactement un horodatage issuedAt (xsd:dateTime, lorsque le changement d'état a été enregistré)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Restriction Area (optional, reference to the area)
    sh:property [ 
        sh:path era:restrictionArea ;
        sh:node era:RestrictionAreaShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A RestrictionAreaState may reference at most one restrictionArea that conforms to RestrictionArea object."@en ;
        sh:message "Ein RestrictionAreaState kann höchstens auf ein restrictionArea verweisen, das dem RestrictionArea-Objekt entspricht."@de ;
        sh:message "Un RestrictionAreaState peut faire référence à au plus un restrictionArea conforme à l'objet RestrictionArea."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Restriction Event (optional, associated event)
    sh:property [ 
        sh:path era:restrictionEvent ;
        sh:class era:RestrictionEvent ;
		sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "A RestrictionAreaState may reference at most one restrictionEvent that conforms to RestrictionEvent object."@en ;
        sh:message "Ein RestrictionAreaState kann höchstens auf ein restrictionEvent verweisen, das dem RestrictionEvent-Objekt entspricht."@de ;
        sh:message "Un RestrictionAreaState peut faire référence à au plus un restrictionEvent conforme à l'objet RestrictionEvent."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Restriction Event Execution Report Shape =====
era:RestrictionEventExecutionReportShape a sh:NodeShape ;
    sh:targetClass era:RestrictionEventExecutionReport ;
    sh:message "Report documenting the execution result of a restriction event (creation or removal of restrictions)."@en ;
    sh:message "Bericht, der das Ausführungsergebnis eines Einschränkungsereignisses dokumentiert (Erstellung oder Aufhebung von Einschränkungen)."@de ;
    sh:message "Rapport documentant le résultat de l'exécution d'un événement de restriction (création ou suppression de restrictions)."@fr ;
    
    # Restriction Event (required, reference to the event)
    sh:property [ 
        sh:path era:restrictionEvent ;
        sh:class era:RestrictionEvent ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RestrictionEventExecutionReport must reference exactly one restrictionEvent that conforms to RestrictionEvent object."@en ;
        sh:message "Jeder RestrictionEventExecutionReport muss auf genau ein restrictionEvent verweisen, das dem RestrictionEvent-Objekt entspricht."@de ;
        sh:message "Chaque RestrictionEventExecutionReport doit faire référence à exactement un restrictionEvent conforme à l'objet RestrictionEvent."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Issued At (required, dateTime - when associated plan was issued)
    sh:property [ 
        sh:path era:operationalPlanIssuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RestrictionEventExecutionReport must have exactly one operationalPlanIssuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder RestrictionEventExecutionReport muss genau einen operationalPlanIssuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque RestrictionEventExecutionReport doit avoir exactement un horodatage operationalPlanIssuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Execution State (required, controlled vocabulary - outcome)
    sh:property [ 
        sh:path era:executionState ;
        sh:in (
            <http://data.europa.eu/949/concepts/event-execution-state/eventCompleted>
            <http://data.europa.eu/949/concepts/event-execution-state/eventFailed>
            <http://data.europa.eu/949/concepts/event-execution-state/eventWarning>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property executionState must have a value from the defined SKOS concept scheme (eventCompleted, eventFailed, or eventWarning)."@en ;
        sh:message "Die Eigenschaft executionState muss einen Wert aus dem definierten SKOS-Konzeptschema (eventCompleted, eventFailed oder eventWarning) haben."@de ;
        sh:message "La propriété executionState doit avoir une valeur du schéma de concept SKOS défini (eventCompleted, eventFailed ou eventWarning)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime - when report was generated)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RestrictionEventExecutionReport must have exactly one issuedAt timestamp (xsd:dateTime, when report was created)."@en ;
        sh:message "Jeder RestrictionEventExecutionReport muss genau einen issuedAt-Zeitstempel haben (xsd:dateTime, als der Bericht erstellt wurde)."@de ;
        sh:message "Chaque RestrictionEventExecutionReport doit avoir exactement un horodatage issuedAt (xsd:dateTime, lorsque le rapport a été créé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Failure Reason (optional, string - explanation if failed)
    sh:property [ 
        sh:path era:failureReason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A RestrictionEventExecutionReport may have at most one failureReason (string, required if executionState is eventFailed)."@en ;
        sh:message "Ein RestrictionEventExecutionReport darf höchstens eine failureReason (Zeichenfolge, erforderlich, wenn executionState eventFailed ist) haben."@de ;
        sh:message "Un RestrictionEventExecutionReport peut avoir au plus un failureReason (chaîne, obligatoire si executionState est eventFailed)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Warning (optional, string - warning details if warning state)
    sh:property [ 
        sh:path era:warning ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A RestrictionEventExecutionReport may have at most one warning (string, required if executionState is eventWarning)."@en ;
        sh:message "Ein RestrictionEventExecutionReport kann höchstens eine Warnung haben (Zeichenfolge, erforderlich, wenn executionState eventWarning ist)."@de ;
        sh:message "Un RestrictionEventExecutionReport peut contenir au plus un avertissement (chaîne, obligatoire si executionState est eventWarning)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Restriction Event Shape =====
era:RestrictionEventShape a sh:NodeShape ;
    sh:targetClass era:RestrictionEvent ;
    sh:message "Defines a scheduled event for creating or removing operational restrictions."@en ;
    sh:message "Definiert ein geplantes Ereignis zum Erstellen oder Entfernen von Betriebsbeschränkungen."@de ;
    sh:message "Définit un événement planifié pour créer ou supprimer des restrictions opérationnelles."@fr ;
    
    # Restriction Area (required, where restriction applies)
    sh:property [ 
        sh:path era:restrictionArea ;
        sh:node era:RestrictionAreaShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RestrictionEvent must reference exactly one restrictionArea that conforms to RestrictionArea object."@en ;
        sh:message "Jedes RestrictionEvent muss auf genau ein restrictionArea verweisen, das dem RestrictionArea-Objekt entspricht."@de ;
        sh:message "Chaque RestrictionEvent doit faire référence à exactement un restrictionArea conforme à l'objet RestrictionArea."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Creation Time (required, dateTime - when restriction becomes active)
    sh:property [ 
        sh:path era:creationTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RestrictionEvent must have exactly one creationTime (xsd:dateTime, when restriction becomes active)."@en ;
        sh:message "Jedes RestrictionEvent muss genau ein creationTime haben (xsd:dateTime, wenn die Einschränkung aktiv wird)."@de ;
        sh:message "Chaque RestrictionEvent doit avoir exactement un creationTime (xsd:dateTime, lorsque la restriction devient active)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Removal Time (required, dateTime - when restriction is lifted)
    sh:property [ 
        sh:path era:removalTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each RestrictionEvent must have exactly one removalTime (xsd:dateTime, when restriction is removed)."@en ;
        sh:message "Jedes RestrictionEvent muss genau ein removalTime haben (xsd:dateTime, wenn die Einschränkung entfernt wird)."@de ;
        sh:message "Chaque RestrictionEvent doit avoir exactement un removalTime (xsd:dateTime, lorsque la restriction est supprimée)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Starts After Events (optional, prerequisite events)
    sh:property [ 
        sh:path era:startsAfterEvents ;
        sh:node era:OperationalEventRefShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A RestrictionEvent may reference multiple startsAfterEvents that must complete before this restriction is activated. Refer to the referenced object to ensure conformance."@en ;
        sh:message "Ein RestrictionEvent kann auf mehrere startsAfterEvents verweisen, die abgeschlossen werden müssen, bevor diese Einschränkung aktiviert wird. Beziehen Sie sich auf das referenzierte Objekt, um die Konformität sicherzustellen."@de ;
        sh:message "Un RestrictionEvent peut faire référence à plusieurs startsAfterEvents qui doivent se terminer avant que cette restriction ne soit activée. Reportez-vous à l'objet référencé pour garantir la conformité."@fr ;
        sh:severity sh:Violation ;
    ] .


# ===== Specific Movement Restriction Shape =====
era:SpecificMovementRestrictionShape a sh:NodeShape ;
    sh:targetClass era:SpecificMovementRestriction ;
    sh:message "Defines a specific type of movement restriction - must specify exactly one 'proper' restriction type."@en ;
    sh:message "Definiert einen bestimmten Typ einer Bewegungseinschränkung – es muss genau ein „richtiger“ Einschränkungstyp angegeben werden."@de ;
    sh:message "Définit un type spécifique de restriction de mouvement – ​​doit spécifier exactement un type de restriction « approprié »."@fr ;
    
    # Each Specific Movement Restriction must have exactly ONE of these restriction types
    sh:xone (
        # Speed Restriction
        [ sh:path era:speedRestriction ;
          sh:node era:SpeedRestrictionShape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Specific movement restriction is a speed restriction."@en ;
          sh:message "Eine konkrete Bewegungseinschränkung ist eine Geschwindigkeitsbeschränkung."@de ;
          sh:message "Une restriction de mouvement spécifique est une restriction de vitesse."@fr ]
        
        # Adhesion Category Restriction
        [ sh:path era:adhesionCategory ;
          sh:in (
              <http://data.europa.eu/949/concepts/adhesion-category/dryRailHigh>
              <http://data.europa.eu/949/concepts/adhesion-category/dryRailMedium>
              <http://data.europa.eu/949/concepts/adhesion-category/dryRailLow>
              <http://data.europa.eu/949/concepts/adhesion-category/lowAdhesion>
              <http://data.europa.eu/949/concepts/adhesion-category/veryLowAdhesion>
              <http://data.europa.eu/949/concepts/adhesion-category/extremelyLowAdhesion>
              <http://data.europa.eu/949/concepts/adhesion-category/unknownAdhesion>
          ) ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "The property adhesionCategory must have a value from the defined SKOS concept scheme (dryRailHigh through extremelyLowAdhesion)."@en ;
          sh:message "Die Eigenschaft adhesionCategory muss einen Wert aus dem definierten SKOS-Konzeptschema (dryRailHigh bis extremelyLowAdhesion) haben."@de ;
          sh:message "La propriété adhesionCategory doit avoir une valeur du schéma de concept SKOS défini (dryRailHigh à extremelyLowAdhesion)."@fr ]
        
        # Maximum Current Restriction
        [ sh:path era:maxCurrent ;
          sh:datatype xsd:unsignedInt ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Specific movement restriction is a maximum current limit (unsigned integer, in amperes)."@en ;
          sh:message "Eine spezifische Bewegungsbeschränkung ist eine maximale Strombegrenzung (ganzzahlige Zahl ohne Vorzeichen, in Ampere)."@de ;
          sh:message "La restriction de mouvement spécifique est une limite de courant maximale (entier non signé, en ampères)."@fr ]
        
        # ATO Inhibition
        [ sh:path era:atoInhibition ;
          sh:datatype xsd:boolean ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Specific movement restriction is an ATO inhibition (boolean)."@en ;
          sh:message "Eine spezifische Bewegungseinschränkung ist eine ATO-Hemmung (boolesch)."@de ;
          sh:message "La restriction de mouvement spécifique est une inhibition ATO (booléenne)."@fr ]
        
        # DAS Inhibition
        [ sh:path era:dasInhibition ;
          sh:datatype xsd:boolean ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Specific movement restriction is a Driver Advisory System inhibition (boolean)."@en ;
          sh:message "Eine spezifische Bewegungseinschränkung ist eine Hemmung des Fahrerberatungssystems (boolescher Wert)."@de ;
          sh:message "La restriction de mouvement spécifique est une inhibition du système d'avis au conducteur (booléen)."@fr ]
        
        # Excluded DPS Groups for Flank Protection
        [ sh:path era:excludedDPSGroupsForFlankProtection ;
          sh:node era:DPSGroupsListShape ;
          sh:nodeKind sh:BlankNodeOrIRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Specific movement restriction is an exclusion of DPS groups for flank protection."@en ;
          sh:message "Eine spezifische Bewegungseinschränkung ist ein Ausschluss von DPS-Gruppen zum Flankenschutz."@de ;
          sh:message "La restriction de mouvement spécifique est une exclusion des groupes DPS pour la protection des flancs."@fr ]
    ) .

# ===== Specific Restriction Shape =====
era:SpecificRestrictionShape a sh:NodeShape ;
    sh:targetClass era:SpecificRestriction ;
    sh:message "Detailed restriction definition including what aspects are restricted and which trains are affected."@en ;
    sh:message "Detaillierte Einschränkungsdefinition, einschließlich der eingeschränkten Aspekte und der betroffenen Züge."@de ;
    sh:message "Définition détaillée des restrictions, comprenant quels aspects sont restreints et quels trains sont concernés."@fr ;
    
    # Restricted Aspects (required, at least one aspect)
    sh:property [ 
        sh:path era:restrictedAspects ;
        sh:node era:RestrictedAspectShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each SpecificRestriction must have at least one restrictedAspects that conform to RestrictedAspect object."@en ;
        sh:message "Jede SpecificRestriction muss mindestens eine restrictedAspects haben, die dem RestrictedAspect-Objekt entspricht."@de ;
        sh:message "Chaque SpecificRestriction doit avoir au moins un restrictedAspects conforme à l'objet RestrictedAspect."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Applied To Trains (optional, which train groups this applies to)
    sh:property [ 
        sh:path era:appliedToTrains ;
        sh:node era:TrainGroupSpecShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A SpecificRestriction may have at most one appliedToTrains specification (TrainGroupSpec)."@en ;
        sh:message "Eine SpecificRestriction darf höchstens eine appliedToTrains-Spezifikation (TrainGroupSpec) haben."@de ;
        sh:message "Une SpecificRestriction peut avoir au plus une spécification appliedToTrains (TrainGroupSpec)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Speed Restriction Shape =====
era:SpeedRestrictionShape a sh:NodeShape ;
    sh:targetClass era:SpeedRestriction ;
    sh:message "Speed restriction definition with maximum permitted speed and application point."@en ;
    sh:message "Definition der Geschwindigkeitsbeschränkung mit maximal zulässiger Geschwindigkeit und Angriffspunkt."@de ;
    sh:message "Définition de la limitation de vitesse avec vitesse maximale autorisée et point d'application."@fr ;
    
    # Max Speed (required, unsigned integer - in km/h)
    sh:property [ 
        sh:path era:maxSpeed ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SpeedRestriction must have exactly one maxSpeed (unsigned integer, maximum permitted speed in km/h)."@en ;
        sh:message "Jede SpeedRestriction muss genau eine maxSpeed (vorzeichenlose Ganzzahl, maximal zulässige Geschwindigkeit in km/h) haben."@de ;
        sh:message "Chaque SpeedRestriction doit avoir exactement un maxSpeed (entier non signé, vitesse maximale autorisée en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Restriction Ends At Train Front (required, boolean)
    sh:property [ 
        sh:path era:restrictionEndsAtTrainFront ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SpeedRestriction must have exactly one restrictionEndsAtTrainFront (boolean: true=ends when front passes, false=ends when rear passes)."@en ;
        sh:message "Jede SpeedRestriction muss genau eine restrictionEndsAtTrainFront haben (boolescher Wert: true=endet, wenn die Front passiert, false=endet, wenn die Rückseite passiert)."@de ;
        sh:message "Chaque SpeedRestriction doit avoir exactement un restrictionEndsAtTrainFront (booléen : true = se termine lorsque l'avant passe, false = se termine lorsque l'arrière passe)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Stop Description Shape =====
era:StopDescriptionShape a sh:NodeShape ;
    sh:targetClass era:StopDescription ;
    sh:message "Detailed description of a station stop including times, doors, and train activities."@en ;
    sh:message "Detaillierte Beschreibung einer Haltestelle einschließlich Zeiten, Türen und Zugaktivitäten."@de ;
    sh:message "Description détaillée d'un arrêt de gare, y compris les horaires, les portes et les activités du train."@fr ;
    
    # Scheduled Departure (required, dateTime)
    sh:property [ 
        sh:path era:scheduledDeparture ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StopDescription must have exactly one scheduledDeparture timestamp (xsd:dateTime)."@en ;
        sh:message "Jede StopDescription muss genau einen scheduledDeparture-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque StopDescription doit avoir exactement un horodatage scheduledDeparture (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Scheduled Minimum Dwell Time (required, unsigned integer - in seconds)
    sh:property [ 
        sh:path era:scheduledMinDwellTime ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StopDescription must have exactly one scheduledMinDwellTime (unsigned integer, minimum stop duration in seconds)."@en ;
        sh:message "Jede StopDescription muss genau eine scheduledMinDwellTime haben (Ganzzahl ohne Vorzeichen, minimale Stoppdauer in Sekunden)."@de ;
        sh:message "Chaque StopDescription doit avoir exactement un scheduledMinDwellTime (entier non signé, durée d'arrêt minimale en secondes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Hold Train (required, boolean)
    sh:property [ 
        sh:path era:holdTrain ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StopDescription must have exactly one holdTrain (boolean, whether train must wait for connections)."@en ;
        sh:message "Jede StopDescription muss genau eine holdTrain haben (boolescher Wert, ob der Zug auf Verbindungen warten muss)."@de ;
        sh:message "Chaque StopDescription doit avoir exactement un holdTrain (booléen, indiquant si le train doit attendre les correspondances)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Relaxed Coupler (required, boolean)
    sh:property [ 
        sh:path era:relaxedCoupler ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StopDescription must have exactly one relaxedCoupler (boolean, whether coupler tension is released during stop)."@en ;
        sh:message "Jede StopDescription muss genau eine relaxedCoupler haben (boolescher Wert, ob die Kupplungsspannung während des Stopps gelöst wird)."@de ;
        sh:message "Chaque StopDescription doit avoir exactement un relaxedCoupler (booléen, indiquant si la tension du coupleur est relâchée pendant l'arrêt)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Door Activity (optional, door operation configuration)
    sh:property [ 
        sh:path era:doorActivity ;
        sh:node era:DoorActivityShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A StopDescription may have at most one doorActivity that conforms to DoorActivity object."@en ;
        sh:message "Eine StopDescription kann höchstens eine doorActivity haben, die dem DoorActivity-Objekt entspricht."@de ;
        sh:message "Une StopDescription peut avoir au plus un doorActivity conforme à l'objet DoorActivity."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Additional Event Times (optional, up to 4 additional time specifications)
    sh:property [ 
        sh:path era:additionalEventTimes ;
        sh:node era:AdditionalEventTimeShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 4 ;
        sh:message "A StopDescription may have at most 4 additionalEventTimes that conform to AdditionalEventTime object."@en ;
        sh:message "Eine StopDescription darf höchstens 4 additionalEventTimes haben, die dem AdditionalEventTime-Objekt entsprechen."@de ;
        sh:message "Une StopDescription peut avoir au plus 4 additionalEventTimes conformes à l'objet AdditionalEventTime."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Unit Activities (optional, RDF list)
    sh:property [ 
        sh:path era:trainUnitActivities ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A StopDescription may have at most one trainUnitActivities property pointing to an RDF list."@en ;
        sh:message "Eine StopDescription darf höchstens eine trainUnitActivities-Eigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Une StopDescription peut avoir au plus une propriété trainUnitActivities pointant vers une liste RDF."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all train unit activities list items
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the trainUnitActivities list must be instances of era:TrainUnitActivity that conform to TrainUnitActivityShape."@en ;
        sh:message "Alle Elemente in der Liste trainUnitActivities müssen Instanzen von era:TrainUnitActivity sein, die TrainUnitActivityShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste trainUnitActivities doivent être des instances de era:TrainUnitActivity conformes à TrainUnitActivityShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:trainUnitActivities ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                FILTER NOT EXISTS { ?item a era:TrainUnitActivity }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .

# ===== Supported OnBoard Equipment Shape =====
era:SupportedOnBoardEquipmentShape a sh:NodeShape ;
    sh:targetClass era:SupportedOnBoardEquipment ;
    sh:message "Describes the train protection systems and ETCS capabilities supported by the train."@en ;
    sh:message "Beschreibt die vom Zug unterstützten Zugsicherungssysteme und ETCS-Funktionen."@de ;
    sh:message "Décrit les systèmes de protection du train et les capacités ETCS pris en charge par le train."@fr ;
    
    # Train Protection Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:trainProtectionType ;
        sh:in (
            <http://data.europa.eu/949/concepts/train-protection-type/Etcs>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property trainProtectionType must have a value from the defined SKOS concept scheme (currently only Etcs is defined)."@en ;
        sh:message "Die Eigenschaft trainProtectionType muss einen Wert aus dem definierten SKOS-Konzeptschema haben (derzeit ist nur Etcs definiert)."@de ;
        sh:message "La propriété trainProtectionType doit avoir une valeur du schéma de concept SKOS défini (actuellement, seul Etcs est défini)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # ETCS System Versions (required, at least one version string)
    sh:property [ 
        sh:path era:etcsSystemVersions ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Each SupportedOnBoardEquipment must have at least one etcsSystemVersions (string, ETCS baseline version)."@en ;
        sh:message "Jedes SupportedOnBoardEquipment muss mindestens eine etcsSystemVersions (Zeichenfolge, ETCS-Basisversion) haben."@de ;
        sh:message "Chaque SupportedOnBoardEquipment doit avoir au moins un etcsSystemVersions (chaîne, version de base ETCS)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # OnBoard Extensions (optional, vendor-specific extensions)
    sh:property [ 
        sh:path era:onboardExtensions ;
        sh:node era:OnBoardExtensionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A SupportedOnBoardEquipment may have multiple onboardExtensions that conform to OnBoardExtension object."@en ;
        sh:message "Ein SupportedOnBoardEquipment kann mehrere onboardExtensions haben, die dem OnBoardExtension-Objekt entsprechen."@de ;
        sh:message "Un SupportedOnBoardEquipment peut avoir plusieurs onboardExtensions conformes à l'objet OnBoardExtension."@fr ;
        sh:severity sh:Violation ;
    ] .


# ===== Track Occupation State Shape =====
era:TrackOccupationStateShape a sh:NodeShape ;
    sh:targetClass era:TrackOccupationState ;
    sh:message "Records the occupation state of a track section by a train at a specific time."@en ;
    sh:message "Erfasst den Belegungszustand eines Gleisabschnitts durch einen Zug zu einem bestimmten Zeitpunkt."@de ;
    sh:message "Enregistre l'état d'occupation d'un tronçon de voie par un train à un moment précis."@fr ;
    
    # Track Area (required, which track section is occupied)
    sh:property [ 
        sh:path era:trackArea ;
        sh:node era:NetAreaReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrackOccupationState must reference exactly one trackArea that conforms to NetAreaReference object."@en ;
        sh:message "Jeder TrackOccupationState muss auf genau ein trackArea verweisen, das dem NetAreaReference-Objekt entspricht."@de ;
        sh:message "Chaque TrackOccupationState doit faire référence à exactement un trackArea conforme à l'objet NetAreaReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Occupation State (required, controlled vocabulary - created/updated/removed)
    sh:property [ 
        sh:path era:occupationState ;
        sh:in (
            <http://data.europa.eu/949/concepts/event-state/created>
            <http://data.europa.eu/949/concepts/event-state/updated>
            <http://data.europa.eu/949/concepts/event-state/removed>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property occupationState must have a value from the defined SKOS concept scheme (created, updated, or removed)."@en ;
        sh:message "Die Eigenschaft occupationState muss einen Wert aus dem definierten SKOS-Konzeptschema haben (erstellt, aktualisiert oder entfernt)."@de ;
        sh:message "La propriété occupationState doit avoir une valeur du schéma de concept SKOS défini (créé, mis à jour ou supprimé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Creation Reason (required, controlled vocabulary - why occupation was created)
    sh:property [ 
        sh:path era:creationReason ;
        sh:in (
            <http://data.europa.eu/949/concepts/occupation-reason/shorterLTrain>
            <http://data.europa.eu/949/concepts/occupation-reason/toCommLoss>
            <http://data.europa.eu/949/concepts/occupation-reason/systemInit>
            <http://data.europa.eu/949/concepts/occupation-reason/ttdOccupation>
            <http://data.europa.eu/949/concepts/occupation-reason/ttdFree>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property creationReason must have a value from the defined SKOS concept scheme (shorterLTrain, toCommLoss, systemInit, ttdOccupation, or ttdFree)."@en ;
        sh:message "Die Eigenschaft creationReason muss einen Wert aus dem definierten SKOS-Konzeptschema (shorterLTrain, toCommLoss, systemInit, ttdOccupation oder ttdFree) haben."@de ;
        sh:message "La propriété creationReason doit avoir une valeur du schéma conceptuel SKOS défini (shorterLTrain, toCommLoss, systemInit, ttdOccupation ou ttdFree)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime - when state was recorded)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrackOccupationState must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder TrackOccupationState muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque TrackOccupationState doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Recorded Train Length (required, unsigned integer - in meters)
    sh:property [ 
        sh:path era:recordedTrainLength ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrackOccupationState must have exactly one recordedTrainLength (unsigned integer, train length in meters)."@en ;
        sh:message "Jeder TrackOccupationState muss genau eine recordedTrainLength (vorzeichenlose Ganzzahl, Zuglänge in Metern) haben."@de ;
        sh:message "Chaque TrackOccupationState doit avoir exactement un recordedTrainLength (entier non signé, longueur du train en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Movement (optional, associated movement plan)
    sh:property [ 
        sh:path era:operationalPlanMovement ;
        sh:class era:OperationalPlanMovement ;
		sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "A TrackOccupationState may reference at most one operationalPlanMovement that conforms to OperationalPlanMovement object."@en ;
        sh:message "Ein TrackOccupationState kann höchstens einen operationalPlanMovement referenzieren, der dem OperationalPlanMovement-Objekt entspricht."@de ;
        sh:message "Un TrackOccupationState peut faire référence à au plus un operationalPlanMovement conforme à l'objet OperationalPlanMovement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Unit Identifier (optional, train identification)
    sh:property [ 
        sh:path era:trainUnitIdentifier ;
        sh:node era:PhysicalTrainUnitIdentifierShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A TrackOccupationState may reference at most one trainUnitIdentifier that conforms to PhysicalTrainUnitIdentifier object."@en ;
        sh:message "Ein TrackOccupationState kann höchstens einen trainUnitIdentifier referenzieren, der dem PhysicalTrainUnitIdentifier-Objekt entspricht."@de ;
        sh:message "Un TrackOccupationState peut faire référence à au plus un trainUnitIdentifier conforme à l'objet PhysicalTrainUnitIdentifier."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Associated Train Object (optional, string - train object ID)
    sh:property [ 
        sh:path era:associatedTrainObject ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A TrackOccupationState may have at most one associatedTrainObject (string, identifier of associated TrainObject)."@en ;
        sh:message "Ein TrackOccupationState darf höchstens einen associatedTrainObject (String, Bezeichner des zugehörigen TrainObjects) haben."@de ;
        sh:message "Un TrackOccupationState peut avoir au plus un associatedTrainObject (chaîne, identifiant du TrainObject associé)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Train Group Spec Shape =====
era:TrainGroupSpecShape a sh:NodeShape ;
    sh:targetClass era:TrainGroupSpec ;
    sh:message "Specification defining groups of trains by their characteristics (axle load, cant deficiency, etc.)."@en ;
    sh:message "Spezifikation, die Gruppen von Zügen anhand ihrer Eigenschaften (Achslast, Überhöhungsdefizit usw.) definiert."@de ;
    sh:message "Cahier des charges définissant des groupes de trains par leurs caractéristiques (charge à l'essieu, défaut de dévers, etc.)."@fr ;
    
    # Axle Load Categories (optional, multiple categories allowed)
    sh:property [ 
        sh:path era:axleLoadCategories ;
        sh:in (
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_A>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_HS17>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B1>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4XL>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E5>
        ) ;
        sh:message "The property axleLoadCategories must have values from the defined SKOS concept scheme (AL_A through AL_E5)."@en ;
        sh:message "Die Eigenschaft axleLoadCategories muss Werte aus dem definierten SKOS-Konzeptschema (AL_A bis AL_E5) haben."@de ;
        sh:message "La propriété axleLoadCategories doit avoir des valeurs du schéma de concept SKOS défini (AL_A à AL_E5)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Cant Deficiency Categories (optional, multiple categories allowed)
    sh:property [ 
        sh:path era:cantDeficiencyCategories ;
        sh:in (
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_Undefined>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_80mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_100mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_130mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_150mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_165mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_180mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_210mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_225mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_245mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_275mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_300mm>
        ) ;
        sh:message "The property cantDeficiencyCategories must have values from the defined SKOS concept scheme (CD_80mm through CD_300mm, or CD_Undefined)."@en ;
        sh:message "Die Eigenschaft cantDeficiencyCategories muss Werte aus dem definierten SKOS-Konzeptschema haben (CD_80mm bis CD_300mm oder CD_Undefiniert)."@de ;
        sh:message "La propriété cantDeficiencyCategories doit avoir des valeurs du schéma de concept SKOS défini (CD_80mm à CD_300mm, ou CD_Undefined)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Train Object Shape =====
era:TrainObjectShape a sh:NodeShape ;
    sh:targetClass era:TrainObject ;
    sh:message "Real-time representation of a train including position, speed, characteristics, and movement authority."@en ;
    sh:message "Echtzeitdarstellung eines Zuges einschließlich Position, Geschwindigkeit, Eigenschaften und Bewegungsautorität."@de ;
    sh:message "Représentation en temps réel d'un train comprenant la position, la vitesse, les caractéristiques et l'autorité de mouvement."@fr ;
    
    # Train Object Identifier (required, string - unique identifier)
    sh:property [ 
        sh:path era:trainObjectIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainObject must have exactly one trainObjectIdentifier (string, unique identifier)."@en ;
        sh:message "Jedes TrainObject muss genau eine trainObjectIdentifier (Zeichenfolge, eindeutige Kennung) haben."@de ;
        sh:message "Chaque TrainObject doit avoir exactement un trainObjectIdentifier (chaîne, identifiant unique)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # OBU Identifier (required, string - onboard unit ID)
    sh:property [ 
        sh:path era:obuIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainObject must have exactly one obuIdentifier (string, ETCS onboard unit identifier)."@en ;
        sh:message "Jedes TrainObject muss genau eine obuIdentifier (Zeichenfolge, ETCS-Bordgeräte-ID) haben."@de ;
        sh:message "Chaque TrainObject doit avoir exactement un obuIdentifier (chaîne, identifiant d'unité embarqué ETCS)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Running Number (required, string - operational train number)
    sh:property [ 
        sh:path era:trainRunningNumber ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainObject must have exactly one trainRunningNumber (string, operational train service number)."@en ;
        sh:message "Jedes TrainObject muss genau eine trainRunningNumber (Zeichenfolge, Betriebsnummer des Zugdienstes) haben."@de ;
        sh:message "Chaque TrainObject doit avoir exactement un trainRunningNumber (chaîne, numéro de service de train opérationnel)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Location (required, current position on network)
    sh:property [ 
        sh:path era:trainLocation ;
        sh:node era:NetLinearReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainObject must have exactly one trainLocation that conforms to NetLinearReference object. A proper NetLinearReference is needed"@en ;
        sh:message "Jedes TrainObject muss genau ein trainLocation haben, das dem NetLinearReference-Objekt entspricht. Es ist eine ordnungsgemäße NetLinearReference erforderlich"@de ;
        sh:message "Chaque TrainObject doit avoir exactement un trainLocation conforme à l'objet NetLinearReference. Une NetLinearReference appropriée est nécessaire"@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Length (required, unsigned integer - in meters)
    sh:property [ 
        sh:path era:trainLength ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainObject must have exactly one trainLength (unsigned integer, total train length in meters)."@en ;
        sh:message "Jedes TrainObject muss genau ein trainLength (vorzeichenlose Ganzzahl, Gesamtzuglänge in Metern) haben."@de ;
        sh:message "Chaque TrainObject doit avoir exactement un trainLength (entier non signé, longueur totale du train en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Safe Train Length (required, boolean - length integrity confirmed)
    sh:property [ 
        sh:path era:safeTrainLength ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainObject must have exactly one safeTrainLength (boolean, true if train integrity is confirmed)."@en ;
        sh:message "Jedes TrainObject muss genau ein safeTrainLength haben (boolean, true, wenn die Zugintegrität bestätigt wird)."@de ;
        sh:message "Chaque TrainObject doit avoir exactement un safeTrainLength (booléen, vrai si l'intégrité du train est confirmée)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Current Speed (required, unsigned integer - in km/h)
    sh:property [ 
        sh:path era:currentSpeed ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainObject must have exactly one currentSpeed (unsigned integer, current speed in km/h)."@en ;
        sh:message "Jedes TrainObject muss genau ein currentSpeed (vorzeichenlose Ganzzahl, aktuelle Geschwindigkeit in km/h) haben."@de ;
        sh:message "Chaque TrainObject doit avoir exactement un currentSpeed (entier non signé, vitesse actuelle en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # V Max Train (required, unsigned integer - maximum speed in km/h)
    sh:property [ 
        sh:path era:vMaxTrain ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainObject must have exactly one vMaxTrain (unsigned integer, train's maximum permitted speed in km/h)."@en ;
        sh:message "Jedes TrainObject muss genau ein vMaxTrain (vorzeichenlose Ganzzahl, maximal zulässige Geschwindigkeit des Zuges in km/h) haben."@de ;
        sh:message "Chaque TrainObject doit avoir exactement un vMaxTrain (entier non signé, vitesse maximale autorisée du train en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Axle Load Category (required, controlled vocabulary)
    sh:property [ 
        sh:path era:axleLoadCategory ;
        sh:in (
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_A>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_HS17>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B1>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_B2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_C4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D2>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D3>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_D4XL>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E4>
            <http://data.europa.eu/949/concepts/load-capability-line-categories/AL_E5>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property axleLoadCategory must have a value from the defined SKOS concept scheme (AL_A through AL_E5)."@en ;
        sh:message "Die Eigenschaft axleLoadCategory muss einen Wert aus dem definierten SKOS-Konzeptschema (AL_A bis AL_E5) haben."@de ;
        sh:message "La propriété axleLoadCategory doit avoir une valeur du schéma de concept SKOS défini (AL_A à AL_E5)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Cant Deficiency Category (required, controlled vocabulary)
    sh:property [ 
        sh:path era:cantDeficiencyCategory ;
        sh:in (
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_Undefined>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_80mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_100mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_130mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_150mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_165mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_180mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_210mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_225mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_245mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_275mm>
            <http://data.europa.eu/949/concepts/cant-deficiencies/CD_300mm>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property cantDeficiencyCategory must have a value from the defined SKOS concept scheme (CD_80mm through CD_300mm, or CD_Undefined)."@en ;
        sh:message "Die Eigenschaft cantDeficiencyCategory muss einen Wert aus dem definierten SKOS-Konzeptschema haben (CD_80mm bis CD_300mm oder CD_Undefiniert)."@de ;
        sh:message "La propriété cantDeficiencyCategory doit avoir une valeur du schéma de concept SKOS défini (CD_80mm à CD_300mm, ou CD_Undefined)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Onboard Operating Mode (required, controlled vocabulary - ETCS mode)
    sh:property [ 
        sh:path era:onboardOperatingMode ;
        sh:in (
            <http://data.europa.eu/949/concepts/onboard-operating-mode/undefined>
            <http://data.europa.eu/949/concepts/onboard-operating-mode/onSight>
            <http://data.europa.eu/949/concepts/onboard-operating-mode/fullSupervision>
            <http://data.europa.eu/949/concepts/onboard-operating-mode/standBy>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property onboardOperatingMode must have a value from the defined SKOS concept scheme (fullSupervision, onSight, standBy, or undefined)."@en ;
        sh:message "Die Eigenschaft onboardOperatingMode muss einen Wert aus dem definierten SKOS-Konzeptschema haben (fullSupervision, onSight, standBy oder undefiniert)."@de ;
        sh:message "La propriété onboardOperatingMode doit avoir une valeur du schéma de concept SKOS défini (fullSupervision, onSight, standBy ou non défini)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Communication Active (required, boolean - GSM-R connection status)
    sh:property [ 
        sh:path era:communicationActive ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainObject must have exactly one communicationActive (boolean, true if GSM-R communication is active)."@en ;
        sh:message "Jedes TrainObject muss genau ein communicationActive haben (boolean, true, wenn die GSM-R-Kommunikation aktiv ist)."@de ;
        sh:message "Chaque TrainObject doit avoir exactement un communicationActive (booléen, vrai si la communication GSM-R est active)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # MP Requested By Train (required, boolean - movement permission request status)
    sh:property [ 
        sh:path era:mpRequestedByTrain ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainObject must have exactly one mpRequestedByTrain (boolean, true if train has requested movement permission)."@en ;
        sh:message "Jedes TrainObject muss genau ein mpRequestedByTrain haben (boolean, true, wenn der Zug eine Bewegungserlaubnis angefordert hat)."@de ;
        sh:message "Chaque TrainObject doit avoir exactement un mpRequestedByTrain (booléen, vrai si le train a demandé l'autorisation de mouvement)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Movement Permission (optional, current movement authority)
    sh:property [ 
        sh:path era:movementPermission ;
        sh:node era:MovementPermissionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A TrainObject may have at most one movementPermission that conforms to MovementPermission object."@en ;
        sh:message "Ein TrainObject kann höchstens ein movementPermission haben, das dem MovementPermission-Objekt entspricht."@de ;
        sh:message "Un TrainObject peut avoir au plus un movementPermission conforme à l'objet MovementPermission."@fr ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Train Unit Activity Shape =====
era:TrainUnitActivityShape a sh:NodeShape ;
    sh:targetClass era:TrainUnitActivity ;
    sh:message "Describes a planned activity involving train units at a stop (joining, splitting, etc.)."@en ;
    sh:message "Beschreibt eine geplante Aktivität von Zugeinheiten an einer Haltestelle (Zusammenfügen, Aufteilen usw.)."@de ;
    sh:message "Décrit une activité planifiée impliquant des unités de train à l'arrêt (rejoindre, diviser, etc.)."@fr ;
    
    # Train Unit Activity Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:trainUnitActivityType ;
        sh:in (
            <http://data.europa.eu/949/concepts/train-unit-activity-type/joinActivity>
            <http://data.europa.eu/949/concepts/train-unit-activity-type/splitActivity>
            <http://data.europa.eu/949/concepts/train-unit-activity-type/collectActivity>
            <http://data.europa.eu/949/concepts/train-unit-activity-type/dropActivity>
            <http://data.europa.eu/949/concepts/train-unit-activity-type/turnAroundActivity>
            <http://data.europa.eu/949/concepts/train-unit-activity-type/meetActivity>
            <http://data.europa.eu/949/concepts/train-unit-activity-type/trainReplacementActivity>
            <http://data.europa.eu/949/concepts/train-unit-activity-type/otherActivity>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property trainUnitActivityType must have a value from the defined SKOS concept scheme (joinActivity, splitActivity, collectActivity, dropActivity, turnAroundActivity, meetActivity, trainReplacementActivity, or otherActivity)."@en ;
        sh:message "Die Eigenschaft trainUnitActivityType muss einen Wert aus dem definierten SKOS-Konzeptschema (joinActivity, splitActivity, collectActivity, dropActivity, turnAroundActivity, meetActivity, trainReplacementActivity oder otherActivity) haben."@de ;
        sh:message "La propriété trainUnitActivityType doit avoir une valeur du schéma conceptuel SKOS défini (joinActivity, splitActivity, collectActivity, dropActivity, turnAroundActivity, meetActivity, trainReplacementActivity ou otherActivity)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Actual Train Unit Index (required, unsigned integer - which unit in this train)
    sh:property [ 
        sh:path era:actualTrainUnitIndex ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitActivity must have exactly one actualTrainUnitIndex (unsigned integer, index of train unit performing activity)."@en ;
        sh:message "Jede TrainUnitActivity muss genau eine actualTrainUnitIndex (vorzeichenlose Ganzzahl, Index der Zugeinheit, die Aktivität ausführt) haben."@de ;
        sh:message "Chaque TrainUnitActivity doit avoir exactement un actualTrainUnitIndex (entier non signé, index de l'unité de train effectuant une activité)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Target Train Unit Index (required, unsigned integer - which unit is target)
    sh:property [ 
        sh:path era:targetTrainUnitIndex ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitActivity must have exactly one targetTrainUnitIndex (unsigned integer, index of target train unit)."@en ;
        sh:message "Jede TrainUnitActivity muss genau eine targetTrainUnitIndex (vorzeichenlose Ganzzahl, Index der Zielzugeinheit) haben."@de ;
        sh:message "Chaque TrainUnitActivity doit avoir exactement un targetTrainUnitIndex (entier non signé, index de l'unité de train cible)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Train Unit Report ATO Capabilities Shape =====
era:TrainUnitReportAtoCapabilitiesShape a sh:NodeShape ;
    sh:targetClass era:TrainUnitReportAtoCapabilities ;
    sh:message "Report of train unit capabilities for ATO operation including consist, mass, and ETCS data."@en ;
    sh:message "Bericht über die Fähigkeiten der Zugeinheit für den ATO-Betrieb, einschließlich Verbands-, Masse- und ETCS-Daten."@de ;
    sh:message "Rapport sur les capacités des unités de train pour l'exploitation des ATO, y compris les données de composition, de masse et ETCS."@fr ;
    
    # Train Unit Identifier (required)
    sh:property [ 
        sh:path era:trainUnitIdentifier ;
        sh:node era:PhysicalTrainUnitIdentifierShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoCapabilities must reference exactly one trainUnitIdentifier that conforms to PhysicalTrainUnitIdentifier object."@en ;
        sh:message "Jedes TrainUnitReportAtoCapabilities muss auf genau ein trainUnitIdentifier verweisen, das dem PhysicalTrainUnitIdentifier-Objekt entspricht."@de ;
        sh:message "Chaque TrainUnitReportAtoCapabilities doit faire référence à exactement un trainUnitIdentifier conforme à l'objet PhysicalTrainUnitIdentifier."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoCapabilities must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder TrainUnitReportAtoCapabilities muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque TrainUnitReportAtoCapabilities doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Mass (required, unsigned integer - total mass in tonnes)
    sh:property [ 
        sh:path era:mass ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoCapabilities must have exactly one mass (unsigned integer, total train mass in tonnes)."@en ;
        sh:message "Jeder TrainUnitReportAtoCapabilities muss genau eine Masse haben (vorzeichenlose Ganzzahl, Gesamtzugmasse in Tonnen)."@de ;
        sh:message "Chaque TrainUnitReportAtoCapabilities doit avoir exactement une masse (entier non signé, masse totale du train en tonnes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Passenger Load (required, unsigned integer - passenger count)
    sh:property [ 
        sh:path era:passengerLoad ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoCapabilities must have exactly one passengerLoad (unsigned integer, total number of passengers)."@en ;
        sh:message "Jedes TrainUnitReportAtoCapabilities muss genau eine passengerLoad (vorzeichenlose Ganzzahl, Gesamtzahl der Passagiere) haben."@de ;
        sh:message "Chaque TrainUnitReportAtoCapabilities doit avoir exactement un passengerLoad (entier non signé, nombre total de passagers)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Last Passenger Exchange Time (required, unsigned integer - in seconds)
    sh:property [ 
        sh:path era:lastPassengerExchangeTime ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoCapabilities must have exactly one lastPassengerExchangeTime (unsigned integer, seconds since last door operation)."@en ;
        sh:message "Jede TrainUnitReportAtoCapabilities muss genau eine lastPassengerExchangeTime haben (Ganzzahl ohne Vorzeichen, Sekunden seit dem letzten Türvorgang)."@de ;
        sh:message "Chaque TrainUnitReportAtoCapabilities doit avoir exactement un lastPassengerExchangeTime (entier non signé, secondes depuis la dernière opération de porte)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Elapsed Start Passenger Exchange (required, unsigned integer - in seconds)
    sh:property [ 
        sh:path era:elapsedStartPassengerExchange ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoCapabilities must have exactly one elapsedStartPassengerExchange (unsigned integer, seconds elapsed since passenger exchange started)."@en ;
        sh:message "Jedes TrainUnitReportAtoCapabilities muss genau eine elapsedStartPassengerExchange haben (Ganzzahl ohne Vorzeichen, verstrichene Sekunden seit Beginn des Passagieraustauschs)."@de ;
        sh:message "Chaque TrainUnitReportAtoCapabilities doit avoir exactement un elapsedStartPassengerExchange (entier non signé, secondes écoulées depuis le début de l'échange de passagers)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Outside Temperature (required, integer - in degrees Celsius)
    sh:property [ 
        sh:path era:outsideTemperature ;
        sh:datatype xsd:int ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoCapabilities must have exactly one outsideTemperature (integer, ambient temperature in degrees Celsius)."@en ;
        sh:message "Jede TrainUnitReportAtoCapabilities muss genau eine outsideTemperature (Ganzzahl, Umgebungstemperatur in Grad Celsius) haben."@de ;
        sh:message "Chaque TrainUnitReportAtoCapabilities doit avoir exactement un outsideTemperature (entier, température ambiante en degrés Celsius)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Physical Consists (optional, RDF list - max 255 consists)
    sh:property [ 
        sh:path era:physicalConsists ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A TrainUnitReportAtoCapabilities may have at most one physicalConsists property pointing to an RDF list (max 255 consists)."@en ;
        sh:message "Ein TrainUnitReportAtoCapabilities darf höchstens eine physicalConsists-Eigenschaft haben, die auf eine RDF-Liste verweist (maximal 255 besteht)."@de ;
        sh:message "Un TrainUnitReportAtoCapabilities peut avoir au plus une propriété physicalConsists pointant vers une liste RDF (maximum 255)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate physical consists list
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "The physicalConsists list must contain at most 255 consist entries."@en ;
        sh:message "Die physicalConsists-Liste darf höchstens 255 Verbundeinträge enthalten."@de ;
        sh:message "La liste physicalConsists doit contenir au maximum 255 entrées de composition."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:physicalConsists ?list .
                {
                    SELECT $this (COUNT(?item) AS ?count)
                    WHERE {
                        $this era:physicalConsists ?list .
                        ?list rdf:rest*/rdf:first ?item .
                    }
                    GROUP BY $this
                    HAVING (?count > 255)
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all consists are PhysicalConsist instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the physicalConsists list must be instances of era:PhysicalConsist that conform to PhysicalConsistShape."@en ;
        sh:message "Alle Elemente in der Liste physicalConsists müssen Instanzen von era:PhysicalConsist sein, die PhysicalConsistShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste physicalConsists doivent être des instances de era:PhysicalConsist conformes à PhysicalConsistShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:physicalConsists ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                FILTER NOT EXISTS { ?item a era:PhysicalConsist }
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # ETCS Data (optional, ETCS/ATO configuration)
    sh:property [ 
        sh:path era:etcsData ;
        sh:node era:EtcsDataAtoShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A TrainUnitReportAtoCapabilities may have at most one etcsData that conforms to EtcsDataAto object."@en ;
        sh:message "Ein TrainUnitReportAtoCapabilities kann höchstens ein etcsData haben, das dem EtcsDataAto-Objekt entspricht."@de ;
        sh:message "Un TrainUnitReportAtoCapabilities peut avoir au plus un etcsData conforme à l'objet EtcsDataAto."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Additional Train Data (optional, supplementary information)
    sh:property [ 
        sh:path era:additionalTrainData ;
        sh:node era:AdditionalTrainDataShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A TrainUnitReportAtoCapabilities may have at most one additionalTrainData that conforms to AdditionalTrainData object."@en ;
        sh:message "Ein TrainUnitReportAtoCapabilities darf höchstens ein additionalTrainData haben, das dem AdditionalTrainData-Objekt entspricht."@de ;
        sh:message "Un TrainUnitReportAtoCapabilities peut avoir au plus un additionalTrainData conforme à l'objet AdditionalTrainData."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Movement (optional, associated plan)
    sh:property [ 
        sh:path era:operationalPlanMovement ;
        sh:class era:OperationalPlanMovement ;
		sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "A TrainUnitReportAtoCapabilities may reference at most one operationalPlanMovement that conforms to OperationalPlanMovement object."@en ;
        sh:message "Ein TrainUnitReportAtoCapabilities kann höchstens ein operationalPlanMovement referenzieren, das dem OperationalPlanMovement-Objekt entspricht."@de ;
        sh:message "Un TrainUnitReportAtoCapabilities peut référencer au plus un operationalPlanMovement conforme à l'objet OperationalPlanMovement."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Train Unit Report ATO Status Shape =====
era:TrainUnitReportAtoStatusShape a sh:NodeShape ;
    sh:targetClass era:TrainUnitReportAtoStatus ;
    sh:message "Real-time status report from ATO system including position, speed, state, and event estimations."@en ;
    sh:message "Echtzeit-Statusbericht vom ATO-System, einschließlich Positions-, Geschwindigkeits-, Zustands- und Ereignisschätzungen."@de ;
    sh:message "Rapport d'état en temps réel du système ATO comprenant des estimations de position, de vitesse, d'état et d'événements."@fr ;
    
    # Train Unit Identifier (required)
    sh:property [ 
        sh:path era:trainUnitIdentifier ;
        sh:node era:PhysicalTrainUnitIdentifierShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must reference exactly one trainUnitIdentifier that conforms to PhysicalTrainUnitIdentifier object."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss auf genau einen trainUnitIdentifier verweisen, der dem PhysicalTrainUnitIdentifier-Objekt entspricht."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit faire référence à exactement un trainUnitIdentifier conforme à l'objet PhysicalTrainUnitIdentifier."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Front Position (required, train front location)
    sh:property [ 
        sh:path era:frontPosition ;
        sh:node era:NetPointReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one frontPosition that conforms to NetPointReference object. A proper NetPointReference is needed"@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau ein frontPosition haben, das dem NetPointReference-Objekt entspricht. Es ist eine ordnungsgemäße NetPointReference erforderlich"@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement un frontPosition conforme à l'objet NetPointReference. Une NetPointReference appropriée est nécessaire"@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Length (required, unsigned integer - in meters)
    sh:property [ 
        sh:path era:trainLength ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one trainLength (unsigned integer, in meters)."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau eine trainLength (vorzeichenlose Ganzzahl in Metern) haben."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement un trainLength (entier non signé, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Speed (required, unsigned integer - in km/h)
    sh:property [ 
        sh:path era:speed ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one speed (unsigned integer, current speed in km/h)."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau eine Geschwindigkeit haben (vorzeichenlose Ganzzahl, aktuelle Geschwindigkeit in km/h)."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement une vitesse (entier non signé, vitesse actuelle en km/h)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # ATO State (required, controlled vocabulary)
    sh:property [ 
        sh:path era:atoState ;
        sh:in (
            <http://data.europa.eu/949/concepts/ato-state/unknown>
            <http://data.europa.eu/949/concepts/ato-state/CO>
            <http://data.europa.eu/949/concepts/ato-state/NA>
            <http://data.europa.eu/949/concepts/ato-state/AV>
            <http://data.europa.eu/949/concepts/ato-state/RE>
            <http://data.europa.eu/949/concepts/ato-state/EG>
            <http://data.europa.eu/949/concepts/ato-state/DE>
            <http://data.europa.eu/949/concepts/ato-state/FA>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property atoState must have a value from the defined SKOS concept scheme (CO, NA, AV, RE, EG, DE, FA, or unknown)."@en ;
        sh:message "Die Eigenschaft atoState muss einen Wert aus dem definierten SKOS-Konzeptschema haben (CO, NA, AV, RE, EG, DE, FA oder unbekannt)."@de ;
        sh:message "La propriété atoState doit avoir une valeur du schéma de concept SKOS défini (CO, NA, AV, RE, EG, DE, FA ou inconnu)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Is Moving (required, boolean)
    sh:property [ 
        sh:path era:isMoving ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one isMoving (boolean, true if train is in motion)."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau einen isMoving haben (boolean, true, wenn der Zug in Bewegung ist)."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement un isMoving (booléen, vrai si le train est en mouvement)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Is Slipping (required, boolean)
    sh:property [ 
        sh:path era:isSlipping ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one isSlipping (boolean, true if wheel slip detected)."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau einen isSlipping haben (boolean, true, wenn Radschlupf erkannt wird)."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement un isSlipping (booléen, vrai si un patinage des roues est détecté)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Low Adhesion Reported By Driver (required, boolean)
    sh:property [ 
        sh:path era:lowAdhesionReportedByDriver ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one lowAdhesionReportedByDriver (boolean, true if driver reported slippery conditions)."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau einen lowAdhesionReportedByDriver haben (boolean, true, wenn der Fahrer rutschige Bedingungen gemeldet hat)."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement un lowAdhesionReportedByDriver (booléen, vrai si le conducteur a signalé des conditions glissantes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Conditions Fulfillment (required, boolean)
    sh:property [ 
        sh:path era:operationalConditionsFulfillment ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one operationalConditionsFulfillment (boolean, true if all operational conditions met)."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau einen operationalConditionsFulfillment haben (boolean, true, wenn alle Betriebsbedingungen erfüllt sind)."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement un operationalConditionsFulfillment (booléen, vrai si toutes les conditions opérationnelles sont remplies)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Next Stopping Point Skip (required, boolean)
    sh:property [ 
        sh:path era:nextStoppingPointSkip ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one nextStoppingPointSkip (boolean, true if next scheduled stop will be skipped)."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau einen nextStoppingPointSkip haben (boolean, true, wenn der nächste geplante Stopp übersprungen wird)."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement un nextStoppingPointSkip (booléen, vrai si le prochain arrêt prévu sera ignoré)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Unable To Stop At Next Stopping Point (required, boolean)
    sh:property [ 
        sh:path era:unableToStopAtNextStoppingPoint ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one unableToStopAtNextStoppingPoint (boolean, true if unable to stop as planned)."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau einen unableToStopAtNextStoppingPoint haben (boolean, true, wenn er nicht wie geplant anhalten kann)."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement un unableToStopAtNextStoppingPoint (booléen, vrai s'il est impossible de s'arrêter comme prévu)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Routing Error (required, boolean)
    sh:property [ 
        sh:path era:routingError ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportAtoStatus must have exactly one routingError (boolean, true if train is on wrong route)."@en ;
        sh:message "Jeder TrainUnitReportAtoStatus muss genau einen routingError haben (boolean, true, wenn der Zug auf der falschen Route ist)."@de ;
        sh:message "Chaque TrainUnitReportAtoStatus doit avoir exactement un routingError (booléen, vrai si le train suit un mauvais itinéraire)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Driver ID (optional, string)
    sh:property [ 
        sh:path era:driverId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A TrainUnitReportAtoStatus may have at most one driverId (string, identifier of current driver)."@en ;
        sh:message "Ein TrainUnitReportAtoStatus darf höchstens einen driverId (String, Kennung des aktuellen Treibers) haben."@de ;
        sh:message "Un TrainUnitReportAtoStatus peut avoir au plus un driverId (chaîne, identifiant du conducteur actuel)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Event Estimations (optional, RDF list)
    sh:property [ 
        sh:path era:eventEstimations ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A TrainUnitReportAtoStatus may have at most one eventEstimations property pointing to an RDF list."@en ;
        sh:message "Ein TrainUnitReportAtoStatus darf höchstens eine eventEstimations-Eigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Un TrainUnitReportAtoStatus peut avoir au plus une propriété eventEstimations pointant vers une liste RDF."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate event estimations list items
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the eventEstimations list must be instances of era:EventEstimation that conform to EventEstimationShape."@en ;
        sh:message "Alle Elemente in der Liste eventEstimations müssen Instanzen von era:EventEstimation sein, die EventEstimationShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste eventEstimations doivent être des instances de era:EventEstimation conformes à EventEstimationShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:eventEstimations ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                FILTER NOT EXISTS { ?item a era:EventEstimation }
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # Event Handling (optional, current event handling)
    sh:property [ 
        sh:path era:eventHandling ;
        sh:node era:EventHandlingShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A TrainUnitReportAtoStatus may have at most one eventHandling that conforms to EventHandling object."@en ;
        sh:message "Ein TrainUnitReportAtoStatus kann höchstens ein eventHandling haben, das dem EventHandling-Objekt entspricht."@de ;
        sh:message "Un TrainUnitReportAtoStatus peut avoir au plus un eventHandling conforme à l'objet EventHandling."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Movement (optional, associated plan)
    sh:property [ 
        sh:path era:operationalPlanMovement ;
        sh:class era:OperationalPlanMovement ;
		sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "A TrainUnitReportAtoStatus may reference at most one operationalPlanMovement that conforms to OperationalPlanMovement object."@en ;
        sh:message "Ein TrainUnitReportAtoStatus kann höchstens einen operationalPlanMovement referenzieren, der dem OperationalPlanMovement-Objekt entspricht."@de ;
        sh:message "Un TrainUnitReportAtoStatus peut référencer au plus un operationalPlanMovement conforme à l'objet OperationalPlanMovement."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Train Unit Report PE Shape =====
era:TrainUnitReportPEShape a sh:NodeShape ;
    sh:targetClass era:TrainUnitReportPE ;
    sh:message "Train unit report for Position Estimation providing current train object state."@en ;
    sh:message "Zugeinheitsbericht zur Positionsschätzung mit aktuellem Zustand des Zugobjekts."@de ;
    sh:message "Rapport d'unité de train pour l'estimation de position fournissant l'état actuel de l'objet de train."@fr ;
    
    # CMD Train Object (required, train object data)
    sh:property [ 
        sh:path era:cmdTrainObject ;
        sh:node era:TrainObjectShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportPE must have exactly one cmdTrainObject that conforms to TrainObject object."@en ;
        sh:message "Jedes TrainUnitReportPE muss genau ein cmdTrainObject haben, das dem TrainObject-Objekt entspricht."@de ;
        sh:message "Chaque TrainUnitReportPE doit avoir exactement un cmdTrainObject conforme à l'objet TrainObject."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnitReportPE must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder TrainUnitReportPE muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque TrainUnitReportPE doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Movement (optional, associated plan)
    sh:property [ 
        sh:path era:operationalPlanMovement ;
        sh:class era:OperationalPlanMovement ;
		sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "A TrainUnitReportPE may reference at most one operationalPlanMovement that conforms to OperationalPlanMovement object."@en ;
        sh:message "Ein TrainUnitReportPE kann höchstens auf ein operationalPlanMovement verweisen, das dem OperationalPlanMovement-Objekt entspricht."@de ;
        sh:message "Un TrainUnitReportPE peut référencer au plus un operationalPlanMovement conforme à l'objet OperationalPlanMovement."@fr ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Train Unit Shape =====
era:TrainUnitShape a sh:NodeShape ;
    sh:targetClass era:TrainUnit ;
    sh:message "Defines an operational train unit including braking characteristics, consist, and categorization."@en ;
    sh:message "Definiert eine betriebsbereite Zugeinheit einschließlich Bremseigenschaften, Zusammensetzung und Kategorisierung."@de ;
    sh:message "Définit une unité de train opérationnelle comprenant les caractéristiques de freinage, la composition et la catégorisation."@fr ;
    
    # Physical Train Unit (required, identifier)
    sh:property [ 
        sh:path era:physicalTrainUnit ;
        sh:node era:PhysicalTrainUnitIdentifierShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnit must reference exactly one physicalTrainUnit that conforms to PhysicalTrainUnitIdentifier object."@en ;
        sh:message "Jede TrainUnit muss genau einen physicalTrainUnit referenzieren, der dem PhysicalTrainUnitIdentifier-Objekt entspricht."@de ;
        sh:message "Chaque TrainUnit doit faire référence à exactement un physicalTrainUnit conforme à l'objet PhysicalTrainUnitIdentifier."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Train Category (required)
    sh:property [ 
        sh:path era:operationalTrainCategory ;
        sh:node era:OperationalTrainCategoryShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnit must reference exactly one operationalTrainCategory that conforms to OperationalTrainCategory object."@en ;
        sh:message "Jede TrainUnit muss genau einen operationalTrainCategory referenzieren, der dem OperationalTrainCategory-Objekt entspricht."@de ;
        sh:message "Chaque TrainUnit doit faire référence à exactement un operationalTrainCategory conforme à l'objet OperationalTrainCategory."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Scheduled Train Length (required, unsigned integer - in meters)
    sh:property [ 
        sh:path era:scheduledTrainLength ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnit must have exactly one scheduledTrainLength (unsigned integer, planned train length in meters)."@en ;
        sh:message "Jede TrainUnit muss genau eine scheduledTrainLength (vorzeichenlose Ganzzahl, geplante Zuglänge in Metern) haben."@de ;
        sh:message "Chaque TrainUnit doit avoir exactement un scheduledTrainLength (entier non signé, longueur prévue du train en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Nominal Rotating Mass (required, unsigned integer - in tonnes)
    sh:property [ 
        sh:path era:nominalRotatingMass ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnit must have exactly one nominalRotatingMass (unsigned integer, equivalent rotating mass in tonnes)."@en ;
        sh:message "Jede TrainUnit muss genau eine nominalRotatingMass (vorzeichenlose Ganzzahl, äquivalente rotierende Masse in Tonnen) haben."@de ;
        sh:message "Chaque TrainUnit doit avoir exactement un nominalRotatingMass (entier non signé, masse tournante équivalente en tonnes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Brake Model Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:brakeModelType ;
        sh:in (
            <http://data.europa.eu/949/concepts/brake-model-type/lambda>
            <http://data.europa.eu/949/concepts/brake-model-type/gamma>
            <http://data.europa.eu/949/concepts/brake-model-type/undefined>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property brakeModelType must have a value from the defined SKOS concept scheme (lambda, gamma, or undefined)."@en ;
        sh:message "Die Eigenschaft brakeModelType muss einen Wert aus dem definierten SKOS-Konzeptschema haben (Lambda, Gamma oder undefiniert)."@de ;
        sh:message "La propriété brakeModelType doit avoir une valeur du schéma de concept SKOS défini (lambda, gamma ou non défini)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Brake Position (required, controlled vocabulary)
    sh:property [ 
        sh:path era:brakePosition ;
        sh:in (
            <http://data.europa.eu/949/concepts/brake-position/passengerTrainInP>
            <http://data.europa.eu/949/concepts/brake-position/passengerTrainInR>
            <http://data.europa.eu/949/concepts/brake-position/freightTrainInP>
            <http://data.europa.eu/949/concepts/brake-position/freightTrainInG>
            <http://data.europa.eu/949/concepts/brake-position/brakePositionUnknown>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property brakePosition must have a value from the defined SKOS concept scheme (passengerTrainInP, passengerTrainInR, freightTrainInP, freightTrainInG, or brakePositionUnknown)."@en ;
        sh:message "Die Eigenschaft brakePosition muss einen Wert aus dem definierten SKOS-Konzeptschema haben (passengerTrainInP, passengerTrainInR, freightTrainInP, freightTrainInG oder brakePositionUnbekannt)."@de ;
        sh:message "La propriété brakePosition doit avoir une valeur du schéma de concept SKOS défini (passengerTrainInP, passengerTrainInR, freightTrainInP, freightTrainInG ou brakePositionInconnu)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Regular Brake Weight Percentage (required, unsigned integer - Lambda percentage)
    sh:property [ 
        sh:path era:regularBrakeWeightPercentage ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnit must have exactly one regularBrakeWeightPercentage (unsigned integer, Lambda braking percentage for service brake)."@en ;
        sh:message "Jede TrainUnit muss genau eine regularBrakeWeightPercentage (vorzeichenlose Ganzzahl, Lambda-Bremsprozentsatz für die Betriebsbremse) haben."@de ;
        sh:message "Chaque TrainUnit doit avoir exactement un regularBrakeWeightPercentage (entier non signé, pourcentage de freinage Lambda pour le frein de service)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Emergency Brake Weight Percentage (required, unsigned integer - Lambda percentage)
    sh:property [ 
        sh:path era:emergencyBrakeWeightPercentage ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnit must have exactly one emergencyBrakeWeightPercentage (unsigned integer, Lambda braking percentage for emergency brake)."@en ;
        sh:message "Jede TrainUnit muss genau eine emergencyBrakeWeightPercentage (vorzeichenlose Ganzzahl, Lambda-Bremsprozentsatz für Notbremsung) haben."@de ;
        sh:message "Chaque TrainUnit doit avoir exactement un emergencyBrakeWeightPercentage (entier non signé, pourcentage de freinage Lambda pour le freinage d'urgence)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # ATO Grade Automation (required, controlled vocabulary - GoA levels)
    sh:property [ 
        sh:path era:atoGradeAutomation ;
        sh:in (
            <http://data.europa.eu/949/concepts/ato-grades-automation/GoAUnknown>
            <http://data.europa.eu/949/concepts/ato-grades-automation/GoA1>
            <http://data.europa.eu/949/concepts/ato-grades-automation/GoA2>
            <http://data.europa.eu/949/concepts/ato-grades-automation/GoA3>
            <http://data.europa.eu/949/concepts/ato-grades-automation/GoA4>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property atoGradeAutomation must have a value from the defined SKOS concept scheme (GoA1, GoA2, GoA3, GoA4, or GoAUnknown)."@en ;
        sh:message "Die Eigenschaft atoGradeAutomation muss einen Wert aus dem definierten SKOS-Konzeptschema (GoA1, GoA2, GoA3, GoA4 oder GoAUnknown) haben."@de ;
        sh:message "La propriété atoGradeAutomation doit avoir une valeur du schéma de concept SKOS défini (GoA1, GoA2, GoA3, GoA4 ou GoAUnknown)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Consists (required, RDF list - at least 1 consist)
    sh:property [ 
        sh:path era:operationalConsists ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TrainUnit must have exactly one operationalConsists property pointing to an RDF list with at least 1 consist."@en ;
        sh:message "Jede TrainUnit muss genau eine operationalConsists-Eigenschaft haben, die auf eine RDF-Liste mit mindestens 1 Inhalt verweist."@de ;
        sh:message "Chaque TrainUnit doit avoir exactement une propriété operationalConsists pointant vers une liste RDF avec au moins 1 consist."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate list has at least 1 item
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "The operationalConsists list must contain at least 1 OperationalConsist item."@en ;
        sh:message "Die Liste operationalConsists muss mindestens 1 OperationalConsist-Element enthalten."@de ;
        sh:message "La liste operationalConsists doit contenir au moins un élément OperationalConsist."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:operationalConsists ?list .
                
                # Check if list is empty or has no items
                FILTER NOT EXISTS {
                    ?list rdf:rest*/rdf:first ?item .
                    ?item a era:OperationalConsist .
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Warning Area Shape =====
era:WarningAreaShape a sh:NodeShape ;
    sh:targetClass era:WarningArea ;
    sh:message "Defines a geographical area where warning measures are active (low adhesion, track conditions, etc.)."@en ;
    sh:message "Definiert einen geografischen Bereich, in dem Warnmaßnahmen aktiv sind (geringe Haftung, Streckenbedingungen usw.)."@de ;
    sh:message "Définit une zone géographique où les mesures d'alerte sont actives (faible adhérence, état de la piste, etc.)."@fr ;
    
    # Track Area (required, where warnings apply)
    sh:property [ 
        sh:path era:trackArea ;
        sh:node era:NetAreaReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each WarningArea must reference exactly one trackArea that conforms to NetAreaReference object."@en ;
        sh:message "Jede WarningArea muss auf genau ein trackArea verweisen, das dem NetAreaReference-Objekt entspricht."@de ;
        sh:message "Chaque WarningArea doit faire référence à exactement un trackArea conforme à l'objet NetAreaReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Warning Devices (required, at least one device)
    sh:property [ 
        sh:path era:warningDevices ;
        sh:node era:WarningDeviceShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each WarningArea must have at least one warningDevices that conform to WarningDevice object."@en ;
        sh:message "Jede WarningArea muss mindestens ein warningDevices haben, das dem WarningDevice-Objekt entspricht."@de ;
        sh:message "Chaque WarningArea doit avoir au moins un warningDevices conforme à l'objet WarningDevice."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Warning Area State Shape =====
era:WarningAreaStateShape a sh:NodeShape ;
    sh:targetClass era:WarningAreaState ;
    sh:message "Records the state change of a warning area at a specific time (created, updated, or removed)."@en ;
    sh:message "Zeichnet die Zustandsänderung eines Warnbereichs zu einem bestimmten Zeitpunkt auf (erstellt, aktualisiert oder entfernt)."@de ;
    sh:message "Enregistre le changement d'état d'une zone d'avertissement à un moment précis (créé, mis à jour ou supprimé)."@fr ;
    
    # Warning State (required, controlled vocabulary)
    sh:property [ 
        sh:path era:warningState ;
        sh:in (
            <http://data.europa.eu/949/concepts/event-state/created>
            <http://data.europa.eu/949/concepts/event-state/updated>
            <http://data.europa.eu/949/concepts/event-state/removed>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property warningState must have a value from the defined SKOS concept scheme (created, updated, or removed)."@en ;
        sh:message "Die Eigenschaft warningState muss einen Wert aus dem definierten SKOS-Konzeptschema haben (erstellt, aktualisiert oder entfernt)."@de ;
        sh:message "La propriété warningState doit avoir une valeur du schéma de concept SKOS défini (créé, mis à jour ou supprimé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each WarningAreaState must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder WarningAreaState muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque WarningAreaState doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Warning Area (optional, reference to the area)
    sh:property [ 
        sh:path era:warningArea ;
        sh:node era:WarningAreaShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A WarningAreaState may reference at most one warningArea that conforms to WarningArea object."@en ;
        sh:message "Ein WarningAreaState kann höchstens auf ein warningArea verweisen, das dem WarningArea-Objekt entspricht."@de ;
        sh:message "Un WarningAreaState peut faire référence à au plus un warningArea conforme à l'objet WarningArea."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Warning Measure Event (optional, associated event)
    sh:property [ 
        sh:path era:warningMeasureEvent ;
        sh:class era:WarningMeasureEvent ;
		sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "A WarningAreaState may reference at most one warningMeasureEvent that conforms to WarningMeasureEvent object."@en ;
        sh:message "Ein WarningAreaState kann höchstens auf einen warningMeasureEvent verweisen, der dem WarningMeasureEvent-Objekt entspricht."@de ;
        sh:message "Un WarningAreaState peut faire référence à au plus un warningMeasureEvent conforme à l'objet WarningMeasureEvent."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Warning Device Shape =====
era:WarningDeviceShape a sh:NodeShape ;
    sh:targetClass era:WarningDevice ;
    sh:message "Defines a warning device that alerts drivers to conditions (acoustic, optical, or haptic indicators)."@en ;
    sh:message "Definiert ein Warngerät, das Fahrer auf Bedingungen aufmerksam macht (akustische, optische oder haptische Indikatoren)."@de ;
    sh:message "Définit un dispositif d'avertissement qui alerte les conducteurs des conditions (indicateurs acoustiques, optiques ou haptiques)."@fr ;
    
    # Device Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:deviceType ;
        sh:in (
            <http://data.europa.eu/949/concepts/device-type/acousticalIndicator>
            <http://data.europa.eu/949/concepts/device-type/opticalIndicator>
            <http://data.europa.eu/949/concepts/device-type/hapticIndicator>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property deviceType must have a value from the defined SKOS concept scheme (acousticalIndicator, opticalIndicator, or hapticIndicator)."@en ;
        sh:message "Die Eigenschaft deviceType muss einen Wert aus dem definierten SKOS-Konzeptschema (acousticalIndicator, opticalIndicator oder hapticIndicator) haben."@de ;
        sh:message "La propriété deviceType doit avoir une valeur du schéma de concept SKOS défini (acousticalIndicator, opticalIndicator ou hapticIndicator)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Warning Measure Event Execution Report Shape =====
era:WarningMeasureEventExecutionReportShape a sh:NodeShape ;
    sh:targetClass era:WarningMeasureEventExecutionReport ;
    sh:message "Report documenting the execution result of a warning measure event (creation or removal of warnings)."@en ;
    sh:message "Bericht, der das Ausführungsergebnis eines Warnmaßnahmenereignisses (Erstellen oder Entfernen von Warnungen) dokumentiert."@de ;
    sh:message "Rapport documentant le résultat de l'exécution d'un événement de mesure d'avertissement (création ou suppression d'avertissements)."@fr ;
    
    # Warning Measure Event (required, reference to the event)
    sh:property [ 
        sh:path era:warningMeasureEvent ;
        sh:class era:WarningMeasureEvent ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each WarningMeasureEventExecutionReport must reference exactly one warningMeasureEvent that conforms to WarningMeasureEvent object."@en ;
        sh:message "Jeder WarningMeasureEventExecutionReport muss auf genau ein warningMeasureEvent verweisen, das dem WarningMeasureEvent-Objekt entspricht."@de ;
        sh:message "Chaque WarningMeasureEventExecutionReport doit faire référence à exactement un warningMeasureEvent conforme à l'objet WarningMeasureEvent."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Plan Issued At (required, dateTime)
    sh:property [ 
        sh:path era:operationalPlanIssuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each WarningMeasureEventExecutionReport must have exactly one operationalPlanIssuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder WarningMeasureEventExecutionReport muss genau einen operationalPlanIssuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque WarningMeasureEventExecutionReport doit avoir exactement un horodatage operationalPlanIssuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Execution State (required, controlled vocabulary)
    sh:property [ 
        sh:path era:executionState ;
        sh:in (
            <http://data.europa.eu/949/concepts/event-execution-state/eventCompleted>
            <http://data.europa.eu/949/concepts/event-execution-state/eventFailed>
            <http://data.europa.eu/949/concepts/event-execution-state/eventWarning>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property executionState must have a value from the defined SKOS concept scheme (eventCompleted, eventFailed, or eventWarning)."@en ;
        sh:message "Die Eigenschaft executionState muss einen Wert aus dem definierten SKOS-Konzeptschema (eventCompleted, eventFailed oder eventWarning) haben."@de ;
        sh:message "La propriété executionState doit avoir une valeur du schéma de concept SKOS défini (eventCompleted, eventFailed ou eventWarning)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Issued At (required, dateTime)
    sh:property [ 
        sh:path era:issuedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each WarningMeasureEventExecutionReport must have exactly one issuedAt timestamp (xsd:dateTime)."@en ;
        sh:message "Jeder WarningMeasureEventExecutionReport muss genau einen issuedAt-Zeitstempel (xsd:dateTime) haben."@de ;
        sh:message "Chaque WarningMeasureEventExecutionReport doit avoir exactement un horodatage issuedAt (xsd:dateTime)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Failure Reason (optional, string)
    sh:property [ 
        sh:path era:failureReason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A WarningMeasureEventExecutionReport may have at most one failureReason (string, required if executionState is eventFailed)."@en ;
        sh:message "Ein WarningMeasureEventExecutionReport darf höchstens eine failureReason (Zeichenfolge, erforderlich, wenn executionState eventFailed ist) haben."@de ;
        sh:message "Un WarningMeasureEventExecutionReport peut avoir au plus un failureReason (chaîne, obligatoire si executionState est eventFailed)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Warning (optional, string)
    sh:property [ 
        sh:path era:warning ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A WarningMeasureEventExecutionReport may have at most one warning (string, required if executionState is eventWarning)."@en ;
        sh:message "Ein WarningMeasureEventExecutionReport kann höchstens eine Warnung enthalten (Zeichenfolge, erforderlich, wenn executionState eventWarning ist)."@de ;
        sh:message "Un WarningMeasureEventExecutionReport peut contenir au plus un avertissement (chaîne, obligatoire si executionState est eventWarning)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Warning Measure Event Shape =====
era:WarningMeasureEventShape a sh:NodeShape ;
    sh:targetClass era:WarningMeasureEvent ;
    sh:message "Defines a scheduled event for creating or removing warning measures."@en ;
    sh:message "Definiert ein geplantes Ereignis zum Erstellen oder Entfernen von Warnmaßnahmen."@de ;
    sh:message "Définit un événement planifié pour créer ou supprimer des mesures d'avertissement."@fr ;
    
    # Warning Area (required, where warning applies)
    sh:property [ 
        sh:path era:warningArea ;
        sh:node era:WarningAreaShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each WarningMeasureEvent must reference exactly one warningArea that conforms to WarningArea object."@en ;
        sh:message "Jedes WarningMeasureEvent muss auf genau ein warningArea verweisen, das dem WarningArea-Objekt entspricht."@de ;
        sh:message "Chaque WarningMeasureEvent doit faire référence à exactement un warningArea conforme à l'objet WarningArea."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Creation Time (required, dateTime)
    sh:property [ 
        sh:path era:creationTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each WarningMeasureEvent must have exactly one creationTime (xsd:dateTime, when warning becomes active)."@en ;
        sh:message "Jedes WarningMeasureEvent muss genau ein creationTime haben (xsd:dateTime, wenn die Warnung aktiv wird)."@de ;
        sh:message "Chaque WarningMeasureEvent doit avoir exactement un creationTime (xsd:dateTime, lorsque l'avertissement devient actif)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Removal Time (required, dateTime)
    sh:property [ 
        sh:path era:removalTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each WarningMeasureEvent must have exactly one removalTime (xsd:dateTime, when warning is removed)."@en ;
        sh:message "Jedes WarningMeasureEvent muss genau ein removalTime haben (xsd:dateTime, wenn die Warnung entfernt wird)."@de ;
        sh:message "Chaque WarningMeasureEvent doit avoir exactement un removalTime (xsd:dateTime, lorsque l'avertissement est supprimé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Starts After Events (optional, prerequisite events)
    sh:property [ 
        sh:path era:startsAfterEvents ;
        sh:node era:OperationalEventRefShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A WarningMeasureEvent may reference multiple startsAfterEvents that must complete before this warning is activated. Properly constituted OperationalEventRef objects should be referenced."@en ;
        sh:message "Ein WarningMeasureEvent kann auf mehrere startsAfterEvents verweisen, die abgeschlossen sein müssen, bevor diese Warnung aktiviert wird. Auf ordnungsgemäß konstituierte OperationalEventRef-Objekte sollte verwiesen werden."@de ;
        sh:message "Un WarningMeasureEvent peut faire référence à plusieurs startsAfterEvents qui doivent se terminer avant que cet avertissement ne soit activé. Les objets OperationalEventRef correctement constitués doivent être référencés."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	

# ===== Net Area Reference Shape =====
era:NetAreaReferenceShape a sh:NodeShape ;
    sh:targetClass era:NetAreaReference ;
    
    # Includes (required, RDF list of net linear references)
    sh:property [ 
        sh:path era:includes ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetAreaReference must have exactly one includes property pointing to an RDF list."@en ;
        sh:message "Jede NetAreaReference muss genau eine Includes-Eigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Chaque NetAreaReference doit avoir exactement une propriété include pointant vers une liste RDF."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate list has at least 1 item
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "The includes list must contain at least 1 item."@en ;
        sh:message "Die Includes-Liste muss mindestens 1 Element enthalten."@de ;
        sh:message "La liste des inclusions doit contenir au moins 1 élément."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:includes ?list .
                
                # Count items in the list
                {
                    SELECT $this (COUNT(?item) AS ?count)
                    WHERE {
                        $this era:includes ?list .
                        ?list rdf:rest*/rdf:first ?item .
                    }
                    GROUP BY $this
                }
                
                # Violation if count is less than 1
                FILTER (?count < 1)
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    # SPARQL constraint to validate all list items are NetLinearReference instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the includes list must be instances of era:NetLinearReference that conform to NetLinearReferenceShape."@en ;
        sh:message "Alle Elemente in der Includes-Liste müssen Instanzen von era:NetLinearReference sein, die NetLinearReferenceShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste d'inclusion doivent être des instances de era:NetLinearReference conformes à NetLinearReferenceShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:includes ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                # Violation if item is not a NetLinearReference
                FILTER NOT EXISTS { ?item a era:NetLinearReference }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .

# ===== Net Linear Reference Shape =====
era:NetLinearReferenceShape a sh:NodeShape ;
    sh:targetClass era:NetLinearReference ;
    
    # Starts At (required, topological coordinate - can be inline or referenced)
    sh:property [ 
        sh:path era:startsAt ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetLinearReference must have exactly one startsAt that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jede NetLinearReference muss genau ein startsAt haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque NetLinearReference doit avoir exactement un startsAt conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Ends At (required, topological coordinate - can be inline or referenced)
    sh:property [ 
        sh:path era:endsAt ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetLinearReference must have exactly one endsAt that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jede NetLinearReference muss genau ein endsAt haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque NetLinearReference doit avoir exactement un endsAt conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Has Sequence (optional, RDF list of linear elements)
    sh:property [ 
        sh:path era:hasSequence ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A NetLinearReference may have at most one hasSequence property pointing to an RDF list."@en ;
        sh:message "Eine NetLinearReference darf höchstens eine hasSequence-Eigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Une NetLinearReference peut avoir au plus une propriété hasSequence pointant vers une liste RDF."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all list items are LinearElement instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the hasSequence list must be instances of era:LinearElement that conform to LinearElementShape."@en ;
        sh:message "Alle Elemente in der Liste hasSequence müssen Instanzen von era:LinearElement sein, die LinearElementShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste hasSequence doivent être des instances de era:LinearElement conformes à LinearElementShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:hasSequence ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                # Violation if item is not a LinearElement
                FILTER NOT EXISTS { ?item a era:LinearElement }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .

# ===== Net Point Reference Shape =====
era:NetPointReferenceShape a sh:NodeShape ;
    sh:targetClass era:NetPointReference ;
    
    # Has Topological Coordinate (required, can be inline or referenced)
    sh:property [ 
        sh:path era:hasTopoCoordinate ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetPointReference must have exactly one hasTopoCoordinate that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jede NetPointReference muss genau ein hasTopoCoordinate haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque NetPointReference doit avoir exactement un hasTopoCoordinate conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Applies To Direction (required, controlled vocabulary)
    sh:property [ 
        sh:path era:appliesToDirection ;
        sh:in (
            <http://data.europa.eu/949/concepts/orientations/both>
            <http://data.europa.eu/949/concepts/orientations/same>
            <http://data.europa.eu/949/concepts/orientations/opposite>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property appliesToDirection must have a value from the defined SKOS concept scheme (both, same, or opposite)."@en ;
        sh:message "Die Eigenschaft appliesToDirection muss einen Wert aus dem definierten SKOS-Konzeptschema haben (beide, gleich oder entgegengesetzt)."@de ;
        sh:message "La propriété appliesToDirection doit avoir une valeur du schéma conceptuel SKOS défini (les deux, identique ou opposé)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
	
# ===== Topological Coordinate Shape =====
era:TopologicalCoordinateShape a sh:NodeShape ;
    sh:targetClass era:TopologicalCoordinate ;
    
    # On Linear Element (required, can be inline or referenced)
    sh:property [ 
        sh:path era:onLinearElement ;
        sh:node era:LinearElementShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TopologicalCoordinate must have exactly one onLinearElement that conforms to LinearElement object."@en ;
        sh:message "Jede TopologicalCoordinate muss genau eine onLinearElement haben, die dem LinearElement-Objekt entspricht."@de ;
        sh:message "Chaque TopologicalCoordonnée doit avoir exactement un onLinearElement conforme à l'objet LinearElement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Offset From Origin (required, unsigned integer >= 0 - distance in meters from element origin)
    sh:property [ 
        sh:path era:offsetFromOrigin ;
        sh:datatype xsd:positiveInteger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TopologicalCoordinate must have exactly one offsetFromOrigin (non-negative unsigned integer, in meters)."@en ;
        sh:message "Jede TopologicalCoordinate muss genau eine offsetFromOrigin haben (nicht negative Ganzzahl ohne Vorzeichen, in Metern)."@de ;
        sh:message "Chaque TopologicalCoorder doit avoir exactement un offsetFromOrigin (entier non signé non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] .
	


# ===== Linear Element Shape =====
era:LinearElementShape a sh:NodeShape ;
    sh:targetClass era:LinearElement ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A LinearElement may have at most one name (string)."@en ;
        sh:message "Ein LinearElement darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un LinearElement peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Length of Net Linear Element (required, double > 0 - length in meters)
    sh:property [ 
        sh:path era:lengthOfNetLinearElement ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElement must have exactly one lengthOfNetLinearElement (non-negative double, in meters)."@en ;
        sh:message "Jedes LinearElement muss genau ein lengthOfNetLinearElement (nicht negatives Double, in Metern) haben."@de ;
        sh:message "Chaque LinearElement doit avoir exactement un lengthOfNetLinearElement (double non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint: lengthOfNetLinearElement must be greater than 0
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The lengthOfNetLinearElement must be greater than 0 meters."@en ;
        sh:message "Der lengthOfNetLinearElement muss größer als 0 Meter sein."@de ;
        sh:message "Le lengthOfNetLinearElement doit être supérieur à 0 mètre."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            
            SELECT $this
            WHERE {
                $this era:lengthOfNetLinearElement ?len .
                FILTER (?len <= 0)
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== Net Point Reference Shape =====
era:NetPointReferenceShape a sh:NodeShape ;
    sh:targetClass era:NetPointReference ;
    
    # Has Topological Coordinate (required, can be inline or referenced)
    sh:property [ 
        sh:path era:hasTopoCoordinate ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetPointReference must have exactly one hasTopoCoordinate that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jede NetPointReference muss genau ein hasTopoCoordinate haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque NetPointReference doit avoir exactement un hasTopoCoordinate conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Applies To Direction (required, controlled vocabulary)
    sh:property [ 
        sh:path era:appliesToDirection ;
        sh:in (
            <http://data.europa.eu/949/concepts/orientations/both>
            <http://data.europa.eu/949/concepts/orientations/same>
            <http://data.europa.eu/949/concepts/orientations/opposite>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property appliesToDirection must have a value from the defined SKOS concept scheme (both, same, or opposite)."@en ;
        sh:message "Die Eigenschaft appliesToDirection muss einen Wert aus dem definierten SKOS-Konzeptschema haben (beide, gleich oder entgegengesetzt)."@de ;
        sh:message "La propriété appliesToDirection doit avoir une valeur du schéma conceptuel SKOS défini (les deux, identique ou opposé)."@fr ;
        sh:severity sh:Violation ;
    ] .
		
		
		
# ===== Linear Element Section Shape =====
era:LinearElementSectionShape a sh:NodeShape ;
    sh:targetClass era:LinearElementSection ;
    
    # On Element (required, reference to the linear element - can be inline or referenced)
    sh:property [ 
        sh:path era:onElement ;
        sh:node era:LinearElementShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one onElement that conforms to LinearElement object."@en ;
        sh:message "Jeder LinearElementSection muss genau ein onElement haben, das dem LinearElement-Objekt entspricht."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement un onElement conforme à l'objet LinearElement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Start Offset From Origin (required, double >= 0 - distance in meters from element origin)
    sh:property [ 
        sh:path era:startOffsetFromOrigin ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one startOffsetFromOrigin (non-negative double, in meters)."@en ;
        sh:message "Jeder LinearElementSection muss genau ein startOffsetFromOrigin (nicht negatives Double, in Metern) haben."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement un startOffsetFromOrigin (double non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # End Offset From Origin (required, double >= 0 - distance in meters from element origin)
    sh:property [ 
        sh:path era:endOffsetFromOrigin ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one endOffsetFromOrigin (non-negative double, in meters)."@en ;
        sh:message "Jeder LinearElementSection muss genau ein endOffsetFromOrigin (nicht negatives Double, in Metern) haben."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement un endOffsetFromOrigin (double non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Applies In Both Directions (required, boolean)
    sh:property [ 
        sh:path era:appliesInBothDirections ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one appliesInBothDirections value (boolean)."@en ;
        sh:message "Jeder LinearElementSection muss genau einen appliesInBothDirections-Wert (boolean) haben."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement une valeur appliesInBothDirections (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint: startOffsetFromOrigin must be less than endOffsetFromOrigin
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The startOffsetFromOrigin must be less than endOffsetFromOrigin."@en ;
        sh:message "Der startOffsetFromOrigin muss kleiner als endOffsetFromOrigin sein."@de ;
        sh:message "Le startOffsetFromOrigin doit être inférieur à endOffsetFromOrigin."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            
            SELECT $this
            WHERE {
                $this era:startOffsetFromOrigin ?start ;
                      era:endOffsetFromOrigin ?end .
                FILTER (?start >= ?end)
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
	
	
	
# Shape to check that at least one Operational Traffic Plan class exists
era:AtLeastOneOperationalTrafficPlanClassShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            SELECT ?this
            WHERE {
                BIND (era:ValidationRoot as ?this)
            }
        """ ;
    ] ;
    
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The data must contain at least one instance of the required Operational Traffic Plan classes (e.g., OperationalPlanMovement, TrainUnit, MovementEvent, RestrictionEvent, etc.). This error may indicate that the provided data significantly deviates from the expected operational planning and traffic management model as defined in the extended ERA ontology."@en ;
        sh:message "Die Daten müssen mindestens eine Instanz der erforderlichen Operational Traffic Plan-Klassen enthalten (z. B. OperationalPlanMovement, TrainUnit, MovementEvent, RestrictionEvent usw.). Dieser Fehler kann darauf hinweisen, dass die bereitgestellten Daten erheblich vom erwarteten Betriebsplanungs- und Verkehrsmanagementmodell abweichen, wie es in der erweiterten ERA-Ontologie definiert ist."@de ;
        sh:message "Les données doivent contenir au moins une instance des classes de plan de trafic opérationnel requises (par exemple, OperationalPlanMovement, TrainUnit, MovementEvent, RestrictionEvent, etc.). Cette erreur peut indiquer que les données fournies s'écartent considérablement du modèle de planification opérationnelle et de gestion du trafic attendu tel que défini dans l'ontologie ERA étendue."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    # Top-Level Container
                    { ?instance rdf:type era:OperationalTrafficPlan . }
                    
                    # Operational Plan Classes
                    UNION { ?instance rdf:type era:OperationalPlanMovement . }
                    UNION { ?instance rdf:type era:OperationalPlanRestriction . }
                    UNION { ?instance rdf:type era:OperationalPlanWarningMeasure . }
                    UNION { ?instance rdf:type era:OperationalPlanReference . }
                    
                    # Train Unit Classes
                    UNION { ?instance rdf:type era:TrainUnit . }
                    UNION { ?instance rdf:type era:OperationalTrainCategory . }
                    UNION { ?instance rdf:type era:OperationalConsist . }
                    UNION { ?instance rdf:type era:PhysicalTrainUnitIdentifier . }
                    
                    # Equipment Classes
                    UNION { ?instance rdf:type era:SupportedOnBoardEquipment . }
                    UNION { ?instance rdf:type era:OnBoardExtension . }
                    
                    # Movement Classes
                    UNION { ?instance rdf:type era:MovementEvent . }
                    UNION { ?instance rdf:type era:OperationalEventRef . }
                    UNION { ?instance rdf:type era:StopDescription . }
                    UNION { ?instance rdf:type era:AdditionalEventTime . }
                    UNION { ?instance rdf:type era:DoorActivity . }
                    UNION { ?instance rdf:type era:TrainUnitActivity . }
                    
                    # Restriction Classes
                    UNION { ?instance rdf:type era:SpeedRestriction . }
                    UNION { ?instance rdf:type era:MovementRestriction . }
                    UNION { ?instance rdf:type era:SpecificMovementRestriction . }
                    UNION { ?instance rdf:type era:DPSGroupsList . }
                    UNION { ?instance rdf:type era:RestrictionEvent . }
                    UNION { ?instance rdf:type era:RestrictionArea . }
                    UNION { ?instance rdf:type era:TrainGroupSpec . }
                    UNION { ?instance rdf:type era:RestrictedAspect . }
                    UNION { ?instance rdf:type era:SpecificRestriction . }
                    UNION { ?instance rdf:type era:RestrictionAreaState . }
                    
                    # Warning Measure Classes
                    UNION { ?instance rdf:type era:WarningArea . }
                    UNION { ?instance rdf:type era:WarningDevice . }
                    UNION { ?instance rdf:type era:WarningMeasureEvent . }
                    UNION { ?instance rdf:type era:WarningAreaState . }
                    
                    # Execution Response Classes
                    UNION { ?instance rdf:type era:ExecutionResponse . }
                    UNION { ?instance rdf:type era:EventExecutionReport . }
                    UNION { ?instance rdf:type era:MovementEventExecutionReport . }
                    UNION { ?instance rdf:type era:RestrictionEventExecutionReport . }
                    UNION { ?instance rdf:type era:WarningMeasureEventExecutionReport . }
                    
                    # Train Report Classes
                    UNION { ?instance rdf:type era:TrainUnitReportPE . }
                    UNION { ?instance rdf:type era:TrainObject . }
                    UNION { ?instance rdf:type era:TrainUnitReportAtoStatus . }
                    UNION { ?instance rdf:type era:TrainUnitReportAtoCapabilities . }
                    
                    # Movement Permission Classes
                    UNION { ?instance rdf:type era:MovementPermission . }
                    UNION { ?instance rdf:type era:MpSpeed . }
                    UNION { ?instance rdf:type era:MpDrivingMode . }
                    
                    # Event Handling Classes
                    UNION { ?instance rdf:type era:EventHandling . }
                    UNION { ?instance rdf:type era:EventEstimation . }
                    
                    # Train Capability Classes
                    UNION { ?instance rdf:type era:EtcsDataAto . }
                    UNION { ?instance rdf:type era:AdditionalTrainData . }
                    
                    # Physical Consist Classes
                    UNION { ?instance rdf:type era:PhysicalConsist . }
                    UNION { ?instance rdf:type era:PhysicalVehicle . }
                    UNION { ?instance rdf:type era:DoorData . }
                    
                    # Track State Classes
                    UNION { ?instance rdf:type era:TrackOccupationState . }
                    UNION { ?instance rdf:type era:DpsGroupState . }
                    UNION { ?instance rdf:type era:DPSState . }
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .