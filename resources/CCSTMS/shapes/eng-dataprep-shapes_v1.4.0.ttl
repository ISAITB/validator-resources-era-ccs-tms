@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix era:    <http://data.europa.eu/949/> .

@prefix eng-dp: <http://data.europa.eu/949/shapes/eng-dataprep#> .



################################################################################
#
#  SPARQL prefix declarations
#
#  SHACL 5.3: the Turtle @prefix declarations above do NOT apply inside sh:select.
#  Only sh:prefixes does. Without this block a query writing era:... fails outright
#  with "Unknown namespace prefix : era" on any data graph that does not itself
#  happen to bind the same prefix - data written with full IRIs, or binding era949:
#  instead of era:. Every sh:SPARQLConstraint below therefore carries
#  sh:prefixes eng-dp:PrefixDeclarations.
#
################################################################################

eng-dp:PrefixDeclarations
    a owl:Ontology ;
    rdfs:label "Prefixes available to every sh:select in this file"@en ;
    sh:declare
        [ sh:prefix "era"  ; sh:namespace "http://data.europa.eu/949/"^^xsd:anyURI ] ,
        [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd"  ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ;
    .


################################################################################
#
#  ENG-DP-001  A kilometric post must not be positioned beyond the end of the
#              LinearElement whose kilometre referencing it belongs to.
#
#     for all lek, for all kp in lek.kilometricPosts:
#         kp.pos <= lek.linearElement.lengthOfNetLinearElement
#
#  Rationale: pos is where along the linear element the kilometric post stands,
#  measured from the element's origin. The post is what ties a position on the
#  topology to a railway kilometre value - the reference in which the line is
#  described, signals are named, incidents are reported and works are ordered.
#  A post beyond the end of its element anchors that translation to track the
#  element does not contain, so every kilometre value derived from it is wrong,
#  and wrong in a way that is invisible from the kilometre side: the numbers still
#  increase smoothly, they simply refer to the wrong ground.
#
#  Note that kilometricPosts is the ordered set from which kilometre values are
#  INTERPOLATED between posts. A post placed off the end therefore does not merely
#  mislabel one point; it skews the interpolation over the whole stretch between
#  itself and its neighbour.
#
#  THE INFRA COUNTERPART is DP-015, which bounds a StaticSpeedLimit's pos against
#  the same length, and the structure here is identical: an object anchored to a
#  LinearElement by an explicit era:linearElement reference, carrying a list of
#  positioned members. As there, the reference is what is navigated - not any
#  identity shared through the IRI, which context.txt rule 24 forbids relying on.
#
#  kilometricPosts IS AN RDF LIST - it is tagged "ordered": "byIndex" in eng.json,
#  so the posts are the ITEMS of an rdf:List, not direct objects of the property.
#  era:kilometricPosts alone reaches the list's first CELL, which is not a
#  KilometricPost and carries no pos; a rule written that way would match nothing
#  and pass everything in silence. The items are reached with
#  era:kilometricPosts/rdf:rest*/rdf:first. A second UNION branch tolerates the
#  non-list form, for the reason set out under infra's DP-016: a provider who
#  writes the posts as a plain multi-valued property has made a structural error
#  that eng-shapes.ttl reports, but staying silent about their positions would be
#  the wrong failure mode.
#
#  CROSS-MODULE - the length lives on an infra LinearElement. If the eng data is
#  validated without the infra topology in the graph, the opening patterns match
#  nothing and this rule is silent. That is silence for want of the other half, not
#  a clean bill of health.
#
#  SCOPE - no further guard is needed. A missing era:linearElement or
#  lengthOfNetLinearElement is a structural fault that the respective -shapes.ttl
#  reports. kilometricPosts is "*", so a LinearElementKm with no posts at all is
#  legitimate and this rule is simply vacuous on it. Comparison is by VALUE, so a
#  position written as a plain integer is compared correctly against a double
#  length.
#
#  REPORTING - the focus node is the LinearElementKm and sh:value is the offending
#  position rather than the post, KilometricPost being a composition and so usually
#  a blank node a data preparer cannot look up. kmPostName is carried in the
#  projection, under OPTIONAL because it is 0..1, so that two distinct posts sharing
#  one bad position are reported separately rather than collapsing into one finding.
#  It is deliberately NOT interpolated into the message: an absent optional renders
#  as the literal placeholder text, which would read worse than omitting it.
#
#  NOT COVERED - the rule states an upper bound only, so a negative pos is accepted
#  here. Note also that eng.json says of kilometricPosts that "these are sorted by
#  pos from 0 to length", which asserts both an ORDER and a COVERAGE that no rule
#  yet checks; both would be rules of their own, and the ordering one is notably
#  stricter than infra's DP-026, since it names a direction.
#
################################################################################

eng-dp:LinearElementKm-ENGDP001
    a sh:NodeShape ;
    sh:targetClass era:LinearElementKm ;
    rdfs:label "ENG-DP-001 a kilometric post must not sit beyond the end of its linear element"@en ;
    era:additionalInfo "This check reads KilometricPost.pos - the post's position along its LinearElement, in metres - and compares it against LinearElement.lengthOfNetLinearElement via LinearElementKm.linearElement. It does not check KilometricPost.kilometer, the actual railway kilometre value. SCOPE: this rule checks only the upper bound (pos must not exceed the element's length); a negative pos is not caught by this rule. Each post is evaluated independently, so one LinearElementKm can have some posts pass and others fail. KilometricPost is a composition with no IRI of its own, so the violation is reported against the parent LinearElementKm; kmPostName is included where available to help identify which specific post failed. NOTE: kilometricPosts is expected to be a proper rdf:List; if it is malformed, that is reported separately by the structural shapes (eng-shapes.ttl). This rule still checks positions on whatever posts it can find even when that structural problem exists, so a pass here does not by itself confirm the list itself is well-formed."@en ;
    era:additionalInfo "Diese Prüfung liest KilometricPost.pos - die Position des Postens entlang seines LinearElement, in Metern - und vergleicht sie über LinearElementKm.linearElement mit LinearElement.lengthOfNetLinearElement. Sie prüft nicht KilometricPost.kilometer, den tatsächlichen Streckenkilometerwert. GELTUNGSBEREICH: diese Regel prüft nur die obere Grenze (pos darf die Länge des Elements nicht überschreiten); ein negativer pos-Wert wird von dieser Regel nicht erfasst. Jeder Posten wird unabhängig bewertet, sodass ein LinearElementKm teils bestehen, teils fehlschlagen kann. KilometricPost ist eine Komposition ohne eigene IRI, daher wird der Verstoß gegen das übergeordnete LinearElementKm gemeldet; kmPostName wird, falls vorhanden, einbezogen, um zu erkennen, welcher konkrete Posten fehlgeschlagen ist. HINWEIS: kilometricPosts wird als ordnungsgemäße rdf:List erwartet; ist sie fehlerhaft, wird dies separat von den strukturellen Shapes (eng-shapes.ttl) gemeldet. Diese Regel prüft weiterhin die Positionen aller auffindbaren Posten, auch wenn dieses strukturelle Problem besteht, sodass ein Bestehen dieser Regel für sich genommen nicht bestätigt, dass die Liste selbst wohlgeformt ist."@de ;
    era:additionalInfo "Cette vérification lit KilometricPost.pos - la position du post le long de son LinearElement, en mètres - et la compare, via LinearElementKm.linearElement, à LinearElement.lengthOfNetLinearElement. Elle ne vérifie pas KilometricPost.kilometer, la valeur kilométrique ferroviaire réelle. PORTÉE : cette règle ne vérifie que la limite supérieure (pos ne doit pas dépasser la longueur de l'élément) ; une valeur pos négative n'est pas détectée par cette règle. Chaque post est évalué indépendamment, si bien qu'un même LinearElementKm peut voir certains posts réussir et d'autres échouer. KilometricPost est une composition sans IRI propre, la violation est donc signalée sur le LinearElementKm parent ; kmPostName est inclus lorsqu'il est disponible pour aider à identifier quel post précis a échoué. REMARQUE : kilometricPosts est censé être une rdf:List correctement formée ; si elle est malformée, cela est signalé séparément par les shapes structurelles (eng-shapes.ttl). Cette règle continue de vérifier les positions des posts qu'elle parvient à trouver même en présence de ce problème structurel, si bien qu'une réussite ici ne confirme pas à elle seule que la liste elle-même est bien formée."@fr ;
    sh:sparql eng-dp:ENGDP001-kilometricPostBeyondElementEnd ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP001-kilometricPostBeyondElementEnd
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-001"@en ;
    sh:message "ENG-DP-001: this LinearElementKm has a KilometricPost at pos {?value} m, beyond the end of the referenced LinearElement, whose lengthOfNetLinearElement is {?len} m. The position is an offset from that element's origin, so it must not exceed the element's length. A post off the end anchors the translation between topology and railway kilometre to track that is not there, and because kilometre values are interpolated between posts it skews every value between this post and its neighbour, not just the one point. Either correct the position, or move the post to the kilometre referencing of the element it really stands on."@en ;
    sh:message "ENG-DP-001: dieses LinearElementKm hat einen KilometricPost an Position {?value} m, jenseits des Endes des referenzierten LinearElement, dessen lengthOfNetLinearElement {?len} m beträgt. Die Position ist ein Offset vom Ursprung dieses Elements und darf daher die Länge des Elements nicht überschreiten. Ein Post jenseits des Endes verankert die Übersetzung zwischen Topologie und Streckenkilometer an Gleis, das dort nicht existiert, und da Kilometerwerte zwischen Posts interpoliert werden, verfälscht dies jeden Wert zwischen diesem Post und seinem Nachbarn, nicht nur den einen Punkt. Entweder die Position korrigieren, oder den Post der Kilometerreferenzierung des Elements zuordnen, auf dem er tatsächlich steht."@de ;
    sh:message "ENG-DP-001: ce LinearElementKm comporte un KilometricPost à la position {?value} m, au-delà de la fin du LinearElement référencé, dont le lengthOfNetLinearElement est de {?len} m. La position est un décalage depuis l'origine de cet élément et ne doit donc pas dépasser la longueur de l'élément. Un post situé au-delà de la fin ancre la correspondance entre la topologie et le kilomètre ferroviaire sur une voie qui n'existe pas à cet endroit, et comme les valeurs kilométriques sont interpolées entre les posts, cela fausse chaque valeur entre ce post et son voisin, pas seulement ce point précis. Corrigez la position, ou déplacez le post vers le référençage kilométrique de l'élément sur lequel il se trouve réellement."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?len ?kp ?kmName
        WHERE {
            $this era:linearElement ?le .
            ?le   era:lengthOfNetLinearElement ?len .

            # kilometricPosts is ordered byIndex, so the posts are the ITEMS of an
            # rdf:List; the second branch tolerates the non-list form
            {   $this era:kilometricPosts/rdf:rest*/rdf:first ?kp . }
            UNION
            {   $this era:kilometricPosts ?kp . }

            ?kp era:pos ?value .
            OPTIONAL { ?kp era:kmPostName ?kmName }

            FILTER ( ?value > ?len )
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-002  Kilometric posts must run in order along the list.
#
#     for all lek: reading the positions of lek.kilometricPosts in list order
#     gives a sequence that is STRICTLY MONOTONIC - increasing throughout, or
#     decreasing throughout.
#
#  The seventh list in the model to carry this rule, and the eng counterpart of
#  infra's DP-026. kilometricPosts is tagged "ordered": "byIndex", which is a
#  promise about MEANING and not merely about serialisation: the posts are in the
#  sequence of their real location, so neighbours in the array are neighbours on
#  the ground.
#
#  EITHER DIRECTION IS ALLOWED, as in DP-026 and DP-036. Note that eng.json says of
#  kilometricPosts that "these are sorted by pos from 0 to length", which reads as
#  ASCENDING specifically; this rule deliberately does not enforce that reading.
#  Confirmed with you that byIndex permits either direction throughout the model,
#  so the direction-specific wording in the model's info text is treated as
#  descriptive of the usual case rather than as a constraint. If you later decide
#  kilometre posts are the exception and must ascend, that is a one-line tightening
#  of ENG-DP-002b - but it would be a different rule from the one implemented here,
#  and it should be a deliberate choice rather than a side effect.
#
#  Rationale: a consumer walking this list expects order on the ground, and uses
#  consecutive posts as the two ends of an interval over which a kilometre value is
#  interpolated. A list that doubles back makes those intervals overlap and run
#  backwards, so the interpolation is not merely inaccurate but ill-defined - a
#  single position on the element can be assigned two different kilometre values
#  depending on which interval a consumer happens to use.
#
#  Nothing about the individual posts is wrong, which is why no other rule sees it:
#  each position is within the element (ENG-DP-001), each kilometre value is
#  plausible. Only the ORDER betrays the fault.
#
#  SPLIT IN TWO, as DP-026 is, because the two ways of breaking order want
#  different messages:
#
#    ENG-DP-002a  two ADJACENT posts at the same position. This is contradictory
#                 rather than untidy: two posts at one place on the element assign
#                 two kilometre values to that one place, and the translation
#                 between topology and kilometre is ambiguous there. Unlike DP-036,
#                 where DP-008 already caught coincident balises, nothing else in
#                 any rule set catches this - so it is checked here.
#
#    ENG-DP-002b  the list CHANGES DIRECTION. Detected locally over three
#                 consecutive posts: if no two adjacent positions are equal then
#                 every step is strictly up or strictly down, so a sequence that is
#                 not monotonic must turn somewhere, and at the turn three
#                 consecutive posts form a peak or a valley. Reporting the turning
#                 position points at the post to move.
#
#  INTERACTION - ENG-DP-002b says nothing where adjacent positions are equal, so a
#  list that both repeats a position AND turns is reported by ENG-DP-002a alone on
#  the first pass; once the repeat is corrected a second pass reports the turn.
#
#  RELIES ON THE rdf:LIST, unavoidably: order is not a property a plain
#  multi-valued property has, so there is no tolerant non-list branch here as there
#  is in ENG-DP-001. On data written without a list this rule is necessarily
#  silent, that missing list being a structural fault eng-shapes.ttl reports.
#
#  NOT CROSS-MODULE, unlike ENG-DP-001: this rule compares posts against one
#  another and needs no infra data at all, so it is just as effective on an eng
#  fragment validated on its own.
#
#  A list of one or two posts is always in order and is never reported by
#  ENG-DP-002b; two posts at one position are still caught by ENG-DP-002a.
#
#  NOT COVERED - the kilometer VALUES are not checked against the positions.
#  A sound list of positions may still carry kilometre values that jump about, or
#  that run in a direction inconsistent with the positions. That is a real and
#  separate rule: kilometre values should themselves be monotonic, though not
#  necessarily in the same direction as pos, since a line's kilometre reference may
#  run against the element's origin direction. Worth writing once you have said
#  which pairings are legitimate.
#
################################################################################

eng-dp:LinearElementKm-ENGDP002
    a sh:NodeShape ;
    sh:targetClass era:LinearElementKm ;
    rdfs:label "ENG-DP-002 kilometric posts must run in order along the list"@en ;
    era:additionalInfo "This check reads KilometricPost.pos across the full kilometricPosts list and requires it to be strictly monotonic - either consistently increasing or consistently decreasing throughout, never a mix. Either direction is accepted: although the data model describes posts as sorted from 0 to length (reading as ascending), this rule deliberately does not enforce ascending order specifically, only consistency. Two distinct failure patterns are checked: ENGDP002a fires when two ADJACENT posts share the exact same pos value; ENGDP002b fires when three consecutive posts form a peak or a valley (the direction reverses). If a list both repeats a position and changes direction, only ENGDP002a is reported first; ENGDP002b only appears on a subsequent check once the duplicate is resolved. SCOPE: this rule checks pos ordering only - the kilometer values themselves are not checked against position order and may be inconsistent even when this rule passes. Unlike ENGDP001, there is no tolerant fallback here: if kilometricPosts is not a well-formed rdf:List, this rule finds nothing and stays completely silent (that structural problem is reported separately by eng-shapes.ttl) - a pass here does not confirm the list is even well-formed to begin with."@en ;
    era:additionalInfo "Diese Prüfung liest KilometricPost.pos über die gesamte kilometricPosts-Liste und verlangt, dass sie streng monoton ist - entweder durchgehend steigend oder durchgehend fallend, niemals gemischt. Beide Richtungen sind zulässig: obwohl das Datenmodell die Posten als von 0 bis Länge sortiert beschreibt (was als aufsteigend zu lesen ist), erzwingt diese Regel bewusst keine aufsteigende Reihenfolge im Speziellen, sondern nur Konsistenz. Zwei unterschiedliche Fehlermuster werden geprüft: ENGDP002a greift, wenn zwei AUFEINANDERFOLGENDE Posten denselben pos-Wert teilen; ENGDP002b greift, wenn drei aufeinanderfolgende Posten einen Gipfel oder ein Tal bilden (die Richtung kehrt sich um). Wenn eine Liste sowohl eine Position wiederholt als auch die Richtung ändert, wird zunächst nur ENGDP002a gemeldet; ENGDP002b erscheint erst bei einer erneuten Prüfung, nachdem das Duplikat behoben wurde. GELTUNGSBEREICH: diese Regel prüft nur die Reihenfolge von pos - die kilometer-Werte selbst werden nicht gegen die Positionsreihenfolge geprüft und können inkonsistent sein, auch wenn diese Regel besteht. Anders als bei ENGDP001 gibt es hier keinen toleranten Fallback: Ist kilometricPosts keine wohlgeformte rdf:List, findet diese Regel nichts und bleibt vollständig stumm (dieses strukturelle Problem wird separat von eng-shapes.ttl gemeldet) - ein Bestehen dieser Regel bestätigt also nicht, dass die Liste überhaupt wohlgeformt ist."@de ;
    era:additionalInfo "Cette vérification lit KilometricPost.pos sur l'ensemble de la liste kilometricPosts et exige qu'elle soit strictement monotone - soit constamment croissante, soit constamment décroissante, jamais un mélange des deux. Les deux sens sont acceptés : bien que le modèle de données décrive les posts comme triés de 0 à la longueur (ce qui se lit comme croissant), cette règle n'impose délibérément pas un ordre croissant spécifiquement, seulement la cohérence. Deux schémas de défaillance distincts sont vérifiés : ENGDP002a se déclenche lorsque deux posts ADJACENTS partagent exactement la même valeur pos ; ENGDP002b se déclenche lorsque trois posts consécutifs forment un pic ou une vallée (la direction s'inverse). Si une liste répète à la fois une position et change de direction, seul ENGDP002a est signalé dans un premier temps ; ENGDP002b n'apparaît que lors d'une vérification ultérieure, une fois le doublon corrigé. PORTÉE : cette règle ne vérifie que l'ordre de pos - les valeurs kilometer elles-mêmes ne sont pas vérifiées par rapport à l'ordre des positions et peuvent être incohérentes même lorsque cette règle est respectée. Contrairement à ENGDP001, il n'existe ici aucun repli tolérant : si kilometricPosts n'est pas une rdf:List bien formée, cette règle ne trouve rien et reste totalement silencieuse (ce problème structurel est signalé séparément par eng-shapes.ttl) - une réussite de cette règle ne confirme donc pas que la liste elle-même est bien formée."@fr ;
    sh:sparql
        eng-dp:ENGDP002a-adjacentPositionsEqual ,
        eng-dp:ENGDP002b-listChangesDirection ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP002a-adjacentPositionsEqual
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-002a"@en ;
    sh:message "ENG-DP-002a: two KilometricPosts that follow one another in this LinearElementKm's list are both at pos {?value} m. Two posts at one place on the element assign two kilometre values to that place, so the translation between topology and railway kilometre is ambiguous there and a consumer will pick one arbitrarily. Remove the duplicate, or correct whichever position was copied."@en ;
    sh:message "ENG-DP-002a: zwei aufeinanderfolgende KilometricPosts in der Liste dieses LinearElementKm liegen beide an Position {?value} m. Zwei Posts an derselben Stelle des Elements weisen dieser Stelle zwei Kilometerwerte zu, sodass die Übersetzung zwischen Topologie und Streckenkilometer dort mehrdeutig ist und ein Konsument willkürlich einen davon wählt. Entfernen Sie das Duplikat, oder korrigieren Sie die Position, die kopiert wurde."@de ;
    sh:message "ENG-DP-002a: deux KilometricPosts consécutifs dans la liste de ce LinearElementKm se trouvent tous deux à la position {?value} m. Deux posts au même endroit de l'élément attribuent deux valeurs kilométriques à cet endroit, ce qui rend ambiguë la correspondance entre la topologie et le kilomètre ferroviaire à cet endroit, et un consommateur en choisira un arbitrairement. Supprimez le doublon, ou corrigez la position qui a été copiée."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?cell
        WHERE {
            $this era:kilometricPosts/rdf:rest* ?cell .
            ?cell rdf:first ?k1 ;
                  rdf:rest  ?c2 .
            ?c2   rdf:first ?k2 .

            ?k1 era:pos ?value .
            ?k2 era:pos ?p2 .

            FILTER ( ?value = ?p2 )
        }
    """ ;
    .

eng-dp:ENGDP002b-listChangesDirection
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-002b"@en ;
    sh:message "ENG-DP-002b: this LinearElementKm's list of kilometric posts changes direction at pos {?value} m - the three consecutive posts at {?p1}, {?value} and {?p3} m turn back on themselves. The list is tagged byIndex, so it is in the order the posts occupy on the ground; that order may run either way along the element but must not reverse part way. Consecutive posts are the two ends of an interval over which kilometre values are interpolated, so a list that doubles back makes those intervals overlap and one position can be given two different kilometre values. Move the post at {?value} m to its proper place in the sequence, or correct its position."@en ;
    sh:message "ENG-DP-002b: die Liste der Kilometerposten dieses LinearElementKm ändert an Position {?value} m die Richtung - die drei aufeinanderfolgenden Posts bei {?p1}, {?value} und {?p3} m kehren sich um. Die Liste ist mit byIndex getaggt, folgt also der Reihenfolge, in der die Posts auf dem Gelände liegen; diese Reihenfolge kann in beide Richtungen entlang des Elements verlaufen, darf sich aber nicht auf halbem Weg umkehren. Aufeinanderfolgende Posts bilden die beiden Enden eines Intervalls, über das Kilometerwerte interpoliert werden, sodass eine Liste, die sich umkehrt, diese Intervalle überlappen lässt und einer Position zwei unterschiedliche Kilometerwerte zugewiesen werden können. Verschieben Sie den Post bei {?value} m an seine richtige Stelle in der Sequenz, oder korrigieren Sie seine Position."@de ;
    sh:message "ENG-DP-002b: la liste des posts kilométriques de ce LinearElementKm change de direction à la position {?value} m - les trois posts consécutifs à {?p1}, {?value} et {?p3} m rebroussent chemin. La liste est étiquetée byIndex, elle suit donc l'ordre dans lequel les posts se trouvent sur le terrain ; cet ordre peut aller dans un sens ou dans l'autre le long de l'élément, mais ne doit pas s'inverser en cours de route. Des posts consécutifs constituent les deux extrémités d'un intervalle sur lequel les valeurs kilométriques sont interpolées, de sorte qu'une liste qui rebrousse chemin fait se chevaucher ces intervalles, et une même position peut alors se voir attribuer deux valeurs kilométriques différentes. Déplacez le post situé à {?value} m à sa place correcte dans la séquence, ou corrigez sa position."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?p1 ?p3 ?cell
        WHERE {
            # three consecutive posts
            $this era:kilometricPosts/rdf:rest* ?cell .
            ?cell rdf:first ?k1 ;
                  rdf:rest  ?c2 .
            ?c2   rdf:first ?k2 ;
                  rdf:rest  ?c3 .
            ?c3   rdf:first ?k3 .

            ?k1 era:pos ?p1 .
            ?k2 era:pos ?value .
            ?k3 era:pos ?p3 .

            # a peak or a valley: the middle post is a turning point. Equal
            # adjacent positions satisfy neither branch and are ENG-DP-002a's.
            FILTER (   ( ?p1 < ?value && ?value > ?p3 )
                    || ( ?p1 > ?value && ?value < ?p3 ) )
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-003  Every danger point of a level crossing must stand on a LinearElement
#              belonging to that level crossing's own area.
#
#     for all lx, for all dp in lx.dangerPoints:
#         dp.topologicalCoordinate.onLinearElement in elements( lx.areaReference )
#
#  where the elements of a NetAreaReference are collected over ALL of its linear
#  references - includes is 1..*, so an area may be built from several paths - and
#  for each of those the element set is the union of three sources:
#
#         startsAt.hasTopoCoordinate.onLinearElement      (the first element)
#       U endsAt.hasTopoCoordinate.onLinearElement        (the last element)
#       U hasSequence                                     (the intermediates)
#
#  That union is exactly right given infra's DP-002, which forbids the two end
#  elements from also appearing in hasSequence: the sequence carries only what lies
#  BETWEEN them, so neither end would be found by looking at hasSequence alone.
#
#  THE TWO HALVES OF THIS RULE COME FROM DIFFERENT MODULES, and unusually they meet
#  on ONE NODE rather than through a reference. eng.json's LevelCrossing declares
#  only id and dangerPoints; areaReference belongs to infra.json's LevelCrossing.
#  A LevelCrossing instance in RDF therefore carries era:dangerPoints from the eng
#  description and era:areaReference from the infra description of the very same
#  object - context.txt rule 19, that a module redefining a class covers only its
#  own attributes, seen from the data side.
#
#  The practical consequence is that this rule needs BOTH module descriptions of the
#  crossing in the graph. Validating eng data alone leaves era:areaReference absent
#  and the rule silent - not because the danger points are sound but because there
#  is nothing to compare them with. The guard below therefore does double duty: in
#  infra terms a missing areaReference is a structural fault (it is 1..1 there), but
#  here it is at least as likely to mean the infra half simply was not loaded, and
#  in neither case should this rule speak.
#
#  Rationale: a level crossing is where a road crosses the railway, and its area
#  reference is the stretch of track that crossing occupies. The danger points are
#  the places within it at which a road user and a train can come into conflict -
#  they are what fouling and protection distances are measured from, and what
#  decides where a train must be stopped when the crossing is not clear. A danger
#  point on track outside the crossing's own area describes a conflict at a place
#  the crossing does not reach, so the protection is computed for the wrong piece
#  of railway. This is exactly the defect described: a provider anchoring a danger
#  point somewhere else entirely, which nothing else in any rule set would notice
#  because the point is internally well formed and its position is valid on the
#  element it names.
#
#  NOTE ON PATH - a DangerPoint carries era:topologicalCoordinate DIRECTLY, as a
#  Balise or a TrainDetectionSystem does, and NOT through a NetPointReference the
#  way a Derailer or BufferStop does. The area's own end points, by contrast, DO go
#  through NetPointReference. The two sides of this rule therefore walk paths of
#  different lengths; using one for both would silently match nothing and pass
#  everything.
#
#  THE INFRA COUNTERPART is DP-014, which places a TvpSection's train detectors
#  within its linkedArea. The shape of the two is identical; only the property
#  names and the module boundary differ.
#
#  LIMITATION - this checks element MEMBERSHIP, which is what the rule states. It
#  does not check the offset along the two END elements of a linear reference, which
#  the area covers only partially: from startsAt's offset to the end of that
#  element, and from the start of the last element to endsAt's offset. A danger
#  point on the right element but outside that offset range is therefore accepted
#  here. The same limitation as DP-005 and DP-014, and enforcing it needs the
#  orientation semantics of the reference.
#
#  REPORTING - dangerPoints is a REFERENCE, so the danger points carry IRIs a
#  preparer can look up, and sh:value is the offending point itself rather than a
#  position. Several danger points with one at fault yield exactly one finding.
#
#  NOT COVERED - eng's BufferStop also carries a dangerPoint (0..1), and the same
#  question could be asked of it: a buffer stop's danger point ought to lie near the
#  buffer stop. That would be a rule of its own, and needs a decision on what "near"
#  means, since a BufferStop has a point reference rather than an area.
#
################################################################################

eng-dp:LevelCrossing-ENGDP003
    a sh:NodeShape ;
    sh:targetClass era:LevelCrossing ;
    rdfs:label "ENG-DP-003 danger points must lie within the level crossing's own area"@en ;
    era:additionalInfo "Every DangerPoint a LevelCrossing owns (dangerPoints, eng module) must stand on a LinearElement reachable from the crossing's areaReference (infra module). areaReference points to a NetAreaReference, whose includes property (multiplicity 1..*) can bundle several separate NetLinearReference paths - for example where a crossing spans multiple parallel tracks. This check reads the LinearElement each DangerPoint stands on via DangerPoint.topologicalCoordinate.onLinearElement, and checks whether that element is reachable from ANY of the included NetLinearReferences, at their start (startsAt), end (endsAt), or hasSequence in between. A LevelCrossing always has at least one DangerPoint (multiplicity 1..*); DangerPoint has its own global id, so sh:value in the report identifies the specific DangerPoint directly. GUARD: this rule only evaluates a DangerPoint if the crossing's areaReference is present at all - if infra data is not loaded alongside eng data, this rule is silent for want of the other half, not because the danger points are confirmed correct. SCOPE: this checks only whether the point's element is part of one of the area's paths, not its exact offset within that element - a point on a correct element but physically outside the crossing's real boundary on that element is not caught by this rule."@en ;
    era:additionalInfo "Jeder DangerPoint, den ein LevelCrossing besitzt (dangerPoints, eng-Modul), muss auf einem LinearElement stehen, das über die areaReference der Kreuzung (infra-Modul) erreichbar ist. areaReference verweist auf eine NetAreaReference, deren includes-Eigenschaft (Multiplizität 1..*) mehrere separate NetLinearReference-Pfade bündeln kann - etwa dort, wo eine Kreuzung mehrere parallele Gleise überspannt. Diese Prüfung liest das LinearElement, auf dem jeder DangerPoint steht, über DangerPoint.topologicalCoordinate.onLinearElement, und prüft, ob dieses Element über eine beliebige der eingeschlossenen NetLinearReferences erreichbar ist, an deren Anfang (startsAt), Ende (endsAt) oder in der dazwischenliegenden hasSequence. Ein LevelCrossing hat immer mindestens einen DangerPoint (Multiplizität 1..*); DangerPoint besitzt eine eigene globale id, sodass sh:value im Bericht den konkreten DangerPoint direkt identifiziert. ABSICHERUNG: diese Regel bewertet einen DangerPoint nur, wenn die areaReference der Kreuzung überhaupt vorhanden ist - fehlen die infra-Daten neben den eng-Daten, bleibt diese Regel mangels der anderen Hälfte stumm, nicht weil die Gefahrenpunkte als korrekt bestätigt wären. GELTUNGSBEREICH: diese Regel prüft nur, ob das Element des Punktes Teil eines der Pfade der Area ist, nicht seinen genauen Offset innerhalb dieses Elements - ein Punkt auf dem richtigen Element, der sich jedoch physisch außerhalb der tatsächlichen Grenze der Kreuzung auf diesem Element befindet, wird von dieser Regel nicht erfasst."@de ;
    era:additionalInfo "Chaque DangerPoint qu'un LevelCrossing possède (dangerPoints, module eng) doit se trouver sur un LinearElement accessible depuis l'areaReference de la traversée (module infra). areaReference pointe vers une NetAreaReference, dont la propriété includes (multiplicité 1..*) peut regrouper plusieurs chemins NetLinearReference distincts - par exemple lorsqu'un passage à niveau s'étend sur plusieurs voies parallèles. Cette vérification lit le LinearElement sur lequel se trouve chaque DangerPoint via DangerPoint.topologicalCoordinate.onLinearElement, et vérifie si cet élément est accessible depuis n'importe laquelle des NetLinearReferences incluses, à leur début (startsAt), leur fin (endsAt), ou dans leur hasSequence intermédiaire. Un LevelCrossing possède toujours au moins un DangerPoint (multiplicité 1..*) ; DangerPoint possède son propre id global, si bien que sh:value dans le rapport identifie directement le DangerPoint concerné. GARDE-FOU : cette règle n'évalue un DangerPoint que si l'areaReference de la traversée est présente ; si les données infra ne sont pas chargées en même temps que les données eng, cette règle reste silencieuse faute de l'autre moitié, et non parce que les points de danger sont confirmés corrects. PORTÉE : cette règle vérifie seulement si l'élément du point fait partie de l'un des chemins de la zone, pas son décalage exact au sein de cet élément - un point situé sur le bon élément mais physiquement en dehors de la limite réelle de la traversée sur cet élément n'est pas détecté par cette règle."@fr ;
    sh:sparql eng-dp:ENGDP003-dangerPointOutsideAreaReference ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP003-dangerPointOutsideAreaReference
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-003"@en ;
    sh:message "ENG-DP-003: this DangerPoint stands on a LinearElement that is not part of the LevelCrossing's areaReference. A danger point marks where a road user and a train can come into conflict, and it is what fouling and protection distances are measured from; placed on track the crossing does not occupy, the protection is computed for the wrong piece of railway. Either move the danger point, or extend the crossing's area reference to cover the element it stands on."@en ;
    sh:message "ENG-DP-003: dieser DangerPoint steht auf einem LinearElement, das nicht Teil der areaReference des LevelCrossing ist. Ein Gefahrenpunkt markiert die Stelle, an der ein Straßenverkehrsteilnehmer und ein Zug in Konflikt geraten können, und von ihm aus werden Freimelde- und Schutzabstände gemessen; steht er auf Gleis, das die Kreuzung nicht belegt, wird der Schutz für das falsche Stück Strecke berechnet. Entweder den Gefahrenpunkt verschieben, oder die areaReference der Kreuzung so erweitern, dass sie das Element abdeckt, auf dem er steht."@de ;
    sh:message "ENG-DP-003: ce DangerPoint se trouve sur un LinearElement qui ne fait pas partie de l'areaReference du LevelCrossing. Un point de danger marque l'endroit où un usager de la route et un train peuvent entrer en conflit, et c'est à partir de lui que sont mesurées les distances d'encombrement et de protection ; placé sur une voie que le passage à niveau n'occupe pas, la protection est calculée pour le mauvais tronçon de voie. Déplacez le point de danger, ou étendez l'areaReference du passage à niveau pour couvrir l'élément sur lequel il se trouve."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value
        WHERE {
            $this era:dangerPoints ?value .

            # a danger point's coordinate hangs directly off it - no NetPointReference
            ?value era:topologicalCoordinate/era:onLinearElement ?dle .

            # areaReference comes from the INFRA description of this same node.
            # Absent, it means either a structural fault there or that the infra
            # half of the data was not loaded; in neither case should we speak.
            FILTER EXISTS { $this era:areaReference ?anyArea }

            FILTER NOT EXISTS {
                $this era:areaReference/era:includes ?lr .
                {
                    ?lr era:startsAt/era:hasTopoCoordinate/era:onLinearElement ?dle .
                } UNION {
                    ?lr era:endsAt/era:hasTopoCoordinate/era:onLinearElement ?dle .
                } UNION {
                    ?lr era:hasSequence/rdf:rest*/rdf:first ?dle .
                }
            }
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-004  Every fouling point of a crossing must stand on one of the
#              LinearElements the crossing itself occupies.
#
#     for all cr, for all fp in cr.foulingPoints:
#         fp.topologicalCoordinate.onLinearElement
#             in { tc.onLinearElement : tc in cr.topologicalCoordinates }
#
#  AS IN ENG-DP-003, THE TWO HALVES COME FROM DIFFERENT MODULES AND MEET ON ONE
#  NODE. eng.json's Crossing declares only id and foulingPoints; topologicalCoordinates
#  belongs to infra.json's Crossing, along with isSwitchable and name. A Crossing
#  instance in RDF therefore carries both, and this rule needs both module
#  descriptions in the graph. Validating eng data alone leaves the coordinates
#  absent and the rule silent - silence for want of the other half, not a clean
#  bill of health. The guard below enforces that.
#
#  MIND THE SINGULAR AND THE PLURAL. This is the sharpest trap in the rule:
#
#      FoulingPoint  era:topologicalCoordinate    (SINGULAR, 1..1)
#      Crossing      era:topologicalCoordinates   (PLURAL,   2..2)
#
#  Two properties differing by one letter, one on each side of the comparison, and
#  BOTH substitutions fail SILENTLY - which is the dangerous direction. Substituting
#  either way was run against data that must be reported: the singular on both sides
#  finds no crossing coordinates, so the guard never passes and nothing is checked;
#  the plural on both sides finds no fouling point coordinate, so no comparison is
#  ever set up. Neither over-reports, which would at least be noticed. Both were
#  verified to pass bad data cleanly, and that is why the trap is called out here.
#
#  Note also that BOTH sides here are direct - a Crossing's coordinates are a
#  composition of TopologicalCoordinate, not a NetPointReference - so unlike
#  ENG-DP-003 the two paths are of equal length. The trap is the name, not the depth.
#
#  Rationale: a crossing is where two tracks cross, and its two topological
#  coordinates are the points at which each of those tracks passes through it. A
#  fouling point is the place beyond which a vehicle standing on one track will
#  foul the other - it is what clearance is measured to, and what decides whether a
#  route over one track may be set while a vehicle stands on the other. It is only
#  meaningful on a track that actually passes through the crossing. A fouling point
#  on some third element describes clearance at a place where nothing crosses, so
#  the protection is computed for the wrong ground and two conflicting movements
#  can be authorised at once.
#
#  RELATION TO INFRA'S DP-032, which requires a Crossing's two coordinates to be on
#  DIFFERENT linear elements. Together the two rules say that a crossing offers
#  exactly two distinct elements and every fouling point must sit on one of them.
#  Where DP-032 is violated and both coordinates name one element, this rule
#  silently becomes stricter - only that one element is admitted - which is a
#  reasonable way to behave on data that is already reported elsewhere.
#
#  SCOPE - foulingPoints is 1..*, so a crossing carrying none is a structural fault
#  that eng-shapes.ttl reports, and this rule is simply vacuous on it. A crossing
#  with no topologicalCoordinates is skipped by the guard.
#
#  LIMITATION - element MEMBERSHIP only, as the rule states. A fouling point is not
#  required to lie at any particular offset along the element, nor within any
#  distance of the crossing's own coordinate. It could sit at the far end of a
#  kilometre-long element and pass. If a distance bound is wanted it would be a rule
#  of its own, and would need a figure from you.
#
#  REPORTING - foulingPoints is a REFERENCE, so the fouling points carry IRIs a
#  preparer can look up and sh:value is the offending point itself.
#
#  NOT COVERED - eng's Switch also has foulingPoints, 1..*, and the same question
#  applies to it. A Switch has no topologicalCoordinates, though; its extent is
#  given by leftBranch and rightBranch, so the elements admitted there are the three
#  ports that infra's DP-013 reasons about. That is a different query and a
#  different rule.
#
################################################################################

eng-dp:Crossing-ENGDP004
    a sh:NodeShape ;
    sh:targetClass era:Crossing ;
    rdfs:label "ENG-DP-004 fouling points must lie on an element the crossing occupies"@en ;
    era:additionalInfo "Every FoulingPoint a Crossing owns must stand on one of the crossing's own two LinearElements, read via Crossing.topologicalCoordinates (plural - a crossing has exactly two, one per track it intersects). Note the naming trap: FoulingPoint.topologicalCoordinate is singular (one point, one coordinate) while Crossing.topologicalCoordinates is plural (two coordinates) - these are distinct properties on distinct objects, not the same property read two ways. foulingPoints is a reference, not a composition, so FoulingPoint has its own id and sh:value in the report identifies the specific fouling point directly. GUARD: this rule only evaluates a Crossing if its topologicalCoordinates are present at all - if infra data is not loaded alongside eng data, this rule is silent for want of the other half. IMPORTANT ASYMMETRY: if a Crossing's topologicalCoordinates exist but do not reach a LinearElement (broken or incomplete data, as opposed to fully absent), the guard passes but the actual comparison can never find a match - every fouling point on that crossing will then be reported as a violation, even if none are actually misplaced. In that situation the real problem is the crossing's own location data, not the fouling points. LIMITATION: element membership only - a fouling point can sit anywhere along the correct element, including far from the crossing itself, and still pass; no distance or offset bound is checked."@en ;
    era:additionalInfo "Jeder FoulingPoint, den eine Crossing besitzt, muss auf einem der beiden eigenen LinearElements der Kreuzung stehen, gelesen über Crossing.topologicalCoordinates (Plural - eine Kreuzung hat genau zwei, eines pro Gleis, das sie kreuzt). Beachten Sie die Namensfalle: FoulingPoint.topologicalCoordinate ist Singular (ein Punkt, eine Koordinate), während Crossing.topologicalCoordinates Plural ist (zwei Koordinaten) - dies sind unterschiedliche Eigenschaften auf unterschiedlichen Objekten, nicht dieselbe Eigenschaft auf zwei Arten gelesen. foulingPoints ist eine Referenz, keine Komposition, daher besitzt FoulingPoint eine eigene id, und sh:value im Bericht identifiziert das konkrete Grenzzeichen direkt. ABSICHERUNG: diese Regel bewertet eine Crossing nur, wenn ihre topologicalCoordinates überhaupt vorhanden sind - fehlen die infra-Daten neben den eng-Daten, bleibt diese Regel mangels der anderen Hälfte stumm. WICHTIGE ASYMMETRIE: existieren die topologicalCoordinates einer Crossing, erreichen aber kein LinearElement (fehlerhafte statt vollständig fehlende Daten), besteht die Absicherung, aber der eigentliche Vergleich kann nie eine Übereinstimmung finden - jedes Grenzzeichen dieser Kreuzung wird dann als Verstoß gemeldet, selbst wenn keines davon tatsächlich falsch positioniert ist. In diesem Fall liegt das eigentliche Problem bei den Standortdaten der Kreuzung selbst, nicht bei den Grenzzeichen. EINSCHRÄNKUNG: nur Zugehörigkeit zum Element - ein Grenzzeichen kann an beliebiger Stelle entlang des richtigen Elements stehen, auch weit entfernt von der Kreuzung selbst, und dennoch bestehen; es wird keine Distanz- oder Offset-Grenze geprüft."@de ;
    era:additionalInfo "Chaque FoulingPoint qu'un Crossing possède doit se trouver sur l'un des deux LinearElements propres au croisement, lus via Crossing.topologicalCoordinates (pluriel - un croisement en possède exactement deux, un par voie qu'il croise). Notez le piège de nommage : FoulingPoint.topologicalCoordinate est au singulier (un point, une coordonnée), tandis que Crossing.topologicalCoordinates est au pluriel (deux coordonnées) - ce sont des propriétés distinctes sur des objets distincts, non la même propriété lue de deux façons. foulingPoints est une référence, non une composition, donc FoulingPoint possède son propre id, et sh:value dans le rapport identifie directement le point d'encombrement concerné. GARDE-FOU : cette règle n'évalue un Crossing que si ses topologicalCoordinates sont présentes ; si les données infra ne sont pas chargées en même temps que les données eng, cette règle reste silencieuse faute de l'autre moitié. ASYMÉTRIE IMPORTANTE : si les topologicalCoordinates d'un Crossing existent mais n'atteignent aucun LinearElement (données incomplètes ou erronées, plutôt que totalement absentes), le garde-fou est satisfait, mais la comparaison réelle ne peut jamais trouver de correspondance - chaque point d'encombrement de ce croisement sera alors signalé comme une violation, même si aucun n'est réellement mal positionné. Dans ce cas, le problème réel concerne les données de localisation du croisement lui-même, pas les points d'encombrement. LIMITATION : appartenance à l'élément uniquement - un point d'encombrement peut se trouver n'importe où le long du bon élément, y compris loin du croisement lui-même, et être néanmoins accepté ; aucune limite de distance ou de décalage n'est vérifiée."@fr ;
    sh:sparql eng-dp:ENGDP004-foulingPointOffTheCrossing ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP004-foulingPointOffTheCrossing
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-004"@en ;
    sh:message "ENG-DP-004: this FoulingPoint stands on a LinearElement that is neither of the two the Crossing occupies. A fouling point marks where a vehicle on one track begins to foul the other, and it is only meaningful on a track that actually passes through the crossing; on a third element it describes clearance at a place where nothing crosses, so a route may be set over one track while a vehicle stands foul on the other. Either move the fouling point onto one of the crossing's own elements, or attach it to the crossing it really belongs to."@en ;
    sh:message "ENG-DP-004: dieser FoulingPoint steht auf einem LinearElement, das keines der beiden ist, die die Crossing belegt. Ein Grenzzeichen markiert die Stelle, an der ein Fahrzeug auf einem Gleis beginnt, das andere zu gefährden, und es ist nur auf einem Gleis sinnvoll, das tatsächlich durch die Kreuzung verläuft; auf einem dritten Element beschreibt es einen Freiraum an einer Stelle, an der sich nichts kreuzt, sodass eine Fahrstraße über ein Gleis gestellt werden kann, während ein Fahrzeug das andere gefährdet. Entweder das Grenzzeichen auf eines der eigenen Elemente der Kreuzung verschieben, oder es der Kreuzung zuordnen, zu der es tatsächlich gehört."@de ;
    sh:message "ENG-DP-004: ce FoulingPoint se trouve sur un LinearElement qui n'est ni l'un ni l'autre des deux que le Crossing occupe. Un point d'encombrement marque l'endroit où un véhicule sur une voie commence à encombrer l'autre, et il n'a de sens que sur une voie qui traverse effectivement le croisement ; sur un troisième élément, il décrit un dégagement à un endroit où rien ne se croise, si bien qu'un itinéraire peut être établi sur une voie pendant qu'un véhicule en encombre une autre. Déplacez le point d'encombrement sur l'un des éléments propres au croisement, ou rattachez-le au croisement auquel il appartient réellement."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value
        WHERE {
            $this era:foulingPoints ?value .

            # SINGULAR on the fouling point, and direct - no NetPointReference
            ?value era:topologicalCoordinate/era:onLinearElement ?fle .

            # topologicalCoordinates comes from the INFRA description of this same
            # node. Absent, the infra half was not loaded; do not speak.
            FILTER EXISTS { $this era:topologicalCoordinates ?anyTc }

            # PLURAL on the crossing, and also direct
            FILTER NOT EXISTS {
                $this era:topologicalCoordinates/era:onLinearElement ?fle .
            }
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-005  Every fouling point of a switch must stand on a LinearElement that
#              one of the switch's own branch relations connects.
#
#     for all sw, for all fp in sw.foulingPoints:
#         fp.topologicalCoordinate.onLinearElement in connected( sw )
#
#     where  connected(sw) = { elementA(nr), elementB(nr)
#                              : nr in { sw.leftBranch, sw.rightBranch } }
#
#  and connects(nr, le) holds when le is EITHER of the relation's two elements,
#  as given. The set is therefore the four element slots of the two branch
#  relations, which by infra's DP-013 resolve to three distinct ends and in
#  practice to three elements: the common track and the two divergences.
#
#  THE SISTER OF ENG-DP-004, and the difference is where the admissible elements
#  come from. A Crossing states its own extent directly, in its two
#  topologicalCoordinates. A Switch does not: it names two NetRelations, and the
#  elements must be read off those. So this rule reaches ONE HOP FURTHER, and the
#  NetRelation objects themselves must be in the graph, not merely referenced.
#
#  CROSS-MODULE ON ONE NODE, again. eng.json's Switch declares foulingPoints,
#  tipShift, bladeLength and the two route properties; leftBranch and rightBranch
#  belong to infra.json's Switch. One Switch instance carries both.
#
#  THE GUARD REQUIRES BOTH BRANCHES TO RESOLVE, and this is deliberate rather than
#  incidental. A guard that merely asked for SOME connected element would leave the
#  rule half-informed when one branch resolves and the other does not - the
#  admissible set would then hold only the elements of the branch that happened to
#  load, and a fouling point on the missing branch's element would be reported as
#  though it were misplaced. That is a false accusation produced by incomplete
#  data, which is the worst kind. Requiring both branches means the rule speaks
#  only when it knows the switch's full extent, and is silent otherwise - silence
#  for want of data, as everywhere else in this file.
#
#  Rationale: a fouling point at a switch is the place beyond which a vehicle
#  standing on one leg will foul a movement over another - it is what clearance is
#  measured to, and what decides whether a route may be set over one leg while a
#  vehicle stands on another. It is only meaningful on a leg of that switch. A
#  fouling point on some unrelated element describes clearance where the switch has
#  no reach at all, so the protection is computed for the wrong ground and two
#  conflicting movements over the switch can be authorised at once. Since a switch
#  is precisely the place where two movements can be brought into conflict, this is
#  the rule's sharpest form.
#
#  LIMITATION - ELEMENT membership, not END membership, exactly as the given
#  definition of connects states. The rule does not ask which END of the element
#  the switch reaches, so a fouling point at the far end of a long common track,
#  hundreds of metres from the switch, is accepted. That is the same distinction
#  infra's DP-012 and DP-013 turn on, where reasoning about (element, isOnOrigin)
#  pairs rather than elements is what makes those rules correct. Tightening this
#  one would need a decision on how far from the switch a fouling point may lie,
#  which is a figure only you can supply - and note it is the same open question
#  left by ENG-DP-004.
#
#  REPORTING - foulingPoints is a REFERENCE, so the fouling points carry IRIs and
#  sh:value is the offending point itself. One finding per misplaced point.
#
################################################################################

eng-dp:Switch-ENGDP005
    a sh:NodeShape ;
    sh:targetClass era:Switch ;
    rdfs:label "ENG-DP-005 fouling points must lie on a leg of their own switch"@en ;
    era:additionalInfo "A Switch does not state its own physical extent directly - instead it names two relations, leftBranch and rightBranch, and the elements that actually belong to the switch are read off those relations. Every FoulingPoint the Switch owns must stand on one of the elements reachable through leftBranch or rightBranch. foulingPoints is a reference, not a composition, so sh:value in the report identifies the specific fouling point directly. GUARD: this rule only evaluates a Switch if BOTH leftBranch and rightBranch fully resolve to an actual element - not merely that the branch property exists, but that it successfully leads to one. If either branch's data is incomplete or missing, this rule stays silent for that switch rather than reporting anything, since checking against only half the switch's true extent could wrongly flag a correctly placed fouling point as misplaced. LIMITATION: this checks only whether the fouling point's element is one the switch reaches at all - it does not check how far along that element the point sits. A fouling point positioned far from the switch itself, on an otherwise correct element, will still pass."@en ;
    era:additionalInfo "Eine Weiche gibt ihre eigene physische Ausdehnung nicht direkt an - stattdessen benennt sie zwei Relationen, leftBranch und rightBranch, und die tatsächlich zur Weiche gehörenden Elemente werden aus diesen Relationen ausgelesen. Jeder FoulingPoint, den die Weiche besitzt, muss auf einem der über leftBranch oder rightBranch erreichbaren Elemente stehen. foulingPoints ist eine Referenz, keine Komposition, daher identifiziert sh:value im Bericht das konkrete Grenzzeichen direkt. ABSICHERUNG: diese Regel bewertet eine Weiche nur, wenn SOWOHL leftBranch ALS AUCH rightBranch vollständig zu einem tatsächlichen Element aufgelöst werden können - nicht nur, dass die Branch-Eigenschaft existiert, sondern dass sie erfolgreich zu einem Element führt. Sind die Daten eines der beiden Zweige unvollständig oder fehlen sie, bleibt diese Regel für diese Weiche stumm, anstatt etwas zu melden, da eine Prüfung gegen nur die halbe tatsächliche Ausdehnung der Weiche ein korrekt platziertes Grenzzeichen fälschlich als falsch platziert kennzeichnen könnte. EINSCHRÄNKUNG: dies prüft nur, ob das Element des Grenzzeichens überhaupt von der Weiche erreicht wird - nicht, wie weit entlang dieses Elements der Punkt liegt. Ein Grenzzeichen, das weit von der Weiche entfernt auf einem ansonsten korrekten Element positioniert ist, besteht die Prüfung dennoch."@de ;
    era:additionalInfo "Un Switch n'indique pas directement sa propre étendue physique - il nomme à la place deux relations, leftBranch et rightBranch, et les éléments appartenant réellement à l'aiguillage sont lus à partir de ces relations. Chaque FoulingPoint que l'aiguillage possède doit se trouver sur l'un des éléments accessibles via leftBranch ou rightBranch. foulingPoints est une référence, non une composition, donc sh:value dans le rapport identifie directement le point d'encombrement concerné. GARDE-FOU : cette règle n'évalue un Switch que si leftBranch ET rightBranch se résolvent tous deux entièrement vers un élément réel - pas seulement que la propriété de branche existe, mais qu'elle mène effectivement à un élément. Si les données de l'une des deux branches sont incomplètes ou absentes, cette règle reste silencieuse pour cet aiguillage plutôt que de signaler quoi que ce soit, car vérifier par rapport à seulement la moitié de l'étendue réelle de l'aiguillage pourrait signaler à tort un point d'encombrement correctement placé comme mal positionné. LIMITATION : ceci vérifie uniquement si l'élément du point d'encombrement est l'un de ceux atteints par l'aiguillage - pas la distance à laquelle le point se trouve le long de cet élément. Un point d'encombrement positionné loin de l'aiguillage lui-même, sur un élément par ailleurs correct, réussira tout de même cette vérification."@fr ;
    sh:sparql eng-dp:ENGDP005-foulingPointOffTheSwitch ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP005-foulingPointOffTheSwitch
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-005"@en ;
    sh:message "ENG-DP-005: this FoulingPoint stands on a LinearElement that neither of the Switch's branch relations connects. A fouling point at a switch marks where a vehicle on one leg begins to foul a movement over another, so it is only meaningful on a leg of that switch; on an unrelated element it describes clearance where the switch has no reach, and a route may be set over one leg while a vehicle stands foul on another. Either move the fouling point onto one of the elements named by the switch's leftBranch or rightBranch, or attach it to the switch it really belongs to."@en ;
    sh:message "ENG-DP-005: dieser FoulingPoint steht auf einem LinearElement, das von keiner der beiden Branch-Relationen des Switch verbunden wird. Ein Grenzzeichen an einer Weiche markiert die Stelle, an der ein Fahrzeug auf einem Strang beginnt, eine Bewegung auf dem anderen zu gefährden, und es ist daher nur auf einem Strang dieser Weiche sinnvoll; auf einem nicht zugehörigen Element beschreibt es einen Freiraum, den die Weiche gar nicht erreicht, und eine Fahrstraße kann über einen Strang gestellt werden, während ein Fahrzeug den anderen gefährdet. Entweder das Grenzzeichen auf eines der von leftBranch oder rightBranch der Weiche benannten Elemente verschieben, oder es der Weiche zuordnen, zu der es tatsächlich gehört."@de ;
    sh:message "ENG-DP-005: ce FoulingPoint se trouve sur un LinearElement qu'aucune des deux relations de branche du Switch ne relie. Un point d'encombrement au niveau d'un aiguillage marque l'endroit où un véhicule sur un brin commence à encombrer un mouvement sur un autre, il n'a donc de sens que sur un brin de cet aiguillage ; sur un élément non lié, il décrit un dégagement que l'aiguillage n'atteint pas, et un itinéraire peut être établi sur un brin pendant qu'un véhicule en encombre un autre. Déplacez le point d'encombrement sur l'un des éléments désignés par leftBranch ou rightBranch de l'aiguillage, ou rattachez-le à l'aiguillage auquel il appartient réellement."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value
        WHERE {
            $this era:foulingPoints ?value .

            # a fouling point carries its coordinate DIRECTLY - no NetPointReference
            ?value era:topologicalCoordinate/era:onLinearElement ?fle .

            # leftBranch and rightBranch come from the INFRA description of this
            # same node, and the NetRelations they name must themselves be in the
            # graph. BOTH branches must resolve: knowing only half the switch's
            # extent would turn a missing relation into a false accusation.
            FILTER EXISTS {
                $this era:leftBranch/(era:elementA|era:elementB) ?anyLeft .
            }
            FILTER EXISTS {
                $this era:rightBranch/(era:elementA|era:elementB) ?anyRight .
            }

            # connects(nr, le) : le is EITHER element of the relation
            FILTER NOT EXISTS {
                $this (era:leftBranch|era:rightBranch)/(era:elementA|era:elementB) ?fle .
            }
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-006  A balise's position in its group must lie within the group.
#
#     for all bg, for all b in bg.balises:
#         b.n_pig <= |bg.balises| - 1        equivalently  b.n_pig < |bg.balises|
#
#  n_pig is the balise's position WITHIN the group, counted from ZERO: n_pig 0 is
#  the first balise, 1 the second, and so on. A group of three balises therefore
#  admits n_pig 0, 1 and 2 only, and an n_pig of 3 or more names a position the
#  group does not have.
#
#  WHAT THE STRUCTURAL SHAPES ALREADY DO, AND WHY THIS IS STILL NEEDED. eng-shapes
#  enforces n_pig's declared range of 0..7, and infra-shapes enforces the balises
#  list bound of 1..8. Between them they guarantee only that n_pig is a position
#  SOME group could have. They say nothing about THIS group: a two-balise group
#  whose second balise carries n_pig 6 passes both, because 6 is in 0..7 and 2 is
#  in 1..8. It is the RELATIVE bound - n_pig against the size of its own group -
#  that no declared constraint can express, and that is what this rule adds.
#
#  Rationale: an on-board reads the balises of a group as it passes over them and
#  uses n_pig to know which one it has just read and how many are still to come.
#  A value outside the group's actual size tells it to expect a balise that does
#  not exist, so the group is never completed and the reading is discarded or
#  reported as an error - and a balise group that cannot be read is a position
#  reference lost at exactly the point where it was meant to be gained.
#
#  CROSS-MODULE, and split unusually. n_pig belongs to eng.json's Balise; the
#  balises list belongs to infra.json's BaliseGroup - eng.json's BaliseGroup
#  declares only id, etcsMVersion and q_link. So the group's membership comes from
#  one module and the position from the other, and both must be in the graph. If
#  the eng half is absent no balise has an n_pig and nothing is compared; if the
#  infra half is absent there is no list to size. Either way the rule is silent for
#  want of data.
#
#  THE COUNT IS OF SLOTS, NOT OF DISTINCT BALISES, and the difference matters on
#  defective data. A list naming the same balise twice has three slots but two
#  distinct balises; counting the latter would shrink the admissible range and
#  report an n_pig that is in fact correct for its position. The repeated balise is
#  a defect, but it is not this rule's, and manufacturing a second finding from it
#  would mislead. Counting list CELLS avoids that.
#
#  A NESTED AGGREGATE IS USED, which needs care under pySHACL: a nested SELECT must
#  itself select every pre-bound variable, or validation fails outright with "All
#  potentially pre-bound variables must be selected from a nested SELECT query".
#  The inner SELECT therefore projects $this alongside the count and groups by it.
#  Doing the aggregation at the top level instead would have forced the finding to
#  name only the GROUP and its worst n_pig; nesting keeps the offending BALISE as
#  the value node, which is what a preparer needs.
#
#  BOTH SERIALISATIONS ARE COUNTED. The list form is walked cell by cell; a second
#  branch counts the direct objects of era:balises for the non-list form, excluding
#  anything that is itself a list cell so that the two branches cannot double-count,
#  and excluding rdf:nil so that an EMPTY list counts zero rather than one. Every
#  one of these cases was checked against known counts before the rule was written.
#
#  NOT COVERED, and worth a rule of its own: nothing here requires the n_pig values
#  within a group to be DISTINCT, nor to cover 0 .. n-1 exactly. Two balises both
#  carrying n_pig 0, or a three-balise group numbered 0, 1, 1, satisfy this rule
#  while being just as unreadable on board. That is the natural companion to this
#  one and is a straightforward addition if you want it.
#
################################################################################

eng-dp:BaliseGroup-ENGDP006
    a sh:NodeShape ;
    sh:targetClass era:BaliseGroup ;
    rdfs:label "ENG-DP-006 a balise's n_pig must lie within its own group"@en ;
    era:additionalInfo " n_pig is a balise's position within its own group, counted from zero - the first balise is 0, the second is 1, and so on. A group with 3 balises therefore only accepts n_pig values 0, 1, or 2; anything higher names a position the group does not actually have. This rule catches cases where n_pig has a value that looks individually plausible but does not match the actual size of the specific group it belongs to - a value can be a perfectly normal number and still be wrong for a smaller group than expected. The group's size is counted as the number of list positions (slots) it has, not the number of distinct balises - if the same balise is listed twice, that counts as two separate positions, since each position is what an on-board system expects to encounter as it passes over the group, regardless of whether the same physical balise happens to appear more than once. If a balise has no n_pig value at all, or if the group's balise list cannot be read, no comparison is made and this rule stays silent for that case rather than reporting anything. LIMITATION: this rule only checks that n_pig fits within the group's size - it does not check that n_pig values within a group are distinct or that they cover every position from 0 upward without gaps. A group where two balises both carry n_pig 0, or where the values are 0, 1, 1, would still pass this rule despite being just as unreadable to an on-board system."@en ;
    era:additionalInfo " n_pig ist die Position einer Balise innerhalb ihrer eigenen Gruppe, gezählt ab null - die erste Balise ist 0, die zweite 1, und so weiter. Eine Gruppe mit 3 Balisen akzeptiert daher nur die n_pig-Werte 0, 1 oder 2; jeder höhere Wert bezeichnet eine Position, die die Gruppe nicht tatsächlich besitzt. Diese Regel erfasst Fälle, in denen n_pig einen für sich genommen plausibel wirkenden Wert trägt, der jedoch nicht zur tatsächlichen Größe der konkreten Gruppe passt, zu der er gehört - ein Wert kann eine völlig normale Zahl sein und dennoch für eine kleinere Gruppe als erwartet falsch sein. Die Größe der Gruppe wird als Anzahl der Listenpositionen (Slots) gezählt, nicht als Anzahl unterschiedlicher Balisen - erscheint dieselbe Balise zweimal in der Liste, zählt dies als zwei getrennte Positionen, da jede Position das ist, was ein Fahrzeuggerät beim Überfahren der Gruppe zu erwarten hat, unabhängig davon, ob dieselbe physische Balise mehrfach auftritt. Besitzt eine Balise überhaupt keinen n_pig-Wert, oder kann die Balisenliste der Gruppe nicht gelesen werden, erfolgt kein Vergleich, und diese Regel bleibt für diesen Fall stumm, anstatt etwas zu melden. EINSCHRÄNKUNG: diese Regel prüft nur, ob n_pig innerhalb der Gruppengröße liegt - sie prüft nicht, ob die n_pig-Werte innerhalb einer Gruppe eindeutig sind oder ob sie jede Position ab 0 lückenlos abdecken. Eine Gruppe, in der zwei Balisen beide n_pig 0 tragen, oder in der die Werte 0, 1, 1 lauten, würde diese Regel dennoch bestehen, obwohl sie für ein Fahrzeuggerät ebenso unlesbar wäre."@de ;
    era:additionalInfo " n_pig est la position d'une balise au sein de son propre groupe, comptée à partir de zéro - la première balise est 0, la deuxième est 1, et ainsi de suite. Un groupe de 3 balises n'accepte donc que les valeurs n_pig 0, 1 ou 2 ; toute valeur supérieure désigne une position que le groupe ne possède pas réellement. Cette règle détecte les cas où n_pig porte une valeur qui semble plausible en elle-même mais qui ne correspond pas à la taille réelle du groupe spécifique auquel elle appartient - une valeur peut être un nombre parfaitement normal tout en étant incorrecte pour un groupe plus petit que prévu. La taille du groupe est comptée comme le nombre de positions de liste (emplacements) qu'il possède, et non comme le nombre de balises distinctes - si la même balise apparaît deux fois dans la liste, cela compte comme deux positions distinctes, car chaque position est ce qu'un équipement embarqué s'attend à rencontrer en franchissant le groupe, que la même balise physique apparaisse plusieurs fois ou non. Si une balise ne possède aucune valeur n_pig, ou si la liste de balises du groupe ne peut être lue, aucune comparaison n'est effectuée et cette règle reste silencieuse pour ce cas plutôt que de signaler quoi que ce soit. LIMITATION : cette règle vérifie uniquement que n_pig se situe dans la taille du groupe - elle ne vérifie pas que les valeurs n_pig au sein d'un groupe sont distinctes, ni qu'elles couvrent chaque position à partir de 0 sans lacune. Un groupe où deux balises portent toutes deux n_pig 0, ou où les valeurs sont 0, 1, 1, réussirait tout de même cette règle bien qu'il soit tout aussi illisible pour un équipement embarqué."@fr ;
    sh:sparql eng-dp:ENGDP006-nPigOutsideGroupSize ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP006-nPigOutsideGroupSize
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-006"@en ;
    sh:message "ENG-DP-006: this Balise carries n_pig {?npig}, but its BaliseGroup holds only {?n} balises. n_pig is the position of the balise within the group counted from zero, so the highest value this group admits is {?n} minus one. An on-board uses n_pig to know which balise it has read and how many remain; a position the group does not have leaves the group incomplete and the reading is lost. Either correct n_pig, or add the balises the group is missing."@en ;
    sh:message "ENG-DP-006: diese Balise trägt n_pig {?npig}, aber ihre BaliseGroup enthält nur {?n} Balisen. n_pig ist die von null gezählte Position der Balise innerhalb der Gruppe, der höchste von dieser Gruppe zulässige Wert ist also {?n} minus eins. Ein Fahrzeugerät nutzt n_pig, um zu erkennen, welche Balise es gelesen hat und wie viele noch ausstehen; eine Position, die die Gruppe nicht besitzt, lässt die Gruppe unvollständig erscheinen und die Lesung geht verloren. Entweder n_pig korrigieren, oder die fehlenden Balisen der Gruppe ergänzen."@de ;
    sh:message "ENG-DP-006: cette Balise porte n_pig {?npig}, mais son BaliseGroup ne contient que {?n} balises. n_pig est la position de la balise au sein du groupe, comptée à partir de zéro ; la valeur la plus élevée admise par ce groupe est donc {?n} moins un. Un équipement embarqué utilise n_pig pour savoir quelle balise il vient de lire et combien il en reste ; une position que le groupe ne possède pas laisse le groupe incomplet et la lecture est perdue. Corrigez n_pig, ou ajoutez les balises manquantes au groupe."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?npig ?n
        WHERE {
            # The size of THIS group. A nested SELECT must project every pre-bound
            # variable, so $this is selected and grouped by; without that pySHACL
            # rejects the query outright.
            {
                SELECT $this (COUNT(DISTINCT ?slot) AS ?n)
                WHERE {
                    # list form: one slot per cell, so a repeated balise still
                    # counts as the two positions it occupies
                    {   $this era:balises/rdf:rest* ?slot .
                        ?slot rdf:first ?anyB .
                    }
                    UNION
                    # non-list form: the balises themselves are the slots. List
                    # cells are excluded so the branches cannot double-count, and
                    # rdf:nil is excluded so an EMPTY list counts zero, not one.
                    {   $this era:balises ?slot .
                        FILTER ( ?slot != rdf:nil )
                        FILTER NOT EXISTS { ?slot rdf:first ?anyCell }
                    }
                }
                GROUP BY $this
            }

            # the balises themselves, in either serialisation
            {   $this era:balises/rdf:rest*/rdf:first ?value . }
            UNION
            {   $this era:balises ?value . }

            # n_pig comes from the ENG description of the balise; absent, there is
            # nothing to judge and no row is produced
            ?value era:n_pig ?npig .

            FILTER ( ?npig >= ?n )
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-007  ADVISORY - every LinearElement should have a speed profile.
#
#     for all le:  exists lesp of class LinearElementSpeedProfile
#                      with lesp.linearElement = le
#
#  WHY THIS RULE LIVES IN THE ENG SET THOUGH BOTH ITS CLASSES ARE INFRA'S.
#  LinearElement and LinearElementSpeedProfile are both declared in infra.json, and
#  on first reading that puts the rule in infra-dataprep-shapes.ttl. It does not,
#  and the reason is worth stating because it decides where several future rules
#  will go.
#
#  An infra dataset that describes elements without speed profiles is NOT defective.
#  PropertiesArea.linearElementSpeedProfiles is "*", and a topology-and-geometry
#  description that says nothing about permitted speeds is a complete, coherent
#  thing in its own right. There is no fault to report against infra alone.
#
#  The absence only BECOMES a problem for a consumer assembling infra together with
#  eng - the point at which the data is expected to describe railway that can
#  actually be run over, and at which a missing permitted speed stops being an
#  omission and starts being a gap in what the combined description promises. The
#  rule therefore belongs to the reading that makes it a fault, not to the module
#  that happens to declare the classes.
#
#  The practical consequence: validate infra on its own and this rule is not
#  applied at all, which is correct. Validate infra together with eng and it is.
#
#  SEVERITY sh:Warning, for the same reason and by the same reading. Even in the
#  combined setting the absence may be deliberate or may simply lie in another
#  file, so it is raised as advice. Under allow_warnings it does not block; a strict
#  pass still does.
#
#  Rationale for caring at all: a speed profile is what says how fast a train may
#  run over an element. Without one a consumer must either refuse to route over the
#  element - turning usable railway into a barrier - or invent a limit, by carrying
#  the previous element's speed forward or falling back on a default, and present
#  the invention as data. The element itself is perfectly well formed; the fault is
#  an ABSENCE, which no per-object rule can see.
#
#  SHACL CORE, no SPARQL: an INVERSE path from the element back to whatever points
#  at it, exactly as infra's DP-004 does for NetRelations.
#
#  THE CLASS FILTER IS LOAD-BEARING. SIX classes across four modules carry an
#  era:linearElement reference:
#
#      infra   LinearElementSpeedProfile   LinearElementGeometry
#              SampledLinearElementGeometry
#      eng     LinearElementKm   LinearElementAccuracyProfile
#      map     LinearElementProjection
#
#  KmArea was a seventh until a model defect was corrected: its second attribute
#  referenced a LinearElement while its own id carried sameKeyAs infra.TopoArea, and
#  both its sibling area classes reference a TopoArea. It now reads era:topoArea.
#
#  A bare inverse path is satisfied by any of them, so an element with a geometry
#  but no speed profile would pass. sh:qualifiedValueShape with
#  sh:class era:LinearElementSpeedProfile is what narrows it, and there is a test
#  for exactly that case.
#
#  IT DEPENDS ON THE PROFILE BEING TYPED, since sh:class matches on rdf:type. An
#  untyped LinearElementSpeedProfile leaves its element advised as having none.
#  That missing type is a structural fault infra-shapes.ttl reports, and the same
#  dependence is accepted in DP-004.
#
#  IT EXPECTS THE COMPLETE DATASET. Validating one PropertiesArea, or a fragment of
#  a TopoArea, will advise on every element whose profile lies outside the fragment.
#  This was measured rather than assumed: as a Violation the rule reported ten of
#  the eleven fixtures and examples in this repository, none of which is wrong - a
#  worked example about a crossover has no business carrying five speed profiles.
#
#  NOT COVERED - nothing here forbids TWO speed profiles for one element, which
#  would be ambiguous: a LinearElementSpeedProfile already carries both directions
#  in sameDirProfile and oppositeDirProfile, so a second profile object for the
#  same element leaves no way to say which governs.
#
################################################################################

eng-dp:LinearElement-ENGDP007
    a sh:NodeShape ;
    sh:targetClass era:LinearElement ;
    rdfs:label "ENG-DP-007 every linear element should have a speed profile"@en ;
    era:additionalInfo " This checks whether at least one properly-typed LinearElementSpeedProfile object points back at this LinearElement through its own linearElement property. Having a geometry, a kilometre profile, or a map projection reference this element does NOT satisfy the check - only an actual speed profile object does, and that object must itself be correctly typed as a LinearElementSpeedProfile; if a speed profile object exists and references this element but is missing its own type declaration, this element will still be advised as having none. This is raised as an advisory (a warning, not a hard violation) rather than an error, for two practical reasons: first, an element with no speed profile is not necessarily wrong on its own - it only becomes worth flagging when speed and infrastructure data are meant to be combined into a complete, runnable description; second, if you are validating only part of the full dataset (a single area, or a subset of the network), elements whose speed profile happens to live in a different, currently unloaded part of the data will also be advised here, even though the complete dataset may be entirely correct. This advisory is expected to appear normally when validating partial or example data, and does not by itself indicate a real problem - it is most meaningful when run against a complete, combined dataset."@en ;
    era:additionalInfo " Diese Prüfung untersucht, ob mindestens ein korrekt typisiertes LinearElementSpeedProfile-Objekt über seine eigene linearElement-Eigenschaft auf dieses LinearElement zurückverweist. Eine Geometrie, ein Kilometerprofil oder eine Kartenprojektion, die auf dieses Element verweisen, erfüllen diese Prüfung NICHT - nur ein tatsächliches Geschwindigkeitsprofil-Objekt tut dies, und dieses Objekt muss selbst korrekt als LinearElementSpeedProfile typisiert sein; existiert ein Geschwindigkeitsprofil-Objekt, das dieses Element referenziert, aber seine eigene Typangabe fehlt, wird dieses Element weiterhin als ohne Profil gekennzeichnet. Dies wird als Hinweis (eine Warnung, kein harter Verstoß) und nicht als Fehler gemeldet, aus zwei praktischen Gründen: erstens ist ein Element ohne Geschwindigkeitsprofil für sich genommen nicht zwangsläufig falsch - es wird erst dann meldenswert, wenn Geschwindigkeits- und Infrastrukturdaten zu einer vollständigen, befahrbaren Beschreibung kombiniert werden sollen; zweitens werden, wenn nur ein Teil des vollständigen Datensatzes validiert wird (ein einzelner Bereich oder ein Ausschnitt des Netzes), auch Elemente gemeldet, deren Geschwindigkeitsprofil sich in einem anderen, derzeit nicht geladenen Teil der Daten befindet, selbst wenn der vollständige Datensatz durchaus korrekt ist. Dieser Hinweis tritt normalerweise bei der Validierung partieller Daten oder Beispieldaten auf und weist für sich genommen nicht zwingend auf ein tatsächliches Problem hin - er ist am aussagekräftigsten bei der Ausführung gegen einen vollständigen, kombinierten Datensatz."@de ;
    era:additionalInfo " Cette vérification examine si au moins un objet LinearElementSpeedProfile correctement typé référence en retour ce LinearElement via sa propre propriété linearElement. Le fait qu'une géométrie, un profil kilométrique ou une projection cartographique référencent cet élément ne satisfait PAS cette vérification - seul un véritable objet de profil de vitesse le fait, et cet objet doit lui-même être correctement typé comme LinearElementSpeedProfile ; si un objet de profil de vitesse existe et référence cet élément mais que son propre type est absent, cet élément sera tout de même signalé comme n'en ayant aucun. Ceci est signalé comme un avis (un avertissement, non une violation stricte) plutôt qu'une erreur, pour deux raisons pratiques : premièrement, un élément sans profil de vitesse n'est pas nécessairement erroné en soi - cela ne devient pertinent que lorsque les données de vitesse et d'infrastructure sont censées être combinées en une description complète et exploitable ; deuxièmement, si vous ne validez qu'une partie du jeu de données complet (une seule zone, ou un sous-ensemble du réseau), les éléments dont le profil de vitesse se trouve dans une autre partie des données non chargée actuellement seront également signalés ici, même si le jeu de données complet est par ailleurs entièrement correct. Cet avis apparaît normalement lors de la validation de données partielles ou d'exemples, et n'indique pas en soi un problème réel - il est le plus pertinent lorsqu'il est exécuté sur un jeu de données complet et combiné."@fr ;
    sh:property eng-dp:ENGDP007-hasSpeedProfile ;
    .

eng-dp:ENGDP007-hasSpeedProfile
    a sh:PropertyShape ;
    rdfs:label "ENG-DP-007"@en ;
    sh:path [ sh:inversePath era:linearElement ] ;
    sh:qualifiedValueShape [ sh:class era:LinearElementSpeedProfile ] ;
    sh:qualifiedMinCount 1 ;
    sh:message "ENG-DP-007 (advisory): no LinearElementSpeedProfile references this LinearElement, so no permitted speed is defined for it. A consumer must then either refuse to route over the element or invent a limit - by carrying the previous element's speed forward, or falling back on a default - and present the invention as data. Note this is not a fault in infra data on its own, where speed profiles are optional; it is raised for datasets that combine infra with eng and are expected to describe runnable railway. Note also that a geometry, a kilometre profile or a projection referencing this element does not satisfy the rule; a speed profile specifically is required, and the complete dataset is expected."@en ;
    sh:message "ENG-DP-007 (Hinweis): keine LinearElementSpeedProfile referenziert dieses LinearElement, es ist also keine zulässige Geschwindigkeit für es definiert. Ein Konsument muss dann entweder das Befahren des Elements ablehnen oder eine Grenze erfinden - indem er die Geschwindigkeit des vorherigen Elements fortschreibt oder auf einen Standardwert zurückfällt - und diese Erfindung als Daten ausgeben. Hinweis: Dies ist für sich genommen kein Fehler in Infrastrukturdaten, wo Geschwindigkeitsprofile optional sind; es wird für Datensätze gemeldet, die Infrastruktur mit Engineering-Daten kombinieren und daher eine befahrbare Strecke beschreiben sollen. Hinweis auch: Eine Geometrie, ein Kilometerprofil oder eine Projektion, die dieses Element referenzieren, erfüllen diese Regel nicht; ein Geschwindigkeitsprofil ist speziell erforderlich, und der vollständige Datensatz wird erwartet."@de ;
    sh:message "ENG-DP-007 (avis): aucun LinearElementSpeedProfile ne référence ce LinearElement, aucune vitesse autorisée n'est donc définie pour lui. Un consommateur doit alors soit refuser de faire circuler un mouvement sur cet élément, soit inventer une limite - en reportant la vitesse de l'élément précédent, ou en se rabattant sur une valeur par défaut - et présenter cette invention comme une donnée. Notez que ceci n'est pas en soi une erreur dans des données infra, où les profils de vitesse sont optionnels ; ceci est signalé pour les jeux de données qui combinent infra et eng et sont donc censés décrire une voie ferroviaire exploitable. Notez également qu'une géométrie, un profil kilométrique ou une projection référençant cet élément ne satisfait pas la règle ; un profil de vitesse est spécifiquement requis, et le jeu de données complet est attendu."@fr ;
    sh:severity sh:Warning ;
    .


################################################################################
#
#  ENG-DP-008  (P-07)  ADVISORY - a speed profile should start at the element
#                      origin.
#
#     for all lesp, for all sp in { lesp.sameDirProfile, lesp.oppositeDirProfile }:
#         sp.staticSpeedProfile non-empty
#         =>  exists l in sp.staticSpeedProfile:  l.pos = 0
#
#  WHY THIS SITS IN THE ENG SET, like ENG-DP-007 and for the same reason. Both
#  classes are infra's, but an infra dataset is not defective for saying nothing
#  about permitted speeds - PropertiesArea.linearElementSpeedProfiles is "*". The
#  gap only matters to a consumer assembling infra with eng, at the point where the
#  data is expected to describe railway that can actually be run over. ENG-DP-007
#  asks whether an element has a profile at all; this asks whether the profile it
#  has covers the element from its start. They are two halves of one question and
#  belong together.
#
#  Rationale: a static speed limit applies FROM its position onwards, until the
#  next one takes over. If the lowest position in a profile is 250 m, then the first
#  250 m of the element has no permitted speed at all - not an unrestricted stretch,
#  an undefined one. A consumer must either refuse to run there or carry a speed in
#  from somewhere else: from the previous element, from a line default, or by
#  extending the first limit backwards. Each of those is a guess, and the guess is
#  indistinguishable from data once it has been made.
#
#  This is the same shape of defect as DP-027a in the infra set, which requires cant
#  to be defined from the element's origin, and the same argument applies: it is the
#  OPENING stretch that has nothing to fall back on, because there is nothing before
#  it on the element to inherit from.
#
#  SEVERITY sh:Warning, at your instruction and for a defensible reason: a profile
#  beginning part way along MAY be intended, if the operator's convention is that a
#  speed is inherited from the preceding element until a new limit is declared.
#  Whether that convention holds is not something the data says, so the rule advises
#  rather than accuses. Under allow_warnings it does not block; a strict pass does.
#
#  PER DIRECTION. sameDirProfile is 1..1 and oppositeDirProfile is 0..1, and each is
#  a separate SpeedProfile that must stand on its own - a limit at the origin in one
#  direction says nothing about the other. The UNION keeps them apart and the
#  direction is named in the message.
#
#  MATCHED EXACTLY, WITH NO TOLERANCE, and this is a deliberate difference from
#  DP-024 and DP-027b which both take +/- 1 m. Those compare two independently
#  authored quantities - a transition position against a cant position, a cant
#  position against a recorded element length - and a metre absorbs the difference
#  in how the two were derived. Here the target is the CONSTANT zero: exactly
#  representable in xsd:double, and authored rather than computed. There is nothing
#  for a tolerance to absorb, and a speed limit at 0.5 m still leaves half a metre
#  undefined. Positions compare by VALUE, so a limit written 0 satisfies the test as
#  well as one written "0.0"^^xsd:double.
#
#  SCOPE - a SpeedProfile carrying no staticSpeedProfile at all is skipped: that is
#  a structural fault against the 1..* multiplicity, which infra-shapes.ttl reports,
#  and this rule has nothing to say about it.
#
#  NOT COVERED - the FAR end. Nothing here asks that the profile reach the element's
#  end, and nothing needs to: unlike cant, which is interpolated BETWEEN points, a
#  static limit EXTENDS from its position onwards, so the last limit already governs
#  to the end of the element. This is the same distinction that makes DP-038 check
#  only the origin while DP-027 checks both ends.
#
################################################################################

eng-dp:LinearElementSpeedProfile-ENGDP008
    a sh:NodeShape ;
    sh:targetClass era:LinearElementSpeedProfile ;
    rdfs:label "ENG-DP-008 a speed profile should start at the element origin"@en ;
    era:additionalInfo "This checks whether a LinearElementSpeedProfile - a record of permitted speed along an element - has a StaticSpeedLimit starting exactly at position 0. Speed limits apply from their stated position onward until the next one takes over, so if the first limit does not start at 0, the opening stretch of the element has no permitted speed defined at all, not merely an unrestricted one. This is checked separately for each of the two directions a profile can carry (sameDirProfile, always present, and oppositeDirProfile, present only where the element is bidirectional) - a limit at the origin in one direction says nothing about the other. This is raised as an advisory rather than a hard violation because starting partway through can be entirely legitimate: some operators use a convention where speed is inherited from the preceding element until a new limit is explicitly declared, and the data itself cannot say whether that convention applies. This check is only satisfied by a limit at exactly position 0, with no tolerance - unlike some other position-based checks elsewhere in this dataset that allow a small margin between independently measured quantities, position 0 here is a fixed, authored reference point rather than something independently measured, so there is nothing for a tolerance to reasonably absorb. This check only evaluates profiles that have at least one limit recorded at all; a profile with none is a separate, structural concern reported elsewhere."@en ;
    era:additionalInfo "Diese Prüfung untersucht, ob ein LinearElementSpeedProfile - eine Aufzeichnung der zulässigen Geschwindigkeit entlang eines Elements - ein StaticSpeedLimit besitzt, das genau bei Position 0 beginnt. Geschwindigkeitsbegrenzungen gelten ab ihrer angegebenen Position bis zur nächsten Begrenzung; beginnt die erste Begrenzung nicht bei 0, ist für den einleitenden Abschnitt des Elements überhaupt keine zulässige Geschwindigkeit definiert, nicht lediglich eine unbeschränkte. Dies wird für jede der beiden Richtungen, die ein Profil tragen kann, getrennt geprüft (sameDirProfile, immer vorhanden, und oppositeDirProfile, nur vorhanden, wenn das Element bidirektional ist) - eine Begrenzung am Ursprung in einer Richtung sagt nichts über die andere aus. Dies wird als Hinweis statt als harter Verstoß gemeldet, da ein Beginn auf halbem Weg durchaus legitim sein kann: manche Betreiber verwenden eine Konvention, nach der die Geschwindigkeit vom vorangehenden Element geerbt wird, bis eine neue Begrenzung ausdrücklich erklärt wird, und die Daten selbst können nicht aussagen, ob diese Konvention hier gilt. Diese Prüfung wird nur durch eine Begrenzung genau bei Position 0 erfüllt, ohne Toleranz - anders als bei einigen anderen positionsbasierten Prüfungen in diesem Datensatz, die einen kleinen Spielraum zwischen unabhängig gemessenen Größen zulassen, ist Position 0 hier ein fester, erfasster Bezugspunkt und keine unabhängig gemessene Größe, es gibt also nichts, was eine Toleranz sinnvoll auffangen könnte. Diese Prüfung bewertet nur Profile, die überhaupt mindestens eine erfasste Begrenzung besitzen; ein Profil ganz ohne Begrenzung ist ein separates, strukturelles Anliegen, das anderswo gemeldet wird."@de ;
    era:additionalInfo "Cette vérification examine si un LinearElementSpeedProfile - un enregistrement de la vitesse autorisée le long d'un élément - possède un StaticSpeedLimit commençant exactement à la position 0. Les limites de vitesse s'appliquent à partir de leur position indiquée jusqu'à ce que la suivante prenne le relais ; si la première limite ne commence pas à 0, le tronçon initial de l'élément n'a aucune vitesse autorisée définie, et non simplement une vitesse non restreinte. Ceci est vérifié séparément pour chacune des deux directions qu'un profil peut porter (sameDirProfile, toujours présent, et oppositeDirProfile, présent uniquement lorsque l'élément est bidirectionnel) - une limite à l'origine dans une direction ne dit rien de l'autre. Ceci est signalé comme un avis plutôt qu'une violation stricte car commencer en cours de tronçon peut être parfaitement légitime : certains exploitants utilisent une convention où la vitesse est héritée de l'élément précédent jusqu'à ce qu'une nouvelle limite soit explicitement déclarée, et les données elles-mêmes ne peuvent indiquer si cette convention s'applique. Cette vérification n'est satisfaite que par une limite exactement à la position 0, sans tolérance - contrairement à certaines autres vérifications basées sur la position ailleurs dans ce jeu de données qui admettent une petite marge entre des grandeurs mesurées indépendamment, la position 0 ici est un point de référence fixe et saisi plutôt qu'une grandeur mesurée indépendamment, il n'y a donc rien qu'une tolérance puisse raisonnablement absorber. Cette vérification n'évalue que les profils comportant au moins une limite enregistrée ; un profil n'en comportant aucune est une préoccupation distincte, de nature structurelle, signalée ailleurs."@fr ;
    sh:sparql eng-dp:ENGDP008-noSpeedLimitAtOrigin ;
    sh:severity sh:Warning ;
    .

eng-dp:ENGDP008-noSpeedLimitAtOrigin
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-008"@en ;
    sh:message "ENG-DP-008 (advisory): this LinearElementSpeedProfile's {?dir} has no StaticSpeedLimit at pos 0, so no permitted speed is defined from the element's origin up to the first limit. A static limit applies from its position onwards, so nothing covers the opening stretch and a consumer must either refuse to run there or carry a speed in from elsewhere - from the previous element, a line default, or by extending the first limit backwards - and present that guess as data. Add a limit at the origin, unless your convention is that the speed is inherited from the preceding element."@en ;
    sh:message "ENG-DP-008 (Hinweis): {?dir} dieser LinearElementSpeedProfile hat kein StaticSpeedLimit an Position 0, es ist also keine zulässige Geschwindigkeit vom Ursprung des Elements bis zur ersten Begrenzung definiert. Eine statische Begrenzung gilt ab ihrer Position, also deckt nichts den Anfangsabschnitt ab, und ein Konsument muss entweder das Befahren dort ablehnen oder eine Geschwindigkeit von anderswo übernehmen - vom vorherigen Element, einem Streckendefault, oder indem die erste Begrenzung rückwärts erweitert wird - und diese Vermutung als Daten ausgeben. Fügen Sie eine Begrenzung am Ursprung hinzu, es sei denn, Ihre Konvention sieht vor, dass die Geschwindigkeit vom vorangehenden Element geerbt wird."@de ;
    sh:message "ENG-DP-008 (avis): {?dir} de ce LinearElementSpeedProfile ne comporte aucun StaticSpeedLimit à la position 0, aucune vitesse autorisée n'est donc définie depuis l'origine de l'élément jusqu'à la première limite. Une limite statique s'applique à partir de sa position, rien ne couvre donc le tronçon initial, et un consommateur doit soit refuser d'y faire circuler un mouvement, soit importer une vitesse d'ailleurs - depuis l'élément précédent, une valeur par défaut de la ligne, ou en prolongeant la première limite vers l'arrière - et présenter cette suppositio comme une donnée. Ajoutez une limite à l'origine, à moins que votre convention ne prévoie que la vitesse est héritée de l'élément précédent."@fr ;
    sh:select """
        SELECT DISTINCT $this ?dir
        WHERE {
            {   $this era:sameDirProfile     ?sp . BIND("sameDirProfile"     AS ?dir) }
            UNION
            {   $this era:oppositeDirProfile ?sp . BIND("oppositeDirProfile" AS ?dir) }

            # only judge a profile that carries limits; an empty staticSpeedProfile
            # is a structural fault against 1..* that infra-shapes.ttl reports
            FILTER EXISTS { ?sp era:staticSpeedProfile/era:pos ?anyPos }

            FILTER NOT EXISTS {
                ?sp era:staticSpeedProfile ?l .
                ?l  era:pos ?pos .
                # the target is the CONSTANT zero, so no tolerance is applied here,
                # unlike DP-024 and DP-027b. Comparison is still BY VALUE.
                FILTER ( ?pos = 0 )
            }
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-009  (E-01)  An offset accuracy must not be stated beyond the end of the
#                      LinearElement whose accuracy it describes.
#
#     for all leap, for all oa in leap.offsetAccuracies:
#         oa.offset <= leap.linearElement.lengthOfNetLinearElement
#
#  LinearElementAccuracyProfile and OffsetAccuracy were, until this rule, the one
#  corner of eng.json that no rule touched at all. Their structure is an exact copy
#  of LinearElementKm and KilometricPost: an object anchored to a LinearElement by an
#  explicit era:linearElement reference, carrying an "ordered": "byIndex" list of
#  positioned members. ENG-DP-001 is therefore the template, and this rule follows it
#  down to the rdf:List walk and the tolerant non-list branch.
#
#  Rationale: accuracy is the statement of how far a recorded position may be from
#  the true one. It is what a consumer uses to decide how much to trust EVERY other
#  position on the element - whether two objects recorded 3 m apart are really
#  distinct, whether a balise is inside a section or just outside it, how much margin
#  a protection distance needs. Because the values are interpolated between offsets,
#  an accuracy stated beyond the element's end does not merely describe absent track:
#  it drags the interpolation over the whole stretch between itself and its
#  neighbour, so confidence is flattered or degraded along real track. That is a
#  quiet failure - nothing looks wrong, positions are simply trusted by the wrong
#  amount.
#
#  offsetAccuracies IS AN RDF LIST - "ordered": "byIndex" in eng.json, so the members
#  are the ITEMS of an rdf:List. era:offsetAccuracies alone reaches the list's first
#  CELL, which is not an OffsetAccuracy and carries no offset; a rule written that
#  way would match nothing and pass everything in silence. The items are reached with
#  era:offsetAccuracies/rdf:rest*/rdf:first, and a second UNION branch tolerates the
#  non-list form for the reason set out under infra's DP-016.
#
#  CROSS-MODULE - the length lives on an infra LinearElement. Validated without the
#  infra topology in the graph, the opening patterns match nothing and the rule is
#  silent: silence for want of the other half, not a clean bill of health.
#
#  SCOPE - no further guard is needed. A missing era:linearElement or
#  lengthOfNetLinearElement is a structural fault the respective -shapes.ttl reports.
#  offsetAccuracies is 0..*, so a profile with no members at all is legitimate and
#  this rule is vacuous on it. Comparison is by VALUE, so an offset written as a
#  plain integer is compared correctly against a double length.
#
#  REPORTING - the focus node is the LinearElementAccuracyProfile and sh:value is the
#  offending offset rather than the member, OffsetAccuracy being a composition and so
#  usually a blank node a preparer cannot look up. The accuracy value is carried in
#  the projection so that two members sharing one bad offset are reported separately.
#
#  NOT COVERED - an upper bound only, so a negative offset is accepted here, as
#  throughout ENG-DP-001 and the infra position rules. Nor is the accuracy VALUE
#  itself checked: an accuracy of zero claims a perfect position and is almost
#  certainly a placeholder, which is proposal E-11.
#
################################################################################

eng-dp:LinearElementAccuracyProfile-ENGDP009
    a sh:NodeShape ;
    sh:targetClass era:LinearElementAccuracyProfile ;
    rdfs:label "ENG-DP-009 an offset accuracy must not sit beyond the end of its linear element"@en ;
    era:additionalInfo "This checks each OffsetAccuracy's offset against the lengthOfNetLinearElement of the LinearElement its profile is anchored to - the offset must not exceed the element's length. It does not check the accuracy value itself, only its position; a zero or negative accuracy is a separate, unrelated concern. OffsetAccuracy is a composition with no IRI of its own, so the violation is reported against the parent LinearElementAccuracyProfile. SCOPE: this checks only the upper bound; a negative offset is not caught by this rule. Each member of the list is evaluated independently, so one profile can have some members pass and others fail."@en ;
    era:additionalInfo "Diese Regel prüft den offset jeder OffsetAccuracy gegen die lengthOfNetLinearElement des LinearElement, an dem ihr Profil verankert ist - der Offset darf die Länge des Elements nicht überschreiten. Sie prüft nicht den Genauigkeitswert selbst, nur dessen Position; eine Genauigkeit von null oder negativ ist ein separates, unabhängiges Anliegen. OffsetAccuracy ist eine Komposition ohne eigene IRI, daher wird der Verstoß gegen das übergeordnete LinearElementAccuracyProfile gemeldet. GELTUNGSBEREICH: diese Regel prüft nur die obere Grenze; ein negativer Offset wird von dieser Regel nicht erfasst. Jedes Mitglied der Liste wird unabhängig bewertet, sodass ein Profil teils bestehen, teils fehlschlagen kann."@de ;
    era:additionalInfo "Cette règle compare le offset de chaque OffsetAccuracy au lengthOfNetLinearElement du LinearElement auquel son profil est ancré - le décalage ne doit pas dépasser la longueur de l'élément. Elle ne vérifie pas la valeur de précision elle-même, uniquement sa position ; une précision nulle ou négative est une préoccupation distincte et sans rapport. OffsetAccuracy est une composition sans IRI propre, la violation est donc signalée sur le LinearElementAccuracyProfile parent. PORTÉE : cette règle vérifie uniquement la limite supérieure ; un décalage négatif n'est pas détecté par cette règle. Chaque membre de la liste est évalué indépendamment, si bien qu'un même profil peut voir certains membres réussir et d'autres échouer."@fr ;
    sh:sparql eng-dp:ENGDP009-offsetAccuracyBeyondElementEnd ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP009-offsetAccuracyBeyondElementEnd
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-009"@en ;
    sh:message "ENG-DP-009: this LinearElementAccuracyProfile states an accuracy at offset {?value} m, beyond the end of the referenced LinearElement, whose lengthOfNetLinearElement is {?len} m. The offset is measured from that element's origin, so it must not exceed the element's length. Because accuracy values are interpolated between offsets, a member off the end skews the confidence attached to every position between it and its neighbour - so positions along real track are trusted by the wrong amount, with nothing visibly wrong. Either correct the offset, or move the member to the accuracy profile of the element it really describes."@en ;
    sh:message "ENG-DP-009: diese LinearElementAccuracyProfile gibt eine Genauigkeit bei Offset {?value} m an, jenseits des Endes des referenzierten LinearElement, dessen lengthOfNetLinearElement {?len} m beträgt. Der Offset wird vom Ursprung dieses Elements gemessen und darf daher die Länge des Elements nicht überschreiten. Da Genauigkeitswerte zwischen Offsets interpoliert werden, verfälscht ein Mitglied jenseits des Endes das Vertrauen, das jeder Position zwischen ihm und seinem Nachbarn zugeordnet ist - sodass Positionen entlang des tatsächlichen Gleises um den falschen Betrag vertraut werden, ohne dass etwas sichtbar falsch ist. Entweder den Offset korrigieren, oder das Mitglied dem Genauigkeitsprofil des Elements zuordnen, das es tatsächlich beschreibt."@de ;
    sh:message "ENG-DP-009: ce LinearElementAccuracyProfile indique une précision au décalage {?value} m, au-delà de la fin du LinearElement référencé, dont le lengthOfNetLinearElement est de {?len} m. Le décalage est mesuré depuis l'origine de cet élément et ne doit donc pas dépasser la longueur de l'élément. Comme les valeurs de précision sont interpolées entre les décalages, un membre situé au-delà de la fin fausse la confiance accordée à chaque position entre lui et son voisin - si bien que des positions le long de la voie réelle sont créditées d'une confiance erronée, sans que rien ne paraisse visiblement faux. Corrigez le décalage, ou déplacez le membre vers le profil de précision de l'élément qu'il décrit réellement."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?len ?oa ?acc
        WHERE {
            $this era:linearElement ?le .
            ?le   era:lengthOfNetLinearElement ?len .

            # offsetAccuracies is ordered byIndex, so the members are the ITEMS of
            # an rdf:List; the second branch tolerates the non-list form
            {   $this era:offsetAccuracies/rdf:rest*/rdf:first ?oa . }
            UNION
            {   $this era:offsetAccuracies ?oa . }

            ?oa era:offset ?value .
            OPTIONAL { ?oa era:accuracy ?acc }

            FILTER ( ?value > ?len )
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-010  (E-02)  Offset accuracies must run in order along the list.
#
#     for all leap: reading the offsets of leap.offsetAccuracies in list order
#     gives a sequence that is STRICTLY MONOTONIC - increasing throughout, or
#     decreasing throughout.
#
#  The eighth byIndex list in the model to carry this rule, and the direct
#  counterpart of ENG-DP-002. offsetAccuracies is tagged "ordered": "byIndex", which
#  is a promise about MEANING: the members are in the sequence of their real location,
#  so neighbours in the array are neighbours on the ground.
#
#  EITHER DIRECTION IS ALLOWED, as established for every byIndex list in this model:
#  a list may run against the direction in which the element's offsets grow. It is
#  the reversal PART WAY ALONG that is the defect.
#
#  Rationale: consecutive members are the two ends of an interval over which accuracy
#  is interpolated. A list that doubles back makes those intervals overlap and run
#  backwards, so a single position can be assigned two different accuracies depending
#  on which interval a consumer happens to use - and since accuracy is what decides
#  how much every other position is trusted, the ambiguity propagates into every
#  judgement made about that stretch of track.
#
#  SPLIT IN TWO, as ENG-DP-002 is:
#
#    ENG-DP-010a  two ADJACENT members at the same offset. Contradictory rather than
#                 untidy: one place on the element given two different accuracies,
#                 with nothing to say which holds. Nothing else in any rule set
#                 catches this.
#
#    ENG-DP-010b  the list CHANGES DIRECTION. Detected over three consecutive
#                 members: if no two adjacent offsets are equal then every step is
#                 strictly up or strictly down, so a sequence that is not monotonic
#                 must turn somewhere, and at the turn three consecutive members form
#                 a peak or a valley. Reporting the turning offset names the member
#                 to move.
#
#  INTERACTION - ENG-DP-010b says nothing where adjacent offsets are equal, so a list
#  that both repeats an offset AND turns is reported by ENG-DP-010a alone on the first
#  pass; once the repeat is corrected a second pass reports the turn.
#
#  RELIES ON THE rdf:LIST, unavoidably: order is not a property a plain multi-valued
#  property has, so there is no tolerant non-list branch here as there is in
#  ENG-DP-009. On data written without a list this rule is necessarily silent, that
#  missing list being a structural fault eng-shapes.ttl reports.
#
#  NOT CROSS-MODULE, unlike ENG-DP-009: this rule compares members against one
#  another and needs no infra data at all, so it is just as effective on an eng
#  fragment validated on its own.
#
#  A list of one or two members is always in order and is never reported by
#  ENG-DP-010b; two members at one offset are still caught by ENG-DP-010a.
#
################################################################################

eng-dp:LinearElementAccuracyProfile-ENGDP010
    a sh:NodeShape ;
    sh:targetClass era:LinearElementAccuracyProfile ;
    rdfs:label "ENG-DP-010 offset accuracies must run in order along the list"@en ;
    era:additionalInfo " This reads the offset of every member in the offsetAccuracies list and requires the sequence to be strictly monotonic - consistently increasing throughout, or consistently decreasing throughout, never a mix of both. Either direction is accepted, only consistency is required. Two distinct failure patterns are checked: ENGDP010a fires when two ADJACENT members share the exact same offset - a genuine contradiction, since one place on the element would then have two different accuracy values with nothing to say which applies. ENGDP010b fires when three consecutive members form a peak or a valley, meaning the direction reverses partway along the list. If a list both repeats an offset and changes direction, only the duplicate is reported at first; the direction problem only appears once the duplicate has been corrected and the check runs again. There is no tolerant fallback for a malformed list here: if offsetAccuracies is not a well-formed rdf:List, this rule finds nothing to check and stays completely silent, so a pass does not by itself confirm the list is well-formed. This check compares the profile's own members against each other only, so it works the same whether or not other, related data is present."@en ;
    era:additionalInfo " Diese Regel liest den offset jedes Mitglieds in der offsetAccuracies-Liste und verlangt, dass die Reihenfolge streng monoton ist - durchgehend steigend oder durchgehend fallend, niemals gemischt. Beide Richtungen sind zulässig, nur Konsistenz wird verlangt. Zwei unterschiedliche Fehlermuster werden geprüft: ENGDP010a greift, wenn zwei AUFEINANDERFOLGENDE Mitglieder denselben Offset teilen - ein echter Widerspruch, da eine Stelle des Elements dann zwei unterschiedliche Genauigkeitswerte hätte, ohne dass klar wäre, welcher gilt. ENGDP010b greift, wenn drei aufeinanderfolgende Mitglieder einen Gipfel oder ein Tal bilden, die Richtung sich also auf halbem Weg umkehrt. Wenn eine Liste sowohl einen Offset wiederholt als auch die Richtung ändert, wird zunächst nur das Duplikat gemeldet; das Richtungsproblem erscheint erst, nachdem das Duplikat behoben wurde und die Prüfung erneut läuft. Es gibt hier keinen toleranten Ausweg für eine fehlerhafte Liste: Ist offsetAccuracies keine wohlgeformte rdf:List, findet diese Regel nichts zu prüfen und bleibt vollständig stumm, sodass ein Bestehen für sich genommen nicht bestätigt, dass die Liste wohlgeformt ist. Diese Prüfung vergleicht nur die eigenen Mitglieder des Profils untereinander, sie funktioniert also unabhängig davon, ob andere, verwandte Daten vorhanden sind."@de ;
    era:additionalInfo " Cette règle lit le offset de chaque membre de la liste offsetAccuracies et exige que la séquence soit strictement monotone - constamment croissante, ou constamment décroissante, jamais un mélange des deux. Les deux sens sont acceptés, seule la cohérence est exigée. Deux schémas de défaillance distincts sont vérifiés : ENGDP010a se déclenche lorsque deux membres ADJACENTS partagent exactement le même décalage - une contradiction réelle, puisqu'un même endroit de l'élément aurait alors deux valeurs de précision différentes sans rien pour indiquer laquelle s'applique. ENGDP010b se déclenche lorsque trois membres consécutifs forment un pic ou une vallée, c'est-à-dire que la direction s'inverse en cours de liste. Si une liste répète à la fois un décalage et change de direction, seul le doublon est signalé dans un premier temps ; le problème de direction n'apparaît qu'une fois le doublon corrigé et la vérification relancée. Il n'existe ici aucun repli tolérant pour une liste malformée : si offsetAccuracies n'est pas une rdf:List bien formée, cette règle ne trouve rien à vérifier et reste totalement silencieuse, si bien qu'une réussite ne confirme pas à elle seule que la liste est bien formée. Cette vérification compare uniquement les membres du profil entre eux, elle fonctionne donc de la même façon que d'autres données associées soient présentes ou non."@fr ;
    sh:sparql
        eng-dp:ENGDP010a-adjacentOffsetsEqual ,
        eng-dp:ENGDP010b-listChangesDirection ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP010a-adjacentOffsetsEqual
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-010a"@en ;
    sh:message "ENG-DP-010a: two OffsetAccuracy members that follow one another in this LinearElementAccuracyProfile's list are both at offset {?value} m. Two members at one place on the element assign two different accuracies to that place, so how far a position there may be trusted is ambiguous and a consumer will pick one arbitrarily. Remove the duplicate, or correct whichever offset was copied."@en ;
    sh:message "ENG-DP-010a: zwei aufeinanderfolgende OffsetAccuracy-Mitglieder in der Liste dieses LinearElementAccuracyProfile liegen beide bei Offset {?value} m. Zwei Mitglieder an derselben Stelle des Elements weisen dieser Stelle zwei unterschiedliche Genauigkeiten zu, sodass unklar ist, wie weit einer Position dort vertraut werden darf, und ein Konsument wählt willkürlich eine davon. Entfernen Sie das Duplikat, oder korrigieren Sie den Offset, der kopiert wurde."@de ;
    sh:message "ENG-DP-010a: deux membres OffsetAccuracy consécutifs dans la liste de ce LinearElementAccuracyProfile se trouvent tous deux au décalage {?value} m. Deux membres au même endroit de l'élément attribuent deux précisions différentes à cet endroit, la confiance à accorder à une position à cet endroit est donc ambiguë, et un consommateur en choisira une arbitrairement. Supprimez le doublon, ou corrigez le décalage qui a été copié."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?cell
        WHERE {
            $this era:offsetAccuracies/rdf:rest* ?cell .
            ?cell rdf:first ?m1 ;
                  rdf:rest  ?c2 .
            ?c2   rdf:first ?m2 .

            ?m1 era:offset ?value .
            ?m2 era:offset ?o2 .

            FILTER ( ?value = ?o2 )
        }
    """ ;
    .

eng-dp:ENGDP010b-listChangesDirection
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-010b"@en ;
    sh:message "ENG-DP-010b: this LinearElementAccuracyProfile's list of offset accuracies changes direction at offset {?value} m - the three consecutive members at {?o1}, {?value} and {?o3} m turn back on themselves. The list is tagged byIndex, so it is in the order its members occupy on the ground; that order may run either way along the element but must not reverse part way. Consecutive members are the two ends of an interval over which accuracy is interpolated, so a list that doubles back makes those intervals overlap and one position can be given two different accuracies. Move the member at {?value} m to its proper place in the sequence, or correct its offset."@en ;
    sh:message "ENG-DP-010b: die Liste der Offset-Genauigkeiten dieses LinearElementAccuracyProfile ändert bei Offset {?value} m die Richtung - die drei aufeinanderfolgenden Mitglieder bei {?o1}, {?value} und {?o3} m kehren sich um. Die Liste ist mit byIndex getaggt, folgt also der Reihenfolge, in der ihre Mitglieder auf dem Gelände liegen; diese Reihenfolge kann in beide Richtungen entlang des Elements verlaufen, darf sich aber nicht auf halbem Weg umkehren. Aufeinanderfolgende Mitglieder bilden die beiden Enden eines Intervalls, über das die Genauigkeit interpoliert wird, sodass eine Liste, die sich umkehrt, diese Intervalle überlappen lässt und einer Position zwei unterschiedliche Genauigkeiten zugewiesen werden können. Verschieben Sie das Mitglied bei {?value} m an seine richtige Stelle in der Sequenz, oder korrigieren Sie seinen Offset."@de ;
    sh:message "ENG-DP-010b: la liste des précisions par décalage de ce LinearElementAccuracyProfile change de direction au décalage {?value} m - les trois membres consécutifs à {?o1}, {?value} et {?o3} m rebroussent chemin. La liste est étiquetée byIndex, elle suit donc l'ordre dans lequel ses membres se trouvent sur le terrain ; cet ordre peut aller dans un sens ou dans l'autre le long de l'élément, mais ne doit pas s'inverser en cours de route. Des membres consécutifs constituent les deux extrémités d'un intervalle sur lequel la précision est interpolée, de sorte qu'une liste qui rebrousse chemin fait se chevaucher ces intervalles, et une même position peut alors se voir attribuer deux précisions différentes. Déplacez le membre situé à {?value} m à sa place correcte dans la séquence, ou corrigez son décalage."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?o1 ?o3 ?cell
        WHERE {
            # three consecutive members
            $this era:offsetAccuracies/rdf:rest* ?cell .
            ?cell rdf:first ?m1 ;
                  rdf:rest  ?c2 .
            ?c2   rdf:first ?m2 ;
                  rdf:rest  ?c3 .
            ?c3   rdf:first ?m3 .

            ?m1 era:offset ?o1 .
            ?m2 era:offset ?value .
            ?m3 era:offset ?o3 .

            # a peak or a valley: the middle member is a turning point. Equal
            # adjacent offsets satisfy neither branch and are ENG-DP-010a's.
            FILTER (   ( ?o1 < ?value && ?value > ?o3 )
                    || ( ?o1 > ?value && ?value < ?o3 ) )
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-011  (E-03)  The assets a track usage path lists must lie on that path.
#
#     for all tup:
#         let P = elements( tup.pathBody )
#                 = startsAt.onLinearElement
#                 U endsAt.onLinearElement
#                 U hasSequence
#
#         (a)  for all d in tup.derailers:
#                  d.netPointReference.hasTopoCoordinate.onLinearElement in P
#
#         (b)  for all s in tup.switches:
#                  elements(s) INTERSECT P  is non-empty
#
#         (c)  for all lx in tup.levelCrossings:
#                  elements(lx) INTERSECT P  is non-empty
#
#  THE POINT / EXTENT DISTINCTION IS THE WHOLE DIFFICULTY, and getting it wrong in
#  either direction ruins the rule.
#
#  A DERAILER IS A POINT. It has one topological coordinate and therefore one
#  element, and that element must be on the path - plain membership, as in
#  ENG-DP-003.
#
#  A SWITCH AND A LEVEL CROSSING ARE EXTENDED, and this is where the naive reading
#  fails. A switch reaches three elements: a common track and two divergences. A
#  path runs in along one and out along another - so the THIRD element is, by the
#  very definition of a switch, NOT on the path. Requiring every element of the
#  switch to lie on the path would therefore report every correctly-recorded switch
#  in the dataset. The same holds for a level crossing, which spans the several
#  tracks it crosses while the path uses only one of them.
#
#  What must hold for those two is that the asset and the path SHARE at least one
#  element - that the path actually reaches the thing it claims to pass. Hence the
#  intersection form, and hence sub-rules (b) and (c) are weaker than (a) on
#  purpose rather than by oversight.
#
#  Rationale: a track usage path lists the assets a movement over it encounters,
#  and a route-setting system uses that list to decide what must be positioned,
#  locked and proved clear before the movement is authorised. An asset that is not
#  on the path at all is either attached to the wrong path or positioned wrongly.
#  Both readings are dangerous in the same direction: the movement is authorised
#  with attention paid to a switch it will not traverse, and none paid to one it
#  will.
#
#  THREE SUB-RULES, NOT ONE, because each asset type states its position by a
#  different route - the trap that ENG-DP-003 and ENG-DP-004 were both built to
#  avoid:
#
#      Derailer       netPointReference / hasTopoCoordinate / onLinearElement
#      Switch         (leftBranch|rightBranch) / (elementA|elementB)
#      LevelCrossing  areaReference / includes / {startsAt, endsAt, hasSequence}
#
#  A single query using one path for all three would silently match nothing for two
#  of them and pass everything.
#
#  GUARDS, and there are two kinds.
#
#    Every sub-rule first requires the PATH to yield at least one element. pathBody
#    is 1..1 and a NetLinearReference always has startsAt and endsAt, so failing
#    that means the infra half is absent or structurally incomplete; judging assets
#    against an empty path would report all of them.
#
#    Sub-rule (b) additionally requires BOTH switch branches to resolve, for the
#    reason established in ENG-DP-005: with only one branch known, the intersection
#    is computed against half the switch, and a switch whose shared leg happens to
#    be the unresolved one is falsely accused. Sub-rule (c) likewise requires the
#    crossing's areaReference to be present.
#
#  CROSS-MODULE THROUGHOUT. pathBody, the derailers, the switch branch relations and
#  the crossing areas are all infra's. Validated without infra data these rules are
#  silent for want of the other half.
#
#  LIMITATION - element membership, not offset. A derailer on the right element but
#  outside the stretch the path actually covers is accepted, as in DP-005, DP-014
#  and ENG-DP-003. And for (b) and (c), sharing ONE element is all that is asked:
#  the rule does not check that the path passes through the switch in a way the
#  switch permits, which is what infra's DP-012 and DP-013 reason about.
#
#  REPORTING - all three properties are REFERENCES, so the assets carry IRIs a
#  preparer can look up and sh:value is the offending asset itself.
#
################################################################################

eng-dp:TrackUsagePath-ENGDP011
    a sh:NodeShape ;
    sh:targetClass era:TrackUsagePath ;
    rdfs:label "ENG-DP-011 the assets a path lists must lie on that path"@en ;
    era:additionalInfo " A TrackUsagePath lists the assets a movement over it will encounter - derailers, switches, and level crossings - and this checks that each one is actually reachable from the path's own route. The three asset types are checked differently because each has a different physical shape: a Derailer is a POINT with exactly one location, so it must stand exactly on one of the path's own elements (ENGDP011a). A Switch and a LevelCrossing are EXTENDED across several elements (a switch spans a common track and two divergences; a crossing spans the several tracks it crosses), so for these it is enough that the asset and the path SHARE at least one element (ENGDP011b, ENGDP011c) - requiring every element of a switch to be on the path would incorrectly flag every normal, correctly-recorded switch, since a switch's third leg is by definition not part of any single path through it. For switches, both of the switch's own branch relations must fully resolve before this rule speaks; checking against only one known branch could wrongly flag an asset on the branch that simply had not loaded. All three checks require the path itself to yield at least one element before judging any asset against it, so that a broken or incomplete path does not cause every asset on it to be falsely flagged. IMPORTANT ASYMMETRY for level crossings specifically: the guard here only confirms the crossing has an areaReference property at all, not that it fully resolves through to actual linear elements - if the areaReference exists but the data beneath it is incomplete, this rule proceeds rather than staying silent, and can then wrongly flag the level crossing as unreachable from the path even though the real problem is the crossing's own incomplete location data, not the path or the crossing's placement. LIMITATION: these checks only confirm shared or exact element membership, not that the asset sits within the specific stretch of that element the path actually uses."@en ;
    era:additionalInfo " Ein TrackUsagePath listet die Bauteile auf, denen eine Fahrt über ihn begegnet - Gleissperren, Weichen und Bahnübergänge - und diese Regel prüft, ob jedes davon von der eigenen Route des Pfades aus tatsächlich erreichbar ist. Die drei Bauteilarten werden unterschiedlich geprüft, da jede eine andere physische Form hat: Ein Derailer ist ein PUNKT mit genau einem Standort, muss also genau auf einem der eigenen Elemente des Pfades stehen (ENGDP011a). Eine Switch und ein LevelCrossing erstrecken sich über mehrere Elemente (eine Weiche über ein Stammgleis und zwei Abzweigungen; eine Kreuzung über die mehreren Gleise, die sie kreuzt), für diese genügt es daher, dass Bauteil und Pfad mindestens ein Element GEMEINSAM haben (ENGDP011b, ENGDP011c) - würde man verlangen, dass jedes Element einer Weiche auf dem Pfad liegt, würde dies fälschlich jede normale, korrekt erfasste Weiche melden, da der dritte Strang einer Weiche per Definition nicht Teil eines einzelnen Pfades durch sie ist. Für Weichen müssen beide eigenen Branch-Relationen der Weiche vollständig aufgelöst werden, bevor diese Regel spricht; eine Prüfung gegen nur einen bekannten Zweig könnte ein Bauteil auf dem Zweig, der schlicht nicht geladen wurde, fälschlich melden. Alle drei Prüfungen verlangen, dass der Pfad selbst mindestens ein Element liefert, bevor ein Bauteil dagegen bewertet wird, damit ein defekter oder unvollständiger Pfad nicht dazu führt, dass jedes Bauteil auf ihm fälschlich gemeldet wird. WICHTIGE ASYMMETRIE speziell für Bahnübergänge: Die Absicherung hier bestätigt nur, dass die Kreuzung überhaupt eine areaReference-Eigenschaft besitzt, nicht, dass diese vollständig bis zu tatsächlichen linearen Elementen aufgelöst wird - existiert die areaReference, sind die darunterliegenden Daten jedoch unvollständig, fährt diese Regel fort statt stumm zu bleiben, und kann den Bahnübergang dann fälschlich als vom Pfad aus unerreichbar melden, obwohl das eigentliche Problem die unvollständigen Standortdaten der Kreuzung selbst sind, nicht der Pfad oder die Platzierung der Kreuzung. EINSCHRÄNKUNG: diese Prüfungen bestätigen nur gemeinsame oder exakte Elementzugehörigkeit, nicht, dass das Bauteil innerhalb des konkreten Abschnitts dieses Elements liegt, den der Pfad tatsächlich nutzt."@de ;
    era:additionalInfo " Un TrackUsagePath liste les équipements qu'un mouvement le long de celui-ci rencontrera - déraillements, aiguillages et passages à niveau - et cette règle vérifie que chacun d'eux est effectivement accessible depuis l'itinéraire propre du chemin. Les trois types d'équipements sont vérifiés différemment car chacun a une forme physique différente : un Derailer est un POINT avec un seul emplacement, il doit donc se trouver exactement sur l'un des éléments propres du chemin (ENGDP011a). Un Switch et un LevelCrossing s'étendent sur plusieurs éléments (un aiguillage couvre une voie commune et deux divergences ; un croisement couvre les plusieurs voies qu'il croise), il suffit donc pour ceux-ci que l'équipement et le chemin PARTAGENT au moins un élément (ENGDP011b, ENGDP011c) - exiger que chaque élément d'un aiguillage soit sur le chemin signalerait à tort chaque aiguillage normal et correctement enregistré, puisque le troisième brin d'un aiguillage ne fait par définition partie d'aucun chemin unique le traversant. Pour les aiguillages, les deux relations de branche propres à l'aiguillage doivent se résoudre entièrement avant que cette règle ne s'exprime ; une vérification portant sur une seule branche connue pourrait signaler à tort un équipement situé sur la branche qui n'avait simplement pas été chargée. Les trois vérifications exigent que le chemin lui-même fournisse au moins un élément avant d'évaluer un équipement par rapport à lui, afin qu'un chemin rompu ou incomplet ne fasse pas signaler à tort chaque équipement s'y trouvant. ASYMÉTRIE IMPORTANTE spécifiquement pour les passages à niveau : le garde-fou ici confirme seulement que le croisement possède une propriété areaReference, pas qu'elle se résout entièrement jusqu'à des éléments linéaires réels - si l'areaReference existe mais que les données sous-jacentes sont incomplètes, cette règle poursuit au lieu de rester silencieuse, et peut alors signaler à tort le passage à niveau comme inaccessible depuis le chemin, alors que le problème réel concerne les données de localisation incomplètes du croisement lui-même, non le chemin ou le placement du croisement. LIMITATION : ces vérifications confirment uniquement une appartenance partagée ou exacte à un élément, pas que l'équipement se situe dans le tronçon spécifique de cet élément que le chemin utilise réellement."@fr ;
    sh:sparql
        eng-dp:ENGDP011a-derailerOffThePath ,
        eng-dp:ENGDP011b-switchOffThePath ,
        eng-dp:ENGDP011c-levelCrossingOffThePath ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP011a-derailerOffThePath
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-011a"@en ;
    sh:message "ENG-DP-011a: this Derailer stands on a LinearElement that is not part of the TrackUsagePath's pathBody. A path lists the assets a movement over it encounters, and a route-setting system positions and proves those assets before authorising the movement; a derailer that is not on the path is either attached to the wrong path or positioned wrongly, and either way attention is paid to an asset the movement will not reach. Either move the derailer, or attach it to the path it really stands on."@en ;
    sh:message "ENG-DP-011a: dieser Derailer steht auf einem LinearElement, das nicht Teil des pathBody des TrackUsagePath ist. Ein Pfad listet die Bauteile auf, denen eine Fahrt auf ihm begegnet, und ein Fahrstraßenstellsystem stellt und prüft diese Bauteile, bevor es die Fahrt zulässt; ein Gleissperre, die nicht auf dem Pfad liegt, ist entweder dem falschen Pfad zugeordnet oder falsch positioniert, und so oder so wird einem Bauteil Aufmerksamkeit gewidmet, das die Fahrt nicht erreicht. Entweder die Gleissperre verschieben, oder sie dem Pfad zuordnen, auf dem sie tatsächlich steht."@de ;
    sh:message "ENG-DP-011a: ce Derailer se trouve sur un LinearElement qui ne fait pas partie du pathBody du TrackUsagePath. Un itinéraire liste les équipements qu'un mouvement sur celui-ci rencontre, et un système d'établissement d'itinéraires positionne et contrôle ces équipements avant d'autoriser le mouvement ; un déraillement qui ne se trouve pas sur l'itinéraire est soit rattaché au mauvais itinéraire, soit mal positionné, et dans les deux cas de l'attention est portée à un équipement que le mouvement n'atteindra pas. Déplacez le déraillement, ou rattachez-le à l'itinéraire sur lequel il se trouve réellement."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value
        WHERE {
            $this era:derailers ?value .

            # a derailer is a POINT: one coordinate, through a NetPointReference
            ?value era:netPointReference/era:hasTopoCoordinate/era:onLinearElement ?dle .

            # the path must yield at least one element, or every asset would be
            # reported for want of anything to compare against
            FILTER EXISTS {
                $this era:pathBody ?pb0 .
                {   ?pb0 era:startsAt/era:hasTopoCoordinate/era:onLinearElement ?any0 . }
                UNION
                {   ?pb0 era:endsAt/era:hasTopoCoordinate/era:onLinearElement ?any0 . }
                UNION
                {   ?pb0 era:hasSequence/rdf:rest*/rdf:first ?any0 . }
            }

            FILTER NOT EXISTS {
                $this era:pathBody ?pb .
                {   ?pb era:startsAt/era:hasTopoCoordinate/era:onLinearElement ?dle . }
                UNION
                {   ?pb era:endsAt/era:hasTopoCoordinate/era:onLinearElement ?dle . }
                UNION
                {   ?pb era:hasSequence/rdf:rest*/rdf:first ?dle . }
            }
        }
    """ ;
    .

eng-dp:ENGDP011b-switchOffThePath
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-011b"@en ;
    sh:message "ENG-DP-011b: none of the LinearElements this Switch connects is part of the TrackUsagePath's pathBody, so the path does not reach the switch at all. Note the rule asks only that the switch and the path SHARE an element: a switch's third leg necessarily leaves the path, so it is not required to be on it. Sharing nothing means the switch is attached to the wrong path, or the path body is wrong. A route-setting system would position and lock a switch the movement never traverses, and leave unattended one it does."@en ;
    sh:message "ENG-DP-011b: keines der von diesem Switch verbundenen LinearElements ist Teil des pathBody des TrackUsagePath, die Fahrstraße erreicht die Weiche also überhaupt nicht. Hinweis: Die Regel verlangt nur, dass Weiche und Pfad ein Element GEMEINSAM haben: Der dritte Strang einer Weiche verlässt zwangsläufig den Pfad, muss also nicht auf ihm liegen. Nichts gemeinsam zu haben bedeutet, dass die Weiche dem falschen Pfad zugeordnet ist, oder dass der pathBody falsch ist. Ein Fahrstraßenstellsystem würde eine Weiche stellen und verriegeln, die die Fahrt nie durchquert, und eine unbeachtet lassen, die sie durchquert."@de ;
    sh:message "ENG-DP-011b: aucun des LinearElements que ce Switch relie ne fait partie du pathBody du TrackUsagePath, l'itinéraire n'atteint donc pas du tout l'aiguillage. Notez que la règle demande seulement que l'aiguillage et l'itinéraire PARTAGENT un élément : le troisième brin d'un aiguillage quitte nécessairement l'itinéraire, il n'est donc pas tenu d'y figurer. Ne rien partager signifie que l'aiguillage est rattaché au mauvais itinéraire, ou que le pathBody est incorrect. Un système d'établissement d'itinéraires positionnerait et verrouillerait un aiguillage que le mouvement ne traverse jamais, et en laisserait un autre sans surveillance alors qu'il le traverse."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value
        WHERE {
            $this era:switches ?value .

            # the path must yield at least one element
            FILTER EXISTS {
                $this era:pathBody ?pb0 .
                {   ?pb0 era:startsAt/era:hasTopoCoordinate/era:onLinearElement ?any0 . }
                UNION
                {   ?pb0 era:endsAt/era:hasTopoCoordinate/era:onLinearElement ?any0 . }
                UNION
                {   ?pb0 era:hasSequence/rdf:rest*/rdf:first ?any0 . }
            }

            # BOTH branches must resolve, as in ENG-DP-005: half a switch's extent
            # would turn a missing relation into a false accusation
            FILTER EXISTS { $this era:switches ?value . ?value era:leftBranch/(era:elementA|era:elementB) ?anyL }
            FILTER EXISTS { $this era:switches ?value . ?value era:rightBranch/(era:elementA|era:elementB) ?anyR }

            # a switch is EXTENDED: sharing ONE element with the path is enough,
            # because its third leg is by definition off the path
            FILTER NOT EXISTS {
                ?value (era:leftBranch|era:rightBranch)/(era:elementA|era:elementB) ?sle .
                $this era:pathBody ?pb .
                {   ?pb era:startsAt/era:hasTopoCoordinate/era:onLinearElement ?sle . }
                UNION
                {   ?pb era:endsAt/era:hasTopoCoordinate/era:onLinearElement ?sle . }
                UNION
                {   ?pb era:hasSequence/rdf:rest*/rdf:first ?sle . }
            }
        }
    """ ;
    .

eng-dp:ENGDP011c-levelCrossingOffThePath
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-011c"@en ;
    sh:message "ENG-DP-011c: none of the LinearElements in this LevelCrossing's areaReference is part of the TrackUsagePath's pathBody, so the path does not reach the crossing at all. As with switches, the rule asks only that the two SHARE an element - a crossing spans the several tracks it crosses while the path uses one of them. Sharing nothing means the crossing is attached to the wrong path, or the path body is wrong, and a movement would be authorised without regard to a crossing it will traverse."@en ;
    sh:message "ENG-DP-011c: keines der LinearElements in der areaReference dieses LevelCrossing ist Teil des pathBody des TrackUsagePath, die Fahrstraße erreicht die Kreuzung also überhaupt nicht. Wie bei Weichen verlangt die Regel nur, dass beide ein Element GEMEINSAM haben - eine Kreuzung erstreckt sich über die mehreren Gleise, die sie kreuzt, während die Fahrstraße eines davon nutzt. Nichts gemeinsam zu haben bedeutet, dass die Kreuzung dem falschen Pfad zugeordnet ist, oder dass der pathBody falsch ist, und eine Fahrt würde ohne Rücksicht auf eine Kreuzung zugelassen, die sie tatsächlich durchquert."@de ;
    sh:message "ENG-DP-011c: aucun des LinearElements de l'areaReference de ce LevelCrossing ne fait partie du pathBody du TrackUsagePath, l'itinéraire n'atteint donc pas du tout le passage à niveau. Comme pour les aiguillages, la règle demande seulement que les deux PARTAGENT un élément - un passage à niveau s'étend sur les plusieurs voies qu'il croise, tandis que l'itinéraire n'en emprunte qu'une. Ne rien partager signifie que le passage à niveau est rattaché au mauvais itinéraire, ou que le pathBody est incorrect, et un mouvement serait autorisé sans tenir compte d'un passage à niveau qu'il traverse pourtant."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value
        WHERE {
            $this era:levelCrossings ?value .

            # the path must yield at least one element
            FILTER EXISTS {
                $this era:pathBody ?pb0 .
                {   ?pb0 era:startsAt/era:hasTopoCoordinate/era:onLinearElement ?any0 . }
                UNION
                {   ?pb0 era:endsAt/era:hasTopoCoordinate/era:onLinearElement ?any0 . }
                UNION
                {   ?pb0 era:hasSequence/rdf:rest*/rdf:first ?any0 . }
            }

            # areaReference comes from the INFRA description of the crossing; absent,
            # the crossing's extent is unknown and it must not be judged
            FILTER EXISTS { $this era:levelCrossings ?value . ?value era:areaReference ?anyArea }

            # a level crossing is EXTENDED: sharing ONE element is enough
            FILTER NOT EXISTS {
                ?value era:areaReference/era:includes ?lr .
                {   ?lr era:startsAt/era:hasTopoCoordinate/era:onLinearElement ?xle . }
                UNION
                {   ?lr era:endsAt/era:hasTopoCoordinate/era:onLinearElement ?xle . }
                UNION
                {   ?lr era:hasSequence/rdf:rest*/rdf:first ?xle . }

                $this era:pathBody ?pb .
                {   ?pb era:startsAt/era:hasTopoCoordinate/era:onLinearElement ?xle . }
                UNION
                {   ?pb era:endsAt/era:hasTopoCoordinate/era:onLinearElement ?xle . }
                UNION
                {   ?pb era:hasSequence/rdf:rest*/rdf:first ?xle . }
            }
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-012  (E-04)  Sleepers must not contradict one another over shared track.
#
#     for all s1, s2 of class Sleepers with s1 != s2,
#     for all sec1 in s1.linearElementSections, sec2 in s2.linearElementSections:
#         (  sec1.onElement = sec2.onElement
#            and sec1 overlaps sec2 )
#         =>  s1.sleepersType = s2.sleepersType
#
#     where overlap is STRICT.
#
#  THE FIFTH BRANCH OF INFRA'S DP-035, written here because the class is eng's.
#  DP-035 covers LinearElementGauge, LinearElementLoadingGauge, TractionSystem and
#  CurrentLimitation - the infra classes whose value is exclusive over a stretch of
#  track. Sleepers is eng's only class of that shape, and sleepersType is exclusive
#  in exactly the same way: a stretch of track is laid on ONE kind of sleeper.
#
#  Every decision is inherited from DP-035 deliberately, so that the two behave
#  identically and a preparer who has learned one has learned the other:
#
#    STRICT OVERLAP - sections that merely touch at a boundary do not report.
#    Laying sections end to end is exactly how a changing property along an element
#    is described, and flagging every boundary would bury the real findings.
#
#    MALFORMED SECTIONS ARE SKIPPED - a guard requires start <= end on both. A
#    reversed section is infra's DP-010 to report, and overlap arithmetic on one is
#    meaningless.
#
#    ONLY A DIFFERENCE IS A CONTRADICTION - two Sleepers objects with the SAME type
#    over shared track are redundant, not conflicting, and are not reported.
#
#    EACH CONFLICTING PAIR ONCE - the pattern matches in both orders and an ordering
#    filter keeps one.
#
#    sh:value IS THE LINEAR ELEMENT, not either object. Sleepers has an id and so an
#    IRI, unlike DP-035's four classes which are all compositions - but the element
#    is what the two objects are arguing about, and both Sleepers are named in the
#    message, so the report stays consistent with DP-035 and loses nothing.
#
#  Rationale: sleeper type determines what the track can carry and how it behaves -
#  it feeds track stiffness, permitted axle load and maintenance regime. Two records
#  claiming different types over ground they share is a flat contradiction, and
#  neither object is wrong on its own: each is internally consistent, each satisfies
#  DP-010 and DP-011, and only holding the two against one another reveals it. A
#  consumer resolves it by picking one, so the answer depends on traversal order.
#
#  A NOTE ON EngArea.defaultSleepersType, which is NOT involved. The area carries a
#  default and the Sleepers objects state exceptions to it; a Sleepers object that
#  merely restates the default is redundant but not contradictory, and nothing here
#  compares an object against the default. Whether such restatements are worth
#  reporting is a separate question.
#
#  APPLIES ACROSS THE WHOLE DATASET, not within one EngArea. Two Sleepers objects in
#  different areas that contradict one another over the same element are still a
#  contradiction. Validating one area at a time sees only that area, as with DP-035.
#
################################################################################

eng-dp:Sleepers-ENGDP012
    a sh:NodeShape ;
    sh:targetClass era:Sleepers ;
    rdfs:label "ENG-DP-012 sleepers must not conflict over shared track"@en ;
    era:additionalInfo " This compares every pair of different Sleepers objects and checks whether they claim different sleeper types over the same physical stretch of track. A stretch of track can only be laid on one kind of sleeper, so if two Sleepers records overlap on the same LinearElement and disagree on the type, that is a genuine contradiction - not a flaw in either record on its own, since each individual Sleepers object can be perfectly well-formed by itself; the conflict only appears once the two are compared against each other, which is why no other check can catch it. Sections that merely touch at a shared boundary, one ending exactly where another begins, are not reported, since that is the normal way a changing property is described along a line, not a conflict. Two Sleepers objects that claim the SAME type over shared track are not reported either, since that is redundant rather than contradictory. This check compares data across the entire dataset, not just within one local area, so two contradicting records defined in completely different parts of the data will still be caught."@en ;
    era:additionalInfo " Diese Regel vergleicht jedes Paar unterschiedlicher Sleepers-Objekte und prüft, ob sie über denselben physischen Gleisabschnitt unterschiedliche Schwellentypen beanspruchen. Ein Gleisabschnitt kann nur auf einer Schwellenart liegen, überschneiden sich also zwei Sleepers-Einträge auf demselben LinearElement und widersprechen sich im Typ, ist das ein echter Widerspruch - kein Fehler in einem der beiden Einträge für sich genommen, da jedes einzelne Sleepers-Objekt für sich vollkommen wohlgeformt sein kann; der Konflikt zeigt sich erst, wenn beide gegeneinander gehalten werden, weshalb keine andere Prüfung dies erfassen kann. Abschnitte, die sich lediglich an einer gemeinsamen Grenze berühren, wobei der eine genau dort endet, wo der andere beginnt, werden nicht gemeldet, da dies die normale Art ist, eine sich ändernde Eigenschaft entlang einer Strecke zu beschreiben, kein Konflikt. Zwei Sleepers-Objekte, die über gemeinsames Gleis DENSELBEN Typ beanspruchen, werden ebenfalls nicht gemeldet, da dies redundant statt widersprüchlich ist. Diese Prüfung vergleicht Daten über den gesamten Datensatz hinweg, nicht nur innerhalb eines lokalen Bereichs, sodass zwei widersprüchliche Einträge, die in völlig unterschiedlichen Teilen der Daten definiert sind, dennoch erfasst werden."@de ;
    era:additionalInfo " Cette règle compare chaque paire d'objets Sleepers différents et vérifie s'ils revendiquent des types de traverses différents sur le même tronçon physique de voie. Un tronçon de voie ne peut reposer que sur un seul type de traverse ; si deux enregistrements Sleepers se chevauchent sur le même LinearElement et divergent sur le type, il s'agit d'une contradiction réelle - non d'un défaut dans l'un ou l'autre enregistrement pris isolément, puisque chaque objet Sleepers peut être parfaitement bien formé par lui-même ; le conflit n'apparaît qu'une fois les deux comparés l'un à l'autre, ce pourquoi aucune autre vérification ne peut le détecter. Les sections qui se touchent simplement à une limite commune, l'une se terminant exactement là où l'autre commence, ne sont pas signalées, car c'est la façon normale de décrire une propriété qui change le long d'une ligne, non un conflit. Deux objets Sleepers revendiquant le MÊME type sur une voie partagée ne sont pas non plus signalés, car cela est redondant plutôt que contradictoire. Cette vérification compare les données sur l'ensemble du jeu de données, pas seulement au sein d'une zone locale, de sorte que deux enregistrements contradictoires définis dans des parties complètement différentes des données seront tout de même détectés."@fr ;
    sh:sparql eng-dp:ENGDP012-conflictingSleeperTypeOverSharedTrack ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP012-conflictingSleeperTypeOverSharedTrack
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-012"@en ;
    sh:message "ENG-DP-012: this Sleepers object and {?other} claim different sleeper types over the same stretch of LinearElement {?value}. One covers [{?a1}, {?b1}] m with {?v1}, the other covers [{?a2}, {?b2}] m with {?v2}, and the two ranges overlap. A stretch of track is laid on one kind of sleeper, so the two cannot both hold; sleeper type feeds track stiffness, permitted axle load and maintenance regime, so the disagreement propagates into all three. Neither object is wrong on its own, which is why nothing else reports this - a consumer will resolve it by picking one, and which one may differ from run to run. Reconcile the types, or move a boundary so the ranges meet without overlapping; ranges that touch at a single offset are accepted."@en ;
    sh:message "ENG-DP-012: dieses Sleepers-Objekt und {?other} beanspruchen unterschiedliche Schwellentypen für denselben Abschnitt von LinearElement {?value}. Eines deckt [{?a1}, {?b1}] m mit {?v1} ab, das andere [{?a2}, {?b2}] m mit {?v2}, und die beiden Bereiche überschneiden sich. Ein Gleisabschnitt liegt auf einer Schwellenart, beide können also nicht gleichzeitig gelten; der Schwellentyp beeinflusst Gleissteifigkeit, zulässige Achslast und Instandhaltungsregime, sodass sich der Widerspruch auf alle drei fortpflanzt. Keines der beiden Objekte ist für sich genommen falsch, weshalb nichts sonst dies meldet - ein Konsument wird es lösen, indem er eines wählt, und welches das ist, kann von Lauf zu Lauf variieren. Gleichen Sie die Typen ab, oder verschieben Sie eine Grenze, sodass sich die Bereiche ohne Überschneidung berühren; Bereiche, die sich an einem einzelnen Offset berühren, werden akzeptiert."@de ;
    sh:message "ENG-DP-012: cet objet Sleepers et {?other} revendiquent des types de traverses différents sur le même tronçon de LinearElement {?value}. L'un couvre [{?a1}, {?b1}] m avec {?v1}, l'autre couvre [{?a2}, {?b2}] m avec {?v2}, et les deux plages se chevauchent. Un tronçon de voie repose sur un seul type de traverse, les deux ne peuvent donc pas être valables à la fois ; le type de traverse influe sur la rigidité de la voie, la charge à l'essieu admise et le régime de maintenance, si bien que le désaccord se propage aux trois. Aucun des deux objets n'est fautif en soi, c'est pourquoi rien d'autre ne signale ceci - un consommateur résoudra la situation en en choisissant un, et lequel peut varier d'une exécution à l'autre. Réconciliez les types, ou déplacez une limite pour que les plages se touchent sans se chevaucher ; des plages qui se touchent en un seul décalage sont acceptées."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?other ?v1 ?v2 ?a1 ?b1 ?a2 ?b2
        WHERE {
            ?other a era:Sleepers .
            FILTER ( !sameTerm($this, ?other) )

            $this  era:sleepersType ?v1 .
            ?other era:sleepersType ?v2 .

            # only a DIFFERENCE is a contradiction; the same type over shared track
            # is redundant, not conflicting
            FILTER ( ?v1 != ?v2 )

            $this  era:linearElementSections ?s1 .
            ?other era:linearElementSections ?s2 .

            ?s1 era:onElement ?value ;
                era:startOffsetFromOrigin ?a1 ;
                era:endOffsetFromOrigin   ?b1 .
            ?s2 era:onElement ?le2 ;
                era:startOffsetFromOrigin ?a2 ;
                era:endOffsetFromOrigin   ?b2 .
            FILTER ( sameTerm(?value, ?le2) )

            # a reversed section is infra's DP-010 to report; overlap arithmetic on
            # one is meaningless, so skip both here
            FILTER ( ?a1 <= ?b1 && ?a2 <= ?b2 )

            # STRICT overlap: sections that merely touch at a boundary are allowed
            FILTER ( ?a1 < ?b2 && ?a2 < ?b1 )

            # the pair matches in both orders; keep one of the two
            FILTER ( STR($this) < STR(?other) )
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-013  (E-05)  No two balises in a group may claim the same position.
#
#     for all bg, for all b1, b2 in bg.balises with b1 != b2:
#         b1.n_pig != b2.n_pig
#
#  Recorded as NOT COVERED under ENG-DP-006, which bounds each n_pig from above but
#  says nothing about the set as a whole. A three-balise group numbered 0, 1, 1
#  satisfies ENG-DP-006 completely while being just as unreadable on board: the
#  on-board is told to expect a balise at position 2 that never arrives, and is
#  handed position 1 twice.
#
#  DISTINCTNESS ALONE IS ENOUGH - the proposal asked for the values to be distinct
#  AND to cover 0 .. n-1 exactly, but the second follows from the first and is not
#  implemented separately. Given ENG-DP-006, every n_pig in a group of n balises
#  lies in 0 .. n-1. If the n values are also pairwise distinct then n distinct
#  values occupy a range of exactly n positions, so by the pigeonhole principle they
#  are precisely 0 .. n-1 with nothing missing. Writing a second coverage rule would
#  add nothing but a second finding for the same defect.
#
#  Note this holds only WITH ENG-DP-006. On data that breaks the upper bound, both
#  rules fire and each says something different: ENG-DP-006 that a position is
#  outside the group, this one that two balises claim the same position.
#
#  Rationale: n_pig is how the on-board tells one balise of a group from another as
#  it passes over them. Two balises claiming one position leave it unable to say
#  which it has read; combined with the group's expected size it will also be
#  waiting for a position that is never transmitted, so the group is never completed
#  and the reading is discarded. A balise group that cannot be read is a position
#  reference lost at exactly the point where it was meant to be gained.
#
#  CROSS-MODULE, split as in ENG-DP-006: n_pig belongs to eng.json's Balise, the
#  balises list to infra.json's BaliseGroup. Both halves must be in the graph.
#
#  A REPEATED BALISE IS NOT A COLLISION. If one balise appears twice in the list it
#  is one node, so !sameTerm excludes the pair and nothing is reported. The
#  repetition is a defect but not this one, and manufacturing a finding from it
#  would mislead - the same reasoning that made ENG-DP-006 count list SLOTS rather
#  than distinct balises.
#
#  BOTH BALISES ARE REPORTED, not one per pair. Unlike ENG-DP-012, where the finding
#  is about an element two objects are arguing over, here each balise carries a
#  value that may be the wrong one and a preparer has to look at both to decide
#  which to change. This follows DP-006, DP-007 and DP-008, which likewise report
#  each object at a shared position.
#
#  Serialisation: both the list form and the plain multi-valued form are matched, as
#  in ENG-DP-006. No order is involved, so no rdf:List walk is strictly required -
#  but the list form must still be reached through it.
#
################################################################################

eng-dp:BaliseGroup-ENGDP013
    a sh:NodeShape ;
    sh:targetClass era:BaliseGroup ;
    rdfs:label "ENG-DP-013 no two balises in a group at the same position"@en ;
    era:additionalInfo " This checks that no two different balises within the same group share the same n_pig value. Even where each individual n_pig value is a plausible number for the group's size, two balises claiming the identical position leave an on-board system unable to tell which one it has actually read as it passes over them - and since the system also expects a specific number of balises, it will additionally wait for a position that will never arrive, so the whole group fails to be read. If the same balise is accidentally listed twice, that counts as one balise, not two colliding ones - that kind of duplication is a different, unrelated problem. Both of the colliding balises are named in the report, since either one could be the one that needs renumbering, and a preparer has to look at both to decide which."@en ;
    era:additionalInfo " Diese Regel prüft, dass keine zwei unterschiedlichen Balisen innerhalb derselben Gruppe denselben n_pig-Wert teilen. Selbst wenn jeder einzelne n_pig-Wert für die Gruppengröße plausibel ist, lassen zwei Balisen, die dieselbe Position beanspruchen, ein Fahrzeuggerät im Unklaren, welche es beim Überfahren tatsächlich gelesen hat - und da das Gerät auch eine bestimmte Anzahl an Balisen erwartet, wartet es zusätzlich auf eine Position, die nie eintrifft, sodass die gesamte Gruppe nicht gelesen werden kann. Erscheint dieselbe Balise versehentlich zweimal in der Liste, zählt dies als eine Balise, nicht als zwei kollidierende - diese Art der Duplizierung ist ein anderes, unabhängiges Problem. Beide kollidierenden Balisen werden im Bericht genannt, da jede von beiden diejenige sein könnte, die umnummeriert werden muss, und ein Bearbeiter beide betrachten muss, um zu entscheiden, welche."@de ;
    era:additionalInfo " Cette règle vérifie qu'aucune paire de balises différentes au sein d'un même groupe ne partage la même valeur n_pig. Même lorsque chaque valeur n_pig prise individuellement est un nombre plausible pour la taille du groupe, deux balises revendiquant la même position empêchent un équipement embarqué de déterminer laquelle il a réellement lue en les franchissant - et comme l'équipement attend également un nombre précis de balises, il attendra en plus une position qui n'arrivera jamais, si bien que le groupe entier ne peut pas être lu. Si la même balise apparaît accidentellement deux fois dans la liste, cela compte comme une seule balise, non comme deux en collision - ce type de duplication est un problème différent et sans rapport. Les deux balises en collision sont toutes deux nommées dans le rapport, car l'une ou l'autre pourrait être celle à renuméroter, et un préparateur doit examiner les deux pour décider laquelle."@fr ;
    sh:sparql eng-dp:ENGDP013-duplicateNPigInGroup ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP013-duplicateNPigInGroup
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-013"@en ;
    sh:message "ENG-DP-013: this Balise carries n_pig {?npig}, and another balise in the same BaliseGroup carries it too. n_pig is how an on-board tells one balise of a group from another as it passes over them, so two balises claiming one position leave it unable to say which it has read - and, since it also knows how many balises to expect, it will wait for a position that is never transmitted, so the group is never completed and the reading is discarded. Renumber whichever balise is wrong; the positions of a group of n balises must be 0 to n-1, each used once."@en ;
    sh:message "ENG-DP-013: diese Balise trägt n_pig {?npig}, und eine andere Balise in derselben BaliseGroup trägt sie ebenfalls. n_pig ist, woran ein Fahrzeugerät eine Balise einer Gruppe von einer anderen unterscheidet, während es darüberfährt; zwei Balisen, die dieselbe Position beanspruchen, machen es unmöglich zu sagen, welche gelesen wurde - und da das Gerät auch weiß, wie viele Balisen zu erwarten sind, wartet es auf eine Position, die nie übertragen wird, sodass die Gruppe nie vervollständigt und die Lesung verworfen wird. Nummerieren Sie die falsche Balise um; die Positionen einer Gruppe von n Balisen müssen 0 bis n-1 sein, jede genau einmal verwendet."@de ;
    sh:message "ENG-DP-013: cette Balise porte n_pig {?npig}, et une autre balise du même BaliseGroup le porte également. n_pig est ce qui permet à un équipement embarqué de distinguer une balise d'un groupe d'une autre lorsqu'il les franchit ; deux balises revendiquant une même position empêchent de savoir laquelle a été lue - et comme l'équipement sait aussi combien de balises attendre, il attendra une position qui ne sera jamais transmise, si bien que le groupe n'est jamais complété et que la lecture est rejetée. Renumérotez la balise fautive ; les positions d'un groupe de n balises doivent être comprises entre 0 et n-1, chacune utilisée une seule fois."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?npig
        WHERE {
            # ?value is the offending BALISE, so that sh:value names the object a
            # preparer must look at - as DP-006, DP-007 and DP-008 do. The position
            # itself is carried as ?npig for the message.
            {   $this era:balises/rdf:rest*/rdf:first ?value . }
            UNION
            {   $this era:balises ?value . }

            {   $this era:balises/rdf:rest*/rdf:first ?other . }
            UNION
            {   $this era:balises ?other . }

            # a balise repeated in the list is ONE node, so it cannot collide with
            # itself; that repetition is a defect but not this one
            FILTER ( !sameTerm(?value, ?other) )

            # n_pig comes from the ENG description of each balise; absent, no row
            ?value era:n_pig ?npig .
            ?other era:n_pig ?n2 .

            FILTER ( ?npig = ?n2 )
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-014  (E-06)  A route must not require a switch in both positions.
#
#     for all sw:
#         sw.routeRequiresPointRight  INTERSECT  sw.routeRequiresPointLeft  =  {}
#
#  A TrackUsagePath appearing in BOTH lists requires the switch to be set right and
#  left for one and the same route. That cannot be satisfied by any physical switch,
#  and the data offers nothing to choose between the two.
#
#  Rationale: these two properties are what a route-setting system reads to decide
#  which way to move a switch before authorising a movement over a path. Faced with
#  a path in both lists it will either detect the contradiction and refuse the route
#  - turning a usable route into a barrier - or take whichever it happens to read
#  first, which means the switch is set correctly for some movements over that path
#  and wrongly for others, depending on nothing more than triple order. The second
#  outcome is the dangerous one, because it is intermittent: the route works, until
#  it does not.
#
#  Neither list is wrong on its own. Each is a perfectly ordinary collection of
#  paths, and only holding the two against one another reveals the conflict - the
#  same character as DP-035 and ENG-DP-012, though far cheaper to check.
#
#  PURE SHACL CORE, and the cheapest rule in either file: sh:disjoint states that
#  the value sets of two properties share no member. No SPARQL, so no prefix
#  concerns and no query to get wrong. sh:value is the shared TrackUsagePath, which
#  is exactly the thing to look at.
#
#  NOT CROSS-MODULE - both properties belong to eng.json's Switch, so unlike
#  ENG-DP-005 and ENG-DP-011b this rule needs no infra data at all and is just as
#  effective on an eng fragment validated alone. It also does not care whether the
#  paths themselves are in the graph: the contradiction is in the switch's own
#  statement about them.
#
#  SCOPE - both properties are 0..*, so a switch naming no routes at all, or routes
#  in only one direction, is entirely ordinary and is not reported.
#
#  NOT COVERED - nothing here checks the CONVERSE direction of the relationship:
#  that a TrackUsagePath naming this switch in its own switches list is among the
#  routes the switch declares, or the other way about. That coherence check would be
#  a rule of its own.
#
################################################################################

eng-dp:Switch-ENGDP014
    a sh:NodeShape ;
    sh:targetClass era:Switch ;
    rdfs:label "ENG-DP-014 a route must not require a switch in both positions"@en ;
    era:additionalInfo "This checks that no single route (TrackUsagePath) appears in both of a switch's own lists of which routes require it set to the right versus set to the left. A route in both lists would require one physical switch to be in two different positions at the same time for the same movement, which no real switch can do, and the data gives no way to tell which position was actually intended. Neither list is wrong on its own - each is an ordinary list of routes - the contradiction only exists because the two lists are held against each other. This check needs no other data beyond the switch's own two properties; it does not matter whether the routes themselves, or any other part of the network, are present in the data being validated."@en ;
    era:additionalInfo " Diese Regel prüft, dass keine einzelne Fahrstraße (TrackUsagePath) in beiden eigenen Listen einer Weiche erscheint - der Liste der Fahrstraßen, die sie rechts gestellt verlangen, und der Liste, die sie links gestellt verlangen. Eine Fahrstraße in beiden Listen würde verlangen, dass eine physische Weiche für dieselbe Fahrt gleichzeitig in zwei unterschiedlichen Stellungen ist, was keine reale Weiche leisten kann, und die Daten geben keinen Hinweis darauf, welche Stellung tatsächlich gemeint war. Keine der beiden Listen ist für sich genommen falsch - jede ist eine gewöhnliche Liste von Fahrstraßen - der Widerspruch besteht erst, wenn beide Listen gegeneinander gehalten werden. Diese Prüfung benötigt keine weiteren Daten außer den beiden eigenen Eigenschaften der Weiche; es spielt keine Rolle, ob die Fahrstraßen selbst oder ein anderer Teil des Netzes in den validierten Daten vorhanden sind."@de ;
    era:additionalInfo "Cette règle vérifie qu'aucun itinéraire (TrackUsagePath) n'apparaît à la fois dans les deux listes propres d'un aiguillage indiquant quels itinéraires exigent qu'il soit positionné à droite et quels itinéraires exigent qu'il soit positionné à gauche. Un itinéraire présent dans les deux listes exigerait qu'un même aiguillage physique soit dans deux positions différentes simultanément pour le même mouvement, ce qu'aucun aiguillage réel ne peut faire, et les données ne permettent pas de savoir laquelle des deux positions était réellement voulue. Aucune des deux listes n'est fautive en elle-même - chacune est une liste ordinaire d'itinéraires - la contradiction n'existe que parce que les deux listes sont confrontées l'une à l'autre. Cette vérification ne nécessite aucune autre donnée que les deux propriétés propres de l'aiguillage ; peu importe que les itinéraires eux-mêmes, ou toute autre partie du réseau, soient présents dans les données validées."@fr ;
    sh:property eng-dp:ENGDP014-routePositionsDisjoint ;
    .

eng-dp:ENGDP014-routePositionsDisjoint
    a sh:PropertyShape ;
    rdfs:label "ENG-DP-014"@en ;
    sh:path era:routeRequiresPointRight ;
    sh:disjoint era:routeRequiresPointLeft ;
    sh:message "ENG-DP-014: this TrackUsagePath appears in BOTH routeRequiresPointRight and routeRequiresPointLeft of the same Switch, so one route requires the switch to be set right and left at once. No physical switch can satisfy that, and nothing in the data says which was meant. A route-setting system will either refuse the route outright, or take whichever it reads first - in which case the switch is set correctly for some movements over this path and wrongly for others, depending on nothing more than the order the data happens to be read in. Remove the path from whichever list is wrong."@en ;
    sh:message "ENG-DP-014: dieser TrackUsagePath erscheint SOWOHL in routeRequiresPointRight ALS AUCH in routeRequiresPointLeft desselben Switch, sodass eine Fahrstraße verlangt, die Weiche gleichzeitig rechts UND links zu stellen. Keine physische Weiche kann das erfüllen, und nichts in den Daten sagt, welche gemeint war. Ein Fahrstraßenstellsystem wird die Fahrt entweder ganz ablehnen, oder nimmt, was es zuerst liest - in diesem Fall ist die Weiche für manche Fahrten korrekt gestellt und für andere falsch, abhängig allein von der zufälligen Lesereihenfolge der Daten. Entfernen Sie den Pfad aus der Liste, in der er falsch ist."@de ;
    sh:message "ENG-DP-014: ce TrackUsagePath apparaît À LA FOIS dans routeRequiresPointRight ET dans routeRequiresPointLeft du même Switch, si bien qu'un itinéraire exige que l'aiguillage soit à la fois à droite et à gauche. Aucun aiguillage physique ne peut satisfaire cela, et rien dans les données n'indique lequel était voulu. Un système d'établissement d'itinéraires refusera l'itinéraire purement et simplement, ou prendra ce qu'il lit en premier - auquel cas l'aiguillage est correctement positionné pour certains mouvements et mal pour d'autres, en fonction du seul ordre de lecture des données. Retirez le chemin de la liste dans laquelle il est erroné."@fr ;
    sh:severity sh:Violation ;
    .


################################################################################
#
#  ENG-DP-015  (E-07)  A buffer stop's danger point must stand on the buffer stop's
#                      own linear element.
#
#     for all bs with bs.dangerPoint = dp:
#         dp.topologicalCoordinate.onLinearElement
#             =  bs.netPointReference.hasTopoCoordinate.onLinearElement
#
#  Recorded as NOT COVERED under ENG-DP-003, and the last member of the
#  danger-point / fouling-point family: ENG-DP-003 places a level crossing's danger
#  points within its area, ENG-DP-004 and ENG-DP-005 place fouling points on a
#  crossing and on a switch, and this places a buffer stop's danger point on the
#  buffer stop.
#
#  IT IS THE STRICTEST OF THE FOUR, and necessarily so. A crossing, a switch and a
#  level crossing are all EXTENDED - they offer two or three elements, and the rule
#  asks for membership in that set. A buffer stop is a POINT: it has exactly one
#  netPointReference and therefore exactly one element, so "on the buffer stop's
#  element" admits no set at all and the check is plain equality.
#
#  CROSS-MODULE ON ONE NODE, as ENG-DP-003 and ENG-DP-004 are. eng.json's BufferStop
#  declares id, dangerPoint, lengthOfBufferStop and bsType; netPointReference belongs
#  to infra.json's BufferStop. One node carries both, and both module descriptions
#  must be in the graph. The guard makes the rule silent when the infra half is
#  absent - silence for want of the other half, not a clean bill of health.
#
#  MIND THE PATHS, which differ in LENGTH on the two sides - the same trap as
#  ENG-DP-003:
#
#      DangerPoint  era:topologicalCoordinate / era:onLinearElement
#      BufferStop   era:netPointReference / era:hasTopoCoordinate / era:onLinearElement
#
#  A danger point carries its coordinate DIRECTLY, as a Balise does; the buffer stop
#  goes through a NetPointReference, as a Derailer does. Using one path for both
#  would silently match nothing and pass everything.
#
#  Rationale: a buffer stop terminates the track, and its danger point is the place
#  beyond which a vehicle must not proceed - it is what the overlap behind a signal
#  is measured to, and what an approach is braked against. A danger point on some
#  other element describes a limit on track the buffer stop does not terminate, so
#  the braking distance is computed to the wrong place. The failure is in the
#  permissive direction whenever the other element is longer, which is the direction
#  that matters for a stop block.
#
#  SCOPE - dangerPoint is 0..1, so a buffer stop without one is entirely ordinary and
#  the rule is vacuous on it.
#
#  LIMITATION, AND AN OPEN QUESTION. The rule asks only that the two share an
#  ELEMENT. A danger point 400 m from its buffer stop, at the far end of the same
#  element, is accepted. Bounding the DISTANCE would be more useful still, but needs
#  a figure from you - and it is the same open question left by ENG-DP-004 and
#  ENG-DP-005, so one answer would settle all three.
#
#  REPORTING - dangerPoint is a REFERENCE, so the point carries an IRI a preparer can
#  look up and sh:value is the offending danger point itself.
#
################################################################################

eng-dp:BufferStop-ENGDP015
    a sh:NodeShape ;
    sh:targetClass era:BufferStop ;
    rdfs:label "ENG-DP-015 a buffer stop's danger point must be on its own element"@en ;
    era:additionalInfo " Every BufferStop that has a danger point must have that point standing on the exact same LinearElement the buffer stop itself stands on - not merely a related or nearby element, since a buffer stop is a single point with exactly one location, unlike a crossing or a switch which can span several elements. The danger point's location is read directly from its own coordinate; the buffer stop's location is read through a separate reference structure, since the two properties describing the same buffer stop object come from different parts of the data - both parts must be present for this check to run at all. LIMITATION: this only checks that the two stand on the same element, not how far apart they are along it - a danger point at the far end of a long element, hundreds of metres from the actual buffer stop, is still accepted by this rule."@en ;
    era:additionalInfo " Jeder BufferStop, der einen Gefahrenpunkt besitzt, muss diesen Punkt auf genau demselben LinearElement stehen haben, auf dem der Prellbock selbst steht - nicht nur auf einem verwandten oder nahegelegenen Element, da ein Prellbock ein einzelner Punkt mit genau einem Standort ist, anders als eine Kreuzung oder eine Weiche, die sich über mehrere Elemente erstrecken können. Der Standort des Gefahrenpunkts wird direkt aus seiner eigenen Koordinate gelesen; der Standort des Prellbocks wird über eine separate Referenzstruktur gelesen, da die beiden Eigenschaften, die dasselbe Prellbock-Objekt beschreiben, aus unterschiedlichen Teilen der Daten stammen - beide Teile müssen vorhanden sein, damit diese Prüfung überhaupt läuft. EINSCHRÄNKUNG: dies prüft nur, ob beide auf demselben Element stehen, nicht, wie weit sie entlang dessen voneinander entfernt sind - ein Gefahrenpunkt am fernen Ende eines langen Elements, hunderte Meter vom tatsächlichen Prellbock entfernt, wird von dieser Regel dennoch akzeptiert."@de ;
    era:additionalInfo " Chaque BufferStop possédant un point de danger doit avoir ce point situé exactement sur le même LinearElement que le heurtoir lui-même - pas simplement sur un élément apparenté ou proche, car un heurtoir est un point unique avec un seul emplacement, contrairement à un croisement ou un aiguillage qui peuvent s'étendre sur plusieurs éléments. L'emplacement du point de danger est lu directement depuis sa propre coordonnée ; l'emplacement du heurtoir est lu via une structure de référence distincte, car les deux propriétés décrivant le même objet heurtoir proviennent de parties différentes des données - les deux parties doivent être présentes pour que cette vérification s'exécute. LIMITATION : ceci vérifie seulement que les deux se trouvent sur le même élément, pas la distance qui les sépare le long de celui-ci - un point de danger situé à l'extrémité éloignée d'un long élément, à des centaines de mètres du heurtoir réel, est tout de même accepté par cette règle."@fr ;
    sh:sparql eng-dp:ENGDP015-dangerPointOffTheBufferStop ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP015-dangerPointOffTheBufferStop
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-015"@en ;
    sh:message "ENG-DP-015: this DangerPoint stands on a LinearElement other than the one its BufferStop stands on. A buffer stop terminates the track and its danger point is the limit beyond which a vehicle must not proceed - the place an overlap is measured to and an approach braked against. On a different element the limit describes track the buffer stop does not terminate, so the braking distance is computed to the wrong place, and whenever that other element is the longer one the error is in the permissive direction. Either move the danger point onto the buffer stop's element, or attach it to the buffer stop it really belongs to."@en ;
    sh:message "ENG-DP-015: dieser DangerPoint steht auf einem anderen LinearElement als dem, auf dem sein BufferStop steht. Ein Prellbock schließt das Gleis ab, und sein Gefahrenpunkt ist die Grenze, die ein Fahrzeug nicht überschreiten darf - die Stelle, zu der ein Überhang gemessen und gegen die eine Annäherung gebremst wird. Auf einem anderen Element beschreibt die Grenze Gleis, das der Prellbock nicht abschließt, sodass der Bremsweg zur falschen Stelle berechnet wird, und immer wenn dieses andere Element das längere ist, liegt der Fehler in die freizügige Richtung. Entweder den Gefahrenpunkt auf das Element des Prellbocks verschieben, oder ihn dem Prellbock zuordnen, zu dem er tatsächlich gehört."@de ;
    sh:message "ENG-DP-015: ce DangerPoint se trouve sur un LinearElement différent de celui sur lequel se trouve son BufferStop. Un heurtoir termine la voie, et son point de danger est la limite qu'un véhicule ne doit pas dépasser - l'endroit jusqu'auquel un dépassement est mesuré et contre lequel une approche est freinée. Sur un autre élément, la limite décrit une voie que le heurtoir ne termine pas, si bien que la distance de freinage est calculée jusqu'au mauvais endroit, et chaque fois que cet autre élément est le plus long, l'erreur va dans le sens permissif. Déplacez le point de danger sur l'élément du heurtoir, ou rattachez-le au heurtoir auquel il appartient réellement."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value
        WHERE {
            $this era:dangerPoint ?value .

            # a danger point carries its coordinate DIRECTLY - no NetPointReference
            ?value era:topologicalCoordinate/era:onLinearElement ?dle .

            # the buffer stop goes THROUGH a NetPointReference. This comes from the
            # INFRA description of the same node; absent, do not judge.
            $this era:netPointReference/era:hasTopoCoordinate/era:onLinearElement ?ble .

            # a buffer stop is a POINT: one element, so plain equality rather than
            # the set membership used for crossings and switches
            FILTER ( !sameTerm(?dle, ?ble) )
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-016  (E-09)  Kilometre values must run in order along the list.
#
#     for all lek: reading the kilometer values of lek.kilometricPosts in list order
#     gives a sequence that is STRICTLY MONOTONIC - increasing throughout, or
#     decreasing throughout.
#
#  The companion of ENG-DP-002, which does the same for pos. Recorded as NOT COVERED
#  there: a sound sequence of positions can still carry kilometre values that jump
#  about, and nothing until now looked at them.
#
#  EITHER DIRECTION IS ALLOWED, and here that is not merely the byIndex convention
#  but a physical necessity: a line's kilometre reference may run against the
#  direction in which the element's offsets grow, so kilometre values may perfectly
#  well DECREASE as pos increases. The rule therefore says nothing about the relation
#  between the two directions - only that each is internally consistent. Whether a
#  particular pairing is legitimate remains open, and is the one question this rule
#  deliberately does not answer.
#
#  WHY THIS SURVIVES THE OBJECTION THAT KILLED THE "km change tracks pos change"
#  IDEA. A stronger rule suggests itself: both pos and kilometer are in metres, so
#  between consecutive posts |change in kilometer| ought to equal |change in pos|.
#  That was rejected because KILOMETRE DISCONTINUITIES ARE REAL - a line's reference
#  may jump at a boundary, and posts are often placed exactly there to record it, so
#  the stronger rule would report the very thing it is meant to describe.
#
#  Monotonicity is not troubled by that. A jump from 105000 to 107000 m is still an
#  increase; the sequence stays ordered, it merely has a gap. So this rule catches
#  values that are genuinely out of order while remaining blind to legitimate
#  discontinuities - which is exactly the line to draw.
#
#  THE RESIDUAL RISK, stated plainly: a REVERSING discontinuity, where the reference
#  runs backwards part way along ONE element, would be reported. Such reversals occur
#  where two lines with different references meet, but a LinearElement is by
#  definition an uninterrupted stretch of track without divergence, so a reference
#  reversal within one is unusual. If your data has them, this rule should be
#  demoted to sh:Warning - a one-line change - rather than rewritten.
#
#  SPLIT IN TWO, as ENG-DP-002 is:
#
#    ENG-DP-016a  two ADJACENT posts with the same kilometre value. The kilometre
#                 reference is then FLAT between them: every position in that stretch
#                 maps to one kilometre, so the interpolation has no resolution at all
#                 and a distance measured in kilometres across it comes out as zero.
#
#    ENG-DP-016b  the list CHANGES DIRECTION, detected over three consecutive posts
#                 as a peak or a valley. Reporting the turning value names the post to
#                 correct.
#
#  RELIES ON THE rdf:LIST, unavoidably, as ENG-DP-002 does: order is not a property a
#  plain multi-valued property has.
#
#  INDEPENDENT OF ENG-DP-002. A list may be sound in pos and unsound in kilometer, or
#  the reverse, and the two rules report separately so the finding says which side is
#  at fault. NOT CROSS-MODULE: no infra data is needed.
#
################################################################################

eng-dp:LinearElementKm-ENGDP016
    a sh:NodeShape ;
    sh:targetClass era:LinearElementKm ;
    rdfs:label "ENG-DP-016 kilometre values must run in order along the list"@en ;
    era:additionalInfo "This reads the kilometer value of every post in a LinearElementKm's list and requires the sequence to be strictly monotonic - consistently increasing throughout, or consistently decreasing throughout. Either direction is accepted: a line's kilometre reference may legitimately run in the opposite direction to the element's own physical measurement, so this is not just a data convention but reflects real railway practice. This check deliberately tolerates large jumps in value between consecutive posts, since kilometre references can genuinely be discontinuous at boundaries where two lines' references meet, and a jump still keeps the sequence ordered - only an actual reversal, where the direction flips partway along, is reported. Two distinct failure patterns are checked: ENGDP016a fires when two ADJACENT posts share the exact same kilometer value, meaning the reference is flat between them and any distance calculated across that stretch in kilometres would come out as zero regardless of the real physical distance. ENGDP016b fires when three consecutive posts form a peak or a valley in their kilometer values, meaning the reference genuinely reverses direction. This check is independent of, and separate from, checking that the posts' physical positions (pos) are in order - a list can be correctly ordered in one and incorrectly ordered in the other, and each is reported separately so the finding identifies which side has the problem. This check does not require any other data beyond the posts' own recorded values."@en ;
    era:additionalInfo " Diese Regel liest den kilometer-Wert jedes Postens in der Liste eines LinearElementKm und verlangt, dass die Reihenfolge streng monoton ist - durchgehend steigend oder durchgehend fallend. Beide Richtungen sind zulässig: Eine Kilometerreferenzierung einer Strecke kann legitim entgegengesetzt zur physischen Messung des Elements selbst verlaufen, dies ist also keine reine Datenkonvention, sondern spiegelt reale Eisenbahnpraxis wider. Diese Prüfung toleriert bewusst große Sprünge im Wert zwischen aufeinanderfolgenden Posten, da Kilometerreferenzierungen an Grenzen, an denen sich die Referenzen zweier Strecken treffen, tatsächlich unstetig sein können, und ein Sprung hält die Reihenfolge weiterhin geordnet - nur eine tatsächliche Umkehr, bei der sich die Richtung auf halbem Weg dreht, wird gemeldet. Zwei unterschiedliche Fehlermuster werden geprüft: ENGDP016a greift, wenn zwei AUFEINANDERFOLGENDE Posten denselben kilometer-Wert teilen, was bedeutet, dass die Referenzierung zwischen ihnen flach ist und jede über diesen Abschnitt in Kilometern berechnete Entfernung null ergäbe, unabhängig von der tatsächlichen physischen Distanz. ENGDP016b greift, wenn drei aufeinanderfolgende Posten in ihren kilometer-Werten einen Gipfel oder ein Tal bilden, was bedeutet, dass sich die Referenzierung tatsächlich umkehrt. Diese Prüfung ist unabhängig von und getrennt von der Prüfung, ob die physischen Positionen (pos) der Posten in Ordnung sind - eine Liste kann in einer Hinsicht korrekt geordnet und in der anderen fehlerhaft sein, und beides wird getrennt gemeldet, sodass der Befund erkennen lässt, welche Seite das Problem hat. Diese Prüfung benötigt keine weiteren Daten außer den eigenen erfassten Werten der Posten."@de ;
    era:additionalInfo "Cette règle lit la valeur kilometer de chaque post dans la liste d'un LinearElementKm et exige que la séquence soit strictement monotone - constamment croissante, ou constamment décroissante. Les deux sens sont acceptés : le repère kilométrique d'une ligne peut légitimement évoluer dans le sens opposé à la mesure physique propre de l'élément, ce n'est donc pas seulement une convention de données mais un reflet de la pratique ferroviaire réelle. Cette vérification tolère délibérément de grands sauts de valeur entre posts consécutifs, car les repères kilométriques peuvent être réellement discontinus aux frontières où se rejoignent les repères de deux lignes, et un saut laisse tout de même la séquence ordonnée - seule une véritable inversion, où la direction se retourne en cours de route, est signalée. Deux schémas de défaillance distincts sont vérifiés : ENGDP016a se déclenche lorsque deux posts ADJACENTS partagent exactement la même valeur kilometer, ce qui signifie que le repère est plat entre eux et que toute distance calculée en kilomètres sur ce tronçon ressortirait à zéro, quelle que soit la distance physique réelle. ENGDP016b se déclenche lorsque trois posts consécutifs forment un pic ou une vallée dans leurs valeurs kilometer, ce qui signifie que le repère s'inverse réellement. Cette vérification est indépendante de, et distincte de, la vérification que les positions physiques (pos) des posts sont en ordre - une liste peut être correctement ordonnée sur l'une et incorrectement sur l'autre, et chacune est signalée séparément afin que le constat identifie quel côté pose problème. Cette vérification ne nécessite aucune autre donnée que les valeurs propres enregistrées des posts."@fr ;
    sh:sparql
        eng-dp:ENGDP016a-adjacentKilometresEqual ,
        eng-dp:ENGDP016b-kilometresChangeDirection ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP016a-adjacentKilometresEqual
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-016a"@en ;
    sh:message "ENG-DP-016a: two KilometricPosts that follow one another in this LinearElementKm's list carry the same kilometer value, {?value} m. The kilometre reference is then flat over the stretch between them: every position there maps to one kilometre, so interpolation has no resolution and any distance measured in kilometres across that stretch comes out as zero. Correct whichever value was copied, or remove the redundant post."@en ;
    sh:message "ENG-DP-016a: zwei aufeinanderfolgende KilometricPosts in der Liste dieses LinearElementKm tragen denselben Kilometerwert, {?value} m. Die Kilometerreferenzierung ist damit auf dem Abschnitt zwischen ihnen flach: Jede Position dort bildet auf einen Kilometer ab, die Interpolation hat also keine Auflösung, und jede in Kilometern gemessene Entfernung über diesen Abschnitt ergibt null. Korrigieren Sie den kopierten Wert, oder entfernen Sie den überzähligen Post."@de ;
    sh:message "ENG-DP-016a: deux KilometricPosts consécutifs dans la liste de ce LinearElementKm portent la même valeur kilométrique, {?value} m. Le repère kilométrique est alors plat sur le tronçon entre eux : chaque position à cet endroit correspond à un seul kilomètre, l'interpolation n'a donc aucune résolution, et toute distance mesurée en kilomètres sur ce tronçon ressort à zéro. Corrigez la valeur qui a été copiée, ou supprimez le post redondant."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?cell
        WHERE {
            $this era:kilometricPosts/rdf:rest* ?cell .
            ?cell rdf:first ?k1 ;
                  rdf:rest  ?c2 .
            ?c2   rdf:first ?k2 .

            ?k1 era:kilometer ?value .
            ?k2 era:kilometer ?v2 .

            FILTER ( ?value = ?v2 )
        }
    """ ;
    .

eng-dp:ENGDP016b-kilometresChangeDirection
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-016b"@en ;
    sh:message "ENG-DP-016b: this LinearElementKm's kilometre values change direction at {?value} m - the three consecutive posts reading {?v1}, {?value} and {?v3} m turn back on themselves. A kilometre reference runs consistently along an element, in whichever direction the line is measured; it may jump at a discontinuity, which leaves it still ordered, but it must not reverse part way. Correct the post reading {?value} m, or reorder the list if the posts themselves are out of sequence."@en ;
    sh:message "ENG-DP-016b: die Kilometerwerte dieses LinearElementKm ändern bei {?value} m die Richtung - die drei aufeinanderfolgenden Posts mit den Werten {?v1}, {?value} und {?v3} m kehren sich um. Eine Kilometerreferenzierung verläuft entlang eines Elements konsistent, in welcher Richtung auch immer die Strecke gemessen wird; sie kann an einer Diskontinuität springen, was sie weiterhin geordnet lässt, darf sich aber nicht auf halbem Weg umkehren. Korrigieren Sie den Post mit dem Wert {?value} m, oder ordnen Sie die Liste neu, falls die Posts selbst außer Reihenfolge sind."@de ;
    sh:message "ENG-DP-016b: les valeurs kilométriques de ce LinearElementKm changent de direction à {?value} m - les trois posts consécutifs {?v1}, {?value} et {?v3} m rebroussent chemin. Un repère kilométrique évolue de manière cohérente le long d'un élément, quel que soit le sens dans lequel la ligne est mesurée ; il peut sauter à une discontinuité, ce qui le laisse tout de même ordonné, mais il ne doit pas s'inverser en cours de route. Corrigez le post portant la valeur {?value} m, ou réordonnez la liste si les posts eux-mêmes sont dans le mauvais ordre."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?v1 ?v3 ?cell
        WHERE {
            # three consecutive posts
            $this era:kilometricPosts/rdf:rest* ?cell .
            ?cell rdf:first ?k1 ;
                  rdf:rest  ?c2 .
            ?c2   rdf:first ?k2 ;
                  rdf:rest  ?c3 .
            ?c3   rdf:first ?k3 .

            ?k1 era:kilometer ?v1 .
            ?k2 era:kilometer ?value .
            ?k3 era:kilometer ?v3 .

            # a peak or a valley. Equal adjacent values satisfy neither branch and
            # are ENG-DP-016a's business. A DISCONTINUITY - a jump in one direction -
            # leaves the sequence ordered and is deliberately not reported.
            FILTER (   ( ?v1 < ?value && ?value > ?v3 )
                    || ( ?v1 > ?value && ?value < ?v3 ) )
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-017  (E-10)  A balise's sleeper type must match the sleepers it sits on.
#
#     for all b, for all s of class Sleepers, for all sec in s.linearElementSections:
#         (  sec.onElement = b.topologicalCoordinate.onLinearElement
#            and sec.startOffsetFromOrigin
#                  <= b.topologicalCoordinate.offsetFromOrigin
#                  <= sec.endOffsetFromOrigin )
#         =>  exists such a section whose s.sleepersType = b.sleepersType
#
#  TWO INDEPENDENT RECORDS OF ONE PHYSICAL FACT, which is what makes this worth
#  checking and what makes it checkable at all. The balise records what it is
#  mounted on; the Sleepers object records what the track is laid on. You have
#  confirmed the two are recorded INDEPENDENTLY, so a disagreement is a real fault
#  in one of them rather than a transcription slip in a derived copy.
#
#  That confirmation is the whole reason this rule exists. The same question was
#  asked of a proposed rule comparing sampled and parametrised geometry, and there
#  the answer was not available - so that rule was dropped rather than written on an
#  assumption. Here the answer is yes, and the rule follows.
#
#  Neither record is wrong on its own, which is why nothing else can see this: the
#  balise's sleepersType is a valid concept, the Sleepers object is internally
#  consistent and satisfies DP-010, DP-011 and ENG-DP-012, and only holding the two
#  against one another reveals the disagreement.
#
#  Rationale: sleeper type governs how a balise is fixed to the trackbed - the
#  fastening, the mounting system and the permitted position all differ between
#  concrete, wood and steel. A balise whose record disagrees with the track it
#  stands on will be maintained, replaced or re-fixed to the wrong specification,
#  and the error surfaces in the field rather than in the data.
#
#  BOUNDARIES ARE HANDLED BY THE FORM OF THE RULE, not by a half-open interval.
#  Containment is INCLUSIVE at both ends, so a balise exactly at the join between a
#  concrete section ending at 800 and a wooden one starting at 800 falls in BOTH.
#  Rather than pick one, the rule asks whether ANY containing section agrees with
#  the balise: at such a join a balise recording either type is accepted, and only
#  one recording a third type is reported. A half-open interval would have forced an
#  arbitrary choice at every boundary and left the far end of the last section
#  uncovered.
#
#  SCOPE - a balise standing on track no Sleepers object covers is NOT reported.
#  Sleepers records are 0..* on EngArea and need not cover the whole network, so an
#  uncovered balise means only that nothing is known about the track there. The
#  guard is implicit: with no containing section, the pattern binds nothing.
#
#  CROSS-MODULE - the balise's position comes from infra, its sleepersType from eng,
#  and the Sleepers sections are infra LinearElementSections held by an eng class.
#  All must be in the graph; otherwise the rule is silent for want of data.
#
#  MALFORMED SECTIONS - a section with start > end contains nothing under an
#  inclusive test, so it silently drops out. That reversal is infra's DP-010 to
#  report.
#
#  REPORTING - the focus node is the BALISE, which carries an IRI, and sh:value is
#  its own sleepersType: the value under dispute. The conflicting Sleepers object
#  and its type are named in the message, so both sides of the disagreement are in
#  the finding.
#
################################################################################

eng-dp:Balise-ENGDP017
    a sh:NodeShape ;
    sh:targetClass era:Balise ;
    rdfs:label "ENG-DP-017 a balise's sleeper type must match the track it sits on"@en ;
    era:additionalInfo " This compares a balise's own recorded sleepersType against what the Sleepers records for the track say the balise is actually standing on. These are two independently recorded pieces of data describing the same physical situation - the balise records what it believes it is mounted on, and the Sleepers object separately records what the track itself is laid on - so a disagreement between them reflects a genuine error in one of the two records, not a copying mistake in a value derived from the other. Sleeper type governs how a balise is physically fixed to the trackbed, and the fastening, mounting system, and permitted position all differ between materials, so a wrong record leads to the balise being maintained or refitted to the wrong specification in the field. Where two sections of different sleeper types meet exactly at a boundary, a balise standing precisely at that join is accepted if it records EITHER of the two adjoining types - only a balise recording a third, unrelated type at such a boundary is reported. A balise standing on a stretch of track that no Sleepers record covers at all is not reported by this rule, since in that case nothing is actually known about the track there to compare against."@en ;
    era:additionalInfo " Diese Regel vergleicht den von einer Balise selbst erfassten sleepersType mit dem, was die Sleepers-Einträge für das Gleis darüber aussagen, worauf die Balise tatsächlich steht. Dies sind zwei unabhängig voneinander erfasste Datenpunkte, die dieselbe physische Situation beschreiben - die Balise erfasst, worauf sie ihrer eigenen Angabe nach montiert ist, und das Sleepers-Objekt erfasst separat, worauf das Gleis selbst verlegt ist - eine Abweichung zwischen beiden spiegelt daher einen echten Fehler in einem der beiden Einträge wider, nicht einen Übertragungsfehler eines von dem anderen abgeleiteten Werts. Der Schwellentyp bestimmt, wie eine Balise physisch am Gleisbett befestigt wird, und Befestigung, Montagesystem und zulässige Position unterscheiden sich je nach Material, sodass ein falscher Eintrag dazu führt, dass die Balise vor Ort nach der falschen Spezifikation gewartet oder neu befestigt wird. Treffen zwei Abschnitte unterschiedlicher Schwellentypen genau an einer Grenze aufeinander, wird eine Balise, die genau an diesem Übergang steht, akzeptiert, wenn sie EINEN der beiden angrenzenden Typen erfasst - nur eine Balise, die an einer solchen Grenze einen dritten, nicht zugehörigen Typ erfasst, wird gemeldet. Eine Balise, die auf einem Gleisabschnitt steht, den kein Sleepers-Eintrag überhaupt abdeckt, wird von dieser Regel nicht gemeldet, da in diesem Fall schlicht nichts über das dortige Gleis bekannt ist, womit verglichen werden könnte."@de ;
    era:additionalInfo "Cette règle compare le sleepersType propre enregistré par une balise à ce que les enregistrements Sleepers pour la voie indiquent quant à ce sur quoi la balise se trouve réellement. Il s'agit de deux données enregistrées indépendamment décrivant la même situation physique - la balise enregistre ce sur quoi elle pense être montée, et l'objet Sleepers enregistre séparément ce sur quoi la voie elle-même est posée - un désaccord entre les deux reflète donc une erreur réelle dans l'un des deux enregistrements, non une erreur de recopie d'une valeur dérivée de l'autre. Le type de traverse détermine comment une balise est physiquement fixée au ballast, et la fixation, le système de montage et la position admise diffèrent tous selon les matériaux, si bien qu'un enregistrement erroné conduit à ce que la balise soit entretenue ou refixée sur le terrain selon la mauvaise spécification. Là où deux sections de types de traverses différents se rejoignent exactement à une limite, une balise se trouvant précisément à cette jonction est acceptée si elle enregistre L'UN OU L'AUTRE des deux types adjacents - seule une balise enregistrant un troisième type, sans rapport, à une telle limite est signalée. Une balise se trouvant sur un tronçon de voie qu'aucun enregistrement Sleepers ne couvre n'est pas signalée par cette règle, car dans ce cas rien n'est réellement connu de la voie à cet endroit pour servir de comparaison."@fr ;
    sh:sparql eng-dp:ENGDP017-sleeperTypeDisagreesWithTrack ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP017-sleeperTypeDisagreesWithTrack
    a sh:SPARQLConstraint ;
    sh:prefixes eng-dp:PrefixDeclarations ;
    rdfs:label "ENG-DP-017"@en ;
    sh:message "ENG-DP-017: this Balise records sleepersType {?value}, but it stands at offset {?off} m on LinearElement {?le}, which {?other} records as laid on {?st}. The two are recorded independently, so one of them is wrong. Sleeper type governs how a balise is fixed to the trackbed - fastening, mounting system and permitted position all differ between concrete, wood and steel - so the balise will be maintained or re-fixed to the wrong specification, and the error surfaces in the field rather than in the data. Note that where sections meet, a balise recording EITHER adjoining type is accepted; this one matches neither."@en ;
    sh:message "ENG-DP-017: diese Balise verzeichnet sleepersType {?value}, steht jedoch bei Offset {?off} m auf LinearElement {?le}, das {?other} als auf {?st} verlegt verzeichnet. Beide werden unabhängig voneinander erfasst, eine der beiden Angaben ist also falsch. Der Schwellentyp bestimmt, wie eine Balise am Gleisbett befestigt wird - Befestigung, Montagesystem und zulässige Position unterscheiden sich zwischen Beton, Holz und Stahl - sodass die Balise nach der falschen Spezifikation gewartet oder neu befestigt wird, und der Fehler zeigt sich im Feld statt in den Daten. Hinweis: Wo Abschnitte aufeinandertreffen, wird eine Balise akzeptiert, die EINEN der beiden angrenzenden Typen verzeichnet; diese entspricht keinem von beiden."@de ;
    sh:message "ENG-DP-017: cette Balise enregistre sleepersType {?value}, mais elle se trouve au décalage {?off} m sur LinearElement {?le}, que {?other} enregistre comme posé sur {?st}. Les deux sont enregistrés indépendamment l'un de l'autre, l'un des deux est donc erroné. Le type de traverse détermine comment une balise est fixée au ballast - la fixation, le système de montage et la position admise diffèrent entre béton, bois et acier - la balise sera donc entretenue ou refixée selon la mauvaise spécification, et l'erreur apparaît sur le terrain plutôt que dans les données. Notez que là où des sections se rejoignent, une balise enregistrant L'UN OU L'AUTRE des deux types adjacents est acceptée ; celle-ci ne correspond à aucun des deux."@fr ;
    sh:select """
        SELECT DISTINCT $this ?value ?st ?other ?le ?off
        WHERE {
            # the balise's own record, from the ENG description
            $this era:sleepersType ?value .

            # its position, from the INFRA description - one coordinate node, so
            # the element and offset cannot come from different coordinates
            $this era:topologicalCoordinate ?tc .
            ?tc era:onLinearElement  ?le ;
                era:offsetFromOrigin ?off .

            # a Sleepers record containing that position. Binding it here rather
            # than in a FILTER EXISTS gives the message both sides of the dispute,
            # and doubles as the guard: a balise on track no record covers binds
            # nothing and is not reported.
            ?other a era:Sleepers ;
                   era:sleepersType ?st ;
                   era:linearElementSections ?sec .
            ?sec era:onElement ?le ;
                 era:startOffsetFromOrigin ?a ;
                 era:endOffsetFromOrigin   ?b .
            # INCLUSIVE at both ends. A reversed section contains nothing and so
            # drops out; that is DP-010's to report.
            FILTER ( ?a <= ?off && ?off <= ?b )

            # report only if NO containing record agrees with the balise. At a join
            # between two sections this accepts either adjoining type.
            FILTER NOT EXISTS {
                ?agree a era:Sleepers ;
                       era:sleepersType ?value ;
                       era:linearElementSections ?asec .
                ?asec era:onElement ?le ;
                      era:startOffsetFromOrigin ?aa ;
                      era:endOffsetFromOrigin   ?ab .
                FILTER ( ?aa <= ?off && ?off <= ?ab )
            }
        }
    """ ;
    .


################################################################################
#
#  ENG-DP-018  (E-11)  Physical magnitudes must be greater than zero.
#
#     bs.lengthOfBufferStop > 0        oa.accuracy > 0   (advisory)
#     sw.tipShift           > 0
#     sw.bladeLength        > 0
#
#  All four are physical dimensions, and all four are SHACL Core - sh:minExclusive
#  on a double, so no SPARQL and no prefix concerns. Being exclusive, one check
#  covers both zero and negative: a negative length is not a length at all.
#
#  SEVERITY IS SPLIT, and deliberately. The question raised when this was proposed
#  was whether zero has a defensible reading, and the answer differs by attribute:
#
#    VIOLATION for the three dimensions of physical objects. A buffer stop of zero
#    length is not a buffer stop; a switch whose blade has zero length has no blade;
#    a tip shift of zero means the blade does not move, which is to say the switch
#    does not switch. None of these describes anything that could exist, so unlike
#    DP-037's stop-train limits - where zero could mean "out of use" - there is no
#    reading under which the data would be right.
#
#    WARNING for accuracy. Zero accuracy claims a position known exactly, which no
#    survey delivers - but it is a plausible way of writing "treat this as exact" or
#    "no uncertainty recorded", and a consumer reading it as a tolerance of zero
#    merely becomes over-confident rather than wrong. That ambiguity is what an
#    advisory is for: draw attention, leave the judgement.
#
#  Rationale beyond "zero is odd": each of these feeds a calculation.
#  lengthOfBufferStop is subtracted from an approach when working out where a train
#  must stop; bladeLength and tipShift determine switch geometry and therefore the
#  speed permitted through the diverging route; accuracy is the margin every other
#  position on the element is trusted within. A zero propagates into each of those
#  as a silently optimistic answer.
#
#  NOTE ON WHAT IS ALREADY COVERED. Neither eng-shapes.ttl nor infra-shapes.ttl
#  bounds any of these: none carries a "range" tag in eng.json, so the generator
#  emits only sh:datatype. The floor is genuinely absent until this rule.
#
################################################################################

eng-dp:BufferStop-ENGDP018
    a sh:NodeShape ;
    sh:targetClass era:BufferStop ;
    rdfs:label "ENG-DP-018 a buffer stop must have positive length"@en ;
    era:additionalInfo " This is a straightforward physical-plausibility check: a buffer stop's length must be a positive number, since a buffer stop that occupies no physical track at all cannot exist. This is reported as a hard violation rather than an advisory, unlike some other zero-value checks in this dataset, because there is no legitimate reading under which zero or a negative length would be intentional or meaningful here. This value directly feeds the calculation of where an approaching train must be brought to a stop, so an incorrect value here has a direct, silent effect on that calculation - a zero value would compute the stopping point too far along, past where the buffer stop actually is."@en ;
    era:additionalInfo " Dies ist eine einfache physikalische Plausibilitätsprüfung: die Länge eines Prellbocks muss eine positive Zahl sein, da ein Prellbock, der überhaupt kein physisches Gleis belegt, nicht existieren kann. Dies wird, anders als einige andere Nullwert-Prüfungen in diesem Datensatz, als harter Verstoß statt als Hinweis gemeldet, da es hier keine legitime Lesart gibt, unter der null oder ein negativer Wert beabsichtigt oder sinnvoll wäre. Dieser Wert fließt direkt in die Berechnung ein, wo ein sich näherender Zug zum Stehen gebracht werden muss, sodass ein falscher Wert hier eine direkte, unsichtbare Auswirkung auf diese Berechnung hat - ein Nullwert würde den Haltepunkt zu weit vorne berechnen, über die tatsächliche Position des Prellbocks hinaus."@de ;
    era:additionalInfo " Il s'agit d'une vérification simple de plausibilité physique : la longueur d'un heurtoir doit être un nombre positif, car un heurtoir n'occupant aucune voie physique ne peut exister. Ceci est signalé comme une violation stricte plutôt qu'un avis, contrairement à certaines autres vérifications de valeur nulle dans ce jeu de données, car il n'existe ici aucune lecture légitime selon laquelle zéro ou une valeur négative serait intentionnelle ou significative. Cette valeur alimente directement le calcul de l'endroit où un train qui approche doit être amené à l'arrêt, si bien qu'une valeur incorrecte ici a un effet direct et silencieux sur ce calcul - une valeur nulle calculerait le point d'arrêt trop loin, au-delà de l'emplacement réel du heurtoir."@fr ;
    sh:property eng-dp:ENGDP018a-bufferStopLengthPositive ;
    .

eng-dp:ENGDP018a-bufferStopLengthPositive
    a sh:PropertyShape ;
    rdfs:label "ENG-DP-018a"@en ;
    sh:path era:lengthOfBufferStop ;
    sh:minExclusive 0 ;
    sh:message "ENG-DP-018a: lengthOfBufferStop is zero or negative. A buffer stop occupies a physical length of track, and that length is subtracted from an approach when working out where a train must be brought to a stand; zero makes the stop block occupy no track at all and the stopping point is computed too far along. Unlike a stop-train limit, zero has no defensible reading here."@en ;
    sh:message "ENG-DP-018a: lengthOfBufferStop ist null oder negativ. Ein Prellbock belegt eine physische Gleislänge, und diese Länge wird von einer Annäherung abgezogen, wenn berechnet wird, wo ein Zug zum Stehen gebracht werden muss; null lässt den Prellbock kein Gleis belegen, und der Haltepunkt wird zu weit vorne berechnet. Anders als bei einer Grenze für Zughalt gibt es hier keine vertretbare Lesart für null."@de ;
    sh:message "ENG-DP-018a: lengthOfBufferStop est nul ou négatif. Un heurtoir occupe une longueur physique de voie, et cette longueur est soustraite d'une approche lors du calcul de l'endroit où un train doit être amené à l'arrêt ; zéro fait que le heurtoir n'occupe aucune voie, et le point d'arrêt est calculé trop loin. Contrairement à une limite d'arrêt de train, il n'y a ici aucune lecture défendable de zéro."@fr ;
    sh:severity sh:Violation ;
    .

eng-dp:Switch-ENGDP018
    a sh:NodeShape ;
    sh:targetClass era:Switch ;
    rdfs:label "ENG-DP-018 a switch's blade dimensions must be positive"@en ;
    era:additionalInfo " This checks two physical dimensions of a switch: tipShift, the distance the switch blade physically moves between its two positions, and bladeLength, the blade's own physical length. Both must be positive numbers, since a zero or negative value describes a component that cannot physically exist - a blade that does not move (tipShift of zero) means the switch could never actually change a train's route, and a blade with no length at all is not a blade. Together, these two values determine the switch's overall geometry, which is used elsewhere to calculate the speed a train may safely take through the diverging route - so an incorrect value in either one has effects beyond just that single field."@en ;
    era:additionalInfo "Diese Regel prüft zwei physische Abmessungen einer Weiche: tipShift, die Strecke, um die sich die Weichenzunge physisch zwischen ihren beiden Stellungen bewegt, und bladeLength, die eigene physische Länge der Zunge. Beide müssen positive Zahlen sein, da ein Wert von null oder negativ ein Bauteil beschreibt, das physisch nicht existieren kann - eine Zunge, die sich nicht bewegt (tipShift von null), bedeutet, dass die Weiche niemals tatsächlich die Fahrtroute eines Zuges ändern könnte, und eine Zunge ganz ohne Länge ist keine Zunge. Zusammen bestimmen diese beiden Werte die Gesamtgeometrie der Weiche, die anderswo genutzt wird, um die Geschwindigkeit zu berechnen, die ein Zug sicher durch den abzweigenden Strang nehmen darf - ein falscher Wert bei einem der beiden wirkt sich also über dieses eine Feld hinaus aus."@de ;
    era:additionalInfo "Cette règle vérifie deux dimensions physiques d'un aiguillage : tipShift, la distance dont l'aiguille se déplace physiquement entre ses deux positions, et bladeLength, la longueur physique propre de l'aiguille. Les deux doivent être des nombres positifs, car une valeur nulle ou négative décrit un composant qui ne peut physiquement exister - une aiguille qui ne bouge pas (tipShift nul) signifie que l'aiguillage ne pourrait jamais réellement changer l'itinéraire d'un train, et une aiguille sans aucune longueur n'est pas une aiguille. Ensemble, ces deux valeurs déterminent la géométrie globale de l'aiguillage, utilisée ailleurs pour calculer la vitesse qu'un train peut emprunter en toute sécurité sur la voie déviante - une valeur incorrecte dans l'une ou l'autre a donc des effets allant au-delà de ce seul champ."@fr ;
    sh:property
        eng-dp:ENGDP018b-tipShiftPositive ,
        eng-dp:ENGDP018c-bladeLengthPositive ;
    .

eng-dp:ENGDP018b-tipShiftPositive
    a sh:PropertyShape ;
    rdfs:label "ENG-DP-018b"@en ;
    sh:path era:tipShift ;
    sh:minExclusive 0 ;
    sh:message "ENG-DP-018b: tipShift is zero or negative. The tip shift is how far the blade moves between its two positions; zero means the blade does not move, which is to say the switch does not switch. It also feeds the switch geometry from which the speed permitted through the diverging route is derived."@en ;
    sh:message "ENG-DP-018b: tipShift ist null oder negativ. Der tipShift ist die Strecke, um die sich die Zunge zwischen ihren beiden Stellungen bewegt; null bedeutet, dass sich die Zunge nicht bewegt, die Weiche also nicht umstellt. Er fließt außerdem in die Weichengeometrie ein, aus der die auf dem abzweigenden Strang zulässige Geschwindigkeit abgeleitet wird."@de ;
    sh:message "ENG-DP-018b: tipShift est nul ou négatif. Le tipShift est la distance dont se déplace l'aiguille entre ses deux positions ; zéro signifie que l'aiguille ne bouge pas, c'est-à-dire que l'aiguillage ne change pas de position. Il alimente également la géométrie de l'aiguillage à partir de laquelle est dérivée la vitesse autorisée sur la voie déviante."@fr ;
    sh:severity sh:Violation ;
    .

eng-dp:ENGDP018c-bladeLengthPositive
    a sh:PropertyShape ;
    rdfs:label "ENG-DP-018c"@en ;
    sh:path era:bladeLength ;
    sh:minExclusive 0 ;
    sh:message "ENG-DP-018c: bladeLength is zero or negative. A switch blade has a physical length, and together with tipShift it determines the switch geometry and therefore the speed permitted through the diverging route. A blade of zero length describes a switch that cannot exist."@en ;
    sh:message "ENG-DP-018c: bladeLength ist null oder negativ. Eine Weichenzunge hat eine physische Länge, und zusammen mit tipShift bestimmt sie die Weichengeometrie und damit die auf dem abzweigenden Strang zulässige Geschwindigkeit. Eine Zunge der Länge null beschreibt eine Weiche, die nicht existieren kann."@de ;
    sh:message "ENG-DP-018c: bladeLength est nul ou négatif. Une aiguille d'aiguillage a une longueur physique, et avec tipShift, elle détermine la géométrie de l'aiguillage et donc la vitesse autorisée sur la voie déviante. Une aiguille de longueur nulle décrit un aiguillage qui ne peut pas exister."@fr ;
    sh:severity sh:Violation ;
    .

eng-dp:OffsetAccuracy-ENGDP018
    a sh:NodeShape ;
    sh:targetClass era:OffsetAccuracy ;
    rdfs:label "ENG-DP-018 an accuracy of zero is probably a placeholder"@en ;
    sh:property eng-dp:ENGDP018d-accuracyPositive ;
    .

eng-dp:ENGDP018d-accuracyPositive
    a sh:PropertyShape ;
    rdfs:label "ENG-DP-018d"@en ;
    sh:path era:accuracy ;
    sh:minExclusive 0 ;
    sh:message "ENG-DP-018d (advisory): accuracy is zero or negative. Zero claims a position known exactly, which no survey delivers - though it may be an intended way of writing 'treat as exact' or 'no uncertainty recorded'. It is raised as advice rather than as a fault because that reading is defensible; a negative value is not, and is always wrong. Note accuracy is the margin within which every other position on this element is trusted, so an over-confident value propagates widely."@en ;
    sh:message "ENG-DP-018d (Hinweis): accuracy ist null oder negativ. Null beansprucht eine exakt bekannte Position, die keine Vermessung liefert - es kann jedoch eine beabsichtigte Schreibweise für 'als exakt behandeln' oder 'keine Unsicherheit erfasst' sein. Es wird als Hinweis statt als Fehler gemeldet, weil diese Lesart vertretbar ist; ein negativer Wert ist es nicht und ist immer falsch. Hinweis: accuracy ist die Marge, innerhalb derer jede andere Position auf diesem Element vertraut wird, ein zu selbstsicherer Wert pflanzt sich also weitreichend fort."@de ;
    sh:message "ENG-DP-018d (avis): accuracy est nul ou négatif. Zéro revendique une position connue exactement, ce qu'aucun levé topographique ne fournit - bien que cela puisse être une façon voulue d'écrire « à traiter comme exact » ou « aucune incertitude enregistrée ». Ceci est signalé à titre d'avis plutôt que comme une erreur car cette lecture est défendable ; une valeur négative ne l'est pas et est toujours erronée. Notez qu'accuracy est la marge dans laquelle toute autre position sur cet élément est créditée de confiance, une valeur trop confiante se propage donc largement."@fr ;
    sh:severity sh:Warning ;
    .
