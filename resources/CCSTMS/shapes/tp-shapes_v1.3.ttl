@prefix era: <http://data.europa.eu/949/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== Allocation Section Shape =====
era:AllocationSectionShape a sh:NodeShape ;
    sh:targetClass era:AllocationSection ;
    sh:message "Track allocation section for train protection with dependencies defining safe occupancy rules."@en ;
    sh:message "Gleiszuteilungsabschnitt für die Zugsicherung mit Abhängigkeiten, die sichere Belegungsregeln definieren."@de ;
    sh:message "Section d'attribution des voies pour la protection des trains avec des dépendances définissant les règles d'occupation en toute sécurité."@fr ;
    
    # Linear Reference (required, track location)
    sh:property [ 
        sh:path era:linearReference ;
        sh:node era:NetLinearReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AllocationSection must reference exactly one linearReference that conforms to NetLinearReference object. A proper NetLinearReference is needed"@en ;
        sh:message "Jeder AllocationSection muss auf genau ein linearReference verweisen, das dem NetLinearReference-Objekt entspricht. Es ist eine ordnungsgemäße NetLinearReference erforderlich"@de ;
        sh:message "Chaque AllocationSection doit faire référence à exactement un linearReference conforme à l'objet NetLinearReference. Une NetLinearReference appropriée est nécessaire"@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Dependencies (required, at least one dependency)
    sh:property [ 
        sh:path era:dependencies ;
        sh:class era:AllocationSection ;
		sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Each AllocationSection must have at least one dependencies (other allocation sections that must be considered for safe operation)."@en ;
        sh:message "Jeder AllocationSection muss mindestens eine Abhängigkeit haben (andere Allocation-Abschnitte, die für einen sicheren Betrieb berücksichtigt werden müssen)."@de ;
        sh:message "Chaque AllocationSection doit avoir au moins une dépendance (autres sections d'allocation qui doivent être prises en compte pour un fonctionnement sûr)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Name (optional, string - section identifier)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "An AllocationSection may have at most one name (string, section identifier)."@en ;
        sh:message "Eine AllocationSection darf höchstens einen Namen haben (Zeichenfolge, Abschnittskennung)."@de ;
        sh:message "Une AllocationSection peut avoir au plus un nom (chaîne, identifiant de section)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Area of Control Shape =====
era:AreaOfControlShape a sh:NodeShape ;
    sh:targetClass era:AreaOfControl ;
    sh:message "Geographic area controlled by a specific interlocking or control system."@en ;
    sh:message "Geografisches Gebiet, das von einem bestimmten Stellwerk oder Leitsystem kontrolliert wird."@de ;
    sh:message "Zone géographique contrôlée par un système d'enclenchement ou de contrôle spécifique."@fr ;
    
    # Area (required, geographic extent)
    sh:property [ 
        sh:path era:area ;
        sh:node era:NetAreaReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each AreaOfControl must reference exactly one area that conforms to NetAreaReference object."@en ;
        sh:message "Jedes AreaOfControl muss genau einen Bereich referenzieren, der dem NetAreaReference-Objekt entspricht."@de ;
        sh:message "Chaque AreaOfControl doit référencer exactement une zone conforme à l’objet NetAreaReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Controlled By (optional, controller reference)
    sh:property [ 
        sh:path era:controlledBy ;
        sh:node era:ControllerShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "An AreaOfControl may reference at most one controlledBy that conforms to Controller object."@en ;
        sh:message "Ein AreaOfControl kann höchstens ein controlledBy referenzieren, das dem Controller-Objekt entspricht."@de ;
        sh:message "Un AreaOfControl peut référencer au plus un controlledBy conforme à l'objet Controller."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Name (optional, string - area identifier)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "An AreaOfControl may have at most one name (string, control area identifier)."@en ;
        sh:message "Ein AreaOfControl darf höchstens einen Namen (String, Kontrollbereichskennung) haben."@de ;
        sh:message "Un AreaOfControl peut avoir au plus un nom (chaîne, identifiant de zone de contrôle)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Controlled Infrastructure Element Shape =====
era:ControlledInfraElementShape a sh:NodeShape ;
    sh:targetClass era:ControlledInfraElement ;
    sh:message "Infrastructure element under interlocking control - must be exactly one element type (DPS group or TVP section)."@en ;
    sh:message "Infrastrukturelement unter Stellwerkssteuerung – muss genau ein Elementtyp sein (DPS-Gruppe oder TVP-Abschnitt)."@de ;
    sh:message "Élément d'infrastructure sous contrôle de verrouillage - doit être exactement un type d'élément (groupe DPS ou section TVP)."@fr ;
    
    # Each Controlled Infrastructure Element must have exactly ONE of these types
    sh:xone (
        [ sh:path era:dpsGroup ;
          sh:class era:DriveProtectionSectionGroup ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Controlled infrastructure element is a drive protection section group."@en ;
          sh:message "Das kontrollierte Infrastrukturelement ist eine Antriebsschutzabschnittsgruppe."@de ;
          sh:message "L'élément d'infrastructure contrôlé est un groupe de sections de protection du lecteur."@fr ]
        
        [ sh:path era:tvpSection ;
          sh:class era:TvpSection ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Controlled infrastructure element is a TVP (Track Vacancy Proof) section."@en ;
          sh:message "Das kontrollierte Infrastrukturelement ist ein TVP-Abschnitt (Track Vacancy Proof)."@de ;
          sh:message "L'élément d'infrastructure contrôlé est une section TVP (Track Vacancy Proof)."@fr ]
    ) .

# ===== Controller Shape =====
era:ControllerShape a sh:NodeShape ;
    sh:targetClass era:Controller ;
    sh:message "Interlocking or signaling controller with network communication parameters."@en ;
    sh:message "Stellwerks- oder Signalsteuerung mit Netzwerkkommunikationsparametern."@de ;
    sh:message "Contrôleur de verrouillage ou de signalisation avec paramètres de communication réseau."@fr ;
    
    # IP Address (optional, string - network address)
    sh:property [ 
        sh:path era:iPAddress ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Controller may have at most one iPAddress (string, IP address for network communication)."@en ;
        sh:message "Ein Controller darf höchstens eine iPAddress (Zeichenfolge, IP-Adresse für die Netzwerkkommunikation) haben."@de ;
        sh:message "Un contrôleur peut avoir au plus un iPAddress (chaîne, adresse IP pour la communication réseau)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Port Number (optional, string - TCP/UDP port)
    sh:property [ 
        sh:path era:portNumber ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Controller may have at most one portNumber (string, network port for communication)."@en ;
        sh:message "Ein Controller darf höchstens einen portNumber (String, Netzwerkport für die Kommunikation) haben."@de ;
        sh:message "Un contrôleur peut avoir au plus un portNumber (chaîne, port réseau pour la communication)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Version (optional, unsigned integer - software/firmware version)
    sh:property [ 
        sh:path era:version ;
        sh:datatype xsd:unsignedInt ;
        sh:maxCount 1 ;
        sh:message "A Controller may have at most one version (unsigned integer, software/firmware version number)."@en ;
        sh:message "Ein Controller darf höchstens eine Version haben (vorzeichenlose Ganzzahl, Software-/Firmware-Versionsnummer)."@de ;
        sh:message "Un Contrôleur peut avoir au plus une version (entier non signé, numéro de version du logiciel/micrologiciel)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # EULYNX Baseline (optional, string - protocol version)
    sh:property [ 
        sh:path era:eulynxBaseline ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Controller may have at most one eulynxBaseline (string, EULYNX protocol baseline version)."@en ;
        sh:message "Ein Controller darf höchstens eine eulynxBaseline (Zeichenfolge, Basisversion des EULYNX-Protokolls) haben."@de ;
        sh:message "Un contrôleur peut avoir au plus un eulynxBaseline (chaîne, version de base du protocole EULYNX)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Drive Protection Section Group Shape =====
era:DriveProtectionSectionGroupShape a sh:NodeShape ;
    sh:targetClass era:DriveProtectionSectionGroup ;
    sh:message "Group of drive protection sections providing flank protection for a protected infrastructure element (switch, crossing, etc.)."@en ;
    sh:message "Gruppe von Antriebsschutzabschnitten, die einen Flankenschutz für ein geschütztes Infrastrukturelement (Weiche, Kreuzung usw.) bieten."@de ;
    sh:message "Groupe de sections de protection d'entraînement assurant la protection des flancs d'un élément d'infrastructure protégé (aiguillage, passage à niveau, etc.)."@fr ;
    
    # Dependencies Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:dependenciesType ;
        sh:in (
            <http://data.europa.eu/949/concepts/dps-dependency-type/exclusive>
            <http://data.europa.eu/949/concepts/dps-dependency-type/equivalent>
            <http://data.europa.eu/949/concepts/dps-dependency-type/specific>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property dependenciesType must have a value from the defined SKOS concept scheme (exclusive, equivalent, or specific)."@en ;
        sh:message "Die Eigenschaft dependenciesType muss einen Wert aus dem definierten SKOS-Konzeptschema haben (exklusiv, äquivalent oder spezifisch)."@de ;
        sh:message "La propriété dependenciesType doit avoir une valeur du schéma de concept SKOS défini (exclusif, équivalent ou spécifique)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Run Time (required, unsigned integer - activation time in seconds)
    sh:property [ 
        sh:path era:runTime ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DriveProtectionSectionGroup must have exactly one runTime (unsigned integer, time in seconds to activate protection)."@en ;
        sh:message "Jede DriveProtectionSectionGroup muss genau eine runTime haben (Ganzzahl ohne Vorzeichen, Zeit in Sekunden zum Aktivieren des Schutzes)."@de ;
        sh:message "Chaque DriveProtectionSectionGroup doit avoir exactement un runTime (entier non signé, délai en secondes pour activer la protection)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Protected Infrastructure Elements (required, what is being protected)
    sh:property [ 
        sh:path era:protectedInfraElements ;
        sh:node era:ProtectedInfraElementShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DriveProtectionSectionGroup must reference exactly one protectedInfraElements that conforms to ProtectedInfraElement object."@en ;
        sh:message "Jede DriveProtectionSectionGroup muss auf genau ein protectedInfraElements verweisen, das dem ProtectedInfraElement-Objekt entspricht."@de ;
        sh:message "Chaque DriveProtectionSectionGroup doit faire référence à exactement un protectedInfraElements conforme à l'objet ProtectedInfraElement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Drive Protection Sections (required, at least one section)
    sh:property [ 
        sh:path era:driveProtectionSections ;
        sh:node era:DriveProtectionSectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each DriveProtectionSectionGroup must contain at least one driveProtectionSections that conform to DriveProtectionSection object."@en ;
        sh:message "Jede DriveProtectionSectionGroup muss mindestens ein driveProtectionSections enthalten, das dem DriveProtectionSection-Objekt entspricht."@de ;
        sh:message "Chaque DriveProtectionSectionGroup doit contenir au moins un driveProtectionSections conforme à l'objet DriveProtectionSection."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # DPSG Dependencies (optional, multiple dependency references)
    sh:property [ 
        sh:path era:dpsgDependencies ;
        sh:datatype xsd:unsignedInt ;
        sh:message "A DriveProtectionSectionGroup may reference multiple dpsgDependencies (unsigned integer IDs of dependent DPS groups)."@en ;
        sh:message "Eine DriveProtectionSectionGroup kann auf mehrere dpsgDependencies (vorzeichenlose Ganzzahl-IDs abhängiger DPS-Gruppen) verweisen."@de ;
        sh:message "Un DriveProtectionSectionGroup peut faire référence à plusieurs dpsgDependencies (ID entiers non signés de groupes DPS dépendants)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Name (optional, string - group identifier)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A DriveProtectionSectionGroup may have at most one name (string, DPS group identifier)."@en ;
        sh:message "Eine DriveProtectionSectionGroup darf höchstens einen Namen haben (Zeichenfolge, DPS-Gruppenkennung)."@de ;
        sh:message "Un DriveProtectionSectionGroup peut avoir au plus un nom (chaîne, identifiant de groupe DPS)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Drive Protection Section Shape =====
era:DriveProtectionSectionShape a sh:NodeShape ;
    sh:targetClass era:DriveProtectionSection ;
    sh:message "Individual track section providing flank protection with maximum permissible speed."@en ;
    sh:message "Einzelner Gleisabschnitt mit Flankenschutz bei maximal zulässiger Geschwindigkeit."@de ;
    sh:message "Section de voie individuelle offrant une protection des flancs avec une vitesse maximale autorisée."@fr ;
    
    # Name (required, string - section identifier)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DriveProtectionSection must have exactly one name (string, section identifier)."@en ;
        sh:message "Jede DriveProtectionSection muss genau einen Namen (Zeichenfolge, Abschnittskennung) haben."@de ;
        sh:message "Chaque DriveProtectionSection doit avoir exactement un nom (chaîne, identifiant de section)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Linear Element Section (required, track location)
    sh:property [ 
        sh:path era:linearElementSection ;
        sh:node era:LinearElementSectionShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DriveProtectionSection must reference exactly one linearElementSection that conforms to LinearElementSection object."@en ;
        sh:message "Jeder DriveProtectionSection muss auf genau ein linearElementSection verweisen, das dem LinearElementSection-Objekt entspricht."@de ;
        sh:message "Chaque DriveProtectionSection doit faire référence à exactement un linearElementSection conforme à l'objet LinearElementSection."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Max Flank Protection Speed (required, unsigned integer - speed in km/h)
    sh:property [ 
        sh:path era:maxFlankProtectionSpeed ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each DriveProtectionSection must have exactly one maxFlankProtectionSpeed (unsigned integer, maximum speed in km/h for safe flank protection)."@en ;
        sh:message "Jede DriveProtectionSection muss genau eine maxFlankProtectionSpeed (vorzeichenlose Ganzzahl, maximale Geschwindigkeit in km/h für sicheren Flankenschutz) haben."@de ;
        sh:message "Chaque DriveProtectionSection doit avoir exactement un maxFlankProtectionSpeed (entier non signé, vitesse maximale en km/h pour une protection sûre des flancs)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== ETCS Marker Shape =====
era:ETCSMarkerShape a sh:NodeShape ;
    sh:targetClass era:ETCSMarker ;
    sh:message "ETCS marker board indicating transition points between ETCS levels or areas."@en ;
    sh:message "ETCS-Markierungstafel, die Übergangspunkte zwischen ETCS-Ebenen oder -Bereichen anzeigt."@de ;
    sh:message "Tableau de marquage ETCS indiquant les points de transition entre les niveaux ou zones ETCS."@fr ;
    
    # Marker Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:markerType ;
        sh:in (
            <http://data.europa.eu/949/concepts/marker-function/entry>
            <http://data.europa.eu/949/concepts/marker-function/exit>
            <http://data.europa.eu/949/concepts/marker-function/intermediate>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property markerType must have a value from the defined SKOS concept scheme (entry, exit, or intermediate)."@en ;
        sh:message "Die Eigenschaft markerType muss einen Wert aus dem definierten SKOS-Konzeptschema (Eintritt, Ausgang oder Zwischen) haben."@de ;
        sh:message "La propriété markerType doit avoir une valeur du schéma de concept SKOS défini (entrée, sortie ou intermédiaire)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Max Transition Speed (optional, unsigned integer - speed in km/h)
    sh:property [ 
        sh:path era:maxTransitionSpeed ;
        sh:datatype xsd:unsignedInt ;
        sh:message "An ETCSMarker may have maxTransitionSpeed (unsigned integer, maximum speed in km/h for ETCS level transition)."@en ;
        sh:message "Ein ETCSMarker kann maxTransitionSpeed haben (vorzeichenlose Ganzzahl, maximale Geschwindigkeit in km/h für den ETCS-Ebenenübergang)."@de ;
        sh:message "Un ETCSMarker peut avoir maxTransitionSpeed (entier non signé, vitesse maximale en km/h pour la transition de niveau ETCS)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Acknowledgement Distance (optional, unsigned integer - distance in meters)
    sh:property [ 
        sh:path era:acknowledgementDistance ;
        sh:datatype xsd:unsignedInt ;
        sh:message "An ETCSMarker may have acknowledgementDistance (unsigned integer, distance in meters before marker where driver must acknowledge transition)."@en ;
        sh:message "Ein ETCSMarker kann acknowledgementDistance haben (ganzzahlige Zahl ohne Vorzeichen, Abstand in Metern vor der Markierung, an der der Fahrer den Übergang bestätigen muss)."@de ;
        sh:message "Un ETCSMarker peut avoir acknowledgementDistance (entier non signé, distance en mètres avant le marqueur où le conducteur doit accuser réception de la transition)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Offset Transition Unreachable (optional, unsigned integer - distance in meters)
    sh:property [ 
        sh:path era:offsetTransitionUnreachable ;
        sh:datatype xsd:unsignedInt ;
        sh:message "An ETCSMarker may have offsetTransitionUnreachable (unsigned integer, distance in meters where transition becomes impossible)."@en ;
        sh:message "Ein ETCSMarker kann offsetTransitionUnreachable haben (Ganzzahl ohne Vorzeichen, Entfernung in Metern, bei der ein Übergang unmöglich wird)."@de ;
        sh:message "Un ETCSMarker peut avoir offsetTransitionUnreachable (entier non signé, distance en mètres où la transition devient impossible)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Field Object Controller Shape =====
era:FieldObjectControllerShape a sh:NodeShape ;
    sh:targetClass era:FieldObjectController ;
    sh:message "Field controller managing specific infrastructure elements within an area of control."@en ;
    sh:message "Feldcontroller, der bestimmte Infrastrukturelemente innerhalb eines Kontrollbereichs verwaltet."@de ;
    sh:message "Contrôleur de terrain gérant des éléments d’infrastructure spécifiques dans une zone de contrôle."@fr ;
    
    # Belongs To AOC (required, area of control membership)
    sh:property [ 
        sh:path era:belongsToAoc ;
        sh:class era:AreaOfControl ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each FieldObjectController must reference exactly one belongsToAoc that conforms to AreaOfControl object."@en ;
        sh:message "Jeder FieldObjectController muss genau ein belongsToAoc referenzieren, das dem AreaOfControl-Objekt entspricht."@de ;
        sh:message "Chaque FieldObjectController doit faire référence à exactement un belongsToAoc conforme à l'objet AreaOfControl."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Controlled By (required, parent controller)
    sh:property [ 
        sh:path era:controlledBy ;
        sh:node era:ControllerShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each FieldObjectController must reference exactly one controlledBy that conforms to Controller object."@en ;
        sh:message "Jeder FieldObjectController muss genau ein controlledBy referenzieren, das dem Controller-Objekt entspricht."@de ;
        sh:message "Chaque FieldObjectController doit faire référence à exactement un controlledBy conforme à l'objet Controller."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Controlled Infrastructure Elements (required, at least one element)
    sh:property [ 
        sh:path era:controlledInfraElements ;
        sh:node era:ControlledInfraElementShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:message "Each FieldObjectController must control at least one controlledInfraElements that conform to ControlledInfraElement object."@en ;
        sh:message "Jeder FieldObjectController muss mindestens ein controlledInfraElements steuern, das dem ControlledInfraElement-Objekt entspricht."@de ;
        sh:message "Chaque FieldObjectController doit contrôler au moins un controlledInfraElements conforme à l'objet ControlledInfraElement."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Protected Infrastructure Element Shape =====
era:ProtectedInfraElementShape a sh:NodeShape ;
    sh:targetClass era:ProtectedInfraElement ;
    sh:message "Infrastructure element requiring flank protection - must be exactly one element type."@en ;
    sh:message "Infrastrukturelement, das einen Flankenschutz erfordert – muss genau einem Elementtyp angehören."@de ;
    sh:message "Élément d'infrastructure nécessitant une protection des flancs - doit être exactement un type d'élément."@fr ;
    
    # Each Protected Infrastructure Element must have exactly ONE of these types
    sh:xone (
        [ sh:path era:switch ;
          sh:class era:Switch ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Protected infrastructure element is a switch (points)."@en ;
          sh:message "Geschütztes Infrastrukturelement ist ein Schalter (Weiche)."@de ;
          sh:message "L'élément d'infrastructure protégé est un commutateur (points)."@fr ]
        
        [ sh:path era:crossing ;
          sh:class era:Crossing ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Protected infrastructure element is a crossing (diamond)."@en ;
          sh:message "Geschütztes Infrastrukturelement ist eine Kreuzung (Raute)."@de ;
          sh:message "L'élément d'infrastructure protégé est un passage (losange)."@fr ]
        
        [ sh:path era:slipCrossing ;
          sh:class era:SlipCrossing ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Protected infrastructure element is a slip crossing."@en ;
          sh:message "Geschütztes Infrastrukturelement ist ein Bahnübergang."@de ;
          sh:message "L'élément d'infrastructure protégé est un passage à niveau."@fr ]
        
        [ sh:path era:levelCrossing ;
          sh:class era:LevelCrossing ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Protected infrastructure element is a level crossing (road/rail intersection)."@en ;
          sh:message "Geschütztes Infrastrukturelement ist ein Bahnübergang (Kreuzung Straße/Schiene)."@de ;
          sh:message "L'élément d'infrastructure protégé est un passage à niveau (intersection route/rail)."@fr ]
        
        [ sh:path era:derailer ;
          sh:class era:Derailer ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Protected infrastructure element is a derailer (safety device)."@en ;
          sh:message "Das geschützte Infrastrukturelement ist ein Entgleiser (Sicherheitseinrichtung)."@de ;
          sh:message "L'élément d'infrastructure protégé est un dérailleur (dispositif de sécurité)."@fr ]
    ) .

# ===== Train Protection Area Shape =====
era:TrainProtectionAreaShape a sh:NodeShape ;
    sh:targetClass era:TrainProtectionArea ;
    sh:message "Complete train protection system configuration for an area including controllers, DPS groups, and allocation sections."@en ;
    sh:message "Vollständige Konfiguration des Zugsicherungssystems für einen Bereich, einschließlich Controller, DPS-Gruppen und Zuweisungsabschnitte."@de ;
    sh:message "Configuration complète du système de protection des trains pour une zone comprenant les contrôleurs, les groupes DPS et les sections d'allocation."@fr ;
    
    # Controllers (optional, multiple controllers)
    sh:property [ 
        sh:path era:controllers ;
        sh:node era:ControllerShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A TrainProtectionArea may contain multiple validated controllers."@en ;
        sh:message "Eine TrainProtectionArea kann mehrere validierte Controller enthalten."@de ;
        sh:message "Une TrainProtectionArea peut contenir plusieurs contrôleurs validés."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Area of Control (optional, multiple control areas)
    sh:property [ 
        sh:path era:areaOfControl ;
        sh:node era:AreaOfControlShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A TrainProtectionArea may contain multiple validated areaOfControl."@en ;
        sh:message "Eine TrainProtectionArea kann mehrere validierte areaOfControl enthalten."@de ;
        sh:message "Une TrainProtectionArea peut contenir plusieurs areaOfControl validés."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Field Object Controllers (optional, multiple field controllers)
    sh:property [ 
        sh:path era:fieldObjectControllers ;
        sh:node era:FieldObjectControllerShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A TrainProtectionArea may contain multiple validated fieldObjectControllers."@en ;
        sh:message "Eine TrainProtectionArea kann mehrere validierte fieldObjectControllers enthalten."@de ;
        sh:message "Une TrainProtectionArea peut contenir plusieurs fieldObjectControllers validés."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # DPS Groups (optional, multiple protection groups)
    sh:property [ 
        sh:path era:dpsGroups ;
        sh:node era:DriveProtectionSectionGroupShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A TrainProtectionArea may contain multiple validated dpsGroups (drive protection section groups)."@en ;
        sh:message "Eine TrainProtectionArea kann mehrere validierte dpsGroups (Laufwerkschutzabschnittsgruppen) enthalten."@de ;
        sh:message "Une TrainProtectionArea peut contenir plusieurs dpsGroups validés (groupes de sections de protection de lecteur)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Allocation Sections (optional, multiple allocation sections)
    sh:property [ 
        sh:path era:allocationSections ;
        sh:node era:AllocationSectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A TrainProtectionArea may contain multiple validated allocationSections."@en ;
        sh:message "Eine TrainProtectionArea kann mehrere validierte allocationSections enthalten."@de ;
        sh:message "Une TrainProtectionArea peut contenir plusieurs allocationSections validés."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # ETCS Markers (optional, multiple markers)
    sh:property [ 
        sh:path era:etcsMarkers ;
        sh:node era:ETCSMarkerShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A TrainProtectionArea may contain multiple validated etcsMarkers."@en ;
        sh:message "Eine TrainProtectionArea kann mehrere validierte etcsMarkers enthalten."@de ;
        sh:message "Une TrainProtectionArea peut contenir plusieurs etcsMarkers validés."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Train Protection Shape =====
era:TrainProtectionShape a sh:NodeShape ;
    sh:targetClass era:TrainProtection ;
    sh:message "Top-level container for train protection system configuration."@en ;
    sh:message "Top-Level-Container für die Konfiguration des Zugsicherungssystems."@de ;
    sh:message "Conteneur de niveau supérieur pour la configuration du système de protection des trains."@fr ;
    
    # TP Area (optional, multiple protection areas)
    sh:property [ 
        sh:path era:tpArea ;
        sh:node era:TrainProtectionAreaShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A TrainProtection may contain multiple validated tpArea (train protection areas)."@en ;
        sh:message "Eine TrainProtection kann mehrere validierte tpArea (Zugsicherungsbereiche) enthalten."@de ;
        sh:message "Une TrainProtection peut contenir plusieurs tpArea (zones de protection des trains) validées."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== Net Linear Reference Shape =====
era:NetLinearReferenceShape a sh:NodeShape ;
    sh:targetClass era:NetLinearReference ;
    
    # Starts At (required, topological coordinate - can be inline or referenced)
    sh:property [ 
        sh:path era:startsAt ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetLinearReference must have exactly one startsAt that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jede NetLinearReference muss genau ein startsAt haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque NetLinearReference doit avoir exactement un startsAt conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Ends At (required, topological coordinate - can be inline or referenced)
    sh:property [ 
        sh:path era:endsAt ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetLinearReference must have exactly one endsAt that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jede NetLinearReference muss genau ein endsAt haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque NetLinearReference doit avoir exactement un endsAt conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Has Sequence (optional, RDF list of linear elements)
    sh:property [ 
        sh:path era:hasSequence ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A NetLinearReference may have at most one hasSequence property pointing to an RDF list."@en ;
        sh:message "Eine NetLinearReference darf höchstens eine hasSequence-Eigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Une NetLinearReference peut avoir au plus une propriété hasSequence pointant vers une liste RDF."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all list items are LinearElement instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the hasSequence list must be instances of era:LinearElement that conform to LinearElementShape."@en ;
        sh:message "Alle Elemente in der Liste hasSequence müssen Instanzen von era:LinearElement sein, die LinearElementShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste hasSequence doivent être des instances de era:LinearElement conformes à LinearElementShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:hasSequence ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                # Violation if item is not a LinearElement
                FILTER NOT EXISTS { ?item a era:LinearElement }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
	
	
	
# ===== Topological Coordinate Shape =====
era:TopologicalCoordinateShape a sh:NodeShape ;
    sh:targetClass era:TopologicalCoordinate ;
    
    # On Linear Element (required, can be inline or referenced)
    sh:property [ 
        sh:path era:onLinearElement ;
        sh:node era:LinearElementShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TopologicalCoordinate must have exactly one onLinearElement that conforms to LinearElement object."@en ;
        sh:message "Jede TopologicalCoordinate muss genau eine onLinearElement haben, die dem LinearElement-Objekt entspricht."@de ;
        sh:message "Chaque TopologicalCoordonnée doit avoir exactement un onLinearElement conforme à l'objet LinearElement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Offset From Origin (required, unsigned integer >= 0 - distance in meters from element origin)
    sh:property [ 
        sh:path era:offsetFromOrigin ;
        sh:datatype xsd:positiveInteger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TopologicalCoordinate must have exactly one offsetFromOrigin (non-negative unsigned integer, in meters)."@en ;
        sh:message "Jede TopologicalCoordinate muss genau eine offsetFromOrigin haben (nicht negative Ganzzahl ohne Vorzeichen, in Metern)."@de ;
        sh:message "Chaque TopologicalCoorder doit avoir exactement un offsetFromOrigin (entier non signé non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] .


# ===== Linear Element Shape =====
era:LinearElementShape a sh:NodeShape ;
    sh:targetClass era:LinearElement ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A LinearElement may have at most one name (string)."@en ;
        sh:message "Ein LinearElement darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un LinearElement peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Length of Net Linear Element (required, double > 0 - length in meters)
    sh:property [ 
        sh:path era:lengthOfNetLinearElement ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElement must have exactly one lengthOfNetLinearElement (non-negative double, in meters)."@en ;
        sh:message "Jedes LinearElement muss genau ein lengthOfNetLinearElement (nicht negatives Double, in Metern) haben."@de ;
        sh:message "Chaque LinearElement doit avoir exactement un lengthOfNetLinearElement (double non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint: lengthOfNetLinearElement must be greater than 0
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The lengthOfNetLinearElement must be greater than 0 meters."@en ;
        sh:message "Der lengthOfNetLinearElement muss größer als 0 Meter sein."@de ;
        sh:message "Le lengthOfNetLinearElement doit être supérieur à 0 mètre."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            
            SELECT $this
            WHERE {
                $this era:lengthOfNetLinearElement ?len .
                FILTER (?len <= 0)
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
		

# ===== Linear Element Section Shape =====
era:LinearElementSectionShape a sh:NodeShape ;
    sh:targetClass era:LinearElementSection ;
    
    # On Element (required, reference to the linear element - can be inline or referenced)
    sh:property [ 
        sh:path era:onElement ;
        sh:node era:LinearElementShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one onElement that conforms to LinearElement object."@en ;
        sh:message "Jeder LinearElementSection muss genau ein onElement haben, das dem LinearElement-Objekt entspricht."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement un onElement conforme à l'objet LinearElement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Start Offset From Origin (required, double >= 0 - distance in meters from element origin)
    sh:property [ 
        sh:path era:startOffsetFromOrigin ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one startOffsetFromOrigin (non-negative double, in meters)."@en ;
        sh:message "Jeder LinearElementSection muss genau ein startOffsetFromOrigin (nicht negatives Double, in Metern) haben."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement un startOffsetFromOrigin (double non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # End Offset From Origin (required, double >= 0 - distance in meters from element origin)
    sh:property [ 
        sh:path era:endOffsetFromOrigin ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one endOffsetFromOrigin (non-negative double, in meters)."@en ;
        sh:message "Jeder LinearElementSection muss genau ein endOffsetFromOrigin (nicht negatives Double, in Metern) haben."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement un endOffsetFromOrigin (double non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Applies In Both Directions (required, boolean)
    sh:property [ 
        sh:path era:appliesInBothDirections ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementSection must have exactly one appliesInBothDirections value (boolean)."@en ;
        sh:message "Jeder LinearElementSection muss genau einen appliesInBothDirections-Wert (boolean) haben."@de ;
        sh:message "Chaque LinearElementSection doit avoir exactement une valeur appliesInBothDirections (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint: startOffsetFromOrigin must be less than endOffsetFromOrigin
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The startOffsetFromOrigin must be less than endOffsetFromOrigin."@en ;
        sh:message "Der startOffsetFromOrigin muss kleiner als endOffsetFromOrigin sein."@de ;
        sh:message "Le startOffsetFromOrigin doit être inférieur à endOffsetFromOrigin."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            
            SELECT $this
            WHERE {
                $this era:startOffsetFromOrigin ?start ;
                      era:endOffsetFromOrigin ?end .
                FILTER (?start >= ?end)
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Switch Shape =====
era:SwitchShape a sh:NodeShape ;
    sh:targetClass era:Switch ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Switch may have at most one name (string)."@en ;
        sh:message "Ein Switch darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un Switch peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Left Branch (required, network relation - can be inline or referenced)
    sh:property [ 
        sh:path era:leftBranch ;
        sh:node era:NetRelationShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Switch must have exactly one leftBranch that conforms to NetRelation object."@en ;
        sh:message "Jeder Switch muss genau ein leftBranch haben, das dem NetRelation-Objekt entspricht."@de ;
        sh:message "Chaque commutateur doit avoir exactement un leftBranch conforme à l'objet NetRelation."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Right Branch (required, network relation - can be inline or referenced)
    sh:property [ 
        sh:path era:rightBranch ;
        sh:node era:NetRelationShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Switch must have exactly one rightBranch that conforms to NetRelation object."@en ;
        sh:message "Jeder Switch muss genau ein rightBranch haben, das dem NetRelation-Objekt entspricht."@de ;
        sh:message "Chaque commutateur doit avoir exactement un rightBranch conforme à l'objet NetRelation."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Reversal Time (required, unsigned integer - time in seconds to change switch position)
    sh:property [ 
        sh:path era:reversalTime ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Switch must have exactly one reversalTime (unsigned integer, in seconds)."@en ;
        sh:message "Jeder Switch muss genau eine reversalTime (vorzeichenlose Ganzzahl in Sekunden) haben."@de ;
        sh:message "Chaque Switch doit avoir exactement un reversalTime (entier non signé, en secondes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint: Warning if reversalTime is 0
	# FILTER (?time = 0)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The reversalTime is 0 seconds. While this is valid, typical values for modern switches range from 3 to 10 seconds. Please verify this value is correct."@en ;
        sh:message "Der reversalTime beträgt 0 Sekunden. Dies ist zwar gültig, typische Werte für moderne Schalter liegen jedoch zwischen 3 und 10 Sekunden. Bitte überprüfen Sie, ob dieser Wert korrekt ist."@de ;
        sh:message "Le reversalTime est de 0 seconde. Bien que cela soit valable, les valeurs typiques des commutateurs modernes vont de 3 à 10 secondes. Veuillez vérifier que cette valeur est correcte."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
			PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> 
            
            SELECT $this
            WHERE {
                $this era:reversalTime ?time .
				FILTER(?time = 0)
                
            }
        """ ;
        sh:severity sh:Warning ;
    ] ;
    
    # SPARQL constraint: Warning if reversalTime is unusually high
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The reversalTime is greater than 30 seconds, which is unusually high for a railway switch. Typical values for modern switches range from 3 to 10 seconds. Please verify this value is correct."@en ;
        sh:message "Die reversalTime beträgt mehr als 30 Sekunden, was für eine Eisenbahnweiche ungewöhnlich hoch ist. Typische Werte für moderne Schalter liegen zwischen 3 und 10 Sekunden. Bitte überprüfen Sie, ob dieser Wert korrekt ist."@de ;
        sh:message "Le reversalTime est supérieur à 30 secondes, ce qui est inhabituellement élevé pour un aiguillage ferroviaire. Les valeurs typiques pour les commutateurs modernes vont de 3 à 10 secondes. Veuillez vérifier que cette valeur est correcte."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
			PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            
            SELECT $this
            WHERE {
                $this era:reversalTime ?time .
                FILTER (?time > 30)
            }
        """ ;
        sh:severity sh:Warning ;
    ] .
	

# ===== Net Relation Shape =====
era:NetRelationShape a sh:NodeShape ;
    sh:targetClass era:NetRelation ;
    
    # Element A (required, reference to a linear element)
    sh:property [ 
        sh:path era:elementA ;
        sh:class era:LinearElement ;
		sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetRelation must have exactly one elementA that conforms to LinearElement object."@en ;
        sh:message "Jede NetRelation muss genau ein elementA haben, das dem LinearElement-Objekt entspricht."@de ;
        sh:message "Chaque NetRelation doit avoir exactement un elementA conforme à l'objet LinearElement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Is On Origin Of Element A (required, boolean - whether relation point is at origin of element A)
    sh:property [ 
        sh:path era:isOnOriginOfElementA ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetRelation must have exactly one isOnOriginOfElementA value (boolean)."@en ;
        sh:message "Jede NetRelation muss genau einen isOnOriginOfElementA-Wert (boolean) haben."@de ;
        sh:message "Chaque NetRelation doit avoir exactement une valeur isOnOriginOfElementA (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Element B (required, reference to a linear element)
    sh:property [ 
        sh:path era:elementB ;
        sh:class era:LinearElement ;
		sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetRelation must have exactly one elementB that conforms to LinearElement object."@en ;
        sh:message "Jede NetRelation muss genau ein elementB haben, das dem LinearElement-Objekt entspricht."@de ;
        sh:message "Chaque NetRelation doit avoir exactement un elementB conforme à l'objet LinearElement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Is On Origin Of Element B (required, boolean - whether relation point is at origin of element B)
    sh:property [ 
        sh:path era:isOnOriginOfElementB ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetRelation must have exactly one isOnOriginOfElementB value (boolean)."@en ;
        sh:message "Jede NetRelation muss genau einen isOnOriginOfElementB-Wert (boolean) haben."@de ;
        sh:message "Chaque NetRelation doit avoir exactement une valeur isOnOriginOfElementB (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Crossing Shape =====
era:CrossingShape a sh:NodeShape ;
    sh:targetClass era:Crossing ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Crossing may have at most one name (string)."@en ;
        sh:message "Eine Kreuzung darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un croisement peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Is Switchable (required, boolean)
    sh:property [ 
        sh:path era:isSwitchable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Crossing must have exactly one isSwitchable value (boolean)."@en ;
        sh:message "Jede Kreuzung muss genau einen isSwitchable-Wert (boolean) haben."@de ;
        sh:message "Chaque croisement doit avoir exactement une valeur isSwitchable (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Topological Coordinates (required, exactly 2)
    sh:property [ 
        sh:path era:topologicalCoordinates ;
        sh:node era:TopologicalCoordinateShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:message "Each Crossing must have exactly 2 topologicalCoordinates that conform to TopologicalCoordinate object."@en ;
        sh:message "Jede Kreuzung muss genau 2 topologicalCoordinates haben, die dem TopologicalCoordinate-Objekt entsprechen."@de ;
        sh:message "Chaque croisement doit avoir exactement 2 topologicalCoordinates conformes à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== Slip Crossing Shape =====
era:SlipCrossingShape a sh:NodeShape ;
    sh:targetClass era:SlipCrossing ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A SlipCrossing may have at most one name (string)."@en ;
        sh:message "Ein SlipCrossing darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un SlipCrossing peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Crossing (required, can be inline or referenced)
    sh:property [ 
        sh:path era:crossing ;
        sh:node era:CrossingShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each SlipCrossing must have exactly one crossing that conforms to Crossing object."@en ;
        sh:message "Jeder SlipCrossing muss genau eine Kreuzung haben, die dem Crossing-Objekt entspricht."@de ;
        sh:message "Chaque SlipCrossing doit avoir exactement un croisement conforme à l’objet Crossing."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Switches (required, 2-4 switches)
    sh:property [ 
        sh:path era:switches ;
        sh:class era:Switch ;
		sh:nodeKind sh:IRI ;
        sh:minCount 2 ;
        sh:maxCount 4 ;
        sh:message "Each SlipCrossing must have between 2 and 4 switches that conform to Switch object."@en ;
        sh:message "Jeder SlipCrossing muss zwischen 2 und 4 Schalter haben, die dem Switch-Objekt entsprechen."@de ;
        sh:message "Chaque SlipCrossing doit avoir entre 2 et 4 commutateurs conformes à l'objet Switch."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	

# ===== Level Crossing Shape =====
era:LevelCrossingShape a sh:NodeShape ;
    sh:targetClass era:LevelCrossing ;
    sh:message "Road-rail intersection requiring protection and potentially drive protection sections for flank safety."@en ;
    sh:message "Schutzbedürftige Straße-Schiene-Kreuzung und möglicherweise Fahrschutzabschnitte zur Flankensicherheit."@de ;
    sh:message "Intersection rail-route nécessitant une protection et potentiellement des sections de protection de conduite pour la sécurité des flancs."@fr ;
    
    # Area Reference (required, geographic location)
    sh:property [ 
        sh:path era:areaReference ;
        sh:node era:NetAreaReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LevelCrossing must reference exactly one areaReference that conforms to NetAreaReference object (geographic extent of the crossing)."@en ;
        sh:message "Jeder LevelCrossing muss genau einen areaReference referenzieren, der dem NetAreaReference-Objekt (geografische Ausdehnung des Übergangs) entspricht."@de ;
        sh:message "Chaque LevelCrossing doit référencer exactement un areaReference conforme à l'objet NetAreaReference (étendue géographique du passage)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Name (optional, string - crossing identifier)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A LevelCrossing may have at most one name (string, crossing identifier or location description)."@en ;
        sh:message "Ein LevelCrossing darf höchstens einen Namen haben (Zeichenfolge, Kreuzungskennung oder Ortsbeschreibung)."@de ;
        sh:message "Un LevelCrossing peut avoir au plus un nom (chaîne, identifiant de passage ou description de localisation)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	

# ===== Net Area Reference Shape =====
era:NetAreaReferenceShape a sh:NodeShape ;
    sh:targetClass era:NetAreaReference ;
    
    # Includes (required, RDF list of net linear references)
    sh:property [ 
        sh:path era:includes ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetAreaReference must have exactly one includes property pointing to an RDF list."@en ;
        sh:message "Jede NetAreaReference muss genau eine Includes-Eigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Chaque NetAreaReference doit avoir exactement une propriété include pointant vers une liste RDF."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate list has at least 1 item
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "The includes list must contain at least 1 item."@en ;
        sh:message "Die Includes-Liste muss mindestens 1 Element enthalten."@de ;
        sh:message "La liste des inclusions doit contenir au moins 1 élément."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:includes ?list .
                
                # Count items in the list
                {
                    SELECT $this (COUNT(?item) AS ?count)
                    WHERE {
                        $this era:includes ?list .
                        ?list rdf:rest*/rdf:first ?item .
                    }
                    GROUP BY $this
                }
                
                # Violation if count is less than 1
                FILTER (?count < 1)
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    # SPARQL constraint to validate all list items are NetLinearReference instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the includes list must be instances of era:NetLinearReference that conform to NetLinearReferenceShape."@en ;
        sh:message "Alle Elemente in der Includes-Liste müssen Instanzen von era:NetLinearReference sein, die NetLinearReferenceShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste d'inclusion doivent être des instances de era:NetLinearReference conformes à NetLinearReferenceShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:includes ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                # Violation if item is not a NetLinearReference
                FILTER NOT EXISTS { ?item a era:NetLinearReference }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
	
	

# ===== ETCS Marker Shape =====
era:ETCSMarkerShape a sh:NodeShape ;
    sh:targetClass era:ETCSMarker ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "An ETCSMarker may have at most one name (string)."@en ;
        sh:message "Ein ETCSMarker darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un ETCSMarker peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Net Point Reference (required, can be inline or referenced)
    sh:property [ 
        sh:path era:netPointReference ;
        sh:node era:NetPointReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSMarker must have exactly one netPointReference that conforms to NetPointReference object."@en ;
        sh:message "Jeder ETCSMarker muss genau ein netPointReference haben, das dem NetPointReference-Objekt entspricht."@de ;
        sh:message "Chaque ETCSMarker doit avoir exactement un netPointReference conforme à l'objet NetPointReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Marker Function Stop (required, boolean - indicates if marker is a stop marker)
    sh:property [ 
        sh:path era:markerFunctionStop ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSMarker must have exactly one markerFunctionStop value (boolean)."@en ;
        sh:message "Jeder ETCSMarker muss genau einen markerFunctionStop-Wert (boolean) haben."@de ;
        sh:message "Chaque ETCSMarker doit avoir exactement une valeur markerFunctionStop (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== Derailer Shape =====
era:DerailerShape a sh:NodeShape ;
    sh:targetClass era:Derailer ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Derailer may have at most one name (string)."@en ;
        sh:message "Ein Derailer darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un dérailleur peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Net Point Reference (required, can be inline or referenced)
    sh:property [ 
        sh:path era:netPointReference ;
        sh:node era:NetPointReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Derailer must have exactly one netPointReference that conforms to NetPointReference object."@en ;
        sh:message "Jeder Derailer muss genau ein netPointReference haben, das dem NetPointReference-Objekt entspricht."@de ;
        sh:message "Chaque dérailleur doit avoir exactement un netPointReference conforme à l'objet NetPointReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Derail to Right (required, boolean - direction of derailment)
    sh:property [ 
        sh:path era:derailToRight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Derailer must have exactly one derailToRight value (boolean)."@en ;
        sh:message "Jeder Derailer muss genau einen derailToRight-Wert (boolean) haben."@de ;
        sh:message "Chaque dérailleur doit avoir exactement une valeur derailToRight (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Reversal Time (required, unsigned integer - typically in seconds)
    sh:property [ 
        sh:path era:reversalTime ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Derailer must have exactly one reversalTime value (unsigned integer)."@en ;
        sh:message "Jeder Derailer muss genau einen reversalTime-Wert (vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque dérailleur doit avoir exactement une valeur reversalTime (entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Net Point Reference Shape =====
era:NetPointReferenceShape a sh:NodeShape ;
    sh:targetClass era:NetPointReference ;
    
    # Has Topological Coordinate (required, can be inline or referenced)
    sh:property [ 
        sh:path era:hasTopoCoordinate ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetPointReference must have exactly one hasTopoCoordinate that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jede NetPointReference muss genau ein hasTopoCoordinate haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque NetPointReference doit avoir exactement un hasTopoCoordinate conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Applies To Direction (required, controlled vocabulary)
    sh:property [ 
        sh:path era:appliesToDirection ;
        sh:in (
            <http://data.europa.eu/949/concepts/orientations/both>
            <http://data.europa.eu/949/concepts/orientations/same>
            <http://data.europa.eu/949/concepts/orientations/opposite>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property appliesToDirection must have a value from the defined SKOS concept scheme (both, same, or opposite)."@en ;
        sh:message "Die Eigenschaft appliesToDirection muss einen Wert aus dem definierten SKOS-Konzeptschema haben (beide, gleich oder entgegengesetzt)."@de ;
        sh:message "La propriété appliesToDirection doit avoir une valeur du schéma conceptuel SKOS défini (les deux, identique ou opposé)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	

# Shape to check that at least one Train Protection class exists
era:AtLeastOneTrainProtectionClassShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            SELECT ?this
            WHERE {
                BIND (era:ValidationRoot as ?this)
            }
        """ ;
    ] ;
    
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The data must contain at least one instance of the required Train Protection classes (e.g., DriveProtectionSectionGroup, AllocationSection, FieldObjectController, AreaOfControl, etc.). This error may indicate that the provided data significantly deviates from the expected train protection and interlocking control model as defined in the extended ERA ontology."@en ;
        sh:message "Die Daten müssen mindestens eine Instanz der erforderlichen Zugsicherungsklassen enthalten (z. B. DriveProtectionSectionGroup, AllocationSection, FieldObjectController, AreaOfControl usw.). Dieser Fehler kann darauf hinweisen, dass die bereitgestellten Daten erheblich vom erwarteten Zugsicherungs- und Stellwerkssteuerungsmodell abweichen, wie es in der erweiterten ERA-Ontologie definiert ist."@de ;
        sh:message "Les données doivent contenir au moins une instance des classes Train Protection requises (par exemple, DriveProtectionSectionGroup, AllocationSection, FieldObjectController, AreaOfControl, etc.). Cette erreur peut indiquer que les données fournies s'écartent considérablement du modèle attendu de protection des trains et de contrôle de verrouillage, tel que défini dans l'ontologie ERA étendue."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    # Top-Level Container
                    { ?instance rdf:type era:TrainProtection . }
                    
                    # Area Container
                    UNION { ?instance rdf:type era:TrainProtectionArea . }
                    
                    # Drive Protection Section Classes
                    UNION { ?instance rdf:type era:DriveProtectionSectionGroup . }
                    UNION { ?instance rdf:type era:DriveProtectionSection . }
                    
                    # Allocation Classes
                    UNION { ?instance rdf:type era:AllocationSection . }
                    
                    # Control Classes
                    UNION { ?instance rdf:type era:FieldObjectController . }
                    UNION { ?instance rdf:type era:AreaOfControl . }
                    UNION { ?instance rdf:type era:Controller . }
                    
                    # Infrastructure Element References
                    UNION { ?instance rdf:type era:ProtectedInfraElement . }
                    UNION { ?instance rdf:type era:ControlledInfraElement . }
                    
                    # ETCS Marker
                    UNION { ?instance rdf:type era:ETCSMarker . }
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .