@prefix era: <http://data.europa.eu/949/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== Functional Element Projection Shape =====
era:FunctionalElementProjectionShape a sh:NodeShape ;
    sh:targetClass era:FunctionalElementProjection ;
    sh:message "Projects a functional railway element (balise, switch, operationalPoint, etc.) onto a geographic coordinate system with position and accuracy."@en ;
    sh:message "Projiziert ein funktionsfähiges Eisenbahnelement (Balise, Weiche, operationalPoint usw.) mit Position und Genauigkeit auf ein geografisches Koordinatensystem."@de ;
    sh:message "Projette un élément ferroviaire fonctionnel (balise, aiguillage, operationalPoint, etc.) sur un système de coordonnées géographiques avec position et précision."@fr ;
    
    # Element Reference (required, reference to functional element)
    sh:property [ 
        sh:path era:elementRef ;
        sh:node era:FunctionalElementRefShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each FunctionalElementProjection must reference exactly one elementRef that conforms to FunctionalElementRef object."@en ;
        sh:message "Jede FunctionalElementProjection muss auf genau ein elementRef verweisen, das dem FunctionalElementRef-Objekt entspricht."@de ;
        sh:message "Chaque FunctionalElementProjection doit faire référence à exactement un elementRef conforme à l'objet FunctionalElementRef."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # X Coordinate (required, double - easting/longitude)
    sh:property [ 
        sh:path era:x ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each FunctionalElementProjection must have exactly one x coordinate (double, easting or longitude value)."@en ;
        sh:message "Jede FunctionalElementProjection muss genau eine x-Koordinate (doppelter, Ost- oder Längengradwert) haben."@de ;
        sh:message "Chaque FunctionalElementProjection doit avoir exactement une coordonnée x (valeur double, est ou longitude)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Y Coordinate (required, double - northing/latitude)
    sh:property [ 
        sh:path era:y ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each FunctionalElementProjection must have exactly one y coordinate (double, northing or latitude value)."@en ;
        sh:message "Jede FunctionalElementProjection muss genau eine y-Koordinate (doppelter Wert, Nordwert oder Breitengradwert) haben."@de ;
        sh:message "Chaque FunctionalElementProjection doit avoir exactement une coordonnée y (valeur double, nord ou latitude)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Z Coordinate (required, double - elevation/altitude)
    sh:property [ 
        sh:path era:z ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each FunctionalElementProjection must have exactly one z coordinate (double, elevation or altitude in meters)."@en ;
        sh:message "Jede FunctionalElementProjection muss genau eine Z-Koordinate haben (doppelt, Höhe oder Höhe in Metern)."@de ;
        sh:message "Chaque FunctionalElementProjection doit avoir exactement une coordonnée z (double, élévation ou altitude en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Accuracy X (required, double - horizontal accuracy in meters)
    sh:property [ 
        sh:path era:accX ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each FunctionalElementProjection must have exactly one accX (double, position accuracy in x-direction in meters)."@en ;
        sh:message "Jede FunctionalElementProjection muss genau eine accX haben (doppelt, Positionsgenauigkeit in x-Richtung in Metern)."@de ;
        sh:message "Chaque FunctionalElementProjection doit avoir exactement un accX (double, précision de position dans la direction x en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Accuracy Y (required, double - horizontal accuracy in meters)
    sh:property [ 
        sh:path era:accY ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each FunctionalElementProjection must have exactly one accY (double, position accuracy in y-direction in meters)."@en ;
        sh:message "Jede FunctionalElementProjection muss genau eine accY haben (doppelt, Positionsgenauigkeit in y-Richtung in Metern)."@de ;
        sh:message "Chaque FunctionalElementProjection doit avoir exactement un accY (double, précision de position dans la direction y en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Accuracy Z (required, double - vertical accuracy in meters)
    sh:property [ 
        sh:path era:accZ ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each FunctionalElementProjection must have exactly one accZ (double, position accuracy in z-direction in meters)."@en ;
        sh:message "Jede FunctionalElementProjection muss genau eine accZ haben (doppelt, Positionsgenauigkeit in Z-Richtung in Metern)."@de ;
        sh:message "Chaque FunctionalElementProjection doit avoir exactement un accZ (double, précision de position dans la direction z en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Functional Element Reference Shape =====
era:FunctionalElementRefShape a sh:NodeShape ;
    sh:targetClass era:FunctionalElementRef ;
    sh:message "Reference to a functional railway element - must be exactly one element type (balise, switch, signal, stop, etc.)."@en ;
    sh:message "Verweis auf ein funktionsfähiges Eisenbahnelement – ​​muss genau ein Elementtyp sein (Balise, Weiche, Signal, Haltestelle usw.)."@de ;
    sh:message "Référence à un élément ferroviaire fonctionnel - doit être exactement un type d'élément (balise, aiguillage, signal, arrêt, etc.)."@fr ;
    
    # Each Functional Element Reference must have exactly ONE of these element types
    sh:xone (
        [ sh:path era:balise ;
          sh:class era:Balise ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Functional element reference is a balise."@en ;
          sh:message "Funktionselementreferenz ist eine Balise."@de ;
          sh:message "La référence de l'élément fonctionnel est une balise."@fr ]
        
        [ sh:path era:switch ;
          sh:class era:Switch ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Functional element reference is a switch (points)."@en ;
          sh:message "Funktionselementreferenz ist ein Schalter (Punkte)."@de ;
          sh:message "La référence de l'élément fonctionnel est un interrupteur (points)."@fr ]
        
        [ sh:path era:operationalPoint ;
          sh:class era:OperationalPoint ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Functional element reference is an operational point (station, junction, etc.)."@en ;
          sh:message "Funktionselementreferenz ist ein Betriebspunkt (Station, Knotenpunkt usw.)."@de ;
          sh:message "La référence d'un élément fonctionnel est un point opérationnel (gare, carrefour, etc.)."@fr ]
        
        [ sh:path era:timingPoint ;
          sh:class era:TimingPoint ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Functional element reference is a timing point."@en ;
          sh:message "Die Referenz auf ein Funktionselement ist ein Zeitpunkt."@de ;
          sh:message "La référence d’élément fonctionnel est un point de timing."@fr ]
        
        [ sh:path era:stopLocation ;
          sh:class era:StopLocation ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Functional element reference is a stop location."@en ;
          sh:message "Die Funktionselementreferenz ist ein Stopport."@de ;
          sh:message "La référence de l'élément fonctionnel est un emplacement d'arrêt."@fr ]
        
        [ sh:path era:etcsMarker ;
          sh:class era:ETCSMarker ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Functional element reference is an ETCS marker board."@en ;
          sh:message "Funktionselementreferenz ist eine ETCS-Markierungstafel."@de ;
          sh:message "La référence de l'élément fonctionnel est un tableau de marquage ETCS."@fr ]
        
        [ sh:path era:derailer ;
          sh:class era:Derailer ;
          sh:nodeKind sh:IRI ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:message "Functional element reference is a derailer (safety device)."@en ;
          sh:message "Funktionselement Referenz ist ein Entgleiser (Sicherheitseinrichtung)."@de ;
          sh:message "La référence de l'élément fonctionnel est un dérailleur (dispositif de sécurité)."@fr ]
    ) .

# ===== Linear Element Coordinate Shape =====
era:LinearElementCoordinateShape a sh:NodeShape ;
    sh:targetClass era:LinearElementCoordinate ;
    sh:message "Geographic coordinate point along a linear track element with position offset and accuracy measurements."@en ;
    sh:message "Geografischer Koordinatenpunkt entlang eines linearen Gleiselements mit Positionsversatz und Genauigkeitsmessungen."@de ;
    sh:message "Point de coordonnées géographiques le long d'un élément de piste linéaire avec mesures de décalage de position et de précision."@fr ;
    
    # Position (required, unsigned integer - offset along track in meters)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementCoordinate must have exactly one pos (unsigned integer, position offset along linear element in meters)."@en ;
        sh:message "Jede LinearElementCoordinate muss genau eine Pos (vorzeichenlose Ganzzahl, Positionsversatz entlang des linearen Elements in Metern) haben."@de ;
        sh:message "Chaque LinearElementCoordonnée doit avoir exactement une pos (entier non signé, décalage de position le long de l'élément linéaire en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # X Coordinate (required, double - easting/longitude)
    sh:property [ 
        sh:path era:x ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementCoordinate must have exactly one x coordinate (double, easting or longitude value)."@en ;
        sh:message "Jede LinearElementCoordinate muss genau eine x-Koordinate haben (Doppel-, Rechts- oder Längengradwert)."@de ;
        sh:message "Chaque LinearElementCoordonnée doit avoir exactement une coordonnée x (valeur double, est ou longitude)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Y Coordinate (required, double - northing/latitude)
    sh:property [ 
        sh:path era:y ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementCoordinate must have exactly one y coordinate (double, northing or latitude value)."@en ;
        sh:message "Jede LinearElementCoordinate muss genau eine y-Koordinate (doppelter Wert, Nordwert oder Breitengradwert) haben."@de ;
        sh:message "Chaque LinearElementCoordonnée doit avoir exactement une coordonnée y (valeur double, nord ou latitude)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Z Coordinate (required, double - elevation/altitude)
    sh:property [ 
        sh:path era:z ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementCoordinate must have exactly one z coordinate (double, elevation or altitude in meters)."@en ;
        sh:message "Jede LinearElementCoordinate muss genau eine Z-Koordinate haben (doppelt, Höhe oder Höhe in Metern)."@de ;
        sh:message "Chaque LinearElementCoordonnée doit avoir exactement une coordonnée z (double, élévation ou altitude en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Accuracy Position (required, unsigned integer - position accuracy in meters)
    sh:property [ 
        sh:path era:accPos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementCoordinate must have exactly one accPos (unsigned integer, position measurement accuracy in meters)."@en ;
        sh:message "Jede LinearElementCoordinate muss genau eine accPos (vorzeichenlose Ganzzahl, Positionsmessgenauigkeit in Metern) haben."@de ;
        sh:message "Chaque LinearElementCoordonnée doit avoir exactement un accPos (entier non signé, précision de la mesure de position en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Accuracy X (required, double - horizontal accuracy in meters)
    sh:property [ 
        sh:path era:accX ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementCoordinate must have exactly one accX (double, coordinate accuracy in x-direction in meters)."@en ;
        sh:message "Jede LinearElementCoordinate muss genau eine accX haben (doppelt, Koordinatengenauigkeit in x-Richtung in Metern)."@de ;
        sh:message "Chaque LinearElementCoordonnée doit avoir exactement un accX (double, précision des coordonnées dans la direction x en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Accuracy Y (required, double - horizontal accuracy in meters)
    sh:property [ 
        sh:path era:accY ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementCoordinate must have exactly one accY (double, coordinate accuracy in y-direction in meters)."@en ;
        sh:message "Jede LinearElementCoordinate muss genau eine accY haben (doppelt, Koordinatengenauigkeit in y-Richtung in Metern)."@de ;
        sh:message "Chaque LinearElementCoordonnée doit avoir exactement un accY (double, précision des coordonnées dans la direction y en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Accuracy Z (required, double - vertical accuracy in meters)
    sh:property [ 
        sh:path era:accZ ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementCoordinate must have exactly one accZ (double, coordinate accuracy in z-direction in meters)."@en ;
        sh:message "Jede LinearElementCoordinate muss genau eine accZ haben (doppelt, Koordinatengenauigkeit in Z-Richtung in Metern)."@de ;
        sh:message "Chaque LinearElementCoordonnée doit avoir exactement un accZ (double, précision des coordonnées dans la direction z en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Linear Element Projection Shape =====
era:LinearElementProjectionShape a sh:NodeShape ;
    sh:targetClass era:LinearElementProjection ;
    sh:message "Projects a linear track element onto a geographic coordinate system with at least 2 coordinate points defining the alignment."@en ;
    sh:message "Projiziert ein lineares Gleiselement auf ein geografisches Koordinatensystem mit mindestens zwei Koordinatenpunkten, die die Ausrichtung definieren."@de ;
    sh:message "Projette un élément de piste linéaire sur un système de coordonnées géographiques avec au moins 2 points de coordonnées définissant l'alignement."@fr ;
    
    # Coordinates (required, RDF list - at least 2 coordinate points)
    sh:property [ 
        sh:path era:coordinates ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElementProjection must have exactly one coordinates property pointing to an RDF list with at least 2 coordinate points."@en ;
        sh:message "Jede LinearElementProjection muss genau eine Koordinateneigenschaft haben, die auf eine RDF-Liste mit mindestens 2 Koordinatenpunkten verweist."@de ;
        sh:message "Chaque LinearElementProjection doit avoir exactement une propriété de coordonnées pointant vers une liste RDF avec au moins 2 points de coordonnées."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate list has at least 2 items
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "The coordinates list must contain at least 2 LinearElementCoordinate items (minimum to define a line segment)."@en ;
        sh:message "Die Koordinatenliste muss mindestens 2 LinearElementCoordinate-Elemente enthalten (mindestens zur Definition eines Liniensegments)."@de ;
        sh:message "La liste de coordonnées doit contenir au moins 2 éléments LinearElementCoordonnée (minimum pour définir un segment de ligne)."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:coordinates ?list .
                {
                    SELECT $this (COUNT(?item) AS ?count)
                    WHERE {
                        $this era:coordinates ?list .
                        ?list rdf:rest*/rdf:first ?item .
                    }
                    GROUP BY $this
                    HAVING (?count < 2)
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all coordinates are LinearElementCoordinate instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the coordinates list must be instances of era:LinearElementCoordinate that conform to LinearElementCoordinateShape."@en ;
        sh:message "Alle Elemente in der Koordinatenliste müssen Instanzen von era:LinearElementCoordinate sein, die LinearElementCoordinateShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste de coordonnées doivent être des instances de era:LinearElementCoordinate conformes à LinearElementCoordonnéeShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:coordinates ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                FILTER NOT EXISTS { ?item a era:LinearElementCoordinate }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .

# ===== Map Shape =====
era:MapShape a sh:NodeShape ;
    sh:targetClass era:Map ;
    sh:message "Geographic map projection containing track alignments and functional elements in a specific coordinate reference system."@en ;
    sh:message "Geografische Kartenprojektion mit Gleisverlauf und Funktionselementen in einem bestimmten Koordinatenbezugssystem."@de ;
    sh:message "Projection de carte géographique contenant les tracés de voies et les éléments fonctionnels dans un système de référence de coordonnées spécifique."@fr ;
    
    # Area ID (required, string - geographic area identifier)
    sh:property [ 
        sh:path era:areaId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Map must have exactly one areaId (string, geographic area or region identifier)."@en ;
        sh:message "Jede Karte muss genau eine areaId (Zeichenfolge, geografische Gebiets- oder Regionskennung) haben."@de ;
        sh:message "Chaque carte doit avoir exactement un areaId (chaîne, zone géographique ou identifiant de région)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # EPSG Code (required, unsigned integer - coordinate reference system)
    sh:property [ 
        sh:path era:epsg ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Map must have exactly one epsg code (unsigned integer, EPSG coordinate reference system identifier)."@en ;
        sh:message "Jede Karte muss genau einen EPSG-Code (vorzeichenlose Ganzzahl, Kennung des EPSG-Koordinatenreferenzsystems) haben."@de ;
        sh:message "Chaque carte doit avoir exactement un code epsg (entier non signé, identifiant du système de référence de coordonnées EPSG)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Version Timestamp (required, dateTime - map data version)
    sh:property [ 
        sh:path era:versionTimestamp ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Map must have exactly one versionTimestamp (xsd:dateTime, when this map version was created)."@en ;
        sh:message "Jede Karte muss genau eine versionTimestamp haben (xsd:dateTime, als diese Kartenversion erstellt wurde)."@de ;
        sh:message "Chaque carte doit avoir exactement un versionTimestamp (xsd:dateTime, lors de la création de cette version de la carte)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Name (optional, string - map name)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Map may have at most one name (string, descriptive name for the map)."@en ;
        sh:message "Eine Karte darf höchstens einen Namen haben (Zeichenfolge, beschreibender Name für die Karte)."@de ;
        sh:message "Une Map peut avoir au plus un nom (chaîne, nom descriptif de la map)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Linear Element Projections (optional, multiple track projections)
    sh:property [ 
        sh:path era:linearElementProjections ;
        sh:node era:LinearElementProjectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A Map may contain multiple linearElementProjections (track alignments)."@en ;
        sh:message "Eine Karte kann mehrere linearElementProjections (Spurausrichtungen) enthalten."@de ;
        sh:message "Une carte peut contenir plusieurs linearElementProjections (alignements de pistes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Functional Elements (optional, multiple element projections)
    sh:property [ 
        sh:path era:functionalElements ;
        sh:node era:FunctionalElementProjectionShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A Map may contain multiple functionalElements (balises, switches, signals, stops, etc.)."@en ;
        sh:message "Eine Karte kann mehrere functionalElements enthalten (Balisen, Weichen, Signale, Haltestellen usw.)."@de ;
        sh:message "Une carte peut contenir plusieurs functionalElements (balises, aiguillages, signaux, arrêts, etc.)."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Map Set Shape =====
era:MapSetShape a sh:NodeShape ;
    sh:targetClass era:MapSet ;
    sh:message "Collection of geographic maps covering different areas or coordinate systems for the railway network."@en ;
    sh:message "Sammlung geografischer Karten, die verschiedene Gebiete oder Koordinatensysteme für das Eisenbahnnetz abdecken."@de ;
    sh:message "Collection de cartes géographiques couvrant différentes zones ou systèmes de coordonnées du réseau ferroviaire."@fr ;
    
    # Maps (optional, multiple maps)
    sh:property [ 
        sh:path era:maps ;
        sh:node era:MapShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "A MapSet may contain multiple maps that conform to MapShape."@en ;
        sh:message "Ein MapSet kann mehrere Karten enthalten, die MapShape entsprechen."@de ;
        sh:message "Un MapSet peut contenir plusieurs cartes conformes à MapShape."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
	
# ===== Balise Shape =====
era:BaliseShape a sh:NodeShape ;
    sh:targetClass era:Balise ;
    
    # Topological Coordinate (required, can be inline or referenced)
    sh:property [ 
        sh:path era:topologicalCoordinate ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Balise must have exactly one topologicalCoordinate that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jede Balise muss genau ein topologicalCoordinate haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque Balise doit avoir exactement un topologicalCoordinate conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Topological Coordinate Shape =====
era:TopologicalCoordinateShape a sh:NodeShape ;
    sh:targetClass era:TopologicalCoordinate ;
    
    # On Linear Element (required, can be inline or referenced)
    sh:property [ 
        sh:path era:onLinearElement ;
        sh:node era:LinearElementShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TopologicalCoordinate must have exactly one onLinearElement that conforms to LinearElement object."@en ;
        sh:message "Jede TopologicalCoordinate muss genau eine onLinearElement haben, die dem LinearElement-Objekt entspricht."@de ;
        sh:message "Chaque TopologicalCoordonnée doit avoir exactement un onLinearElement conforme à l'objet LinearElement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Offset From Origin (required, unsigned integer >= 0 - distance in meters from element origin)
    sh:property [ 
        sh:path era:offsetFromOrigin ;
        sh:datatype xsd:positiveInteger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TopologicalCoordinate must have exactly one offsetFromOrigin (non-negative unsigned integer, in meters)."@en ;
        sh:message "Jede TopologicalCoordinate muss genau eine offsetFromOrigin haben (nicht negative Ganzzahl ohne Vorzeichen, in Metern)."@de ;
        sh:message "Chaque TopologicalCoorder doit avoir exactement un offsetFromOrigin (entier non signé non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] .
	


# ===== Linear Element Shape =====
era:LinearElementShape a sh:NodeShape ;
    sh:targetClass era:LinearElement ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A LinearElement may have at most one name (string)."@en ;
        sh:message "Ein LinearElement darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un LinearElement peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Length of Net Linear Element (required, double > 0 - length in meters)
    sh:property [ 
        sh:path era:lengthOfNetLinearElement ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each LinearElement must have exactly one lengthOfNetLinearElement (non-negative double, in meters)."@en ;
        sh:message "Jedes LinearElement muss genau ein lengthOfNetLinearElement (nicht negatives Double, in Metern) haben."@de ;
        sh:message "Chaque LinearElement doit avoir exactement un lengthOfNetLinearElement (double non négatif, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint: lengthOfNetLinearElement must be greater than 0
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The lengthOfNetLinearElement must be greater than 0 meters."@en ;
        sh:message "Der lengthOfNetLinearElement muss größer als 0 Meter sein."@de ;
        sh:message "Le lengthOfNetLinearElement doit être supérieur à 0 mètre."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            
            SELECT $this
            WHERE {
                $this era:lengthOfNetLinearElement ?len .
                FILTER (?len <= 0)
            }
        """ ;
        sh:severity sh:Violation ;
    ] .


# ===== Switch Shape =====
era:SwitchShape a sh:NodeShape ;
    sh:targetClass era:Switch ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Switch may have at most one name (string)."@en ;
        sh:message "Ein Switch darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un Switch peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Left Branch (required, network relation - can be inline or referenced)
    sh:property [ 
        sh:path era:leftBranch ;
        sh:node era:NetRelationShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Switch must have exactly one leftBranch that conforms to NetRelation object."@en ;
        sh:message "Jeder Switch muss genau ein leftBranch haben, das dem NetRelation-Objekt entspricht."@de ;
        sh:message "Chaque commutateur doit avoir exactement un leftBranch conforme à l'objet NetRelation."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Right Branch (required, network relation - can be inline or referenced)
    sh:property [ 
        sh:path era:rightBranch ;
        sh:node era:NetRelationShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Switch must have exactly one rightBranch that conforms to NetRelation object."@en ;
        sh:message "Jeder Switch muss genau ein rightBranch haben, das dem NetRelation-Objekt entspricht."@de ;
        sh:message "Chaque commutateur doit avoir exactement un rightBranch conforme à l'objet NetRelation."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Reversal Time (required, unsigned integer - time in seconds to change switch position)
    sh:property [ 
        sh:path era:reversalTime ;
        sh:datatype xsd:unsignedInt ;
		# sh:datatype xsd:nonNegativeInteger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Switch must have exactly one reversalTime (unsigned integer, in seconds)."@en ;
        sh:message "Jeder Switch muss genau eine reversalTime (vorzeichenlose Ganzzahl in Sekunden) haben."@de ;
        sh:message "Chaque Switch doit avoir exactement un reversalTime (entier non signé, en secondes)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint: Warning if reversalTime is 0
	# FILTER (?time = 0)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The reversalTime is 0 seconds. While this is valid, typical values for modern switches range from 3 to 10 seconds. Please verify this value is correct."@en ;
        sh:message "Der reversalTime beträgt 0 Sekunden. Dies ist zwar gültig, typische Werte für moderne Schalter liegen jedoch zwischen 3 und 10 Sekunden. Bitte überprüfen Sie, ob dieser Wert korrekt ist."@de ;
        sh:message "Le reversalTime est de 0 seconde. Bien que cela soit valable, les valeurs typiques des commutateurs modernes vont de 3 à 10 secondes. Veuillez vérifier que cette valeur est correcte."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
			PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> 
            
            SELECT $this
            WHERE {
                $this era:reversalTime ?time .
				FILTER(?time = 0)
                
            }
        """ ;
        sh:severity sh:Warning ;
    ] ;
    
    # SPARQL constraint: Warning if reversalTime is unusually high
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The reversalTime is greater than 30 seconds, which is unusually high for a railway switch. Typical values for modern switches range from 3 to 10 seconds. Please verify this value is correct."@en ;
        sh:message "Die reversalTime beträgt mehr als 30 Sekunden, was für eine Eisenbahnweiche ungewöhnlich hoch ist. Typische Werte für moderne Schalter liegen zwischen 3 und 10 Sekunden. Bitte überprüfen Sie, ob dieser Wert korrekt ist."@de ;
        sh:message "Le reversalTime est supérieur à 30 secondes, ce qui est inhabituellement élevé pour un aiguillage ferroviaire. Les valeurs typiques pour les commutateurs modernes vont de 3 à 10 secondes. Veuillez vérifier que cette valeur est correcte."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
			PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            
            SELECT $this
            WHERE {
                $this era:reversalTime ?time .
                FILTER (?time > 30)
            }
        """ ;
        sh:severity sh:Warning ;
    ] .
	

# ===== Net Relation Shape =====
era:NetRelationShape a sh:NodeShape ;
    sh:targetClass era:NetRelation ;
    
    # Element A (required, reference to a linear element)
    sh:property [ 
        sh:path era:elementA ;
        sh:node era:LinearElementShape ;
		sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetRelation must have exactly one elementA that conforms to LinearElement object."@en ;
        sh:message "Jede NetRelation muss genau ein elementA haben, das dem LinearElement-Objekt entspricht."@de ;
        sh:message "Chaque NetRelation doit avoir exactement un elementA conforme à l'objet LinearElement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Is On Origin Of Element A (required, boolean - whether relation point is at origin of element A)
    sh:property [ 
        sh:path era:isOnOriginOfElementA ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetRelation must have exactly one isOnOriginOfElementA value (boolean)."@en ;
        sh:message "Jede NetRelation muss genau einen isOnOriginOfElementA-Wert (boolean) haben."@de ;
        sh:message "Chaque NetRelation doit avoir exactement une valeur isOnOriginOfElementA (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Element B (required, reference to a linear element)
    sh:property [ 
        sh:path era:elementB ;
        sh:node era:LinearElementShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetRelation must have exactly one elementB that conforms to LinearElement object."@en ;
        sh:message "Jede NetRelation muss genau ein elementB haben, das dem LinearElement-Objekt entspricht."@de ;
        sh:message "Chaque NetRelation doit avoir exactement un elementB conforme à l'objet LinearElement."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Is On Origin Of Element B (required, boolean - whether relation point is at origin of element B)
    sh:property [ 
        sh:path era:isOnOriginOfElementB ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetRelation must have exactly one isOnOriginOfElementB value (boolean)."@en ;
        sh:message "Jede NetRelation muss genau einen isOnOriginOfElementB-Wert (boolean) haben."@de ;
        sh:message "Chaque NetRelation doit avoir exactement une valeur isOnOriginOfElementB (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== Operational Point Shape =====
era:OperationalPointShape a sh:NodeShape ;
    sh:targetClass era:OperationalPoint ;
    
    # UOPID - Unique Operational Point ID (required, string)    
	sh:property [ 
		sh:path era:uopid ;
		sh:datatype xsd:string ;
		sh:pattern "^[A-Z]{2}.{0,10}$" ; # Example: DE12345, FR67890
		sh:minCount 1 ;
		sh:maxCount 1 ;
		sh:message "Each OperationalPoint must have exactly one uopid following the format: 2-letter country code + alphanumeric ID (e.g., DE12345)."@en ;
		sh:message "Jeder OperationalPoint muss genau eine UOPID haben, die dem Format folgt: 2-Buchstaben-Ländercode + alphanumerische ID (z. B. DE12345)."@de ;
		sh:message "Chaque OperationalPoint doit avoir exactement un uopid suivant le format : code de pays à 2 lettres + identifiant alphanumérique (par exemple, DE12345)."@fr ;
		sh:severity sh:Violation ;
	] ;
    # Operational Point Name (optional, string)
    sh:property [ 
        sh:path era:opName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "An OperationalPoint may have at most one opName (string)."@en ;
        sh:message "Ein OperationalPoint darf höchstens einen opName (String) haben."@de ;
        sh:message "Un OperationalPoint peut avoir au plus un opName (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Operational Point Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:opType ;
        sh:in (
            <http://data.europa.eu/949/concepts/op-types/station>
            <http://data.europa.eu/949/concepts/op-types/depot>
            <http://data.europa.eu/949/concepts/op-types/siding>
            <http://data.europa.eu/949/concepts/op-types/trainTechnicalServices>
            <http://data.europa.eu/949/concepts/op-types/shuntingYard>
            <http://data.europa.eu/949/concepts/op-types/borderPoint>
            <http://data.europa.eu/949/concepts/op-types/technicalChange>
            <http://data.europa.eu/949/concepts/op-types/domesticBorderPoint>
            <http://data.europa.eu/949/concepts/op-types/freightTerminal>
            <http://data.europa.eu/949/concepts/op-types/junction>
            <http://data.europa.eu/949/concepts/op-types/passengerStop>
            <http://data.europa.eu/949/concepts/op-types/passengerTerminal>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property opType must have a value from the defined SKOS concept scheme."@en ;
        sh:message "Die Eigenschaft opType muss einen Wert aus dem definierten SKOS-Konzeptschema haben."@de ;
        sh:message "La propriété opType doit avoir une valeur issue du schéma conceptuel SKOS défini."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Platforms (optional, RDF list)
    sh:property [ 
        sh:path era:platforms ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "An OperationalPoint may have at most one platforms property pointing to an RDF list."@en ;
        sh:message "Ein OperationalPoint kann höchstens eine Plattformeigenschaft haben, die auf eine RDF-Liste verweist."@de ;
        sh:message "Un OperationalPoint peut avoir au plus une propriété de plates-formes pointant vers une liste RDF."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Travel Time Measurement Points (optional, multiple allowed)
    sh:property [ 
        sh:path era:travelTimeMeasurementPoints ;
        sh:node era:TravelTimeMeasurementPointShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "OperationalPoint travelTimeMeasurementPoints must conform to TravelTimeMeasurementPointShape."@en ;
        sh:message "OperationalPoint travelTimeMeasurementPoints muss TravelTimeMeasurementPointShape entsprechen."@de ;
        sh:message "OperationalPoint travelTimeMeasurementPoints doit être conforme à TravelTimeMeasurementPointShape."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # SPARQL constraint to validate all platform list items are Platform instances
    sh:sparql [ 
        a sh:SPARQLConstraint ;
        sh:message "All items in the platforms list must be instances of era:Platform that conform to PlatformShape."@en ;
        sh:message "Alle Elemente in der Plattformliste müssen Instanzen von era:Platform sein, die PlatformShape entsprechen."@de ;
        sh:message "Tous les éléments de la liste des plates-formes doivent être des instances de era:Platform conformes à PlatformShape."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                $this era:platforms ?list .
                ?list rdf:rest*/rdf:first ?item .
                
                # Violation if item is not a Platform
                FILTER NOT EXISTS { ?item a era:Platform }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Travel Time Measurement Point Shape =====
era:TravelTimeMeasurementPointShape a sh:NodeShape ;
    sh:targetClass era:TravelTimeMeasurementPoint ;
    
    # Topological Coordinate (required, can be inline or referenced)
    sh:property [ 
        sh:path era:topologicalCoordinate ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TravelTimeMeasurementPoint must have exactly one topologicalCoordinate that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jeder TravelTimeMeasurementPoint muss genau ein topologicalCoordinate haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque TravelTimeMeasurementPoint doit avoir exactement un topologicalCoordinate conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	

# ===== Timing Point Shape =====
era:TimingPointShape a sh:NodeShape ;
    sh:targetClass era:TimingPoint ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A TimingPoint may have at most one name (string)."@en ;
        sh:message "Ein TimingPoint darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un TimingPoint peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Position (required, unsigned integer)
    sh:property [ 
        sh:path era:pos ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TimingPoint must have exactly one pos (position as unsigned integer)."@en ;
        sh:message "Jeder TimingPoint muss genau eine Position (Position als vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque TimingPoint doit avoir exactement une pos (position sous forme d'entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Topological Coordinate (required, can be inline or referenced)
    sh:property [ 
        sh:path era:topologicalCoordinate ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TimingPoint must have exactly one topologicalCoordinate that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jeder TimingPoint muss genau ein topologicalCoordinate haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque TimingPoint doit avoir exactement un topologicalCoordinate conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Active Object (required, can be inline or referenced)
    sh:property [ 
        sh:path era:activeObject ;
        sh:node era:TPActiveObjectShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each TimingPoint must have exactly one activeObject that conforms to TPActiveObject object."@en ;
        sh:message "Jeder TimingPoint muss genau einen activeObject haben, der dem TPActiveObject-Objekt entspricht."@de ;
        sh:message "Chaque TimingPoint doit avoir exactement un activeObject conforme à l'objet TPActiveObject."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# ===== TP Active Object Shape =====
era:TPActiveObjectShape a sh:NodeShape ;
    sh:targetClass era:TPActiveObject ;
    sh:message "A TPActiveObject must have exactly one of: etcsMarker, stopLocation, or timeMeasurePoint."@en ;
    sh:message "Ein TPActiveObject muss genau eines von: etcsMarker, stopLocation oder timeMeasurePoint haben."@de ;
    sh:message "Un TPActiveObject doit avoir exactement l'un des éléments : etcsMarker, stopLocation ou timeMeasurePoint."@fr ;
    
    # Exactly one of the three object types must be present
    sh:xone (
        # Option 1: ETCS Marker
        [ 
            sh:path era:etcsMarker ;
            sh:node era:ETCSMarkerShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:message "If present, etcsMarker must conform to ETCSMarker object."@en ;
            sh:message "Falls vorhanden, muss etcsMarker dem ETCSMarker-Objekt entsprechen."@de ;
            sh:message "S'il est présent, etcsMarker doit être conforme à l'objet ETCSMarker."@fr ;
            sh:severity sh:Violation ;
        ]
        
        # Option 2: Stop Location
        [ 
            sh:path era:stopLocation ;
            sh:node era:StopLocationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:message "If present, stopLocation must conform to StopLocation object."@en ;
            sh:message "Falls vorhanden, muss stopLocation dem StopLocation-Objekt entsprechen."@de ;
            sh:message "S'il est présent, stopLocation doit être conforme à l'objet StopLocation."@fr ;
            sh:severity sh:Violation ;
        ]
        
        # Option 3: Travel Time Measurement Point
        [ 
            sh:path era:timeMeasurePoint ;
            sh:node era:TravelTimeMeasurementPointShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:message "If present, timeMeasurePoint must conform to TravelTimeMeasurementPoint object."@en ;
            sh:message "Falls vorhanden, muss timeMeasurePoint dem TravelTimeMeasurementPoint-Objekt entsprechen."@de ;
            sh:message "S'il est présent, timeMeasurePoint doit être conforme à l'objet TravelTimeMeasurementPoint."@fr ;
            sh:severity sh:Violation ;
        ]
    ) .
	


# ===== Stop Location Shape =====
era:StopLocationShape a sh:NodeShape ;
    sh:targetClass era:StopLocation ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A StopLocation may have at most one name (string)."@en ;
        sh:message "Eine StopLocation darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un StopLocation peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Net Point Reference (required, can be inline or referenced)
    sh:property [ 
        sh:path era:netPointReference ;
        sh:node era:NetPointReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StopLocation must have exactly one netPointReference that conforms to NetPointReference object."@en ;
        sh:message "Jeder StopLocation muss genau ein netPointReference haben, das dem NetPointReference-Objekt entspricht."@de ;
        sh:message "Chaque StopLocation doit avoir exactement un netPointReference conforme à l'objet NetPointReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Load Type (required, controlled vocabulary)
    sh:property [ 
        sh:path era:trainLoadType ;
        sh:in (
            <http://data.europa.eu/949/concepts/train-load-type/passengerTrain>
            <http://data.europa.eu/949/concepts/train-load-type/freightTrain>
            <http://data.europa.eu/949/concepts/train-load-type/anyTrain>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property trainLoadType must have a value from the defined SKOS concept scheme (passengerTrain, freightTrain, or anyTrain)."@en ;
        sh:message "Die Eigenschaft trainLoadType muss einen Wert aus dem definierten SKOS-Konzeptschema (passengerTrain, freightTrain oder anyTrain) haben."@de ;
        sh:message "La propriété trainLoadType doit avoir une valeur du schéma de concept SKOS défini (passengerTrain, freightTrain ou anyTrain)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Door Opening Side (required, controlled vocabulary)
    sh:property [ 
        sh:path era:doorOpeningSide ;
        sh:in (
            <http://data.europa.eu/949/concepts/door-opening-side/noSide>
            <http://data.europa.eu/949/concepts/door-opening-side/leftSide>
            <http://data.europa.eu/949/concepts/door-opening-side/rightSide>
            <http://data.europa.eu/949/concepts/door-opening-side/bothSides>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property doorOpeningSide must have a value from the defined SKOS concept scheme (noSide, leftSide, rightSide, or bothSides)."@en ;
        sh:message "Die Eigenschaft doorOpeningSide muss einen Wert aus dem definierten SKOS-Konzeptschema (noSide, leftSide, rightSide oder bothSides) haben."@de ;
        sh:message "La propriété doorOpeningSide doit avoir une valeur du schéma de concept SKOS défini (noSide, leftSide, rightSide ou bothSides)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Stop Train Limit (optional, can be inline or referenced)
    sh:property [ 
        sh:path era:stopTrainLimit ;
        sh:node era:StopTrainLimitShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:message "A StopLocation may have at most one stopTrainLimit that conforms to StopTrainLimit object."@en ;
        sh:message "Eine StopLocation kann höchstens eine stopTrainLimit haben, die dem StopTrainLimit-Objekt entspricht."@de ;
        sh:message "Un StopLocation peut avoir au plus un stopTrainLimit conforme à l'objet StopTrainLimit."@fr ;
        sh:severity sh:Violation ;
    ] .

# ===== Stop Train Limit Shape =====
era:StopTrainLimitShape a sh:NodeShape ;
    sh:targetClass era:StopTrainLimit ;
    
    # Train Max Length (required, unsigned integer - maximum train length in meters)
    sh:property [ 
        sh:path era:trainMaxLength ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StopTrainLimit must have exactly one trainMaxLength (unsigned integer > 0, in meters)."@en ;
        sh:message "Jedes StopTrainLimit muss genau eine trainMaxLength (vorzeichenlose Ganzzahl > 0, in Metern) haben."@de ;
        sh:message "Chaque StopTrainLimit doit avoir exactement un trainMaxLength (entier non signé > 0, en mètres)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Max Axles (required, unsigned integer - maximum number of axles)
    sh:property [ 
        sh:path era:trainMaxAxles ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StopTrainLimit must have exactly one trainMaxAxles (unsigned integer > 0)."@en ;
        sh:message "Jedes StopTrainLimit muss genau eine trainMaxAxles (vorzeichenlose Ganzzahl > 0) haben."@de ;
        sh:message "Chaque StopTrainLimit doit avoir exactement un trainMaxAxles (entier non signé > 0)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Max Wagons (required, unsigned integer - maximum number of wagons/cars)
    sh:property [ 
        sh:path era:trainMaxWagons ;
        sh:datatype xsd:unsignedInt ;
        sh:minInclusive 1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each StopTrainLimit must have exactly one trainMaxWagons (unsigned integer > 0)."@en ;
        sh:message "Jedes StopTrainLimit muss genau eine trainMaxWagons (vorzeichenlose Ganzzahl > 0) haben."@de ;
        sh:message "Chaque StopTrainLimit doit avoir exactement un trainMaxWagons (entier non signé > 0)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Train Max Size (required, controlled vocabulary)
    sh:property [ 
        sh:path era:trainMaxSize ;
        sh:in (
            <http://data.europa.eu/949/concepts/train-size/undefinedTrainSize>
            <http://data.europa.eu/949/concepts/train-size/shortTrain>
            <http://data.europa.eu/949/concepts/train-size/halfTrain>
            <http://data.europa.eu/949/concepts/train-size/fullTrain>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property trainMaxSize must have a value from the defined SKOS concept scheme (undefinedTrainSize, shortTrain, halfTrain, or fullTrain)."@en ;
        sh:message "Die Eigenschaft trainMaxSize muss einen Wert aus dem definierten SKOS-Konzeptschema (undefinedTrainSize, shortTrain, halfTrain oder fullTrain) haben."@de ;
        sh:message "La propriété trainMaxSize doit avoir une valeur du schéma de concept SKOS défini (undefinedTrainSize, shortTrain, halfTrain ou fullTrain)."@fr ;
        sh:severity sh:Violation ;
    ] .
	

# ===== Net Point Reference Shape =====
era:NetPointReferenceShape a sh:NodeShape ;
    sh:targetClass era:NetPointReference ;
    
    # Has Topological Coordinate (required, can be inline or referenced)
    sh:property [ 
        sh:path era:hasTopoCoordinate ;
        sh:node era:TopologicalCoordinateShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each NetPointReference must have exactly one hasTopoCoordinate that conforms to TopologicalCoordinate object."@en ;
        sh:message "Jede NetPointReference muss genau ein hasTopoCoordinate haben, das dem TopologicalCoordinate-Objekt entspricht."@de ;
        sh:message "Chaque NetPointReference doit avoir exactement un hasTopoCoordinate conforme à l'objet TopologicalCoordonnée."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Applies To Direction (required, controlled vocabulary)
    sh:property [ 
        sh:path era:appliesToDirection ;
        sh:in (
            <http://data.europa.eu/949/concepts/orientations/both>
            <http://data.europa.eu/949/concepts/orientations/same>
            <http://data.europa.eu/949/concepts/orientations/opposite>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The property appliesToDirection must have a value from the defined SKOS concept scheme (both, same, or opposite)."@en ;
        sh:message "Die Eigenschaft appliesToDirection muss einen Wert aus dem definierten SKOS-Konzeptschema haben (beide, gleich oder entgegengesetzt)."@de ;
        sh:message "La propriété appliesToDirection doit avoir une valeur du schéma conceptuel SKOS défini (les deux, identique ou opposé)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	

# ===== ETCS Marker Shape =====
era:ETCSMarkerShape a sh:NodeShape ;
    sh:targetClass era:ETCSMarker ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "An ETCSMarker may have at most one name (string)."@en ;
        sh:message "Ein ETCSMarker darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un ETCSMarker peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Net Point Reference (required, can be inline or referenced)
    sh:property [ 
        sh:path era:netPointReference ;
        sh:node era:NetPointReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSMarker must have exactly one netPointReference that conforms to NetPointReference object."@en ;
        sh:message "Jeder ETCSMarker muss genau ein netPointReference haben, das dem NetPointReference-Objekt entspricht."@de ;
        sh:message "Chaque ETCSMarker doit avoir exactement un netPointReference conforme à l'objet NetPointReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Marker Function Stop (required, boolean - indicates if marker is a stop marker)
    sh:property [ 
        sh:path era:markerFunctionStop ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ETCSMarker must have exactly one markerFunctionStop value (boolean)."@en ;
        sh:message "Jeder ETCSMarker muss genau einen markerFunctionStop-Wert (boolean) haben."@de ;
        sh:message "Chaque ETCSMarker doit avoir exactement une valeur markerFunctionStop (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	

# ===== Derailer Shape =====
era:DerailerShape a sh:NodeShape ;
    sh:targetClass era:Derailer ;
    
    # Name (optional, string)
    sh:property [ 
        sh:path era:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "A Derailer may have at most one name (string)."@en ;
        sh:message "Ein Derailer darf höchstens einen Namen (String) haben."@de ;
        sh:message "Un dérailleur peut avoir au plus un nom (chaîne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Net Point Reference (required, can be inline or referenced)
    sh:property [ 
        sh:path era:netPointReference ;
        sh:node era:NetPointReferenceShape ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Derailer must have exactly one netPointReference that conforms to NetPointReference object."@en ;
        sh:message "Jeder Derailer muss genau ein netPointReference haben, das dem NetPointReference-Objekt entspricht."@de ;
        sh:message "Chaque dérailleur doit avoir exactement un netPointReference conforme à l'objet NetPointReference."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Derail to Right (required, boolean - direction of derailment)
    sh:property [ 
        sh:path era:derailToRight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Derailer must have exactly one derailToRight value (boolean)."@en ;
        sh:message "Jeder Derailer muss genau einen derailToRight-Wert (boolean) haben."@de ;
        sh:message "Chaque dérailleur doit avoir exactement une valeur derailToRight (booléenne)."@fr ;
        sh:severity sh:Violation ;
    ] ;
    
    # Reversal Time (required, unsigned integer - typically in seconds)
    sh:property [ 
        sh:path era:reversalTime ;
        sh:datatype xsd:unsignedInt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Derailer must have exactly one reversalTime value (unsigned integer)."@en ;
        sh:message "Jeder Derailer muss genau einen reversalTime-Wert (vorzeichenlose Ganzzahl) haben."@de ;
        sh:message "Chaque dérailleur doit avoir exactement une valeur reversalTime (entier non signé)."@fr ;
        sh:severity sh:Violation ;
    ] .
	
	
# Shape to check that at least one Map/Projection class exists
era:AtLeastOneMapProjectionClassShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            SELECT ?this
            WHERE {
                BIND (era:ValidationRoot as ?this)
            }
        """ ;
    ] ;
    
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The data must contain at least one instance of the required Map/Projection classes (e.g., Map, LinearElementProjection, FunctionalElementProjection, MapSet, etc.). This error may indicate that the provided data significantly deviates from the expected geographic mapping model as defined in the extended ERA ontology."@en ;
        sh:message "Die Daten müssen mindestens eine Instanz der erforderlichen Karten-/Projektionsklassen enthalten (z. B. Map, LinearElementProjection, FunctionalElementProjection, MapSet usw.). Dieser Fehler kann darauf hinweisen, dass die bereitgestellten Daten erheblich vom erwarteten geografischen Kartierungsmodell abweichen, wie es in der erweiterten ERA-Ontologie definiert ist."@de ;
        sh:message "Les données doivent contenir au moins une instance des classes Map/Projection requises (par exemple, Map, LinearElementProjection, FunctionalElementProjection, MapSet, etc.). Cette erreur peut indiquer que les données fournies s'écartent considérablement du modèle de cartographie géographique attendu tel que défini dans l'ontologie ERA étendue."@fr ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    # Core Map Classes
                    { ?instance rdf:type era:Map . }
                    UNION { ?instance rdf:type era:MapSet . }
                    
                    # Linear Element Projection
                    UNION { ?instance rdf:type era:LinearElementProjection . }
                    UNION { ?instance rdf:type era:LinearElementCoordinate . }
                    
                    # Functional Element Projection
                    UNION { ?instance rdf:type era:FunctionalElementProjection . }
                    UNION { ?instance rdf:type era:FunctionalElementRef . }
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .